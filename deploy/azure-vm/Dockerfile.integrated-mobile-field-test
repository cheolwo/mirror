# Runtime-only context: server/ is the inspected framework-dependent Linux publish.
# No repository, SDK build stage, credential or local configuration is copied.
FROM mcr.microsoft.com/dotnet/aspnet:10.0.13 AS base
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
USER $APP_UID
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_HTTP_PORTS=8080

FROM base AS final
WORKDIR /app
USER root
RUN mkdir -p /app/App_Data /app/uploads /app/community /app/logs \
    && chown -R $APP_UID:$APP_UID /app/App_Data /app/uploads /app/community /app/logs
COPY --chown=$APP_UID:$APP_UID server/ ./
USER $APP_UID
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8080/health/ready || exit 1
ENTRYPOINT ["dotnet", "Ssalddel.dll"]
