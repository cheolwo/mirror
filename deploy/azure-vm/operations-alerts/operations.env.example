# 실제 환경 파일은 Git 밖 /etc/mirror 등에서만 관리한다.
MIRROR_OPERATIONS_ALERTS_ENABLED=false
MIRROR_OPERATIONS_EXTERNAL_SEND_ENABLED=false
MIRROR_OPERATIONS_BUDGET_ENABLED=false
MIRROR_OPERATOR_USER_ID=
MIRROR_OPERATOR_EMAIL=
MIRROR_OPERATOR_GMAIL_USER=
MIRROR_OPERATOR_GMAIL_APP_PASSWORD=
# 아래 백업 값은 별도 /etc/mirror/backup.env에 넣는다.
MIRROR_BACKUP_RECIPIENT=
MIRROR_BACKUP_STORAGE_ACCOUNT=
MIRROR_BACKUP_CONTAINER=
MIRROR_COMPOSE_DIR=/opt/mirror
MIRROR_PROTECTION_KEYS_BACKUP_VERIFIED=false
