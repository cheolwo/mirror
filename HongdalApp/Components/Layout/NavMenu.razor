@using Hongdal.Contracts.Common.ViewSettings
@using Hongdal.Ui.Common.Areas.App.Services
@using HongdalApp.Services
@implements IDisposable
@inject ShipperViewVisibilityService ViewVisibilityService
@inject ShipperLocalizationService L
@inject ShipperOperatingProfileService ProfileService
@inject HongdalClientRoleService RoleService
@inject PlatformHomeModeStateService HomeModeState
@inject NavigationManager Navigation

<MudNavMenu Class="pa-3 shipper-navmenu">
    <MudStack Spacing="0" Class="px-2 pb-3">
        <MudText Typo="Typo.subtitle1" Class="fw-bold">살뜰</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@ProfileLabel</MudText>
    </MudStack>
    <MudStack Spacing="1" Class="px-2 pb-3">
        <MudText Typo="Typo.caption" Color="Color.Secondary">현재 역할</MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudButton Variant="@RoleVariant(HongdalClientRole.Unspecified)"
                       Color="Color.Secondary"
                       Size="Size.Small"
                       OnClick="@(() => SetRole(HongdalClientRole.Unspecified))">
                공통 홈
            </MudButton>
            <MudButton Variant="@RoleVariant(HongdalClientRole.Shipper)"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="@(() => SetRole(HongdalClientRole.Shipper))">
                화주
            </MudButton>
            <MudButton Variant="@RoleVariant(HongdalClientRole.WarehouseManager)"
                       Color="Color.Success"
                       Size="Size.Small"
                       OnClick="@(() => SetRole(HongdalClientRole.WarehouseManager))">
                창고 관리자
            </MudButton>
        </MudStack>
    </MudStack>
    <MudDivider Class="mb-3" />

    @if (!ViewVisibilityService.IsLoaded)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mx-2 my-2" />
    }
    else
    {
        @foreach (var group in BuildGroups())
        {
            if (group.Items.Count > 0)
            {
                <MudNavGroup Title="@group.Title" Icon="@group.Icon" Expanded="@group.Expanded">
                    @foreach (var item in group.Items)
                    {
                        <MudNavLink Href="@ToHref(item.Route)" Match="@(item.Route == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Icon="@ResolveIcon(item.IconKey)">
                            @item.DisplayName
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
        }
    }

    <MudDivider Class="my-3" />
    <MudStack Spacing="1" Class="px-2 pb-2">
        <MudText Typo="Typo.caption" Color="Color.Secondary">모드 전환</MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            <MudButton Variant="@CommunityModeVariant" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Forum" OnClick="@(() => SetMode(false))">커뮤니티</MudButton>
            <MudButton Variant="@WorkModeVariant" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Work" OnClick="@(() => SetMode(true))">업무</MudButton>
        </MudStack>
    </MudStack>
</MudNavMenu>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewVisibilityService.Changed += HandleChanged;
        ProfileService.Changed += HandleChanged;
        RoleService.Changed += HandleChanged;
        HomeModeState.Changed += HandleChanged;
        await ViewVisibilityService.EnsureLoadedAsync();
    }

    private Variant CommunityModeVariant => HomeModeState.IsWorkMode ? Variant.Outlined : Variant.Filled;

    private Variant WorkModeVariant => HomeModeState.IsWorkMode ? Variant.Filled : Variant.Outlined;

    private Variant RoleVariant(HongdalClientRole role) => RoleService.CurrentRole == role
        ? Variant.Filled
        : Variant.Outlined;

    private void SetRole(HongdalClientRole role)
    {
        RoleService.SetRole(role);
        Navigation.NavigateTo(ShipperRoutes.Home);
    }

    private void SetMode(bool isWorkMode)
    {
        HomeModeState.SetWorkMode(isWorkMode);
    }

    private void HandleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private static string ToHref(string route)
    {
        if (string.IsNullOrWhiteSpace(route) || route == "/")
        {
            return string.Empty;
        }

        return route.TrimStart('/');
    }

    private static string ResolveIcon(string iconKey) => iconKey switch
    {
        "home" => Icons.Material.Filled.Home,
        "settings" => Icons.Material.Filled.Settings,
        "add_box" => Icons.Material.Filled.AddBox,
        "view_list" => Icons.Material.Filled.ViewList,
        "inbox" => Icons.Material.Filled.Inbox,
        "dashboard" => Icons.Material.Filled.Dashboard,
        "inventory_2" => Icons.Material.Filled.Inventory2,
        "warehouse" => Icons.Material.Filled.Warehouse,
        "local_shipping" => Icons.Material.Filled.LocalShipping,
        "qr_code_scanner" => Icons.Material.Filled.QrCodeScanner,
        "person" => Icons.Material.Filled.Person,
        "storefront" => Icons.Material.Filled.Storefront,
        "sell" => Icons.Material.Filled.Sell,
        "outbox" => Icons.Material.Filled.Outbox,
        "public" => Icons.Material.Filled.Public,
        "fact_check" => Icons.Material.Filled.FactCheck,
        _ => Icons.Material.Filled.ChevronRight
    };

    private IReadOnlyList<NavGroupItem> BuildGroups()
    {
        var visibleItems = RoleService.CurrentRole switch
        {
            HongdalClientRole.Unspecified =>
            [
                new NavMenuItem("홈", ShipperRoutes.Home, "home", "primary", 0)
            ],
            HongdalClientRole.WarehouseManager => BuildWarehouseManagerItems().ToList(),
            _ => ViewVisibilityService.VisibleItems
                .Where(x => ShouldShowForProfile(x.Route))
                .Select(x => new NavMenuItem(
                    L.ViewName(x.Route, x.DisplayName),
                    x.Route,
                    x.IconKey,
                    ResolveGroupKey(x.Route),
                    x.SortOrder))
                .ToList()
        };

        visibleItems.Add(new NavMenuItem(
            "공공데이터 정보",
            ShipperRoutes.PublicDataInformation,
            "public",
            "primary",
            5));

        if (RoleService.IsShipper)
        {
            visibleItems.Add(new NavMenuItem(L.T("Nav.DispatchAddress"), ShipperRoutes.DispatchAddressForm, "local_shipping", "transport", 900));
            visibleItems.Add(new NavMenuItem("FCL/LCL 판단", ShipperRoutes.FclLclPlanner, "public", "transport", 905));
            visibleItems.Add(new NavMenuItem("창고 작업대", ShipperRoutes.WarehouseWorkspace, "warehouse", "warehouse", 910));
            visibleItems.Add(new NavMenuItem(L.T("ProfileSettings.Nav"), ShipperRoutes.ProfileSettings, "person", "settings", 920));
        }

        return
        [
            CreateGroup("primary", L.T("Nav.Group.Primary"), Icons.Material.Filled.Dashboard, visibleItems, expanded: true),
            CreateGroup("transport", L.T("Nav.Group.Transport"), Icons.Material.Filled.LocalShipping, visibleItems, expanded: true),
            CreateGroup("warehouse", L.T("Nav.Group.Warehouse"), Icons.Material.Filled.Warehouse, visibleItems, expanded: true),
            CreateGroup("sales", L.T("Nav.Group.Sales"), Icons.Material.Filled.Storefront, visibleItems, expanded: false),
            CreateGroup("settings", L.T("Nav.Group.Settings"), Icons.Material.Filled.Settings, visibleItems, expanded: false)
        ];
    }

    private static IReadOnlyList<NavMenuItem> BuildWarehouseManagerItems()
    {
        return HongdalClientNavigationCatalog.WarehouseManagerItems
            .Select(x => new NavMenuItem(x.DisplayName, x.Route, x.IconKey, x.GroupKey, x.SortOrder))
            .ToArray();
    }

    private static NavGroupItem CreateGroup(string key, string title, string icon, IReadOnlyList<NavMenuItem> allItems, bool expanded)
    {
        return new NavGroupItem(
            key,
            title,
            icon,
            allItems.Where(x => x.GroupKey == key).OrderBy(x => x.SortOrder).ToList(),
            expanded);
    }

    private static string ResolveGroupKey(string route)
    {
        var normalizedRoute = route.TrimEnd('/').ToLowerInvariant();
        return normalizedRoute switch
        {
            "" or ShipperRoutes.Home => "primary",
            ShipperRoutes.TransportWorkspace or ShipperRoutes.Request or ShipperRoutes.PublicCargo or ShipperRoutes.ExplorationInbox or ShipperRoutes.DispatchAddressForm or ShipperRoutes.CustomsHsReviews or ShipperRoutes.FclLclPlanner => "transport",
            ShipperRoutes.WarehouseWorkspace or ShipperRoutes.InboundDashboard or ShipperRoutes.InboundRequests or ShipperRoutes.WarehouseInventory or ShipperRoutes.ReconsignmentOrders or ShipperRoutes.WarehouseScan => "warehouse",
            ShipperRoutes.SalesChannels or ShipperRoutes.SalesPageComposer or ShipperRoutes.ProductListings or ShipperRoutes.OrderFulfillment => "sales",
            _ when normalizedRoute.StartsWith("/shipper/settings", StringComparison.OrdinalIgnoreCase) => "settings",
            _ => "primary"
        };
    }

    private bool ShouldShowForProfile(string route)
    {
        var normalizedRoute = route.TrimEnd('/');
        if (ProfileService.IsDomestic)
        {
            return normalizedRoute is not ShipperRoutes.InboundDashboard and not ShipperRoutes.InboundRequests;
        }

        return normalizedRoute is not ShipperRoutes.SalesChannels and not ShipperRoutes.SalesPageComposer and not ShipperRoutes.ProductListings and not ShipperRoutes.OrderFulfillment;
    }

    private string ProfileLabel => RoleService.CurrentRole switch
    {
        HongdalClientRole.WarehouseManager => RoleService.RoleDescription,
        HongdalClientRole.Shipper => $"{RoleService.RoleLabel} · {(ProfileService.IsDomestic ? "국내 운송 운영" : "글로벌 물류 운영")}",
        _ => RoleService.RoleDescription
    };

    public void Dispose()
    {
        ViewVisibilityService.Changed -= HandleChanged;
        ProfileService.Changed -= HandleChanged;
        RoleService.Changed -= HandleChanged;
        HomeModeState.Changed -= HandleChanged;
    }

    private sealed record NavMenuItem(string DisplayName, string Route, string IconKey, string GroupKey, int SortOrder);

    private sealed record NavGroupItem(string Key, string Title, string Icon, IReadOnlyList<NavMenuItem> Items, bool Expanded);
}
