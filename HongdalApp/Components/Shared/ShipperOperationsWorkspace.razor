@using Hongdal.Contracts.Common.Inventory
@using Hongdal.Contracts.Common.Inbound
@using Hongdal.Contracts.Common.Warehouse
@using HongdalApp.Services.Commerce.Orders
@using HongdalApp.Services.Customs
@inject IShipperOperationsService ShipperOperations
@inject IShipperSalesService SalesService
@inject ICommerceOrderFulfillmentService FulfillmentService
@inject ICustomsHsReviewService CustomsReviewService
@inject NavigationManager Navigation

<MudPaper Elevation="0" Class="pa-4" Style="border:1px solid var(--mud-palette-divider); border-radius: 8px;">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">운영 작업대</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">창고, 판매채널, 주문 출고, 통관 검토를 한 곳에서 확인합니다.</MudText>
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@isBusy" OnClick="LoadAsync">
                새로고침
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        <MudGrid>
            @foreach (var metric in Metrics)
            {
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Elevation="0" Class="pa-3 h-100" Style="border:1px solid var(--mud-palette-divider); border-radius: 8px;">
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@metric.Icon" Color="@metric.Color" />
                                <MudText Typo="Typo.h5">@metric.Value</MudText>
                            </MudStack>
                            <MudText Typo="Typo.subtitle2">@metric.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@metric.Description</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudGrid>
            <MudItem xs="12" md="7">
                <MudPaper Elevation="0" Class="pa-3 h-100" Style="border:1px solid var(--mud-palette-divider); border-radius: 8px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1">우선 처리 업무</MudText>
                        @foreach (var task in PriorityTasks)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="py-1">
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@task.Icon" Color="@task.Color" />
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.body2">@task.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@task.Description</MudText>
                                    </MudStack>
                                </MudStack>
                                <MudButton Variant="Variant.Text" Color="@task.Color" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => Navigation.NavigateTo(task.Route))">
                                    열기
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="5">
                <MudPaper Elevation="0" Class="pa-3 h-100" Style="border:1px solid var(--mud-palette-divider); border-radius: 8px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1">최근 출고 알림</MudText>
                        @if (recentNotifications.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">아직 주문 출고 알림이 없습니다.</MudText>
                        }
                        else
                        {
                            @foreach (var notification in recentNotifications)
                            {
                                <MudStack Spacing="0" Class="py-1">
                                    <MudText Typo="Typo.body2">@notification.ChannelOrderNo · @notification.ProductName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@notification.WarehouseName / @notification.Status / @notification.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</MudText>
                                </MudStack>
                            }
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Outbox" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.OrderFulfillment))">
                            출고 알림 보기
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudPaper>

@code {
    private IReadOnlyList<입고요청항목응답> inbounds = [];
    private IReadOnlyList<재고항목응답> inventory = [];
    private IReadOnlyList<WarehouseOutboundNotification> notifications = [];
    private IReadOnlyList<CustomsHsReviewRequest> reviews = [];
    private int connectedChannelCount;
    private bool isBusy;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    private IReadOnlyList<WarehouseOutboundNotification> recentNotifications => notifications
        .OrderByDescending(x => x.CreatedAt)
        .Take(3)
        .ToArray();

    private IReadOnlyList<WorkspaceMetric> Metrics =>
    [
        new("입고 대기", PendingInboundCount.ToString(), "창고 입고 처리 필요", Icons.Material.Filled.MoveToInbox, Color.Warning),
        new("가용 재고", AvailableInventoryCount.ToString(), "판매 또는 재위탁 가능", Icons.Material.Filled.Inventory2, Color.Success),
        new("출고 대기", ReadyOutboundCount.ToString(), "창고 담당자 알림", Icons.Material.Filled.Outbox, Color.Primary),
        new("HS 검토", OpenHsReviewCount.ToString(), "관세사 확인 필요", Icons.Material.Filled.FactCheck, Color.Info)
    ];

    private IReadOnlyList<WorkspaceTask> PriorityTasks =>
    [
        new($"입고 예정 {PendingInboundCount}건", "입고 현황에서 창고 도착/재고 전환 흐름을 확인합니다.", ShipperRoutes.InboundRequests, Icons.Material.Filled.Warehouse, PendingInboundCount > 0 ? Color.Warning : Color.Default),
        new($"재고 후속 업무 {AvailableInventoryCount}건", "가용 재고를 판매 등록 또는 재위탁 운송으로 연결합니다.", ShipperRoutes.WarehouseInventory, Icons.Material.Filled.Inventory2, AvailableInventoryCount > 0 ? Color.Success : Color.Default),
        new($"판매채널 {connectedChannelCount}개 연결", "상품 출품과 주문 수집을 위한 채널 연결 상태를 확인합니다.", ShipperRoutes.SalesChannels, Icons.Material.Filled.Storefront, connectedChannelCount > 0 ? Color.Primary : Color.Warning),
        new($"HS 검토 진행 {OpenHsReviewCount}건", "수출입 흐름이 있는 상품의 HS 코드 검토 상태를 확인합니다.", ShipperRoutes.CustomsHsReviews, Icons.Material.Filled.FactCheck, OpenHsReviewCount > 0 ? Color.Info : Color.Default)
    ];

    private int PendingInboundCount => inbounds.Count(x => string.Equals(x.상태, "입고예정", StringComparison.OrdinalIgnoreCase));

    private int AvailableInventoryCount => inventory.Count(x => x.가용수량 > 0);

    private int ReadyOutboundCount => notifications.Count(x => x.Status == WarehouseOutboundNotificationStatusCodes.Ready);

    private int OpenHsReviewCount => reviews.Count(x => x.Status is CustomsHsReviewStatusCodes.Requested or CustomsHsReviewStatusCodes.BrokerAssigned);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        message = null;

        try
        {
            inbounds = await ShipperOperations.GetInboundsAsync();
            inventory = await ShipperOperations.GetInventoryAsync();
            notifications = await FulfillmentService.GetNotificationsAsync();
            reviews = await CustomsReviewService.GetReviewsAsync();
            connectedChannelCount = (await SalesService.GetAccountsAsync())?.Items.Count ?? 0;
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed record WorkspaceMetric(string Title, string Value, string Description, string Icon, Color Color);

    private sealed record WorkspaceTask(string Title, string Description, string Route, string Icon, Color Color);
}
