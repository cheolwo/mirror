@using HongdalApp.Services
@inject ShipperViewVisibilityService ViewVisibilityService
@inject NavigationManager NavigationManager

@if (!ViewVisibilityService.IsLoaded)
{
    <MudStack Class="pa-4" AlignItems="AlignItems.Center" Justify="Justify.Center">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudStack>
}
else if (blockedItem is not null)
{
    <ViewAccessDenied ViewName="@blockedItem.DisplayName" />
}
else
{
    <RouteView RouteData="RouteData" DefaultLayout="typeof(Layout.MainLayout)" />
    <FocusOnNavigate RouteData="RouteData" Selector="h1" />
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;

    private Hongdal.Contracts.Common.ViewSettings.View가시성항목응답? blockedItem;

    protected override async Task OnParametersSetAsync()
    {
        await ViewVisibilityService.EnsureLoadedAsync();
        blockedItem = ViewVisibilityService.GetBlockingItem(NavigationManager.ToBaseRelativePath(NavigationManager.Uri));
    }
}
