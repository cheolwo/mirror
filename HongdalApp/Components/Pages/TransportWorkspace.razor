@page "/shipper/transport"
@using HongdalApp.Models.Shipper
@using HongdalApp.Services
@inject IAuthSession AuthSession
@inject IShipperOperationsService ShipperOperations
@inject NavigationManager Navigation
@inject ShipperLocalizationService L

<PageTitle>운송 업무</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">운송 업무</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">운송 의뢰별 결제, 배차, 운송 진행 상태와 정책 정보를 처리합니다.</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">새로고침</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToRequestWizard">운송 의뢰 등록</MudButton>
            </MudStack>
        </MudStack>

        @if (!AuthSession.IsLoggedIn)
        {
            <MudAlert Severity="Severity.Warning">
                운송 의뢰를 확인하려면 홈에서 먼저 로그인해 주세요.
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@ShipperRoutes.Home">홈으로 이동</MudButton>
            </MudAlert>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="@messageSeverity" Dense="true">@message</MudAlert>
            }

            <MudGrid>
                @foreach (var metric in Metrics)
                {
                    <MudItem xs="12" sm="4">
                        <MudPaper Elevation="0" Class="pa-3 shipper-panel h-100">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@metric.Label</MudText>
                                    <MudText Typo="Typo.h5" Color="@metric.Color">@metric.Value</MudText>
                                </MudStack>
                                <MudIcon Icon="@metric.Icon" Color="@metric.Color" Size="Size.Large" />
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <MudStack Spacing="1">
                <MudText Typo="Typo.h6">@L.T("Home.RequestList")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">의뢰 상세와 민감 정보는 필요한 건만 펼쳐서 확인합니다.</MudText>
            </MudStack>

            @if (requests.Count == 0)
            {
                <MudAlert Severity="Severity.Info">@L.T("Home.NoRequests")</MudAlert>
            }
            else
            {
                <MudGrid>
                    @foreach (var request in OrderedRequests)
                    {
                        <MudItem xs="12" lg="6">
                            <MudPaper Elevation="0" Class="pa-4 shipper-panel h-100">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold">@request.의뢰Id</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@request.화물종류 · @request.의뢰상태</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                            <MudChip T="string" Size="Size.Small" Color="@ResolvePaymentColor(request.결제상태)" Variant="Variant.Outlined">@request.결제상태</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="@ResolveDispatchColor(request.배차상태)" Variant="Variant.Outlined">@request.배차상태</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="@ResolvePolicyColor(request)" Variant="Variant.Outlined">@BuildPolicyLabel(request)</MudChip>
                                        </MudStack>
                                    </MudStack>

                                    <MudGrid>
                                        <MudItem xs="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">결제예정</MudText>
                                            <MudText Typo="Typo.body2">@(request.결제예정금액?.ToString("N0") ?? "-")원</MudText>
                                        </MudItem>
                                        <MudItem xs="6" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">다음 확인</MudText>
                                            <MudText Typo="Typo.body2">@BuildRequestNextCheck(request)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">요금 정책</MudText>
                                            <MudText Typo="Typo.body2">@BuildFarePolicySummary(request)</MudText>
                                        </MudItem>
                                    </MudGrid>

                                    <HongdalSensitiveDisclosureList Title="의뢰 상세"
                                                                    Summary="@request.결제상태"
                                                                    RelatedParties="@BuildRequestRelatedParties(request)"
                                                                    Icon="@Icons.Material.Filled.LocalShipping"
                                                                    Color="Color.Primary"
                                                                    PrivacyHint="주소와 결제 정보는 필요한 순간에만 펼쳐 확인합니다.">
                                        <MudExpansionPanel Text="화물 정보" Expanded="true">
                                            <HongdalSensitiveInfoRow Label='@L.T("Home.CargoType")' Value="@request.화물종류" />
                                            <HongdalSensitiveInfoRow Label="화물 적재 형태" Value='@(string.IsNullOrWhiteSpace(request.화물적재형태) ? "-" : request.화물적재형태)' />
                                            <HongdalSensitiveInfoRow Label="의뢰 상태" Value="@request.의뢰상태" />
                                            <HongdalSensitiveInfoRow Label='@L.T("Home.CreatedAt")' Value='@request.생성일시.ToLocalTime().ToString("yyyy-MM-dd HH:mm")' />
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="운송 정보">
                                            <HongdalSensitiveInfoRow Label='@L.T("Home.Pickup")' Value='@(request.픽업지 ?? "-")' />
                                            <HongdalSensitiveInfoRow Label="하차지" Value='@(request.하차지 ?? "-")' />
                                            <HongdalSensitiveInfoRow Label='@L.T("Home.Dispatch")' Value="@request.배차상태" />
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="결제 정보">
                                            <HongdalSensitiveInfoRow Label='@L.T("Home.Payment")' Value="@request.결제상태" />
                                            <HongdalSensitiveInfoRow Label='@L.T("Home.PaymentMethod")' Value="@request.결제수단" />
                                            <HongdalSensitiveInfoRow Label="예정 금액" Value='@(request.결제예정금액?.ToString("N0") ?? "-")' />
                                            <HongdalSensitiveInfoRow Label="기준 운임" Value='@(request.기준운임?.ToString("N0") ?? "-")' />
                                            <HongdalSensitiveInfoRow Label="기사 지급 예정" Value='@(request.기사지급예정운임?.ToString("N0") ?? "-")' />
                                        </MudExpansionPanel>
                                        <MudExpansionPanel Text="요금/알선 정책">
                                            <HongdalSensitiveInfoRow Label="알선 단계" Value='@($"{request.알선단계}단계")' />
                                            <HongdalSensitiveInfoRow Label="재알선 금지" Value='@(request.재알선금지 ? "적용" : "미적용")' />
                                            <HongdalSensitiveInfoRow Label="정책 상태" Value="@BuildPolicyLabel(request)" />
                                            <HongdalSensitiveInfoRow Label="경고" Value="@BuildPolicyWarningText(request)" />
                                        </MudExpansionPanel>
                                    </HongdalSensitiveDisclosureList>

                                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Timeline" OnClick="@(() => NavigateToRequestDetail(request))">타임라인</MudButton>
                                        @if (request.CanPay)
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ShowPayMessage(request))">@L.T("Home.Pay")</MudButton>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        }
    </MudStack>
</MudContainer>

@code {
    private List<ShipperRequestItem> requests = [];
    private string? message;
    private Severity messageSeverity = Severity.Info;

    private IEnumerable<ShipperRequestItem> OrderedRequests => requests.OrderByDescending(x => x.생성일시);

    private IReadOnlyList<WorkspaceMetric> Metrics =>
    [
        new("전체 의뢰", $"{requests.Count:N0}건", Icons.Material.Filled.ReceiptLong, Color.Primary),
        new("결제 대기", $"{requests.Count(x => IsMatch(x.결제상태, "결제대기", "미결제", "대기")):N0}건", Icons.Material.Filled.Payments, Color.Warning),
        new("배차 진행", $"{requests.Count(x => IsMatch(x.배차상태, "매칭중", "배차대기", "기사배정", "운송중")):N0}건", Icons.Material.Filled.LocalShipping, Color.Info)
    ];

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.RestoreAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!AuthSession.IsLoggedIn)
        {
            requests = [];
            return;
        }

        try
        {
            requests = (await ShipperOperations.GetRequestsAsync()).ToList();
            message = null;
        }
        catch (Exception ex)
        {
            requests = [];
            messageSeverity = Severity.Error;
            message = $"서버 API 조회 실패: {ex.Message}";
        }
    }

    private static bool IsMatch(string? value, params string[] keywords)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               keywords.Any(keyword => value.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    private static string BuildRequestRelatedParties(ShipperRequestItem request)
    {
        var dispatchParty = string.IsNullOrWhiteSpace(request.배차상태)
            ? "기사 매칭 대상"
            : $"기사 {request.배차상태}";
        var dropoffParty = string.IsNullOrWhiteSpace(request.하차지)
            ? "하차지 담당자"
            : $"하차지 {request.하차지}";
        return $"화주 · {dispatchParty} · {dropoffParty}";
    }

    private static string BuildRequestNextCheck(ShipperRequestItem request)
    {
        if (IsMatch(request.결제상태, "결제대기", "미결제", "대기"))
        {
            return "결제 확인";
        }

        if (IsMatch(request.배차상태, "매칭중", "배차대기", "대기"))
        {
            return "기사 매칭";
        }

        if (IsMatch(request.배차상태, "기사배정", "배차확정"))
        {
            return "상차 대기";
        }

        return IsMatch(request.배차상태, "운송중", "상차완료", "운송") ? "하차 진행" : "상세 확인";
    }

    private static string BuildPolicyLabel(ShipperRequestItem request)
    {
        if (request.정책위반)
        {
            return "정책확인";
        }

        return request.재알선의심 ? "재알선의심" : "정책정상";
    }

    private static string BuildFarePolicySummary(ShipperRequestItem request)
    {
        var baseFare = request.기준운임?.ToString("N0") ?? "-";
        var driverFare = request.기사지급예정운임?.ToString("N0") ?? "-";
        return $"기준 {baseFare}원 / 기사 {driverFare}원";
    }

    private static string BuildPolicyWarningText(ShipperRequestItem request)
    {
        return request.정책경고목록.Count == 0
            ? "경고 없음"
            : string.Join(" / ", request.정책경고목록);
    }

    private static Color ResolvePolicyColor(ShipperRequestItem request)
    {
        if (request.정책위반)
        {
            return Color.Warning;
        }

        return request.재알선의심 ? Color.Error : Color.Success;
    }

    private static Color ResolvePaymentColor(string status)
    {
        if (IsMatch(status, "결제완료"))
        {
            return Color.Success;
        }

        return IsMatch(status, "결제대기", "미결제", "대기") ? Color.Warning : Color.Default;
    }

    private static Color ResolveDispatchColor(string status)
    {
        if (IsMatch(status, "배송완료", "하차완료", "완료"))
        {
            return Color.Success;
        }

        if (IsMatch(status, "운송중", "상차완료", "운송"))
        {
            return Color.Info;
        }

        return IsMatch(status, "매칭중", "배차대기", "대기") ? Color.Warning : Color.Primary;
    }

    private void NavigateToRequestDetail(ShipperRequestItem request)
    {
        if (!string.IsNullOrWhiteSpace(request.의뢰Id))
        {
            Navigation.NavigateTo(ShipperRoutes.RequestDetailFor(request.의뢰Id));
        }
    }

    private void GoToRequestWizard() => Navigation.NavigateTo(ShipperRoutes.Request);

    private async Task ShowPayMessage(ShipperRequestItem request)
    {
        var page = Application.Current?.Windows.FirstOrDefault()?.Page;
        if (page is null)
        {
            return;
        }

        await page.DisplayAlertAsync(
            L.T("Home.Alert.PaymentTitle"),
            L.T("Home.Alert.PaymentMessage", request.의뢰Id),
            L.T("Home.Alert.Confirm"));
    }

    private sealed record WorkspaceMetric(string Label, string Value, string Icon, Color Color);
}
