@page "/shipper/request"
@using Hongdal.Ui.Common.Areas.App.Models
@using HongdalApp.Models.Shipper
@using HongdalApp.Services
@inject IShipperOperationsService ShipperOperations

<PageTitle>화주 운송 의뢰 작성</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">화주 운송 의뢰 작성</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                웹에서는 한 화면에서 입력하고, 작은 화면에서는 단계 입력으로 바꿔 같은 운송 모델을 작성합니다.
            </MudText>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(PageStatusMessage))
        {
            <MudAlert Severity="@PageStatusSeverity">@PageStatusMessage</MudAlert>
        }

        <MudTabs Elevation="0" Rounded="true">
            <MudTabPanel Text="단건 등록">
                <Hongdal운송모델작성Panel 제목="운송 모델 작성"
                                      설명="화물 정보, 운송 정보, 결제/요금 정보를 하나의 운송 모델로 관리합니다."
                                      작성출처="화주앱"
                                      차량종류목록="VehicleTypes"
                                      한화면입력="true"
                                      전송버튼텍스트="화주 운송 의뢰 등록"
                                      커뮤니티AppKey="shipper"
                                      커뮤니티RoleTag="화주"
                                      커뮤니티보기Href="/shipper"
                                      커뮤니티기본닉네임="화주상담"
                                      IsBusy="IsBusy"
                                      기준운임조회Async="EstimateFareAsync"
                                      OnSubmit="SubmitSingleAsync" />
            </MudTabPanel>
            <MudTabPanel Text="CSV 일괄등록">
                <ShipperBulkImportPanel />
            </MudTabPanel>
        </MudTabs>
    </MudStack>
</MudContainer>

@code {
    private bool IsBusy { get; set; }
    private string PageStatusMessage { get; set; } = string.Empty;
    private Severity PageStatusSeverity { get; set; } = Severity.Info;
    private IReadOnlyList<string> VehicleTypes { get; set; } = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            VehicleTypes = await ShipperOperations.GetVehicleTypesAsync();
        }
        catch (Exception ex)
        {
            VehicleTypes = [];
            PageStatusSeverity = Severity.Warning;
            PageStatusMessage = $"차량 후보 서버 조회 실패: {ex.Message}";
        }
    }

    private async Task SubmitSingleAsync(운송모델작성Draft draft)
    {
        IsBusy = true;
        PageStatusSeverity = Severity.Info;
        PageStatusMessage = "서버 API로 화주 운송 의뢰를 등록하는 중입니다.";

        try
        {
            var request = new ShipperRequestItem
            {
                의뢰Id = $"SHP-{DateTime.Now:yyyyMMddHHmmss}",
                화물종류 = draft.화물종류,
                화물적재형태 = draft.화물적재형태,
                의뢰상태 = "접수",
                결제상태 = draft.결제예정금액.HasValue ? "결제대기" : "대기",
                배차상태 = "매칭중",
                운송방식 = draft.운송방식,
                차량종류 = draft.차량종류 ?? "1톤",
                결제수단 = draft.결제수단,
                결제예정금액 = draft.결제예정금액,
                예상거리Km = draft.예상거리Km,
                기준운임 = draft.기준운임,
                기사지급예정운임 = draft.기사지급예정운임,
                알선단계 = draft.알선단계,
                재알선금지 = draft.재알선금지,
                재알선의심 = draft.재알선의심,
                정책위반 = draft.정책위반,
                정책경고목록 = draft.정책경고목록,
                생성일시 = DateTime.Now,
                픽업지 = draft.픽업도로명주소,
                하차지 = draft.하차도로명주소
            };

            await ShipperOperations.AddRequestAsync(request);
            PageStatusSeverity = Severity.Success;
            PageStatusMessage = "서버에 화주 운송 의뢰를 등록했습니다.";
        }
        catch (Exception ex)
        {
            PageStatusSeverity = Severity.Error;
            PageStatusMessage = $"서버 의뢰 등록 실패: {ex.Message}";
            throw;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task<decimal?> EstimateFareAsync(string vehicleType, decimal distanceKm)
    {
        return await ShipperOperations.EstimateFareAsync(vehicleType, distanceKm);
    }
}
