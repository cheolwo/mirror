@inject NavigationManager Navigation
@using Hongdal.Contracts.Common.Community

<PlatformCommunityHome AppName="살뜰"
                       RoleLabel="창고 관리자"
                       AppKey="warehouse-manager"
                       UseBaguaRoleTransitionPages="true"
                       BaguaPerspectiveRoleCode="@BaguaActorRoleCodes.WarehouseManager"
                       UseCompactHomeSummary="true"
                       ShowRealtimeBest="true"
                       QuickActions="QuickActions"
                       CardinalNavigationOptions="CardinalNavigationOptions">
    <CommunityModeContent>
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="1">
                <MudText Typo="Typo.overline" Color="Color.Success">역할 기반 통합 클라이언트</MudText>
                <MudText Typo="Typo.h6">창고 관리자에게 필요한 흐름만 보여드립니다.</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    같은 살뜰 앱 안에서 역할을 바꾸면 홈의 사방괘와 업무 메뉴가 함께 바뀝니다.
                </MudText>
            </MudStack>
        </MudPaper>
    </CommunityModeContent>

    <WorkModeContent>
        <MudStack Spacing="3">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">창고 운영</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    입고·출고·판매·운송 중 지금 처리할 흐름 하나를 선택하세요.
                </MudText>
            </MudStack>

            <MudGrid>
                @foreach (var action in WarehouseActions)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                            <MudStack Spacing="2" Class="h-100">
                                <MudIcon Icon="@action.Icon" Color="@action.Color" Size="Size.Large" />
                                <MudStack Spacing="0" Class="flex-grow-1">
                                    <MudText Typo="Typo.h6">@action.Title</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                                </MudStack>
                                <MudButton Variant="Variant.Filled"
                                           Color="@action.Color"
                                           EndIcon="@Icons.Material.Filled.ChevronRight"
                                           OnClick="@(() => NavigateTo(action.Route))">
                                    업무 시작
                                </MudButton>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Warehouse"
                       OnClick="@(() => NavigateTo(ShipperRoutes.WarehouseWorkspace))">
                전체 창고 작업대 열기
            </MudButton>
        </MudStack>
    </WorkModeContent>
</PlatformCommunityHome>

@code {
    private static readonly IReadOnlyList<PlatformHomeQuickAction> QuickActions =
    [
        new("입고", "입고 확인과 적재 흐름을 시작합니다.", ShipperRoutes.WarehouseInboundWorkStart, Icons.Material.Filled.MoveToInbox, Color.Warning),
        new("출고", "피킹과 출고 흐름을 시작합니다.", ShipperRoutes.WarehouseOutboundWorkStart, Icons.Material.Filled.Outbox, Color.Primary),
        new("판매", "판매 주문의 창고 처리 흐름을 시작합니다.", ShipperRoutes.MarketFulfillmentWorkStart, Icons.Material.Filled.Storefront, Color.Info),
        new("운송", "배송대행과 운송 연결 흐름을 시작합니다.", ShipperRoutes.DeliveryAgencyWorkStart, Icons.Material.Filled.LocalShipping, Color.Success)
    ];

    private static readonly IReadOnlyList<HongdalCardinalNavigationOption> CardinalNavigationOptions =
    [
        new("li", "리", "☲", "남", "판매", HongdalCardinalNavigationActionKinds.Route, ShipperRoutes.MarketFulfillmentWorkStart),
        new("dui", "태", "☱", "서", "출고", HongdalCardinalNavigationActionKinds.Route, ShipperRoutes.WarehouseOutboundWorkStart),
        new("kan", "감", "☵", "북", "운송", HongdalCardinalNavigationActionKinds.Route, ShipperRoutes.DeliveryAgencyWorkStart),
        new("zhen", "진", "☳", "동", "입고", HongdalCardinalNavigationActionKinds.Route, ShipperRoutes.WarehouseInboundWorkStart)
    ];

    private static readonly IReadOnlyList<WarehouseAction> WarehouseActions =
    [
        new("입고", "입고 예정 확인과 상품 검수를 진행합니다.", ShipperRoutes.WarehouseInboundWorkStart, Icons.Material.Filled.MoveToInbox, Color.Warning),
        new("출고", "주문에 맞춰 피킹하고 출고를 확정합니다.", ShipperRoutes.WarehouseOutboundWorkStart, Icons.Material.Filled.Outbox, Color.Primary),
        new("판매", "판매 주문과 마켓 풀필먼트 작업을 연결합니다.", ShipperRoutes.MarketFulfillmentWorkStart, Icons.Material.Filled.Storefront, Color.Info),
        new("운송", "배송대행 접수와 후속 운송을 연결합니다.", ShipperRoutes.DeliveryAgencyWorkStart, Icons.Material.Filled.LocalShipping, Color.Success)
    ];

    private void NavigateTo(string route) => Navigation.NavigateTo(route);

    private sealed record WarehouseAction(
        string Title,
        string Description,
        string Route,
        string Icon,
        Color Color);
}
