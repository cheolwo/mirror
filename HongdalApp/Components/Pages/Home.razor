@page "/shipper"
@using Hongdal.Contracts.Common.Inbound
@using Hongdal.Contracts.Common.Inventory
@using HongdalApp.Models.Shipper
@using HongdalApp.Services
@inject AuthApiService AuthApi
@inject IAuthSession AuthSession
@inject 꾸미기보유권동기화Service 꾸미기보유권동기화Service
@inject IShipperOperationsService ShipperOperations
@inject NavigationManager Navigation
@inject ShipperViewVisibilityService ViewVisibilityService
@inject I화주공통콘텐츠Service 화주공통콘텐츠Service
@inject ShipperLocalizationService L

<PageTitle>@L.T("Home.PageTitle")</PageTitle>

<PlatformCommunityHome AppName="살뜰"
                       RoleLabel="화주"
                       AppKey="shipper"
                       UseBaguaRoleTransitionPages="true"
                       UseCompactHomeSummary="true"
                       ShowRealtimeBest="true"
                       QuickActions="QuickActions">
    <CommunityModeContent>
        @if (_혜택콘텐츠 is not null || _공지콘텐츠 is not null)
        {
            <MudCard Elevation="0" Class="shipper-panel">
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@L.T("Home.CommonContent")</MudText>

                        @if (_혜택콘텐츠 is not null)
                        {
                            <MudPaper Elevation="0" Class="pa-3 shipper-panel" Style="border-color: var(--mud-palette-info);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Info">@L.T("Home.Benefit")</MudText>
                                <MudText Typo="Typo.body1" Class="fw-bold">@_혜택콘텐츠.제목</MudText>
                                @if (!string.IsNullOrWhiteSpace(_혜택콘텐츠.설명))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_혜택콘텐츠.설명</MudText>
                                }
                            </MudPaper>
                        }

                        @if (_공지콘텐츠 is not null)
                        {
                            <MudPaper Elevation="0" Class="pa-3 shipper-panel" Style="border-color: var(--mud-palette-warning);">
                                <MudText Typo="Typo.subtitle2" Color="Color.Warning">@L.T("Home.Notice")</MudText>
                                <MudText Typo="Typo.body1" Class="fw-bold">@_공지콘텐츠.제목</MudText>
                                @if (!string.IsNullOrWhiteSpace(_공지콘텐츠.설명))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@_공지콘텐츠.설명</MudText>
                                }
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    </CommunityModeContent>

    <WorkModeContent>
        <MudStack Spacing="3" Class="shipper-page">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="shipper-page-header">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">@L.T("Home.Title")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">홈에서는 현재 상태를 요약하고, 실제 처리는 각 업무 화면에서 진행합니다.</MudText>
                </MudStack>
                @if (isLoggedIn)
                {
                    <MudStack Row="true" Spacing="2" Class="shipper-page-actions">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDashboardAsync">@L.T("Home.Refresh")</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToRequestWizard">@L.T("Home.CreateRequest")</MudButton>
                    </MudStack>
                }
            </MudStack>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <MudAlert Severity="@statusSeverity" Dense="true">@statusMessage</MudAlert>
            }

            @if (!isLoggedIn)
            {
                <Hongdal공통로그인Panel 제목='@L.T("Home.LoginTitle")'
                                 설명='@L.T("Home.LoginDescription")'
                                 아이디Label='@L.T("Home.LoginId")'
                                 비밀번호Label='@L.T("Home.Password")'
                                 일반로그인버튼텍스트='@L.T("Home.Login")'
                                 로그인진행텍스트='@L.T("Home.LoggingIn")'
                                 일반로그인Color="Color.Success"
                                 Class="pa-4 shipper-panel"
                                 Elevation="0"
                                 상태메시지="@statusMessage"
                                 상태Severity="@statusSeverity"
                                 IsBusy="@isBusy"
                                 OnPasswordLogin="LoginAsync"
                                 OnSocialLogin="SocialLoginAsync" />
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-4 shipper-panel" Style="border-color: var(--mud-palette-primary);">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.overline" Color="Color.Primary">지금 확인할 일</MudText>
                            @if (LatestRequest is null)
                            {
                                <MudText Typo="Typo.h6">첫 운송 의뢰를 등록해 주세요.</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">운송 조건을 입력하면 결제와 배차 흐름을 시작할 수 있습니다.</MudText>
                            }
                            else
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.h6">@LatestRequest.의뢰Id</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@ResolvePaymentColor(LatestRequest.결제상태)" Variant="Variant.Outlined">@LatestRequest.결제상태</MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="@ResolveDispatchColor(LatestRequest.배차상태)" Variant="Variant.Outlined">@LatestRequest.배차상태</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">다음 확인: @BuildRequestNextCheck(LatestRequest)</MudText>
                            }
                        </MudStack>
                        <MudStack Row="true" Spacing="1">
                            @if (LatestRequest is not null)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="GoToLatestRequest">상세 보기</MudButton>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToTransportWorkspace">운송 업무 열기</MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>

                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">업무 영역</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">처리할 업무를 선택하면 해당 목적에 집중된 화면으로 이동합니다.</MudText>
                </MudStack>

                <MudGrid>
                    @foreach (var area in DashboardAreas)
                    {
                        <MudItem xs="12" sm="6" lg="3">
                            <MudPaper Elevation="0" Class="pa-4 h-100 shipper-action-card">
                                <MudStack Spacing="2" Class="h-100">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@area.Icon" Color="@area.Color" Size="Size.Large" />
                                        <MudChip T="string" Size="Size.Small" Color="@area.Color" Variant="Variant.Outlined">@area.Status</MudChip>
                                    </MudStack>
                                    <MudStack Spacing="0" Class="flex-grow-1">
                                        <MudText Typo="Typo.subtitle1" Class="fw-bold">@area.Title</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@area.Description</MudText>
                                    </MudStack>
                                    <MudButton Variant="Variant.Text" Color="@area.Color" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => NavigateTo(area.Route))">
                                        업무 열기
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudStack>
    </WorkModeContent>
</PlatformCommunityHome>

@code {
    private List<ShipperRequestItem> requests = [];
    private IReadOnlyList<입고요청항목응답> inbounds = [];
    private IReadOnlyList<재고항목응답> inventory = [];
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private bool isBusy;
    private 홍달위젯콘텐츠Dto? _혜택콘텐츠;
    private 홍달위젯콘텐츠Dto? _공지콘텐츠;

    private bool isLoggedIn => AuthSession.IsLoggedIn;
    private ShipperRequestItem? LatestRequest => requests.OrderByDescending(x => x.생성일시).FirstOrDefault();

    private IReadOnlyList<DashboardArea> DashboardAreas =>
    [
        new(
            "운송 관리",
            "의뢰별 결제, 배차, 운송 진행 상태를 확인하고 후속 작업을 처리합니다.",
            $"{ActiveRequestCount:N0}건 진행",
            ShipperRoutes.TransportWorkspace,
            Icons.Material.Filled.LocalShipping,
            Color.Primary),
        new(
            "창고 운영",
            "입고, 재고, 스캔과 출고 작업을 창고 작업대에서 처리합니다.",
            $"입고 {PendingInboundCount:N0} · 재고 {ActionableInventoryCount:N0}",
            ShipperRoutes.WarehouseWorkspace,
            Icons.Material.Filled.Warehouse,
            Color.Warning),
        new(
            "판매 운영",
            "판매채널 주문과 출고 연결 상태를 확인합니다.",
            "채널 · 출고",
            ShipperRoutes.OrderFulfillment,
            Icons.Material.Filled.Storefront,
            Color.Info),
        new(
            "통관 · 국제",
            "FCL/LCL 판단과 HS 코드 검토처럼 국제 운송에 필요한 업무를 시작합니다.",
            "검토 업무",
            ShipperRoutes.FclLclPlanner,
            Icons.Material.Filled.Public,
            Color.Secondary)
    ];

    private int ActiveRequestCount => requests.Count(x =>
        !IsMatch(x.의뢰상태, "취소", "환불") &&
        !IsMatch(x.배차상태, "배송완료", "하차완료", "완료"));

    private int PendingInboundCount => inbounds.Count(x =>
        string.Equals(x.상태, "입고예정", StringComparison.OrdinalIgnoreCase));

    private int ActionableInventoryCount => inventory.Count(x => x.가용수량 > 0);

    private static readonly IReadOnlyList<PlatformHomeQuickAction> QuickActions =
    [
        new("운송 업무", "결제, 배차, 운송 상태를 의뢰별로 관리합니다.", ShipperRoutes.TransportWorkspace, Icons.Material.Filled.LocalShipping, Color.Primary),
        new("운송 의뢰", "화물 운송 의뢰를 새로 등록합니다.", ShipperRoutes.Request, Icons.Material.Filled.AddRoad, Color.Primary),
        new("창고 작업대", "입고, 재고, 스캔과 출고 작업을 시작합니다.", ShipperRoutes.WarehouseWorkspace, Icons.Material.Filled.Warehouse, Color.Warning),
        new("판매 주문", "판매 채널 주문 출고 알림을 확인합니다.", ShipperRoutes.OrderFulfillment, Icons.Material.Filled.Storefront, Color.Info)
    ];

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.RestoreAsync();
        await 꾸미기보유권동기화Service.RestoreAndSynchronizeAsync();
        await ViewVisibilityService.EnsureLoadedAsync();
        await LoadCommonContentsAsync();
        await LoadDashboardAsync();
    }

    private async Task LoadCommonContentsAsync()
    {
        try
        {
            _혜택콘텐츠 = await 화주공통콘텐츠Service.혜택콘텐츠조회Async();
            _공지콘텐츠 = await 화주공통콘텐츠Service.공지콘텐츠조회Async();
        }
        catch
        {
            _혜택콘텐츠 = null;
            _공지콘텐츠 = null;
        }
    }

    private async Task LoginAsync(공통로그인요청 request)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        statusMessage = null;

        try
        {
            var result = await AuthApi.LoginAsync(request.UserNameOrEmail, request.Password);
            if (!result.IsSuccess)
            {
                statusSeverity = Severity.Error;
                statusMessage = result.ErrorMessage;
                return;
            }

            statusSeverity = Severity.Success;
            statusMessage = L.T("Home.Message.LoginSucceeded", AuthSession.UserName);
            await ViewVisibilityService.ReloadAsync();
        }
        finally
        {
            isBusy = false;
        }

        await LoadDashboardAsync();
    }

    private Task SocialLoginAsync(공통소셜로그인요청 request)
    {
        statusSeverity = Severity.Info;
        statusMessage = $"{request.ProviderDisplayName} 요청을 받았습니다. ProviderId={request.ProviderId}. 화주 계정 연결 정책이 준비되면 활성화합니다.";
        return Task.CompletedTask;
    }

    private async Task LoadDashboardAsync()
    {
        if (!isLoggedIn)
        {
            requests = [];
            inbounds = [];
            inventory = [];
            return;
        }

        try
        {
            requests = (await ShipperOperations.GetRequestsAsync()).ToList();
            inbounds = await ShipperOperations.GetInboundsAsync();
            inventory = await ShipperOperations.GetInventoryAsync();
            statusMessage = null;
        }
        catch (Exception ex)
        {
            requests = [];
            inbounds = [];
            inventory = [];
            statusSeverity = Severity.Error;
            statusMessage = $"서버 API 조회 실패: {ex.Message}";
        }
    }

    private static bool IsMatch(string? value, params string[] keywords)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               keywords.Any(keyword => value.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    private static string BuildRequestNextCheck(ShipperRequestItem request)
    {
        if (IsMatch(request.결제상태, "결제대기", "미결제", "대기"))
        {
            return "결제 확인";
        }

        if (IsMatch(request.배차상태, "매칭중", "배차대기", "대기"))
        {
            return "기사 매칭";
        }

        if (IsMatch(request.배차상태, "기사배정", "배차확정"))
        {
            return "상차 대기";
        }

        if (IsMatch(request.배차상태, "운송중", "상차완료", "운송"))
        {
            return "하차 진행";
        }

        return "상세 확인";
    }

    private static Color ResolvePaymentColor(string status)
    {
        if (IsMatch(status, "결제완료"))
        {
            return Color.Success;
        }

        return IsMatch(status, "결제대기", "미결제", "대기") ? Color.Warning : Color.Default;
    }

    private static Color ResolveDispatchColor(string status)
    {
        if (IsMatch(status, "배송완료", "하차완료", "완료"))
        {
            return Color.Success;
        }

        if (IsMatch(status, "운송중", "상차완료", "운송"))
        {
            return Color.Info;
        }

        return IsMatch(status, "매칭중", "배차대기", "대기") ? Color.Warning : Color.Primary;
    }

    private void GoToLatestRequest()
    {
        if (LatestRequest is not null && !string.IsNullOrWhiteSpace(LatestRequest.의뢰Id))
        {
            Navigation.NavigateTo(ShipperRoutes.RequestDetailFor(LatestRequest.의뢰Id));
        }
    }

    private void GoToRequestWizard() => Navigation.NavigateTo(ShipperRoutes.Request);
    private void GoToTransportWorkspace() => Navigation.NavigateTo(ShipperRoutes.TransportWorkspace);
    private void NavigateTo(string route) => Navigation.NavigateTo(route);

    private sealed record DashboardArea(
        string Title,
        string Description,
        string Status,
        string Route,
        string Icon,
        Color Color);
}
