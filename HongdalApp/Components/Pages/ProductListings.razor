@page "/shipper/sales/listings"
@using Hongdal.Contracts.Common.Sales
@using HongdalApp.Services
@inject NavigationManager Navigation
@inject IShipperSalesService SalesService

<PageTitle>출품 관리</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">출품 관리</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">판매상품과 채널출품 상태를 조회하고 기존 판매상품을 다른 채널로 추가 출품할 수 있습니다.</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.SalesPageComposer))">판매 페이지 만들기</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">새로고침</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.SalesChannels))">채널 연결</MudButton>
            </MudStack>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">판매상품 목록</MudText>
                        @if (isLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (products.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">등록된 판매상품이 없습니다. 재고 허브에서 먼저 판매 등록을 진행해 주세요.</MudAlert>
                        }
                        else
                        {
                            <MudTable Items="products.OrderByDescending(x => x.Id)" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>상품명</MudTh>
                                    <MudTh>판매SKU</MudTh>
                                    <MudTh>판매가</MudTh>
                                    <MudTh>상태</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID">@context.Id</MudTd>
                                    <MudTd DataLabel="상품명">@context.대표상품명</MudTd>
                                    <MudTd DataLabel="판매SKU">@context.판매SKU</MudTd>
                                    <MudTd DataLabel="판매가">@context.판매가.ToString("N0")</MudTd>
                                    <MudTd DataLabel="상태">@context.상태</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="mb-3">채널출품 목록</MudText>
                        @if (isLoading)
                        {
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (listings.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">등록된 채널출품이 없습니다.</MudAlert>
                        }
                        else
                        {
                            <MudTable Items="listings.OrderByDescending(x => x.Id)" Dense="true" Hover="true">
                                <HeaderContent>
                                    <MudTh>ID</MudTh>
                                    <MudTh>판매상품ID</MudTh>
                                    <MudTh>채널계정ID</MudTh>
                                    <MudTh>채널상품번호</MudTh>
                                    <MudTh>출품상태</MudTh>
                                    <MudTh>동기화상태</MudTh>
                                    <MudTh>연동메시지</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="ID">@context.Id</MudTd>
                                    <MudTd DataLabel="판매상품ID">@context.판매상품Id</MudTd>
                                    <MudTd DataLabel="채널계정ID">@context.판매채널계정Id</MudTd>
                                    <MudTd DataLabel="채널상품번호">@context.채널상품번호</MudTd>
                                    <MudTd DataLabel="출품상태">@context.출품상태</MudTd>
                                    <MudTd DataLabel="동기화상태">@context.동기화상태</MudTd>
                                    <MudTd DataLabel="연동메시지">@context.에러메시지</MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6">기존 판매상품 추가 출품</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">이미 등록된 판매상품을 연결된 채널 계정으로 추가 출품합니다.</MudText>
                <MudGrid Class="mt-2">
                    <MudItem xs="12" md="6">
                        <MudSelect T="long?" Label="판매상품" @bind-Value="selectedProductId" Variant="Variant.Outlined">
                            @foreach (var product in products)
                            {
                                <MudSelectItem T="long?" Value="@product.Id">@product.대표상품명 (@product.판매SKU)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="long?" Label="판매채널 계정" @bind-Value="selectedAccountId" Variant="Variant.Outlined">
                            @foreach (var account in accounts)
                            {
                                <MudSelectItem T="long?" Value="@account.Id">@account.채널종류 - @account.상점명</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Success" Disabled="isBusy || !selectedProductId.HasValue || !selectedAccountId.HasValue" OnClick="CreateListingAsync">채널출품 생성</MudButton>
            </MudCardContent>
        </MudCard>
    </MudStack>
</MudContainer>

@code {
    private readonly List<판매상품항목응답> products = [];
    private readonly List<채널출품항목응답> listings = [];
    private readonly List<판매채널계정항목응답> accounts = [];
    private bool isLoading;
    private bool isBusy;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    private long? selectedProductId;
    private long? selectedAccountId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            products.Clear();
            listings.Clear();
            accounts.Clear();

            products.AddRange((await SalesService.GetProductsAsync())?.Items ?? []);
            listings.AddRange((await SalesService.GetListingsAsync())?.Items ?? []);
            accounts.AddRange((await SalesService.GetAccountsAsync())?.Items ?? []);

            selectedProductId ??= products.FirstOrDefault()?.Id;
            selectedAccountId ??= accounts.FirstOrDefault()?.Id;

            messageSeverity = Severity.Info;
            message = $"판매상품 {products.Count}건, 채널출품 {listings.Count}건을 불러왔습니다.";
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateListingAsync()
    {
        if (isBusy || !selectedProductId.HasValue || !selectedAccountId.HasValue)
        {
            return;
        }

        isBusy = true;
        try
        {
            var created = await SalesService.CreateListingAsync(new 채널출품저장요청
            {
                판매상품Id = selectedProductId.Value,
                판매채널계정Id = selectedAccountId.Value
            });

            messageSeverity = Severity.Success;
            message = $"채널출품 {created?.채널상품번호} 을 생성했습니다.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
