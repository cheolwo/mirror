@page "/shipper/settings/views"
@using HongdalApp.Services
@inject ShipperViewVisibilityService ViewVisibilityService

<PageTitle>화면 설정</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">화면 설정</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">필수 화면은 항상 표시되고, 선택 화면만 숨기거나 다시 보이게 할 수 있습니다.</MudText>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        @if (!ViewVisibilityService.IsLoaded)
        {
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudTable Items="ViewVisibilityService.Items.OrderBy(x => x.SortOrder)" Dense="true">
                <HeaderContent>
                    <MudTh>화면</MudTh>
                    <MudTh>필수</MudTh>
                    <MudTh>관리자 정책</MudTh>
                    <MudTh>표시</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="화면">@context.DisplayName</MudTd>
                    <MudTd DataLabel="필수">@(context.IsRequired ? "예" : "아니오")</MudTd>
                    <MudTd DataLabel="관리자 정책">@(context.PolicyEnabled ? "허용" : "숨김")</MudTd>
                    <MudTd DataLabel="표시">
                        <MudSwitch T="bool"
                                   Value="@context.UserVisible"
                                   ValueChanged="@((bool value) => ToggleAsync(context.ViewKey, value))"
                                   Disabled="@(context.IsRequired || !context.PolicyEnabled || isBusy)" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudStack>
</MudContainer>

@code {
    private bool isBusy;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    protected override async Task OnInitializedAsync()
    {
        await ViewVisibilityService.EnsureLoadedAsync();
    }

    private async Task ToggleAsync(string viewKey, bool isVisible)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        message = null;

        try
        {
            await ViewVisibilityService.UpdateVisibilityAsync(viewKey, isVisible);
            messageSeverity = Severity.Success;
            message = "화면 표시 설정을 저장했습니다.";
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
}
