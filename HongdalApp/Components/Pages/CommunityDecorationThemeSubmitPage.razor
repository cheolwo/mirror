@page "/community/decorations/themes/submit"
@using Hongdal.Ui.Common.Areas.App.Components.Community
@using Hongdal.Ui.Common.Areas.App.Services
@inject PlatformCommunityDecorationStateService DecorationState
@inject NavigationManager Navigation

<PageTitle>@(IsMarketTheme ? "디자이너 전통시장 팩 등록" : "디자이너 홈 테마 등록") · Hongdal</PageTitle>

<main class="theme-submit">
    <nav class="theme-submit__breadcrumb">
        <button type="button" @onclick="BackToStore">
            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
            꾸미기 상점
        </button>
    </nav>

    <header class="theme-submit__hero">
        <div>
            <span>DESIGNER THEME PACKAGE</span>
            <h1>@(IsMarketTheme ? "전통시장 꾸미기 팩 등록" : "홈 테마 패키지 등록")</h1>
            <p>@(IsMarketTheme
                ? "시장 고유의 이야기와 표식을 6개 화면 슬롯으로 제안합니다. 플랫폼 검수와 해당 상인회 승인을 모두 받아야 공식 적용됩니다."
                : "기능과 터치 영역은 살뜰이 유지합니다. 디자이너는 8개 시각 슬롯을 하나의 완성된 패키지로 구성합니다.")</p>
        </div>
        <strong>현재 단계 · 내 제작함 초안</strong>
    </header>

    <nav class="theme-submit__preview-toolbar theme-submit__kind" aria-label="디자이너 패키지 종류">
        <button type="button" class="@(!IsMarketTheme ? "is-active" : null)" @onclick="@(() => themeKind = HomeThemeKind)">개인 홈 테마</button>
        <button type="button" class="@(IsMarketTheme ? "is-active" : null)" @onclick="@(() => themeKind = MarketThemeKind)">전통시장 꾸미기 팩</button>
    </nav>

    <div class="theme-submit__layout">
        <aside class="theme-submit__preview-column">
            @if (IsMarketTheme)
            {
                <TraditionalMarketThemePreview Theme="@PreviewMarketManifest"
                                               Title="@(string.IsNullOrWhiteSpace(title) ? "새 전통시장 팩" : title)" />
            }
            else
            {
                <div class="theme-submit__preview-toolbar">
                    <button type="button" class="@(!previewCollapsed ? "is-active" : null)" @onclick="@(() => previewCollapsed = false)">펼친 모습</button>
                    <button type="button" class="@(previewCollapsed ? "is-active" : null)" @onclick="@(() => previewCollapsed = true)">접힌 모습</button>
                    <button type="button" class="@(previewDark ? "is-active" : null)" @onclick="@(() => previewDark = !previewDark)">
                        @(previewDark ? "어두운 배경" : "밝은 배경")
                    </button>
                </div>
                <HongdalHomeNavigatorThemePreview Theme="@PreviewHomeManifest"
                                                          Title="@(string.IsNullOrWhiteSpace(title) ? "새 홈 테마" : title)"
                                                          Collapsed="@previewCollapsed"
                                                          DarkBackground="@previewDark" />
            }
            <section class="theme-submit__checks">
                <strong>자동 확인</strong>
                <p><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> 필수 슬롯 @(ActiveSlotEditors.Count)개 구성</p>
                <p><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" /> @(IsMarketTheme ? "가격·원산지·수령시간 영역 고정" : "태극 마스크와 클릭 영역 고정")</p>
                <p><MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" Size="Size.Small" /> 이미지가 없으면 지정 색상을 사용</p>
            </section>
        </aside>

        <section class="theme-submit__form">
            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <MudAlert Severity="@statusSeverity" Dense="true">@statusMessage</MudAlert>
            }

            <section class="theme-submit__section">
                <div class="theme-submit__section-title">
                    <span>1</span>
                    <div><strong>상품 정보</strong><small>상점 카드와 상세 페이지에 표시됩니다.</small></div>
                </div>
                <label>
                    <span>@(IsMarketTheme ? "시장 팩 이름" : "테마 상품명")</span>
                    <input type="text" maxlength="40" placeholder="@(IsMarketTheme ? "예: 함께 여는 봄 장날" : "예: 물 위의 나무배")" @bind="title" />
                </label>
                <div class="theme-submit__row">
                    <label>
                        <span>디자이너 표시명</span>
                        <input type="text" maxlength="30" placeholder="예: 살뜰 공방" @bind="creatorName" />
                    </label>
                    <label>
                        <span>패키지 버전</span>
                        <input type="text" maxlength="12" placeholder="1.0.0" @bind="version" />
                    </label>
                </div>
                <label>
                    <span>테마 설명</span>
                    <textarea rows="3" maxlength="180" placeholder="테마의 분위기와 디자인 의도를 적어주세요." @bind="summary"></textarea>
                </label>
                @if (IsMarketTheme)
                {
                    <div class="theme-submit__row">
                        <label>
                            <span>대상 전통시장</span>
                            <input type="text" maxlength="60" placeholder="예: 성남 생활권 전통시장" @bind="marketName" />
                        </label>
                        <label>
                            <span>시장 범위 키</span>
                            <input type="text" maxlength="80" placeholder="traditional-market:market-code" @bind="marketScopeKey" />
                        </label>
                    </div>
                    <label>
                        <span>디자이너 보상 제안</span>
                        <input type="text" maxlength="100" placeholder="예: 상인회와 사용 기간·범위별 별도 계약" @bind="designerCompensationPolicy" />
                    </label>
                }
                <div class="theme-submit__row">
                    <label>
                        <span>판매 희망 가격</span>
                        <input type="number" min="0" step="100" @bind="priceAmount" />
                    </label>
                    <label>
                        <span>미리보기 배경</span>
                        <input type="color" @bind="previewBackground" />
                    </label>
                </div>
            </section>

            <section class="theme-submit__section">
                <div class="theme-submit__section-title">
                    <span>2</span>
                    <div><strong>패키지 슬롯</strong><small>각 영역은 색상을 필수로 가지며 이미지는 선택입니다.</small></div>
                </div>
                <div class="theme-submit__slot-grid">
                    @foreach (var slot in ActiveSlotEditors)
                    {
                        <article class="theme-submit-slot">
                            <div class="theme-submit-slot__head">
                                <span style="@($"--slot-color: {slot.Color};")">
                                    @if (!string.IsNullOrWhiteSpace(slot.ImageUrl))
                                    {
                                        <img src="@slot.ImageUrl" alt="@($"{slot.Title} 업로드 미리보기")" />
                                    }
                                </span>
                                <div><strong>@slot.Title</strong><small>@slot.Description</small></div>
                            </div>
                            <label>
                                <span>대체 색상</span>
                                <input type="color" @bind="slot.Color" />
                            </label>
                            <label class="theme-submit-slot__upload">
                                <span>@(string.IsNullOrWhiteSpace(slot.ImageUrl) ? "이미지 선택" : "이미지 교체")</span>
                                <InputFile OnChange="@(args => HandleSlotImageSelectedAsync(args, slot))" accept="image/png,image/webp,image/svg+xml" />
                            </label>
                            @if (!string.IsNullOrWhiteSpace(slot.ImageUrl))
                            {
                                <button type="button" @onclick="@(() => ClearSlotImage(slot))">이미지 제거</button>
                            }
                        </article>
                    }
                </div>
            </section>

            <section class="theme-submit__section">
                <div class="theme-submit__section-title">
                    <span>3</span>
                    <div><strong>권리와 검수</strong><small>실제 판매 연결 전 서버 검수가 추가됩니다.</small></div>
                </div>
                <div class="theme-submit__policy">
                    <MudIcon Icon="@Icons.Material.Filled.Policy" Color="Color.Primary" />
                    <p>@(IsMarketTheme
                        ? "현재 페이지는 시장 팩 제안 초안만 저장합니다. 플랫폼은 이미지 권리와 안전 정보 보존을 검수하고, 해당 상인회가 사용 범위와 디자이너 보상 조건을 별도로 승인합니다."
                        : "SVG는 스크립트와 외부 참조를 제거하는 정제 과정이 필요합니다. 현재 페이지는 로컬 UI 초안이므로 공개 판매·정산을 수행하지 않습니다.")</p>
                </div>
                <label class="theme-submit__rights">
                    <input type="checkbox" @bind="hasRights" />
                    <span>모든 이미지와 디자인을 직접 제작했거나 살뜰 테마로 등록할 권리를 가지고 있습니다.</span>
                </label>
                <label class="theme-submit__rights">
                    <input type="checkbox" @bind="acceptFixedActions" />
                    <span>@(IsMarketTheme
                        ? "가격·수량·원산지·알레르기·보관·수령 시간과 접근성 라벨은 시스템이 관리하며 팩에서 변경할 수 없음을 확인했습니다."
                        : "커뮤니티·상점 이동 영역과 접근성 라벨은 앱이 관리하며 테마에서 변경할 수 없음을 확인했습니다.")</span>
                </label>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Large"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveDraftAsync">
                    @(IsMarketTheme ? "시장 팩 제안 초안 저장" : "초안 저장하고 내 홈에 적용")
                </MudButton>
            </section>
        </section>
    </div>
</main>

@code {
    private const long MaxImageBytes = 2 * 1024 * 1024;
    private const string HomeThemeKind = "home";
    private const string MarketThemeKind = "traditional-market";

    private readonly List<ThemeSlotEditor> homeSlotEditors =
    [
        new("outer-upaya", "바깥 방편", "위·왼쪽·오른쪽을 감싸는 영역", "#CD2E3A"),
        new("outer-prajna", "바깥 반야", "아래쪽 물결 형태 영역", "#0047A0"),
        new("inner-community", "커뮤니티", "안쪽 태극의 커뮤니티 영역", "#171717"),
        new("inner-store", "상점", "안쪽 태극의 상점 영역", "#8B5E3C"),
        new("center-gen", "가운데 간괘", "간괘와 간 표시의 중심", "#1F2937"),
        new("frame", "원형 테두리", "안쪽·바깥쪽 원형 프레임", "#F4EADC"),
        new("labels", "라벨", "방편·반야·커뮤니티·상점 글자", "#FFFFFF"),
        new("closed-handle", "접힌 손잡이", "오른쪽 하단에 접힌 반원", "#7C3AED")
    ];

    private readonly List<ThemeSlotEditor> marketSlotEditors =
    [
        new("market-header", "시장 머리말", "시장 이름과 대표 이야기를 표시하는 머리말", "#146B55"),
        new("board-marker", "게시판 표식", "시장 게시판과 글 목록의 식별 표식", "#B8443C"),
        new("market-day-banner", "장날 배너", "공동 장날과 현장 행사를 알리는 배너", "#C18416"),
        new("product-marker", "상품 표식", "시장 품목과 공동구매 상품의 분류 표식", "#35566B"),
        new("pickup-sign", "수령 표식", "예약 수령 장소와 시간의 식별 표식", "#694F3D"),
        new("story-cover", "성사 이야기", "함께 성사시킨 거래 기록의 표지", "#6D5A88")
    ];

    private string themeKind = HomeThemeKind;
    private string title = string.Empty;
    private string creatorName = string.Empty;
    private string version = "1.0.0";
    private string summary = string.Empty;
    private decimal priceAmount;
    private string previewBackground = "#F8FAFC";
    private string marketName = string.Empty;
    private string marketScopeKey = "traditional-market:";
    private string designerCompensationPolicy = "디자이너와 상인회가 사용 기간·범위별로 별도 협의";
    private bool previewCollapsed;
    private bool previewDark;
    private bool hasRights;
    private bool acceptFixedActions;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;

    private bool IsMarketTheme
        => string.Equals(themeKind, MarketThemeKind, StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<ThemeSlotEditor> ActiveSlotEditors
        => IsMarketTheme ? marketSlotEditors : homeSlotEditors;

    private HomeNavigatorThemeManifest PreviewHomeManifest => new(
        string.IsNullOrWhiteSpace(version) ? "1.0.0" : version.Trim(),
        "neutral-taegeuk-v1",
        "초안",
        "살뜰 앱 내 개인 사용",
        previewBackground,
        ToHomeSlot("outer-upaya"),
        ToHomeSlot("outer-prajna"),
        ToHomeSlot("inner-community"),
        ToHomeSlot("inner-store"),
        ToHomeSlot("center-gen"),
        ToHomeSlot("frame"),
        ToHomeSlot("labels"),
        ToHomeSlot("closed-handle"));

    private TraditionalMarketThemeManifest PreviewMarketManifest => new(
        string.IsNullOrWhiteSpace(version) ? "1.0.0" : version.Trim(),
        "traditional-market-surfaces-v1",
        "초안",
        "검토 전",
        "상인회 승인 범위 내 사용",
        string.IsNullOrWhiteSpace(marketScopeKey) ? "traditional-market:draft" : marketScopeKey.Trim(),
        string.IsNullOrWhiteSpace(marketName) ? "새 전통시장" : marketName.Trim(),
        previewBackground,
        ToMarketSlot("market-header"),
        ToMarketSlot("board-marker"),
        ToMarketSlot("market-day-banner"),
        ToMarketSlot("product-marker"),
        ToMarketSlot("pickup-sign"),
        ToMarketSlot("story-cover"),
        true,
        string.IsNullOrWhiteSpace(designerCompensationPolicy)
            ? "디자이너와 상인회 별도 협의"
            : designerCompensationPolicy.Trim());

    private HomeNavigatorThemeSlot ToHomeSlot(string key)
    {
        var editor = homeSlotEditors.First(item => item.Key == key);
        return new(editor.Key, editor.Title, editor.Color, editor.ImageUrl, $"{editor.Title} 디자이너 이미지");
    }

    private TraditionalMarketThemeSlot ToMarketSlot(string key)
    {
        var editor = marketSlotEditors.First(item => item.Key == key);
        return new(editor.Key, editor.Title, editor.Color, editor.ImageUrl, $"{editor.Title} 디자이너 이미지");
    }

    private async Task HandleSlotImageSelectedAsync(InputFileChangeEventArgs args, ThemeSlotEditor slot)
    {
        var file = args.File;
        if (file.Size > MaxImageBytes)
        {
            statusSeverity = Severity.Warning;
            statusMessage = $"{slot.Title} 이미지는 2MB 이하로 등록해 주세요.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory);
            slot.ImageUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(memory.ToArray())}";
            statusSeverity = Severity.Success;
            statusMessage = $"{slot.Title}에 {file.Name} 이미지를 넣었습니다.";
        }
        catch (Exception)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"{slot.Title} 이미지를 읽지 못했습니다.";
        }
    }

    private void ClearSlotImage(ThemeSlotEditor slot)
    {
        slot.ImageUrl = null;
        statusSeverity = Severity.Info;
        statusMessage = $"{slot.Title} 이미지를 제거하고 대체 색상을 사용합니다.";
    }

    private Task SaveDraftAsync()
    {
        if (!hasRights || !acceptFixedActions)
        {
            statusSeverity = Severity.Warning;
            statusMessage = "디자인 권리와 고정 이동 영역 정책을 모두 확인해 주세요.";
            return Task.CompletedTask;
        }

        var created = IsMarketTheme
            ? DecorationState.TryCreateTraditionalMarketThemePackage(
                title,
                creatorName,
                summary,
                priceAmount,
                PreviewMarketManifest,
                out var product,
                out var message)
            : DecorationState.TryCreateHomeThemePackage(
                title,
                creatorName,
                summary,
                priceAmount,
                PreviewHomeManifest,
                out product,
                out message);
        if (!created)
        {
            statusSeverity = Severity.Warning;
            statusMessage = message;
            return Task.CompletedTask;
        }

        if (product is not null)
        {
            Navigation.NavigateTo(ShipperRoutes.CommunityDecorationDetailFor(product.Key));
        }

        return Task.CompletedTask;
    }

    private void BackToStore()
        => Navigation.NavigateTo(ShipperRoutes.CommunityDecorations);

    private sealed class ThemeSlotEditor(string key, string title, string description, string color)
    {
        public string Key { get; } = key;
        public string Title { get; } = title;
        public string Description { get; } = description;
        public string Color { get; set; } = color;
        public string? ImageUrl { get; set; }
    }
}
