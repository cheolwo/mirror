@page "/"
@implements IDisposable
@inject HongdalClientRoleService RoleService

<PageTitle>살뜰</PageTitle>

@if (RoleService.IsWarehouseManager)
{
    <WarehouseManagerRoleHome />
}
else if (RoleService.IsShipper)
{
    <Home />
}
else
{
    <RoleNeutralHome />
}

@code {
    protected override void OnInitialized()
    {
        RoleService.Changed += HandleRoleChanged;
    }

    private void HandleRoleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        RoleService.Changed -= HandleRoleChanged;
    }
}
