@page "/shipper/international/fcl-lcl"
@using HongdalApp.Services
@inject NavigationManager Navigation

<PageTitle>FCL/LCL 판단 및 협의</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">FCL/LCL 판단 및 수입 판매 협의</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    구매 전 단계에서 화물량, 팔레트 배송대행 비용, 통관 비용, 예상 판매가를 함께 보고 수입 여부와 커뮤니티 수요 확인 방향을 잡습니다.
                </MudText>
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.ShipperHome))">
                살뜰 홈
            </MudButton>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" lg="5">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                    <MudStack Spacing="3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">구매 전 입력값</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                실제 견적 전 단계의 판단 보조값입니다. 최종 운임과 세금은 배송대행 담당자, 포워더, 관세사 확인이 필요합니다.
                            </MudText>
                        </MudStack>

                        <MudTextField T="string"
                                      Label="수입 검토 상품"
                                      @bind-Value="productName"
                                      Variant="Variant.Outlined"
                                      Placeholder="예: 접이식 캠핑 테이블" />

                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Label="총 부피 CBM" @bind-Value="cargoCbm" Min="0" Step="0.5M" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Label="총 중량 kg" @bind-Value="cargoWeightKg" Min="0" Step="50M" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="int" Label="팔레트 수" @bind-Value="palletCount" Min="0" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="int" Label="예상 수량" @bind-Value="unitCount" Min="1" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Label="매입 단가" @bind-Value="purchaseUnitPrice" Min="0" Step="100M" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Label="예상 판매가" @bind-Value="saleUnitPrice" Min="0" Step="100M" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Label="팔레트당 배송대행비" @bind-Value="agencyFeePerPallet" Min="0" Step="10000M" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" Label="관세/부가세 등 예상률 %" @bind-Value="customsTaxRatePercent" Min="0" Step="1M" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Label="희망 출발" @bind-Value="departureUrgency" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@UrgencyFlexible">일정 유연</MudSelectItem>
                                    <MudSelectItem T="string" Value="@UrgencyNormal">일반</MudSelectItem>
                                    <MudSelectItem T="string" Value="@UrgencyUrgent">긴급</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        <MudCheckBox T="bool" @bind-Value="canBeConsolidated" Label="다른 화물과 혼재 가능" Color="Color.Primary" />
                        <MudCheckBox T="bool" @bind-Value="needsExclusiveHandling" Label="파손/온도/브랜드 사유로 단독 취급 선호" Color="Color.Warning" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Calculate" OnClick="Recalculate">
                            판단 새로 계산
                        </MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudStack Spacing="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">추천 판단</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Recommendation.Reason</MudText>
                                </MudStack>
                                <MudChip T="string" Color="@Recommendation.Color" Variant="Variant.Filled">@Recommendation.Mode</MudChip>
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="12" sm="4">@Metric("20ft 사용률", $"{TwentyFootUtilization:P0}", Color.Info)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("40ft 사용률", $"{FortyFootUtilization:P0}", Color.Secondary)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("협의 우선도", Recommendation.Priority, Recommendation.Color)</MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">수입 판매 예측</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="4">@Metric("예상 배송대행비", Money(TotalAgencyFee), Color.Info)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("예상 통관/세금", Money(EstimatedCustomsTax), Color.Warning)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("단위당 예상 원가", Money(EstimatedUnitCost), MarginColor)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("총 예상 매출", Money(ExpectedRevenue), Color.Success)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("예상 이익", Money(ExpectedProfit), MarginColor)</MudItem>
                                <MudItem xs="12" sm="4">@Metric("예상 마진율", $"{ExpectedMarginRate:P1}", MarginColor)</MudItem>
                            </MudGrid>
                            <MudAlert Severity="@MarginSeverity" Dense="true" Variant="Variant.Outlined">
                                @MarginMessage
                            </MudAlert>
                        </MudStack>
                    </MudPaper>

                    <HongdalSensitiveDisclosureList Title="FCL/LCL 협의 상세"
                                                    Summary="@Recommendation.Summary"
                                                    RelatedParties="화주 · 배송대행 담당자 · 포워더 · 관세사 · 국내 운송 기사 · 선구매 관심 고객"
                                                    Icon="@Icons.Material.Filled.Public"
                                                    Color="@Recommendation.Color"
                                                    PrivacyHint="매입가, 공급처, 실제 출발지는 협의가 필요한 순간에만 상세로 펼쳐 확인합니다.">
                        <MudExpansionPanel Text="판단 기준" Expanded="true">
                            <HongdalSensitiveInfoRow Label="FCL 고려" Value="@Recommendation.FclCondition" />
                            <HongdalSensitiveInfoRow Label="LCL 고려" Value="@Recommendation.LclCondition" />
                            <HongdalSensitiveInfoRow Label="보류/추가 확인" Value="@Recommendation.HoldCondition" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="배송대행/통관 협의 항목">
                            <HongdalSensitiveInfoRow Label="해외 창고" Value="입고 가능일, 보관 가능 기간, 출고 마감 시간을 확인" />
                            <HongdalSensitiveInfoRow Label="포워더" Value="컨테이너 공간, 선적 스케줄, LCL 혼재 가능 여부 확인" />
                            <HongdalSensitiveInfoRow Label="관세사" Value="HS 코드, 수입 신고 서류, 식품/검역 대상 여부 확인" />
                            <HongdalSensitiveInfoRow Label="판매 준비" Value="선구매 관심 수량, 예상 판매가, 상세페이지/인증 필요 여부 확인" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="다음 액션">
                            <HongdalSensitiveInfoRow Label="1단계" Value="배송대행 담당자에게 FCL/LCL 판단 결과 공유" />
                            <HongdalSensitiveInfoRow Label="2단계" Value="커뮤니티에 선구매/수요 확인 글을 올려 판매 가능성 확인" />
                            <HongdalSensitiveInfoRow Label="3단계" Value="HS 코드 검토 또는 수입 통관 풀필먼트 계약 필요 여부 확인" />
                            <HongdalSensitiveInfoRow Label="4단계" Value="입항 후 국내 운송 의뢰 또는 재위탁 운송 의뢰로 전환" />
                        </MudExpansionPanel>
                    </HongdalSensitiveDisclosureList>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">커뮤니티 수요 확인 글 초안</MudText>
                            <MudTextField T="string"
                                          Value="@CommunityDemandDraft"
                                          ReadOnly="true"
                                          Lines="9"
                                          Variant="Variant.Outlined" />
                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Forum"
                                           OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.ShipperHome))">
                                    커뮤니티에서 글쓰기
                                </MudButton>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    현재는 초안을 확인한 뒤 커뮤니티 글쓰기 영역에 옮겨 등록하는 방식입니다. 다음 단계에서 초안 자동 주입으로 확장할 수 있습니다.
                                </MudText>
                            </MudStack>
                        </MudStack>
                    </MudPaper>

                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.CustomsHsReviews))">
                            HS/통관 검토로 이동
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.LocalShipping" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.Request))">
                            국내 운송 의뢰로 전환
                        </MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Info" StartIcon="@Icons.Material.Filled.Public" OnClick="@(() => Navigation.NavigateTo(ShipperRoutes.InternationalForwardingWorkStart))">
                            배송대행 작업 확인
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    private const string UrgencyFlexible = "Flexible";
    private const string UrgencyNormal = "Normal";
    private const string UrgencyUrgent = "Urgent";

    private string productName = "접이식 캠핑 테이블";
    private decimal cargoCbm = 18;
    private decimal cargoWeightKg = 6800;
    private int palletCount = 10;
    private int unitCount = 240;
    private decimal purchaseUnitPrice = 18500;
    private decimal saleUnitPrice = 39000;
    private decimal agencyFeePerPallet = 85000;
    private decimal customsTaxRatePercent = 18;
    private string departureUrgency = UrgencyNormal;
    private bool canBeConsolidated = true;
    private bool needsExclusiveHandling;

    private FclLclRecommendation Recommendation => BuildRecommendation();

    private decimal TwentyFootUtilization => Math.Clamp(cargoCbm / 28m, 0m, 1.5m);

    private decimal FortyFootUtilization => Math.Clamp(cargoCbm / 58m, 0m, 1.5m);

    private decimal TotalPurchaseAmount => purchaseUnitPrice * Math.Max(unitCount, 0);

    private decimal TotalAgencyFee => agencyFeePerPallet * Math.Max(palletCount, 0);

    private decimal EstimatedCustomsTax => TotalPurchaseAmount * (customsTaxRatePercent / 100m);

    private decimal EstimatedTotalCost => TotalPurchaseAmount + TotalAgencyFee + EstimatedCustomsTax;

    private decimal EstimatedUnitCost => unitCount <= 0 ? 0 : EstimatedTotalCost / unitCount;

    private decimal ExpectedRevenue => saleUnitPrice * Math.Max(unitCount, 0);

    private decimal ExpectedProfit => ExpectedRevenue - EstimatedTotalCost;

    private decimal ExpectedMarginRate => ExpectedRevenue <= 0 ? 0 : ExpectedProfit / ExpectedRevenue;

    private Color MarginColor => ExpectedProfit > 0 && ExpectedMarginRate >= 0.15m
        ? Color.Success
        : ExpectedProfit > 0
            ? Color.Warning
            : Color.Error;

    private Severity MarginSeverity => ExpectedProfit > 0 && ExpectedMarginRate >= 0.15m
        ? Severity.Success
        : ExpectedProfit > 0
            ? Severity.Warning
            : Severity.Error;

    private string MarginMessage => ExpectedProfit > 0 && ExpectedMarginRate >= 0.15m
        ? "현재 입력값 기준으로 판매 여지가 있어 보입니다. 선구매 관심 수량을 커뮤니티에서 먼저 확인해도 좋습니다."
        : ExpectedProfit > 0
            ? "이익은 남지만 마진이 얇습니다. 팔레트 배송대행비, 통관 비용, 판매가를 다시 확인하는 편이 좋습니다."
            : "현재 판매가로는 손실 가능성이 있습니다. 구매 전 수요 확인, 판매가 조정, 배송 방식 재검토가 필요합니다.";

    private string CommunityDemandDraft =>
        $"[{productName}] 수입 전 선구매/수요 확인\n\n" +
        $"수입 검토 상품: {productName}\n" +
        $"예상 수량: {unitCount:N0}개 / 팔레트: {palletCount:N0}개 / 화물량: {cargoCbm:0.0}CBM\n" +
        $"현재 물류 판단: {Recommendation.Mode}\n" +
        $"예상 판매가: {Money(saleUnitPrice)} / 선구매 관심 고객에게는 더 낮은 가격을 검토 중입니다.\n\n" +
        "구매 의사가 있으신 분은 댓글로 희망 수량, 원하는 가격대, 필요한 배송 지역을 남겨주세요.\n" +
        "관심 수량이 모이면 통관/배송대행 비용을 다시 계산해서 실제 진행 여부를 공유하겠습니다.";

    private void Recalculate()
    {
        StateHasChanged();
    }

    private FclLclRecommendation BuildRecommendation()
    {
        if (needsExclusiveHandling || !canBeConsolidated)
        {
            return new(
                "FCL 우선",
                Color.Primary,
                "단독 취급 조건이 있어 FCL 또는 단독 공간 확보 협의가 우선입니다.",
                "단독 취급 필요",
                "파손, 온도, 브랜드, 보안 사유가 있으면 컨테이너 공간을 단독으로 잡는 쪽을 먼저 검토합니다.",
                "혼재 가능하더라도 예외 조건이 있으면 LCL은 보류합니다.",
                "포장 조건과 보험, 선적 책임 범위를 먼저 확인해야 합니다.",
                "높음");
        }

        if (cargoCbm >= 18 || cargoWeightKg >= 8000 || palletCount >= 10)
        {
            return new(
                "FCL 검토",
                Color.Primary,
                "화물량이 20ft 컨테이너 일부 이상을 차지해 FCL 견적 비교가 필요합니다.",
                "컨테이너 견적 비교 필요",
                "CBM, 중량, 팔레트 수가 일정 수준 이상이면 FCL 견적을 함께 받아야 합니다.",
                "출발 일정이 유연하고 혼재 가능하면 LCL 견적도 비교합니다.",
                "FCL과 LCL 견적 차이, 출항 일정, 도착 후 국내 운송비를 같이 봅니다.",
                departureUrgency == UrgencyUrgent ? "높음" : "중간");
        }

        if (cargoCbm <= 12 && canBeConsolidated && departureUrgency != UrgencyUrgent)
        {
            return new(
                "LCL 우선",
                Color.Success,
                "화물량이 작고 혼재 가능하므로 LCL로 배송대행 협의를 시작하는 것이 자연스럽습니다.",
                "혼재 견적 우선",
                "FCL은 공간이 많이 남아 비용 효율이 낮을 수 있습니다.",
                "CBM이 작고 혼재 가능하면 LCL 견적과 출발 스케줄을 먼저 확인합니다.",
                "혼재 금지 품목, 파손 위험, 출발 마감일은 별도로 확인합니다.",
                "낮음");
        }

        return new(
            "비교 견적",
            Color.Warning,
            "화물량이 중간 구간이라 FCL과 LCL 견적, 출항 일정, 국내 운송 연결을 함께 비교해야 합니다.",
            "FCL/LCL 동시 비교",
            "20ft 사용률이 올라가면 FCL 견적이 유리해질 수 있습니다.",
            "혼재 가능성과 출발 일정 여유가 있으면 LCL도 유효합니다.",
            "포워더에게 FCL, LCL, 혼재 마감일을 동시에 확인합니다.",
            "중간");
    }

    private static string Money(decimal value) => $"{value:N0}원";

    private static RenderFragment Metric(string label, string value, Color color) => builder =>
    {
        builder.OpenComponent<MudPaper>(0);
        builder.AddAttribute(1, "Elevation", 0);
        builder.AddAttribute(2, "Outlined", true);
        builder.AddAttribute(3, "Class", "pa-3 h-100");
        builder.AddAttribute(4, "ChildContent", (RenderFragment)(childBuilder =>
        {
            childBuilder.OpenComponent<MudText>(0);
            childBuilder.AddAttribute(1, "Typo", Typo.caption);
            childBuilder.AddAttribute(2, "Color", Color.Secondary);
            childBuilder.AddAttribute(3, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, label)));
            childBuilder.CloseComponent();
            childBuilder.OpenComponent<MudText>(4);
            childBuilder.AddAttribute(5, "Typo", Typo.h6);
            childBuilder.AddAttribute(6, "Color", color);
            childBuilder.AddAttribute(7, "ChildContent", (RenderFragment)(textBuilder => textBuilder.AddContent(0, value)));
            childBuilder.CloseComponent();
        }));
        builder.CloseComponent();
    };

    private sealed record FclLclRecommendation(
        string Mode,
        Color Color,
        string Reason,
        string Summary,
        string FclCondition,
        string LclCondition,
        string HoldCondition,
        string Priority);
}
