@page "/shipper/warehouse/scan"
@inject NavigationManager Navigation

<PageTitle>Warehouse scan</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">Warehouse scan</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Receive inbound, split products, create bundles, and put away stock with barcode scans.
                </MudText>
            </MudStack>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.RestartAlt"
                       Disabled="@(_scans.Count == 0 && _completedActions.Count == 0)"
                       OnClick="ResetAsync">
                Reset
            </MudButton>
        </MudStack>

        <MudGrid>
            <MudItem xs="12" lg="4">
                <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--mud-palette-divider); border-radius:8px;">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle1">Work step</MudText>
                        <MudSelect T="string"
                                   Label="Step"
                                   Value="@_step"
                                   ValueChanged="ChangeStepAsync"
                                   Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@WarehouseScanStepCode.ReceiveInbound">Inbound receive</MudSelectItem>
                            <MudSelectItem T="string" Value="@WarehouseScanStepCode.SplitProduct">Product split</MudSelectItem>
                            <MudSelectItem T="string" Value="@WarehouseScanStepCode.CreateBundle">Bundle create</MudSelectItem>
                            <MudSelectItem T="string" Value="@WarehouseScanStepCode.PutAway">Put away</MudSelectItem>
                        </MudSelect>

                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            Barcode prefixes: INB, SKU, LOC, BND, HU.
                        </MudAlert>

                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">Sample scans</MudText>
                            @foreach (var sample in SampleCodes)
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => AddSampleAsync(sample))">
                                    @sample
                                </MudButton>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--mud-palette-divider); border-radius:8px;">
                    <HongdalWarehouseScanStation Step="@_step"
                                                 Scans="@_scans"
                                                 ScansChanged="OnScansChangedAsync"
                                                 ActionConfirmed="OnActionConfirmedAsync"
                                                 Title="@StepTitle"
                                                 ConfirmButtonText="Confirm step"
                                                 ClearButtonText="Clear scans"
                                                 ScannerId="shipper-scan-station" />
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--mud-palette-divider); border-radius:8px;">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle1">Completed actions</MudText>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@_completedActions.Count</MudChip>
                </MudStack>

                @if (_completedActions.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No scan action has been confirmed yet.</MudText>
                }
                else
                {
                    <MudTable T="CompletedScanAction" Items="@_completedActions.OrderByDescending(x => x.CompletedAt)" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Time</MudTh>
                            <MudTh>Action</MudTh>
                            <MudTh>Scans</MudTh>
                            <MudTh>Next</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Time">@context.CompletedAt.ToLocalTime().ToString("HH:mm:ss")</MudTd>
                            <MudTd DataLabel="Action">@context.DisplayName</MudTd>
                            <MudTd DataLabel="Scans">@context.ScanSummary</MudTd>
                            <MudTd DataLabel="Next">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.ChevronRight" OnClick="() => GoToNext(context)">
                                    @context.NextActionLabel
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private readonly List<WarehouseBarcodeScan> _scans = [];
    private readonly List<CompletedScanAction> _completedActions = [];
    private string _step = WarehouseScanStepCode.ReceiveInbound;

    private string StepTitle => _step switch
    {
        WarehouseScanStepCode.ReceiveInbound => "Inbound receive",
        WarehouseScanStepCode.SplitProduct => "Product split",
        WarehouseScanStepCode.CreateBundle => "Bundle create",
        WarehouseScanStepCode.PutAway => "Put away",
        _ => "Warehouse scan"
    };

    private static IReadOnlyList<string> SampleCodes =>
    [
        "INB:1001",
        "SKU:ABC-100",
        "HU:BOX-01",
        "BND:PKG-01",
        "LOC:A-01-02"
    ];

    private Task ChangeStepAsync(string step)
    {
        _step = step;
        _scans.Clear();
        return Task.CompletedTask;
    }

    private Task OnScansChangedAsync(IReadOnlyList<WarehouseBarcodeScan> scans)
    {
        _scans.Clear();
        _scans.AddRange(scans);
        return Task.CompletedTask;
    }

    private Task AddSampleAsync(string rawCode)
    {
        var scan = WarehouseBarcodeParser.Parse(rawCode, scannerId: "sample");
        _scans.RemoveAll(x => string.Equals(x.RawCode, scan.RawCode, StringComparison.OrdinalIgnoreCase));
        _scans.Add(scan);
        return Task.CompletedTask;
    }

    private Task OnActionConfirmedAsync(WarehouseScanAction action)
    {
        if (!action.IsReady)
        {
            return Task.CompletedTask;
        }

        var next = ResolveNextAction(action.Step);
        _completedActions.Add(new CompletedScanAction(
            DateTimeOffset.Now,
            action.ActionCode,
            action.DisplayName,
            string.Join(", ", action.Scans.Select(x => $"{x.Kind}:{x.Value}")),
            next.Label,
            next.Route));

        _scans.Clear();
        return Task.CompletedTask;
    }

    private Task ResetAsync()
    {
        _scans.Clear();
        _completedActions.Clear();
        return Task.CompletedTask;
    }

    private void GoToNext(CompletedScanAction action)
    {
        Navigation.NavigateTo(action.NextRoute);
    }

    private static (string Label, string Route) ResolveNextAction(string step)
    {
        return step switch
        {
            WarehouseScanStepCode.ReceiveInbound => ("Open inbound requests", ShipperRoutes.InboundRequests),
            WarehouseScanStepCode.SplitProduct => ("Open inventory hub", ShipperRoutes.WarehouseInventory),
            WarehouseScanStepCode.CreateBundle => ("Open inventory hub", ShipperRoutes.WarehouseInventory),
            WarehouseScanStepCode.PutAway => ("Open inventory hub", ShipperRoutes.WarehouseInventory),
            _ => ("Open warehouse dashboard", ShipperRoutes.InboundDashboard)
        };
    }

    private sealed record CompletedScanAction(
        DateTimeOffset CompletedAt,
        string ActionCode,
        string DisplayName,
        string ScanSummary,
        string NextActionLabel,
        string NextRoute);
}
