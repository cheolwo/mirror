@page "/shipper"

<WebPageHeader Eyebrow="Shipper Web"
               Title="화주·판매자 웹 작업공간"
               Description="살뜰 앱의 운송, 입고, 창고, 판매채널, 통관 흐름을 하나의 웹 업무공간에서 확인합니다."
               Badge="살뜰 앱 라우트 통합" />

<MudGrid>
    <MudItem xs="12" lg="8">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">운송 업무</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">운송 의뢰 등록, 공개 화물, 탐색 문의, 결제/정산 타임라인을 먼저 닫습니다.</MudText>
                </MudStack>
                <WebPageLinkGrid Items="TransportLinks" />
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">입고·창고 업무</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">입고 예정, 재고, 재위탁 운송, 스캔 검증 화면을 화주 관점으로 묶습니다.</MudText>
                </MudStack>
                <WebPageLinkGrid Items="WarehouseLinks" />
            </MudStack>
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">판매·통관 업무</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">판매채널, 출품, 주문 출고, HS 검토, FCL/LCL 판단을 같은 셸 안에 둡니다.</MudText>
                </MudStack>
                <WebPageLinkGrid Items="CommerceLinks" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">의뢰 상태 타임라인</MudText>
                <div class="web-timeline">
                    @foreach (var item in Timeline)
                    {
                        <MudStack Spacing="0" Class="mb-3">
                            <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                        </MudStack>
                    }
                </div>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static readonly IReadOnlyList<WebAppPageLink> TransportLinks =
    [
        new("운송 의뢰 작성", "화물, 운송, 절차/결제 정보를 한 화면에서 입력합니다.", ShipperRoutes.Request, Icons.Material.Filled.PostAdd, "운송"),
        new("CSV 일괄등록", "대량 운송 의뢰를 표 형태로 붙여넣고 미리보기합니다.", ShipperRoutes.RequestBulk, Icons.Material.Filled.UploadFile, "운송"),
        new("공개 화물정보", "공개 상태의 화물 목록과 배차 가능 상태를 확인합니다.", ShipperRoutes.PublicCargo, Icons.Material.Filled.ViewList, "운송"),
        new("받은 탐색 문의함", "기사나 파트너가 먼저 보낸 운행 가능성 문의에 응답합니다.", ShipperRoutes.ExplorationInbox, Icons.Material.Filled.Inbox, "운송"),
        new("결제/정산 상태 점검", "결제상태와 정산상태 변화가 화면에 반영되는지 확인합니다.", ShipperRoutes.PaymentStatus, Icons.Material.Filled.Payments, "운송"),
        new("의뢰 상세 타임라인", "결제, 배차, 수락, 상차, 하차, 정산 상태를 한 화면으로 검증합니다.", ShipperRoutes.RequestDetailFor("HD-WEB-001"), Icons.Material.Filled.Timeline, "운송")
    ];

    private static readonly IReadOnlyList<WebAppPageLink> WarehouseLinks =
    [
        new("입고 대시보드", "창고, 입고예정, 입고완료, 보관 재고 요약을 확인합니다.", ShipperRoutes.InboundDashboard, Icons.Material.Filled.Dashboard, "창고"),
        new("입고 현황", "창고와 입고 요청을 등록하고 입고완료 처리로 재고를 생성합니다.", ShipperRoutes.InboundRequests, Icons.Material.Filled.MoveToInbox, "창고"),
        new("창고 작업대", "화주가 봐야 할 입고, 재고, 재위탁, 주문 출고 링크를 모읍니다.", ShipperRoutes.WarehouseWorkspace, Icons.Material.Filled.Warehouse, "창고"),
        new("재고 목록", "가용 재고를 판매 등록 또는 재위탁 운송으로 연결합니다.", ShipperRoutes.WarehouseInventory, Icons.Material.Filled.Inventory2, "창고"),
        new("창고 스캔", "입고, 상품, 번들, 적재 위치 바코드 흐름을 브라우저 입력으로 검증합니다.", ShipperRoutes.WarehouseScan, Icons.Material.Filled.QrCodeScanner, "창고"),
        new("재위탁 운송", "창고 재고를 기사 운송 의뢰로 전환하는 입력 흐름입니다.", ShipperRoutes.ReconsignmentOrders, Icons.Material.Filled.LocalShipping, "창고")
    ];

    private static readonly IReadOnlyList<WebAppPageLink> CommerceLinks =
    [
        new("판매채널 연결", "스마트스토어, 쿠팡, 해외 채널 계정 연결 상태를 관리합니다.", ShipperRoutes.SalesChannels, Icons.Material.Filled.Storefront, "판매"),
        new("출품 관리", "판매상품과 채널출품 상태를 조회하고 추가 출품합니다.", ShipperRoutes.ProductListings, Icons.Material.Filled.Sell, "판매"),
        new("주문 출고 알림", "판매채널 주문을 재고, 피킹, 포장 흐름으로 연결합니다.", ShipperRoutes.OrderFulfillment, Icons.Material.Filled.Outbox, "판매"),
        new("FCL/LCL 판단", "수입 전 화물량, 비용, 판매 마진을 기준으로 운송 방식을 비교합니다.", ShipperRoutes.FclLclPlanner, Icons.Material.Filled.Public, "통관"),
        new("HS 코드 검토", "HS 코드 리스크와 관세사 검토 상태를 확인합니다.", ShipperRoutes.CustomsHsReviews, Icons.Material.Filled.FactCheck, "통관"),
        new("화주 화면 설정", "통합 웹앱에서 표시할 화주 업무 화면을 확인합니다.", ShipperRoutes.ViewSettings, Icons.Material.Filled.Settings, "설정")
    ];

    private static readonly IReadOnlyList<(string Title, string Description)> Timeline =
    [
        ("의뢰 작성", "화주가 화물, 운송, 결제 조건을 입력합니다."),
        ("배차 추천", "서버가 기사 후보를 찾고 추천을 보냅니다."),
        ("기사 수락", "수락 후 화주에게 준비 알림이 전달됩니다."),
        ("상차/하차 증빙", "사진 업로드가 완료된 뒤 상태가 변경됩니다."),
        ("정산", "하차 완료 후 결제/입금 상태를 관리합니다.")
    ];
}
