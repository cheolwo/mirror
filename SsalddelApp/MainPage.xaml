<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SsalddelApp"
             xmlns:components="clr-namespace:SsalddelApp.Components"
             x:Class="SsalddelApp.MainPage"
             SafeAreaEdges="Container">

    <Grid>
    <BlazorWebView x:Name="blazorWebView"
                   HostPage="wwwroot/index.html"
                   StartPath="/">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app"
                           ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
    <AbsoluteLayout x:Name="mapOverlay" InputTransparent="True" CascadeInputTransparent="False" />
    </Grid>
</ContentPage>
