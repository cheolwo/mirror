@page "/shipper/transport"
@using SsalddelApp.Models.Shipper
@using SsalddelApp.Services
@using Ssalddel.Client.Infrastructure.Transport
@using Ssalddel.Contracts.Shipper.Request
@using SsalddelApp.ViewModels.Shipper
@inject IAuthSession AuthSession
@inject IShipperOperationsService ShipperOperations
@inject ITransportRequestLedgerObserver LedgerObserver
@inject NavigationManager Navigation
@inject ShipperLocalizationService L
@implements IDisposable

<PageTitle>운송 업무</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">운송 업무</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">의뢰별 현재 상태와 다음 확인을 보고, 필요한 상세로 이동합니다.</MudText>
            </MudStack>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@loading" OnClick="LoadAsync">새로고침</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="GoToRequestWizard">운송 의뢰 등록</MudButton>
            </MudStack>
        </MudStack>

        @if (!AuthSession.IsLoggedIn)
        {
            <MudAlert Severity="Severity.Warning">
                운송 의뢰를 확인하려면 홈에서 먼저 로그인해 주세요.
                <MudButton Variant="Variant.Text" Color="Color.Warning" Href="@ShipperRoutes.Home">홈으로 이동</MudButton>
            </MudAlert>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="@messageSeverity" Dense="true">@message</MudAlert>
            }

            @if (loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2" role="status">운송 의뢰를 불러오는 중입니다.</MudText>
            }

            @if (hasLoaded)
            {
            <MudGrid>
                @foreach (var metric in Metrics)
                {
                    <MudItem xs="12" sm="4">
                        <MudPaper Elevation="0" Class="pa-3 shipper-panel h-100">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@metric.Label</MudText>
                                    <MudText Typo="Typo.h5" Color="@metric.Color">@metric.Value</MudText>
                                </MudStack>
                                <MudIcon Icon="@metric.Icon" Color="@metric.Color" Size="Size.Large" />
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
            }

            <MudStack Spacing="1">
                <MudText Typo="Typo.h6">@L.T("Home.RequestList")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">화물과 현재 상태로 의뢰를 찾고, 주소와 결제 내역은 상세에서 확인합니다.</MudText>
            </MudStack>

            @if (hasLoaded && !loading && requests.Count == 0 && string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="Severity.Info">@(page == 1 ? L.T("Home.NoRequests") : "이 페이지에 표시할 운송 의뢰가 없습니다.")</MudAlert>
            }
            else if (requests.Count > 0)
            {
                <MudGrid>
                    @foreach (var request in OrderedRequests)
                    {
                        <MudItem xs="12" lg="6">
                            <MudPaper Elevation="0" Class="pa-4 shipper-panel h-100">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1" Class="fw-bold">@(string.IsNullOrWhiteSpace(request.화물종류) ? "운송 의뢰" : request.화물종류)</MudText>
                                            <MudText Typo="Typo.body2">@request.의뢰상태</MudText>
                                            @if (!string.IsNullOrWhiteSpace(request.화물적재형태))
                                            {
                                                <MudText Typo="Typo.body2">적재 형태 · @request.화물적재형태</MudText>
                                            }
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="overflow-wrap: anywhere;">의뢰 @request.의뢰Id</MudText>
                                        </MudStack>
                                        <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                            <MudChip T="string" Size="Size.Small" Color="@ResolvePaymentColor(request.결제상태)" Variant="Variant.Outlined">@request.결제상태</MudChip>
                                            <MudChip T="string" Size="Size.Small" Color="@ResolveDispatchColor(request.배차상태)" Variant="Variant.Outlined">@request.배차상태</MudChip>
                                            @if (정책확인필요(request))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="@ResolvePolicyColor(request)" Variant="Variant.Outlined">@BuildPolicyLabel(request)</MudChip>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">결제예정</MudText>
                                            <MudText Typo="Typo.body2">@(request.결제예정금액 is { } amount ? $"{amount:N0}원" : "미확인")</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">다음 확인</MudText>
                                            <MudText Typo="Typo.body2">@BuildRequestNextCheck(request)</MudText>
                                        </MudItem>
                                    </MudGrid>

                                    @if (정책확인필요(request))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">@BuildPolicyWarningText(request)</MudAlert>
                                    }

                                    <MudExpansionPanels Elevation="0">
                                        <MudExpansionPanel Text="요금·알선 조건" Expanded="false">
                                            <SsalddelSensitiveInfoRow Label="기준 운임" Value='@(request.기준운임?.ToString("N0") ?? "-")' />
                                            <SsalddelSensitiveInfoRow Label="기사 지급 예정" Value='@(request.기사지급예정운임?.ToString("N0") ?? "-")' />
                                            <SsalddelSensitiveInfoRow Label="알선 단계" Value='@($"{request.알선단계}단계")' />
                                            <SsalddelSensitiveInfoRow Label="재알선 금지" Value='@(request.재알선금지 ? "적용" : "미적용")' />
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>

                                    <MudStack Row="true" Spacing="1" Class="flex-wrap">
                                        <MudButton Variant="@(request.CanPay ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" Style="white-space: nowrap;" StartIcon="@Icons.Material.Filled.Description"
                                                   Disabled="@string.IsNullOrWhiteSpace(request.의뢰Id)" Href="@의뢰상세경로(request, ShipperRequestDetailScreenKind.Summary)">상세 보기</MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Style="white-space: nowrap;" StartIcon="@Icons.Material.Filled.Timeline"
                                                   Disabled="@string.IsNullOrWhiteSpace(request.의뢰Id)" Href="@의뢰상세경로(request, ShipperRequestDetailScreenKind.Timeline)">진행 이력</MudButton>
                                        @if (request.CanPay)
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="white-space: nowrap;"
                                                       Disabled="@string.IsNullOrWhiteSpace(request.의뢰Id)" Href="@의뢰상세경로(request, ShipperRequestDetailScreenKind.Payment)">결제 확인</MudButton>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
            @if (hasLoaded && (page > 1 || hasOlderRequests))
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.caption">@(page)페이지</MudText>
                    @if (page > 1)
                    {
                        <MudButton Variant="Variant.Text" Disabled="@loading"
                                   OnClick="@(() => LoadPageAsync(page - 1, synchronizeAddress: true))">최신 쪽 보기</MudButton>
                    }
                    @if (hasOlderRequests)
                    {
                        <MudButton Variant="Variant.Text" Disabled="@loading"
                                   OnClick="@(() => LoadPageAsync(page + 1, synchronizeAddress: true))">이전 의뢰 보기</MudButton>
                    }
                </MudStack>
            }
        }
    </MudStack>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public string? PageQuery { get; set; }

    private List<ShipperRequestItem> requests = [];
    private string? message;
    private Severity messageSeverity = Severity.Info;
    private CancellationTokenSource? refreshCancellation;
    private ShipperQueryLifetime? queryLifetime;
    private bool disposed;
    private bool loading;
    private bool hasLoaded;
    private bool initialized;
    private bool hasOlderRequests;
    private int page = 1;
    private int observedRoutePage = 1;

    private int RoutePage => int.TryParse(PageQuery, out var parsed) && parsed is >= 1 and <= IShipperOperationsService.MaximumRequestPage
        ? parsed : 1;

    private IEnumerable<ShipperRequestItem> OrderedRequests => requests.OrderByDescending(x => x.생성일시);

    private IReadOnlyList<WorkspaceMetric> Metrics =>
    [
        new("이 페이지 의뢰", $"{requests.Count:N0}건", Icons.Material.Filled.ReceiptLong, Color.Primary),
        new("이 페이지 결제 대기", $"{requests.Count(x => IsMatch(x.결제상태, "결제대기", "미결제", "대기")):N0}건", Icons.Material.Filled.Payments, Color.Warning),
        new("이 페이지 배차 진행", $"{requests.Count(x => IsMatch(x.배차상태, "매칭중", "배차대기", "기사배정", "운송중")):N0}건", Icons.Material.Filled.LocalShipping, Color.Info)
    ];

    protected override async Task OnInitializedAsync()
    {
        queryLifetime = new ShipperQueryLifetime(AuthSession);
        queryLifetime.SessionInvalidated += OnSessionInvalidated;
        LedgerObserver.RefreshRequested += OnLedgerRefreshRequested;
        await AuthSession.RestoreAsync();
        if (disposed) return;
        page = observedRoutePage = RoutePage;
        initialized = true;
        await LoadAsync();
        if (disposed) return;
        refreshCancellation = new CancellationTokenSource();
        _ = RunFallbackPollingAsync(refreshCancellation.Token);
    }

    protected override Task OnParametersSetAsync()
    {
        var requestedPage = RoutePage;
        if (!initialized || requestedPage == observedRoutePage)
        {
            return Task.CompletedTask;
        }

        observedRoutePage = requestedPage;
        return requestedPage == page && !loading
            ? Task.CompletedTask
            : LoadPageAsync(requestedPage, synchronizeAddress: true);
    }

    public void Dispose()
    {
        disposed = true;
        LedgerObserver.RefreshRequested -= OnLedgerRefreshRequested;
        if (queryLifetime is not null)
        {
            queryLifetime.SessionInvalidated -= OnSessionInvalidated;
            queryLifetime.Dispose();
        }
        refreshCancellation?.Cancel();
        refreshCancellation?.Dispose();
    }

    private void OnSessionInvalidated()
        => _ = InvokeAsync(() =>
        {
            if (disposed) return;
            requests = [];
            message = null;
            loading = false;
            hasLoaded = false;
            hasOlderRequests = false;
            page = 1;
            if (initialized && RoutePage != 1)
            {
                Navigation.NavigateTo(ShipperRoutes.TransportWorkspace, replace: true);
            }
            StateHasChanged();
        });

    private void OnLedgerRefreshRequested(TransportRequestLedgerRefreshRequest request)
        => _ = InvokeAsync(async () =>
        {
            if (disposed || !initialized || loading) return;
            await LoadAsync();
        });

    private async Task RunFallbackPollingAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(
            TransportRequestLedgerRefreshPolicy.FallbackPollingInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (disposed || loading) return;
                    await LoadAsync();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private Task LoadAsync() => LoadPageAsync(page);

    private async Task LoadPageAsync(int requestedPage, bool synchronizeAddress = false)
    {
        if (disposed || queryLifetime is null) return;
        if (!AuthSession.IsLoggedIn)
        {
            requests = [];
            message = null;
            loading = false;
            hasLoaded = false;
            hasOlderRequests = false;
            return;
        }

        var sessionRevision = AuthSession.SessionRevision;
        var finished = false;
        loading = true;
        StateHasChanged();
        await queryLifetime.RunAsync(
            cancellationToken => ShipperOperations.GetRequestsPageAsync(requestedPage, cancellationToken),
            result =>
            {
                if (hasLoaded && requestedPage != page && result.Count == 0)
                {
                    messageSeverity = Severity.Info;
                    message = requestedPage > page ? "더 오래된 의뢰가 없습니다." : "이 페이지에 표시할 운송 의뢰가 없습니다.";
                    if (requestedPage > page)
                    {
                        hasOlderRequests = false;
                    }
                    return;
                }

                requests = result.ToList();
                page = requestedPage;
                hasLoaded = true;
                hasOlderRequests = page < IShipperOperationsService.MaximumRequestPage
                    && requests.Count == IShipperOperationsService.RequestPageSize;
                message = null;
            },
            ex =>
            {
                messageSeverity = hasLoaded ? Severity.Warning : Severity.Error;
                message = !hasLoaded
                    ? $"서버 API 조회 실패: {ex.Message}"
                    : $"최신 상태를 확인하지 못해 마지막 조회 결과를 표시합니다: {ex.Message}";
            },
            () => { finished = true; loading = false; StateHasChanged(); });
        if (synchronizeAddress && finished && !disposed && AuthSession.SessionRevision == sessionRevision && RoutePage != page)
        {
            Navigation.NavigateTo(PagePath(page), replace: true);
        }
    }

    private static bool IsMatch(string? value, params string[] keywords)
    {
        return !string.IsNullOrWhiteSpace(value) &&
               keywords.Any(keyword => value.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    private static string BuildRequestNextCheck(ShipperRequestItem request)
    {
        if (IsMatch(request.결제상태, "결제대기", "미결제", "대기"))
        {
            return "결제 확인";
        }

        if (IsMatch(request.배차상태, "매칭중", "배차대기", "대기"))
        {
            return "기사 매칭";
        }

        if (IsMatch(request.배차상태, "기사배정", "배차확정"))
        {
            return "상차 대기";
        }

        return IsMatch(request.배차상태, "운송중", "상차완료", "운송") ? "하차 진행" : "상세 확인";
    }

    private static string BuildPolicyLabel(ShipperRequestItem request)
    {
        if (request.정책위반)
        {
            return "정책확인";
        }

        return request.재알선의심 ? "재알선의심" : "정책 안내";
    }

    private static bool 정책확인필요(ShipperRequestItem request)
        => request.정책위반 || request.재알선의심 || request.정책경고목록.Count > 0;

    private static string BuildPolicyWarningText(ShipperRequestItem request)
    {
        return request.정책경고목록.Count == 0
            ? "정책 확인이 필요합니다. 요금·알선 조건을 확인해 주세요."
            : string.Join(" / ", request.정책경고목록);
    }

    private static Color ResolvePolicyColor(ShipperRequestItem request)
    {
        if (request.정책위반)
        {
            return Color.Warning;
        }

        return request.재알선의심 ? Color.Error : Color.Warning;
    }

    private static Color ResolvePaymentColor(string status)
    {
        if (IsMatch(status, "결제완료"))
        {
            return Color.Success;
        }

        return IsMatch(status, "결제대기", "미결제", "대기") ? Color.Warning : Color.Default;
    }

    private static Color ResolveDispatchColor(string status)
    {
        if (IsMatch(status, "배송완료", "하차완료", "완료"))
        {
            return Color.Success;
        }

        if (IsMatch(status, "운송중", "상차완료", "운송"))
        {
            return Color.Info;
        }

        return IsMatch(status, "매칭중", "배차대기", "대기") ? Color.Warning : Color.Primary;
    }

    private string? 의뢰상세경로(ShipperRequestItem request, ShipperRequestDetailScreenKind screen)
    {
        if (string.IsNullOrWhiteSpace(request.의뢰Id))
        {
            return null;
        }

        return new ShipperRequestDetailNavigationContext { ReturnPath = PagePath(page) }
            .PathFor(screen, request.의뢰Id);
    }

    private static string PagePath(int targetPage) => targetPage == 1
        ? ShipperRoutes.TransportWorkspace
        : FormattableString.Invariant($"{ShipperRoutes.TransportWorkspace}?page={targetPage}");

    private void GoToRequestWizard() => Navigation.NavigateTo(ShipperRoutes.Request);

    private sealed record WorkspaceMetric(string Label, string Value, string Icon, Color Color);
}
