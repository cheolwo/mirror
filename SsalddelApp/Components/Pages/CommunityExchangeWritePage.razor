@page "/community/exchange/write"
@layout CommunityMobileLayout
<PageTitle>@(Purpose == Ssalddel.Ui.Common.Areas.App.ViewModels.NeighborhoodExchangeViewModel.InboundInterestPurpose ? "입고 희망 올리기" : "교류 글 올리기") · 살뜰</PageTitle>
<Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.ExchangeWrite InitialRegionKey="@Region" ReturnUrl="@ReturnUrl" Purpose="@Purpose" />
@code {
    [SupplyParameterFromQuery(Name = "purpose")] public string? Purpose { get; set; }
    [SupplyParameterFromQuery(Name = "region")] public string? Region { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
