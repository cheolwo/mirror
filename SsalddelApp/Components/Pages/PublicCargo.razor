@page "/shipper/public-cargo"
@using Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Cargo
@inject IAuthSession Session

<PageTitle>공개 화물</PageTitle>

<CargoPublicBrowseScreen InformationNoticesHref="@CargoNoticeNavigation.Public"
                         PrimaryActionHref="@(Session.IsLoggedIn ? ShipperRoutes.Request : CargoPublicBrowseNavigation.ShipperRequestLogin)"
                         PrimaryActionLabel="@(Session.IsLoggedIn ? "운송 의뢰하기" : "로그인하고 운송 의뢰")"
                         SecondaryActionHref="@CargoPublicBrowseNavigation.DriverLogin"
                         SecondaryActionLabel="기사로 로그인하고 추천 확인"
                         ReturnHref="@ShipperRoutes.ShipperHome" ReturnLabel="화주 홈" />
