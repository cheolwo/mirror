@page "/community/posts/{PostId:long}"
@layout CommunityMobileLayout

<PageTitle>@RouteContext.WorkspaceTitle</PageTitle>

<CommunityRoutePageFrame BackHref="@RouteContext.BackHref"
                         BackLabel="@RouteContext.BackLabel"
                         Eyebrow="공개 커뮤니티 · 01A.03"
                         Heading="게시글 상세"
                         Description="글의 원문과 참여 맥락을 읽고 다음 행동을 직접 선택합니다."
                         ShowComposeAction="true"
                         ComposeHref="@CommunityPageRoutes.ComposeFor(QueryBoardName, QueryBoardKey, RouteContext.BackHref)">
    <CommunityPostDetailScreen AppName="살뜰"
                               RoleLabel="앱 사용자"
                               AppKey="shipper"
                               CargoRequestDraftHrefBase="/shipper/request"
                               UseBaguaRoleTransitionPages="true"
                               PostId="@PostId"
                               BoardName="@QueryBoardName"
                               ListReturnPath="@RouteContext.BackHref" />
</CommunityRoutePageFrame>

@code {
    [Parameter] public long PostId { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CommunityBoardNavigationQueryNames.BoardName)]
    public string? QueryBoardName { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = CommunityBoardNavigationQueryNames.BoardKey)]
    public string? QueryBoardKey { get; set; }

    [Parameter, SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)]
    public string? QueryReturnPath { get; set; }

    private CommunityWorkspaceRouteContext RouteContext
        => CommunityWorkspaceRouteContext.Resolve(
            $"/community/posts/{PostId}",
            PostId,
            null,
            null,
            QueryBoardName,
            QueryBoardKey,
            null,
            QueryReturnPath);
}
