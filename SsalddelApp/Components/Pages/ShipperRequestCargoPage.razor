@page "/shipper/request/cargo"
@layout ShipperMobileLayout
@inject ShipperRequestAuthoringPageViewModel PageModel
@inject NavigationManager Navigation

<PageTitle>화물 조건 입력</PageTitle>

<ShipperRequestCargoScreen ViewModel="PageModel.State"
                           NavigationContext="RouteContext"
                           ScreenCode="03.03"
                           Title="화물 조건 입력"
                           Description="품목·수량·취급 조건을 운송 검토용 초안으로 기록합니다."
                           RootBackHref="@(RouteContext.ReturnPath ?? ShipperRoutes.ShipperHome)"
                           RootBackLabel="돌아가기"
                           BulkHref="@ShipperRequestPageRoutes.Bulk"
                           Changed="PageModel.AutoSaveAsync" />

@code {
    private ShipperRequestNavigationContext RouteContext
        => ShipperRequestNavigationContext.Parse(Navigation.Uri);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PageModel.InitializeAsync();
        StateHasChanged();
    }
}
