@inject SsalddelClientRoleService RoleService
@inject NavigationManager Navigation

<main class="common-mobile-home">
    <header class="common-mobile-home__hero">
        <span>살뜰 통합 · 00</span>
        <h1>이야기에서 함께 사는 일까지</h1>
        <p>
            가입 없이 지역과 생활 이야기를 둘러보고, 필요할 때만 역할을 골라 공동행동과 업무를 이어갑니다.
        </p>
        <a href="/community/map">
            <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Small" />
            생활 지도 시작
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
        </a>
    </header>

    <section class="common-mobile-home__section" aria-labelledby="common-home-discovery-title">
        <header>
            <span>먼저 둘러보기</span>
            <h2 id="common-home-discovery-title">지금 살펴볼 곳</h2>
        </header>

        <nav class="common-mobile-home__destinations" aria-label="살뜰 공통 탐색">
            <a href="@NeighborhoodExchange.Home">
                <span class="common-mobile-home__icon common-mobile-home__icon--community"><MudIcon Icon="@Icons.Material.Filled.Handshake" /></span>
                <span><strong>생활 교류</strong><small>제공할 수 있는 것과 필요한 것을 나눠요</small></span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </a>
            <a href="@CommunityPageRoutes.Home">
                <span class="common-mobile-home__icon common-mobile-home__icon--community">
                    <MudIcon Icon="@Icons.Material.Filled.GridView" />
                </span>
                <span>
                    <strong>공개 커뮤니티</strong>
                    <small>생활 이야기와 관심을 나누는 출발점</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </a>
            <a href="@CommunityPageRoutes.Regions">
                <span class="common-mobile-home__icon common-mobile-home__icon--region">
                    <MudIcon Icon="@Icons.Material.Filled.TravelExplore" />
                </span>
                <span>
                    <strong>지역 문화·특산물</strong>
                    <small>미국의 주와 중국의 지역을 문화부터 탐색</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </a>
            <a href="@ShipperRoutes.PublicDataInformation">
                <span class="common-mobile-home__icon common-mobile-home__icon--data">
                    <MudIcon Icon="@Icons.Material.Filled.QueryStats" />
                </span>
                <span>
                    <strong>공공데이터</strong>
                    <small>가격·수입식품·농수산물 근거 확인</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </a>
            <a href="@CommunityPageRoutes.WorkRelationships">
                <span class="common-mobile-home__icon common-mobile-home__icon--relationships">
                    <MudIcon Icon="@Icons.Material.Filled.Handshake" />
                </span>
                <span>
                    <strong>친구 요청</strong>
                    <small>02~05 업무에서 만난 익명 접점을 로그인 후 다시 확인</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
            </a>
        </nav>
    </section>

    <aside class="common-mobile-home__boundary">
        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
        <span>
            <strong>둘러보는 것만으로 참여나 주문이 만들어지지 않습니다.</strong>
            관심, 참여, 연락처 공개와 실제 실행은 각각 따로 선택합니다.
        </span>
    </aside>

    <section class="common-mobile-home__section" aria-labelledby="common-home-role-title">
        <header>
            <span>일이 필요할 때</span>
            <h2 id="common-home-role-title">업무 역할 선택</h2>
            <p>역할은 업무 화면만 바꾸며 커뮤니티의 가입·노출·신뢰 기준으로 사용하지 않습니다.</p>
        </header>

        <div class="common-mobile-home__roles">
            <button type="button" @onclick="@(() => SelectRole(SsalddelClientRole.Shipper))">
                <span class="common-mobile-home__icon common-mobile-home__icon--shipper">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" />
                </span>
                <span>
                    <strong>화주·판매자</strong>
                    <small>운송 의뢰와 판매·물류 흐름</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </button>
            <button type="button" @onclick="@(() => SelectRole(SsalddelClientRole.WarehouseManager))">
                <span class="common-mobile-home__icon common-mobile-home__icon--warehouse">
                    <MudIcon Icon="@Icons.Material.Filled.Warehouse" />
                </span>
                <span>
                    <strong>창고 관리자</strong>
                    <small>입고·출고·재고와 배송 운영</small>
                </span>
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </button>
        </div>
    </section>
</main>

@code {
    private void SelectRole(SsalddelClientRole role)
    {
        RoleService.SetRole(role);
        Navigation.NavigateTo(role switch
        {
            SsalddelClientRole.Shipper => ShipperRoutes.ShipperHome,
            SsalddelClientRole.WarehouseManager => ShipperRoutes.WarehouseWorkspace,
            _ => ShipperRoutes.Home
        });
    }
}
