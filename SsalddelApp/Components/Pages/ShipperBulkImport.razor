@page "/shipper/request/bulk"
@layout ShipperMobileLayout
@inject NavigationManager Navigation

<a href="@ReturnHref">운송 업무로 돌아가기</a>

<PageTitle>운송의뢰 일괄등록</PageTitle>

<ShipperMobileRouteFrame ScreenCode="03.11"
                         Title="운송의뢰 일괄등록"
                         Description="여러 의뢰를 CSV로 미리보기하고 유효한 행만 선택해 등록합니다."
                         Badge="CSV"
                         BoundaryMessage="파일 선택과 미리보기는 등록이 아닙니다. 검토 결과로 등록 버튼을 눌러야 서버 요청이 발생합니다.">
    <ShipperBulkImportPanel />
</ShipperMobileRouteFrame>

@code {
    private string ReturnHref => ShipperRequestNavigationContext.Parse(Navigation.Uri).ReturnPath ?? "/shipper/request";
}
