@page "/community/exchange/deliveries/work/{RequestId}"
@layout RoleWorkspaceLayout
@using Ssalddel.Ui.Common.Areas.App.Services
@inject IAuthSession Auth
@inject MemberDeliveryPushService Push
@implements IDisposable
<PageTitle>생활 배송 · 살뜰</PageTitle>
<Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.NeighborhoodMemberWork @ref="_page" RequestId="@RequestId" LoginHref="@LoginHref" />
@code {
    private Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.NeighborhoodMemberWork? _page;
    private bool _disposed;
    protected override void OnInitialized() { Auth.Changed += AuthenticationChanged; Push.Changed += RefreshRequested; }
    private void AuthenticationChanged() { if (!_disposed) _ = InvokeAsync(async () => { if (_page is null || _disposed) return; await _page.NotifyAuthenticationChangedAsync(); await _page.RefreshAsync(); }); }
    private void RefreshRequested() { if (!_disposed) _ = InvokeAsync(async () => { if (_page is not null && !_disposed) await _page.RefreshAsync(); }); }
    public void Dispose() { _disposed = true; Auth.Changed -= AuthenticationChanged; Push.Changed -= RefreshRequested; }

    [Parameter] public string RequestId { get; set; } = "";
    private string ReturnRoute => NeighborhoodMemberDeliveryRoutes.WorkDetail(RequestId);
    private string LoginHref => NeighborhoodExchangeAuthenticationRoutes.LoginHref(ReturnRoute);
}
