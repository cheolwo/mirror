@page "/shipper/request"
@layout ShipperMobileLayout
@inject NavigationManager Navigation

<PageTitle>운송의뢰 시작</PageTitle>

<ShipperMobileRouteFrame ScreenCode="03.02"
                         Title="운송의뢰 시작"
                           Description="보낼 물품부터 운송 조건까지 하나씩 입력합니다."
                         Badge="초안"
                         BoundaryMessage="작성 시작만으로 배차·계약·결제는 실행되지 않으며, 최종 검토에서 명시적으로 등록합니다.">
    <div class="shipper-mobile-start-grid">
        <article class="shipper-mobile-start-card">
            <span><MudIcon Icon="@Icons.Material.Filled.Inventory2" /></span>
            <div>
                <strong>단건 운송의뢰</strong>
                <p>물품 → 크기·중량 → 출발지 → 도착지 → 시간 → 차량 → 비용 → 최종 확인</p>
            </div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="OpenCargo">
                시작
            </MudButton>
        </article>

        <article class="shipper-mobile-start-card">
            <span><MudIcon Icon="@Icons.Material.Filled.UploadFile" /></span>
            <div>
                <strong>여러 의뢰 일괄등록</strong>
                <p>CSV를 먼저 미리보기하고 유효한 행만 선택해 등록합니다.</p>
            </div>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Href="@PageNavigationContext.WithReturnPath(ShipperRoutes.RequestBulk, RouteContext.ReturnPath)">
                열기
            </MudButton>
        </article>
    </div>
</ShipperMobileRouteFrame>

@code {
    private ShipperRequestNavigationContext RouteContext
        => ShipperRequestNavigationContext.Parse(Navigation.Uri);

    private void OpenCargo()
    {
        Navigation.NavigateTo(
            RouteContext.PathFor(ShipperRequestAuthoringStep.Cargo),
            replace: true);
    }
}
