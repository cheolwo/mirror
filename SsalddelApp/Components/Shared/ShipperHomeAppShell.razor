@using Ssalddel.Ui.Common.Areas.App.Components.Shipper
@implements IDisposable
@inject IAuthSession AuthSession
@inject 꾸미기보유권동기화Service 꾸미기보유권동기화Service
@inject ShipperViewVisibilityService ViewVisibilityService

@if (isInitializing)
{
    <MudPaper Elevation="0" Outlined="true" Class="pa-5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1">화주 앱의 로그인과 화면 설정을 확인하고 있습니다.</MudText>
        </MudStack>
    </MudPaper>
}
else
{
    @if (!string.IsNullOrWhiteSpace(initializationWarning))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3">@initializationWarning</MudAlert>
    }

    <ShipperHomeScreen @ref="homeScreen"
                       CompactPresentation="true"
                       SeparateAnonymousAuthentication="true"
                       SessionAuthenticated="@AuthSession.IsLoggedIn"
                       ScreenCode="@ScreenCode"
                       HomeTitle="화주 홈"
                       HomeDescription="의뢰와 입고·판매 상태를 요약하고 다음 확인 업무로 이동합니다."
                       TransportHref="@ShipperRoutes.Request"
                       WarehouseHref="@ShipperRoutes.WarehouseWorkspace"
                       SalesHref="@ShipperRoutes.SalesOrders"
                       InternationalHref="@ShipperRoutes.FclLclPlanner">
        <AuthenticatedIntro>
            <RolePurposeJourney RoleName="화주·판매자"
                                Title="운송 의뢰를 입고와 판매 이행까지 연결합니다"
                                Description="운송 조건을 작성하고 진행 상태·입고 준비·판매 결과를 같은 업무 흐름에서 확인합니다."
                                Steps="@PurposeSteps"
                                BoundaryNote="의뢰 작성과 조회만으로 배차·계약·결제·통관·출고가 자동 확정되지는 않습니다." />
        </AuthenticatedIntro>
        <AnonymousContent>
            <ShipperHomeAppLoginPanel OnAuthenticated="HandleAuthenticatedAsync" />
        </AnonymousContent>
    </ShipperHomeScreen>
}

@code {
    [Parameter]
    public string ScreenCode { get; set; } = "03.01";

    private ShipperHomeScreen? homeScreen;
    private bool isInitializing = true;
    private bool disposed;
    private string? initializationWarning;
    private static readonly IReadOnlyList<RolePurposeJourneyStep> PurposeSteps =
    [
        new("시작할 일", "운송의뢰 작성", "화물·운송·절차 조건을 검토 가능한 초안으로 만듭니다.", ShipperRoutes.Request, true),
        new("진행 확인", "운송·입고 상태", "진행 중 의뢰와 창고 입고 준비 상태를 확인합니다.", ShipperRoutes.TransportWorkspace),
        new("확인 필요", "통관·운송 조건", "HS 검토와 FCL·LCL 계획의 미확인 근거를 봅니다.", ShipperRoutes.CustomsHsReviews),
        new("완료 근거", "판매주문 이행", "입고된 상품의 출품과 판매주문 처리 결과를 확인합니다.", ShipperRoutes.SalesOrders)
    ];

    protected override async Task OnInitializedAsync()
    {
        AuthSession.Changed += HandleSessionChanged;
        try
        {
            await AuthSession.RestoreAsync();
            await 꾸미기보유권동기화Service.RestoreAndSynchronizeAsync();
            await ViewVisibilityService.EnsureLoadedAsync();
        }
        catch (Exception exception)
        {
            initializationWarning = $"일부 앱 설정을 복원하지 못했습니다. 업무 기능은 각 화면에서 다시 확인합니다. {exception.Message}";
        }
        finally
        {
            isInitializing = false;
        }
    }

    private async Task HandleAuthenticatedAsync()
    {
        if (!disposed && homeScreen is not null)
        {
            await homeScreen.RefreshAsync();
        }
    }

    private void HandleSessionChanged()
    {
        if (!disposed)
        {
            _ = InvokeAsync(() =>
            {
                if (!disposed)
                {
                    StateHasChanged();
                }
            });
        }
    }

    public void Dispose()
    {
        disposed = true;
        AuthSession.Changed -= HandleSessionChanged;
    }
}
