@namespace Hongdal.Ui.Common.Areas.App.Components.Community
@using Hongdal.Ui.Common.Areas.App.ViewModels

@if (ViewModel.Opportunities.TryGetValue(Post.Id, out var opportunity))
{
    var participation = opportunity.Participation;
    var flow = CommunityPostActionFlowViewModel.Create(opportunity);
    <CommunityPostActionFlowSummary Flow="@flow"
                                    IsBusy="@ViewModel.IsParticipationPending(Post.Id)"
                                    DetailsExpanded="@_detailsExpanded"
                                    PrimaryActionRequested="HandlePrimaryActionAsync"
                                    DetailsRequested="ToggleDetails" />
    <MudCollapse Expanded="@_detailsExpanded">
    <section class="platform-community-participation" aria-label="게시글 참여 관심 모집 세부 정보">
        <header>
            <div>
                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" />
                <strong>@participation.Title</strong>
            </div>
            @if (participation.ParticipantCount > 0)
            {
                <span>@($"{participation.ParticipantCount:N0}명 관심")</span>
            }
        </header>
        <p>@participation.Summary</p>

        @if (participation.CanJoin && participation.InterestVoteId.HasValue)
        {
            <div class="platform-community-participation-roles" role="group" aria-label="가능한 참여 역할">
                @foreach (var role in participation.RoleOptions)
                {
                    <button type="button"
                            class="@BuildParticipationRoleClass(role.OptionId)"
                            title="@role.Summary"
                            aria-pressed="@ViewModel.IsParticipationRoleSelected(Post.Id, role.OptionId)"
                            disabled="@(ViewModel.IsParticipationPending(Post.Id) || string.IsNullOrWhiteSpace(role.OptionId))"
                            @onclick="@(async () => await ToggleParticipationRoleAsync(role))">
                        <span>@role.Label</span>
                        @if (role.InterestCount > 0)
                        {
                            <b>@role.InterestCount</b>
                        }
                    </button>
                }
            </div>
        }
        else if (participation.CanStart)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.GroupAdd"
                       Disabled="@ViewModel.IsParticipationPending(Post.Id)"
                       OnClick="StartParticipationAsync">
                비구속적 관심 모으기
            </MudButton>
        }
        else if (participation.StateCode != CommunityPostParticipationStateCodes.ProvisionalLedgerCreated)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">이 게시글의 관심 모집은 마감되었습니다.</MudText>
        }

        @if (participation.CanPromoteToProvisionalLedger && participation.InterestVoteId.HasValue)
        {
            <div class="platform-community-provisional-actions">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Description"
                           Disabled="@ViewModel.IsParticipationPending(Post.Id)"
                           OnClick="@(() => PromoteRequested.InvokeAsync(CommunityCollectiveIntentTypeCodes.GroupPurchase))">
                    공동구매 가원장
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Public"
                           Disabled="@ViewModel.IsParticipationPending(Post.Id)"
                           OnClick="@(() => PromoteRequested.InvokeAsync(CommunityCollectiveIntentTypeCodes.GroupImportCandidate))">
                    공동수입 검토 가원장
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Public"
                           Disabled="@ViewModel.IsParticipationPending(Post.Id)"
                           OnClick="@(() => PromoteRequested.InvokeAsync(CommunityCollectiveIntentTypeCodes.GroupExportCandidate))">
                    공동수출 검토 가원장
                </MudButton>
            </div>
        }
        else if (participation.StateCode == CommunityPostParticipationStateCodes.ProvisionalLedgerCreated)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Description">
                비구속적 가원장 생성됨
            </MudChip>
        }

        @if (participation.PartyFormation.IsAvailable)
        {
            var formation = participation.PartyFormation;
            <section class="platform-community-party-formation" aria-label="거래 참여팀 역할 구성">
                <header>
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Small" />
                        <strong>거래 참여팀</strong>
                    </div>
                    <span>@($"필수 역할 {formation.RepresentedRequiredRoleSlotCount}/{formation.RequiredRoleSlotCount}")</span>
                </header>
                <div class="platform-community-party-route">
                    <span>@TradeDirectionLabel(formation.TradeDirectionCode)</span>
                    @if (!string.IsNullOrWhiteSpace(formation.OriginCountryCode)
                         || !string.IsNullOrWhiteSpace(formation.DestinationCountryCode))
                    {
                        <span>@($"{CountryCodeLabel(formation.OriginCountryCode)} → {CountryCodeLabel(formation.DestinationCountryCode)}")</span>
                    }
                    @if (formation.TransportModeCodes.Count > 0)
                    {
                        <span>@string.Join(" · ", formation.TransportModeCodes.Select(TransportModeLabel))</span>
                    }
                </div>
                <div class="platform-community-party-slots">
                    @foreach (var slot in formation.RoleSlots)
                    {
                        var opening = participation.ProfessionalParticipation.RoleOpenings.FirstOrDefault(candidate =>
                            string.Equals(candidate.RoleCode, slot.RoleCode, StringComparison.OrdinalIgnoreCase));
                        <div class="@BuildPartySlotClass(slot)">
                            <MudIcon Icon="@PartySlotIcon(slot)" Size="Size.Small" />
                            <div>
                                <strong>@slot.Label</strong>
                                <small>@slot.Summary</small>
                            </div>
                            <div class="platform-community-party-slot-meta">
                                <span>@(slot.IsRequired ? "필수" : slot.IsRecommended ? "권장" : "선택")</span>
                                @if (slot.ConfirmedParticipantCount > 0)
                                {
                                    <b>@($"확인 {slot.ConfirmedParticipantCount}")</b>
                                }
                                else if (slot.InterestCount > 0)
                                {
                                    <b>@($"관심 {slot.InterestCount}")</b>
                                }
                                @if (slot.ExternalCredentialVerificationRequired && !slot.ExternalCredentialVerified)
                                {
                                    <MudTooltip Text="관할기관 면허·등록 또는 운송 권한을 별도로 확인해야 합니다.">
                                        <MudIcon Icon="@Icons.Material.Filled.GppMaybe"
                                                 Size="Size.Small"
                                                 Color="Color.Warning"
                                                 aria-label="외부 자격 확인 필요" />
                                    </MudTooltip>
                                }
                                @if (CommunityPostPartyRoleCodes.IsCommercialParty(slot.RoleCode))
                                {
                                    <MudTooltip Text="가원장 검토 단계에서 당사자 역할을 명시적으로 수락합니다. 주문·계약·결제 또는 법적 책임은 확정되지 않습니다.">
                                        <MudIconButton Icon="@Icons.Material.Filled.HowToReg"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Disabled="@ViewModel.IsParticipationPending(Post.Id)"
                                                       aria-label="@($"{slot.Label} 역할을 비구속적으로 수락")"
                                                       OnClick="@(() => JoinPartyRoleRequested.InvokeAsync(slot.RoleCode))" />
                                    </MudTooltip>
                                }
                                else if (opening is not null)
                                {
                                    <MudTooltip Text="플랫폼 프로필에서 역할이 확인된 계정만 참여할 수 있으며 외부 면허·등록은 별도 확인 대상입니다.">
                                        <MudIconButton Icon="@Icons.Material.Filled.PersonAdd"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       Disabled="@ViewModel.IsParticipationPending(Post.Id)"
                                                       aria-label="@($"{slot.Label} 역할로 자발적 참여")"
                                                       OnClick="@(() => JoinProfessionalRoleRequested.InvokeAsync(slot.RoleCode))" />
                                    </MudTooltip>
                                }
                            </div>
                        </div>
                    }
                </div>
                <p class="platform-community-party-readiness">@formation.ReadinessMessage</p>
            </section>
        }

        <small>관심만 표시하며 주문·계약·배차·운송 주선은 시작되지 않습니다.</small>
    </section>
    </MudCollapse>
}

@code {
    [Parameter, EditorRequired]
    public PlatformCommunityPostResponse Post { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlatformCommunityPostEngagementViewModel ViewModel { get; set; } = null!;

    [Parameter]
    public EventCallback<PlatformCommunityCommandResult> CommandCompleted { get; set; }

    [Parameter]
    public EventCallback<string> PromoteRequested { get; set; }

    [Parameter]
    public EventCallback<string> JoinPartyRoleRequested { get; set; }

    [Parameter]
    public EventCallback<string> JoinProfessionalRoleRequested { get; set; }

    private bool _detailsExpanded;

    private string BuildParticipationRoleClass(string optionId)
        => ViewModel.IsParticipationRoleSelected(Post.Id, optionId)
            ? "platform-community-participation-role platform-community-participation-role--selected"
            : "platform-community-participation-role";

    private async Task StartParticipationAsync()
    {
        var result = await ViewModel.StartParticipationAsync(Post.Id);
        if (result.Succeeded)
        {
            _detailsExpanded = true;
        }

        await CompleteAsync(result);
    }

    private async Task ToggleParticipationRoleAsync(CommunityPostParticipationRoleOptionResponse role)
        => await CompleteAsync(await ViewModel.ToggleParticipationRoleAsync(Post.Id, role));

    private async Task CompleteAsync(PlatformCommunityCommandResult result)
        => await CommandCompleted.InvokeAsync(result);

    private async Task HandlePrimaryActionAsync()
    {
        if (!ViewModel.Opportunities.TryGetValue(Post.Id, out var opportunity))
        {
            return;
        }

        var flow = CommunityPostActionFlowViewModel.Create(opportunity);
        if (flow.PrimaryActionKind == CommunityPostPrimaryActionKind.StartGathering)
        {
            await StartParticipationAsync();
            return;
        }

        if (flow.PrimaryActionKind == CommunityPostPrimaryActionKind.ShowParticipationDetails)
        {
            _detailsExpanded = true;
        }
    }

    private void ToggleDetails()
        => _detailsExpanded = !_detailsExpanded;

    private static string TradeDirectionLabel(string code)
        => code switch
        {
            CommunityTradeDirectionCodes.Import => "수입 검토",
            CommunityTradeDirectionCodes.Export => "수출 검토",
            _ => "국내 거래 검토"
        };

    private static string CountryCodeLabel(string? code)
        => string.IsNullOrWhiteSpace(code) ? "미정" : code.Trim().ToUpperInvariant();

    private static string TransportModeLabel(string code)
        => code switch
        {
            CommunityTransportModeCodes.Ocean => "해상",
            CommunityTransportModeCodes.Air => "항공",
            CommunityTransportModeCodes.Road => "도로",
            CommunityTransportModeCodes.Rail => "철도",
            CommunityTransportModeCodes.Multimodal => "복합운송",
            _ => code
        };

    private static string BuildPartySlotClass(CommunityPostPartyRoleSlotResponse slot)
        => slot.StateCode switch
        {
            CommunityPartyRoleSlotStateCodes.RoleAccepted =>
                "platform-community-party-slot platform-community-party-slot--confirmed",
            CommunityPartyRoleSlotStateCodes.InterestExpressed =>
                "platform-community-party-slot platform-community-party-slot--interest",
            _ => "platform-community-party-slot"
        };

    private static string PartySlotIcon(CommunityPostPartyRoleSlotResponse slot)
        => slot.StateCode switch
        {
            CommunityPartyRoleSlotStateCodes.RoleAccepted => Icons.Material.Filled.CheckCircle,
            CommunityPartyRoleSlotStateCodes.InterestExpressed => Icons.Material.Filled.Schedule,
            _ => Icons.Material.Outlined.RadioButtonUnchecked
        };
}
