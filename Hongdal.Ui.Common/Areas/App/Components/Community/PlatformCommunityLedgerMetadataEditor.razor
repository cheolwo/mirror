@namespace Hongdal.Ui.Common.Areas.App.Components.Community
@using Hongdal.Contracts.Common.Community
@using Hongdal.Ui.Common.Areas.App.ViewModels

@if (Template.LedgerBlocks.Count > 0)
{
    <MudStack Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary">동적 원장 블록 입력</MudText>
        <MudGrid Spacing="2">
            @foreach (var block in Template.LedgerBlocks)
            {
                <MudItem xs="12" md="6">
                    <div class="platform-ledger-block-input">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="1">
                                <MudText Typo="Typo.body2">@block.DisplayName</MudText>
                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    @if (block.RequiredForAiJudgment)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">AI 판단 필요</MudChip>
                                    }
                                    @if (block.OpensApiHandoff)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">API handoff</MudChip>
                                    }
                                </MudStack>
                            </MudStack>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@block.Purpose</MudText>
                            <MudTextField T="string"
                                          Label="@($"{block.DisplayName} 내용")"
                                          Value="@GetLedgerBlockValue(block.Code)"
                                          ValueChanged="@((string value) => SetLedgerBlockValueAsync(block.Code, value))"
                                          Lines="2"
                                          Immediate="true"
                                          Variant="Variant.Outlined" />
                        </MudStack>
                    </div>
                </MudItem>
            }
        </MudGrid>
    </MudStack>
}

@if (ApiSurfaces.Count > 0)
{
    <MudStack Spacing="1">
        <MudText Typo="Typo.caption" Color="Color.Secondary">API 경로 메타데이터 후보</MudText>
        @if (ApiRouteParameterNames.Count > 0)
        {
            <MudGrid Spacing="2">
                @foreach (var parameterName in ApiRouteParameterNames)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="@($"{parameterName} 경로 값")"
                                      Value="@GetApiRouteValue(parameterName)"
                                      ValueChanged="@((string value) => SetApiRouteValueAsync(parameterName, value))"
                                      Immediate="true"
                                      Variant="Variant.Outlined" />
                    </MudItem>
                }
            </MudGrid>
        }
        @foreach (var item in ApiSurfaces)
        {
            <div class="platform-ledger-api-send">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@item.Method</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="@item.StatusColor" Variant="Variant.Outlined">@item.StatusLabel</MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">@item.Surface.HandoffMode</MudChip>
                        </MudStack>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Route"
                                   Disabled="@(item.HasUnresolvedMetadata || item.HasMissingRouteParameters)"
                                   OnClick="@(() => ApiRoutePrepareRequested.InvokeAsync(item.Surface))">
                            이 경로로 준비
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.caption" Class="platform-ledger-api-route">@item.ResolvedRoute</MudText>
                    @if (item.Surface.IsExistingSurface && !string.IsNullOrWhiteSpace(item.Surface.ApiEndpointKey))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Surface.ApiEndpointKey</MudText>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Surface.Purpose</MudText>
                    @if (item.HasUnresolvedMetadata)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">기존 API 메타데이터를 아직 불러오지 못했습니다.</MudText>
                    }
                    @if (item.HasMissingRouteParameters)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">경로 변수 값을 먼저 입력해야 전송할 수 있습니다.</MudText>
                    }
                </MudStack>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ResultMessage))
        {
            <MudAlert Severity="@ResultSeverity" Dense="true" Variant="Variant.Outlined">@ResultMessage</MudAlert>
        }
    </MudStack>
}

@code {
    [Parameter, EditorRequired]
    public CommunityLedgerTemplateResponse Template { get; set; } = default!;

    [Parameter, EditorRequired]
    public PlatformCommunityDiagramWorkspaceViewModel Workspace { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<string> ApiRouteParameterNames { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PlatformCommunityLedgerApiSurfacePresentation> ApiSurfaces { get; set; } = [];

    [Parameter]
    public string? ResultMessage { get; set; }

    [Parameter]
    public Severity ResultSeverity { get; set; }

    [Parameter]
    public EventCallback ValuesChanged { get; set; }

    [Parameter]
    public EventCallback<CommunityLedgerProcessingSurfaceResponse> ApiRoutePrepareRequested { get; set; }

    private string GetLedgerBlockValue(string blockCode)
        => Workspace.LedgerBlockValues.TryGetValue(blockCode, out var value) ? value : string.Empty;

    private async Task SetLedgerBlockValueAsync(string blockCode, string? value)
    {
        Workspace.LedgerBlockValues[blockCode] = value ?? string.Empty;
        await ValuesChanged.InvokeAsync();
    }

    private string GetApiRouteValue(string parameterName)
        => Workspace.ApiPathParameterValues.TryGetValue(parameterName, out var value) ? value : string.Empty;

    private async Task SetApiRouteValueAsync(string parameterName, string? value)
    {
        Workspace.ApiPathParameterValues[parameterName] = value ?? string.Empty;
        await ValuesChanged.InvokeAsync();
    }
}
