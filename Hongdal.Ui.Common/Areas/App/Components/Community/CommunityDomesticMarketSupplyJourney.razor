@namespace Hongdal.Ui.Common.Areas.App.Components.Community
@using Hongdal.Ui.Common.Areas.App.ViewModels

@if (Model.IsApplicable)
{
    <section class="domestic-market-supply" aria-labelledby="domestic-market-supply-title">
        <header class="domestic-market-supply__header">
            <div>
                <span><MudIcon Icon="@Icons.Material.Filled.Agriculture" Size="Size.Small" /> 국내 농수산물 공동구매</span>
                <h3 id="domestic-market-supply-title">@Model.Title</h3>
                <p>국내 산지 물량은 수입 통관 흐름과 분리하고, 생산자와 운송 주체가 수락한 배치만 전통시장으로 곧장 연결합니다.</p>
            </div>
            <strong>@Model.StatusLabel</strong>
        </header>

        <div class="domestic-market-supply__route" aria-label="국내 산지에서 전통시장까지의 공급 경로">
            <div>
                <span>산지 출발</span>
                <strong>@Model.SourceAreaLabel</strong>
                <small>@Model.HarvestOrLandingLabel</small>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Medium" />
            <div>
                <span>시장 직입고</span>
                <strong>@Model.DestinationMarketLabel</strong>
                <small>@Model.TransportConditionLabel</small>
            </div>
        </div>

        <dl class="domestic-market-supply__facts">
            <div>
                <dt>품목 구분</dt>
                <dd>@Model.ProductCategoryLabel</dd>
            </div>
            <div>
                <dt>예약 출하</dt>
                <dd>@FormatQuantity(Model.CommittedQuantity)</dd>
            </div>
            <div>
                <dt>추가 관심</dt>
                <dd>@FormatQuantity(Model.AdditionalPotentialQuantity)</dd>
            </div>
            <div>
                <dt>통관 단계</dt>
                <dd>@(Model.RequiresCustomsClearance ? "별도 확인 필요" : "국내 유통 · 해당 없음")</dd>
            </div>
        </dl>

        <div class="domestic-market-supply__readiness">
            <article class="@(Model.SourceAcceptanceConfirmed ? "is-confirmed" : null)">
                <MudIcon Icon="@(Model.SourceAcceptanceConfirmed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" />
                <div><strong>산지 공급 수락</strong><span>@(Model.SourceAcceptanceConfirmed ? "확인됨" : "당사자 수락 필요")</span></div>
            </article>
            <article class="@(Model.CarrierAcceptanceConfirmed ? "is-confirmed" : null)">
                <MudIcon Icon="@(Model.CarrierAcceptanceConfirmed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" />
                <div><strong>시장 직송 운송</strong><span>@(Model.CarrierAcceptanceConfirmed ? "확인됨" : "운송 주체 수락 필요")</span></div>
            </article>
            <article class="@(Model.MarketReceivingConfirmed ? "is-confirmed" : null)">
                <MudIcon Icon="@(Model.MarketReceivingConfirmed ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" />
                <div><strong>시장 입고 슬롯</strong><span>@(Model.MarketReceivingConfirmed ? "확인됨" : "상인회·상인 확인 필요")</span></div>
            </article>
            <article class="@(Model.CanDispatchDirectlyToMarket ? "is-confirmed" : null)">
                <MudIcon Icon="@(Model.CanDispatchDirectlyToMarket ? Icons.Material.Filled.LocalShipping : Icons.Material.Filled.Schedule)" />
                <div><strong>직입고 가능 상태</strong><span>@(Model.CanDispatchDirectlyToMarket ? "출하 가능" : "확정 조건 확인 중")</span></div>
            </article>
        </div>

        <section class="domestic-market-supply__roles" aria-labelledby="domestic-market-supply-roles-title">
            <header>
                <div>
                    <span>공급자·운송인 자동 배정 없음</span>
                    <h3 id="domestic-market-supply-roles-title">산지에서 시장 입고까지의 역할</h3>
                </div>
                <strong>@($"{Model.Roles.Count(role => role.Accepted)}/{Model.Roles.Count} 수락")</strong>
            </header>
            <div>
                @foreach (var role in Model.Roles)
                {
                    <article class="@(role.Accepted ? "is-accepted" : null)">
                        <MudIcon Icon="@(role.Accepted ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.PersonAdd)"
                                 Color="@(role.Accepted ? Color.Success : Color.Default)" />
                        <div>
                            <strong>@role.Label</strong>
                            <p>@role.Responsibility</p>
                            <small>@role.VerificationLabel</small>
                        </div>
                    </article>
                }
            </div>
        </section>

        <CommunityMarketIngredientSupplyJourney Model="@Model.MarketIngredientSupply" />

        <section class="domestic-market-supply__journey" aria-labelledby="domestic-market-supply-journey-title">
            <header>
                <div>
                    <span>산지 공동 출하부터 참여자 배분까지</span>
                    <h3 id="domestic-market-supply-journey-title">국내 농수산물 10단계 이행</h3>
                </div>
                @if (Model.CurrentStage is { } currentStage)
                {
                    <strong>@($"현재 · {currentStage.Label}")</strong>
                }
            </header>
            <ol>
                @foreach (var stage in Model.Stages.OrderBy(stage => stage.Number))
                {
                    <li class="@BuildStageClass(stage.State)">
                        <span>@stage.Number</span>
                        <div>
                            <strong>@stage.Label</strong>
                            <p>@stage.Detail</p>
                            <small>@stage.ResponsibleRoleLabel · @stage.EvidenceLabel</small>
                        </div>
                    </li>
                }
            </ol>
        </section>

        <div class="domestic-market-supply__policies">
            <p><MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Small" /> @Model.SupplierSelectionPolicyLabel</p>
            <p><MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" /> @Model.ReceivingPolicyLabel</p>
            <p><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" /> @Model.AllocationPolicyLabel</p>
        </div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            원산지·생산 이력과 품목별 보관·가공·표시 요건은 실제 생산자, 운송 주체와 판매 상인이 확인합니다. 플랫폼은 후보를 자동 선정하거나 적법성·품질을 보증하지 않습니다.
        </MudAlert>
    </section>
}

@code {
    [Parameter, EditorRequired]
    public CommunityDomesticMarketSupplySnapshot Model { get; set; } = new();

    private string FormatQuantity(decimal quantity)
        => $"{quantity:N0}{Model.QuantityUnit}";

    private static string BuildStageClass(CommunityDomesticMarketSupplyStageState state)
        => state switch
        {
            CommunityDomesticMarketSupplyStageState.Completed => "is-completed",
            CommunityDomesticMarketSupplyStageState.Current => "is-current",
            CommunityDomesticMarketSupplyStageState.DirectAcceptanceRequired => "is-acceptance",
            _ => "is-waiting"
        };
}
