    private bool IsSelected(string nodeId)
        => string.Equals(nodeId, selectedNodeId, StringComparison.OrdinalIgnoreCase);

    private void SelectNode(string nodeId)
    {
        selectedNodeId = nodeId;
        pendingAction = null;
        evidenceFile = null;
        evidenceConfirmed = false;
        actionStatusMessage = null;
    }

    private string BuildNodeState(DiagramNodeDto node)
    {
        var block = Context?.블록목록.FirstOrDefault(item =>
            string.Equals(item.블록Id, node.NodeId, StringComparison.OrdinalIgnoreCase));
        return !string.IsNullOrWhiteSpace(block?.상태)
            ? block.상태
            : !string.IsNullOrWhiteSpace(node.Description)
                ? node.Description
                : "상태 정보 없음";
    }

    private static int BuildNodeSequence(DiagramSnapshotDto diagram, DiagramNodeDto node)
        => Array.FindIndex(OrderedNodes(diagram).ToArray(), item =>
            string.Equals(item.NodeId, node.NodeId, StringComparison.OrdinalIgnoreCase)) + 1;

    private Task HandleBackAsync() => OnBack.InvokeAsync();

    private Task HandleAttachAsync() => OnAttach.InvokeAsync();

    private void BeginAction(PlatformCommunityLedgerNodeActionResponse action)
    {
        pendingAction = action;
        evidenceFile = null;
        evidenceConfirmed = false;
        actionStatusMessage = null;
    }

    private void CancelAction()
    {
        pendingAction = null;
        evidenceFile = null;
        evidenceConfirmed = false;
    }

    private void HandleEvidenceSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file.Size > CommunityLedgerNodeActionService.MaxEvidenceFileBytes)
        {
            evidenceFile = null;
            actionSucceeded = false;
            actionStatusMessage = "증빙 사진은 8MB 이하만 선택할 수 있습니다.";
            return;
        }

        if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
        {
            evidenceFile = null;
            actionSucceeded = false;
            actionStatusMessage = "이미지 형식의 증빙 파일을 선택해 주세요.";
            return;
        }

        evidenceFile = file;
        actionStatusMessage = null;
    }

    private bool actionSucceeded;

    private async Task ExecutePendingActionAsync()
    {
        if (pendingAction is null || !CanExecutePendingAction)
        {
            return;
        }

        isExecutingAction = true;
        actionStatusMessage = null;
        try
        {
            CommunityLedgerEvidenceUploadResult? evidence = null;
            if (pendingAction.사진필수여부 && evidenceFile is not null)
            {
                evidence = await NodeActionService.상차증빙업로드Async(pendingAction, evidenceFile);
            }

            var result = await NodeActionService.실행Async(pendingAction, evidence);
            actionSucceeded = true;
            actionStatusMessage = $"{pendingAction.표시명} 처리가 완료되었습니다. 현재 상태는 {result.상태}입니다.";
            pendingAction = null;
            evidenceFile = null;
            evidenceConfirmed = false;
            await RequestRefreshAsync();
        }
        catch (Exception ex)
        {
            actionSucceeded = false;
            actionStatusMessage = ex.Message;
        }
        finally
        {
            isExecutingAction = false;
        }
    }

    private async Task JoinLedgerRoomAsync(PlatformCommunityPostLedgerContextResponse context)
    {
        var roomId = DiagramLedgerRoomIds.Build(context.원장Id);
        if (string.Equals(joinedLedgerRoomId, roomId, StringComparison.OrdinalIgnoreCase)
            && DiagramCollaborationClient.연결됨)
        {
            realtimeConnected = true;
            realtimeStatus = "원장 변경 실시간 반영 중";
            return;
        }

        if (isJoiningLedgerRoom)
        {
            return;
        }

        isJoiningLedgerRoom = true;
        try
        {
            realtimeStatus = "실시간 연결 중";
            realtimeConnected = await DiagramCollaborationClient.방입장Async(new DiagramRoomJoinRequest
            {
                RoomId = roomId,
                CommunityId = "platform",
                LedgerId = context.원장Id,
                DiagramId = context.다이어그램?.DiagramId,
                DiagramName = context.다이어그램?.DiagramName ?? context.제목,
                LedgerTemplateKey = context.원장템플릿Key
            });
            joinedLedgerRoomId = realtimeConnected ? roomId : null;
            realtimeStatus = realtimeConnected ? "원장 변경 실시간 반영 중" : "실시간 연결 대기 중";
        }
        finally
        {
            isJoiningLedgerRoom = false;
        }
    }

    private async Task HandleLedgerChangedAsync(DiagramLedgerChangedResponse changed)
    {
        if (disposed
            || Context is null
            || !string.Equals(Context.원장Id, changed.LedgerId, StringComparison.OrdinalIgnoreCase)
            || changed.Revision > 0 && changed.Revision <= Context.Revision)
        {
            return;
        }

        realtimeStatus = string.IsNullOrWhiteSpace(changed.CurrentStep)
            ? "원장 변경을 반영하는 중"
            : $"{changed.CurrentStep} 변경을 반영하는 중";
        await InvokeAsync(RequestRefreshAsync);
        realtimeStatus = "원장 변경 실시간 반영 중";
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleRealtimeStatusChangedAsync(string message)
    {
        if (disposed)
        {
            return;
        }

        realtimeConnected = DiagramCollaborationClient.연결됨;
        realtimeStatus = realtimeConnected ? "원장 변경 실시간 반영 중" : message;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RequestRefreshAsync()
    {
        if (isRefreshing || !OnRefreshRequested.HasDelegate)
        {
            return;
        }

        isRefreshing = true;
        try
        {
            await OnRefreshRequested.InvokeAsync();
        }
        finally
        {
            isRefreshing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        DiagramCollaborationClient.원장변경수신 -= HandleLedgerChangedAsync;
        DiagramCollaborationClient.상태변경 -= HandleRealtimeStatusChangedAsync;
        if (!string.IsNullOrWhiteSpace(joinedLedgerRoomId))
        {
            await DiagramCollaborationClient.연결해제Async();
        }
    }

    private sealed record NodeLayout(DiagramNodeDto Node, int X, int Y);
}
