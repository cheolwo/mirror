@namespace Hongdal.Ui.Common.Areas.App.Components.Community
@using Hongdal.Contracts.Common.Community
@using Hongdal.Ui.Common.Areas.App.Services
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject CommunityLedgerNodeActionService NodeActionService
@inject IDiagramCollaborationClientService DiagramCollaborationClient

<section class="ledger-diagram-detail" aria-label="원장 다이어그램 상세">
    <header class="ledger-diagram-detail__header">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="HandleBackAsync"
                       aria-label="원장 목록으로 돌아가기" />
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">원장 내부 보기</MudText>
            <MudText Typo="Typo.h5">@(Context?.제목 ?? "원장 다이어그램")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">흐름을 선택하면 해당 블록의 내부 항목을 확인할 수 있습니다.</MudText>
        </div>
    </header>

    @if (IsLoading)
    {
        <div class="ledger-diagram-detail__state" aria-live="polite">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
            <span>원장 내부 데이터를 불러오는 중입니다.</span>
        </div>
    }
    else if (Context is null)
    {
        <div class="ledger-diagram-detail__state">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Warning" Size="Size.Large" />
            <strong>원장 상세를 표시할 수 없습니다.</strong>
            <span>@(ErrorMessage ?? "공개 범위 또는 접근 권한을 확인해 주세요.")</span>
        </div>
    }
    else
    {
        <div class="ledger-diagram-detail__summary" aria-label="원장 요약">
            <div>
                <span>원장 종류</span>
                <strong>@Context.원장템플릿명</strong>
            </div>
            <div>
                <span>현재 상태</span>
                <strong>@Context.상태</strong>
            </div>
            <div>
                <span>현재 단계</span>
                <strong>@(string.IsNullOrWhiteSpace(Context.현재단계) ? "단계 정보 없음" : Context.현재단계)</strong>
            </div>
            <div>
                <span>조회 범위</span>
                <strong>@ResolveAccessScopeLabel(Context)</strong>
            </div>
        </div>

        @if (string.Equals(Context.원장템플릿Key, CommunityLedgerTemplateKeys.GroupImport, StringComparison.OrdinalIgnoreCase))
        {
            @if (Context.역할권한관리가능여부)
            {
                <CommunityGroupImportRoleAccessPanel LedgerId="@Context.원장Id" Saved="RequestRefreshAsync" />
            }
            else if (Context.역할범위조회여부)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                    현재 계정은 <strong>@Context.접근역할명</strong> 권한으로 @(Context.조회가능노드Ids.Count)개 노드를 조회합니다.
                    편집 가능한 노드는 @(Context.편집가능노드Ids.Count)개이며,
                    운송 주선은 @(Context.운송주선가능여부 ? "허용됨" : "허용되지 않음") 상태입니다.
                </MudAlert>
            }
        }

        @if (Context.다이어그램 is { Nodes.Count: > 0 } diagram)
        {
            var nodeLayouts = BuildNodeLayouts(diagram);
            var canvasHeight = BuildCanvasHeight(nodeLayouts.Count);

            <div class="ledger-diagram-detail__body">
                <div class="ledger-diagram-detail__canvas-section">
                    <div class="ledger-diagram-detail__canvas-heading">
                        <div>
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" />
                            <strong>@(string.IsNullOrWhiteSpace(diagram.DiagramName) ? "원장 흐름" : diagram.DiagramName)</strong>
                        </div>
                        <div class="ledger-diagram-detail__canvas-meta">
                            <span>@($"{diagram.Nodes.Count}개 블록 · {diagram.Edges.Count}개 연결")</span>
                            <span class="ledger-diagram-detail__legend" aria-label="노드 상태 범례">
                                <i class="ledger-diagram-detail__legend-dot ledger-diagram-detail__legend-dot--complete"></i>완료
                                <i class="ledger-diagram-detail__legend-dot ledger-diagram-detail__legend-dot--active"></i>진행
                                <i class="ledger-diagram-detail__legend-dot ledger-diagram-detail__legend-dot--upcoming"></i>예정
                            </span>
                        </div>
                    </div>

                    <div class="ledger-diagram-detail__desktop-scroll">
                        <div class="ledger-diagram-detail__canvas" style="@($"height:{canvasHeight}px")">
                            <svg class="ledger-diagram-detail__edges"
                                 viewBox="@($"0 0 {CanvasWidth} {canvasHeight}")"
                                 preserveAspectRatio="xMinYMin meet"
                                 aria-hidden="true">
                                <defs>
                                    <marker id="ledger-detail-arrow"
                                            markerWidth="9"
                                            markerHeight="9"
                                            refX="8"
                                            refY="4.5"
                                            orient="auto">
                                        <path d="M 0 0 L 9 4.5 L 0 9 z" class="ledger-diagram-detail__arrow" />
                                    </marker>
                                </defs>
                                @foreach (var edge in diagram.Edges)
                                {
                                    var from = nodeLayouts.FirstOrDefault(item =>
                                        string.Equals(item.Node.NodeId, edge.FromNodeId, StringComparison.OrdinalIgnoreCase));
                                    var to = nodeLayouts.FirstOrDefault(item =>
                                        string.Equals(item.Node.NodeId, edge.ToNodeId, StringComparison.OrdinalIgnoreCase));
                                    if (from is not null && to is not null)
                                    {
                                        <path d="@BuildEdgePath(from, to)"
                                              class="ledger-diagram-detail__edge"
                                              marker-end="url(#ledger-detail-arrow)" />
                                    }
                                }
                            </svg>

                            @foreach (var nodeLayout in nodeLayouts)
                            {
                                <button type="button"
                                        class="@BuildNodeClass(nodeLayout.Node)"
                                        style="@BuildNodeStyle(nodeLayout)"
                                        aria-pressed="@IsSelected(nodeLayout.Node.NodeId)"
                                        @onclick="@(() => SelectNode(nodeLayout.Node.NodeId))">
                                    <span class="ledger-diagram-detail__node-type">
                                        <span class="ledger-diagram-detail__node-icon">
                                            <MudIcon Icon="@ResolveNodeIcon(nodeLayout.Node)" Size="Size.Small" />
                                        </span>
                                        @ResolveNodeTypeLabel(nodeLayout.Node)
                                        @if (nodeLayout.Node.OrganizationReferences?.Count > 0)
                                        {
                                            <span class="ledger-diagram-detail__node-organization-count">@($"업체 {nodeLayout.Node.OrganizationReferences.Count}")</span>
                                        }
                                    </span>
                                    <strong>@nodeLayout.Node.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(BuildAssigneeSummary(nodeLayout.Node.NodeId)))
                                    {
                                        <small class="ledger-diagram-detail__node-assignee">담당 · @BuildAssigneeSummary(nodeLayout.Node.NodeId)</small>
                                    }
                                    <small class="ledger-diagram-detail__node-state">
                                        <i></i>
                                        @BuildNodeState(nodeLayout.Node)
                                    </small>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="ledger-diagram-detail__mobile-flow" aria-label="모바일 원장 흐름">
                        @foreach (var node in OrderedNodes(diagram))
                        {
                            <button type="button"
                                    class="@BuildMobileNodeClass(node)"
                                    aria-pressed="@IsSelected(node.NodeId)"
                                    @onclick="@(() => SelectNode(node.NodeId))">
                                <span class="ledger-diagram-detail__mobile-step">@BuildNodeSequence(diagram, node)</span>
                                <span class="ledger-diagram-detail__mobile-content">
                                    <span class="ledger-diagram-detail__mobile-type">
                                        <MudIcon Icon="@ResolveNodeIcon(node)" Size="Size.Small" />
                                        @ResolveNodeTypeLabel(node)
                                        @if (node.OrganizationReferences?.Count > 0)
                                        {
                                            <span class="ledger-diagram-detail__node-organization-count">@($"업체 {node.OrganizationReferences.Count}")</span>
                                        }
                                    </span>
                                    <strong>@node.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(BuildAssigneeSummary(node.NodeId)))
                                    {
                                        <small class="ledger-diagram-detail__mobile-assignee">담당 · @BuildAssigneeSummary(node.NodeId)</small>
                                    }
                                    <small class="ledger-diagram-detail__mobile-state">
                                        <i></i>
                                        @BuildNodeState(node)
                                    </small>
                                </span>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Default" />
                            </button>
                            @foreach (var edge in OutgoingEdges(diagram, node.NodeId))
                            {
                                <div class="ledger-diagram-detail__mobile-edge">
                                    <MudIcon Icon="@Icons.Material.Filled.South" Color="Color.Primary" Size="Size.Small" />
                                    <span>@(string.IsNullOrWhiteSpace(edge.Label) ? "다음" : edge.Label)</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                <aside class="ledger-diagram-detail__inspector" aria-label="선택한 블록 내부 데이터">
                    <div class="ledger-diagram-detail__inspector-heading">
                        <span class="ledger-diagram-detail__inspector-icon">
                            <MudIcon Icon="@(SelectedNode is null ? Icons.Material.Filled.DataObject : ResolveNodeIcon(SelectedNode))" />
                        </span>
                        <div>
                            <span>선택한 블록</span>
                            <strong>@(SelectedNode?.Title ?? "블록을 선택하세요")</strong>
                        </div>
                        <button type="button"
                                class="ledger-diagram-detail__refresh"
                                title="원장 새로고침"
                                aria-label="원장 새로고침"
                                disabled="@isRefreshing"
                                @onclick="RequestRefreshAsync">
                            <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" />
                        </button>
                    </div>

                    <div class="ledger-diagram-detail__live-status" aria-live="polite">
                        <i class="@(realtimeConnected ? "is-connected" : string.Empty)"></i>
                        <span>@realtimeStatus</span>
                    </div>

                    @if (SelectedNode is null)
                    {
                        <p>다이어그램에서 확인할 블록을 선택하세요.</p>
                    }
                    else
                    {
                        <dl class="ledger-diagram-detail__metadata">
                            <div>
                                <dt>블록 ID</dt>
                                <dd>@SelectedNode.NodeId</dd>
                            </div>
                            <div>
                                <dt>블록 유형</dt>
                                <dd>@(SelectedBlock?.블록유형 ?? SelectedNode.Kind)</dd>
                            </div>
                            <div>
                                <dt>상태</dt>
                                <dd>@BuildNodeState(SelectedNode)</dd>
                            </div>
                        </dl>

                        @if (Context.상세조회가능여부 || Context.역할범위조회여부)
                        {
                            <section class="ledger-diagram-detail__assignees" aria-label="블록 담당자">
                                <strong>블록 담당자</strong>
                                @if (SelectedBlock is { 담당자목록.Count: > 0 } assignedBlock)
                                {
                                    <MudChipSet T="string" ReadOnly="true">
                                        @foreach (var assignee in assignedBlock.담당자목록)
                                        {
                                            <MudChip T="string" Value="@assignee.UserId" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                                                @($"{assignee.ResponsibilityName} · {assignee.DisplayName} ({assignee.RoleLabel})")
                                            </MudChip>
                                        }
                                    </MudChipSet>
                                }
                                else
                                {
                                    <span>아직 지정된 담당자가 없습니다.</span>
                                }
                            </section>

                            @if (Context.상세조회가능여부)
                            {
                                <CommunityLedgerBlockAssignmentPanel LedgerId="@Context.원장Id"
                                                                     BlockId="@SelectedNode.NodeId"
                                                                     Saved="RequestRefreshAsync" />
                            }
                        }

                        @if (SelectedNode.OrganizationReferences is { Count: > 0 } organizationReferences)
                        {
                            <section class="ledger-diagram-detail__organizations" aria-label="연결 업체 후보">
                                <div class="ledger-diagram-detail__organizations-heading">
                                    <strong>연결 업체·기관</strong>
                                    <span>@($"{organizationReferences.Count:N0}곳")</span>
                                </div>
                                @foreach (var organization in organizationReferences)
                                {
                                    var websiteUrl = ResolveExternalHttpUrl(organization.OfficialWebsiteUrl);
                                    var sourceUrl = ResolveExternalHttpUrl(organization.SourceReferenceUrl);
                                    <article>
                                        <div>
                                            <strong>@organization.DisplayName</strong>
                                            <span>@organization.RoleLabel · @organization.CountryCode</span>
                                        </div>
                                        <MudChipSet T="string" ReadOnly="true">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                                @ResolveOrganizationRelationshipLabel(organization)
                                            </MudChip>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                @ResolveOrganizationVerificationLabel(organization)
                                            </MudChip>
                                        </MudChipSet>
                                        @if (websiteUrl is not null || sourceUrl is not null)
                                        {
                                            <div class="ledger-diagram-detail__organization-links">
                                                @if (websiteUrl is not null)
                                                {
                                                    <a href="@websiteUrl" target="_blank" rel="noopener noreferrer">공식 사이트</a>
                                                }
                                                @if (sourceUrl is not null && !string.Equals(sourceUrl, websiteUrl, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <a href="@sourceUrl" target="_blank" rel="noopener noreferrer">조사 출처</a>
                                                }
                                            </div>
                                        }
                                    </article>
                                }
                                <small>연결 정보는 조사 후보이며 선정·계약·면허 확인을 대신하지 않습니다.</small>
                            </section>
                        }

                        @if (SelectedBlock is { 항목.Count: > 0 } block)
                        {
                            <div class="ledger-diagram-detail__fields">
                                @foreach (var item in block.항목)
                                {
                                    <div>
                                        <span>@item.Key</span>
                                        <strong>@item.Value</strong>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="ledger-diagram-detail__empty-fields">
                                <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Color="Color.Default" />
                                <span>이 블록에 공개된 세부 항목이 없습니다.</span>
                            </div>
                        }

                        @if (Context.상세조회가능여부)
                        {
                            <section class="ledger-diagram-detail__node-actions" aria-label="선택한 블록 업무">
                                <div class="ledger-diagram-detail__node-actions-heading">
                                    <div>
                                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" />
                                        <strong>이 블록에서 할 수 있는 일</strong>
                                    </div>
                                    <span>@($"{SelectedNodeActions.Count(action => action.실행가능여부)}개 실행 가능")</span>
                                </div>

                                @if (SelectedNodeActions.Count == 0)
                                {
                                    <p class="ledger-diagram-detail__node-actions-empty">현재 계정과 진행 상태에서 실행할 수 있는 업무가 없습니다.</p>
                                }
                                else
                                {
                                    @foreach (var action in SelectedNodeActions)
                                    {
                                        <div class="@(action.실행가능여부 ? "ledger-diagram-detail__action-item" : "ledger-diagram-detail__action-item ledger-diagram-detail__action-item--disabled")">
                                            <div>
                                                <strong>@action.표시명</strong>
                                                <span>@action.설명</span>
                                                @if (!action.실행가능여부 && !string.IsNullOrWhiteSpace(action.비활성사유))
                                                {
                                                    <small>@action.비활성사유</small>
                                                }
                                            </div>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@(!action.실행가능여부 || isExecutingAction)"
                                                       OnClick="@(() => BeginAction(action))">
                                                실행
                                            </MudButton>
                                        </div>
                                    }
                                }

                                @if (pendingAction is not null)
                                {
                                    <div class="ledger-diagram-detail__action-confirm">
                                        <div class="ledger-diagram-detail__action-confirm-title">
                                            <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Small" />
                                            <strong>@pendingAction.표시명 확인</strong>
                                        </div>
                                        <p>@pendingAction.설명</p>

                                        @if (pendingAction.사진필수여부)
                                        {
                                            <label class="ledger-diagram-detail__evidence-picker">
                                                <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Small" />
                                                <span>@(evidenceFile is null ? "상차·인수 증빙 사진 선택" : evidenceFile.Name)</span>
                                                <InputFile OnChange="HandleEvidenceSelected" accept="image/*" />
                                            </label>
                                            <MudCheckBox T="bool"
                                                         @bind-Value="evidenceConfirmed"
                                                         Color="Color.Primary"
                                                         Label="사진에 현장 상차 또는 인수 확인 내용이 포함되어 있습니다." />
                                        }

                                        <div class="ledger-diagram-detail__action-confirm-buttons">
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Default"
                                                       Disabled="@isExecutingAction"
                                                       OnClick="CancelAction">
                                                취소
                                            </MudButton>
                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       StartIcon="@Icons.Material.Filled.Check"
                                                       Disabled="@(!CanExecutePendingAction)"
                                                       OnClick="ExecutePendingActionAsync">
                                                @(isExecutingAction ? "처리 중" : "확인 후 실행")
                                            </MudButton>
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(actionStatusMessage))
                                {
                                    <div class="@(actionSucceeded ? "ledger-diagram-detail__action-status ledger-diagram-detail__action-status--success" : "ledger-diagram-detail__action-status ledger-diagram-detail__action-status--error")">
                                        <MudIcon Icon="@(actionSucceeded ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ErrorOutline)" Size="Size.Small" />
                                        <span>@actionStatusMessage</span>
                                    </div>
                                }
                            </section>
                        }
                    }

                    <p class="ledger-diagram-detail__privacy">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                        공개 설정과 참여 권한에 따라 서버에서 허용한 항목만 표시합니다.
                    </p>
                </aside>
            </div>
        }
        else
        {
            <div class="ledger-diagram-detail__state">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Default" Size="Size.Large" />
                <strong>저장된 다이어그램이 없습니다.</strong>
                <span>원장 블록은 확인할 수 있지만 아직 연결 구조가 저장되지 않았습니다.</span>
            </div>
        }

        <footer class="ledger-diagram-detail__actions">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="HandleBackAsync">목록으로</MudButton>
            @if (OnAttach.HasDelegate && !HideAttach)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AttachFile"
                           OnClick="HandleAttachAsync">
                    이 원장 첨부
                </MudButton>
            }
        </footer>
    }
</section>

@code {
    private const int CanvasWidth = 560;
    private const int NodeWidth = 140;
    private const int NodeHeight = 108;
    private const int LeftMargin = 30;
    private const int TopMargin = 48;
    private const int ColumnGap = 40;
    private const int RowGap = 72;
    private const int ColumnCount = 3;

    private string? selectedNodeId;
    private string? loadedLedgerId;
    private string? joinedLedgerRoomId;
    private PlatformCommunityLedgerNodeActionResponse? pendingAction;
    private IBrowserFile? evidenceFile;
    private string realtimeStatus = "실시간 연결 준비 중";
    private string? actionStatusMessage;
    private bool realtimeConnected;
    private bool isJoiningLedgerRoom;
    private bool evidenceConfirmed;
    private bool isExecutingAction;
    private bool isRefreshing;
    private bool disposed;

    [Parameter]
    public PlatformCommunityPostLedgerContextResponse? Context { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public EventCallback OnAttach { get; set; }

    [Parameter]
    public bool HideAttach { get; set; }

    [Parameter]
    public EventCallback OnRefreshRequested { get; set; }

    private DiagramNodeDto? SelectedNode
        => Context?.다이어그램?.Nodes.FirstOrDefault(node =>
            string.Equals(node.NodeId, selectedNodeId, StringComparison.OrdinalIgnoreCase));

    private PlatformCommunityLedgerBlockResponse? SelectedBlock
        => Context?.블록목록.FirstOrDefault(block =>
            string.Equals(block.블록Id, selectedNodeId, StringComparison.OrdinalIgnoreCase));

    private string BuildAssigneeSummary(string nodeId)
    {
        var assignees = Context?.블록목록.FirstOrDefault(block =>
            string.Equals(block.블록Id, nodeId, StringComparison.OrdinalIgnoreCase))?.담당자목록 ?? [];
        var primary = assignees.FirstOrDefault(assignee =>
            string.Equals(
                assignee.ResponsibilityType,
                CommunityLedgerBlockResponsibilityTypes.Primary,
                StringComparison.OrdinalIgnoreCase));
        if (primary is not null)
        {
            return primary.DisplayName;
        }

        return assignees.Count == 0
            ? string.Empty
            : assignees.Count == 1
                ? assignees[0].DisplayName
                : $"{assignees[0].DisplayName} 외 {assignees.Count - 1}명";
    }

    private IReadOnlyList<PlatformCommunityLedgerNodeActionResponse> SelectedNodeActions
        => Context?.노드행동목록
               .Where(action => string.Equals(action.블록Id, selectedNodeId, StringComparison.OrdinalIgnoreCase))
               .ToArray()
           ?? [];

    private bool CanExecutePendingAction
        => pendingAction is not null
           && !isExecutingAction
           && (!pendingAction.사진필수여부 || evidenceFile is not null && evidenceConfirmed);

    private static string ResolveAccessScopeLabel(PlatformCommunityPostLedgerContextResponse context)
        => context.역할범위조회여부
            ? $"{context.접근역할명} 역할 범위"
            : context.상세조회가능여부
                ? "참여자 상세"
                : "공개 항목";

    private static string ResolveOrganizationRelationshipLabel(
        DiagramOrganizationReferenceDto organization)
        => organization.IsPlatformPartner
            ? "플랫폼 제휴"
            : "플랫폼 제휴 없음";

    private static string ResolveOrganizationVerificationLabel(
        DiagramOrganizationReferenceDto organization)
        => organization.CanBeSelectedForOperations
            ? "업무 선택 가능"
            : string.Equals(
                organization.CompanySourceVerificationStatusCode,
                DiagramOrganizationVerificationStatusCodes.PublicSourceReviewed,
                StringComparison.OrdinalIgnoreCase)
