@using Hongdal.Ui.Common.Areas.App.Services

<section class="hongdal-bagua hongdal-prajna-upaya"
         style="@BuildRootStyle()"
         aria-label="@($"역할 미설정 상태의 {PrajnaLabel}와 {UpayaLabel} 태극 이동")">
    <header>
        <div>
            <span>@PrajnaLabel · @UpayaLabel</span>
            <strong>역할을 정하기 전의 공통 시작점</strong>
        </div>
        <small>바깥 태극은 @(UpayaLabel)과 @PrajnaLabel, 안쪽 태극은 커뮤니티와 상점입니다.</small>
    </header>

    <div class="hongdal-bagua-wheel hongdal-prajna-upaya-wheel"
         role="img"
         aria-label="@($"바깥쪽 빨간 영역은 {UpayaLabel}, 파란 영역은 {PrajnaLabel}인 태극과 안쪽 커뮤니티·상점 태극")">
        <div class="hongdal-prajna-upaya-outer" role="group" aria-label="@($"{UpayaLabel}과 {PrajnaLabel} 이동")">
            <svg viewBox="-50 -50 100 100" focusable="false">
                <defs>
                    @Pattern(OuterUpayaPatternId, Theme.OuterUpaya)
                    @Pattern(OuterPrajnaPatternId, Theme.OuterPrajna)
                </defs>
                <circle cx="0" cy="0" r="50" style="@BuildFillStyle(Theme.OuterUpaya, OuterUpayaPatternId)" />
                <path d="M -42 17
                         C -27 4 -15 29 0 18
                         C 15 7 29 7 42 18
                         C 39 35 23 48 0 50
                         C -23 48 -39 35 -42 17 Z"
                      style="@BuildFillStyle(Theme.OuterPrajna, OuterPrajnaPatternId)" />
            </svg>
            <button type="button"
                    class="hongdal-prajna-upaya-outer-action hongdal-prajna-upaya-outer-action--upaya"
                    aria-label="@($"{UpayaLabel} 영역으로 이동")"
                    disabled="@(!UpayaSelected.HasDelegate)"
                    @onclick="UpayaSelected">
                <span>@UpayaLabel</span>
            </button>
            <button type="button"
                    class="hongdal-prajna-upaya-outer-action hongdal-prajna-upaya-outer-action--prajna"
                    aria-label="@($"{PrajnaLabel} 영역으로 이동")"
                    disabled="@(!PrajnaSelected.HasDelegate)"
                    @onclick="PrajnaSelected">
                <span>@PrajnaLabel</span>
            </button>
        </div>

        <div class="hongdal-prajna-upaya-inner"
             role="group"
             aria-label="간괘 태극 중심 이동">
            <svg viewBox="-50 -50 100 100" focusable="false" aria-hidden="true">
                <defs>
                    @Pattern(CommunityPatternId, Theme.InnerCommunity)
                    @Pattern(StorePatternId, Theme.InnerStore)
                </defs>
                <g transform="rotate(-56.3099325)">
                    <path d="M 50 0 a 25 25 0 1 1 -50 0 a 25 25 0 1 0 -50 0 a 50 50 0 1 1 100 0 Z"
                          style="@BuildFillStyle(Theme.InnerCommunity, CommunityPatternId)" />
                    <path d="M -50 0 a 25 25 0 1 1 50 0 a 25 25 0 1 0 50 0 a 50 50 0 1 1 -100 0 Z"
                          style="@BuildFillStyle(Theme.InnerStore, StorePatternId)" />
                </g>
            </svg>

            <button type="button"
                    class="hongdal-prajna-upaya-inner-action hongdal-prajna-upaya-inner-action--yang"
                    aria-label="빨간 양효 영역, 커뮤니티로 이동"
                    @onclick="CommunitySelected">
                커뮤니티
            </button>
            <button type="button"
                    class="hongdal-prajna-upaya-inner-action hongdal-prajna-upaya-inner-action--yin"
                    aria-label="파란 음효 영역, 상점으로 이동"
                    @onclick="StoreSelected">
                상점
            </button>
            <span class="hongdal-prajna-upaya-center-mark" style="@($"background-color: {Theme.CenterGen.Color};")" aria-hidden="true">
                @if (Theme.CenterGen.HasImage)
                {
                    <img src="@Theme.CenterGen.ImageUrl" alt="" />
                }
                <b>☶</b>
                <small>간</small>
            </span>
        </div>
    </div>

    <footer>
        <span>@(UpayaLabel)과 @PrajnaLabel</span>
        <span>커뮤니티와 상점</span>
    </footer>
</section>

@code {
    [Parameter]
    public string UpayaLabel { get; set; } = "방편";

    [Parameter]
    public string PrajnaLabel { get; set; } = "정보";

    [Parameter]
    public string AccentColor { get; set; } = "#7c3aed";

    [Parameter]
    public HomeNavigatorThemeManifest Theme { get; set; } = PlatformCommunityDecorationStateService.CreateDefaultHomeTheme();

    [Parameter]
    public EventCallback CommunitySelected { get; set; }

    [Parameter]
    public EventCallback StoreSelected { get; set; }

    [Parameter]
    public EventCallback UpayaSelected { get; set; }

    [Parameter]
    public EventCallback PrajnaSelected { get; set; }

    private readonly string instanceId = $"navigator-{Guid.NewGuid():N}";

    private string OuterUpayaPatternId => $"{instanceId}-outer-upaya";
    private string OuterPrajnaPatternId => $"{instanceId}-outer-prajna";
    private string CommunityPatternId => $"{instanceId}-community";
    private string StorePatternId => $"{instanceId}-store";

    private string BuildRootStyle()
        => $"--hongdal-prajna-upaya-accent: {Theme.AccentColor}; --taegeuk-yang: {Theme.OuterUpaya.Color}; --taegeuk-yin: {Theme.OuterPrajna.Color}; --inner-community: {Theme.InnerCommunity.Color}; --inner-store: {Theme.InnerStore.Color}; --theme-frame: {Theme.Frame.Color}; --theme-label: {Theme.Labels.Color};";

    private static string BuildFillStyle(HomeNavigatorThemeSlot slot, string patternId)
        => slot.HasImage ? $"fill: url(#{patternId});" : $"fill: {slot.Color};";

    private RenderFragment Pattern(string id, HomeNavigatorThemeSlot slot) => builder =>
    {
        if (!slot.HasImage)
        {
            return;
        }

        var sequence = 0;
        builder.OpenElement(sequence++, "pattern");
        builder.AddAttribute(sequence++, "id", id);
        builder.AddAttribute(sequence++, "patternUnits", "userSpaceOnUse");
        builder.AddAttribute(sequence++, "x", "-50");
        builder.AddAttribute(sequence++, "y", "-50");
        builder.AddAttribute(sequence++, "width", "100");
        builder.AddAttribute(sequence++, "height", "100");
        builder.OpenElement(sequence++, "image");
        builder.AddAttribute(sequence++, "href", slot.ImageUrl);
        builder.AddAttribute(sequence++, "x", "-50");
        builder.AddAttribute(sequence++, "y", "-50");
        builder.AddAttribute(sequence++, "width", "100");
        builder.AddAttribute(sequence++, "height", "100");
        builder.AddAttribute(sequence++, "preserveAspectRatio", "xMidYMid slice");
        builder.CloseElement();
        builder.CloseElement();
    };
}
