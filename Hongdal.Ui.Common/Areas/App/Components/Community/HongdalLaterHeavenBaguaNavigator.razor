@using Microsoft.AspNetCore.Components.Web

<section class="hongdal-bagua" style="@BuildRootStyle()" aria-label="후천팔괘 빠른 이동">
    <header>
        <div>
            <span>後天八卦 · 四方</span>
            <strong>@RoleLabel 역할의 네 방향</strong>
        </div>
        <small>@CurrentGuide</small>
    </header>

    <div class="hongdal-bagua-wheel"
         @onpointermove="HandlePointerMove"
         @onpointerup="HandlePointerUpAsync"
         @onpointercancel="CancelAllDrags"
         @onpointerleave="HandlePointerLeave">
        <span class="hongdal-bagua-octagon" aria-hidden="true"></span>
        <span class="hongdal-bagua-direction hongdal-bagua-direction--south">남</span>
        <span class="hongdal-bagua-direction hongdal-bagua-direction--north">북</span>
        <span class="hongdal-bagua-direction hongdal-bagua-direction--east">동</span>
        <span class="hongdal-bagua-direction hongdal-bagua-direction--west">서</span>
        @foreach (var item in NavigationItems)
        {
            <button type="button"
                    class="@BuildItemClass(item)"
                    style="@BuildItemStyle(item)"
                    title="@BuildItemTitle(item)"
                    aria-label="@BuildItemAriaLabel(item)"
                    disabled="@isCenterTransferAnimating"
                    @onpointerdown="@((PointerEventArgs args) => BeginItemDrag(item, args))"
                    @onclick="@(() => SelectAsync(item))">
                <span>@ResolveItemSymbol(item)</span>
                <b>@item.TrigramName · @ResolveBusinessLabel(item)</b>
                @if (ShouldShowDestinationLabel(item))
                {
                    <small>@item.DestinationLabel</small>
                }
            </button>
        }
        @if (ShowTaegeukCenter)
        {
            <div class="@BuildTaegeukCenterClass()"
                 role="group"
                 aria-label="@($"{CenterTrigramName}괘 태극 중심 이동")">
                <svg class="hongdal-bagua-taegeuk-art"
                     viewBox="-50 -50 100 100"
                     focusable="false"
                     aria-hidden="true">
                    <g transform="rotate(-56.3099325)">
                        <path d="M 50 0 a 25 25 0 1 1 -50 0 a 25 25 0 1 0 -50 0 a 50 50 0 1 1 100 0 Z"
                              class="hongdal-bagua-taegeuk-region hongdal-bagua-taegeuk-yang-shape"
                              role="button"
                              tabindex="0"
                              aria-label="@($"빨간 양효 영역, {TaegeukYangDestinationLabel}로 이동")"
                              @onclick="SelectTaegeukYangAsync"
                              @onkeydown="HandleTaegeukYangKeyDownAsync">
                            <title>@($"빨간 양효 · {TaegeukYangDestinationLabel}")</title>
                        </path>
                        <path d="M -50 0 a 25 25 0 1 1 50 0 a 25 25 0 1 0 50 0 a 50 50 0 1 1 -100 0 Z"
                              class="hongdal-bagua-taegeuk-region hongdal-bagua-taegeuk-yin-shape"
                              role="button"
                              tabindex="0"
                              aria-label="@($"파란 음효 영역, {TaegeukYinDestinationLabel}으로 이동")"
                              @onclick="SelectTaegeukYinAsync"
                              @onkeydown="HandleTaegeukYinKeyDownAsync">
                            <title>@($"파란 음효 · {TaegeukYinDestinationLabel}")</title>
                        </path>
                    </g>
                </svg>
                <span class="hongdal-bagua-taegeuk-label hongdal-bagua-taegeuk-label--yang" aria-hidden="true">
                    @TaegeukYangDestinationLabel
                </span>
                <span class="hongdal-bagua-taegeuk-label hongdal-bagua-taegeuk-label--yin" aria-hidden="true">
                    @TaegeukYinDestinationLabel
                </span>
                <span class="hongdal-bagua-taegeuk-mark" aria-hidden="true">
                    <b>@ResolveCenterSymbol()</b>
                    <small>@BuildCenterMarkLabel()</small>
                </span>
            </div>
        }
        else
        {
            <button type="button"
                    class="@BuildDotClass()"
                    style="@BuildDotStyle()"
                    title="@BuildCenterTitle()"
                    aria-label="@BuildCenterAriaLabel()"
                    @onpointerdown="BeginDrag"
                    @onpointerdown:preventDefault="true"
                    @onpointerdown:stopPropagation="true"
                    @onkeydown="HandleCenterKeyDownAsync"
                    @onkeydown:preventDefault="true">
                <span>@ResolveCenterSymbol()</span>
                @if (CenterSelected.HasDelegate)
                {
                    <small>@CenterTrigramName</small>
                }
            </button>
        }
    </div>

    <footer>
        @if (CenterTransferCompleted.HasDelegate)
        {
            <span>@ResolveCenterTransferTrigramName()괘를 가운데로 끌면</span>
            <span>@CenterTransferDestinationLabel 화면이 열립니다</span>
        }
        else
        {
            <span>점을 끌거나</span>
            <span>괘를 바로 눌러도 됩니다</span>
        }
    </footer>
</section>

@code {
    [Parameter]
    public string RoleLabel { get; set; } = "플랫폼 구성원";

    [Parameter]
    public IReadOnlyList<HongdalCardinalNavigationOption> NavigationItems { get; set; } = DefaultItems;

    [Parameter]
    public EventCallback<HongdalCardinalNavigationOption> DestinationSelected { get; set; }

    [Parameter]
    public EventCallback CenterSelected { get; set; }

    [Parameter]
    public bool ShowTaegeukCenter { get; set; } = true;

    [Parameter]
    public string TaegeukYangDestinationLabel { get; set; } = "커뮤니티";

    [Parameter]
    public string TaegeukYinDestinationLabel { get; set; } = "상점";

    [Parameter]
    public EventCallback TaegeukYangSelected { get; set; }

    [Parameter]
    public EventCallback TaegeukYinSelected { get; set; }

    [Parameter]
    public string AccentColor { get; set; } = "#2563eb";

    [Parameter]
    public string CenterSymbol { get; set; } = "☶";

    [Parameter]
    public string CenterTrigramName { get; set; } = "간";

    [Parameter]
    public string CenterDestinationLabel { get; set; } = "커뮤니티";

    [Parameter]
    public bool ShowTrigramSymbols { get; set; } = true;

    [Parameter]
    public string CenterTransferTrigramKey { get; set; } = string.Empty;

    [Parameter]
    public string CenterTransferDestinationLabel { get; set; } = "공동구매";

    [Parameter]
    public EventCallback<HongdalCardinalNavigationOption> CenterTransferCompleted { get; set; }

    private static readonly IReadOnlyList<HongdalCardinalNavigationOption> DefaultItems =
    [
        new("li", "리", "☲", "남", "판매", HongdalCardinalNavigationActionKinds.Diagram),
        new("dui", "태", "☱", "서", "창고", HongdalCardinalNavigationActionKinds.Work),
        new("kan", "감", "☵", "북", "운송", HongdalCardinalNavigationActionKinds.CommunityHome),
        new("zhen", "진", "☳", "동", "주문", HongdalCardinalNavigationActionKinds.Compose)
    ];

    private bool isDragging;
    private double dragStartX;
    private double dragStartY;
    private string? activeKey;
    private bool isCenterTransferDragging;
    private bool isCenterTransferAnimating;
    private HongdalCardinalNavigationOption? centerTransferItem;
    private double centerTransferStartX;
    private double centerTransferStartY;
    private double centerTransferDragX;
    private double centerTransferDragY;
    private bool isCenterTransferDropReady;
    private string? suppressedClickKey;
    private DateTimeOffset suppressedClickUntil;

    private HongdalCardinalNavigationOption? ActiveItem
        => NavigationItems.FirstOrDefault(item => item.TrigramKey == activeKey);

    private string CurrentGuide => ActiveItem is { } item
        ? isCenterTransferDragging && IsCenterTransferItem(item)
            ? isCenterTransferDropReady
                ? $"{CenterTrigramName}괘에 놓아 {CenterTransferDestinationLabel} 열기"
                : $"{item.TrigramName}괘를 가운데 {CenterTrigramName}괘로 이동"
            : $"{item.TrigramName}괘 · {ResolveBusinessLabel(item)} · {item.DestinationLabel}"
        : ShowTaegeukCenter
            ? $"{CenterTrigramName}괘 · {TaegeukYangDestinationLabel}와 {TaegeukYinDestinationLabel}"
            : CenterSelected.HasDelegate
            ? $"{CenterTrigramName}괘 · {CenterDestinationLabel}"
            : "가운데 점에서 시작";

    private void BeginDrag(PointerEventArgs args)
    {
        isDragging = true;
        dragStartX = args.ClientX;
        dragStartY = args.ClientY;
        activeKey = null;
    }

    private void HandlePointerMove(PointerEventArgs args)
    {
        if (isCenterTransferDragging && centerTransferItem is { } transferItem)
        {
            centerTransferDragX = args.ClientX - centerTransferStartX;
            centerTransferDragY = args.ClientY - centerTransferStartY;
            isCenterTransferDropReady = IsCenterDropTarget(
                transferItem,
                centerTransferDragX,
                centerTransferDragY);
            return;
        }

        if (!isDragging)
        {
            return;
        }

        var deltaX = args.ClientX - dragStartX;
        var deltaY = args.ClientY - dragStartY;
        var distance = Math.Sqrt(deltaX * deltaX + deltaY * deltaY);
        if (distance < 22)
        {
            activeKey = null;
            return;
        }

        activeKey = Math.Abs(deltaX) > Math.Abs(deltaY)
            ? deltaX < 0 ? "zhen" : "dui"
            : deltaY < 0 ? "li" : "kan";
    }

    private async Task HandlePointerUpAsync(PointerEventArgs args)
    {
        if (isCenterTransferDragging)
        {
            await CompleteCenterTransferDragAsync(args);
            return;
        }

        if (!isDragging)
        {
            return;
        }

        isDragging = false;
        if (ActiveItem is { } item)
        {
            await DestinationSelected.InvokeAsync(item);
            return;
        }

        if (CenterSelected.HasDelegate)
        {
            await CenterSelected.InvokeAsync();
        }
    }

    private async Task HandleCenterKeyDownAsync(KeyboardEventArgs args)
    {
        if (CenterSelected.HasDelegate && args.Key is "Enter" or " ")
        {
            await CenterSelected.InvokeAsync();
        }
    }

    private Task SelectTaegeukYangAsync()
        => TaegeukYangSelected.HasDelegate
            ? TaegeukYangSelected.InvokeAsync()
            : Task.CompletedTask;

    private Task SelectTaegeukYinAsync()
        => TaegeukYinSelected.HasDelegate
            ? TaegeukYinSelected.InvokeAsync()
            : Task.CompletedTask;

    private Task HandleTaegeukYangKeyDownAsync(KeyboardEventArgs args)
        => args.Key is "Enter" or " "
            ? SelectTaegeukYangAsync()
            : Task.CompletedTask;

    private Task HandleTaegeukYinKeyDownAsync(KeyboardEventArgs args)
        => args.Key is "Enter" or " "
            ? SelectTaegeukYinAsync()
            : Task.CompletedTask;

    private void HandlePointerLeave()
    {
        if (isDragging || isCenterTransferDragging)
        {
            CancelAllDrags();
        }
    }

    private void CancelAllDrags()
    {
        isDragging = false;
        isCenterTransferDragging = false;
        isCenterTransferDropReady = false;
        centerTransferItem = null;
        centerTransferDragX = 0;
        centerTransferDragY = 0;
        activeKey = null;
    }

    private async Task SelectAsync(HongdalCardinalNavigationOption item)
    {
        if (string.Equals(item.TrigramKey, suppressedClickKey, StringComparison.OrdinalIgnoreCase)
            && DateTimeOffset.UtcNow <= suppressedClickUntil)
        {
            suppressedClickKey = null;
            return;
        }

        activeKey = item.TrigramKey;
        await DestinationSelected.InvokeAsync(item);
    }

    private void BeginItemDrag(HongdalCardinalNavigationOption item, PointerEventArgs args)
    {
        if (!IsCenterTransferItem(item) || isCenterTransferAnimating)
        {
            return;
        }

        isCenterTransferDragging = true;
        isCenterTransferDropReady = false;
        centerTransferItem = item;
        centerTransferStartX = args.ClientX;
        centerTransferStartY = args.ClientY;
        centerTransferDragX = 0;
        centerTransferDragY = 0;
        activeKey = item.TrigramKey;
    }

    private bool IsCenterTransferItem(HongdalCardinalNavigationOption item)
        => CenterTransferCompleted.HasDelegate
           && !string.IsNullOrWhiteSpace(CenterTransferTrigramKey)
           && string.Equals(
               item.TrigramKey,
               CenterTransferTrigramKey,
               StringComparison.OrdinalIgnoreCase);

    private async Task CompleteCenterTransferDragAsync(PointerEventArgs args)
    {
        if (centerTransferItem is not { } item)
        {
            CancelAllDrags();
            return;
        }

        centerTransferDragX = args.ClientX - centerTransferStartX;
        centerTransferDragY = args.ClientY - centerTransferStartY;
        var distance = Math.Sqrt(
            centerTransferDragX * centerTransferDragX
            + centerTransferDragY * centerTransferDragY);
        var droppedOnCenter = IsCenterDropTarget(item, centerTransferDragX, centerTransferDragY);

        isCenterTransferDragging = false;
        isCenterTransferDropReady = droppedOnCenter;
        if (distance >= 8)
        {
            suppressedClickKey = item.TrigramKey;
            suppressedClickUntil = DateTimeOffset.UtcNow.AddMilliseconds(900);
        }

        if (!droppedOnCenter)
        {
            isCenterTransferDropReady = false;
            centerTransferItem = null;
            centerTransferDragX = 0;
            centerTransferDragY = 0;
            activeKey = null;
            return;
        }

        isCenterTransferAnimating = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(520);

        try
        {
            await CenterTransferCompleted.InvokeAsync(item);
        }
        finally
        {
            isCenterTransferAnimating = false;
            isCenterTransferDropReady = false;
            centerTransferItem = null;
            centerTransferDragX = 0;
            centerTransferDragY = 0;
            activeKey = null;
        }
    }

    private static bool IsCenterDropTarget(
        HongdalCardinalNavigationOption item,
        double deltaX,
        double deltaY)
    {
        const double inwardThreshold = 56;
        const double crossAxisTolerance = 86;

        return item.TrigramKey switch
        {
            "li" => deltaY >= inwardThreshold && Math.Abs(deltaX) <= crossAxisTolerance,
            "dui" => deltaX <= -inwardThreshold && Math.Abs(deltaY) <= crossAxisTolerance,
            "kan" => deltaY <= -inwardThreshold && Math.Abs(deltaX) <= crossAxisTolerance,
            _ => deltaX >= inwardThreshold && Math.Abs(deltaY) <= crossAxisTolerance
        };
    }

    private string BuildItemClass(HongdalCardinalNavigationOption item)
    {
        var classes = new List<string> { "hongdal-bagua-item" };
        if (IsCenterTransferItem(item))
        {
            classes.Add("hongdal-bagua-item--center-transfer-enabled");
        }

        if (item.TrigramKey == activeKey)
        {
            classes.Add("hongdal-bagua-item--active");
        }

        if (centerTransferItem?.TrigramKey == item.TrigramKey)
        {
            if (isCenterTransferDragging)
            {
                classes.Add("hongdal-bagua-item--dragging-to-center");
            }

            if (isCenterTransferDropReady)
            {
                classes.Add("hongdal-bagua-item--center-ready");
            }

            if (isCenterTransferAnimating)
            {
                classes.Add("hongdal-bagua-item--center-transfer-completing");
            }
        }

        return string.Join(' ', classes);
    }

    private string BuildItemStyle(HongdalCardinalNavigationOption item)
    {
        var position = item.TrigramKey switch
        {
            "li" => "--bagua-x: 50%; --bagua-y: 10%;",
            "dui" => "--bagua-x: 90%; --bagua-y: 50%;",
            "kan" => "--bagua-x: 50%; --bagua-y: 90%;",
            _ => "--bagua-x: 10%; --bagua-y: 50%;"
        };

        if (centerTransferItem?.TrigramKey != item.TrigramKey)
        {
            return position;
        }

        return $"{position} --bagua-drag-x: {centerTransferDragX:0.##}px; --bagua-drag-y: {centerTransferDragY:0.##}px;";
    }

    private string BuildItemTitle(HongdalCardinalNavigationOption item)
        => IsCenterTransferItem(item)
            ? $"{item.TrigramName}괘 · {ResolveBusinessLabel(item)} · 누르면 {item.DestinationLabel}, 가운데 {CenterTrigramName}괘로 끌면 {CenterTransferDestinationLabel}"
            : $"{item.TrigramName}괘 · {ResolveBusinessLabel(item)} · {item.Direction} · {item.DestinationLabel}";

    private string BuildItemAriaLabel(HongdalCardinalNavigationOption item)
        => IsCenterTransferItem(item)
            ? $"{item.TrigramName}괘, {ResolveBusinessLabel(item)}. 누르면 {item.DestinationLabel}로 이동. 가운데 {CenterTrigramName}괘로 끌어 놓으면 {CenterTransferDestinationLabel} 열기"
            : $"{item.TrigramName}괘, {ResolveBusinessLabel(item)}, {item.Direction}, {item.DestinationLabel}로 이동";

    private static string ResolveBusinessLabel(HongdalCardinalNavigationOption item)
        => !string.IsNullOrWhiteSpace(item.BusinessLabel)
            ? item.BusinessLabel
            : item.TrigramKey switch
        {
            "li" => "판매",
            "dui" => "창고",
            "kan" => "운송",
            _ => "주문"
        };

    private static bool ShouldShowDestinationLabel(HongdalCardinalNavigationOption item)
        => !string.Equals(
            item.DestinationLabel,
            ResolveBusinessLabel(item),
            StringComparison.OrdinalIgnoreCase);

    private string BuildTaegeukCenterClass()
        => isCenterTransferDropReady
            ? "hongdal-bagua-taegeuk-center hongdal-bagua-taegeuk-center--drop-ready"
            : "hongdal-bagua-taegeuk-center";

    private string BuildCenterMarkLabel()
        => isCenterTransferDragging || isCenterTransferAnimating
            ? isCenterTransferDropReady
                ? $"{CenterTrigramName} · 놓기"
                : CenterTrigramName
            : CenterTrigramName;

    private string ResolveCenterTransferTrigramName()
        => NavigationItems.FirstOrDefault(IsCenterTransferItem)?.TrigramName ?? "진";

    private string BuildDotClass()
        => isDragging ? "hongdal-bagua-dot hongdal-bagua-dot--dragging" : "hongdal-bagua-dot";

    private string BuildDotStyle()
        => ActiveItem is { } item
            ? item.TrigramKey switch
            {
                "li" => "--dot-x: 50%; --dot-y: 10%;",
                "dui" => "--dot-x: 90%; --dot-y: 50%;",
                "kan" => "--dot-x: 50%; --dot-y: 90%;",
                _ => "--dot-x: 10%; --dot-y: 50%;"
            }
            : "--dot-x: 50%; --dot-y: 50%;";

    private string BuildRootStyle()
        => $"--hongdal-bagua-accent: {AccentColor};";

    private string ResolveItemSymbol(HongdalCardinalNavigationOption item)
        => ShowTrigramSymbols
            ? item.TrigramSymbol
            : item.TrigramKey switch
            {
                "li" => "↑",
                "dui" => "→",
                "kan" => "↓",
                _ => "←"
            };

    private string ResolveCenterSymbol()
        => string.IsNullOrWhiteSpace(CenterSymbol)
            ? "•"
            : System.Globalization.StringInfo.GetNextTextElement(CenterSymbol.Trim());

    private string BuildCenterTitle()
        => CenterSelected.HasDelegate
            ? $"{CenterTrigramName}괘 · 산 · {CenterDestinationLabel}"
            : "동서남북 네 괘 방향으로 끌기";

    private string BuildCenterAriaLabel()
        => CenterSelected.HasDelegate
            ? $"{CenterTrigramName}괘, 산, {CenterDestinationLabel}로 이동. 누르거나 동서남북 네 괘 방향으로 끌 수 있습니다."
            : "이동점. 동서남북 네 괘 방향으로 끌어 놓으세요.";
}
