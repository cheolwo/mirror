@namespace Hongdal.Ui.Common.Areas.App.Components.Community
@using Hongdal.Contracts.Common.Community
@using Hongdal.Ui.Common.Areas.App.ViewModels

<section class="platform-ledger-picker-page" aria-label="첨부할 원장 선택">
    <header class="platform-ledger-picker-header">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@BackRequested"
                       aria-label="글쓰기로 돌아가기" />
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary">살뜰 게시판 글쓰기</MudText>
            <MudText Typo="Typo.h5">원장 목록</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">글에 첨부할 원장을 선택하세요.</MudText>
        </div>
    </header>

    <div class="platform-ledger-picker-tools">
        <MudTextField T="string"
                      Label="원장 검색"
                      @bind-Value="ViewModel.SearchText"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="platform-ledger-picker-search" />
        <div class="platform-ledger-picker-segments" role="group" aria-label="원장 범위">
            @foreach (var scope in Scopes)
            {
                <button type="button"
                        class="@BuildScopeClass(scope)"
                        aria-pressed="@string.Equals(ViewModel.Scope, scope, StringComparison.Ordinal)"
                        @onclick="@(() => ViewModel.Scope = scope)">
                    @scope
                </button>
            }
        </div>
        <span class="platform-ledger-picker-count">@($"{ViewModel.FilteredItems.Count}개 원장")</span>
    </div>

    <div class="platform-ledger-picker-content">
        @if (ViewModel.IsLoading)
        {
            <div class="platform-ledger-picker-state" aria-live="polite">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <span>원장을 불러오는 중입니다.</span>
            </div>
        }
        else if (ViewModel.Items.Count == 0)
        {
            <div class="platform-ledger-picker-state">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Default" Size="Size.Large" />
                <strong>첨부할 수 있는 원장이 없습니다.</strong>
                <span>@(ViewModel.LoadMessage ?? "로그인 상태와 원장 공유 범위를 확인해 주세요.")</span>
            </div>
        }
        else if (ViewModel.FilteredItems.Count == 0)
        {
            <div class="platform-ledger-picker-state">
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Default" Size="Size.Large" />
                <strong>조건에 맞는 원장이 없습니다.</strong>
                <button type="button" class="platform-ledger-picker-reset" @onclick="ViewModel.ResetFilters">검색 조건 지우기</button>
            </div>
        }
        else
        {
            <div class="platform-ledger-picker-list">
                @foreach (var ledger in ViewModel.FilteredItems)
                {
                    <button type="button"
                            class="@BuildItemClass(ledger)"
                            aria-pressed="@ViewModel.IsPending(ledger)"
                            @onclick="@(() => LedgerSelected.InvokeAsync(ledger))">
                        <span class="platform-ledger-picker-item-icon">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                        </span>
                        <span class="platform-ledger-picker-item-main">
                            <span class="platform-ledger-picker-item-heading">
                                <strong>@ledger.제목</strong>
                                <small>@(ledger.내접근원장여부 ? "내 원장" : "공개 원장")</small>
                            </span>
                            <span>@ledger.원장템플릿명 · @ledger.상태</span>
                            <small>@ledger.참여역할 · @FormatDate(ledger.수정시각Utc)</small>
                        </span>
                        <MudIcon Icon="@(ViewModel.IsPending(ledger) ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                 Color="@(ViewModel.IsPending(ledger) ? Color.Primary : Color.Default)" />
                    </button>
                }
            </div>
        }
    </div>

    <footer class="platform-ledger-picker-actions">
        <div>
            <span>선택한 원장</span>
            <strong>@(PendingLedger?.제목 ?? "아직 선택하지 않음")</strong>
        </div>
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@BackRequested">취소</MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AccountTree"
                       Disabled="@(PendingLedger is null)"
                       OnClick="@DetailRequested">
                다이어그램 보기
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AttachFile"
                       Disabled="@(PendingLedger is null)"
                       OnClick="@AttachRequested">
                선택한 원장 첨부
            </MudButton>
        </MudStack>
    </footer>
</section>

@code {
    private static readonly IReadOnlyList<string> Scopes = ["전체", "내 원장", "공개 원장"];

    [Parameter, EditorRequired]
    public PlatformCommunityLedgerPickerViewModel ViewModel { get; set; } = default!;

    [Parameter]
    public EventCallback BackRequested { get; set; }

    [Parameter]
    public EventCallback<PlatformCommunityPostLedgerChoiceResponse> LedgerSelected { get; set; }

    [Parameter]
    public EventCallback DetailRequested { get; set; }

    [Parameter]
    public EventCallback AttachRequested { get; set; }

    private PlatformCommunityPostLedgerChoiceResponse? PendingLedger
        => ViewModel.Items.FirstOrDefault(ViewModel.IsPending);

    private string BuildItemClass(PlatformCommunityPostLedgerChoiceResponse ledger)
        => ViewModel.IsPending(ledger)
            ? "platform-ledger-picker-item platform-ledger-picker-item--selected"
            : "platform-ledger-picker-item";

    private string BuildScopeClass(string scope)
        => string.Equals(ViewModel.Scope, scope, StringComparison.Ordinal)
            ? "platform-ledger-picker-segment platform-ledger-picker-segment--active"
            : "platform-ledger-picker-segment";

    private static string FormatDate(DateTime dateTimeUtc)
        => dateTimeUtc.ToLocalTime().ToString("yyyy.MM.dd HH:mm");
}
