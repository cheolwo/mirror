@using System.Globalization
@using Hongdal.Contracts.Common.Inbound
@using Hongdal.Contracts.Common.Sales
@using Hongdal.Contracts.Common.Warehouse
@using Hongdal.Ui.Common.Areas.App.Components.Crud
@using Hongdal.Ui.Common.Areas.App.Services
@using Hongdal.Ui.Common.Areas.App.ViewModels
@using Microsoft.AspNetCore.Components
@inject NavigationManager Navigation
@inject IWarehouseWorkspaceService WarehouseService
@inject 판매상품조회ViewModel ProductSearchViewModel

<MudContainer MaxWidth="MaxWidth.False" Class="py-6">
    <MudStack Spacing="3">
        <div class="inbound-page-header-wrap">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="inbound-page-header">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">@Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
                </MudStack>
                <MudButton Class="inbound-page-refresh" Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync">새로고침</MudButton>
            </MudStack>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        <MudGrid>
            <MudItem xs="12" lg="5">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">창고 빠른 등록</MudText>
                        <MudGrid Class="mt-2">
                            <MudItem xs="12"><MudTextField Label="창고명" @bind-Value="warehouseName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12">
                                <MudSelect T="string" Label="물류 대행지 분류" @bind-Value="warehouseProxySiteType" Variant="Variant.Outlined">
                                    @foreach (var siteType in proxySiteTypes)
                                    {
                                        <MudSelectItem T="string" Value="@siteType">@LogisticsProxySiteTypes.GetDisplayName(siteType)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12"><MudTextField Label="주소" @bind-Value="warehouseAddress" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="담당자명" @bind-Value="warehouseManager" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="연락처" @bind-Value="warehousePhone" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>
                        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" Disabled="isBusy" OnClick="CreateWarehouseAsync">창고 등록</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" lg="7">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6">입고 요청 등록</MudText>
                        <MudGrid Class="mt-2">
                            <MudItem xs="12" md="6">
                                <HongdalAutocomplete TItem="창고요약응답"
                                                     ViewModel="@warehouseSearchViewModel"
                                                     Value="@SelectedWarehouse"
                                                     ValueChanged="SelectWarehouseAsync"
                                                     ToStringFunc="FormatWarehouse"
                                                     Label="창고"
                                                     Placeholder="창고명 또는 주소 검색"
                                                     Required="true"
                                                     Disabled="@(isBusy || isLoading)" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Label="입고 흐름" @bind-Value="inboundFlowType" Variant="Variant.Outlined">
                                    @foreach (var flowType in inboundFlowTypes)
                                    {
                                        <MudSelectItem T="string" Value="@flowType">@입고흐름유형코드.GetDisplayName(flowType)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12">
                                <MudAlert Severity="@InboundFlowSeverity" Dense="true">
                                    @입고흐름유형코드.GetDescription(inboundFlowType)
                                </MudAlert>
                            </MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="공급처 코드" @bind-Value="supplierCode" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="공급처명" @bind-Value="supplierName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="원주문 참조번호" @bind-Value="orderReference" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudDatePicker Label="예정 도착일" @bind-Date="expectedArrivalDate" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="계약번호" @bind-Value="contractNo" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Label="입고 계약 유형" @bind-Value="contractType" Variant="Variant.Outlined">
                                    @foreach (var type in inboundContractTypes)
                                    {
                                        <MudSelectItem T="string" Value="@type">@입고계약유형코드.GetDisplayName(type)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="계약 상대방" @bind-Value="contractCounterpartyName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="6"><MudTextField Label="정산방식" @bind-Value="contractSettlementType" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="3"><MudNumericField T="decimal" Label="판매수수료율(%)" @bind-Value="contractCommissionRate" Variant="Variant.Outlined" Min="0" Max="100" /></MudItem>
                            <MudItem xs="12" md="3"><MudNumericField T="decimal" Label="일 보관료" @bind-Value="contractDailyStorageFee" Variant="Variant.Outlined" Min="0" /></MudItem>
                            <MudItem xs="12"><MudTextField Label="비고" @bind-Value="inboundMemo" Variant="Variant.Outlined" Lines="2" /></MudItem>
                        </MudGrid>
                        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Success" Disabled="isBusy || warehouses.Count == 0" OnClick="CreateInboundAsync">입고 요청 등록</MudButton>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudCard>
            <MudCardContent>
                <HongdalOperationState ViewModel="@inboundQueryViewModel" />
                <HongdalServerDataGrid @ref="inboundGrid"
                                       TItem="입고요청항목응답"
                                       ViewModel="@inboundQueryViewModel"
                                       SelectedItem="@selectedInbound"
                                       SelectedItemChanged="SelectInboundAsync"
                                       RowsPerPage="25"
                                       MinimumWidth="1280"
                                       SkeletonColumns="9"
                                       SearchPlaceholder="공급처 코드·명칭, 상품, SKU, 참조번호 검색"
                                       EmptyText="등록된 입고 요청이 없습니다.">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">입고 요청 목록</MudText>
                    </ToolBarContent>
                    <Columns>
                        <PropertyColumn T="입고요청항목응답" TProperty="long" Property="item => item.Id" Title="입고ID" />
                        <PropertyColumn T="입고요청항목응답" TProperty="long" Property="item => item.창고Id" Title="창고ID" />
                        <TemplateColumn T="입고요청항목응답" Title="흐름" Sortable="false">
                            <CellTemplate>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@GetInboundFlowColor(context.Item.입고흐름유형)"
                                         Variant="Variant.Filled">
                                    @입고흐름유형코드.GetDisplayName(context.Item.입고흐름유형)
                                </MudChip>
                                @if (!string.IsNullOrWhiteSpace(context.Item.입고생성경로))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.입고생성경로</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn T="입고요청항목응답" TProperty="string" Property="item => item.공급처코드" Title="공급처 코드" />
                        <PropertyColumn T="입고요청항목응답" TProperty="string" Property="item => item.공급처명" Title="공급처" />
                        <TemplateColumn T="입고요청항목응답" Title="예정 품목" Sortable="false">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@(string.IsNullOrWhiteSpace(context.Item.예정상품명) ? "-" : context.Item.예정상품명)</MudText>
                                @if (!string.IsNullOrWhiteSpace(context.Item.예정SKU))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.예정SKU · @context.Item.예정수량</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn T="입고요청항목응답" TProperty="string" Property="item => item.원주문참조번호" Title="참조번호" />
                        <TemplateColumn T="입고요청항목응답" Title="계약" Sortable="false">
                            <CellTemplate>
                                <MudText Typo="Typo.body2">@입고계약유형코드.GetDisplayName(context.Item.계약정보.계약유형)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Item.계약정보.계약번호</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <PropertyColumn T="입고요청항목응답" TProperty="string" Property="item => item.상태" Title="상태" />
                        <PropertyColumn T="입고요청항목응답" TProperty="DateTime?" Property="item => item.예정도착일" Title="예정일" Format="yyyy-MM-dd" />
                        <TemplateColumn T="입고요청항목응답" Title="처리" Sortable="false">
                            <CellTemplate>
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Disabled="@(isBusy || context.Item.상태 == "입고완료")"
                                           OnClick="@(() => SelectInbound(context.Item))">
                                    입고완료 준비
                                </MudButton>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </HongdalServerDataGrid>
            </MudCardContent>
        </MudCard>

        @if (selectedInbound is not null)
        {
            <MudCard>
                <MudCardContent>
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">입고완료 처리 - @selectedInbound.원주문참조번호</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">현재 컴포넌트는 단일 상품 기준으로 입고완료를 처리합니다.</MudText>

                        <MudGrid>
                            <MudItem xs="12">
                                <HongdalAutocomplete TItem="판매상품항목응답"
                                                     ViewModel="@ProductSearchViewModel"
                                                     Value="@selectedSalesProduct"
                                                     ValueChanged="SelectSalesProductAsync"
                                                     ToStringFunc="FormatSalesProduct"
                                                     Label="기존 판매상품"
                                                     Placeholder="상품명 또는 SKU 검색"
                                                     Disabled="@isBusy" />
                            </MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="상품명" @bind-Value="itemName" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="SKU" @bind-Value="itemSku" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="옵션명" @bind-Value="itemOption" Variant="Variant.Outlined" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="int" Label="입고수량" @bind-Value="itemQuantity" Variant="Variant.Outlined" Min="1" /></MudItem>
                            <MudItem xs="12" md="4"><MudNumericField T="int" Label="불량수량" @bind-Value="itemDefectQuantity" Variant="Variant.Outlined" Min="0" /></MudItem>
                            <MudItem xs="12" md="4"><MudTextField Label="보관위치" @bind-Value="storageLocation" Variant="Variant.Outlined" /></MudItem>
                        </MudGrid>

                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="isBusy" OnClick="CompleteInboundAsync">입고완료 처리</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="isBusy" OnClick="ClearSelection">취소</MudButton>
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter] public string Title { get; set; } = "입고 현황";
    [Parameter] public string Description { get; set; } = "창고를 만들고 입고 요청을 등록한 뒤, 도착 상품을 입고완료 처리해 재고로 전환합니다.";

    private List<창고요약응답> warehouses = [];
    private HongdalServerDataGrid<입고요청항목응답>? inboundGrid;
    private 위임서버목록조회ViewModel<입고요청항목응답> inboundQueryViewModel = default!;
    private 위임비동기검색ViewModel<창고요약응답> warehouseSearchViewModel = default!;
    private 입고요청항목응답? selectedInbound;
    private 판매상품항목응답? selectedSalesProduct;

    private bool isLoading;
    private bool isBusy;
    private bool initialDiagramWarehouseProxyApplied;
    private string? message;
    private Severity messageSeverity = Severity.Info;
    private static readonly IReadOnlyList<string> proxySiteTypes =
    [
        LogisticsProxySiteTypes.DeliveryAgency,
        LogisticsProxySiteTypes.MarketFulfillment,
        LogisticsProxySiteTypes.OverseasCustomsAgency
    ];
    private static readonly IReadOnlyList<string> inboundContractTypes =
    [
        입고계약유형코드.보관대행,
        입고계약유형코드.위탁판매,
        입고계약유형코드.마켓풀필먼트,
        입고계약유형코드.수입통관풀필먼트
    ];
    private static readonly IReadOnlyList<string> inboundFlowTypes =
    [
        입고흐름유형코드.계약기반입고,
        입고흐름유형코드.현장임시입고,
        입고흐름유형코드.주문자동입고예정
    ];

    private string warehouseName = string.Empty;
    private string warehouseProxySiteType = LogisticsProxySiteTypes.DeliveryAgency;
    private string warehouseAddress = string.Empty;
    private string warehouseManager = string.Empty;
    private string warehousePhone = string.Empty;

    private long? selectedWarehouseId;
    private string inboundFlowType = 입고흐름유형코드.계약기반입고;
    private string supplierCode = string.Empty;
    private string supplierName = string.Empty;
    private string orderReference = string.Empty;
    private DateTime? expectedArrivalDate = DateTime.Today;
    private string inboundMemo = string.Empty;
    private string contractNo = string.Empty;
    private string contractType = 입고계약유형코드.보관대행;
    private string contractCounterpartyName = string.Empty;
    private string contractSettlementType = string.Empty;
    private decimal contractCommissionRate;
    private decimal contractDailyStorageFee;

    private string itemName = string.Empty;
    private string itemSku = string.Empty;
    private string itemOption = string.Empty;
    private int itemQuantity = 1;
    private int itemDefectQuantity;
    private string storageLocation = string.Empty;

    private Severity InboundFlowSeverity => 입고흐름유형코드.Normalize(inboundFlowType) switch
    {
        입고흐름유형코드.현장임시입고 => Severity.Warning,
        입고흐름유형코드.주문자동입고예정 => Severity.Info,
        _ => Severity.Success
    };

    private 창고요약응답? SelectedWarehouse
        => selectedWarehouseId is { } warehouseId
            ? warehouses.FirstOrDefault(item => item.Id == warehouseId)
            : null;

    protected override async Task OnInitializedAsync()
    {
        inboundQueryViewModel = new 위임서버목록조회ViewModel<입고요청항목응답>(
            "inbound-server-query",
            "입고 요청 목록",
            QueryInboundsAsync);
        warehouseSearchViewModel = new 위임비동기검색ViewModel<창고요약응답>(
            "warehouse-autocomplete",
            "창고 검색",
            SearchWarehousesAsync);
        await LoadAsync();
        ApplyDiagramWarehouseProxyRequestFromQuery();
    }

    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
            warehouses = ((await WarehouseService.GetWarehousesAsync())?.Items ?? []).ToList();
            if (!selectedWarehouseId.HasValue && warehouses.Count > 0)
            {
                selectedWarehouseId = warehouses[0].Id;
            }

            messageSeverity = Severity.Info;
            message = $"창고 {warehouses.Count}건을 불러왔습니다.";
            if (inboundGrid is not null)
            {
                await inboundGrid.ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<목록조회결과<입고요청항목응답>> QueryInboundsAsync(
        목록조회요청 request,
        CancellationToken cancellationToken)
    {
        var normalized = request.정규화();
        var firstSort = normalized.정렬조건.FirstOrDefault();
        var response = await WarehouseService.QueryInboundsAsync(new 입고요청목록조회요청
        {
            Page = normalized.페이지,
            PageSize = normalized.페이지크기,
            Search = normalized.검색어,
            SortBy = firstSort?.필드,
            SortDescending = firstSort?.방향 != 목록정렬방향.오름차순
        }, cancellationToken);

        return response is null
            ? 목록조회결과<입고요청항목응답>.비어있음
            : new 목록조회결과<입고요청항목응답>(response.Items, response.TotalCount);
    }

    private Task<IReadOnlyList<창고요약응답>> SearchWarehousesAsync(
        string? searchText,
        CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();
        IEnumerable<창고요약응답> query = warehouses;
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();
            query = query.Where(item =>
                item.창고명.Contains(search, StringComparison.OrdinalIgnoreCase)
                || item.주소.Contains(search, StringComparison.OrdinalIgnoreCase)
                || item.담당자명.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult<IReadOnlyList<창고요약응답>>(query.Take(20).ToArray());
    }

    private Task SelectWarehouseAsync(창고요약응답? warehouse)
    {
        selectedWarehouseId = warehouse?.Id;
        return Task.CompletedTask;
    }

    private Task SelectInboundAsync(입고요청항목응답? inbound)
    {
        if (inbound is null)
        {
            ClearSelection();
        }
        else
        {
            SelectInbound(inbound);
        }

        return Task.CompletedTask;
    }

    private Task SelectSalesProductAsync(판매상품항목응답? product)
    {
        selectedSalesProduct = product;
        if (product is not null)
        {
            itemName = product.대표상품명;
            itemSku = product.판매SKU;
        }

        return Task.CompletedTask;
    }

    private static string FormatWarehouse(창고요약응답 warehouse)
        => $"{warehouse.창고명} · {LogisticsProxySiteTypes.GetDisplayName(warehouse.물류대행지분류)}";

    private static string FormatSalesProduct(판매상품항목응답 product)
        => string.IsNullOrWhiteSpace(product.판매SKU)
            ? product.대표상품명
            : $"{product.대표상품명} · {product.판매SKU}";

    private async Task CreateWarehouseAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            await WarehouseService.CreateWarehouseAsync(new 창고저장요청
            {
                창고명 = warehouseName,
                물류대행지분류 = warehouseProxySiteType,
                주소 = warehouseAddress,
                담당자명 = warehouseManager,
                연락처 = warehousePhone
            });

            warehouseName = warehouseAddress = warehouseManager = warehousePhone = string.Empty;
            warehouseProxySiteType = LogisticsProxySiteTypes.DeliveryAgency;
            messageSeverity = Severity.Success;
            message = "창고를 등록했습니다.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task CreateInboundAsync()
    {
        if (isBusy || !selectedWarehouseId.HasValue)
        {
            return;
        }

        isBusy = true;
        try
        {
            await WarehouseService.CreateInboundAsync(new 입고요청저장요청
            {
                창고Id = selectedWarehouseId.Value,
                입고흐름유형 = 입고흐름유형코드.Normalize(inboundFlowType),
                입고생성경로 = BuildInboundSourceLabel(inboundFlowType),
                계약선행여부 = 입고흐름유형코드.RequiresExistingContract(inboundFlowType),
                자동생성여부 = 입고흐름유형코드.IsOrderGenerated(inboundFlowType),
                공급처코드 = supplierCode,
                공급처명 = supplierName,
                원주문참조번호 = orderReference,
                예정도착일 = expectedArrivalDate,
                비고 = inboundMemo,
                계약정보 = new 입고계약스냅샷
                {
                    계약번호 = contractNo,
                    계약유형 = contractType,
                    계약상대방명 = string.IsNullOrWhiteSpace(contractCounterpartyName) ? supplierName : contractCounterpartyName,
                    정산방식 = contractSettlementType,
                    판매수수료율 = contractCommissionRate,
                    보관료일단가 = contractDailyStorageFee,
                    통관필요여부 = 입고계약유형코드.RequiresCustoms(contractType),
                    계약시작일 = DateTime.Today
                }.Normalize()
            });

            supplierCode = supplierName = orderReference = inboundMemo = string.Empty;
            inboundFlowType = 입고흐름유형코드.계약기반입고;
            contractNo = contractCounterpartyName = contractSettlementType = string.Empty;
            contractType = 입고계약유형코드.보관대행;
            contractCommissionRate = 0m;
            contractDailyStorageFee = 0m;
            expectedArrivalDate = DateTime.Today;
            messageSeverity = Severity.Success;
            message = "입고 요청을 등록했습니다.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void SelectInbound(입고요청항목응답 inbound)
    {
        selectedInbound = inbound;
        selectedSalesProduct = null;
        itemName = inbound.공급처명;
        itemSku = inbound.원주문참조번호;
        itemOption = string.Empty;
        itemQuantity = 1;
        itemDefectQuantity = 0;
        storageLocation = string.Empty;
    }

    private void ClearSelection()
    {
        selectedInbound = null;
        selectedSalesProduct = null;
    }

    private static Color GetInboundFlowColor(string? flowType)
        => 입고흐름유형코드.Normalize(flowType) switch
        {
            입고흐름유형코드.현장임시입고 => Color.Warning,
            입고흐름유형코드.주문자동입고예정 => Color.Info,
            _ => Color.Success
        };

    private static string BuildInboundSourceLabel(string? flowType)
        => 입고흐름유형코드.Normalize(flowType) switch
        {
            입고흐름유형코드.현장임시입고 => "창고 관리자 수기 등록",
            입고흐름유형코드.주문자동입고예정 => "주문/구매 흐름 자동 생성",
            _ => "계약 DB 기반 등록"
        };

    private void ApplyDiagramWarehouseProxyRequestFromQuery()
    {
        if (initialDiagramWarehouseProxyApplied)
        {
            return;
        }

        var query = ParseQueryParameters(Navigation.Uri);
        if (!string.Equals(GetQueryValue(query, "source"), "diagram-warehouse-proxy", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        initialDiagramWarehouseProxyApplied = true;

        var warehouseIdText = GetQueryValue(query, "warehouseId");
        if (long.TryParse(warehouseIdText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var warehouseId) &&
            warehouses.Any(warehouse => warehouse.Id == warehouseId))
        {
            selectedWarehouseId = warehouseId;
        }

        var warehouseNameFromQuery = GetQueryValue(query, "warehouseName") ?? string.Empty;
        var proxyType = LogisticsProxySiteTypes.Normalize(GetQueryValue(query, "proxyType"));
        var warehouseAddressFromQuery = GetQueryValue(query, "warehouseAddress") ?? string.Empty;

        if (!selectedWarehouseId.HasValue)
        {
            warehouseName = warehouseNameFromQuery;
            warehouseProxySiteType = proxyType;
            warehouseAddress = warehouseAddressFromQuery;
        }

        inboundFlowType = 입고흐름유형코드.계약기반입고;
        supplierName = "다이어그램 물류 대행 신청";
        orderReference = $"DIAGRAM-{DateTime.Today:yyyyMMdd}";
        expectedArrivalDate = DateTime.Today.AddDays(1);
        contractType = ResolveInboundContractType(proxyType);
        contractCounterpartyName = warehouseNameFromQuery;
        contractSettlementType = "보관료/작업비 협의";
        inboundMemo = BuildDiagramWarehouseProxyMemo(query, warehouseNameFromQuery, proxyType);
        messageSeverity = Severity.Info;
        message = selectedWarehouseId.HasValue
            ? "다이어그램 창고 블록에서 넘어온 물류 대행 신청서 초안을 채웠습니다."
            : "다이어그램 창고 블록에서 넘어온 후보를 창고 빠른 등록과 입고 요청 신청서에 채웠습니다. 먼저 창고를 등록하거나 기존 창고를 선택하세요.";
    }

    private static string ResolveInboundContractType(string proxyType)
        => LogisticsProxySiteTypes.Normalize(proxyType) switch
        {
            LogisticsProxySiteTypes.MarketFulfillment => 입고계약유형코드.마켓풀필먼트,
            LogisticsProxySiteTypes.OverseasCustomsAgency => 입고계약유형코드.수입통관풀필먼트,
            _ => 입고계약유형코드.보관대행
        };

    private static string BuildDiagramWarehouseProxyMemo(
        IReadOnlyDictionary<string, string> query,
        string warehouseName,
        string proxyType)
    {
        var nodeTitle = GetQueryValue(query, "nodeTitle") ?? "창고 블록";
        var nodeGroup = GetQueryValue(query, "nodeGroup") ?? string.Empty;
        var nodeDescription = GetQueryValue(query, "nodeDescription") ?? string.Empty;
        var scope = GetQueryValue(query, "scope") ?? string.Empty;

        return string.Join(Environment.NewLine, new[]
        {
            "다이어그램 창고 블록에서 시작한 판매자 물류 대행 신청입니다.",
            $"- 창고 후보: {warehouseName}",
            $"- 물류 대행 유형: {LogisticsProxySiteTypes.GetDisplayName(proxyType)}",
            $"- 후보 범위: {scope}",
            $"- 다이어그램 노드: {nodeTitle}",
            $"- 블록 그룹: {nodeGroup}",
            $"- 노드 설명: {nodeDescription}",
            "- 보완 필요: 품목, 수량, 희망 입고일, 보관 기간, 피킹/포장/출고 대행 필요 여부"
        });
    }

    private static IReadOnlyDictionary<string, string> ParseQueryParameters(string uri)
    {
        var queryStart = uri.IndexOf('?', StringComparison.Ordinal);
        if (queryStart < 0 || queryStart == uri.Length - 1)
        {
            return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }

        var query = uri[(queryStart + 1)..];
        var fragmentStart = query.IndexOf('#', StringComparison.Ordinal);
        if (fragmentStart >= 0)
        {
            query = query[..fragmentStart];
        }

        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=', StringComparison.Ordinal);
            var key = separator >= 0 ? pair[..separator] : pair;
            var value = separator >= 0 ? pair[(separator + 1)..] : string.Empty;

            if (string.IsNullOrWhiteSpace(key))
            {
                continue;
            }

            result[DecodeQueryValue(key)] = DecodeQueryValue(value);
        }

        return result;
    }

    private static string? GetQueryValue(IReadOnlyDictionary<string, string> query, string key)
        => query.TryGetValue(key, out var value) ? value : null;

    private static string DecodeQueryValue(string value)
        => Uri.UnescapeDataString(value.Replace("+", " ", StringComparison.Ordinal));

    private async Task CompleteInboundAsync()
    {
        if (isBusy || selectedInbound is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            await WarehouseService.CompleteInboundAsync(selectedInbound.Id, new 입고완료요청
            {
                Items =
                [
                    new 입고상품저장요청
                    {
                        상품명 = itemName,
                        SKU = itemSku,
                        옵션명 = itemOption,
                        입고수량 = itemQuantity,
                        불량수량 = itemDefectQuantity,
                        보관위치 = storageLocation
                    }
                ]
            });

            messageSeverity = Severity.Success;
            message = $"입고 요청 {selectedInbound.Id}를 재고로 전환했습니다.";
            ClearSelection();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }
