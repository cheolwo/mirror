    private static string SavedChoice(CargoTrainingReview? review)
    {
        if (review is null) return "아직 의견이 없습니다.";
        var choice = string.Join(" · ", review.AcceptableCandidateIds.Concat(review.AcceptHold ? ["배차 보류 허용"] : Array.Empty<string>()));
        return choice.Length > 0 ? choice : "허용 결과 미지정";
    }
