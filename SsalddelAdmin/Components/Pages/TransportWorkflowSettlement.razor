@page "/transports/{RequestId}/settlement"
@using Ssalddel.Contracts.Common.Community
@using SsalddelAdmin.ViewModels
@inject I백오피스Service DataService
@inject NavigationManager NavigationManager

<PageTitle>1.0 운송 결제/정산</PageTitle>

<AdminTransportWorkflowHeader Title="06-1. 운송 결제/정산"
                              Subtitle="화주 수납과 기사 지급요청·실지급을 나눠 확인합니다."
                              BackButtonText="관제 개요"
                              IsLoading="@isLoading"
                              OnBack="NavigateToOverview"
                              OnRefresh="LoadAsync" />

@if (isLoading)
{
    <MudAlert Severity="Severity.Info">결제/정산 정보를 불러오는 중입니다...</MudAlert>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (detail is null)
{
    <MudAlert Severity="Severity.Warning">의뢰 @RequestId 관제 정보를 찾지 못했습니다.</MudAlert>
}
else
{
    <AdminTransportWorkflowSummaryCard Detail="@detail" />

    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" lg="6">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">화주 수납</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12"><AdminInfoField Label="수납 확인" Value="@Settlement.CollectionStatus" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="결제 상태" Value="@(detail.결제?.결제상태 ?? detail.의뢰?.결제상태)" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="결제 수단" Value="@(detail.결제?.결제수단 ?? detail.의뢰?.결제수단)" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="결제 금액" Value="@(detail.결제 is null ? null : $"{detail.결제.결제금액:N0}원")" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="승인 시각" Value="@(detail.결제?.승인일시Utc is null ? null : detail.결제.승인일시Utc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="OrderId" Value="@detail.결제?.OrderId" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="PaymentKey" Value="@detail.결제?.PaymentKey" /></MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="6">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">운송·수납 기준</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6"><AdminInfoField Label="화주 정산 상태" Value="@detail.의뢰?.정산상태" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="정산 시점" Value="@detail.의뢰?.정산시점" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="화주 운임" Value="@(detail.의뢰?.최종운임 is null ? null : $"{detail.의뢰.최종운임:N0}원")" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="수납 주체" Value="@detail.의뢰?.수납주체" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="운송 상태" Value="@detail.운송?.상태" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="하차 시각" Value="@(detail.운송?.도착 is null ? null : detail.운송.도착.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="세금계산서" Value="@(detail.의뢰 is null ? null : (detail.의뢰.세금계산서필요 ? "필요" : "미필요"))" /></MudItem>
                        <MudItem xs="12" md="6"><AdminInfoField Label="현금영수증" Value="@(detail.의뢰 is null ? null : (detail.의뢰.현금영수증필요 ? "필요" : "미필요"))" /></MudItem>
                        <MudItem xs="12"><AdminInfoField Label="정산 메모" Value="@detail.의뢰?.정산메모" /></MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">기사 운송료 지급</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@(Settlement.QueryCompleted ? $"{Settlement.PayoutRequests.Count:N0}건" : "미확인")</MudChip>
            </MudStack>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4"><AdminInfoField Label="지급준비" Value="@Settlement.PreparationStatus" /></MudItem>
                <MudItem xs="12" md="4"><AdminInfoField Label="지급요청" Value="@Settlement.RequestStatus" /></MudItem>
                <MudItem xs="12" md="4"><AdminInfoField Label="실지급" Value="@Settlement.ActualTransferStatus" /></MudItem>
            </MudGrid>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Settlement.QueryScope</MudText>
            @if (Settlement.QueryFailed)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">지급요청 조회 실패. 새로고침 후 다시 확인하세요.</MudAlert>
            }
            else if (!Settlement.QueryCompleted)
            {
                <MudText Typo="Typo.body2">지급요청 미연결. 실지급 여부를 확인할 수 없습니다.</MudText>
            }
            else if (Settlement.PayoutRequests.Count == 0)
            {
                <MudText Typo="Typo.body2">이 승인월에 연결된 지급요청이 없습니다. 다른 월의 지급 여부는 미확인입니다.</MudText>
            }
            else
            {
                <MudTable Items="@Settlement.PayoutRequests" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>지급 예정액</MudTh>
                        <MudTh>요청</MudTh>
                        <MudTh>실지급</MudTh>
                        <MudTh>구분</MudTh>
                        <MudTh>승인 시각</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="지급 예정액">@TransportWorkflowSettlementViewModel.ExpectedAmountOf(context)</MudTd>
                        <MudTd DataLabel="요청">@TransportWorkflowSettlementViewModel.RequestStatusOf(context)</MudTd>
                        <MudTd DataLabel="실지급">@(TransportWorkflowSettlementViewModel.IsActualTransferConfirmed(context) ? "실지급 확인" : "실지급 미확인")</MudTd>
                        <MudTd DataLabel="구분">@TransportWorkflowSettlementViewModel.ExecutionModeOf(context)</MudTd>
                        <MudTd DataLabel="승인 시각">@context.ApprovedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            <MudText Typo="Typo.body2">수납 확인·월 이용료·시험 지급 검증은 실지급 완료가 아닙니다.</MudText>
            <MudButton Href="/settlements" Variant="Variant.Text" Color="Color.Primary">월 이용료 조회</MudButton>
        </MudStack>
    </MudPaper>

    <MudStack Row="true" Spacing="1" Class="mt-3" Style="flex-wrap: wrap;">
        <MudButton Href="@EventsHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight">이벤트 로그</MudButton>
        <MudButton Href="@ProofsHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight">증빙/POD</MudButton>
    </MudStack>
}

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)] public string? ReturnPath { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private 운송워크플로우관제상세응답? detail;
    private TransportWorkflowSettlementViewModel Settlement => detail is null ? new() : TransportWorkflowSettlementViewModel.Create(detail);

    private string OverviewHref => BuildHref(null);
    private string EventsHref => BuildHref("events");
    private string ProofsHref => BuildHref("proofs");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            detail = null;
            errorMessage = "의뢰ID가 없습니다.";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            detail = await DataService.운송워크플로우관제상세조회Async(RequestId);
        }
        catch (Exception ex)
        {
            detail = null;
            errorMessage = $"결제/정산 조회 실패: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildHref(string? segment)
        => 운송관제NavigationContext.WorkflowHref(RequestId, segment, ReturnPath);

    private void NavigateToOverview()
        => NavigationManager.NavigateTo(OverviewHref);

}
