@page "/transports/{RequestId}/proofs"
@using Ssalddel.Contracts.Common.Community
@inject I백오피스Service DataService
@inject NavigationManager NavigationManager

<PageTitle>1.0 운송 증빙/POD</PageTitle>

<AdminTransportWorkflowHeader Title="06-1. 운송 증빙/POD"
                              Subtitle="상차·하차 사진과 인수증 파일의 업로드 상태를 확인합니다."
                              BackButtonText="관제 개요"
                              IsLoading="@isLoading"
                              OnBack="NavigateToOverview"
                              OnRefresh="LoadAsync" />

@if (isLoading)
{
    <MudAlert Severity="Severity.Info">증빙 정보를 불러오는 중입니다...</MudAlert>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (detail is null)
{
    <MudAlert Severity="Severity.Warning">의뢰 @RequestId 관제 정보를 찾지 못했습니다.</MudAlert>
}
else
{
    <AdminTransportWorkflowSummaryCard Detail="@detail" />

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">증빙/POD</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@detail.증빙목록.Count 건</MudChip>
            </MudStack>
            @if (detail.증빙목록.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">업로드된 증빙이 없습니다. 운송 완료 상태라면 기사 앱 업로드 결과를 확인하세요.</MudAlert>
            }
            else
            {
                <MudTable Items="@detail.증빙목록" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>종류</MudTh>
                        <MudTh>파일명</MudTh>
                        <MudTh>상태</MudTh>
                        <MudTh>업로드</MudTh>
                        <MudTh>저장 위치</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="종류">@context.FileType</MudTd>
                        <MudTd DataLabel="파일명">
                            @if (!string.IsNullOrWhiteSpace(context.Url) && context.Url != "#")
                            {
                                <MudLink Href="@context.Url" Target="_blank">@context.OriginalFileName</MudLink>
                            }
                            else
                            {
                                @관리자화면Ui.표시값(context.OriginalFileName)
                            }
                        </MudTd>
                        <MudTd DataLabel="상태">
                            <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.UploadStatus)" Variant="Variant.Filled">
                                @관리자화면Ui.표시값(context.UploadStatus)
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="업로드">@context.UploadedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd DataLabel="저장 위치">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@관리자화면Ui.표시값(context.BucketName) / @관리자화면Ui.표시값(context.ObjectName)</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudStack>
    </MudPaper>

    <MudStack Row="true" Spacing="1" Class="mt-3" Style="flex-wrap: wrap;">
        <MudButton Href="@EventsHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight">이벤트 로그</MudButton>
        <MudButton Href="@SettlementHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight">결제/정산</MudButton>
    </MudStack>
}

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)] public string? ReturnPath { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private 운송워크플로우관제상세응답? detail;

    private string OverviewHref => BuildHref(null);
    private string EventsHref => BuildHref("events");
    private string SettlementHref => BuildHref("settlement");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            detail = null;
            errorMessage = "의뢰ID가 없습니다.";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            detail = await DataService.운송워크플로우관제상세조회Async(RequestId);
        }
        catch (Exception ex)
        {
            detail = null;
            errorMessage = $"증빙/POD 조회 실패: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildHref(string? segment)
        => 운송관제NavigationContext.WorkflowHref(RequestId, segment, ReturnPath);

    private void NavigateToOverview()
        => NavigationManager.NavigateTo(OverviewHref);

}
