@page "/login"
@layout AuthLayout
@rendermode InteractiveServer
@inject 관리자인증Service 관리자인증Service
@inject 관리자인증세션Service 관리자인증세션Service
@inject NavigationManager NavigationManager

<PageTitle>운영자 로그인</PageTitle>

<Ssalddel공통로그인Panel 제목="운영자 로그인"
                     설명="운영자도 같은 로그인 컴포넌트를 사용합니다. 카카오, 구글, 네이버 로그인은 계정 연결 정책이 정해진 뒤 활성화합니다."
                     Style="max-width: 480px;"
                     상태메시지="@statusMessage"
                     상태Severity="@statusSeverity"
                     IsBusy="@isLoading"
                     OnPasswordLogin="LoginAsync"
                     OnSocialLogin="SocialLoginAsync" />

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool isLoading;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;
    private readonly 로그인요청 model = new();

    protected override void OnInitialized()
    {
        if (관리자인증세션Service.HsCode운영자인가)
        {
            NavigateAfterLogin();
        }
    }

    private async Task LoginAsync(공통로그인요청 request)
    {
        if (isLoading)
        {
            return;
        }

        model.UserNameOrEmail = request.UserNameOrEmail;
        model.Password = request.Password;

        isLoading = true;
        statusMessage = null;

        try
        {
            var result = await 관리자인증Service.로그인Async(model.UserNameOrEmail, model.Password);
            if (!result.성공여부)
            {
                statusSeverity = Severity.Error;
                statusMessage = result.오류메시지;
                return;
            }

            NavigateAfterLogin();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"로그인 처리 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SocialLoginAsync(공통소셜로그인요청 request)
    {
        statusSeverity = Severity.Info;
        statusMessage = $"{request.ProviderDisplayName} 요청을 받았습니다. ProviderId={request.ProviderId}. 운영자 권한 매핑 정책이 준비되면 활성화합니다.";
        return Task.CompletedTask;
    }

    private void NavigateAfterLogin()
    {
        var defaultRoute = 관리자인증세션Service.서버관리자인가 ? "/" : "/customs/hs-codes";
        NavigationManager.NavigateTo(IsSafeLocalRoute(ReturnUrl) ? ReturnUrl! : defaultRoute);
    }

    private static bool IsSafeLocalRoute(string? route)
        => !string.IsNullOrWhiteSpace(route)
           && route.StartsWith("/", StringComparison.Ordinal)
           && !route.StartsWith("//", StringComparison.Ordinal)
           && !route.StartsWith("/\\", StringComparison.Ordinal);
}
