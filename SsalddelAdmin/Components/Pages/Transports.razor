@page "/transports"
@page "/admin/freight-delivery/transports"
@page "/admin/order-warehouse/outbound-transports"
@inject I백오피스Service DataService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>06. 운송 진행</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">06. 운송 진행</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">관리자 확인이 필요한 운송 예외와 이벤트 흐름을 확인합니다.</MudText>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField Label="운송상태" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="statusFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField Label="이벤트 의뢰ID" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="eventRequestFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudCheckBox T="bool" @bind-Value="관리자확인만" Label="관리자 확인 필요만 보기" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" FullWidth="true" Disabled="@isLoading" OnClick="ApplyFiltersAsync">조회</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    { <MudAlert Severity="Severity.Info">운송 목록을 불러오는 중입니다.</MudAlert> }
    else if (errorMessage is not null)
    { <MudAlert Severity="Severity.Warning">@errorMessage</MudAlert> }
    else
    {
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" xl="3">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">전체 운송</MudText>
                <MudText Typo="Typo.h4">@transports.Count</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" xl="3">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">관리자 확인 필요</MudText>
                <MudText Typo="Typo.h4" Color="Color.Error">@transports.Count(x => x.관리자확인필요)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" xl="3">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">예외 신고</MudText>
                <MudText Typo="Typo.h4" Color="Color.Warning">@transports.Count(x => x.예외신고됨)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" xl="3">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudText Typo="Typo.caption" Color="Color.Secondary">지연 확인</MudText>
                <MudText Typo="Typo.h4" Color="Color.Error">@transports.Count(IsStale)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="7">
            <MudStack Spacing="3">
                <MudPaper Elevation="1" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">운송 운영 레인</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@운영확인대상.Count 건</MudChip>
                        </MudStack>

                        @if (운영확인대상.Count == 0)
                        {
                            <MudAlert Severity="Severity.Success" Dense="true">현재 관리자 확인이 필요한 운송 예외가 없습니다.</MudAlert>
                        }
                        else
                        {
                            <MudTable Items="@운영확인대상" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>운송</MudTh>
                                    <MudTh>운영상태</MudTh>
                                    <MudTh>예외 내용</MudTh>
                                    <MudTh>갱신</MudTh>
                                    <MudTh>관제</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="운송">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.body2">@context.운송번호</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.기사_운송자</MudText>
                                        </MudStack>
                                    </MudTd>
                                    <MudTd DataLabel="운영상태">
                                        <MudChip T="string" Size="Size.Small" Color="@TransportColor(context)" Variant="Variant.Filled">@TransportBadgeText(context)</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="예외 내용">@ExceptionSummary(context)</MudTd>
                                    <MudTd DataLabel="갱신">@context.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")</MudTd>
                                    <MudTd DataLabel="관제">
                                        <MudButton Href="@WorkflowDetailHref(context.운송번호)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">상세</MudButton>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudStack>
                </MudPaper>

                <MudPaper Elevation="1" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">운송 목록</MudText>
                        @if (표시운송목록.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">조회된 운송이 없습니다.</MudAlert>
                        }
                        else
                        {
                            <MudTable Items="@표시운송목록" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>번호</MudTh>
                                    <MudTh>상태</MudTh>
                                    <MudTh>기사</MudTh>
                                    <MudTh>구간</MudTh>
                                    <MudTh>운임</MudTh>
                                    <MudTh>예외</MudTh>
                                    <MudTh>관제</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="번호">@context.운송번호</MudTd>
                                    <MudTd DataLabel="상태">
                                        <MudChip T="string" Size="Size.Small" Color="@TransportColor(context)" Variant="Variant.Filled">@context.상태</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="기사">@context.기사_운송자</MudTd>
                                    <MudTd DataLabel="구간">@context.출발지 → @context.도착지</MudTd>
                                    <MudTd DataLabel="운임">@(context.운임?.ToString("N0") ?? "-")</MudTd>
                                    <MudTd DataLabel="예외">@ExceptionSummary(context)</MudTd>
                                    <MudTd DataLabel="관제">
                                        <MudButton Href="@WorkflowDetailHref(context.운송번호)" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">상세</MudButton>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudStack>
                </MudPaper>
            </MudStack>
        </MudItem>

        <MudItem xs="12" lg="5">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">이벤트 로그</MudText>
                    @if (events.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">조회된 이벤트가 없습니다.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@events" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>의뢰ID</MudTh>
                                <MudTh>이벤트</MudTh>
                                <MudTh>시각</MudTh>
                                <MudTh>메타</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="의뢰ID">@context.의뢰Id</MudTd>
                                <MudTd DataLabel="이벤트">@context.이벤트타입</MudTd>
                                <MudTd DataLabel="시각">@context.이벤트시각.ToLocalTime().ToString("MM-dd HH:mm")</MudTd>
                                <MudTd DataLabel="메타">
                                    <MudTooltip Text="@관리자화면Ui.표시값(context.메타데이터)">
                                        <MudText Typo="Typo.body2">@ShortMetadata(context.메타데이터)</MudText>
                                    </MudTooltip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
    }
</MudStack>

@code {
    [SupplyParameterFromQuery(Name = "status")] public string? Status { get; set; }
    [SupplyParameterFromQuery(Name = "eventRequest")] public string? EventRequestId { get; set; }
    [SupplyParameterFromQuery(Name = "adminOnly")] public bool AdminOnly { get; set; }
    private string? statusFilter;
    private string? eventRequestFilter;
    private bool 관리자확인만;
    private IReadOnlyList<운송진행응답> transports = [];
    private IReadOnlyList<운송이벤트로그응답> events = [];
    private bool isLoading;
    private string? errorMessage;
    private CancellationTokenSource? read;
    private long generation;
    private bool disposed;
    private 운송관제NavigationContext? loadedContext;
    private 운송관제NavigationContext Context => 운송관제NavigationContext.ForList(
        new Uri(Navigation.Uri).AbsolutePath, statusFilter, eventRequestFilter, 관리자확인만);

    private IReadOnlyList<운송진행응답> 운영확인대상 => transports
        .Where(x => x.관리자확인필요 || x.예외신고됨 || IsStale(x))
        .OrderByDescending(x => x.관리자확인필요)
        .ThenByDescending(x => x.예외신고됨)
        .ThenBy(x => x.UpdatedAt)
        .ToArray();

    private IReadOnlyList<운송진행응답> 표시운송목록 => 관리자확인만
        ? transports.Where(x => x.관리자확인필요 || x.예외신고됨 || IsStale(x)).ToArray()
        : transports;

    protected override async Task OnParametersSetAsync()
    {
        statusFilter = Status; eventRequestFilter = EventRequestId; 관리자확인만 = AdminOnly;
        await LoadAsync();
    }

    private Task ApplyFiltersAsync()
    {
        var href = Context.ListHref;
        if (new Uri(Navigation.Uri).PathAndQuery != href)
        {
            Navigation.NavigateTo(href, replace: true);
            return Task.CompletedTask;
        }
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (disposed) return;
        read?.Cancel(); read?.Dispose();
        using var request = read = new CancellationTokenSource();
        var current = ++generation;
        var context = Context;
        isLoading = true; errorMessage = null;
        try
        {
            var rows = await DataService.운송진행목록조회Async(context.Status, context.BusinessCode, request.Token);
            var logs = await DataService.운송이벤트조회Async(context.EventRequestId, request.Token);
            if (disposed || current != generation || request.IsCancellationRequested) return;
            transports = rows; events = logs; loadedContext = context;
        }
        catch (OperationCanceledException) when (request.IsCancellationRequested) { }
        catch (Exception)
        {
            if (!disposed && current == generation)
            { transports = []; events = []; errorMessage = "운송 목록을 불러오지 못했습니다. 다시 조회해 주세요."; }
        }
        finally
        {
            if (!disposed && current == generation) isLoading = false;
            if (ReferenceEquals(read, request)) read = null;
        }
    }

    private static Color TransportColor(운송진행응답 item)
        => item.관리자확인필요 ? Color.Error
            : item.예외신고됨 ? Color.Warning
            : IsStale(item) ? Color.Error
            : item.상태 switch
            {
                "운송중" => Color.Primary,
                "인수완료" or "완료" => Color.Success,
                "배차확정" => Color.Info,
                _ => Color.Default
            };

    private static string TransportBadgeText(운송진행응답 item)
        => item.관리자확인필요 ? "관리자 확인"
            : item.예외신고됨 ? "예외 신고"
            : IsStale(item) ? "지연 확인"
            : item.상태;

    private static string ExceptionSummary(운송진행응답 item)
    {
        if (!item.예외신고됨 && !item.관리자확인필요 && !IsStale(item))
        {
            return "-";
        }

        if (IsStale(item) && !item.예외신고됨)
        {
            return $"{item.상태} 상태가 2시간 이상 갱신되지 않았습니다.";
        }

        var stage = string.IsNullOrWhiteSpace(item.최근예외단계) ? "단계 미확인" : item.최근예외단계;
        var code = string.IsNullOrWhiteSpace(item.최근예외코드) ? "예외코드 없음" : item.최근예외코드;
        var message = string.IsNullOrWhiteSpace(item.최근예외메시지) ? "기사님 예외 신고 내용을 확인하세요." : item.최근예외메시지;
        return $"{stage} · {code} · {message}";
    }

    private static bool IsStale(운송진행응답 item)
        => (item.상태 == "배차확정" || item.상태 == "운송중") && item.UpdatedAt < DateTime.UtcNow.AddHours(-2);

    private static string ShortMetadata(string? metadata)
    {
        if (string.IsNullOrWhiteSpace(metadata))
        {
            return "-";
        }

        return metadata.Length <= 80 ? metadata : metadata[..80] + "...";
    }

    private string WorkflowDetailHref(string requestId)
        => 운송관제NavigationContext.ForList(Context.ListPath, loadedContext?.Status,
            loadedContext?.EventRequestId, 관리자확인만).DetailHref(requestId);
    public void Dispose()
    {
        disposed = true; ++generation; read?.Cancel(); read?.Dispose(); read = null;
    }
}
