@page "/privacy-support"
@page "/privacy-support/{CaseId}"
@rendermode InteractiveServer
@using Ssalddel.Ui.Common.Areas.BackOffice.Components.PrivacySupport
@using Ssalddel.Contracts.Common.PrivacySupport
@using Ssalddel.Contracts.Common.Community
@inject 관리자인증세션Service Session

<PageTitle>거래·개인정보 처리 요청</PageTitle>
<보호지원관리Page CaseId="@CaseId" Kind="@Kind" Page="@Page" ReturnPath="@ReturnPath" AdminOwnerProvider="AdminOwner" LoginHref="@LoginHref" />

@code {
    [Parameter] public string? CaseId { get; set; }
    [SupplyParameterFromQuery(Name = PrivacySupportNavigationContext.KindQuery)] public string? Kind { get; set; }
    [SupplyParameterFromQuery(Name = PrivacySupportNavigationContext.PageQuery)] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)] public string? ReturnPath { get; set; }
    private string? AdminOwner() => Session.로그인됨 && Session.서버관리자인가
        && Session.AccessTokenExpiresAtUtc > DateTime.UtcNow ? Session.UserId : null;
    private string LoginHref => PrivacySupportNavigationContext.Resolve(Kind, Page, ReturnPath).LoginPath(CaseId);
}
