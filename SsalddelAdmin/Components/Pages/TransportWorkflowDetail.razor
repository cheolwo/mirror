@page "/transports/{RequestId}"
@using Ssalddel.Client.Infrastructure.Transport
@using Ssalddel.Contracts.Common.Community
@inject I백오피스Service DataService
@inject ITransportRequestLedgerObserver LedgerObserver
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>1.0 운송 관제 개요</PageTitle>

<AdminTransportWorkflowHeader Title="06-1. 1.0 운송 관제 개요"
                              Subtitle="진행 단계와 운영 확인 항목을 중심으로 봅니다."
                              BackButtonText="운송 목록"
                              IsLoading="@isLoading"
                              OnBack="NavigateToTransportList"
                              OnRefresh="LoadAsync" />

@if (isLoading)
{
    <MudAlert Severity="Severity.Info">관제 정보를 불러오는 중입니다...</MudAlert>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (detail is null)
{
    <MudAlert Severity="Severity.Warning">의뢰 @RequestId 관제 정보를 찾지 못했습니다.</MudAlert>
}
else
{
    <AdminTransportWorkflowSummaryCard Detail="@detail"
                                       HeadingTypo="Typo.h4"
                                       ShowTransportMeta="true"
                                       ShowNextAction="true" />

    <MudGrid Spacing="3" Class="mb-3">
        @foreach (var step in detail.단계목록)
        {
            <MudItem xs="12" md="6" xl="3">
                <MudPaper Elevation="1" Class="pa-4" Style="@StepBorderStyle(step)">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@step.순번. @step.제목</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.색상(step.색상)" Variant="Variant.Filled">
                                @StepLabel(step)
                            </MudChip>
                        </MudStack>
                        <MudText Typo="Typo.subtitle1">@step.상태</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@step.설명</MudText>
                        <MudText Typo="Typo.body2">@step.증빙</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudGrid Spacing="3" Class="mb-3">
        <MudItem xs="12" lg="8">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">운영 확인</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@detail.운영확인목록.Count 건</MudChip>
                    </MudStack>
                    @if (detail.운영확인목록.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true">현재 즉시 확인할 운영 항목이 없습니다.</MudAlert>
                    }
                    else
                    {
                        <MudTable Items="@detail.운영확인목록" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>구분</MudTh>
                                <MudTh>우선도</MudTh>
                                <MudTh>조치 안내</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="구분">@context.구분</MudTd>
                                <MudTd DataLabel="우선도">
                                    <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.우선도색상(context.우선도)" Variant="Variant.Filled">
                                        @context.우선도
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="조치 안내">@context.조치안내</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">연결 화면</MudText>
                    <MudButton Href="@EventsHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight" FullWidth="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                            <MudText>이벤트 로그</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@detail.이벤트목록.Count</MudChip>
                        </MudStack>
                    </MudButton>
                    <MudButton Href="@ProofsHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight" FullWidth="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                            <MudText>증빙/POD</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@detail.증빙목록.Count</MudChip>
                        </MudStack>
                    </MudButton>
                    <MudButton Href="@SettlementHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight" FullWidth="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="width: 100%;">
                            <MudText>수납/기사 지급</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@(detail.기사운송료지급조회?.조회완료 == true ? $"{detail.기사운송료지급조회.지급요청목록.Count:N0}건" : "미확인")</MudChip>
                        </MudStack>
                    </MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)] public string? ReturnPath { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private 운송워크플로우관제상세응답? detail;
    private CancellationTokenSource? pollingCts;

    private string EventsHref => BuildSubPageHref("events");
    private string ProofsHref => BuildSubPageHref("proofs");
    private string SettlementHref => BuildSubPageHref("settlement");

    protected override async Task OnParametersSetAsync()
    {
        EnsureObserverStarted();
        await LoadAsync();
    }

    private Task LoadAsync() => LoadAsync(showLoading: true);

    private async Task LoadAsync(bool showLoading)
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            detail = null;
            errorMessage = "의뢰ID가 없습니다.";
            isLoading = false;
            return;
        }

        if (showLoading)
        {
            isLoading = true;
            errorMessage = null;
        }

        try
        {
            detail = await DataService.운송워크플로우관제상세조회Async(RequestId);
        }
        catch (Exception ex)
        {
            if (showLoading)
            {
                detail = null;
                errorMessage = $"관제 개요 조회 실패: {ex.Message}";
            }
        }
        finally
        {
            if (showLoading)
            {
                isLoading = false;
            }
        }
    }

    private void EnsureObserverStarted()
    {
        if (pollingCts is not null)
        {
            return;
        }

        LedgerObserver.Changed += OnLedgerChanged;
        LedgerObserver.RefreshRequested += OnLedgerRefreshRequested;
        pollingCts = new CancellationTokenSource();
        _ = RunPollingAsync(pollingCts.Token);
    }

    private async Task RunPollingAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(
            TransportRequestLedgerRefreshPolicy.FallbackPollingInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (string.IsNullOrWhiteSpace(RequestId) || isLoading)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    await LoadAsync(showLoading: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnLedgerChanged(TransportRequestLedgerChange change)
    {
        if (!IsCurrentRequest(change.RequestId))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync(showLoading: false);
            StateHasChanged();
        });
    }

    private void OnLedgerRefreshRequested(TransportRequestLedgerRefreshRequest request)
    {
        if (!IsCurrentRequest(request.RequestId))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync(showLoading: false);
            StateHasChanged();
        });
    }

    private bool IsCurrentRequest(string requestId)
        => !string.IsNullOrWhiteSpace(RequestId)
           && string.Equals(RequestId.Trim(), requestId.Trim(), StringComparison.OrdinalIgnoreCase);

    public void Dispose()
    {
        LedgerObserver.Changed -= OnLedgerChanged;
        LedgerObserver.RefreshRequested -= OnLedgerRefreshRequested;
        pollingCts?.Cancel();
        pollingCts?.Dispose();
    }

    private string BuildSubPageHref(string segment)
        => 운송관제NavigationContext.WorkflowHref(RequestId, segment, ReturnPath);

    private void NavigateToTransportList()
        => NavigationManager.NavigateTo(운송관제NavigationContext.ResolveListHref(ReturnPath));

    private static string StepLabel(운송워크플로우단계응답 step)
    {
        if (step.확인필요)
        {
            return "확인필요";
        }

        if (step.완료됨)
        {
            return "완료";
        }

        if (step.진행중)
        {
            return "진행중";
        }

        return "대기";
    }

    private static string StepBorderStyle(운송워크플로우단계응답 step)
        => $"height: 100%; border-left: 4px solid {StepBorderColor(step.색상)};";

    private static string StepBorderColor(string? color)
        => color switch
        {
            "success" => "var(--mud-palette-success)",
            "primary" => "var(--mud-palette-primary)",
            "danger" => "var(--mud-palette-error)",
            "warning" => "var(--mud-palette-warning)",
            _ => "var(--mud-palette-lines-default)"
        };
}
