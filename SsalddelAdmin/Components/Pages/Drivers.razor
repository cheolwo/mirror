@page "/drivers"
@inject I백오피스Service DataService

<PageTitle>09. 기사 관리</PageTitle>

<MudStack Spacing="3">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">09. 기사 관리</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">기사 상태, 차량, 활동지역, 최근 배차 내역을 확인합니다.</MudText>
        <MudButton Variant="Variant.Text" Href="/drivers/platform-registration-readiness" StartIcon="@Icons.Material.Outlined.AssignmentTurnedIn">플랫폼 등록 준비</MudButton>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3">
                <MudTextField Label="운행상태" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="statusFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField Label="활동지역" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="areaFilter" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Disabled="@isLoading" FullWidth="true" OnClick="LoadAsync">조회</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (isLoading)
    {
        <MudAlert Severity="Severity.Info">기사 목록을 불러오는 중입니다...</MudAlert>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" lg="7">
                <MudPaper Elevation="1" Class="pa-4" Style="height: 100%;">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">기사 목록</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@drivers.Count 건</MudChip>
                        </MudStack>

                        @if (drivers.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">조회된 기사가 없습니다.</MudAlert>
                        }
                        else
                        {
                            <MudTable Items="@drivers" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>기사</MudTh>
                                    <MudTh>운행상태</MudTh>
                                    <MudTh>차량</MudTh>
                                    <MudTh>활동지역</MudTh>
                                    <MudTh>배차건수</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="기사">@context.기사명</MudTd>
                                    <MudTd DataLabel="운행상태">
                                        <MudChip T="string" Size="Size.Small" Color="@AdminMudUi.상태색상(context.운행상태)" Variant="Variant.Filled">@context.운행상태</MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="차량">@context.차량</MudTd>
                                    <MudTd DataLabel="활동지역">@context.주_활동지역</MudTd>
                                    <MudTd DataLabel="배차건수">@context.배차건수</MudTd>
                                    <MudTd>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => SelectDriverAsync(context.기사Id))">상세</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/drivers/{Uri.EscapeDataString(context.기사Id)}/qualification")">운송 자격 검토</MudButton>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/admin/freight-delivery/vehicles?driverId={Uri.EscapeDataString(context.기사Id)}")">실차 적재 확인</MudButton>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="5">
                @if (selectedDriver is null)
                {
                    <MudPaper Elevation="1" Class="pa-4">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">기사를 선택하면 상세 정보와 배차 내역이 표시됩니다.</MudText>
                    </MudPaper>
                }
                else
                {
                    <MudStack Spacing="3">
                        <MudPaper Elevation="1" Class="pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">@selectedDriver.기사명</MudText>
                                <AdminInfoField Label="기사ID" Value="@selectedDriver.기사Id" />
                                <AdminInfoField Label="연락처" Value="@selectedDriver.연락처" />
                                <AdminInfoField Label="차량" Value="@selectedDriver.차량" />
                                <AdminInfoField Label="활동지역" Value="@selectedDriver.주_활동지역" />
                                <AdminInfoField Label="운행상태" Value="@selectedDriver.운행상태" />
                                <AdminInfoField Label="최근 위치" Value="@FormatCoord(selectedDriver.최근위도, selectedDriver.최근경도)" />
                                <AdminInfoField Label="최근 위치 시각" Value="@FormatDateTime(selectedDriver.최근위치기록시각)" />
                            </MudStack>
                        </MudPaper>

                        <MudPaper Elevation="1" Class="pa-4">
                            <MudStack Spacing="2">
                                <MudText Typo="Typo.h6">배차 내역</MudText>
                                @if (dispatches.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Info" Dense="true">배차 내역이 없습니다.</MudAlert>
                                }
                                else
                                {
                                    @foreach (var item in dispatches)
                                    {
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.body2">@item.배차명 (@item.상태)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.픽업지 → @item.배송지</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">배차일: @FormatDateTime(item.배차일)</MudText>
                                            </MudStack>
                                        </MudPaper>
                                    }
                                }
                            </MudStack>
                        </MudPaper>
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    }
</MudStack>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private string? statusFilter;
    private string? areaFilter;
    private IReadOnlyList<기사목록응답> drivers = [];
    private 기사상세응답? selectedDriver;
    private IReadOnlyList<기사배차내역응답> dispatches = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            drivers = await DataService.기사목록조회Async(statusFilter, areaFilter);
            selectedDriver = null;
            dispatches = [];
        }
        catch (Exception ex)
        {
            errorMessage = $"기사 목록 조회 실패: {ex.Message}";
            drivers = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SelectDriverAsync(string driverId)
    {
        try
        {
            selectedDriver = await DataService.기사상세조회Async(driverId);
            dispatches = await DataService.기사배차내역조회Async(driverId);
        }
        catch (Exception ex)
        {
            errorMessage = $"기사 상세 조회 실패: {ex.Message}";
        }
    }

    private static string FormatCoord(decimal? lat, decimal? lng) => lat.HasValue && lng.HasValue ? $"{lat.Value}, {lng.Value}" : "-";
    private static string FormatDateTime(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";
}
