@page "/transports/{RequestId}/events"
@using Ssalddel.Contracts.Common.Community
@inject I백오피스Service DataService
@inject NavigationManager NavigationManager

<PageTitle>1.0 운송 이벤트 로그</PageTitle>

<AdminTransportWorkflowHeader Title="06-1. 운송 이벤트 로그"
                              Subtitle="서버에 남은 이벤트 시각과 메타데이터를 확인합니다."
                              BackButtonText="관제 개요"
                              IsLoading="@isLoading"
                              OnBack="NavigateToOverview"
                              OnRefresh="LoadAsync" />

@if (isLoading)
{
    <MudAlert Severity="Severity.Info">이벤트 로그를 불러오는 중입니다...</MudAlert>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}
else if (detail is null)
{
    <MudAlert Severity="Severity.Warning">의뢰 @RequestId 관제 정보를 찾지 못했습니다.</MudAlert>
}
else
{
    <AdminTransportWorkflowSummaryCard Detail="@detail" />

    <MudPaper Elevation="1" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">이벤트 로그</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@detail.이벤트목록.Count 건</MudChip>
            </MudStack>
            @if (detail.이벤트목록.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">등록된 이벤트가 없습니다.</MudAlert>
            }
            else
            {
                <MudTable Items="@detail.이벤트목록" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>시각</MudTh>
                        <MudTh>이벤트</MudTh>
                        <MudTh>메타데이터</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="시각">@context.이벤트시각.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd DataLabel="이벤트">@context.이벤트타입</MudTd>
                        <MudTd DataLabel="메타데이터">
                            <MudText Typo="Typo.body2" Class="text-break">@관리자화면Ui.표시값(context.메타데이터)</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudStack>
    </MudPaper>

    <MudStack Row="true" Spacing="1" Class="mt-3" Style="flex-wrap: wrap;">
        <MudButton Href="@ProofsHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight">증빙/POD</MudButton>
        <MudButton Href="@SettlementHref" Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ChevronRight">결제/정산</MudButton>
    </MudStack>
}

@code {
    [Parameter]
    public string RequestId { get; set; } = string.Empty;
    [SupplyParameterFromQuery(Name = PageNavigationQueryNames.ReturnPath)] public string? ReturnPath { get; set; }

    private bool isLoading = true;
    private string? errorMessage;
    private 운송워크플로우관제상세응답? detail;

    private string OverviewHref => BuildHref(null);
    private string ProofsHref => BuildHref("proofs");
    private string SettlementHref => BuildHref("settlement");

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(RequestId))
        {
            detail = null;
            errorMessage = "의뢰ID가 없습니다.";
            isLoading = false;
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            detail = await DataService.운송워크플로우관제상세조회Async(RequestId);
        }
        catch (Exception ex)
        {
            detail = null;
            errorMessage = $"이벤트 로그 조회 실패: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string BuildHref(string? segment)
        => 운송관제NavigationContext.WorkflowHref(RequestId, segment, ReturnPath);

    private void NavigateToOverview()
        => NavigationManager.NavigateTo(OverviewHref);

}
