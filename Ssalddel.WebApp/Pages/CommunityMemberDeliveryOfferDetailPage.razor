@page "/community/exchange/deliveries/offers/{OfferId}"
@using Ssalddel.Ui.Common.Areas.App.Services
@inject NavigationManager Navigation
<PageTitle>생활 배송 · 살뜰</PageTitle>
<Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.NeighborhoodMemberOfferDetail OfferId="@OfferId" LoginHref="@LoginHref" />
@code {
    [Parameter] public string OfferId { get; set; } = "";
    private string ReturnRoute => NeighborhoodMemberDeliveryRoutes.Offer(OfferId);
    private string LoginHref => Navigation.ToAbsoluteUri($"login?returnUrl={Uri.EscapeDataString(Navigation.ToAbsoluteUri(ReturnRoute.TrimStart('/')).PathAndQuery)}").ToString();
}
