@page "/driver/work/start"
@using Ssalddel.Contracts.Driver.Work
@inject 기사운행Service 운행Service
@inject WebAuthSessionService AuthSession

<WebPageHeader Eyebrow="Driver Web"
               Title="운행 시작"
               Description="기사 본인이 입력한 시작 조건으로 운행 세션과 서버 위치 갱신만 처리합니다."
               Badge="운행 API" />

<MudGrid>
    <MudItem xs="12" lg="5">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.h6">시작 기준</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Android 백그라운드 위치 송신은 네이티브 앱에 남기고, WebApp에서는 서버 운행 상태와 위치 계약을 검증합니다.
                    </MudText>
                </MudStack>

                <MudSelect T="string" @bind-Value="StartMode" Label="시작 모드" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@StartModeImmediate">일반 운행</MudSelectItem>
                    <MudSelectItem T="string" Value="@StartModeReserved">예약 운행</MudSelectItem>
                    <MudSelectItem T="string" Value="@StartModeReturn">복귀 운행</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="StartLocation" Label="시작 위치" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="ReturnDestination" Label="복귀지" Variant="Variant.Outlined" />

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" @bind-Value="Latitude" Label="현재 위도" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" @bind-Value="Longitude" Label="현재 경도" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" @bind-Value="ReturnLatitude" Label="복귀지 위도 (선택)" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" @bind-Value="ReturnLongitude" Label="복귀지 경도 (선택)" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Disabled="@(IsBusy || !CanStartWork)"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               OnClick="StartWorkAsync">
                        운행 시작
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               Disabled="@IsBusy"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="StopWorkAsync">
                        운행 종료
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Disabled="@IsBusy"
                               StartIcon="@Icons.Material.Filled.Sync"
                               OnClick="LoadWorkStateAsync">
                        상태 새로고침
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="7">
        <MudStack Spacing="3">
            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <MudAlert Severity="@StatusSeverity" Variant="Variant.Outlined">
                    @StatusMessage
                </MudAlert>
            }

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">현재 운행 상태</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@WorkStateColor" Variant="Variant.Filled">@WorkStateLabel</MudChip>
                    </MudStack>

                    <MudGrid>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">기사</MudText>
                            <MudText Typo="Typo.body1">@Display(CurrentWork?.DriverId, AuthSession.UserName, AuthSession.UserId, "-")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">시작 모드</MudText>
                            <MudText Typo="Typo.body1">@Display(CurrentWork?.시작모드, StartMode)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">시작 시각</MudText>
                            <MudText Typo="Typo.body1">@DisplayDate(CurrentWork?.시작시각, LastStartResponse?.StartedAt)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">시작 위치</MudText>
                            <MudText Typo="Typo.body1">@Display(CurrentWork?.시작위치, StartLocation)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">복귀지</MudText>
                            <MudText Typo="Typo.body1">@Display(CurrentWork?.복귀지, CurrentWork?.오늘의복귀지주소, ReturnDestination, "미설정")</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">최근 위치</MudText>
                            <MudText Typo="Typo.body1">@DisplayLocation()</MudText>
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">위치 갱신</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info">위치 API</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        브라우저는 자동 위치 추적을 가장하지 않습니다. 현재 좌표를 확인한 뒤 명시적으로 서버에 갱신하고, 추천 수신은 추천 목록에서 연결합니다.
                    </MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Disabled="@(IsBusy || !HasValidCoordinates)"
                                   StartIcon="@Icons.Material.Filled.MyLocation"
                                   OnClick="SendLocationAsync">
                            위치 갱신
                        </MudButton>
                        <MudButton Href="@DriverRoutes.Recommendations"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.TaskAlt">
                            추천 배차로
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">다음 행동</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Href="@DriverRoutes.CurrentTransport" Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.LocalShipping">
                            현재 운송 보기
                        </MudButton>
                        <MudButton Href="@DriverRoutes.Home" Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Home">
                            기사 홈으로
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    private const string StartModeImmediate = "바로시작";
    private const string StartModeReserved = "예약대기";
    private const string StartModeReturn = "복귀콜찾기";

    private string StartMode { get; set; } = StartModeImmediate;
    private string StartLocation { get; set; } = string.Empty;
    private string? ReturnDestination { get; set; }
    private decimal? Latitude { get; set; }
    private decimal? Longitude { get; set; }
    private decimal? ReturnLatitude { get; set; }
    private decimal? ReturnLongitude { get; set; }
    private bool IsBusy { get; set; }
    private string? StatusMessage { get; set; }
    private Severity StatusSeverity { get; set; } = Severity.Info;
    private 기사운행시작응답? LastStartResponse { get; set; }
    private 기사운행상태응답? WorkStatus { get; set; }
    private 기사현재근무응답? CurrentWork { get; set; }
    private 기사위치갱신응답? LastLocation { get; set; }

    private string WorkStateLabel => Display(CurrentWork?.운행상태, WorkStatus?.Status, LastStartResponse?.Status, "상태 미확인");
    private Color WorkStateColor => ContainsAny(WorkStateLabel, "운행중", "운행") ? Color.Success : Color.Default;
    private bool HasValidCoordinates
        => Latitude is >= -90 and <= 90
           && Longitude is >= -180 and <= 180;
    private bool CanStartWork
        => !string.IsNullOrWhiteSpace(StartLocation)
           && HasValidCoordinates
           && (!ReturnLatitude.HasValue && !ReturnLongitude.HasValue
               || ReturnLatitude is >= -90 and <= 90 && ReturnLongitude is >= -180 and <= 180 && !string.IsNullOrWhiteSpace(ReturnDestination));

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.RestoreAsync();
        await TryLoadInitialStateAsync();
    }

    private async Task TryLoadInitialStateAsync()
    {
        try
        {
            await LoadWorkStateAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"운행 상태를 아직 불러오지 못했습니다. {ex.Message}", Severity.Info);
        }
    }

    private async Task StartWorkAsync()
    {
        if (!CanStartWork)
        {
            SetStatus("시작 위치와 현재 좌표를 확인하고, 복귀지 좌표는 위도·경도를 함께 입력해 주세요.", Severity.Warning);
            return;
        }

        await RunAsync("운행을 시작했습니다. 위치 갱신 후 추천 산정 흐름을 확인할 수 있습니다.", async () =>
        {
            LastStartResponse = await 운행Service.운행시작Async(new 기사운행시작요청
            {
                시작모드 = StartMode,
                시작시각 = DateTime.UtcNow,
                시작위치 = StartLocation,
                복귀지 = ReturnDestination,
                오늘의복귀지주소 = ReturnDestination,
                오늘의복귀지위도 = ReturnLatitude,
                오늘의복귀지경도 = ReturnLongitude,
                기본복귀지사용 = false,
                복귀지출처 = "WebApp",
                복귀콜선호 = StartMode == StartModeReturn ? "복귀우선" : "균형"
            });

            await LoadWorkStateCoreAsync();
        });
    }

    private async Task StopWorkAsync()
    {
        await RunAsync("운행을 종료했습니다.", async () =>
        {
            await 운행Service.운행종료Async();
            LastStartResponse = null;
            await LoadWorkStateCoreAsync();
        });
    }

    private async Task SendLocationAsync()
    {
        if (!HasValidCoordinates)
        {
            SetStatus("서버에 보낼 유효한 위도·경도를 직접 확인해 주세요.", Severity.Warning);
            return;
        }

        await RunAsync("서버 위치를 갱신했습니다.", async () =>
        {
            LastLocation = await 운행Service.위치갱신Async(new 기사위치갱신요청
            {
                위도 = Latitude!.Value,
                경도 = Longitude!.Value,
                정확도_m = 30,
                상차접근허용반경Km = 10m,
                운행상태 = "운행중",
                기록시각 = DateTime.UtcNow
            });

            await LoadWorkStateCoreAsync();
        });
    }

    private async Task LoadWorkStateAsync()
    {
        await RunAsync("운행 상태를 새로고침했습니다.", LoadWorkStateCoreAsync);
    }

    private async Task LoadWorkStateCoreAsync()
    {
        WorkStatus = await 운행Service.운행상태조회Async();
        CurrentWork = await 운행Service.현재근무조회Async();
    }

    private async Task RunAsync(string successMessage, Func<Task> action)
    {
        IsBusy = true;
        SetStatus("서버 요청을 처리하는 중입니다.", Severity.Info);

        try
        {
            await action();
            SetStatus(successMessage, Severity.Success);
        }
        catch (Exception ex)
        {
            SetStatus(ex.Message, Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void SetStatus(string message, Severity severity)
    {
        StatusMessage = message;
        StatusSeverity = severity;
    }

    private string DisplayLocation()
    {
        var lat = LastLocation?.현재위도 ?? WorkStatus?.현재위도 ?? Latitude;
        var lng = LastLocation?.현재경도 ?? WorkStatus?.현재경도 ?? Longitude;
        if (!lat.HasValue || !lng.HasValue)
        {
            return "아직 수신되지 않음";
        }

        var time = LastLocation?.최근위치수신시각 ?? WorkStatus?.최근위치수신시각 ?? WorkStatus?.UpdatedAt;
        var timeLabel = time.HasValue ? $" · {time.Value.ToLocalTime():MM-dd HH:mm}" : string.Empty;
        return $"{lat.Value:F6}, {lng.Value:F6}{timeLabel}";
    }

    private static string Display(params string?[] values)
        => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static string DisplayDate(params DateTime?[] values)
    {
        var value = values.FirstOrDefault(x => x.HasValue);
        return value.HasValue ? value.Value.ToLocalTime().ToString("MM-dd HH:mm") : "-";
    }

    private static bool ContainsAny(string? value, params string[] tokens)
        => !string.IsNullOrWhiteSpace(value)
           && tokens.Any(token => value.Contains(token, StringComparison.OrdinalIgnoreCase));
}
