<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2" AlignItems="AlignItems.Center">
        <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6">표시할 현재 운송이 없습니다.</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            추천 배차를 보거나 현재 운송을 다시 확인할 수 있습니다.
        </MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Justify="Justify.Center">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Sync"
                       Disabled="@IsBusy"
                       OnClick="OnRefresh">
                현재 운송 조회
            </MudButton>
            <MudButton Href="/driver/recommendations"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.TaskAlt">
                추천 배차로
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }
}
