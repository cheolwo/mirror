@page "/shipper/request/procedure"
@inject ShipperRequestAuthoringPageViewModel PageModel
@inject NavigationManager Navigation

<PageTitle>운송 의뢰 작성 - 절차·결제 정보</PageTitle>

<WebShipperSubmissionRecoveryPanel PageModel="PageModel" />
@if (!PageModel.HasSubmission && !PageModel.IsBusy)
{
<ShipperRequestProcedureScreen ViewModel="PageModel.State"
                               MobileStep="ShipperRequestMobileStep.Payment"
                               Title="비용은 어떻게 정하나요?"
                               Description="운임과 지급 조건을 확인해 주세요."
                               NavigationContext="RouteContext"
                               RootBackHref="@RouteContext.RootPath"
                               VehicleTypes="PageModel.VehicleTypes"
                               RecommendationRequested="PageModel.RecommendVehiclesAsync"
                               IsBusy="PageModel.IsBusy"
                               CommunityConsultationHref="@CommunityConsultationHref"
                               Changed="PageModel.AutoSaveAsync" />
}

@code {
    private ShipperRequestNavigationContext RouteContext
        => ShipperRequestNavigationContext.Parse(Navigation.Uri);

    private string CommunityConsultationHref
        => CommunityPageRoutes.ComposeFor(
            boardName: "화물",
            boardKey: CommunityBoardKeys.Cargo,
            returnPath: RouteContext.PathFor(ShipperRequestAuthoringStep.Procedure));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await PageModel.InitializeAsync(RouteContext);
        StateHasChanged();
    }
}
