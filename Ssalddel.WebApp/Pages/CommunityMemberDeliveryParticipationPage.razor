@page "/community/exchange/deliveries/participation"
@using Ssalddel.Ui.Common.Areas.App.Services
@inject NavigationManager Navigation
<PageTitle>생활 배송 · 살뜰</PageTitle>
<Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.NeighborhoodMemberParticipation  LoginHref="@LoginHref" />
@code {
    private string ReturnRoute => NeighborhoodMemberDeliveryRoutes.Home;
    private string LoginHref => Navigation.ToAbsoluteUri($"login?returnUrl={Uri.EscapeDataString(Navigation.ToAbsoluteUri(ReturnRoute.TrimStart('/')).PathAndQuery)}").ToString();
}
