@page "/community/exchange/work/new"
@inject NavigationManager Navigation
<PageTitle>협업 신청 · 살뜰</PageTitle>
<Ssalddel.WebApp.Components.Community.NeighborhoodAuthenticationBoundary AuthenticationChanged="@AuthenticationChanged">
    <Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.NeighborhoodCollaborationCreate @ref="_page" PostId="@PostId" SpaceId="@SpaceId" WorkId="@WorkId" ReturnUrl="@ReturnUrl" LoginHref="@LoginHref"  />
</Ssalddel.WebApp.Components.Community.NeighborhoodAuthenticationBoundary>
@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "postId")] public long? PostId { get; set; }
    [SupplyParameterFromQuery(Name = "spaceId")] public string? SpaceId { get; set; }
    [SupplyParameterFromQuery(Name = "workId")] public string? WorkId { get; set; }
    private Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.NeighborhoodCollaborationCreate? _page;
    private string LoginHref => Navigation.ToAbsoluteUri("login?returnUrl=" + Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)).ToString();
    private Task AuthenticationChanged() => _page?.NotifyAuthenticationChangedAsync() ?? Task.CompletedTask;
}
