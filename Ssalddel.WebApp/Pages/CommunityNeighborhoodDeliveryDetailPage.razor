@page "/community/exchange/deliveries/{RequestId}"
@inject NavigationManager Navigation
<PageTitle>배송 진행 · 살뜰</PageTitle>
<Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.NeighborhoodDeliveryDetail RequestId="@RequestId" LoginHref="@LoginHref" @key="RequestId" />
@code {
    [Parameter] public string RequestId { get; set; } = "";
    private string LoginHref => Navigation.ToAbsoluteUri($"login?returnUrl={Uri.EscapeDataString(Navigation.ToAbsoluteUri(NeighborhoodDeliveryRoutes.Detail(RequestId).TrimStart('/')).PathAndQuery)}").ToString();
}
