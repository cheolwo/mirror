@page "/shipper/public-cargo"
@using Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Cargo
@using Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Core
@inject IRoleWorkspaceAccess Access

<PageTitle>공개 화물 · 살뜰</PageTitle>

<CargoPublicBrowseScreen InformationNoticesHref="@CargoNoticeNavigation.Public"
                         PrimaryActionHref="@(Access.GetIdentity("shipper").IsAuthenticated ? ShipperRoutes.Request : CargoPublicBrowseNavigation.ShipperRequestLogin)"
