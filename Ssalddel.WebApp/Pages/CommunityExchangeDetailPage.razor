@page "/community/exchange/posts/{PostId:long}"
@inject NavigationManager Navigation
<PageTitle>교류 글 · 살뜰</PageTitle>
<Ssalddel.Ui.Common.Areas.App.Components.Community.Exchange.ExchangeDetail PostId="@PostId" ReturnUrl="@ReturnUrl" LoginHref="@LoginHref" @key="PostId" />
@code { [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; } [Parameter] public long PostId { get; set; } private string LoginHref => Navigation.ToAbsoluteUri("login?returnUrl=" + Uri.EscapeDataString(new Uri(Navigation.Uri).PathAndQuery)).ToString(); }
