@page "/community/home"
@layout MapOnlyLayout
@using Ssalddel.Contracts.Common.Content
@using Ssalddel.Contracts.Common.TraditionalMarkets
@using Ssalddel.Ui.Common.Areas.App.Services
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject WebAuthSessionService AuthSession
@inject 커뮤니티세계지도Client WorldMapClient
@inject GoogleMapsBrowserRuntimeClient GoogleMapsRuntimeClient
@inject 지역문화이미지Client RegionalImageClient
@inject CommunityMapApplicationLedgerClient MapApplicationLedgerClient

<PageTitle>생활·업무 통합 지도 · 살뜰</PageTitle>

<main class="@RootClass">
    <header class="world-community-home__hero">
        <div>
            <span>01 · 생활·업무 공개정보</span>
            <h1>세계 지도를 보며<br />지역의 삶과 일을 알아봐요</h1>
            <p>지역 문화·가격·유통 근거처럼 생활과 업무 판단에 필요한 공개 자료를 보여줍니다. 가격 자료는 출처·기준 시각·통화·거래 단위를 함께 표시하고, 조회와 실제 주문·계약·배차는 계속 분리합니다.</p>
        </div>
        <nav aria-label="커뮤니티 바로가기">
            <a class="world-community-home__primary-link" href="@AppRelative(RegionalCultureSpecialtyRoutes.Browse)">
                지역 자료 전체 보기
                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
            </a>
            <a href="@AppRelative(CommunityPageRoutes.BoardDirectory)">커뮤니티 대화 보기</a>
        </nav>
    </header>

    <section class="world-community-home__map-panel" aria-labelledby="world-map-heading">
        <aside class="world-community-home__map-controls" aria-label="지도 데이터와 레이어 조작">
        <header>
            <div>
                <span>PUBLIC DATA WORK EXPLORER</span>
                <h2 id="world-map-heading">어느 지역의 업무 근거를 들여다볼까요?</h2>
            </div>
            <div class="world-community-home__legend" aria-label="지도 자료 상태">
                <span><i class="is-ready" aria-hidden="true"></i>자료 연결</span>
                <span><i class="is-preparing" aria-hidden="true"></i>자료 준비 중</span>
            </div>
        </header>

        <section class="world-community-home__role-profile" aria-label="현재 역할별 지도 관점" aria-live="polite">
            <div>
                <span>ROLE LENS</span>
                <strong>@ActiveRoleProfile.DisplayName</strong>
            </div>
            <p>@ActiveRoleProfile.Description</p>
            <small>@ActiveRoleProfile.Boundary</small>
            @if (_layersCustomized)
            {
                <button type="button" @onclick="ResetLayersForActiveRole">
                    역할 기본 레이어 복원
                </button>
            }
        </section>

        <div class="world-community-home__layer-bar" aria-label="지도 분야 레이어 선택">
            <div>
                <strong>@(IsNightLearning ? "지도에 표시할 분야" : "업무 영역과 원장 연결")</strong>
                <small>@(IsNightLearning ? "여러 분야를 함께 켜도 지도는 한 개만 유지됩니다." : "업무 영역을 켜면 대응 원장과 지도 근거가 함께 표시됩니다.")</small>
            </div>
            <div class="world-community-home__layer-options">
                @foreach (var layer in RoleOrderedLayers)
                {
                    var layerDiagram = BuildLayerDiagram(layer);
                    <button type="button"
                            class="@LayerOptionClass(layer.Code)"
                            style="--layer-color: @layer.Color"
                            aria-pressed="@IsLayerSelected(layer.Code).ToString().ToLowerInvariant()"
                            title="@layer.Description"
                            @onclick="() => ToggleLayer(layer.Code)">
                        <i class="world-community-home__layer-shape world-community-home__layer-shape--@layer.MarkerShape" aria-hidden="true"></i>
                        <span class="world-community-home__layer-option-copy">
                            <strong>@layer.DisplayName</strong>
                            <small>@LayerOptionCaption(layer, layerDiagram)</small>
                        </span>
                    </button>
                }
                <button type="button"
                        class="world-community-home__price-source-button @(ShowPriceMarketCatalog ? "is-active" : null)"
                        aria-pressed="@ShowPriceMarketCatalog.ToString().ToLowerInvariant()"
                        aria-controls="world-map-results"
                        @onclick="OpenPriceMarketCatalog">
                    <MudIcon Icon="@Icons.Material.Filled.PriceCheck" Size="Size.Small" />
                    <span class="world-community-home__layer-option-copy">
                        <strong>가격·시장 출처</strong>
                        <small>KAMIS · USDA AMS</small>
                    </span>
                </button>
            </div>
            @if (!IsNightLearning)
            {
                <p class="world-community-home__layer-ledger-summary" aria-live="polite">
                    <span>현재 기준 원장</span>
                    <strong>@(ActiveLayerDiagrams.Count == 0 ? "연결 없음" : string.Join(" · ", ActiveLayerDiagrams.Select(diagram => diagram.DisplayName)))</strong>
                </p>
            }
        </div>
        </aside>

        @if (!IsNightLearning)
        {
            <section class="world-community-home__simulation" aria-labelledby="transport-simulation-heading">
                <header>
                    <div>
                        <span>SIMULATED · 시뮬레이션/교육용/비실시간</span>
                        <strong id="transport-simulation-heading">물류·항공·해상 흐름</strong>
                    </div>
                    <button type="button"
                            class="world-community-home__simulation-motion"
                            aria-pressed="@_simulationAnimationEnabled.ToString().ToLowerInvariant()"
                            @onclick="ToggleSimulationAnimation">
                        <MudIcon Icon="@(_simulationAnimationEnabled ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" Size="Size.Small" />
                        @(_simulationAnimationEnabled ? "움직임 끄기" : "움직임 켜기")
                    </button>
                </header>
                <p class="world-community-home__simulation-warning">
                    실제 운행 추적·배차 확정·개인 위치·타 조직 운영정보가 아닙니다.
                </p>
                <div class="world-community-home__simulation-toggles" role="group" aria-label="교육용 이동 레이어 선택">
                    @foreach (var modeCode in SimulationModeCodes)
                    {
                        <button type="button"
                                class="@(_enabledSimulationModeCodes.Contains(modeCode) ? "is-active" : null)"
                                style="--simulation-color: @SimulationColor(modeCode)"
                                aria-pressed="@_enabledSimulationModeCodes.Contains(modeCode).ToString().ToLowerInvariant()"
                                @onclick="() => ToggleSimulationMode(modeCode)">
                            <i aria-hidden="true"></i>
                            @SimulationModeDisplayName(modeCode)
                        </button>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_simulationOverlayMessage))
                {
                    <p class="world-community-home__simulation-error" role="status">@_simulationOverlayMessage</p>
                }
                <details>
                    <summary>고정 예시의 상태·출처·기준 보기</summary>
                    <ul>
                        @foreach (var scenario in SimulationRoutes)
                        {
                            <li>
                                <strong>@scenario.DisplayName · @scenario.SimulationMark</strong>
                                <span>@scenario.StatusLabel · @scenario.SourceName</span>
                                <span>기준 @scenario.BasisAtUtc.ToString("yyyy-MM-dd") · @scenario.FreshnessLabel</span>
                            </li>
                        }
                    </ul>
                </details>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(_snapshotConnectionMessage))
        {
            <div class="world-community-home__freshness world-community-home__freshness--warning" role="status">
                <strong>자동 갱신 연결 안 됨</strong>
                <span>@_snapshotConnectionMessage</span>
            </div>
        }
        else if (_lastSnapshotCheckedAt is not null)
        {
            <p class="world-community-home__refresh-note">
                공개 자료 자동 확인 · 마지막 확인 @_lastSnapshotCheckedAt.Value.ToLocalTime().ToString("HH:mm:ss")
            </p>
        }

        <div id="world-map-focus-target"
             class="world-community-home__map-scroll"
             tabindex="0"
             aria-label="세계 지도. 작은 화면에서는 좌우로 이동할 수 있습니다.">
            <div class="world-community-home__map">
                <div id="community-world-google-map"
                     class="world-community-home__google-map @(_googleMapState == GoogleMapState.Ready ? "is-ready" : null)"
                     role="application"
                     aria-hidden="@(_googleMapState == GoogleMapState.Ready ? "false" : "true")"
                     aria-label="@(IsNightLearning ? "Google 지도에서 밤의 공개 자료 알아차리기" : "Google 지도에서 낮의 생활·업무 자료 지역 선택")">
                </div>

                @if (_googleMapState == GoogleMapState.Ready)
                {
                    <label class="world-community-home__keyboard-markers">
                        <span>키보드 마커 선택</span>
                        <select aria-label="Google 지도 마커 키보드 선택"
                                aria-controls="world-map-results"
                                value="@_selectedObservationId"
                                @onchange="SelectMapFeatureFromKeyboard">
                            <option value="">마커를 선택하세요</option>
                            @foreach (var marker in CurrentMapMarkers)
                            {
                                <option value="@marker.Id">@marker.Name · @marker.DataLabel</option>
                            }
                        </select>
                    </label>
                }

                @if (_googleMapState != GoogleMapState.Ready)
                {
                    <div class="world-community-home__map-fallback">
                    <svg viewBox="0 0 1000 500"
                         role="img"
                         aria-labelledby="world-map-title world-map-description"
                         preserveAspectRatio="xMidYMid meet">
                        <title id="world-map-title">@(IsNightLearning ? "생각·성찰·경전 공개 자료 알아차림 세계 지도" : "생활·업무 근거 탐색 세계 지도")</title>
                        <desc id="world-map-description">@(IsNightLearning ? "공개 자료 채널의 제공 국가를 기준으로 가볍게 알아차립니다." : "대한민국, 미국, 중국, 호주에 생활·업무 판단 자료가 연결되어 있습니다.")</desc>
                        <defs>
                            <linearGradient id="world-map-ocean" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="#dcecf3" />
                                <stop offset="100%" stop-color="#c7dfe9" />
                            </linearGradient>
                            <linearGradient id="world-map-land" x1="0" y1="0" x2=".8" y2="1">
                                <stop offset="0%" stop-color="#e9e4cf" />
                                <stop offset="62%" stop-color="#d7dfc7" />
                                <stop offset="100%" stop-color="#c9d5bc" />
                            </linearGradient>
                            <filter id="world-map-coast-shadow" x="-10%" y="-10%" width="120%" height="120%">
                                <feDropShadow dx="0" dy="2" stdDeviation="2.5" flood-color="#426b7a" flood-opacity=".2" />
                            </filter>
                        </defs>
                        <rect class="world-community-home__ocean" width="1000" height="500" fill="url(#world-map-ocean)" />
                        <g class="world-community-home__graticule" aria-hidden="true">
                            <path d="M0 62.5 H1000 M0 125 H1000 M0 187.5 H1000 M0 250 H1000 M0 312.5 H1000 M0 375 H1000 M0 437.5 H1000" />
                            <path d="M100 0 V500 M200 0 V500 M300 0 V500 M400 0 V500 M500 0 V500 M600 0 V500 M700 0 V500 M800 0 V500 M900 0 V500" />
                        </g>
                        <g class="world-community-home__continents" aria-hidden="true">
                            <path d="M64 94 L128 52 L221 58 L286 95 L274 128 L235 147 L222 190 L180 212 L142 188 L110 146 L77 133 Z" />
                            <path d="M225 217 L282 226 L312 270 L295 331 L268 392 L241 423 L226 370 L205 315 L198 260 Z" />
                            <path d="M424 104 L467 85 L514 98 L526 126 L498 144 L456 140 L427 123 Z" />
                            <path d="M447 154 L516 156 L555 214 L539 286 L501 357 L461 330 L434 264 L421 201 Z" />
                            <path d="M516 91 L603 63 L707 78 L785 112 L875 120 L920 168 L882 210 L805 206 L755 179 L702 194 L643 170 L590 180 L548 145 Z" />
                            <path d="M760 306 L825 287 L884 309 L897 353 L866 388 L795 381 L753 345 Z" />
                            <path d="M341 39 L389 18 L431 40 L415 75 L365 78 Z" />
                        </g>
                        <g class="world-community-home__country-boundaries" aria-hidden="true">
                            <path d="M112 82 L139 113 L161 128 L181 174 M172 63 L190 95 L224 119 L235 147 M90 134 L136 143 L164 174" />
                            <path d="M227 244 L260 266 L291 274 M217 302 L268 315 L294 346" />
                            <path d="M548 106 L579 132 L616 137 L643 170 M603 64 L632 112 L674 137 L702 194 M707 78 L694 123 L735 164 L755 179 M785 112 L751 145 L805 206 M825 124 L842 163 L882 210" />
                            <path d="M452 173 L490 192 L539 214 M434 226 L482 238 L527 272 M461 330 L496 293 L539 286" />
                            <path d="M774 315 L812 335 L869 329 M795 381 L820 350 L884 353" />
                        </g>
                        <g class="world-community-home__water-labels" aria-hidden="true">
                            <text x="52" y="274">태평양</text>
                            <text x="352" y="214">대서양</text>
                            <text x="635" y="322">인도양</text>
                            <text x="900" y="256">태평양</text>
                        </g>
                        <g class="world-community-home__coordinate-labels" aria-hidden="true">
                            <text x="8" y="130">45°N</text>
                            <text x="8" y="255">0°</text>
                            <text x="8" y="380">45°S</text>
                            <text x="194" y="493">120°W</text>
                            <text x="395" y="493">60°W</text>
                            <text x="495" y="493">0°</text>
                            <text x="596" y="493">60°E</text>
                            <text x="793" y="493">120°E</text>
                        </g>
                        <g class="world-community-home__preparing-labels" aria-hidden="true">
                            <text x="255" y="305">남아메리카 · 준비 중</text>
                            <text x="471" y="256">아프리카 · 준비 중</text>
                            <text x="475" y="116">유럽 · 준비 중</text>
                        </g>
                        <g class="world-community-home__compass" transform="translate(955 46)" aria-hidden="true">
                            <circle r="22" />
                            <path d="M0 -17 L5 0 L0 -4 L-5 0 Z" />
                            <text y="-26">N</text>
                        </g>
                        <g class="world-community-home__scale" transform="translate(28 456)" aria-hidden="true">
                            <path d="M0 0 H112 M0 -4 V4 M56 -4 V4 M112 -4 V4" />
                            <text x="0" y="16">0</text>
                            <text x="45" y="16">2,500</text>
                            <text x="99" y="16">5,000 km</text>
                        </g>
                    </svg>

                    @if (!IsNightLearning && VisibleSimulationRoutes.Count > 0)
                    {
                        <svg class="world-community-home__simulation-fallback"
                             viewBox="0 0 1000 500"
                             role="img"
                             aria-label="실제 위치가 아닌 교육용 화물·항공·해상 시뮬레이션 경로">
                            @foreach (var scenario in VisibleSimulationRoutes)
                            {
                                <path class="world-community-home__simulation-route"
                                      d="@FallbackSimulationPath(scenario)"
                                      stroke="@scenario.Color" />
                                <g class="world-community-home__simulation-vehicle world-community-home__simulation-vehicle--@scenario.ModeCode"
                                   fill="@scenario.Color"
                                   transform="@FallbackSimulationStaticTransform(scenario)">
                                    @if (scenario.ModeCode == 운송시뮬레이션ModeCodes.Aviation)
                                    {
                                        <path d="M13 0 L-7 -6 L-3 0 L-7 6 Z" />
                                    }
                                    else if (scenario.ModeCode == 운송시뮬레이션ModeCodes.Maritime)
                                    {
                                        <path class="world-community-home__simulation-wake" d="M-12 -4 L-24 0 L-12 4" />
                                        <path d="M11 0 L5 7 L-10 5 L-12 -5 L5 -7 Z" />
                                    }
                                    else
                                    {
                                        <rect x="-11" y="-7" width="17" height="12" rx="3" />
                                        <rect x="6" y="-4" width="7" height="9" rx="2" />
                                    }
                                    @if (_simulationAnimationEnabled)
                                    {
                                        <animateMotion dur="@($"{scenario.AnimationCycleSeconds:F0}s")"
                                                       repeatCount="indefinite"
                                                       rotate="auto"
                                                       path="@FallbackSimulationPath(scenario)" />
                                    }
                                </g>
                            }
                        </svg>
                    }

                    @foreach (var country in FallbackMapMarkers)
                    {
                        <button type="button"
                                class="@MapHotspotClass(country)"
                                style="@MapHotspotStyle(country)"
                                aria-label="@($"{country.Name} · {country.DataLabel}")"
                                title="왼쪽 클릭: 자료 보기 · 오른쪽 클릭: 신청 업무 선택"
                                aria-pressed="@IsSelectedMarker(country)"
                                aria-controls="world-map-results"
                                @onclick="() => SelectMapFeature(country.Code, country.Id)"
                                @oncontextmenu="args => OpenMapApplicationsAsync(args, country)"
                                @oncontextmenu:preventDefault>
                            <span aria-hidden="true"></span>
                            <strong>@country.Name</strong>
                            <small>@country.DataLabel</small>
                        </button>
                    }

                    <span class="world-community-home__map-provider-status">
                        @(_googleMapState switch
                        {
                            GoogleMapState.Failed => "Google 지도 연결 실패 · 지도형 개략도 표시",
                            GoogleMapState.BlockedOrigin => "Google 지도 origin 허용 안 됨 · 지도형 개략도 표시",
                            _ => "Google 지도 설정 전 · 지도형 개략도 표시"
                        })
                    </span>
                    </div>
                }
            </div>
        </div>

        <p class="world-community-home__map-note">
            지도는 자료를 찾기 위한 개략도이며 국경·영유권 판단의 기준이 아닙니다.
            @(IsNightLearning
                ? "밤 지도의 위치는 자료 제공자의 국가 맥락일 뿐, 사상·경전의 기원이나 신앙 분류가 아닙니다."
                : "활성 지역도 모든 품목을 뜻하지 않으며, 연결된 공식 관측 범위만 보여줍니다.")
        </p>
    </section>

    <aside id="world-map-layer-diagrams"
           class="@DiagramPanelClass"
           aria-label="@(IsNightLearning ? "활성 지도 레이어 알아차림 다이어그램" : "활성 지도 레이어 원장 업무흐름 다이어그램")">
        <button type="button"
                class="world-community-home__diagram-toggle"
                aria-controls="world-map-layer-diagram-content"
                aria-expanded="@_isDiagramPanelExpanded.ToString().ToLowerInvariant()"
                @onclick="ToggleDiagramPanel">
            <span class="world-community-home__diagram-toggle-icon" aria-hidden="true">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
            </span>
            <span>
                <small>@(IsNightLearning ? "NIGHT LAYER FLOW" : "DAY LAYER FLOW")</small>
                <strong>@(IsNightLearning ? "레이어 알아차림 다이어그램" : "원장 업무흐름 다이어그램")</strong>
            </span>
            <em>@DiagramPanelSummary</em>
            <MudIcon Icon="@(_isDiagramPanelExpanded ? Icons.Material.Filled.KeyboardArrowDown : Icons.Material.Filled.KeyboardArrowUp)"
                     Size="Size.Small" />
        </button>

        <div id="world-map-layer-diagram-content"
             class="world-community-home__diagram-content"
             aria-hidden="@(!_isDiagramPanelExpanded).ToString().ToLowerInvariant()">
            @if (ActiveLayerDiagrams.Count == 0)
            {
                <div class="world-community-home__diagram-empty" role="status">
                    <MudIcon Icon="@Icons.Material.Filled.LayersClear" />
                    <div>
                        <strong>현재 켜진 레이어가 없습니다.</strong>
                        <span>왼쪽에서 분야를 켜면 이곳에 자료가 이어지는 흐름이 나타납니다.</span>
                    </div>
                </div>
            }
            else
            {
                @if (!IsNightLearning)
                {
                    <p class="world-community-home__diagram-projection-note">
                        <strong>업무 영역별 기준 원장 투영</strong>
                        <span>현재 레이어에 대응하는 원장 템플릿의 실제 블록·관계·구성 규칙을 표시합니다. 아직 생성된 개별 원장이나 실행 상태는 아닙니다.</span>
                    </p>
                }
                <div class="world-community-home__diagram-grid">
                    @foreach (var diagram in ActiveLayerDiagrams)
                    {
                        <section class="world-community-home__diagram-card"
                                 style="--diagram-color: @diagram.Color"
                                 aria-label="@(diagram.TemplateKey is null ? $"{diagram.DisplayName} 알아차림 흐름" : $"{diagram.DisplayName} 원장 내부 업무 절차")">
                            <header>
                                <div>
                                    <i class="world-community-home__layer-shape world-community-home__layer-shape--@diagram.MarkerShape" aria-hidden="true"></i>
                                    <span>@diagram.LayerDisplayName · @diagram.Eyebrow</span>
                                    <strong>@diagram.DisplayName</strong>
                                </div>
                                <small>블록 @diagram.Nodes.Count · 관계 @diagram.RelationCount</small>
                            </header>
                            <ol class="world-community-home__diagram-track">
                                @foreach (var node in diagram.Nodes)
                                {
                                    <li class="world-community-home__diagram-node--@node.BlockType">
                                        <span>@node.Order</span>
                                        <strong>@node.Title</strong>
                                        <small>@node.Caption</small>
                                        @if (!string.IsNullOrWhiteSpace(node.OutgoingRelationLabel))
                                        {
                                            <em>@node.OutgoingRelationLabel</em>
                                        }
                                    </li>
                                }
                            </ol>
                            <p>@diagram.Boundary</p>
                            @if (diagram.Rules.Count > 0)
                            {
                                <ul class="world-community-home__diagram-rules" aria-label="@diagram.DisplayName 구성 규칙">
                                    @foreach (var rule in diagram.Rules.Take(2))
                                    {
                                        <li>@rule</li>
                                    }
                                </ul>
                            }
                            @if (diagram.TemplateKey is not null)
                            {
                                <code>@diagram.TemplateKey</code>
                            }
                        </section>
                    }
                </div>
            }
        </div>
    </aside>

    <section id="world-map-results"
             class="world-community-home__results @(HasSelectedCountry ? "is-open" : null)"
             role="region"
             tabindex="-1"
             aria-labelledby="world-map-results-heading"
             aria-hidden="@(!HasSelectedCountry)"
             aria-live="polite"
             @onkeydown="HandleResultsPanelKeyDown">
        <header>
            <div>
                <span>@ResultEyebrow</span>
                <h2 id="world-map-results-heading">
                    @ResultTitle
                </h2>
                <p>@ResultSummary</p>
            </div>
            @if (HasSelectedCountry)
            {
                <button type="button" aria-label="선택한 지역 상세 닫기" @onclick="ShowAllCountries">상세 닫기</button>
            }
        </header>

        @if (AuthSession.IsLoggedIn && SelectedMapMarker is { } selectedLedgerMarker)
        {
            <p class="world-community-home__selected-marker-ledger">
                <span>@selectedLedgerMarker.Name</span>
                <small>@selectedLedgerMarker.DataLabel</small>
            </p>

            <section class="world-community-home__my-ledgers" aria-label="지도 마커의 내 신청 원장">
                <header>
                    <div>
                        <span>내 원장</span>
                        <strong>@selectedLedgerMarker.Name</strong>
                    </div>
                    <button type="button" @onclick="RefreshSelectedMapLedgersAsync">최신 상태 확인</button>
                </header>

                @if (_myMapLedgersLoading)
                {
                    <p class="world-community-home__my-ledger-status" role="status">내 신청 원장을 확인하고 있습니다.</p>
                }
                else if (!string.IsNullOrWhiteSpace(_myMapLedgersError))
                {
                    <p class="world-community-home__my-ledger-status is-error" role="alert">@_myMapLedgersError</p>
                }
                else if (_myMapLedgers.Count == 0)
                {
                    <p class="world-community-home__my-ledger-status" role="status">이 마커에서 시작한 내 신청 원장이 없습니다.</p>
                }
                else
                {
                    <div>
                        @foreach (var ledger in _myMapLedgers)
                        {
                            var badge = CommunityMapApplicationLedgerPresentation.For(ledger);
                            <article class="@(string.Equals(ledger.원장Id, _selectedLedgerId, StringComparison.Ordinal) ? "is-selected" : null)">
                                <span class="world-community-home__my-ledger-badge">@badge.KindLabel</span>
                                <strong>@badge.WorkLabel</strong>
                                <small>@badge.StateLabel · @badge.StepLabel</small>
                                <button type="button" @onclick="() => SelectMapLedger(ledger.원장Id)">@badge.ActionLabel</button>
                            </article>
                        }
                    </div>
                }
            </section>
        }

        @if (HasRegionalVisualSelection)
        {
            <section class="world-community-home__region-visual" aria-label="선택한 지역의 생성 이미지">
                @if (_regionImagesLoading)
                {
                    <div class="world-community-home__region-visual-state" role="status">
                        <MudIcon Icon="@Icons.Material.Filled.ImageSearch" />
                        <span>지역 이미지를 불러오는 중입니다.</span>
                    </div>
                }
                else if (SelectedRegionImage is { } regionImage)
                {
                    <figure>
                        <img src="@regionImage.ImageUrl"
                             alt="@regionImage.AltText"
                             loading="eager"
                             decoding="async" />
                        <figcaption>
                            <span>AI 생성 이미지 · @ImageQualityLabel(regionImage.QualityStatus)</span>
                            <strong>@(SelectedObservation?.Title ?? regionImage.Title)</strong>
                            <small>지역의 생활문화 맥락을 돕는 참고 이미지이며 공식 기록·원산지·거래 근거가 아닙니다.</small>
                        </figcaption>
                    </figure>
                }
                else if (!string.IsNullOrWhiteSpace(_regionImagesError))
                {
                    <div class="world-community-home__region-visual-state is-error" role="alert">
                        <MudIcon Icon="@Icons.Material.Filled.BrokenImage" />
                        <span>@_regionImagesError</span>
                        <button type="button" @onclick="LoadRegionalImagesAsync">다시 시도</button>
                    </div>
                }
                else
                {
                    <div class="world-community-home__region-visual-state" role="status">
                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" />
                        <span>이 마커에 연결된 지역 이미지는 아직 준비 중입니다.</span>
                    </div>
                }
            </section>
        }

        @if (SelectedObservation is { } selectedObservation)
        {
            var selectedLayer = LayerFor(selectedObservation.LayerCode);
            <section class="world-community-home__selection-summary" aria-label="선택한 지도 마커의 공개 정보">
                <dl>
                    <div><dt>유형</dt><dd>@(selectedLayer?.DisplayName ?? selectedObservation.LayerCode)</dd></div>
                    <div><dt>상태</dt><dd>@ObservationStatusLabel(selectedObservation)</dd></div>
                    <div><dt>자료 기준</dt><dd>@EvidenceFreshnessLabel(selectedObservation.EvidenceAsOfUtc)</dd></div>
                    <div><dt>출처</dt><dd>@selectedObservation.SourceName</dd></div>
                    @if (!string.IsNullOrWhiteSpace(selectedObservation.SourceDatasetKey))
                    {
                        <div><dt>원자료</dt><dd>@selectedObservation.SourceDatasetKey</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedObservation.SourceVersion))
                    {
                        <div><dt>자료 버전</dt><dd class="world-community-home__source-version">@selectedObservation.SourceVersion</dd></div>
                    }
                    @if (selectedObservation.CollectedAtUtc is { } collectedAtUtc)
                    {
                        <div><dt>수집</dt><dd>@($"{collectedAtUtc:yyyy-MM-dd HH:mm} UTC · {DataFreshnessLabel(selectedObservation.FreshnessCode)}")</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedObservation.UpdateCycle))
                    {
                        <div><dt>갱신 주기</dt><dd>@selectedObservation.UpdateCycle</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(selectedObservation.LocationPrecisionCode))
                    {
                        <div><dt>위치 기준</dt><dd>@LocationPrecisionLabel(selectedObservation.LocationPrecisionCode)</dd></div>
                    }
                    @if (selectedObservation.LayerCode == 커뮤니티세계지도LayerCodes.OverseasManufacturer)
                    {
                        <div><dt>제조업소</dt><dd>@(selectedObservation.OrganizationCount ?? 0)개</dd></div>
                        <div><dt>재료 관계 근거</dt><dd>@(selectedObservation.EvidenceCount ?? 0)건</dd></div>
                        <div><dt>위치 기준</dt><dd>행정권역 대표점</dd></div>
                    }
                    @if (selectedObservation.LayerCode == 커뮤니티세계지도LayerCodes.NewsPublisher)
                    {
                        <div><dt>매체 성격</dt><dd>@NewsPublisherTypeLabel(selectedObservation.MarkerStatusCode)</dd></div>
                        <div><dt>지도 위치</dt><dd>국가 대표점</dd></div>
                        <div><dt>기사 수집</dt><dd>공식 홈페이지 연결만 제공</dd></div>
                    }
                    @if (selectedObservation.Metrics is { Count: > 0 } selectedMetrics)
                    {
                        @foreach (var metric in selectedMetrics)
                        {
                            <div><dt>@metric.DisplayName</dt><dd>@MetricValueLabel(metric)</dd></div>
                        }
                    }
                </dl>
                @if (EvidenceVersionNotice is { } versionNotice)
                {
                    <p class="world-community-home__evidence-version @versionNotice.CssClass" role="status">
                        <strong>@versionNotice.Title</strong>
                        <span>@versionNotice.Message</span>
                    </p>
                }
                <p>@(selectedObservation.BoundaryNotice
                     ?? "이 마커 선택은 공개 자료 조회만 수행하며 원장·참여·주문·계약·배차를 만들지 않습니다.")</p>
                <div>
                    @if (!string.IsNullOrWhiteSpace(selectedObservation.SourceHref))
                    {
                        <a href="@selectedObservation.SourceHref" target="_blank" rel="noopener noreferrer">공식 출처</a>
                    }
                    @if (IsPriceMarketSelection)
                    {
                        <a href="@ObservationHref(selectedObservation)"
                           target="@(IsExternalHref(selectedObservation.DetailHref) ? "_blank" : null)"
                           rel="@(IsExternalHref(selectedObservation.DetailHref) ? "noopener noreferrer" : null)">
                            가격·시장 상세 보기
                        </a>
                    }
                    else if (selectedObservation.LayerCode == 커뮤니티세계지도LayerCodes.NewsPublisher)
                    {
                        <a href="@selectedObservation.DetailHref" target="_blank" rel="noopener noreferrer">
                            뉴스 홈페이지 열기
                        </a>
                    }
                </div>
            </section>

            @if (selectedObservation.LayerCode == 커뮤니티세계지도LayerCodes.NewsPublisher)
            {
                <section class="world-community-home__news-review" aria-label="뉴스 RSS 연결과 검토 후보">
                    <header>
                        <div>
                            <span>RSS REVIEW · 자동 게시 없음</span>
                            <strong>이 뉴스 출처의 기사 수집 상태</strong>
                        </div>
                        @if (_newsCandidates is null)
                        {
                            <button type="button"
                                    disabled="@_newsCandidatesLoading"
                                    @onclick="() => LoadNewsCandidatesAsync(null)">
                                @(_newsCandidatesLoading ? "확인 중…" : "RSS 연결 상태 확인")
                            </button>
                        }
                    </header>

                    @if (!string.IsNullOrWhiteSpace(_newsCandidatesError))
                    {
                        <p class="world-community-home__news-review-status is-error" role="alert">
                            @_newsCandidatesError
                        </p>
                    }
                    @if (_newsCandidates is { } newsCandidates
                         && string.Equals(newsCandidates.ObservationStableId, selectedObservation.StableId, StringComparison.Ordinal))
                    {
                        <div class="world-community-home__news-feed-status">
                            <span>@newsCandidates.PublisherFeedStatus.Label</span>
                            <p>@newsCandidates.PublisherFeedStatus.Notice</p>
                            <a href="@newsCandidates.PublisherFeedStatus.EvidenceHref"
                               target="_blank"
                               rel="noopener noreferrer">판정 근거 확인</a>
                        </div>
                        <p class="world-community-home__news-relation-notice">@newsCandidates.RelationNotice</p>

                        @if (newsCandidates.RelatedOfficialSources.Count > 0)
                        {
                            <div class="world-community-home__news-source-options" aria-label="같은 국가의 별도 공식뉴스 RSS 선택">
                                @foreach (var source in newsCandidates.RelatedOfficialSources)
                                {
                                    <button type="button"
                                            disabled="@_newsCandidatesLoading"
                                            aria-pressed="@string.Equals(newsCandidates.SelectedSourceKey, source.SourceKey, StringComparison.OrdinalIgnoreCase).ToString().ToLowerInvariant()"
                                            @onclick="() => LoadNewsCandidatesAsync(source.SourceKey)">
                                        <strong>@source.DisplayName</strong>
                                        <small>@source.UpdateCycle · 승인된 후보만</small>
                                    </button>
                                }
                            </div>
                        }

                        @if (_newsCandidatesLoading)
                        {
                            <p class="world-community-home__news-review-status" role="status">검토 원장에서 승인된 후보를 확인하고 있습니다.</p>
                        }
                        else if (newsCandidates.SelectedSourceKey is not null
                                 && newsCandidates.Failures.Count > 0)
                        {
                            <p class="world-community-home__news-review-status is-error" role="alert">
                                @newsCandidates.Failures[0].Message 외부 실패를 빈 기사 목록으로 숨기지 않습니다.
                            </p>
                        }
                        else if (newsCandidates.SelectedSourceKey is not null
                                 && newsCandidates.Items.Count == 0)
                        {
                            <p class="world-community-home__news-review-status" role="status">
                                현재 승인된 검토 후보가 없습니다. 운영 검토 전이거나 제외된 후보는 공개 지도에 표시하지 않습니다.
                            </p>
                        }
                        else if (newsCandidates.Items.Count > 0)
                        {
                            <div class="world-community-home__news-candidates">
                                @foreach (var candidate in newsCandidates.Items)
                                {
                                    <article>
                                        <div>
                                            <span>검토 승인 · @candidate.Provider · @NewsCandidateTimestamp(candidate)</span>
                                            <strong>@candidate.Title</strong>
                                        </div>
                                        <p>@candidate.Summary</p>
                                        <small>@candidate.SourceNotice</small>
                                        <a href="@candidate.OriginalUrl" target="_blank" rel="noopener noreferrer">공식 원문 확인</a>
                                    </article>
                                }
                            </div>
                        }
                        <p class="world-community-home__news-boundary">@newsCandidates.BoundaryNotice</p>
                    }
                </section>
            }

            <section class="world-community-home__question-entry" aria-label="선택한 공개 근거로 커뮤니티 글 작성">
                <header>
                    <div>
                        <span>지도에서 커뮤니티로</span>
                        <strong>이 자료를 보고 무엇을 나누고 싶나요?</strong>
                    </div>
                    <small>초안 생성은 저장되지 않습니다. 게시 버튼을 눌러야 질문 글 하나만 만들어집니다.</small>
                </header>
                <div class="world-community-home__question-purposes">
                    <button type="button"
                            disabled="@_questionDraftLoading"
                            @onclick="() => OpenQuestionComposerAsync(QuestionPurpose.Question)">
                        질문하기
                    </button>
                    <button type="button"
                            disabled="@_questionDraftLoading"
                            @onclick="() => OpenQuestionComposerAsync(QuestionPurpose.Proposal)">
                        아이디어 제안하기
                    </button>
                    <button type="button"
                            disabled="@_questionDraftLoading"
                            @onclick="() => OpenQuestionComposerAsync(QuestionPurpose.Gathering)">
                        함께 확인할 사람 모으기
                    </button>
                </div>

                @if (_questionDraftLoading)
                {
                    <p class="world-community-home__question-status" role="status">공개 근거를 붙인 초안을 준비하고 있습니다.</p>
                }
                @if (!string.IsNullOrWhiteSpace(_questionComposerError))
                {
                    <p class="world-community-home__question-status is-error" role="alert">@_questionComposerError</p>
                }
                @if (_questionDraft is { } questionDraft
                     && string.Equals(questionDraft.Evidence.ObservationStableId, selectedObservation.StableId, StringComparison.Ordinal))
                {
                    <div class="world-community-home__question-composer">
                        <div class="world-community-home__question-evidence">
                            <span>함께 저장할 공개 근거</span>
                            <strong>@questionDraft.Evidence.SourceName · @EvidenceFreshnessLabel(questionDraft.Evidence.EvidenceAsOfUtc)</strong>
                            @if (!string.IsNullOrWhiteSpace(questionDraft.Evidence.SourceVersion))
                            {
                                <small class="world-community-home__source-version">source version · @questionDraft.Evidence.SourceVersion</small>
                            }
                            <small>@questionDraft.BoundaryNotice</small>
                        </div>
                        <label>
                            <span>제목</span>
                            <input maxlength="160" @bind="_questionTitle" />
                        </label>
                        <label>
                            <span>내용</span>
                            <textarea maxlength="4000" rows="7" @bind="_questionBody"></textarea>
                        </label>
                        <div class="world-community-home__question-identity">
                            <label>
                                <span>작성자 이름</span>
                                <input maxlength="40" autocomplete="nickname" @bind="_questionNickname" />
                            </label>
                            <label>
                                <span>글 비밀번호</span>
                                <input type="password" minlength="4" maxlength="100" autocomplete="new-password" @bind="_questionPassword" />
                            </label>
                        </div>
                        <label class="world-community-home__question-confirm">
                            <input type="checkbox" @bind="_confirmSourceReference" />
                            <span>출처·기준 시각·자료 한계가 글에 함께 저장되는 것을 확인했습니다.</span>
                        </label>
                        @if (!AuthSession.IsLoggedIn)
                        {
                            <p class="world-community-home__question-login">
                                초안은 지금 편집할 수 있습니다. 게시하려면 <a href="@LoginHref">로그인</a>해 주세요.
                            </p>
                        }
                        <div class="world-community-home__question-actions">
                            <button type="button" class="is-secondary" @onclick="CloseQuestionComposer">닫기</button>
                            <button type="button"
                                    disabled="@(!CanPublishQuestion)"
                                    @onclick="PublishQuestionAsync">
                                @(_questionPublishing ? "게시 중…" : "출처와 함께 게시")
                            </button>
                        </div>
                    </div>
                }
                @if (_publishedQuestion is { } publishedQuestion)
                {
                    <div class="world-community-home__question-published" role="status">
                        <strong>커뮤니티 글을 게시했습니다.</strong>
                        <span>@publishedQuestion.NextActionNotice</span>
                        <a href="@publishedQuestion.PostHref">작성한 글 보기</a>
                    </div>
                }
            </section>
        }
        else if (SelectedMapMarker is { } selectedMarker)
        {
            var selectedMarkerLayer = LayerFor(selectedMarker.LayerCode);
            <section class="world-community-home__selection-summary" aria-label="선택한 지도 마커의 공개 카탈로그 정보">
                <dl>
                    <div><dt>유형</dt><dd>@(selectedMarkerLayer?.DisplayName ?? selectedMarker.LayerCode)</dd></div>
                    <div><dt>상태</dt><dd>@selectedMarker.DataLabel</dd></div>
                    <div><dt>자료 기준</dt><dd>@EvidenceFreshnessLabel(selectedMarker.EvidenceAsOfUtc)</dd></div>
                    <div><dt>출처</dt><dd>@(selectedMarker.SourceName ?? "검토된 공개 카탈로그")</dd></div>
                </dl>
                <p>대표 위치와 공개 출처만 표시하며 개인 주소·실시간 위치·미확인 물류 후보·개인 연락처는 포함하지 않습니다.</p>
                @if (!string.IsNullOrWhiteSpace(selectedMarker.SourceHref))
                {
                    <div><a href="@selectedMarker.SourceHref" target="_blank" rel="noopener noreferrer">공식 출처</a></div>
                }
            </section>
        }

        @if (ShowPriceMarketCatalog)
        {
            <section class="world-community-home__price-sources" aria-label="가격·시장 공개 출처 선택">
                <header>
                    <span>서로 다른 국가·시장 단계의 관측을 합산하지 않습니다.</span>
                    <strong>KAMIS와 USDA AMS 출처별 보기</strong>
                </header>
                <div>
                    @foreach (var source in PriceMarketSources)
                    {
                        <article>
                            <header><span>@source.Country</span><strong>@source.Name</strong></header>
                            <dl>
                                <div><dt>시장 단계</dt><dd>@source.MarketStage</dd></div>
                                <div><dt>품목</dt><dd>@source.CommodityScope</dd></div>
                                <div><dt>통화·단위</dt><dd>@source.CurrencyAndUnit</dd></div>
                                <div><dt>기준일·신선도</dt><dd>@source.Freshness</dd></div>
                            </dl>
                            <p>@source.Boundary</p>
                            <a href="@source.Href"
                               target="@(IsExternalHref(source.Href) ? "_blank" : null)"
                               rel="@(IsExternalHref(source.Href) ? "noopener noreferrer" : null)">
                                @source.ActionLabel
                            </a>
                        </article>
                    }
                </div>
            </section>
        }

        @if (!IsNightLearning && SelectedCountry is not null)
        {
            <section class="world-community-home__selected-ledgers" aria-label="선택 지역의 업무 영역별 원장 연결">
                <header>
                    <span>SELECTED WORK LEDGERS</span>
                    <strong>@SelectedCountry.Name 업무 영역별 원장</strong>
                    <p>지도 근거는 아래 원장을 만들기 전에 살펴보는 판단 자료입니다. 지역을 선택한 것만으로 원장·주문·계약이 생성되지는 않습니다.</p>
                </header>
                @if (SelectedDayLedgerDiagrams.Count == 0)
                {
                    <p class="world-community-home__selected-ledgers-empty">현재 켜진 업무 영역에서 연결할 원장이 없습니다.</p>
                }
                else
                {
                    <div class="world-community-home__selected-ledger-list">
                        @foreach (var ledger in SelectedDayLedgerDiagrams)
                        {
                            <article style="--ledger-color: @ledger.Color">
                                <header>
                                    <span>@ledger.LayerDisplayName</span>
                                    <strong>@ledger.DisplayName</strong>
                                    <code>@ledger.TemplateKey</code>
                                </header>
                                <ol aria-label="@ledger.DisplayName 주요 블록 미리보기">
                                    @foreach (var node in ledger.Nodes.Take(3))
                                    {
                                        <li><span>@node.Order</span><strong>@node.Title</strong></li>
                                    }
                                    @if (ledger.Nodes.Count > 3)
                                    {
                                        <li class="is-more">외 @(ledger.Nodes.Count - 3)개 블록</li>
                                    }
                                </ol>
                                <small>블록 @ledger.Nodes.Count · 관계 @ledger.RelationCount</small>
                            </article>
                        }
                    </div>
                    <button type="button" @onclick="OpenDiagramPanel">
                        하단에서 원장 전체 절차 보기
