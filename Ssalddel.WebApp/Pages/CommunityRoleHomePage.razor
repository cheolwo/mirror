    private sealed record GoogleMapMarker(
        string Id,
        string Code,
        string Name,
        string DataLabel,
        double Latitude,
        double Longitude,
        string LayerCode,
        string? SourceName = null,
        string? SourceHref = null,
        DateTimeOffset? EvidenceAsOfUtc = null)
    {
        public static GoogleMapMarker FromObservation(커뮤니티세계지도ObservationDto observation)
            => new(
                observation.StableId,
                observation.CountryCode,
                IsIndividualLocationLayer(observation.LayerCode)
                    ? observation.Title
                    : observation.CountryName,
                observation.Title,
                observation.Latitude,
                observation.Longitude,
                observation.LayerCode,
                observation.SourceName,
                observation.SourceHref,
                observation.EvidenceAsOfUtc);

        public static GoogleMapMarker ForMarket(커뮤니티도매시장MapDefinition market)
            => new(
                $"catalog:wholesale-market:{market.Key}",
                market.CountryCode,
                market.MarketName,
                market.MarketStageLabel,
                market.Latitude,
                market.Longitude,
                커뮤니티세계지도LayerCodes.WholesaleMarket,
                market.SourceName,
                market.SourceHref,
                market.EvidenceAsOfUtc);

        public static GoogleMapMarker For(
            string id,
            string code,
            string name,
            string dataLabel,
            string layerCode)
        {
            var (latitude, longitude) = code switch
            {
                "US" => (39.8283, -98.5795),
                "CN" => (35.8617, 104.1954),
                "KR" => (36.5, 127.8),
                "AU" => (-25.2744, 133.7751),
                "GB" => (54.0, -2.0),
                "FR" => (46.2276, 2.2137),
                "IN" => (20.5937, 78.9629),
                _ => (0.0, 0.0)
            };

            return new(id, code, name, dataLabel, latitude, longitude, layerCode);
        }
    }

