    private void ApplySnapshot(커뮤니티세계지도SnapshotDto snapshot, bool preserveViewport = false)
    {
        var selectionChanged = false;
        var selectedObservation = _selectedObservationId is null
            ? null
            : snapshot.Observations.FirstOrDefault(observation =>
                string.Equals(observation.StableId, _selectedObservationId, StringComparison.Ordinal));
        if (_selectedObservationId is not null && selectedObservation is null)
        {
            if (string.Equals(_selectedMarkerId, _selectedObservationId, StringComparison.Ordinal))
            {
                _selectedMarkerId = null;
            }
            _selectedObservationId = null;
            ResetQuestionComposer();
            selectionChanged = true;
        }
        else if (selectedObservation is not null)
        {
            if (!string.Equals(_selectedCountryCode, selectedObservation.CountryCode, StringComparison.Ordinal))
            {
                _selectedCountryCode = selectedObservation.CountryCode;
                selectionChanged = true;
            }

            if (!string.Equals(_selectedMarkerId, selectedObservation.StableId, StringComparison.Ordinal))
            {
                _selectedMarkerId = selectedObservation.StableId;
                selectionChanged = true;
            }

            if (_selectedLayerCodes.Add(selectedObservation.LayerCode))
            {
                _layersCustomized = true;
                selectionChanged = true;
            }
        }
        else if (_selectedMarkerId is not null)
        {
            var markerObservation = snapshot.Observations.FirstOrDefault(observation =>
                string.Equals(observation.StableId, _selectedMarkerId, StringComparison.Ordinal));
            if (markerObservation is not null)
            {
                _selectedObservationId = markerObservation.StableId;
                _selectedCountryCode = markerObservation.CountryCode;
                if (_selectedLayerCodes.Add(markerObservation.LayerCode))
                {
                    _layersCustomized = true;
                }
                selectionChanged = true;
            }
        }
        _pendingGoogleMapUpdate = true;
        _preserveGoogleMapViewport = preserveViewport;
        EnsureDefaultLayersSelected();
        if (selectionChanged)
        {
            SyncDeepLinkToUrl(replace: true);
        }
    }

    private IReadOnlyList<GoogleMapMarker> BuildCatalogFallbackMarkers()
    {
        if (IsNightLearning)
        {
            return LearningMapCountries
                .Where(_ => IsLayerSelected(커뮤니티세계지도LayerCodes.LearningChannel)
                            || IsLayerSelected(커뮤니티세계지도LayerCodes.ScriptureAndClassics))
                .Select(country => GoogleMapMarker.For(
                    $"catalog:{country.Code}",
                    country.Code,
                    country.Name,
                    country.DataLabel,
                    커뮤니티세계지도LayerCodes.LearningChannel))
                .ToArray();
        }

        var countryMarkers = MapCountries
            .Where(country => (country.Regions.Count > 0 && IsObservationSourceLayerVisible(커뮤니티세계지도LayerCodes.RegionalCulture))
                              || IsObservationSourceLayerVisible(커뮤니티세계지도LayerCodes.PublicPrice))
            .Select(country => GoogleMapMarker.For(
                    $"catalog:{country.Code}",
                    country.Code,
                    country.Name,
                    country.DataLabel,
                    country.Regions.Count > 0
                        ? 커뮤니티세계지도LayerCodes.RegionalCulture
                        : 커뮤니티세계지도LayerCodes.PublicPrice));
        var marketMarkers = IsObservationSourceLayerVisible(커뮤니티세계지도LayerCodes.WholesaleMarket)
            ? 커뮤니티도매시장MapCatalog.All.Select(GoogleMapMarker.ForMarket)
            : Enumerable.Empty<GoogleMapMarker>();

        return countryMarkers.Concat(marketMarkers).ToArray();
    }

