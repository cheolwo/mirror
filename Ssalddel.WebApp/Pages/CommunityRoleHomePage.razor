    private void ApplyDeepLinkParameters()
    {
        var previousCountry = _selectedCountryCode;
        var previousMarker = _selectedMarkerId;
        var previousObservation = _selectedObservationId;
        var previousLedgerId = _selectedLedgerId;
        var previousLayers = _selectedLayerCodes.ToHashSet(StringComparer.Ordinal);

        _selectedCountryCode = CommunityWorldMapDeepLink.NormalizeCountryCode(
            Country,
            MapCountries.Select(country => country.Code));
        _selectedMarkerId = CommunityWorldMapDeepLink.NormalizeStableId(Marker);
        _selectedObservationId = CommunityWorldMapDeepLink.NormalizeStableId(Observation);
        _requestedSnapshotRevision = CommunityWorldMapDeepLink.NormalizeStableId(
            RequestedSnapshotRevision);
        _requestedSourceVersion = CommunityWorldMapDeepLink.NormalizeStableId(
            RequestedSourceVersion);
        _selectedLedgerId = CommunityWorldMapDeepLink.NormalizeStableId(LedgerId);
        if (_selectedMarkerId is null && _selectedObservationId is not null)
        {
            _selectedMarkerId = _selectedObservationId;
        }

        var requestedLayers = CommunityWorldMapDeepLink.ParseLayerCodes(
            Layers,
            CurrentLayers.Select(layer => layer.Code));
        _selectedLayerCodes.Clear();
        if (requestedLayers is null)
        {
            AddActiveRoleDefaultLayers();
            _layersCustomized = false;
        }
        else
        {
            _selectedLayerCodes.UnionWith(requestedLayers);
            _layersCustomized = !HasActiveRoleDefaultLayers();
        }

        var selectionChanged = !string.Equals(
                                   previousCountry,
                                   _selectedCountryCode,
                                   StringComparison.Ordinal)
                               || !string.Equals(
                                   previousMarker,
                                   _selectedMarkerId,
                                   StringComparison.Ordinal)
                               || !string.Equals(
                                   previousObservation,
                                   _selectedObservationId,
                                   StringComparison.Ordinal);
        if (selectionChanged)
        {
            ResetQuestionComposer();
            ResetNewsCandidates();
            _myMapLedgers = [];
            _pendingMyMapLedgersRefresh = true;
        }
        else if (!string.Equals(previousLedgerId, _selectedLedgerId, StringComparison.Ordinal))
        {
            _pendingMyMapLedgersRefresh = true;
        }

        if (selectionChanged || !previousLayers.SetEquals(_selectedLayerCodes))
        {
            _pendingGoogleMapUpdate = true;
        }
    }

    private bool HasActiveRoleDefaultLayers()
    {
        var available = CurrentLayers
            .Select(layer => layer.Code)
            .ToHashSet(StringComparer.Ordinal);
        var defaults = ActiveRoleProfile.RecommendedLayerCodes
            .Where(available.Contains)
            .ToHashSet(StringComparer.Ordinal);
        return defaults.SetEquals(_selectedLayerCodes);
    }

    private void SyncDeepLinkToUrl(bool replace = false)
    {
        var orderedLayerCodes = CurrentLayers.Select(layer => layer.Code).ToArray();
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["dataset"] = IsNightLearning
                ? CommunityPageRoutes.WorldMapNightLearningDataset
                : null,
            [CommunityWorldMapDeepLink.CountryQueryKey] = _selectedCountryCode,
            [CommunityWorldMapDeepLink.LayersQueryKey] =
                CommunityWorldMapDeepLink.SerializeLayerCodes(
                    _selectedLayerCodes,
                    orderedLayerCodes),
            [CommunityWorldMapDeepLink.MarkerQueryKey] = _selectedMarkerId,
            [CommunityWorldMapDeepLink.ObservationQueryKey] = _selectedObservationId,
            [CommunityWorldMapDeepLink.SnapshotRevisionQueryKey] =
                SelectedObservation is null ? null : _appliedSnapshot?.Revision,
            [CommunityWorldMapDeepLink.SourceVersionQueryKey] = SelectedObservation?.SourceVersion,
            [CommunityWorldMapDeepLink.LedgerQueryKey] = _selectedLedgerId
        });
        if (!string.Equals(uri, Navigation.Uri, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(uri, replace);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await GoogleSdk.InitializeAsync(
                () => CurrentMapMarkers,
                () => DatasetCode,
                () => _selectedCountryCode,
                () => SelectedMarkerId,
                reducedMotion =>
                {
                    if (reducedMotion)
                    {
                        _simulationAnimationEnabled = false;
                    }
                });
            await UpdateTransportSimulationLayerAsync();
            _pendingGoogleMapUpdate = false;
            SnapshotSession.StartPolling(async cancellationToken =>
            {
                if (_pendingMyMapLedgersRefresh)
                {
                    await RefreshMyMapLedgersAsync(cancellationToken);
                }
            });
            StateHasChanged();
            return;
        }

        if (_googleMapState == GoogleMapState.Ready && _pendingGoogleMapUpdate && GoogleSdk.HasModule)
        {
            _pendingGoogleMapUpdate = false;
            var preserveViewport = _preserveGoogleMapViewport;
            _preserveGoogleMapViewport = false;
            await GoogleSdk.UpdateDatasetAsync(
                CurrentMapMarkers,
                DatasetCode,
                _selectedCountryCode,
                SelectedMarkerId,
                preserveViewport);
            await UpdateTransportSimulationLayerAsync();
        }

        if (_pendingFocusElementId is not null && GoogleSdk.HasModule)
        {
            var elementId = _pendingFocusElementId;
            _pendingFocusElementId = null;
            await GoogleSdk.FocusElementAsync(elementId);
        }
    }

    private async Task SelectDataset(MapDatasetMode mode)
    {
        if (_datasetMode == mode)
        {
            return;
        }

        _datasetMode = mode;
        _selectedCountryCode = null;
        _selectedMarkerId = null;
        _selectedObservationId = null;
        ResetQuestionComposer();
        ResetNewsCandidates();
        _pendingGoogleMapUpdate = true;
        ResetSnapshotForDataset();
        EnsureDefaultLayersSelected();
        SyncDeepLinkToUrl(replace: true);
        await RefreshMapSnapshotAsync(applyImmediately: true, CancellationToken.None);
    }

