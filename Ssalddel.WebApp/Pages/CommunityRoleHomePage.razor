        }

        var marker = CurrentMapMarkers.FirstOrDefault(candidate =>
            string.Equals(candidate.Id, observationId, StringComparison.Ordinal));
        if (marker is null)
        {
            return;
        }

        var availableSourceLayerCodes = new HashSet<string>(StringComparer.Ordinal)
        {
            marker.LayerCode
        };
        var hasSelectedLedgerLayer = CurrentLayers.Any(layer =>
            IsLayerSelected(layer.Code)
            && LayerHasVisibleSource(layer, availableSourceLayerCodes));
        if (hasSelectedLedgerLayer)
        {
            _isDiagramPanelExpanded = true;
        }
    }

