    private static IReadOnlyList<MapLayerDiagram> ConsolidateLedgerDiagrams(
        IEnumerable<MapLayerDiagram> diagrams)
        => diagrams
            .GroupBy(
                diagram => diagram.TemplateKey is null ? $"layer:{diagram.LayerCode}" : $"ledger:{diagram.TemplateKey}",
                StringComparer.Ordinal)
            .Select(group =>
            {
                var first = group.First();
                var layerNames = group.Select(diagram => diagram.LayerDisplayName)
                    .Distinct(StringComparer.Ordinal)
                    .ToArray();
                return layerNames.Length == 1
                    ? first
                    : first with { LayerDisplayName = string.Join(" + ", layerNames) };
            })
            .ToArray();

    private static string? FormatBlockRelation(CommunityLedgerBlockRelationResponse? relation)
        => relation is null
            ? null
            : relation.RelationType switch
            {
                CommunityLedgerRelationTypes.Requires => relation.Required ? "필수 선행" : "선행조건",
                CommunityLedgerRelationTypes.Handoff => "인계",
                CommunityLedgerRelationTypes.Reference => "참조",
                CommunityLedgerRelationTypes.Contains => "포함",
                _ => relation.Required ? "필수 흐름" : "흐름"
            };

    private void EnsureDefaultLayersSelected()
    {
        if (_selectedLayerCodes.Count > 0)
        {
            return;
        }

        AddActiveRoleDefaultLayers();
    }

    private void AddActiveRoleDefaultLayers()
    {
        var availableLayerCodes = CurrentLayers
            .Select(layer => layer.Code)
            .ToHashSet(StringComparer.Ordinal);
        foreach (var layerCode in ActiveRoleProfile.RecommendedLayerCodes)
        {
            if (availableLayerCodes.Contains(layerCode))
            {
                _selectedLayerCodes.Add(layerCode);
            }
        }
    }

