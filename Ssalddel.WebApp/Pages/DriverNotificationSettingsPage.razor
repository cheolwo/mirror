@page "/driver/notifications/settings"
@using Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DriverNotifications
@inject IDriverRecommendationSettingsClient Client
@implements IDisposable

<WebPageHeader Eyebrow="Driver Web" Title="알림 설정"
               Description="받고 싶은 추천과 알림 방식을 선택해 주세요." Badge="기사 알림" />
<DriverRecommendationSettingsForm Model="Model" ShowAdvancedOptions="true" />
<MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-4">
    <MudButton Href="/driver/notifications" Variant="Variant.Outlined">알림함 보기</MudButton>
    <MudButton Href="/driver/me" Variant="Variant.Text">내 정보로</MudButton>
</MudStack>

@code {
    private DriverRecommendationSettingsViewModel Model = default!;
    protected override void OnInitialized() => Model = new(Client);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender) { await Model.LoadAsync(); StateHasChanged(); } }
    public void Dispose() => Model.Dispose();
}
