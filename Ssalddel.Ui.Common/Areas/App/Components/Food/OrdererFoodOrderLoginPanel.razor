@using Ssalddel.Ui.Common.Areas.App.ViewModels

<div class="food-order-login-layout">
    <Ssalddel공통로그인Panel 제목="주문 내역 로그인"
                             설명="@(SessionExpired ? "로그인이 만료되었습니다. 다시 로그인해 주세요." : "주문한 계정으로 로그인해 주문 내역을 확인하세요.")"
                             상태메시지="@AuthenticationMessage"
                             상태Severity="@AuthenticationSeverity"
                             일반로그인표시="true"
                             소셜로그인표시="false"
                             일반로그인버튼텍스트="내 주문 확인"
                             IsBusy="@Authentication.처리중"
                             Elevation="0"
                             Class="food-order-login-card"
                             OnPasswordLogin="LoginRequested" />

    <MudPaper Elevation="0" Outlined="true" Class="food-order-login-note">
        <MudIcon Icon="@Icons.Material.Filled.PrivacyTip" Color="Color.Info" Size="Size.Large" />
        <MudText Typo="Typo.h6">음식점과 메뉴 둘러보기</MudText>
        <MudText Typo="Typo.body2">
            로그인 없이 메뉴를 둘러볼 수 있습니다.
        </MudText>
        <MudButton Href="/food/restaurants" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Storefront">
            음식점 보기
        </MudButton>
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired]
    public 주문자앱인증ViewModel Authentication { get; set; } = default!;

    [Parameter]
    public bool SessionExpired { get; set; }

    [Parameter]
    public EventCallback<공통로그인요청> LoginRequested { get; set; }

    private Severity AuthenticationSeverity
        => Authentication.오류발생 ? Severity.Error : Severity.Info;

    private string? AuthenticationMessage
        => !Authentication.오류발생 ? null : Authentication.오류 switch
        {
            { 코드: "transport-failure" or "timeout" } or { Http상태코드: >= 500 or 429 }
                => OrdererFoodOrderPresentation.ErrorMessage(Authentication.오류),
            { Http상태코드: 403 } => "주문할 때 사용한 계정으로 로그인해 주세요.",
            _ => "아이디와 비밀번호를 확인한 뒤 다시 로그인해 주세요."
        };
}
