@using Ssalddel.Ui.Common.Areas.App.ViewModels
@using Ssalddel.Contracts.Food

<MudPaper Elevation="0" Outlined="true" Class="food-order-panel">
    @if (Detail.처리중)
    {
        <div class="food-order-state">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2">주문 상세를 불러오고 있습니다.</MudText>
        </div>
    }
    else if (Detail.오류발생)
    {
        <div class="food-order-state">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2">주문 상세를 불러오지 못했습니다.</MudText>
            <MudText Typo="Typo.body2">@OrdererFoodOrderPresentation.ErrorMessage(Detail.오류)</MudText>
            @if (!string.IsNullOrWhiteSpace(Detail.요청OrderNo))
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="@(() => RetryRequested.InvokeAsync(Detail.요청OrderNo!))">
                    다시 시도
                </MudButton>
            }
        </div>
    }
    else if (Detail.찾을수없음)
    {
        <div class="food-order-state">
            <MudIcon Icon="@Icons.Material.Filled.NoAccounts" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2">이 계정의 음식 주문을 찾을 수 없습니다.</MudText>
            <MudText Typo="Typo.body2">주문번호와 로그인한 계정을 확인해 주세요.</MudText>
        </div>
    }
    else if (Detail.상세 is { } detail)
    {
        <div class="food-order-detail-heading">
            <div>
                <MudText Typo="Typo.h6">@detail.주문.주문번호</MudText>
                <MudText Typo="Typo.body2">
                    @OrdererFoodOrderPresentation.RestaurantLabel(detail.주문) · @detail.주문.상품요약
                </MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           OnClick="CloseRequested"
                           aria-label="주문 상세 닫기" />
        </div>

        <div class="food-order-detail-summary">
            <MudChip T="string"
                     Color="@OrdererFoodOrderPresentation.StatusColor(detail.주문.상태)"
                     Variant="Variant.Filled">
                @detail.주문.상태
            </MudChip>
            <span>@($"{detail.주문.총주문금액:N0}원")</span>
        </div>

        @if (Cancellation is not null)
        {
            <OrdererFoodOrderCancellationPanel Cancellation="Cancellation"
                                               CancellationRequested="CancellationRequested" />
        }

        <SsalddelSensitiveDisclosureList Title="내 음식 주문 상세"
                                         Icon="@Icons.Material.Filled.ReceiptLong"
                                         Color="Color.Primary"
                                         PrivacyHint="수령지와 연락처는 주문한 계정에서 필요할 때만 펼쳐 확인합니다.">
            <MudExpansionPanel Text="주문 상품" Expanded="true">
                @foreach (var item in detail.상품목록)
                {
                    <div class="food-order-line-item">
                        <span>@item.상품명</span>
                        <span>@($"{item.수량:N0}개 × {item.단가:N0}원")</span>
                    </div>
                }
                <SsalddelSensitiveInfoRow Label="결제 수단" Value="@OrdererFoodOrderPresentation.ValueOrDash(detail.결제수단)" />
                <SsalddelSensitiveInfoRow Label="주문 시각" Value="@OrdererFoodOrderPresentation.FormatDate(detail.주문.CreatedAtUtc)" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="수령 정보">
                <SsalddelSensitiveInfoRow Label="수령인" Value="@OrdererFoodOrderPresentation.ValueOrDash(detail.수령인정보.수령인명)" />
                <SsalddelSensitiveInfoRow Label="연락처" Value="@OrdererFoodOrderPresentation.ValueOrDash(detail.수령인정보.연락처)" />
                <SsalddelSensitiveInfoRow Label="수령지" Value="@OrdererFoodOrderPresentation.Address(detail.수령인정보.주소, detail.수령인정보.상세주소)" />
                <SsalddelSensitiveInfoRow Label="요청사항" Value="@OrdererFoodOrderPresentation.ValueOrDash(detail.수령인정보.요청사항)" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="음식점 처리">
                <SsalddelSensitiveInfoRow Label="음식점" Value="@OrdererFoodOrderPresentation.RestaurantLabel(detail.주문)" />
                <SsalddelSensitiveInfoRow Label="음식점 주소" Value="@OrdererFoodOrderPresentation.Address(detail.음식점주소, detail.음식점상세주소)" />
                <SsalddelSensitiveInfoRow Label="수락 시각" Value="@OrdererFoodOrderPresentation.FormatOptionalDate(detail.음식점수락시각Utc)" />
                <SsalddelSensitiveInfoRow Label="조리 예상 완료" Value="@OrdererFoodOrderPresentation.FormatOptionalDate(detail.주문.조리예상완료시각Utc)" />
                <SsalddelSensitiveInfoRow Label="수락 메모" Value="@OrdererFoodOrderPresentation.ValueOrDash(detail.수락메모)" />
            </MudExpansionPanel>
            <MudExpansionPanel Text="배달 진행" Expanded="@detail.배달진행.배차요청됨">
                <MudAlert Severity="@OrdererFoodOrderPresentation.DeliverySeverity(detail.배달진행)"
                          Variant="Variant.Outlined"
                          Dense="true">
                    @detail.배달진행.안내
                </MudAlert>
                @if (OrdererFoodOrderPresentation.NeedsDeliveryRecovery(detail.배달진행))
                {
                    <MudAlert Severity="Severity.Warning"
                              Variant="Variant.Filled"
                              Dense="true">
                        @OrdererFoodOrderPresentation.DeliveryRecoveryGuide(detail.배달진행)
                    </MudAlert>
                }
                <SsalddelSensitiveInfoRow Label="최근 변경" Value="@OrdererFoodOrderPresentation.FormatOptionalDate(detail.배달진행.최근변경시각Utc)" />
                @if (detail.기사위치.상태 == 음식배달위치추적상태코드.갱신지연)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                        기사 위치 확인이 지연되고 있습니다. 배달 진행 상태를 확인해 주세요.
                    </MudAlert>
                }
                <div class="food-order-receipt-steps" aria-label="전달과 수령 확인 단계">
                    <div class="food-order-receipt-step @(detail.배달진행.기사전달완료 ? "food-order-receipt-step--done" : string.Empty)">
                        <MudIcon Icon="@(detail.배달진행.기사전달완료 ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)"
                                 Color="@(detail.배달진행.기사전달완료 ? Color.Success : Color.Default)"
                                 Size="Size.Small" />
                        <span>
                            <strong>1. 기사 전달 완료</strong>
                            <small>@(detail.배달진행.기사전달완료 ? "기사가 전달 완료를 기록했습니다." : "기사의 전달 완료를 기다리고 있습니다.")</small>
                        </span>
                    </div>
                    <div class="food-order-receipt-step @(detail.배달진행.주문자수령확인됨 ? "food-order-receipt-step--done" : string.Empty)">
                        <MudIcon Icon="@(detail.배달진행.주문자수령확인됨 ? Icons.Material.Filled.Verified : Icons.Material.Outlined.RadioButtonUnchecked)"
                                 Color="@(detail.배달진행.주문자수령확인됨 ? Color.Success : Color.Default)"
                                 Size="Size.Small" />
                        <span>
                            <strong>2. 주문자 수령 확인</strong>
                            <small>
                                @(detail.배달진행.주문자수령확인됨
                                    ? $"확인 {OrdererFoodOrderPresentation.FormatOptionalDate(detail.배달진행.수령확인시각Utc)}"
                                    : "실제 음식을 받은 뒤 주문자가 직접 확인합니다.")
                            </small>
                        </span>
                    </div>
                </div>

                @if (Detail.수령확인가능)
                {
                    <div class="food-order-receipt-action">
                        <MudTextField T="string"
                                      @bind-Value="Detail.수령확인메모"
                                      Label="수령 확인 메모 (선택)"
                                      Placeholder="예: 문 앞에서 정상 수령"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      MaxLength="500"
                                      Counter="500"
                                      Lines="2" />
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                            음식을 받은 뒤 수령 확인을 눌러 주세요.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Verified"
                                   Disabled="@Detail.처리중"
                                   OnClick="ReceiptConfirmationRequested">
                            음식 수령 확인
                        </MudButton>
                    </div>
                }

                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           Disabled="@Detail.처리중"
                           OnClick="@(() => RefreshRequested.InvokeAsync(detail.주문.주문번호))">
                    진행 상태 새로고침
                </MudButton>
            </MudExpansionPanel>
            <MudExpansionPanel Text="주문 진행 기록">
                @if (detail.상태이력.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">아직 진행 기록이 없습니다.</MudText>
                }
                else
                {
                    @foreach (var transition in detail.상태이력)
                    {
                        <div class="food-order-history-item">
                            <span>@($"{OrdererFoodOrderPresentation.ValueOrDash(transition.이전상태)} → {transition.다음상태}")</span>
                            <span>
                                @OrdererFoodOrderPresentation.FormatDate(transition.전이시각Utc) · @OrdererFoodOrderPresentation.ValueOrDash(transition.사유)
                            </span>
                        </div>
                    }
                }
            </MudExpansionPanel>
        </SsalddelSensitiveDisclosureList>
    }
    else
    {
        <div class="food-order-state">
            <MudIcon Icon="@Icons.Material.Filled.TouchApp" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2">목록에서 주문을 선택해 주세요.</MudText>
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public 주문자음식주문상세ViewModel Detail { get; set; } = default!;

    [Parameter]
    public EventCallback<string> RetryRequested { get; set; }

    [Parameter]
    public EventCallback<string> RefreshRequested { get; set; }

    [Parameter]
    public EventCallback ReceiptConfirmationRequested { get; set; }

    [Parameter]
    public 주문자음식주문취소ViewModel? Cancellation { get; set; }

    [Parameter]
    public EventCallback CancellationRequested { get; set; }

    [Parameter]
    public EventCallback CloseRequested { get; set; }
}
