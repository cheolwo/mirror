@namespace Ssalddel.Ui.Common.Areas.App.Components.Food
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<MudPaper Elevation="0" Outlined="true" Class="food-order-composer">
    <div class="food-order-composer__heading">
        <div>
            <MudText Typo="Typo.overline">ORDER CHECK</MudText>
            <MudText Typo="Typo.h6">선택 메뉴와 수령 정보 확인</MudText>
        </div>
        <MudChip T="string"
                 Size="Size.Small"
                 Color="@(Writer.최소주문충족 ? Color.Success : Color.Warning)">
            @Writer.주문금액.ToString("N0")원
        </MudChip>
    </div>

    @if (!Writer.메뉴선택됨)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            위 메뉴의 더하기 버튼으로 주문 수량을 선택해 주세요.
        </MudAlert>
    }
    else
    {
        <div class="food-order-composer__items">
            @foreach (var item in Writer.선택항목목록)
            {
                <div>
                    <span>@item.메뉴명 × @item.수량</span>
                    <strong>@item.합계.ToString("N0")원</strong>
                </div>
            }
        </div>
    }

    <div class="food-order-composer__minimum">
        <span>최소 주문 @Writer.최소주문금액.ToString("N0")원</span>
        <strong class="@(Writer.최소주문충족 ? "is-ready" : null)">
            @(Writer.최소주문충족
                ? "주문 가능 금액"
                : $"{Math.Max(0, Writer.최소주문금액 - Writer.주문금액):N0}원 더 필요")
        </strong>
    </div>

    @if (Authentication.처리중)
    {
        <div class="food-order-composer__state">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.body2">주문자 로그인 상태를 확인하고 있습니다.</MudText>
        </div>
    }
    else if (!Authentication.초기화됨 || !Authentication.로그인됨 || Writer.재로그인필요)
    {
        @if (Authentication.오류발생)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                @Authentication.오류메시지
            </MudAlert>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Login"
                   OnClick="AuthenticationRequested">
            로그인하고 주문 계속
        </MudButton>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Text" Dense="true">
            @Authentication.현재사용자표시 계정으로 주문합니다. 메뉴명과 금액은 제출 시 서버의 최신 공개 메뉴를 기준으로 다시 계산합니다.
        </MudAlert>

        <div class="food-order-composer__form">
            <MudTextField @bind-Value="Writer.수령인명"
                          Label="수령인 이름"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Disabled="@Writer.처리중" />
            <MudTextField @bind-Value="Writer.연락처"
                          Label="수령인 연락처"
                          Variant="Variant.Outlined"
                          InputType="InputType.Telephone"
                          Immediate="true"
                          Disabled="@Writer.처리중" />
            <MudTextField @bind-Value="Writer.주소"
                          Label="배달 주소"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Disabled="@Writer.처리중"
                          Class="food-order-composer__wide" />
            <MudTextField @bind-Value="Writer.상세주소"
                          Label="상세 주소"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Disabled="@Writer.처리중" />
            <MudTextField @bind-Value="Writer.요청사항"
                          Label="전달 요청사항"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Immediate="true"
                          Disabled="@Writer.처리중" />
        </div>

        <MudCheckBox T="bool"
                     @bind-Value="Writer.주문자본인수령여부"
                     Color="Color.Primary"
                     Disabled="@Writer.처리중">
            주문자 본인이 수령합니다.
        </MudCheckBox>

        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
            현재 결제 방식은 현장결제 메모만 저장하며 온라인 결제 승인을 만들지 않습니다. 운영 결제 연동 전까지 결제 완료로 표시하지 않습니다.
        </MudAlert>

        @if (Writer.오류발생)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                @Writer.오류메시지
            </MudAlert>
        }

        <div class="food-order-composer__actions">
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       Disabled="@Writer.처리중"
                       OnClick="@(() => Writer.새요청준비(clearRecipient: false))">
                메뉴 다시 선택
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       Disabled="@(!Writer.제출가능)"
                       OnClick="SubmitRequested">
                @(Writer.처리중 ? "서버 확인 중" : "주문 제출")
            </MudButton>
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public 주문자앱인증ViewModel Authentication { get; set; } = null!;

    [Parameter, EditorRequired]
    public 음식주문작성ViewModel Writer { get; set; } = null!;

    [Parameter]
    public EventCallback AuthenticationRequested { get; set; }

    [Parameter]
    public EventCallback SubmitRequested { get; set; }
}
