@namespace Ssalddel.Ui.Common.Areas.App.Components.Commerce
@using Ssalddel.Contracts.Common.Commerce
@using Ssalddel.Ui.Common.Areas.App.ViewModels.Commerce
@inject 판매자공개정보ViewModel Model
@implements IDisposable
<section class="commerce-seller-public" aria-label="계약 판매자 정보">
    <h3>판매자 정보</h3>
    @if (Model.IsLoading) { <p role="status">판매자 정보를 확인하고 있습니다.</p> }
    else if (Model.Error is not null) { <p role="alert">@Model.Error</p> }
    else if (Model.Value is { StatusCode: "Verified" } value)
    {
        <p><strong>@value.DisplayName</strong> · @(value.SellerKind == 판매자유형Codes.사업자 ? "사업자 판매자" : "개인 판매자") · 확인 완료</p>
        @if (value.SellerKind == 판매자유형Codes.사업자)
        { <dl><dt>대표자</dt><dd>@value.RepresentativeName</dd><dt>사업장 주소</dt><dd>@value.BusinessAddress</dd><dt>연락처</dt><dd>@value.PhoneNumber · @value.Email</dd><dt>사업자등록번호</dt><dd>@value.BusinessRegistrationNumber</dd><dt>통신판매 신고</dt><dd>@(value.MailOrderRegistrationNumber ?? value.MailOrderRegistrationExemptionReason)</dd></dl> }
        else { <p>개인 판매자의 주소·전화번호·실명은 공개하지 않습니다.</p> }
    }
    else { <p role="status">판매자 신원 확인이 완료되지 않았습니다. 공개 거래 운영 전 확인이 필요합니다.</p> }
    <button type="button" disabled="@(Disabled || Model.IsLoading)" @onclick="Reload">판매자 정보 다시 확인</button>
</section>
@code {
    [Parameter] public string? SellerId { get; set; }
    [Parameter] public long? RestaurantId { get; set; }
    [Parameter] public long? PostId { get; set; }
    [Parameter] public string? CollaborationId { get; set; }
    [Parameter] public EventCallback<판매자공개정보Response?> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private string? _target;
    protected override void OnInitialized() => Model.PropertyChanged += Changed;
    protected override Task OnParametersSetAsync() { var target = !string.IsNullOrWhiteSpace(CollaborationId) ? "collaboration:" + CollaborationId : PostId is > 0 ? "post:" + PostId : RestaurantId is > 0 ? "restaurant:" + RestaurantId : SellerId; if (_target == target) return Task.CompletedTask; _target = target; return Reload(); }
    private async Task Reload()
    {
        var target = _target;
        await ValueChanged.InvokeAsync(null);
        await Model.LoadAsync(SellerId, RestaurantId, PostId, CollaborationId);
        if (_target == target && !Model.IsLoading) await ValueChanged.InvokeAsync(Model.Value is { StatusCode: "Verified" } value ? value : null);
    }
    private void Changed(object? sender, System.ComponentModel.PropertyChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Model.PropertyChanged -= Changed; Model.Dispose(); }
}
