@namespace Ssalddel.Ui.Common.Areas.App.Components.Commerce
@using Ssalddel.Contracts.Common.Commerce
@using Ssalddel.Ui.Common.Areas.App.ViewModels.Commerce
@inject 판매자확인ViewModel Model
@inject NavigationManager Navigation
@implements IDisposable
@{ Model.SynchronizeOwner(); }
<CommercePageFrame Title="판매자 확인" Description="판매자 유형과 정보를 등록하고 확인 상태를 살펴보세요.">
    @if (!Model.IsAuthenticated) { <section><h2>로그인이 필요해요</h2><p>본인의 판매자 정보만 등록하고 확인합니다.</p><a href="@LoginHref">로그인하기</a></section> }
    else
    {
        @if (Model.IsLoading) { <p role="status">확인 상태를 불러오고 있습니다.</p> }
        @if (Model.Error is not null) { <div class="commerce-error" role="alert">@Model.Error<button disabled="@Model.IsSending" @onclick="Model.LoadAsync">상태 다시 확인</button></div> }
        @if (Model.Notice is not null) { <p role="status">@Model.Notice</p> }
        @if (Model.Value is { } value)
        {
            <section><h2>@(value.StatusCode == "Verified" ? "확인 완료" : "판매자 확인 필요")</h2><p>@(value.SellerKind == 판매자유형Codes.사업자 ? "사업자 판매자" : value.SellerKind == 판매자유형Codes.개인 ? "개인 판매자" : "유형 미확인") · @(string.IsNullOrWhiteSpace(value.DisplayName) ? "표시명 미등록" : value.DisplayName)</p>
                <p>전화번호: @(value.PhoneVerified ? "확인됨" : "미확인") · 이메일: @(value.EmailVerified ? "확인됨" : "미확인")</p><p>만 19세 이상 여부: @(value.IsAdult ? "확인됨" : "미확인")</p>
                @if (value.MissingRequirements.Count > 0) { <p class="commerce-warning">확인할 조건: @string.Join(" · ", value.MissingRequirements)</p> }
                <p class="commerce-note">정보 등록과 본인확인은 별도입니다. 거래 가능 여부는 서버의 확인 상태에 따라 결정됩니다.</p>
                @if (Model.Policy?.IsOperationalReady != true) { <p class="commerce-note">현재 거래에 필요한 운영 설정을 준비하고 있습니다. 정보 등록만으로 거래할 수는 없습니다.</p> }
            </section>
        }
        @if (Model.Policy is { } policy)
        {
            <form @onsubmit="Model.SaveAsync" @onsubmit:preventDefault><section><h2>판매자 정보 등록</h2><fieldset disabled="@(Model.IsSending || Model.HasPending)">
                <label for="seller-kind">판매자 유형</label><select id="seller-kind" @bind="Model.Draft.SellerKind"><option value="Individual">개인</option><option value="Business">사업자</option></select>
                <label for="seller-name">표시 이름</label><input id="seller-name" @bind="Model.Draft.DisplayName" maxlength="120" required />
                <label for="seller-phone">전화번호</label><input id="seller-phone" type="tel" @bind="Model.Draft.PhoneNumber" maxlength="40" required />
                <label for="seller-email">이메일</label><input id="seller-email" type="email" @bind="Model.Draft.Email" maxlength="256" required />
                @if (Model.Draft.SellerKind == 판매자유형Codes.사업자)
                {
                    <label for="seller-representative">대표자 이름</label><input id="seller-representative" @bind="Model.Draft.RepresentativeName" maxlength="120" required />
                    <label for="seller-address">사업장 주소</label><textarea id="seller-address" @bind="Model.Draft.BusinessAddress" maxlength="500" required rows="2"></textarea>
                    <label for="seller-registration">사업자등록번호</label><input id="seller-registration" @bind="Model.Draft.BusinessRegistrationNumber" maxlength="40" required />
                    <label for="seller-mail-order">통신판매 신고번호</label><input id="seller-mail-order" @bind="Model.Draft.MailOrderRegistrationNumber" maxlength="120" />
                    <label for="seller-exemption">신고 면제 사유 <small>해당하는 경우</small></label><textarea id="seller-exemption" @bind="Model.Draft.MailOrderRegistrationExemptionReason" maxlength="500" rows="2"></textarea>
                }
                <p>@policy.IntermediaryNotice</p><a href="@Navigation.ToAbsoluteUri("commerce/notices")">수집·이용 및 공개 범위 안내</a>
                <label class="commerce-check"><input type="checkbox" @bind="Model.Draft.CollectionConsentAccepted" /><span>안내를 확인하고 판매자 확인을 위한 정보 수집·이용에 동의합니다.</span></label>
            </fieldset><button class="commerce-primary" type="submit" disabled="@(Model.IsSending || !Model.Draft.CollectionConsentAccepted)">@(Model.IsSending ? "저장 중…" : Model.HasPending ? "같은 등록 요청 다시 확인" : "판매자 정보 저장")</button></section></form>
        }
    }
</CommercePageFrame>
@code {
    [Parameter] public string LoginHref { get; set; } = "/login?returnUrl=%2Fcommerce%2Fseller";
    protected override async Task OnInitializedAsync() { Model.PropertyChanged += Changed; await Model.LoadAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { Model.SynchronizeOwner(); if (Model.IsAuthenticated && !Model.Loaded && !Model.IsLoading && !Model.IsSending && Model.Error is null) await Model.LoadAsync(); }
    private void Changed(object? sender, System.ComponentModel.PropertyChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Model.PropertyChanged -= Changed; Model.Dispose(); }
}
