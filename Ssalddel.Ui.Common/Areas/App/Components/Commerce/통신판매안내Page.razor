@namespace Ssalddel.Ui.Common.Areas.App.Components.Commerce
@using Ssalddel.Ui.Common.Areas.App.ViewModels.Commerce
@inject 통신판매안내ViewModel Model
@implements IDisposable
<CommercePageFrame Title="거래·개인정보 안내" Description="이용 기준과 정보 처리 방식, 문의할 곳을 확인하세요.">
    @if (Model.IsLoading) { <p role="status">안내를 불러오고 있습니다.</p> }
    else if (Model.Error is not null) { <div class="commerce-error" role="alert">@Model.Error<button @onclick="Model.LoadAsync">다시 불러오기</button></div> }
    else if (Model.Value is { } value)
    {
        <section aria-labelledby="commerce-notice"><h2 id="commerce-notice">거래 중개 안내</h2><p>@value.IntermediaryNotice</p><p class="commerce-note">안내 버전: @value.Version</p>
            @if (!value.IsOperationalReady) { <p class="commerce-warning" role="status">공개 거래 운영에 필요한 준비가 아직 완료되지 않았습니다. 안내를 읽는 것과 실제 거래 이용은 별도입니다.</p> }
        </section>
        @foreach (var document in value.Documents)
        {
            <details data-document="@document.Code"><summary>@document.Title</summary>@foreach (var section in document.Sections) { <h3>@section.Title</h3><p>@section.Text</p> }</details>
        }
        <section><h2>운영자와 문의</h2><dl><dt>상호·대표자</dt><dd>@Show(value.OperatorInfo.상호) · @Show(value.OperatorInfo.대표자)</dd><dt>주소</dt><dd>@Show(value.OperatorInfo.주소)</dd><dt>전화·이메일</dt><dd>@Show(value.OperatorInfo.전화번호)<br />@Show(value.OperatorInfo.이메일)</dd><dt>사업자등록번호</dt><dd>@Show(value.OperatorInfo.사업자등록번호)</dd><dt>개인정보 담당 연락처</dt><dd>@Show(value.OperatorInfo.개인정보담당연락처)</dd></dl></section>
        <nav aria-label="본인 처리 요청"><a href="commerce/seller">판매자 확인</a><a href="commerce/privacy">내 정보 관리</a><a href="commerce/disputes">거래 문제 신고</a></nav>
    }
</CommercePageFrame>
@code {
    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "등록 준비 중" : value;
    protected override async Task OnInitializedAsync() { Model.PropertyChanged += Changed; await Model.LoadAsync(); }
    private void Changed(object? sender, System.ComponentModel.PropertyChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Model.PropertyChanged -= Changed; Model.Dispose(); }
}
