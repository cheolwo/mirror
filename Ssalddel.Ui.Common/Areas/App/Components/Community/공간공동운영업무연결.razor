@namespace Ssalddel.Ui.Common.Areas.App.Components.Community
@using Ssalddel.Contracts.Common.Community
@using Ssalddel.Contracts.Common.Versioning
@using Ssalddel.Ui.Common.Areas.App.ViewModels

<section class="work-flow" aria-label="생산부터 정산까지 업무 연결도" data-testid="cooperation-work-flow">
    <header class="work-flow-heading"><h3>업무별로 확인하기</h3><p>업무를 누르면 상세 내용과 연락 가능한 업무 연락처를 확인해요.</p></header>
    @if (!flow.Available)
    {
        <p class="work-flow-note" role="status">@flow.Message</p>
    }
    else
    {
        <div class="work-flow-ledger" data-testid="work-flow-ledger">
        <header class="work-flow-ledger-heading"><span class="work-flow-eyebrow">통합 원장</span><h4>@Detail.Terms.Title</h4><p>회차별 주문과 업무 원장을 함께 살펴봐요.</p></header>
        <label class="work-flow-cycle">살펴볼 회차
            <select value="@flow.Cycle!.CycleId" @onchange="ChangeCycle">
                @foreach (var cycle in Snapshot.Cycles.OrderByDescending(item => item.Number))
                {
                    <option value="@cycle.CycleId">@(cycle.Number)번째 회차</option>
                }
            </select>
        </label>
        <section class="work-flow-cycle-scope" aria-label="선택 회차의 연결 업무">
        <header class="work-flow-scope-heading"><strong>@(flow.Cycle.Number)번째 회차</strong><span>연결 업무 @progress.LinkedSourceCount · @(Snapshot.OrdersReadStatusCode == "current" ? $"내 주문 {progress.LinkedOrderCount}" : "내 주문 확인 필요")</span></header>
        <section class="@($"work-flow-gate tone-{progress.GateTone}")" data-testid="work-flow-gate" aria-label="회차 시작 점검" role="status">
            <div class="work-flow-gate-title"><span class="work-flow-gate-icon" aria-hidden="true">@(progress.GateTone == "blocked" ? "Ⅱ" : progress.GateTone == "ready" ? "✓" : "i")</span><strong>@progress.GateTitle</strong></div>
            <p>@progress.GateMessage</p>
            @if (progress.MissingRoleCodes.Count > 0)
            { <p class="work-flow-missing">함께할 역할: @string.Join(" · ", progress.MissingRoleCodes.Select(공간공동운영Presentation.Role))</p><p class="work-flow-muted">역할 수락이 더 필요해요. 실제 업무 담당 배정은 원 업무에서 확인해요.</p> }
            @if (progress.Issues.Count > 0)
            {
                <details class="work-flow-reasons"><summary>보완할 내용 @(progress.Issues.Count)개</summary><ul>@foreach (var issue in progress.Issues) { <li>@issue.Message</li> }</ul><p>운영 담당자와 역할 수락·조건 동의·필수 약속·원장 연결을 확인해 주세요.</p></details>
            }
            @if (progress.CheckedAtUtc is { } checkedAt) { <small class="work-flow-muted">점검 시각 @checkedAt.ToLocalTime().ToString("MM.dd HH:mm")</small> }
        </section>
        @if (Snapshot.OrdersReadStatusCode != "current") { <p class="work-flow-note" role="status">@flow.Message</p> }
        <p class="work-flow-legend">절차 요약입니다. 연결 자료 수는 실제 완료 건수와 달라요.</p>
        <p class="work-flow-mobile-caption">보관 흐름과 주문은 피킹·출고에서 만나요.</p>
        <div class="work-flow-layout" aria-label="절차 선택">
            <svg class="work-flow-lines" viewBox="0 0 1000 394" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                <defs><marker id="@arrowId" markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M 0 0 L 7 3.5 L 0 7 z" /></marker></defs>
                @foreach (var path in GuidePaths)
                {
                    <path class="work-flow-guide-path" d="@path" marker-end="@($"url(#{arrowId})")" />
                }
            </svg>
            @foreach (var node in flow.Nodes)
            {
                var state = progress.Nodes.Single(item => item.StageKey == node.Stage.Key);
                <a class="@($"work-flow-node work-flow-{node.Stage.Key} tone-{state.Tone}")" href="@공간공동운영업무Routes.Detail(Detail.LedgerId, node.Stage.Key, flow.Cycle.CycleId)" data-testid="work-flow-node" data-stage="@node.Stage.Key">
                    <span class="work-flow-mobile-branch" aria-hidden="true"></span>
                    @if (state.Tone == "blocked") { <span class="work-flow-stop" aria-hidden="true">Ⅱ</span> }
                    <span class="work-flow-node-summary"><strong>@node.Stage.Title</strong><span class="work-flow-badge">@state.Label</span><span>@NodeSummary(node)</span>
                        @if (state.Issues.Count > 0) { <span class="work-flow-node-reason">@state.Issues[0].Message</span> }
                        @if (state.SourceLabels.Count > 0) { <span class="work-flow-source-labels">@string.Join(" · ", state.SourceLabels)</span> }
                        @if (state.RelatedOrderCount > 0) { <small>연결이 확인된 내 주문 @(state.RelatedOrderCount)건</small> }
                    </span>
                    <span class="work-flow-node-open" aria-hidden="true">›</span>
                </a>
            }
        </div>
        <section class="work-flow-result" data-testid="work-flow-settlement" aria-label="정산과 다음 회차">
            <span class="work-flow-eyebrow">이번 회차의 끝에서</span><h4>정산과 결과 확인</h4><p>@progress.SettlementLabel</p>
            @if (progress.PaymentReadyEvidenceCount > 0) { <p>지급 준비가 확인된 연결 정산 @(progress.PaymentReadyEvidenceCount)개</p> }
            <dl class="work-flow-result-steps"><div><dt>지급 준비</dt><dd>@(progress.PaymentReadyEvidenceCount > 0 ? "연결된 근거 확인" : "원 정산에서 확인")</dd></div><div><dt>실제 지급</dt><dd>원 정산에서 별도 확인</dd></div><div><dt>이익</dt><dd>수익·비용 근거 미연결</dd></div></dl>
            <a href="@공간공동운영업무Routes.Detail(Detail.LedgerId, "settlement", flow.Cycle.CycleId)">정산 근거 자세히 보기 ›</a>
            <p class="work-flow-muted">실제 수행·약정·비용을 대조해 정산해요. 지급 준비를 입금이나 이익으로 계산하지 않아요.</p>
        </section>
        <div class="work-flow-next-cycle"><span aria-hidden="true">↓</span><strong>결과를 살펴보고 다음 회차 준비</strong><p>부족한 역할과 조건을 보완해 다음 약속을 잡아요. 다음 회차는 운영 담당자가 따로 준비해요.</p></div>
        </section>
        </div>
        @if (flow.UnmappedSources.Count > 0)
        {
            <details class="work-flow-other"><summary>절차를 아직 분류하지 않은 연결 자료 (@flow.UnmappedSources.Count)</summary>@foreach (var source in flow.UnmappedSources) { <p>@source.Label · @공간공동운영업무연결Presentation.SourceStatus(source)</p> }</details>
        }
        <details class="work-flow-other"><summary>업무 영역 사이의 인계 안내</summary>
            <p class="work-flow-muted">기존에 정의한 인계 방식이에요. 이번 회차의 실제 인계 여부·담당·수락은 원 업무에서 확인해요.</p>
            @foreach (var interaction in OperatingSystemInteractionCatalog.GetAll())
            {
                <article class="work-flow-record"><strong>@OperatingSystemName(interaction.SourceOperatingSystemId) → @OperatingSystemName(interaction.TargetOperatingSystemId)</strong><p>@StageName(interaction.SourceOperatingSystemId, interaction.SourceLifecycleStageId) → @StageName(interaction.TargetOperatingSystemId, interaction.TargetLifecycleStageId)</p><p class="work-flow-muted">@interaction.Responsibility</p></article>
            }
        </details>
    }
</section>
