@namespace Ssalddel.Ui.Common.Areas.App.Components.Community
@using System.ComponentModel
@using Microsoft.Extensions.DependencyInjection
@using Ssalddel.Contracts.Common.Community
@using Ssalddel.Ui.Common.Areas.App.Services
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@implements IDisposable
@inject IServiceProvider Services

<main class="work-detail" data-testid="cooperation-work-detail">
    <a class="work-detail-back" href="@(model?.BackHref ?? 공간공동운영Routes.Home)">‹ 업무 요약으로</a>
    @if (model is null)
    {
        <h1>업무 상세</h1><p role="status">지금은 업무 상세를 확인할 수 없어요.</p>
    }
    else if (!Model.IsAuthenticated)
    {
        <h1>업무 상세</h1><p>로그인한 계정에서 이 업무의 상세 내용을 확인해 주세요.</p><a class="work-detail-primary" href="@LoginHref">로그인하기</a>
    }
    else
    {
        @if (Model.IsLoading) { <h1>업무 상세</h1><p role="status">선택한 업무를 확인하고 있어요.</p> }
        @if (Model.Error is { } error) { <p class="work-detail-note" role="alert">@error</p> }
        @if (!Model.IsLoading && Model.Node is null) { <h1>업무 상세</h1><button type="button" @onclick="ReloadAsync">다시 불러오기</button> }
        @if (Model.IsCurrentView && Model.Node is { } node && Model.Detail is { } detail)
        {
            <header class="work-detail-heading"><div><p class="work-detail-muted">@detail.Terms.Title · @(Model.Flow.Cycle!.Number)번째 회차</p><h1>@node.Stage.Title</h1></div><button type="button" disabled="@(Model.IsLoading || Model.IsLoadingContacts || Model.IsOpeningDialer)" @onclick="ReloadAsync">새로고침</button></header>
            @if (detail.ExecutionMode == "Simulation") { <p class="work-detail-note">시험 자료 · 실제 작업이나 지급 실적이 아니에요.</p> }
            @if (Model.Progress.Nodes.FirstOrDefault(item => item.StageKey == node.Stage.Key) is { Issues.Count: > 0 } stage)
            {
                <section class="work-detail-blocked" data-testid="work-detail-blocked" aria-label="시작 전 보완할 내용"><h2>Ⅱ 시작 전 보완이 필요해요</h2><ul>@foreach (var issue in stage.Issues) { <li>@issue.Message</li> }</ul><p>운영 담당자와 이 회차에 연결할 원 업무와 동의 상태를 확인해 주세요.</p><a class="work-detail-link" href="@Model.BackHref">같은 회차의 역할·원장 연결 확인 ›</a></section>
            }
            @if (node.Stage.Key == "settlement")
            {
                <section class="work-detail-section" aria-label="정산 확인 범위"><h2>정산에서 확인할 결과</h2><p>@Model.Progress.SettlementLabel</p><p>실제 수행과 약정, 수익·비용을 원 정산에서 대조해요. 현재 연결 자료로 실입금이나 이익 금액은 확인되지 않아요.</p><p class="work-detail-muted">지급 준비 확인 뒤에도 실제 지급 확인은 별도예요. 다음 회차는 이번 결과를 살펴본 뒤 따로 준비해요.</p></section>
            }
            <section aria-label="현재 업무 자료" class="work-detail-section">
                <h2>현재 연결된 업무</h2>
                @if (node.Orders.Count == 0 && node.Sources.Count == 0) { <p>현재 연결한 자료가 없어요. 이 절차를 수행하지 않았다는 뜻은 아니에요.</p> }
                @if (node.Stage.Key == "order" && Model.Snapshot?.OrdersReadStatusCode != "current") { <p class="work-detail-note" role="status">주문 자료를 현재 확인하지 못했어요. 새로고침해 다시 확인해 주세요.</p> }
                @foreach (var order in node.Orders)
                {
                    <article class="work-detail-record" data-testid="work-detail-order"><h3>@order.ProductName</h3><p>@공간공동운영업무연결Presentation.OrderStatus(order.AgreementStatusCode)</p><p class="work-detail-muted">@공간공동운영업무연결Presentation.RootStatus(order.RootReadStatusCode)</p></article>
                }
                @foreach (var source in node.Sources)
                {
                    <article class="work-detail-record" data-testid="work-detail-source"><h3>@source.Label</h3><p>@공간공동운영업무연결Presentation.SourceStatus(source)</p>
                        @foreach (var order in LinkedOrders(source)) { <p class="work-detail-muted">함께 연결된 내 주문: @order.ProductName</p> }
                        @if (source.Verified && 공간공동운영Presentation.SafeWorkHref(source.Href) is { } href) { <a class="work-detail-link" href="@href">원 업무에서 이어서 확인</a> }
                    </article>
                }
            </section>
            <section aria-label="업무 담당·현장 연락처" class="work-detail-section" data-testid="work-detail-contacts">
                <h2>업무 연락처</h2><p class="work-detail-muted">기존 업무에서 내 권한으로 확인할 수 있는 담당·현장 연락처만 보여요.</p>
                @if (!node.Sources.Any(source => source.Verified))
                { <p>연락처를 확인할 수 있는 업무가 아직 연결되지 않았어요.</p> }
                else
                {
                    <button type="button" disabled="@(!Model.CanReadContacts)" @onclick="Model.ReadContactsAsync">@(Model.Contacts is null ? "등록된 업무 연락처 확인" : "연락처 다시 확인")</button>
                }
                @if (Model.IsLoadingContacts) { <p role="status">현재 업무의 연락처를 확인하고 있어요.</p> }
                @if (Model.ContactError is { } contactError) { <p class="work-detail-note" role="alert">@contactError</p> }
                @if (Model.Contacts is { } contacts)
                {
                    @if (contacts.Contacts.Count == 0) { <p role="status">@ContactStatus(contacts.StatusCode)</p> }
                    @foreach (var contact in contacts.Contacts)
                    {
                        <article class="work-detail-record" data-testid="work-detail-contact"><h3>@contact.Label</h3>
                            @if (!string.IsNullOrWhiteSpace(contact.DisplayName)) { <p>@contact.DisplayName</p> }
                            @if (업무전화번호Policy.TryNormalize(contact.PhoneNumber, out var number)) { <p class="work-detail-number">@number</p> }
                            else { <p class="work-detail-note">등록된 전화번호 형식을 확인해 주세요.</p> }
                            <button class="work-detail-primary" type="button" disabled="@(!Model.CanOpen(contact))" @onclick="() => Model.OpenDialerAsync(contact.ContactKey)">전화 앱에 번호 입력</button>
                            @if (!Model.DialerSupported) { <p class="work-detail-muted">전화 앱 연결은 지원되는 휴대폰 앱에서 이용할 수 있어요.</p> }
                        </article>
                    }
                }
                @if (Model.Notice is { } notice) { <p class="work-detail-note" role="status">@notice</p> }
                <p class="work-detail-muted">전화 앱의 번호 입력창만 열어요. 통화 버튼은 직접 선택해 주세요.</p>
            </section>
            <section class="work-detail-section" aria-label="업무 절차 안내"><h2>이 업무에서 확인할 내용</h2>
                <dl><div><dt>관련 역할</dt><dd>@node.Stage.Roles</dd></div><div><dt>넘겨받을 내용</dt><dd>@node.Stage.Input</dd></div><div><dt>다음 업무에 넘길 내용</dt><dd>@node.Stage.Result</dd></div></dl>
                <p class="work-detail-note">@node.Stage.Boundary</p><p class="work-detail-muted">관련 역할 안내는 실제 담당 배정과 달라요. 업무 시작과 완료는 원 업무에서 확인해요.</p>
                <nav class="work-detail-neighbours" aria-label="관련 절차 상세">
                    @foreach (var key in node.Stage.PreviousKeys.Concat(node.Stage.NextKeys).Distinct(StringComparer.Ordinal))
                    { <a class="work-detail-link" href="@공간공동운영업무Routes.Detail(LedgerId!, key, CycleId!)">@StageTitle(key) 상세 ›</a> }
                </nav>
            </section>
            <a class="work-detail-back" href="@Model.BackHref">‹ 같은 회차의 업무 요약으로</a>
        }
        else if (!Model.IsLoading && Model.Node is not null) { <p role="status">계정이나 서버가 바뀌었어요. 다시 불러와 주세요.</p><button type="button" @onclick="ReloadAsync">다시 불러오기</button> }
    }
</main>
