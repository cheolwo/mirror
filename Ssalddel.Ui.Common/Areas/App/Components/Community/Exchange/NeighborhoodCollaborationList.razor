@inherits NeighborhoodWorkflowPageBase<NeighborhoodCollaborationQueryViewModel>
@{ Model.SynchronizeOwner(); }
<NeighborhoodDeliveryFrame><main class="exchange-page">
    @if (!Embedded) { <a class="exchange-back" href="@Href(NeighborhoodMapNavigation.SafeReturn(ReturnUrl) ?? NeighborhoodMapNavigation.Home)">← 생활 지도</a> }
    <header><span class="exchange-eyebrow">생활 교류</span><h1>내 할 일</h1><p>신청한 일과 받은 요청의 약속·진행을 확인해요.</p></header>
    @if (!Model.IsAuthenticated) { <section class="exchange-empty"><h2>로그인이 필요해요</h2><a class="exchange-primary" href="@LoginHref">로그인하기</a></section> }
    else
    {
        <nav class="exchange-tabs" aria-label="협업 구분"><button aria-pressed="@(Model.Scope == "requested")" @onclick="Requested">내가 신청한 일</button><button aria-pressed="@(Model.Scope == "undertaken")" @onclick="Undertaken">받은 요청·맡은 일</button></nav>
        @if (Model.HasPending) { <section class="exchange-surface"><h2>처리 결과 확인이 필요해요</h2><p>자동으로 다시 보내지 않습니다. 먼저 이전 요청 결과를 확인하세요.</p><button disabled="@Model.IsSending" @onclick="Recover">처리 결과 확인</button></section> }
        @if (Model.Notice is not null) { <p role="status" class="exchange-note">@Model.Notice</p> }
        @if (Model.IsLoading) { <p role="status">할 일을 불러오는 중입니다.</p> }
        else if (Model.Error is not null) { <div class="exchange-error" role="alert">@Model.Error<button @onclick="Reload">다시 불러오기</button></div> }
        else if (Model.Loaded && Model.Items.Count == 0) { <section class="exchange-empty"><h2>이 구분에 해당하는 일이 없어요</h2><p>생활 교류 글이나 보관공간에서 필요한 일을 신청할 수 있어요.</p><a href="@Href(NeighborhoodMapNavigation.SafeReturn(ReturnUrl) is { } home ? NeighborhoodMapNavigation.PanelHref(home, null) : NeighborhoodExchange.Home)">생활 교류 둘러보기</a></section> }
        else { <section class="exchange-list" aria-label="내 협업 목록">@foreach (var item in Model.Items) { <a class="exchange-row" href="@Href(PanelHref("work", item.StableId, NeighborhoodCollaborationRoutes.Detail(item.StableId)))"><span class="exchange-kind">@NeighborhoodCollaborationPresentation.Stage(item.StatusCode)</span><h2>@(item.Terms?.Summary ?? item.SourceTitle)</h2><p>@NeighborhoodCollaborationPresentation.Kind(item.Kind) · @(item.IsRequester ? "신청한 일" : "받은 요청·맡은 일")</p><small>@item.UpdatedAtUtc.ToLocalTime().ToString("MM.dd HH:mm")</small></a> }</section> }
        @if (!Model.IsLoading && Model.Error is null && (Model.Page > 1 || Model.HasMore)) { <nav class="exchange-pagination"><button disabled="@(Model.Page <= 1)" @onclick="() => LoadList(Model.Scope, Model.Page - 1)">이전</button><span>@Model.Page 페이지</span><button disabled="@(!Model.HasMore)" @onclick="() => LoadList(Model.Scope, Model.Page + 1)">다음</button></nav> }
    }
</main></NeighborhoodDeliveryFrame>
@code {
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string? ReturnUrl { get; set; }
    private string InputHref(string route) => NeighborhoodMapNavigation.SafeReturn(ReturnUrl) is { } home ? NeighborhoodMapNavigation.WithReturn(route, home) : route;
    private string PanelHref(string kind, string? id, string fallback) => NeighborhoodMapNavigation.SafeReturn(ReturnUrl) is { } home ? NeighborhoodMapNavigation.PanelHref(home, kind, id) : fallback;

    [Parameter] public int InitialPage { get; set; } = 1;
    [Parameter] public string? InitialScope { get; set; }
    [Parameter] public EventCallback<NeighborhoodMapListContext> ListContextChanged { get; set; }
    private bool _initialized;
    protected override async Task OnParametersSetAsync() { if (!_initialized) { _initialized = true; await LoadList(InitialScope ?? "requested", InitialPage); } }
    private async Task LoadList(string scope, int page = 1) { await Model.LoadMineAsync(scope, page); await ListContextChanged.InvokeAsync(new("work", Model.Page, Model.Scope)); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { Model.SynchronizeOwner(); if (Model.IsAuthenticated && !Model.Loaded && !Model.IsLoading && !Model.IsSending && Model.Error is null) await LoadList(InitialScope ?? "requested", InitialPage); }
    private Task Reload() => LoadList(Model.Scope, Model.Page);
    private Task Requested() => LoadList("requested");
    private Task Undertaken() => LoadList("undertaken");
    private async Task Recover() { if (await Model.RecoverAsync() is { } id) Navigation.NavigateTo(Href(PanelHref("work", id, NeighborhoodCollaborationRoutes.Detail(id)))); }
}
