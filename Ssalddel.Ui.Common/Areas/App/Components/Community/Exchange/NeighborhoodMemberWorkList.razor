@inherits NeighborhoodWorkflowPageBase<NeighborhoodMemberWorkViewModel>
<NeighborhoodDeliveryFrame><main class="exchange-page">
    <a class="exchange-back" href="@Href(NeighborhoodMemberDeliveryRoutes.Offers)">← 받은 배송 제안</a><header><span class="exchange-eyebrow">생활 배송</span><h1>내 생활 배송</h1></header>
    <NeighborhoodMemberStateNotice Model="Model" LoginHref="@LoginHref" />
    @if (Model.IsAuthenticated)
    {
        @if (Model.Loaded && Model.Items.Count == 0) { <section class="exchange-empty"><h2>수락한 배송이 없어요</h2><a href="@Href(NeighborhoodMemberDeliveryRoutes.Offers)">배송 제안 확인하기</a></section> }
        else if (Model.Loaded) { <ul class="exchange-list">@foreach (var value in Model.Items) { <li class="exchange-surface"><a href="@Href(NeighborhoodMemberDeliveryRoutes.WorkDetail(value.RequestId))"><span>@NeighborhoodMemberDeliveryPresentation.State(value.StateCode)</span><h2>@value.CargoName</h2><strong>@NeighborhoodDeliveryPresentation.Money(value.FareKrw)</strong></a></li> }</ul> }
        <button disabled="@(Model.IsLoading || Model.IsSending)" @onclick="Reload">새로고침</button>
    }
</main></NeighborhoodDeliveryFrame>
@code {
    [Parameter] public string LoginHref { get; set; } = "/login";
    protected override Task OnInitializedAsync() => Reload();
    private Task Reload() => Model.LoadAsync();
    public Task RefreshAsync() => Reload();
    protected override async Task OnAfterRenderAsync(bool firstRender) { Model.SynchronizeOwner(); if (Model.IsAuthenticated && !Model.Loaded && !Model.IsLoading && Model.Error is null) await Reload(); }
}
