@using Ssalddel.Contracts.Shipper.Request

<section class="delivery-simple-input" aria-label="생활 배송 간편 작성">
    <div class="delivery-input-mode">
        <strong>@(Input.ShowDetailed ? "상세 작성" : "간편 작성")</strong>
        <button type="button" @onclick="Input.ToggleDetailed" disabled="@Disabled">@(Input.ShowDetailed ? "간편 작성으로" : "상세 작성으로")</button>
    </div>
    <details class="delivery-import">
        <summary>엑셀에서 한 건 가져오기</summary>
        <p class="exchange-note">양식의 여러 행을 미리 본 뒤 한 행만 선택합니다. 업로드와 선택은 배송 접수가 아닙니다.</p>
        <button type="button" @onclick="Model.LoadInputTemplateAsync" disabled="@Disabled">엑셀 양식 준비</button>
        @if (Input.TemplateDownloadHref is { } href)
        { <a class="exchange-back" href="@href" download="@Input.Template!.FileName">양식 내려받기</a> }
        <label for="delivery-input-file">작성한 양식 선택 (.xlsx · 최대 2 MiB)</label>
        <InputFile id="delivery-input-file" accept=".xlsx" OnChange="Import" disabled="@Disabled" />
        @if (Input.IsBusy) { <p role="status">입력 자료 확인 중…</p> }
        @if (Input.Preview is { } preview)
        {
            @foreach (var issue in preview.Errors) { <p class="delivery-warning">@issue.Message</p> }
            @if (preview.Rows.Count == 0 && preview.Errors.Count == 0) { <p>가져올 배송 행이 없습니다.</p> }
            <ul class="delivery-import-rows">
                @foreach (var row in preview.Rows)
                {
                    <li>
                        <strong>@row.RowNumber 행 · @(string.IsNullOrWhiteSpace(row.Draft.CargoName) ? "물건 이름 미입력" : row.Draft.CargoName)</strong>
                        <span>@(row.Issues.Count == 0 ? "입력값 검토 필요" : $"보완 항목 {row.Issues.Count}개")</span>
                        <button type="button" disabled="@(Disabled || !Input.CanApplyRow(row))" @onclick="() => Input.ApplyRow(row)">이 행으로 작성</button>
                        @foreach (var issue in row.Issues.Where(issue => issue.FieldKey == "SourceRowId")) { <p class="delivery-warning">@issue.Message 원 엑셀의 행 ID를 고친 뒤 다시 올려 주세요.</p> }
                    </li>
                }
            </ul>
        }
        <p class="exchange-note">행 ID가 없으면 현재 작성 화면의 같은 파일·같은 행에만 같은 요청 번호를 유지합니다. 화면 재시작·파일 수정·새 파일의 중복은 자동 판정하지 않습니다. 재업로드를 추적하려면 행 ID를 보존하고 내 배송 의뢰를 먼저 확인하세요.</p>
    </details>
    @if (Input.Error is { } error) { <div class="exchange-error" role="alert">@error</div> }
    @if (Input.SelectedRow is { } selected)
    {
        <details class="delivery-import-source"><summary>@selected.SourceSheet @selected.RowNumber 행의 원본과 보완 항목</summary>
            <p>원본 셀은 참고 자료입니다. 아래 작성값을 직접 보완하고 확인해야 합니다.</p>
            <dl>
                @foreach (var value in selected.RawValues)
                {
                    <dt>@생활배송간편입력ViewModel.FieldLabel(value.Key) @if (selected.SourceCells.TryGetValue(value.Key, out var cell)) { <small>· @cell</small> }</dt>
                    <dd>@(string.IsNullOrEmpty(value.Value) ? "미입력" : value.Value)</dd>
                }
            </dl>
            @foreach (var issue in selected.Issues) { <p class="exchange-note">원본 보완: @issue.Message</p> }
        </details>
    }
    @if (!Input.ShowDetailed)
    {
        <ol class="delivery-input-steps" aria-label="작성 단계">
            @for (var i = 0; i < 생활배송간편입력ViewModel.Steps.Count; i++)
            { <li aria-current="@(Input.Step == i ? "step" : null)" class="@(Input.Step == i ? "is-current" : "")">@(i + 1). @생활배송간편입력ViewModel.Steps[i]</li> }
        </ol>
        @if (Input.Step == 0)
        {
            <section class="exchange-surface"><h2>어떤 물건을 보내나요?</h2><p class="exchange-note">생활 화물 배송용입니다. 음식 주문은 기존 음식 배달 화면을 이용해 주세요.</p>
                <label for="simple-cargo">물건 이름</label><input id="simple-cargo" @bind="Model.Draft.CargoName" @bind:event="oninput" @bind:after="Model.InputChanged" maxlength="120" required />
                <div class="delivery-input-grid">
                    <div><label for="simple-quantity">수량</label><input id="simple-quantity" type="number" @bind="Model.Draft.Quantity" @bind:after="Model.InputChanged" min="1" max="1000" required /></div>
                    <div><label for="simple-weight">전체 중량(kg)</label><input id="simple-weight" type="number" @bind="Model.Draft.WeightKg" @bind:after="Model.InputChanged" min="0.001" max="10000" step="0.001" required /></div>
                </div>
                <label for="simple-vehicle">배송 차량</label><select id="simple-vehicle" @bind="Model.Draft.VehicleType" @bind:after="Model.InputChanged" required><option value="">선택해 주세요</option><option>오토바이</option><option>다마스</option><option>라보</option><option>1톤</option></select>
                <details><summary>포장 크기와 요청 사항</summary>
                    <label for="simple-size">포장 크기 <small>선택</small></label><select id="simple-size" @bind="Model.PackageSizeCode" @bind:after="Model.InputChanged"><option value="">미입력</option><option value="Small">작음</option><option value="Medium">보통</option><option value="Large">큼</option></select>
                    <p class="exchange-note">우리 입력용 분류이며 실제 업체의 규격을 뜻하지 않습니다.</p>
                    <label for="simple-notes">요청 사항 <small>선택</small></label><textarea id="simple-notes" @bind="Model.Draft.Notes" @bind:event="oninput" @bind:after="Model.InputChanged" maxlength="1000" rows="3"></textarea>
                </details>
            </section>
        }
        else if (Input.Step == 1)
        {
            @foreach (var place in new[] { (Id: "simple-pickup", Title: "픽업지", Value: Model.Draft.Pickup), (Id: "simple-dropoff", Title: "전달지", Value: Model.Draft.Dropoff) })
            {
                <section class="exchange-surface"><h2>@place.Title</h2>
                    <label for="@(place.Id + "-address")">도로명 주소</label><input id="@(place.Id + "-address")" @bind="place.Value.주소.도로명주소" @bind:event="oninput" @bind:after="Model.InputChanged" maxlength="300" autocomplete="off" required />
                    <label for="@(place.Id + "-detail")">상세주소 <small>선택</small></label><input id="@(place.Id + "-detail")" @bind="place.Value.주소.상세주소" @bind:event="oninput" @bind:after="Model.InputChanged" maxlength="300" autocomplete="off" />
                    <label for="@(place.Id + "-name")">담당자 이름</label><input id="@(place.Id + "-name")" @bind="place.Value.연락처.이름" @bind:event="oninput" @bind:after="Model.InputChanged" maxlength="100" autocomplete="off" required />
                    <label for="@(place.Id + "-phone")">담당자 전화번호</label><input id="@(place.Id + "-phone")" type="tel" @bind="place.Value.연락처.전화번호" @bind:event="oninput" @bind:after="Model.InputChanged" maxlength="40" autocomplete="off" required />
                </section>
            }
        }
        else if (Input.Step == 2)
        {
            <section class="exchange-surface"><h2>언제 받을 수 있나요?</h2><p class="exchange-note">처음 표시된 시각은 작성용 기본값입니다. 실제 가능한 시각으로 고친 뒤 확인하세요. 픽업 시각은 필수이며, 전달 시간은 보완하거나 지정하지 않을 수 있습니다.</p>
                <label for="simple-pickup-start">픽업 가능한 시작 시각</label><input id="simple-pickup-start" type="datetime-local" @bind="Input.PickupStart" required />
                <label for="simple-pickup-end">픽업 가능한 종료 시각</label><input id="simple-pickup-end" type="datetime-local" @bind="Input.PickupEnd" required />
                <label class="delivery-check"><input id="simple-dropoff-unspecified" type="checkbox" @bind="Input.DropoffTimeUnspecified" /><span>전달 시간 지정 안 함 · 선택</span></label>
                @if (!Input.DropoffTimeUnspecified)
                {
                    <label for="simple-dropoff-start">전달 가능한 시작 시각</label><input id="simple-dropoff-start" type="datetime-local" @bind="Input.DropoffStart" required />
                    <label for="simple-dropoff-end">전달 가능한 종료 시각</label><input id="simple-dropoff-end" type="datetime-local" @bind="Input.DropoffEnd" required />
                }
                <label class="delivery-check"><input type="checkbox" @bind="Input.TimeReviewed" /><span>표시된 픽업·전달 시간창이 실제 가능한 시각임을 확인했습니다.</span></label>
                @if (!Model.AutoRoutingEnabled) { <label for="simple-desired">희망 완료 시각 <small>선택</small></label><input id="simple-desired" type="datetime-local" @bind="Model.DesiredCompletionLocal" @bind:after="Model.InputChanged" /> }
            </section>
        }
        else
        {
            <section class="exchange-surface"><h2>보낼 내용을 확인하세요</h2>
                @{ var review = Model.CurrentInputSnapshot(); }
                <dl class="delivery-input-review">
                    <dt>물품</dt><dd>@review.CargoName · @review.Quantity 개 · @review.WeightKg.ToString("0.###") kg</dd>
                    <dt>배송 차량</dt><dd>@review.VehicleType</dd><dt>포장 크기</dt><dd>@NeighborhoodPackageSizes.Label(review.PackageSizeCode)</dd>
                    @foreach (var place in new[] { (Title: "픽업지", Value: review.Pickup), (Title: "전달지", Value: review.Dropoff) })
                    {
                        <dt>@place.Title</dt><dd>@place.Value.주소.도로명주소 @place.Value.주소.상세주소</dd>
                        <dt>@place.Title 담당자</dt><dd>@place.Value.연락처.이름 · @place.Value.연락처.전화번호</dd>
                        <dt>@place.Title 시간창</dt><dd>@(place.Value.시간창 is { } window ? $"{window.시작일시.ToLocalTime():yyyy-MM-dd HH:mm} ~ {window.종료일시.ToLocalTime():yyyy-MM-dd HH:mm}" : place.Title == "전달지" && Input.DropoffTimeUnspecified ? "지정 안 함" : "미입력")</dd>
                    }
                    <dt>요청 사항</dt><dd>@(review.Notes ?? "없음")</dd><dt>기사 찾는 방식</dt><dd>@NeighborhoodDispatchModes.Label(review.DispatchMode)</dd>
                    <dt>희망 완료 시각</dt><dd>@(review.DesiredCompletionUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "미지정")</dd>
                </dl>
                @foreach (var missing in Input.MissingForStep(3)) { <p class="delivery-warning">@missing</p> }
                <details><summary>기사를 찾는 방식 변경</summary><label for="simple-mode">배차 방식</label><select id="simple-mode" @bind="Model.Draft.DispatchMode" @bind:after="Model.InputChanged"><option value="automatic">자동 추천</option><option value="public-call">공개 콜 · 기사 자율 수락</option><option value="hybrid">자동 추천과 공개 콜 함께</option></select><p class="exchange-note">@NeighborhoodDeliveryPresentation.배차선택안내(Model.Draft.DispatchMode)</p></details>
            </section>
        }
        <div class="delivery-input-actions">
            @if (Input.Step > 0) { <button type="button" @onclick="Input.Previous" disabled="@Disabled">이전</button> }
            @if (Input.Step < 3) { <button type="button" class="exchange-primary" @onclick="() => Input.Next()" disabled="@Disabled">다음 · @생활배송간편입력ViewModel.Steps[Input.Step + 1]</button> }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public NeighborhoodDeliveryAuthoringViewModel Model { get; set; } = null!;
    private 생활배송간편입력ViewModel Input => Model.SimpleInput;
    private bool Disabled => !Model.CanEditInput || Input.IsBusy;
    protected override void OnParametersSet() => Input.IsActive = true;
    private async Task Import(InputFileChangeEventArgs args)
    {
        if (Disabled) return;
        if (args.FileCount != 1 || args.File.Size is <= 0 or > NeighborhoodDeliveryInputSchema.MaximumFileBytes)
        { Input.ReportError("2 MiB 이하의 .xlsx 파일 한 개를 선택해 주세요."); return; }
        try
        {
            await using var stream = args.File.OpenReadStream(NeighborhoodDeliveryInputSchema.MaximumFileBytes);
            using var memory = new MemoryStream(); await stream.CopyToAsync(memory);
            var content = memory.ToArray();
            try { await Model.ImportInputAsync(args.File.Name, content); }
            finally { Array.Clear(content); if (memory.TryGetBuffer(out var buffer)) Array.Clear(buffer.Array!, buffer.Offset, buffer.Count); }
        }
        catch { Input.ReportError("파일을 읽지 못했습니다. 파일 크기와 양식을 확인해 주세요."); }
    }
}
