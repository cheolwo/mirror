@using Ssalddel.Contracts.Common.Inbound

<nav class="inbound-request-nav" aria-label="입고 요청 화면">
    @foreach (var item in Items)
    {
        if ((item.RequiresInboundId && InboundId is not > 0)
            || (NewRequestDisabled && item.Screen == InboundRequestScreenKind.Create))
        {
            <span class="inbound-request-nav__item inbound-request-nav__item--disabled" aria-disabled="true">
                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                <span><strong>@item.Label</strong><small>@item.Description</small></span>
            </span>
        }
        else
        {
            <a class="@BuildClass(item.Screen)"
               href="@Context.PathFor(item.Screen, InboundId)"
               aria-current="@(item.Screen == CurrentScreen ? "page" : null)">
                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                <span><strong>@item.Label</strong><small>@item.Description</small></span>
            </a>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public InboundRequestNavigationContext Context { get; set; } = new();
    [Parameter] public InboundRequestScreenKind CurrentScreen { get; set; }
    [Parameter] public long? InboundId { get; set; }
    [Parameter] public bool NewRequestDisabled { get; set; }

    private static readonly IReadOnlyList<NavigationItem> Items =
    [
        new(InboundRequestScreenKind.List, "목록", "검색·선택", Icons.Material.Filled.ListAlt, false),
        new(InboundRequestScreenKind.Create, "신규 신청", "입고 예정 등록", Icons.Material.Filled.AddBox, false),
        new(InboundRequestScreenKind.WarehouseRegistration, "창고 등록", "신청 전 준비", Icons.Material.Filled.Warehouse, false),
        new(InboundRequestScreenKind.Detail, "상세", "원장 확인", Icons.Material.Filled.Description, true),
        new(InboundRequestScreenKind.Complete, "입고 완료", "재고 전환", Icons.Material.Filled.Inventory, true)
    ];

    private string BuildClass(InboundRequestScreenKind screen)
        => screen == CurrentScreen
            ? "inbound-request-nav__item inbound-request-nav__item--active"
            : "inbound-request-nav__item";

    private sealed record NavigationItem(
        InboundRequestScreenKind Screen,
        string Label,
        string Description,
        string Icon,
        bool RequiresInboundId);
}
