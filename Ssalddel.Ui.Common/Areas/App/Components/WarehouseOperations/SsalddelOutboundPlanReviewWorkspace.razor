@using Ssalddel.Contracts.Common.Inventory
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@inherits MvvmComponentBase<출고예정검토PageViewModel>

<MudStack Spacing="3" Class="outbound-review-workspace">
    @if (SingleTask)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">출고 수량·포장·보관 조건을 확인해 주세요.</MudAlert>
    }
    else
    {
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.FactCheck">
        <MudText Typo="Typo.subtitle2">출고예정 원장의 운송 전 조건을 한 화면에서 확인합니다.</MudText>
        <MudText Typo="Typo.body2">포장·수량·출발 창고 근거와 하차지·일정 입력 필요 상태를 분리해 보여 줍니다.</MudText>
    </MudAlert>
    }

    @if (SingleTask && OutboundPlanId is > 0)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@ViewModel.처리중" OnClick="RefreshCurrentAsync">
            다시 확인
        </MudButton>
    }
    @if (!SingleTask)
    {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Visibility">
        <MudText Typo="Typo.subtitle2">ReadOnly 검토 경계</MudText>
        <MudText Typo="Typo.body2">이 페이지는 출고예정과 재고를 변경하지 않으며 운송의뢰·배차·결제·정산을 생성하지 않습니다.</MudText>
    </MudAlert>
    }

    @if (!SingleTask)
    {
    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" md="6"><MudTextField T="string" Label="상품·SKU·주문 참조·출고예정 ID 검색" Value="@ViewModel.목록.검색어" ValueChanged="SetSearch" OnKeyDown="SearchKeyDownAsync" Immediate="true" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Disabled="@ViewModel.처리중" /></MudItem>
            <MudItem xs="12" sm="7" md="3"><MudSelect T="string" Label="검토 상태" Value="@ViewModel.목록.조회상태" ValueChanged="StatusChangedAsync" Variant="Variant.Outlined" Disabled="@ViewModel.처리중">@foreach(var status in ViewModel.목록.조회상태목록){<MudSelectItem T="string" Value="@status">@status</MudSelectItem>}</MudSelect></MudItem>
            <MudItem xs="12" sm="5" md="3"><MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@ViewModel.처리중" OnClick="SearchAsync">서버 검토 목록 조회</MudButton></MudItem>
        </MudGrid>
    </MudPaper>
    }

    @if(ViewModel.목록.오류발생){<MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@ViewModel.목록.오류메시지</MudAlert>}

    <MudGrid>
        @if (!SingleTask)
        {
        <MudItem xs="12" lg="5">
            <MudPaper Class="pa-4 review-panel" Elevation="0" Outlined="true"><MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"><MudStack Spacing="0"><MudText Typo="Typo.h6">운송 전 검토 대상</MudText><MudText Typo="Typo.caption" Color="Color.Secondary">서버 조회 @ViewModel.목록.응답.TotalCount.ToString("N0")건</MudText></MudStack>@if(ViewModel.목록.처리중){<MudProgressCircular Indeterminate="true" Size="Size.Small" />}</MudStack>
                @if(ViewModel.목록.비어있음){<div class="review-empty"><MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Size="Size.Large" Color="Color.Secondary" /><MudText Typo="Typo.subtitle1">조건에 맞는 출고예정이 없습니다.</MudText><MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">출고 인계 준비가 완료되기 전에는 샘플 검토 항목을 표시하지 않습니다.</MudText></div>}
                else{<div class="review-list">@foreach(var item in ViewModel.목록.항목목록){<button type="button" class="review-item @(ViewModel.상세.조회대상Id==item.OutboundPlanId?"is-selected":null)" disabled="@ViewModel.처리중" @onclick="@(()=>SelectAsync(item.OutboundPlanId))"><span class="review-title-row"><span class="review-title">@Display(item.ProductName)</span><span class="review-status">@item.ReviewStatus</span></span><span class="review-meta">출고예정 #@item.OutboundPlanId · @Display(item.Sku)</span><span class="review-meta">@Display(item.WarehouseName) · @item.Quantity.ToString("N0")개</span><span class="review-meta">@Display(item.OrderReference) · @FormatDateTime(item.UpdatedAtUtc)</span></button>}</div>}
                <MudStack Row="true" Justify="Justify.SpaceBetween"><MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.이전페이지있음||ViewModel.처리중)" OnClick="PreviousAsync">이전</MudButton><MudText Typo="Typo.caption">@(ViewModel.목록.응답.Page+1)페이지</MudText><MudButton Variant="Variant.Text" Disabled="@(!ViewModel.목록.다음페이지있음||ViewModel.처리중)" OnClick="NextAsync">다음</MudButton></MudStack>
            </MudStack></MudPaper>
        </MudItem>
        }
        <MudItem xs="12" lg="@(SingleTask ? 12 : 7)">
            <MudPaper Class="pa-4 review-panel" Elevation="0" Outlined="true">
                @if(ViewModel.상세.처리중){<div class="review-empty"><MudProgressCircular Indeterminate="true" /><MudText>@(SingleTask ? "출고할 물품을 확인하고 있습니다." : "출고예정 원장을 같은 ID로 확인하고 있습니다.")</MudText></div>}
                else if(ViewModel.상세.오류발생){<div class="review-empty"><MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" /><MudText>@(SingleTask ? "출고 상태를 확인하지 못했습니다. 다시 확인해 주세요." : ViewModel.상세.오류메시지)</MudText></div>}
                else if(ViewModel.상세.대상없음){<div class="review-empty"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Warning" Size="Size.Large" /><MudText Typo="Typo.subtitle1">검토할 출고예정을 찾을 수 없습니다.</MudText>@if(!SingleTask){<MudText Typo="Typo.body2" Color="Color.Secondary">다른 출고예정으로 자동 대체하지 않습니다.</MudText><MudButton Variant="Variant.Outlined" OnClick="ClearAsync">선택 해제</MudButton>}</div>}
                else if(ViewModel.상세.항목 is not{} plan){<div class="review-empty"><MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" /><MudText Typo="Typo.subtitle1">검토할 출고예정을 선택해 주세요.</MudText>@if(!SingleTask){<MudText Typo="Typo.body2" Color="Color.Secondary">목록에서 한 건을 선택할 때만 정확한 원장과 선행 근거를 조회합니다.</MudText>}</div>}
                else{<MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap"><MudStack Spacing="0"><MudText Typo="Typo.h5">@Display(plan.ProductName)</MudText><MudText Typo="Typo.body2" Color="Color.Secondary">@(SingleTask ? Display(plan.Sku) : $"출고예정 #{plan.OutboundPlanId} · {Display(plan.Sku)}")</MudText></MudStack><MudChip T="string" Color="@ReviewColor(plan.ReviewStatus)" Variant="Variant.Outlined">@(SingleTask && plan.CanStartTransportRequestDraft ? "운송 요청 가능" : plan.ReviewStatus)</MudChip></MudStack>
                    <MudGrid><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="창고" Value="@Display(plan.WarehouseName)" /></MudItem><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="출고 상태" Value="@Display(plan.OutboundStatus)" /></MudItem><MudItem xs="6" sm="4"><SsalddelSensitiveInfoRow Label="출고 수량" Value="@($"{plan.Quantity:N0}개")" /></MudItem><MudItem xs="4"><SsalddelSensitiveInfoRow Label="가용" Value="@Quantity(plan.AvailableQuantity)" /></MudItem><MudItem xs="4"><SsalddelSensitiveInfoRow Label="예약" Value="@Quantity(plan.ReservedQuantity)" /></MudItem><MudItem xs="4"><SsalddelSensitiveInfoRow Label="불량" Value="@Quantity(plan.DefectiveQuantity)" /></MudItem><MudItem xs="6"><SsalddelSensitiveInfoRow Label="보관 위치" Value="@Display(plan.StorageLocation)" /></MudItem><MudItem xs="6"><SsalddelSensitiveInfoRow Label="보관 조건" Value="@Display(plan.StorageCondition)" /></MudItem><MudItem xs="12"><SsalddelSensitiveInfoRow Label="주문 참조" Value="@Display(plan.OrderReference)" /></MudItem></MudGrid>
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined"><MudText Typo="Typo.subtitle2">인계 준비 근거</MudText><MudText Typo="Typo.body2">@Display(plan.PackagingType) · 포장 @FormatDateTime(plan.PackedAtUtc)</MudText><MudText Typo="Typo.caption">인계 준비 @FormatDateTime(plan.HandoffReadyAtUtc) · 재고 상태 @Display(plan.InventoryStatus)</MudText></MudAlert>
                    <MudText Typo="Typo.h6">운송의뢰 생성 전 확인</MudText>
                    <div class="review-checks">@foreach(var check in plan.Checks){<div class="review-check"><MudIcon Icon="@CheckIcon(check.Status)" Color="@CheckColor(check.Status)" /><div><MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center"><MudText Typo="Typo.subtitle2">@check.Label</MudText><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@CheckColor(check.Status)">@check.Status</MudChip></MudStack><MudText Typo="Typo.body2" Color="Color.Secondary">@check.Summary</MudText></div></div>}</div>
                    <MudAlert Severity="@(plan.CanStartTransportRequestDraft?Severity.Success:Severity.Warning)" Variant="Variant.Outlined" Icon="@(plan.CanStartTransportRequestDraft?Icons.Material.Filled.LocalShipping:Icons.Material.Filled.Info)"><MudText Typo="Typo.subtitle2">@(SingleTask && plan.CanStartTransportRequestDraft ? "운송 요청 가능" : plan.ReviewStatus)</MudText><MudText Typo="Typo.body2">@plan.NextStep</MudText>@if(!SingleTask){<MudText Typo="Typo.caption">실제 입력과 저장은 별도 출고 운송의뢰 단계에서만 수행합니다.</MudText>}@if(plan.CanStartTransportRequestDraft){<MudButton Href="@DraftLink(plan.OutboundPlanId)" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.LocalShipping">출고 운송의뢰 작성</MudButton>}</MudAlert>
                </MudStack>}
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudStack>

@code {
    [Parameter] public long? OutboundPlanId { get; set; }
    [Parameter] public EventCallback<long?> OnPlanSelected { get; set; }
    [Parameter] public bool SingleTask { get; set; }
    [Parameter] public string? DraftHref { get; set; }
    [Parameter] public 출고예정검토PageViewModel? ExternalViewModel { get; set; }
    protected new 출고예정검토PageViewModel ViewModel => ExternalViewModel ?? base.ViewModel;
    protected override void OnInitialized()
    {
        if (ExternalViewModel is null) base.OnInitialized();
        else ExternalViewModel.PropertyChanged += ExternalChanged;
    }
    private void ExternalChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    protected override void Dispose(bool disposing)
    {
        if (disposing && ExternalViewModel is not null) ExternalViewModel.PropertyChanged -= ExternalChanged;
        base.Dispose(disposing);
    }
    private string DraftLink(long id) => DraftHref ?? $"/warehouse/general/transport-request-draft?outboundPlanId={id}";
    private bool _initialized;
    private long? _loadedId;

    protected override async Task OnParametersSetAsync(){var id=OutboundPlanId is>0?OutboundPlanId:null;if(!_initialized){_initialized=true;_loadedId=id;if(ExternalViewModel is null)await ViewModel.초기화Async(id);}else if(id!=_loadedId){_loadedId=id;if(id is>0)await ViewModel.대상선택Async(id.Value);else ViewModel.선택해제();}}
    private void SetSearch(string value)=>ViewModel.목록.검색어=value??string.Empty;
    private async Task SearchKeyDownAsync(KeyboardEventArgs args){if(args.Key is "Enter" or "NumpadEnter")await SearchAsync();}
    private async Task StatusChangedAsync(string value){ViewModel.목록.조회상태=출고예정검토조회상태코드.Normalize(value);await SearchAsync();}
    private Task SearchAsync()=>ViewModel.검색Async();
    private Task RefreshCurrentAsync()=>OutboundPlanId is > 0 ? ViewModel.대상선택Async(OutboundPlanId.Value) : Task.CompletedTask;
    private Task PreviousAsync()=>ViewModel.목록.이전페이지Async();
    private Task NextAsync()=>ViewModel.목록.다음페이지Async();
    private async Task SelectAsync(long id){if(await ViewModel.대상선택Async(id)){_loadedId=id;await OnPlanSelected.InvokeAsync(id);}}
    private async Task ClearAsync(){ViewModel.선택해제();_loadedId=null;await OnPlanSelected.InvokeAsync(null);}
    private static string Display(string? value)=>string.IsNullOrWhiteSpace(value)?"-":value;
    private static string Quantity(int? value)=>value.HasValue?$"{value.Value:N0}개":"-";
    private static string FormatDateTime(DateTime? value)=>value.HasValue?value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm"):"-";
    private static Color ReviewColor(string status)=>status=="초안 입력 가능"?Color.Success:status=="운송 연결됨"?Color.Info:Color.Warning;
    private static Color CheckColor(string status)=>status==출고예정검토항목상태코드.확인완료?Color.Success:status==출고예정검토항목상태코드.차단?Color.Error:Color.Warning;
    private static string CheckIcon(string status)=>status==출고예정검토항목상태코드.확인완료?Icons.Material.Filled.CheckCircle:status==출고예정검토항목상태코드.차단?Icons.Material.Filled.Error:Icons.Material.Filled.Edit;
}
