@using Ssalddel.Contracts.Common.Inventory
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@implements IDisposable

<section class="period-workspace" aria-label="회차별 출고 현황">
    <header><h2 tabindex="-1" @ref="heading">회차별 출고 현황</h2><p>선택 구간에 접수된 물량과 이전 접수 미완료를 함께 확인합니다.</p></header>
    @if (!Model.IsAuthenticated)
    {
        <p role="alert">로그인 후 창고와 조회 구간을 다시 확인해 주세요.</p>
    }
    else
    {
        <form class="period-card period-form" @onsubmit="QueryAsync" @onsubmit:preventDefault>
            <label>창고<select aria-label="창고" @bind="Model.WarehouseId" disabled="@(!Model.WarehousesLoaded)"><option value="0">창고 선택</option>@foreach (var warehouse in Model.Warehouses) { <option value="@warehouse.Id">@warehouse.창고명</option> }</select></label>
            <label>조회 시작 · 한국 시간<input type="datetime-local" @bind="Model.StartLocal" /></label>
            <label>조회 종료 · 한국 시간<input type="datetime-local" @bind="Model.EndLocal" /></label>
            <button type="submit" class="period-primary" disabled="@(Model.IsLoading || !Model.WarehousesLoaded)">회차 현황 조회</button>
            <div class="period-period-actions"><button type="button" @onclick="PreviousPeriodAsync" disabled="@Model.IsLoading">이전 구간</button><button type="button" @onclick="NextPeriodAsync" disabled="@Model.IsLoading">다음 구간</button><button type="button" @onclick="DayAsync" disabled="@Model.IsLoading">하루 보기</button></div>
        </form>
        @if (Model.IsLoading) { <p role="status">창고의 회차 현황을 확인하고 있습니다.</p> }
        @if (Model.Error is { } error) { <p role="alert" class="period-error">@error</p> }
        @if (!Model.WarehousesLoaded && !Model.IsLoading) { <button type="button" @onclick="Model.InitializeAsync">창고 목록 다시 확인</button> }
        @if (Model.WarehousesLoaded && Model.Warehouses.Count == 0) { <p role="status">현재 계정에서 조회할 창고가 없습니다.</p> }
        @if (Model.Warning is { } warning) { <p role="status" class="period-warning">@warning</p> }
        <SsalddelOutboundWorkflowPanel Model="Model" OnPlanSelected="OnPlanSelected" />
        @if (Model.Snapshot is { } report)
        {
            <p class="period-caption">@report.WarehouseName · @Time(report.PeriodStartUtc) ~ @Time(report.PeriodEndUtc)<br />확인 @Time(report.ObservedAtUtc) · 접수 시각 기준 현재 현황</p>
            <section class="period-card" aria-label="선택 구간 접수"><h3>선택 구간 접수</h3>
                <dl class="period-totals"><div><dt>접수</dt><dd>@report.Current.PlanCount.ToString("N0")건 · @report.Current.ReceivedQuantity.ToString("N0")개</dd></div><div><dt>인계 완료</dt><dd>@report.Current.HandedOffQuantity.ToString("N0")개</dd></div><div><dt>피킹 확인</dt><dd>@report.Current.PickedQuantity.ToString("N0")개</dd></div><div><dt>포장 확인</dt><dd>@report.Current.PackedQuantity.ToString("N0")개</dd></div></dl>
                <p class="period-caption">피킹·포장은 연결된 완료 작업의 확인 수량입니다. 공정별 수량은 같은 물량의 진행을 나타냅니다.</p>
                @if (report.Current.NeedsReviewCount > 0) { <p class="period-warning">확인 필요 @report.Current.NeedsReviewCount.ToString("N0")건 · 아래 사유를 확인해 주세요.</p> }
            </section>
            <section class="period-card" aria-label="이전 접수 미완료"><h3>이전 접수 미완료</h3><strong>@report.Carryover.PlanCount.ToString("N0")건 · @report.Carryover.ReceivedQuantity.ToString("N0")개</strong><p>조회 시작 전에 접수되어 현재 남아 있는 출고입니다. 최초 접수와 현재 담당을 이어서 확인합니다.</p></section>
            <section class="period-card" aria-label="이어 확인할 출고"><h3>이어 확인할 출고</h3>
                @if (report.TotalCount == 0) { <p role="status">선택 구간 접수와 이전 미완료 출고가 없습니다.</p> }
                @foreach (var item in report.Items)
                {
                    <article class="period-item" data-plan-id="@item.OutboundPlanId">
                        <div class="period-item-status">@(item.CreatedAtUtc == default ? "접수 시각 미확인" : item.IsCarryover ? "이전 접수" : "선택 구간 접수") · @item.OutboundStatus</div>
                        <h4>@item.ProductName</h4><p class="period-caption">접수 @Time(item.CreatedAtUtc) · @item.Quantity.ToString("N0")개 · @item.OrderReference</p>
                        <dl class="period-fields"><div><dt>피킹 확인</dt><dd>@item.PickedQuantity.ToString("N0")개</dd></div><div><dt>포장 확인</dt><dd>@item.PackedQuantity.ToString("N0")개</dd></div><div><dt>담당</dt><dd>@(item.WorkerDisplayNames.Count > 0 ? string.Join(" · ", item.WorkerDisplayNames) : "배정 근거 미확인")</dd></div><div><dt>다음 확인</dt><dd>@item.NextActor · @item.WaitingReason</dd></div></dl>
                        @if (item.NeedsReview) { <p class="period-warning">@item.ReviewReason</p> }
                        <button type="button" @onclick="() => OnPlanSelected.InvokeAsync(item.OutboundPlanId)" disabled="@(Model.IsLoading || !item.CanOpenReview)" aria-label="@($"{item.ProductName} 출고 검토")">@(item.CanOpenReview ? "같은 출고 검토" : "취소된 출고")</button>
                    </article>
                }
                <div class="period-pagination"><button type="button" disabled="@(report.Page == 0 || Model.IsLoading)" @onclick="() => Model.LoadAsync(report.Page - 1)">이전</button><span>@(report.Page + 1)페이지 · 전체 @report.TotalCount.ToString("N0")건</span><button type="button" disabled="@(!report.HasNextPage || Model.IsLoading)" @onclick="() => Model.LoadAsync(report.Page + 1)">다음</button></div>
            </section>
            <section class="period-card" aria-label="인력과 배정 부하"><h3>인력과 배정 부하</h3><p>창고 등록 @report.Workforce.RegisteredWorkerCount.ToString("N0")명 · 배정 중 @report.Workforce.AssignedWorkerCount.ToString("N0")명 · 미완료 작업 @report.Workforce.OpenTaskCount.ToString("N0")건</p><p class="period-caption">현장 근무 미확인. 실제 출근과 휴게·교대 종료는 현장에서 확인해 주세요.</p></section>
            <section class="period-card" aria-label="날짜별 접수 현황"><h3>선택일과 최근 7일</h3><p>같은 날짜에 접수된 출고의 현재 진행을 비교합니다.</p>
                <p><strong>@KstDate(report.PeriodStartUtc)</strong> · 접수 @report.Today.ReceivedQuantity.ToString("N0")개 · 인계 @report.Today.HandedOffQuantity.ToString("N0")개 · 확인 필요 @report.Today.NeedsReviewCount.ToString("N0")건</p>
                <ul class="period-days">@foreach (var day in report.PreviousDays) { <li><strong>@day.DateKst</strong><span>접수 @day.Totals.ReceivedQuantity.ToString("N0")개 · 인계 @day.Totals.HandedOffQuantity.ToString("N0")개 · 확인 필요 @day.Totals.NeedsReviewCount.ToString("N0")건</span></li> }</ul>
            </section>
        }
        else if (!Model.IsLoading && Model.Error is null && Model.Warehouses.Count > 0) { <p role="status">창고와 조회 구간을 선택한 뒤 회차 현황을 조회해 주세요.</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public 출고회차ViewModel Model { get; set; } = default!;
    [Parameter] public EventCallback<long> OnPlanSelected { get; set; }
    private ElementReference heading;
    protected override async Task OnInitializedAsync() { Model.PropertyChanged += Changed; await Model.InitializeAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await heading.FocusAsync(); }
    private void Changed(object? sender, System.ComponentModel.PropertyChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    private Task QueryAsync() => Model.LoadAsync();
    private async Task PreviousPeriodAsync() { Model.MovePeriod(-1); await Model.LoadAsync(); }
    private async Task NextPeriodAsync() { Model.MovePeriod(1); await Model.LoadAsync(); }
    private async Task DayAsync() { Model.SelectDay(); await Model.LoadAsync(); }
    private static string Time(DateTime value) => value == default ? "시각 미확인" : new DateTimeOffset(DateTime.SpecifyKind(value, DateTimeKind.Utc)).ToOffset(TimeSpan.FromHours(9)).ToString("MM-dd HH:mm");
    private static string KstDate(DateTime value) => new DateTimeOffset(DateTime.SpecifyKind(value, DateTimeKind.Utc)).ToOffset(TimeSpan.FromHours(9)).ToString("yyyy-MM-dd");
    public void Dispose() { Model.PropertyChanged -= Changed; Model.Suspend(); }
}
