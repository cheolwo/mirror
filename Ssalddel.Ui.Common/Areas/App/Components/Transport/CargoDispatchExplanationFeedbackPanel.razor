@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport
@using Ssalddel.Contracts.Common.Dispatch
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@implements IDisposable

<section class="cargo-decision" aria-label="배차 설명·의견">
    <div class="cargo-decision__heading">
        <div><h3>배차 설명·의견</h3><p>당시 저장된 판단과 확인된 조건을 봅니다.</p></div>
        <button type="button" class="cargo-decision__secondary" @onclick="ToggleAsync" aria-expanded="@_expanded">@(_expanded ? "접기" : "열기")</button>
    </div>
    @if (_expanded)
    {
        @if (_model.RequiresLogin)
        {
            <p role="status">로그인한 뒤 본인이 관계된 운송의 설명을 확인해 주세요.</p>
        }
        else
        {
            <button type="button" class="cargo-decision__secondary" @onclick="RefreshAsync" disabled="@_model.IsBusy">다시 확인</button>
            @if (_model.IsLoading) { <p role="status">저장된 배차 설명을 확인하고 있습니다.</p> }
            @if (_model.Error is { } error) { <p class="cargo-decision__error" role="alert">@error</p> }
            @if (_model.Notice is { } notice) { <p class="cargo-decision__notice" role="status">@notice</p> }
            @if (_model.Explanation is { } response)
            {
                @if (response.Status == "unrecorded" || response.Items.Count == 0)
                {
                    <p class="cargo-decision__notice">당시 배차 설명이 기록되지 않았습니다. 현재 조건으로 과거 판단을 다시 만들지 않습니다.</p>
                }
                else
                {
                    <p>@response.Notice</p>
                    <label class="cargo-decision__field">확인할 배차 기록
                        <select value="@_model.SelectedEvidenceId" @onchange="SelectEvidence" disabled="@(_model.IsBusy || _model.HasPending)">
                            @foreach (var item in response.Items)
                            {
                                <option value="@item.EvidenceId">@RecordLabel(item)</option>
                            }
                        </select>
                    </label>
                    @if (_model.SelectedItem is { } selected)
                    {
                        <div class="cargo-decision__record">
                            <p><strong>@Stage(selected)</strong> · @KoreaTime(selected.OccurredAtUtc)</p>
                            <p>@selected.MethodLabel</p>
                            <dl>
                                @foreach (var fact in selected.Facts)
                                {
                                    <div><dt>@fact.Label</dt><dd>@fact.Value</dd></div>
                                }
                            </dl>
                            @foreach (var limitation in selected.Limitations) { <p class="cargo-decision__notice">@limitation</p> }
                            <p>추천은 기사 수락·운송 완료와 구분됩니다.</p>
                        </div>
                        @if (selected.MyFeedback.Count > 0)
                        {
                            <details><summary>내 의견 접수 기록 @selected.MyFeedback.Count 건</summary>
                                @foreach (var receipt in selected.MyFeedback)
                                {
                                    <p>@CargoDispatchFeedbackCategories.Label(receipt.CategoryCode) · 접수됨 · @KoreaTime(receipt.SubmittedAtUtc)</p>
                                }
                            </details>
                        }
                        @if (selected.CanSubmitFeedback || _model.HasPending)
                        {
                            <div class="cargo-decision__form">
                                <h4>이 배차 설명에 의견 남기기</h4>
                                <label class="cargo-decision__field">의견 종류
                                    <select @bind="_model.CategoryCode" disabled="@(_model.IsBusy || _model.HasPending)">
                                        <option value="">선택해 주세요</option>
                                        @foreach (var category in CargoDispatchFeedbackCategories.All)
                                        {
                                            <option value="@category">@CargoDispatchFeedbackCategories.Label(category)</option>
                                        }
                                    </select>
                                </label>
                                <label class="cargo-decision__field">추가 의견 (선택)
                                    <textarea @bind="_model.Comment" @bind:event="oninput" maxlength="500" rows="3"
                                              disabled="@(_model.IsBusy || _model.HasPending)" aria-describedby="cargo-feedback-privacy"></textarea>
                                </label>
                                <p id="cargo-feedback-privacy">줄바꿈 없이 500자 이내로 작성해 주세요. 주소·전화번호 등 개인정보는 적지 마세요.</p>
                                @if (_model.CommentValidation is { } validation) { <p class="cargo-decision__error" role="alert">@validation</p> }
                                <p>의견은 비공개로 접수됩니다. 제출만으로 배차·운임이 바뀌거나 자동 학습에 반영되지 않습니다.</p>
                                @if (_model.HasPending)
                                {
                                    <p role="status">이전에 보낸 요청의 접수 결과를 먼저 확인합니다. 입력과 요청 번호를 보존했습니다.</p>
                                    <div class="cargo-decision__actions">
                                        <button type="button" @onclick="_model.CheckPendingAsync" disabled="@_model.IsBusy">접수 여부 확인</button>
                                        @if (_model.CanRetry)
                                        {
                                            <button type="button" @onclick="_model.RetryAsync" disabled="@_model.IsBusy">같은 의견 다시 보내기</button>
                                        }
                                        @if (_model.CanDiscardExpired)
                                        {
                                            <button type="button" class="cargo-decision__secondary" @onclick="_model.DiscardExpiredAsync" disabled="@_model.IsBusy">새로 작성</button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <button type="button" @onclick="_model.SubmitAsync" disabled="@(!_model.CanSubmit)">의견 보내기</button>
                                }
                            </div>
                        }
                    }
                }
            }
            @if (_model.Receipt is { } received)
            {
                <p class="cargo-decision__notice" role="status">@CargoDispatchFeedbackCategories.Label(received.CategoryCode) 의견이 접수되었습니다. 접수 시각 @KoreaTime(received.SubmittedAtUtc)</p>
            }
            @if (_model.HasPending && _model.SelectedItem is null)
            {
                <p role="status">이전 의견의 접수 결과를 확인해야 합니다.</p>
                <button type="button" @onclick="_model.CheckPendingAsync" disabled="@_model.IsBusy">접수 여부 확인</button>
                @if (_model.CanDiscardExpired)
                {
                    <button type="button" @onclick="_model.DiscardExpiredAsync" disabled="@_model.IsBusy">새로 작성</button>
                }
            }
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public string RequestId { get; set; } = string.Empty;
    [Parameter] public bool InitiallyExpanded { get; set; }
    [Parameter] public CargoDispatchExplanationFeedbackViewModel? Model { get; set; }
    private CargoDispatchExplanationFeedbackViewModel _model = default!;
    private string? _lastRequest;
    private bool _expanded;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _model = Model ?? Services.GetRequiredService<CargoDispatchExplanationFeedbackViewModel>();
        _expanded = InitiallyExpanded;
        _model.Changed += OnChanged;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_lastRequest == RequestId) return;
        _lastRequest = RequestId;
        // 접힌 상태에서도 계정·의뢰 전환은 즉시 반영하고 기존 미확정 요청을 복원한다.
        await _model.LoadAsync(RequestId);
    }
    private Task RefreshAsync() => _model.LoadAsync(RequestId);
    private async Task ToggleAsync()
    {
        _expanded = !_expanded;
        if (_expanded && _model.Explanation is null && !_model.IsBusy) await RefreshAsync();
    }
    private void SelectEvidence(ChangeEventArgs args) => _model.SelectEvidence(args.Value?.ToString() ?? string.Empty);
    private void OnChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private static string Stage(CargoDispatchExplanationItem item) => item.DecisionKind == "acceptance" ? "기사 수락 기록" : "배차 추천 기록";
    private static string RecordLabel(CargoDispatchExplanationItem item) => $"{Stage(item)} · {KoreaTime(item.OccurredAtUtc)} · {item.RecommendationRound}차";
    private static string KoreaTime(DateTime value) => value == default ? "시각 미확인"
        : new DateTimeOffset(DateTime.SpecifyKind(value, DateTimeKind.Utc)).ToOffset(TimeSpan.FromHours(9)).ToString("MM.dd HH:mm (한국시간)");
    public void Dispose() { _disposed = true; _model.Changed -= OnChanged; if (Model is null) _model.Dispose(); }
}
