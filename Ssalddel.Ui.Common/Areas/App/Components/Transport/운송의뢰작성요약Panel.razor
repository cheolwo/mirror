@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="3">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h6">운송 의뢰 작성 상태</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                한 화면 입력과 단계별 입력 모두 같은 ViewModel을 공유합니다.
            </MudText>
        </MudStack>

        <MudStack Row="true" Spacing="1" Class="flex-wrap">
            @foreach (var 단계 in ViewModel.단계목록.Take(3))
            {
                <MudChip T="string"
                         Size="Size.Small"
                         Color="@GetStepColor(단계)"
                         Variant="Variant.Outlined"
                         Icon="@GetStepIcon(단계)">
                    @단계.제목
                </MudChip>
            }
        </MudStack>

        <MudDivider />

        <MudStack Spacing="1">
            <MudText Typo="Typo.subtitle2">현재 초안</MudText>
            <MudText Typo="Typo.body2">화물: @Display(ViewModel.화물종류)</MudText>
            <MudText Typo="Typo.body2">적재: @Display(ViewModel.화물적재형태)</MudText>
            <MudText Typo="Typo.body2">포장 수량: @(ViewModel.화물수량?.ToString() ?? "미확인")개 · 전체 포장 포함 중량: @(ViewModel.화물중량Kg?.ToString("0.###") ?? "미입력") kg</MudText>
            <MudText Typo="Typo.body2">포장 1개 크기: @(ViewModel.화물길이Mm?.ToString() ?? "미입력") × @(ViewModel.화물폭Mm?.ToString() ?? "미입력") × @(ViewModel.화물높이Mm?.ToString() ?? "미입력") mm</MudText>
            <MudText Typo="Typo.body2">입력 부피: @Volume(ViewModel.화물부피Cbm) · 크기로 계산한 부피: @Volume(ViewModel.적재입력.치수추정부피Cbm)</MudText>
            <MudText Typo="Typo.body2">차량 확인에 쓸 부피: @Volume(ViewModel.적재입력.유효부피Cbm)</MudText>
            <MudText Typo="Typo.body2">바닥 방향 변경: @Permission(ViewModel.화물바닥회전가능여부) · 위에 쌓기: @Permission(ViewModel.화물적층가능여부)</MudText>
            <MudText Typo="Typo.body2">구간: @Display(ViewModel.상차도로명주소) → @Display(ViewModel.하차도로명주소)</MudText>
            <MudText Typo="Typo.body2">상차 담당자: @Display(ViewModel.상차연락처이름) · @MaskedPhone(ViewModel.상차연락처전화번호)</MudText>
            <MudText Typo="Typo.body2">상차 시간창: @Window(ViewModel.상차시간창시작일시, ViewModel.상차시간창종료일시) (한국시간)</MudText>
            <MudText Typo="Typo.body2">하차 담당자: @Display(ViewModel.하차연락처이름) · @MaskedPhone(ViewModel.하차연락처전화번호)</MudText>
            <MudText Typo="Typo.body2">하차 시간창: @Window(ViewModel.하차시간창시작일시, ViewModel.하차시간창종료일시) (한국시간)</MudText>
            <MudText Typo="Typo.body2">차량/결제: @Display(ViewModel.차량종류) · @ViewModel.결제수단</MudText>
            <MudText Typo="Typo.body2">추천 차량: @(ViewModel.추천차량종류목록.Count > 0 ? string.Join(", ", ViewModel.추천차량종류목록) : "확인된 추천 없음")</MudText>
            @if (ViewModel.적용차량재확인필요)
            {
                <MudText Typo="Typo.body2" Color="Color.Warning">화물 조건이 바뀌었습니다. 차량을 다시 확인해 주세요.</MudText>
            }
            <MudText Typo="Typo.body2">부가비용: @ViewModel.부가비용합계.ToString("N0")원</MudText>
        </MudStack>

        <MudAlert Severity="@(ViewModel.서버등록가능 ? Severity.Success : Severity.Warning)" Dense="true" Variant="Variant.Outlined">
            @(ViewModel.서버등록가능
                ? "서버 등록에 필요한 필수 입력이 채워졌습니다."
                : $"필수 보완 {ViewModel.필수입력오류목록.Count}건이 남아 있습니다.")
        </MudAlert>
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired] public 운송의뢰작성ViewModel ViewModel { get; set; } = default!;

    private static Color GetStepColor(운송의뢰작성단계 단계) => 단계.완료 ? Color.Success : Color.Default;

    private static string GetStepIcon(운송의뢰작성단계 단계) =>
        단계.완료 ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked;

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "미입력" : value;

    private static string Volume(decimal? value) => value.HasValue ? $"{value.Value:0.######} m³" : "미입력";
    private static string Permission(bool? value) => value.HasValue ? (value.Value ? "가능" : "불가") : "미확인";

    private static string MaskedPhone(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "미입력";
        var digits = new string(value.Where(char.IsDigit).ToArray());
        return digits.Length > 4 ? $"***-****-{digits[^4..]}" : "****";
    }

    private static string Window(DateTime? start, DateTime? end)
        => !start.HasValue && !end.HasValue ? "미입력"
            : $"{(start.HasValue ? start.Value.ToString("MM.dd HH:mm") : "시작 미입력")} ~ {(end.HasValue ? end.Value.ToString("MM.dd HH:mm") : "종료 미입력")}";
}
