@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<ShipperRequestScreenFrame ViewModel="ViewModel"
                           NavigationContext="NavigationContext"
                           Step="ShipperRequestAuthoringStep.Transport"
                           ScreenCode="@ScreenCode"
                           Title="@Title"
                           Description="@Description"
                           ShowNavigation="ShowNavigation"
                           RootBackHref="@RootBackHref"
                           RootBackLabel="@RootBackLabel"
                           Changed="Changed">
    <Ssalddel운송정보입력정책Panel 화물적재형태="@ViewModel.화물적재형태" />

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        상세 주소와 연락처는 실제 운송 준비에 필요한 개인정보입니다. 공개 커뮤니티 초안에는 포함하지 않습니다.
    </MudAlert>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">상차 정보</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">기사님이 화물을 받을 위치와 연락 대상을 확인합니다.</MudText>
            </MudStack>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.상차도로명주소" Label="상차 도로명 주소" Variant="Variant.Outlined" Required="true" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.상차상세주소" Label="상차 상세 주소" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.상차연락처이름" Label="상차 담당자" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.상차연락처전화번호" Label="상차 담당자 연락처" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="DateTime?" @bind-Value="ViewModel.상차시간창시작일시" Label="상차 시작 (한국시간)"
                                  InputType="InputType.DateTimeLocal" Format="yyyy-MM-ddTHH:mm" Culture="@System.Globalization.CultureInfo.InvariantCulture"
                                  Variant="Variant.Outlined" Required="true" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="DateTime?" @bind-Value="ViewModel.상차시간창종료일시" Label="상차 종료 (한국시간)"
                                  InputType="InputType.DateTimeLocal" Format="yyyy-MM-ddTHH:mm" Culture="@System.Globalization.CultureInfo.InvariantCulture"
                                  Variant="Variant.Outlined" Required="true" Immediate="true"
                                  Error="@(ViewModel.상차시간창오류 is not null)" ErrorText="@ViewModel.상차시간창오류" />
                </MudItem>
            </MudGrid>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.subtitle1">하차 정보</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">기사님이 화물을 인계할 위치와 연락 대상을 확인합니다.</MudText>
            </MudStack>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.하차도로명주소" Label="하차 도로명 주소" Variant="Variant.Outlined" Required="true" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.하차상세주소" Label="하차 상세 주소" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.하차연락처이름" Label="하차 담당자" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="ViewModel.하차연락처전화번호" Label="하차 담당자 연락처" Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="DateTime?" @bind-Value="ViewModel.하차시간창시작일시" Label="하차 시작 (한국시간 · 선택)"
                                  InputType="InputType.DateTimeLocal" Format="yyyy-MM-ddTHH:mm" Culture="@System.Globalization.CultureInfo.InvariantCulture"
                                  Variant="Variant.Outlined" Immediate="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="DateTime?" @bind-Value="ViewModel.하차시간창종료일시" Label="하차 종료 (한국시간 · 선택)"
                                  InputType="InputType.DateTimeLocal" Format="yyyy-MM-ddTHH:mm" Culture="@System.Globalization.CultureInfo.InvariantCulture"
                                  Variant="Variant.Outlined" Immediate="true"
                                  Error="@(ViewModel.하차시간창오류 is not null)" ErrorText="@ViewModel.하차시간창오류" />
                </MudItem>
            </MudGrid>
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="ViewModel.운송방식" Label="운송 방식" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("혼적")">혼적</MudSelectItem>
                    <MudSelectItem Value="@("단독")">단독</MudSelectItem>
                    <MudSelectItem Value="@("세대 배송")">세대 배송</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect @bind-Value="ViewModel.서비스레벨" Label="서비스 수준" Variant="Variant.Outlined" Clearable="true">
                    <MudSelectItem Value="@("일반")">일반</MudSelectItem>
                    <MudSelectItem Value="@("당일")">당일</MudSelectItem>
                    <MudSelectItem Value="@("예약")">예약</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="ViewModel.요청사항"
                              Label="요청 사항"
                              Lines="3"
                              Variant="Variant.Outlined"
                              HelperText="@ViewModel.요청사항입력힌트"
                              Immediate="true" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (ViewModel.운송정보경고목록.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            @foreach (var warning in ViewModel.운송정보경고목록)
            {
                <div>@warning</div>
            }
        </MudAlert>
    }
</ShipperRequestScreenFrame>

@code {
    [Parameter, EditorRequired] public 운송의뢰작성ViewModel ViewModel { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestNavigationContext NavigationContext { get; set; } = new();
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter] public string Title { get; set; } = "운송 정보";
    [Parameter] public string Description { get; set; } = "상차·하차 장소와 담당자, 현장 요청 조건만 입력합니다.";
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public string RootBackHref { get; set; } = ShipperRequestPageRoutes.Root;
    [Parameter] public string RootBackLabel { get; set; } = "한 화면 입력";
    [Parameter] public EventCallback Changed { get; set; }
}
