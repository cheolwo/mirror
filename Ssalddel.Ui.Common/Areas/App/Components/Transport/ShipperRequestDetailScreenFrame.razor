@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport
@using Ssalddel.Ui.Common.Areas.App.Components.Recovery
@using Ssalddel.Contracts.Common.Workflow
@using Ssalddel.Contracts.Common.Versioning

<section class="shipper-detail-screen" data-detail-screen="@CurrentScreen.ToString().ToLowerInvariant()">
    <header class="shipper-detail-screen__header">
        <div class="shipper-detail-screen__title">
            <MudButton Href="@Context.ResolveReturnPath(HomeHref)"
                       Class="shipper-detail-screen__back"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                돌아가기
            </MudButton>
            <h1>@Title</h1>
        </div>

        <div class="shipper-detail-screen__actions">
            <MudButton Href="@NewRequestHref"
                       Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Add">
                새 의뢰
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@State.IsBusy"
                       OnClick="RefreshRequested">
                새로고침
            </MudButton>
        </div>
    </header>

    @if (State.Created && State.Request is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">
            의뢰 등록 완료
        </MudAlert>
    }

    <업무오류복구Panel Message="@QueryErrorMessage" ContextKey="@State.LookupRequestId"
                     Error="@State.QueryError"
                     Context="@(State.QueryError is not null ? QueryContext : null)"
                     Busy="@State.IsBusy" RetryRequested="RefreshRequested"
                     ReturnHref="@(State.RequiresLogin ? LoginHref : Context.ResolveReturnPath(HomeHref))"
                     ReturnLabel="@(State.RequiresLogin ? "로그인" : "업무로 돌아가기")" />

    @if (!string.IsNullOrWhiteSpace(State.StatusMessage) && QueryErrorMessage is null)
    {
        <MudAlert Severity="@ResolveSeverity(State.StatusTone)" Variant="Variant.Outlined">
            @State.StatusMessage
        </MudAlert>
    }

    @if (State.IsBusy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (State.Request is null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-detail-screen__empty">
            @if (State.RequiresLogin)
            {
                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h6">로그인이 필요합니다</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    의뢰를 등록한 계정으로 로그인해 주세요.
                </MudText>
                <MudButton Href="@LoginHref" Variant="Variant.Filled" Color="Color.Primary">로그인</MudButton>
            }
            else if (State.IsWorkflowEnabled == false)
            {
                <MudIcon Icon="@Icons.Material.Filled.ToggleOff" Color="Color.Warning" Size="Size.Large" />
                <MudText Typo="Typo.h6">현재 이용할 수 없습니다</MudText>
            }
            else if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Default" Size="Size.Large" />
                <MudText Typo="Typo.h6">@(QueryErrorMessage is not null ? "조회 미완료" : "의뢰 정보를 찾지 못했습니다")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(QueryErrorMessage is not null ? "다시 조회하거나 업무 목록으로 돌아가세요." : "의뢰 번호를 확인하고 다시 조회해 주세요.")</MudText>
            }
        </MudPaper>
    }
    else
    {
        @if (State.SourceBoundaryMessage.Contains("sample", StringComparison.OrdinalIgnoreCase))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">테스트 환경 · 예시 데이터가 포함될 수 있습니다.</MudAlert>
        }
        else if (State.SourceBoundaryMessage.Contains("합성", StringComparison.Ordinal)
                 || State.SourceBoundaryMessage.Contains("예시", StringComparison.Ordinal))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">미리보기 · 실제 운송 아님</MudAlert>
        }

        <ShipperRequestDetailNavigation RequestId="@State.Request.RequestId"
                                        Context="@Context"
                                        CurrentScreen="@CurrentScreen" />

        <main class="shipper-detail-screen__body">
            @ChildContent
        </main>
    }
</section>

@code {
    [Parameter, EditorRequired] public ShipperRequestDetailPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestDetailNavigationContext Context { get; set; } = new();
    [Parameter] public ShipperRequestDetailScreenKind CurrentScreen { get; set; }
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter, EditorRequired] public string Eyebrow { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string HomeHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NewRequestHref { get; set; } = string.Empty;
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public RenderFragment? EmptyContent { get; set; }
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    private string? QueryErrorMessage => State.QueryError is not null || 업무오류안내Presentation.조회오류인가(State.StatusMessage)
        ? State.StatusMessage : null;

    private 업무실패맥락Dto QueryContext => new(OperatingSystemIds.ShipperTransportManagement,
        CurrentScreen switch
        {
            ShipperRequestDetailScreenKind.Payment => OperatingSystemLifecycleStageIds.ShipperSettlementRecovery,
            ShipperRequestDetailScreenKind.Proofs => OperatingSystemLifecycleStageIds.ShipperDeliveryAcceptance,
            _ => OperatingSystemLifecycleStageIds.ShipperProgressChange
        }, 업무처리결과Codes.조회);

    private static Severity ResolveSeverity(ShipperRequestDetailMessageTone tone)
        => tone switch
        {
            ShipperRequestDetailMessageTone.Success => Severity.Success,
            ShipperRequestDetailMessageTone.Warning => Severity.Warning,
            ShipperRequestDetailMessageTone.Error => Severity.Error,
            _ => Severity.Info
        };
}
