@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<ShipperRequestDetailScreenFrame State="@State"
                                 Context="@Context"
                                 CurrentScreen="ShipperRequestDetailScreenKind.Proofs"
                                 ScreenCode="@ScreenCode"
                                 Eyebrow="증빙"
                                 Title="@Title"
                                 Description="@Description"
                                 HomeHref="@HomeHref"
                                 NewRequestHref="@NewRequestHref"
                                 LoginHref="@LoginHref"
                                 RefreshRequested="RefreshRequested">
    <ChildContent>
        @if (State.Request is { } item)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                사진 검수·인수증·입금은 각각 확인해 주세요.
            </MudAlert>

            @ReceiptContent

            <div class="shipper-proofs">
                @foreach (var proof in ShipperRequestDetailPresentation.BuildProofs(item))
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-proofs__card" Style="@BuildStyle(proof.State)">
                        <div class="shipper-proofs__heading">
                            <div class="shipper-proofs__title">
                                <MudIcon Icon="@ResolveIcon(proof.State)" Color="@ResolveColor(proof.State)" />
                                <MudText Typo="Typo.h6">@proof.Title</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="@ResolveColor(proof.State)" Variant="Variant.Outlined">
                                @ResolveLabel(proof.State)
                            </MudChip>
                        </div>
                        <MudText Typo="Typo.subtitle2">@proof.Status</MudText>
                        @if (!string.IsNullOrWhiteSpace(proof.Description))
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@proof.Description</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(proof.Detail))
                        {
                            <MudText Typo="Typo.caption">@proof.Detail</MudText>
                        }
                    </MudPaper>
                }
            </div>
        }
    </ChildContent>
</ShipperRequestDetailScreenFrame>

@code {
    [Parameter, EditorRequired] public ShipperRequestDetailPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestDetailNavigationContext Context { get; set; } = new();
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter] public string Title { get; set; } = "증빙";
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string HomeHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NewRequestHref { get; set; } = string.Empty;
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public RenderFragment? ReceiptContent { get; set; }

    private static Color ResolveColor(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => Color.Success,
            ShipperRequestProgressState.Active => Color.Primary,
            ShipperRequestProgressState.Attention => Color.Error,
            _ => Color.Default
        };

    private static string ResolveIcon(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => Icons.Material.Filled.Verified,
            ShipperRequestProgressState.Active => Icons.Material.Filled.PendingActions,
            ShipperRequestProgressState.Attention => Icons.Material.Filled.ReportProblem,
            _ => Icons.Material.Filled.InsertDriveFile
        };

    private static string ResolveLabel(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => "기록 있음",
            ShipperRequestProgressState.Active => "확인 대기",
            ShipperRequestProgressState.Attention => "확인 필요",
            _ => "생성 전"
        };

    private static string BuildStyle(ShipperRequestProgressState state)
        => $"border-top: 3px solid {ResolveCssColor(state)};";

    private static string ResolveCssColor(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => "var(--mud-palette-success)",
            ShipperRequestProgressState.Active => "var(--mud-palette-primary)",
            ShipperRequestProgressState.Attention => "var(--mud-palette-error)",
            _ => "var(--mud-palette-lines-default)"
        };
}
