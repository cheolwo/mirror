@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<ShipperRequestDetailScreenFrame State="@State"
                                 Context="@Context"
                                 CurrentScreen="ShipperRequestDetailScreenKind.Timeline"
                                 ScreenCode="@ScreenCode"
                                 Eyebrow="진행 이력"
                                 Title="@Title"
                                 Description="@Description"
                                 HomeHref="@HomeHref"
                                 NewRequestHref="@NewRequestHref"
                                 LoginHref="@LoginHref"
                                 RefreshRequested="RefreshRequested">
    <ChildContent>
        @if (State.Request is { } item)
        {
            <ShipperRequestNextActionPanel Item="@item" Context="@Context" CurrentScreen="ShipperRequestDetailScreenKind.Timeline" />
            <div class="shipper-timeline">
                @foreach (var step in ShipperRequestDetailPresentation.BuildTimeline(item))
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-timeline__step" Style="@BuildStyle(step.State)">
                        <MudAvatar Color="@ResolveColor(step.State)" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@ResolveIcon(step.State)" Size="Size.Small" />
                        </MudAvatar>
                        <div class="shipper-timeline__content">
                            <div class="shipper-timeline__heading">
                                <MudText Typo="Typo.h6">@step.Title</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@ResolveColor(step.State)" Variant="Variant.Outlined">
                                    @ResolveLabel(step.State)
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.subtitle2">@step.Status</MudText>
                            @if (!string.IsNullOrWhiteSpace(step.Description))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@step.Description</MudText>
                            }
                            @if (!string.IsNullOrWhiteSpace(step.Detail))
                            {
                                <MudText Typo="Typo.caption">@step.Detail</MudText>
                            }
                        </div>
                    </MudPaper>
                }
            </div>
        }
    </ChildContent>
</ShipperRequestDetailScreenFrame>

@code {
    [Parameter, EditorRequired] public ShipperRequestDetailPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestDetailNavigationContext Context { get; set; } = new();
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter] public string Title { get; set; } = "진행 이력";
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string HomeHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NewRequestHref { get; set; } = string.Empty;
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public EventCallback RefreshRequested { get; set; }

    private static Color ResolveColor(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => Color.Success,
            ShipperRequestProgressState.Active => Color.Primary,
            ShipperRequestProgressState.Attention => Color.Error,
            _ => Color.Default
        };

    private static string ResolveIcon(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => Icons.Material.Filled.Check,
            ShipperRequestProgressState.Active => Icons.Material.Filled.PlayArrow,
            ShipperRequestProgressState.Attention => Icons.Material.Filled.PriorityHigh,
            _ => Icons.Material.Filled.HourglassEmpty
        };

    private static string ResolveLabel(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => "완료",
            ShipperRequestProgressState.Active => "진행 중",
            ShipperRequestProgressState.Attention => "확인 필요",
            _ => "대기"
        };

    private static string BuildStyle(ShipperRequestProgressState state)
        => $"border-left: 4px solid {ResolveCssColor(state)};";

    private static string ResolveCssColor(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => "var(--mud-palette-success)",
            ShipperRequestProgressState.Active => "var(--mud-palette-primary)",
            ShipperRequestProgressState.Attention => "var(--mud-palette-error)",
            _ => "var(--mud-palette-lines-default)"
        };
}
