@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<ShipperRequestScreenFrame ViewModel="ViewModel"
                           NavigationContext="NavigationContext"
                           Step="ShipperRequestAuthoringStep.Review"
                           MobileStep="MobileStep"
                           ScreenCode="@ScreenCode"
                           Title="@Title"
                           Description="@Description"
                           ShowNavigation="ShowNavigation"
                           RootBackHref="@RootBackHref"
                           RootBackLabel="@RootBackLabel"
                           Changed="Changed">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <MudAlert Severity="StatusSeverity">@StatusMessage</MudAlert>
    }

    @if (MobileStep is null)
    {
        <운송의뢰작성요약Panel ViewModel="ViewModel" />
        <운송의뢰검증Panel ViewModel="ViewModel" NavigationContext="NavigationContext" />
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4"><MudStack Spacing="2">
            @foreach (var step in ShipperRequestMobileStepCatalog.Steps.Where(item => item.Step != ShipperRequestMobileStep.Review))
            {
                <section class="shipper-mobile-review-section">
                    <div><strong>@step.Title</strong><a href="@MobileHref(step.Step)">수정</a></div>
                    <p>@MobileSummary(step.Step)</p>
                </section>
            }
        </MudStack></MudPaper>
        @if (ViewModel.입력검증메시지목록.Count > 0)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4"><h3>접수 전 확인</h3>
                @foreach (var item in ViewModel.입력검증메시지목록)
                {
                    <div class="shipper-mobile-review-check"><p>@item.내용</p><a href="@MobileHref(item.MobileStep ?? FirstMobileStep(item.단계))">@(item.필수 ? "보완" : "확인")</a></div>
                }
            </MudPaper>
        }
    }

    @BeforeSubmission

    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@(MobileStep is null ? "실행 경계" : "접수 안내")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    선결제 의뢰는 접수 준비를 저장한 뒤 결제합니다. 결제가 확인되면 배차가 접수됩니다.
                </MudText>
            </MudStack>

            @if (RegistrationEnabled != true)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <span>@RegistrationBoundaryMessage</span>
                        @if (RetryRegistrationCheck.HasDelegate)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Warning" Disabled="IsBusy" OnClick="RetryRegistrationCheck">다시 확인</MudButton>
                        }
                    </MudStack>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    @RegistrationBoundaryMessage
                </MudAlert>
            }

            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.RestartAlt"
                           Disabled="IsBusy"
                           OnClick="ResetRequested">
                    초기화
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           Disabled="IsBusy"
                           OnClick="SaveRequested">
                    이 화면에 초안 유지
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.CloudUpload"
                           Disabled="@(!CanSubmit)"
                           OnClick="SubmitRequested">
                    @(IsBusy ? "처리 중" : SubmitLabel)
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
</ShipperRequestScreenFrame>

@code {
    [Parameter, EditorRequired] public 운송의뢰작성ViewModel ViewModel { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestNavigationContext NavigationContext { get; set; } = new();
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter] public ShipperRequestMobileStep? MobileStep { get; set; }
    [Parameter] public string Title { get; set; } = "최종 확인";
    [Parameter] public string Description { get; set; } = "작성한 초안과 필수 입력, 운영 경계를 확인한 뒤 사용자가 명시적으로 저장 또는 등록합니다.";
    [Parameter] public bool? RegistrationEnabled { get; set; }
    [Parameter] public string RegistrationBoundaryMessage { get; set; } = "현재 환경의 등록 가능 여부를 확인하고 있습니다. 초안은 계속 작성할 수 있습니다.";
    [Parameter] public string? StatusMessage { get; set; }
    [Parameter] public Severity StatusSeverity { get; set; } = Severity.Info;
    [Parameter] public string SubmitLabel { get; set; } = "운송 의뢰 등록";
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter] public string RootBackHref { get; set; } = ShipperRequestPageRoutes.Root;
    [Parameter] public string RootBackLabel { get; set; } = "한 화면 입력";
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback SaveRequested { get; set; }
    [Parameter] public EventCallback ResetRequested { get; set; }
    [Parameter] public EventCallback SubmitRequested { get; set; }
    [Parameter] public EventCallback RetryRegistrationCheck { get; set; }
    [Parameter] public RenderFragment? BeforeSubmission { get; set; }
    [Parameter] public bool SubmissionPrerequisiteSatisfied { get; set; } = true;

    private bool CanSubmit
        => RegistrationEnabled == true
           && SubmissionPrerequisiteSatisfied
           && ViewModel.서버등록가능
           && !IsBusy
           && SubmitRequested.HasDelegate;

    private string MobileHref(ShipperRequestMobileStep step) => NavigationContext.PathFor(step).TrimStart('/');
    private static ShipperRequestMobileStep FirstMobileStep(ShipperRequestAuthoringStep step)
        => ShipperRequestMobileStepCatalog.Steps.First(item => item.MajorStep == step).Step;
    private string MobileSummary(ShipperRequestMobileStep step) => step switch
    {
        ShipperRequestMobileStep.Cargo => $"{Display(ViewModel.화물종류)} · 수량 {ViewModel.화물수량?.ToString() ?? "미입력"} · {Display(ViewModel.화물적재형태)}",
        ShipperRequestMobileStep.Package => $"{ViewModel.화물중량Kg?.ToString("0.###") ?? "미입력"} kg · {ViewModel.화물길이Mm?.ToString() ?? "미입력"} × {ViewModel.화물폭Mm?.ToString() ?? "미입력"} × {ViewModel.화물높이Mm?.ToString() ?? "미입력"} mm",
        ShipperRequestMobileStep.Pickup => $"{Display(ViewModel.상차도로명주소)} {ViewModel.상차상세주소} · {Display(ViewModel.상차연락처이름)} · {MaskedPhone(ViewModel.상차연락처전화번호)}",
        ShipperRequestMobileStep.Dropoff => $"{Display(ViewModel.하차도로명주소)} {ViewModel.하차상세주소} · {Display(ViewModel.하차연락처이름)} · {MaskedPhone(ViewModel.하차연락처전화번호)}",
        ShipperRequestMobileStep.Schedule => $"상차 {Window(ViewModel.상차시간창시작일시, ViewModel.상차시간창종료일시)} · 하차 {Window(ViewModel.하차시간창시작일시, ViewModel.하차시간창종료일시)} (한국시간)",
        ShipperRequestMobileStep.Vehicle => $"{Display(ViewModel.차량종류)} · {Display(ViewModel.운송방식)}",
        ShipperRequestMobileStep.Payment => $"{Display(ViewModel.결제수단)} · 예정 {ViewModel.결제예정금액?.ToString("N0") ?? "미입력"}원",
        _ => "입력 내용을 확인해 주세요."
    };
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "미입력" : value;
    private static string MaskedPhone(string? value)
    { var digits = new string((value ?? "").Where(char.IsDigit).ToArray()); return digits.Length > 4 ? "***-****-" + digits[^4..] : "연락처 미입력"; }
    private static string Window(DateTime? start, DateTime? end) => start is null && end is null ? "미지정" : $"{start?.ToString("MM.dd HH:mm") ?? "시작 미입력"} ~ {end?.ToString("HH:mm") ?? "종료 미입력"}";
}
