@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<ShipperRequestDetailScreenFrame State="@State"
                                 Context="@Context"
                                 CurrentScreen="ShipperRequestDetailScreenKind.Payment"
                                 ScreenCode="@ScreenCode"
                                 Eyebrow="결제"
                                 Title="@Title"
                                 Description="@Description"
                                 HomeHref="@HomeHref"
                                 NewRequestHref="@NewRequestHref"
                                 LoginHref="@LoginHref"
                                 RefreshRequested="RefreshRequested">
    <ChildContent>
        @if (State.Request is { } item)
        {
            <div class="shipper-payment">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-payment__summary">
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary">결제 상태</MudText>
                        <MudText Typo="Typo.h5">@ShipperRequestDetailPresentation.Display(item.PaymentStatus)</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@ShipperRequestDetailPresentation.Display(item.PaymentMethod)</MudText>
                    </div>
                    <MudChip T="string"
                             Color="@ResolveColor(ShipperRequestDetailPresentation.ResolvePaymentState(item))"
                             Variant="Variant.Filled">
                        @ResolveLabel(ShipperRequestDetailPresentation.ResolvePaymentState(item))
                    </MudChip>
                </MudPaper>

                <div class="shipper-payment__grid">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-payment__card">
                        <MudText Typo="Typo.h6">수납 조건</MudText>
                        <dl>
                            <div><dt>결제 예정</dt><dd>@ShipperRequestDetailPresentation.Money(item.ExpectedPaymentAmount)</dd></div>
                            <div><dt>최종 운임</dt><dd>@ShipperRequestDetailPresentation.Money(item.FinalFare)</dd></div>
                            <div><dt>정산 시점</dt><dd>@ShipperRequestDetailPresentation.Display(item.SettlementTiming)</dd></div>
                            <div><dt>수납 주체</dt><dd>@ShipperRequestDetailPresentation.Display(item.CollectionOwner)</dd></div>
                            <div><dt>정산 상태</dt><dd>@ShipperRequestDetailPresentation.Display(item.SettlementStatus)</dd></div>
                            <div><dt>현장 확인</dt><dd>@DisplayDateTime(item.OnSiteCollectionConfirmedAt)</dd></div>
                        </dl>
                    </MudPaper>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 shipper-payment__card">
                        @if (item.SettlementTiming == "선결제")
                        {
                            <ShipperPrepaymentPanel RequestId="@item.RequestId" Confirmed="RefreshRequested" />
                        }
                        else
                        {
                        <MudText Typo="Typo.h6">테스트 결제</MudText>
                        @if (Receipt is not null)
                        {
                            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                                @Receipt.PaymentMethod · @Receipt.Amount.ToString("N0")원 · @Receipt.PaymentStatus
                            </MudAlert>
                            <MudText Typo="Typo.body2">승인번호 @Receipt.ReceiptId</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Receipt.ApprovedAt.ToString("yyyy-MM-dd HH:mm") · @Receipt.SettlementMode</MudText>
                        }
                        else if (SimulationAvailable)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                실제 결제·송금은 발생하지 않습니다.
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.CreditCard"
                                       Disabled="@(!item.CanPay || PaymentAmount <= 0)"
                                       OnClick="OpenSimulationRequested">
                                테스트 결제
                            </MudButton>
                            @if (!item.CanPay)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">현재 결제 조건과 이전 요청의 확인 상태를 살펴봐 주세요.</MudText>
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                결제 상태 조회만 가능합니다.
                            </MudAlert>
                        }
                        }
                    </MudPaper>
                </div>
            </div>
        }
    </ChildContent>
</ShipperRequestDetailScreenFrame>

@if (PaymentWindowOpen && State.Request is { } paymentItem)
{
    <div class="shipper-payment__backdrop" role="dialog" aria-modal="true" aria-labelledby="shipper-payment-title">
        <MudPaper Elevation="8" Class="pa-4 shipper-payment__window">
            <div class="shipper-payment__window-header">
                <div>
                    <MudText Typo="Typo.h6" id="shipper-payment-title">테스트 결제</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Default"
                               Disabled="@PaymentCompleting"
                               OnClick="CloseSimulationRequested" />
            </div>

            <MudPaper Elevation="0" Class="pa-3 shipper-payment__amount">
                <MudText Typo="Typo.caption" Color="Color.Secondary">결제 금액</MudText>
                <MudText Typo="Typo.h5">@PaymentAmount.ToString("N0")원</MudText>
            </MudPaper>

            <SsalddelPaymentCheckoutPanel TargetType="20"
                                         TargetId="@paymentItem.RequestId"
                                         ProviderType="990"
                                         Amount="@PaymentAmount"
                                         OrderName="@PaymentOrderName"
                                         PaymentMethod="@PaymentMethod"
                                         PaymentMethodChanged="PaymentMethodChanged"
                                         SettlementMode="@SettlementMode"
                                         SettlementModeChanged="SettlementModeChanged"
                                         AllowMonthlySettlement="false"
                                         AllowSubscription="false"
                                         Disabled="@PaymentCompleting"
                                         PaymentRequested="PaymentRequested" />

            <MudTextField T="string"
                          Label="메모"
                          Variant="Variant.Outlined"
                          Lines="2"
                          Value="@PaymentMemo"
                          ValueChanged="PaymentMemoChanged"
                          Disabled="@PaymentCompleting"
                          Placeholder="결제 메모 (선택)" />

            <MudAlert Severity="Severity.Info" Dense="true">
                테스트 기록만 저장됩니다. 실제 결제·송금은 발생하지 않습니다.
            </MudAlert>
        </MudPaper>
    </div>
}

@code {
    [Parameter, EditorRequired] public ShipperRequestDetailPageState State { get; set; } = default!;
    [Parameter, EditorRequired] public ShipperRequestDetailNavigationContext Context { get; set; } = new();
    [Parameter] public string? ScreenCode { get; set; }
    [Parameter] public string Title { get; set; } = "결제";
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string HomeHref { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NewRequestHref { get; set; } = string.Empty;
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public bool SimulationAvailable { get; set; }
    [Parameter] public bool PaymentWindowOpen { get; set; }
    [Parameter] public bool PaymentCompleting { get; set; }
    [Parameter] public int PaymentAmount { get; set; }
    [Parameter] public string PaymentOrderName { get; set; } = "살뜰 운송 의뢰";
    [Parameter] public string PaymentMethod { get; set; } = PaymentMethodCode.TossCard;
    [Parameter] public string SettlementMode { get; set; } = SettlementModeCode.Prepaid;
    [Parameter] public string? PaymentMemo { get; set; }
    [Parameter] public ShipperRequestPaymentReceiptPresentation? Receipt { get; set; }
    [Parameter] public EventCallback OpenSimulationRequested { get; set; }
    [Parameter] public EventCallback CloseSimulationRequested { get; set; }
    [Parameter] public EventCallback<string> PaymentMethodChanged { get; set; }
    [Parameter] public EventCallback<string> SettlementModeChanged { get; set; }
    [Parameter] public EventCallback<string> PaymentMemoChanged { get; set; }
    [Parameter] public EventCallback<PaymentRequestPlan> PaymentRequested { get; set; }

    private static Color ResolveColor(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => Color.Success,
            ShipperRequestProgressState.Active => Color.Primary,
            ShipperRequestProgressState.Attention => Color.Error,
            _ => Color.Default
        };

    private static string ResolveLabel(ShipperRequestProgressState state)
        => state switch
        {
            ShipperRequestProgressState.Completed => "확보됨",
            ShipperRequestProgressState.Active => "처리 대기",
            ShipperRequestProgressState.Attention => "확인 필요",
            _ => "조건 확인"
        };

    private static string DisplayDateTime(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-";
}
