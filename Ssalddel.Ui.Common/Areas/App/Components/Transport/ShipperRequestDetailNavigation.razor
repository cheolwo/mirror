@namespace Ssalddel.Ui.Common.Areas.App.Components.Transport

<nav class="shipper-detail-nav" aria-label="운송 의뢰 상세 화면">
    @foreach (var item in Items)
    {
        <a class="@BuildClass(item.Screen)"
           href="@Context.PathFor(item.Screen, RequestId)"
           aria-current="@(item.Screen == CurrentScreen ? "page" : null)">
            <MudIcon Icon="@item.Icon" Size="Size.Small" />
            <span>
                <strong>@item.Label</strong>
            </span>
        </a>
    }
</nav>

@code {
    [Parameter, EditorRequired] public string RequestId { get; set; } = string.Empty;
    [Parameter, EditorRequired] public ShipperRequestDetailNavigationContext Context { get; set; } = new();
    [Parameter] public ShipperRequestDetailScreenKind CurrentScreen { get; set; }

    private static readonly IReadOnlyList<DetailNavigationItem> Items =
    [
        new(ShipperRequestDetailScreenKind.Summary, "요약", "의뢰·경로", Icons.Material.Filled.Description),
        new(ShipperRequestDetailScreenKind.Timeline, "진행 이력", "결제부터 정산", Icons.Material.Filled.Timeline),
        new(ShipperRequestDetailScreenKind.Payment, "결제", "수납", Icons.Material.Filled.Payments),
        new(ShipperRequestDetailScreenKind.Proofs, "증빙", "POD·인수증", Icons.Material.Filled.FactCheck)
    ];

    private string BuildClass(ShipperRequestDetailScreenKind screen)
        => screen == CurrentScreen
            ? "shipper-detail-nav__item shipper-detail-nav__item--active"
            : "shipper-detail-nav__item";

    private sealed record DetailNavigationItem(
        ShipperRequestDetailScreenKind Screen,
        string Label,
        string Description,
        string Icon);
}
