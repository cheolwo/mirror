@namespace Ssalddel.Ui.Common.Areas.App.Components.Fulfillment
@using Ssalddel.Ui.Common.Areas.App.ViewModels
<section class="auto-fulfillment-conditions" aria-labelledby="@HeadingId">
    <h3 id="@HeadingId">자동 배송 접수 조건</h3>
    <p>플랫폼이 완료 시간 조건을 충족하는 처리처 중 총비용이 낮은 곳을 정합니다. 비용이 같으면 더 빠른 곳을 우선합니다.</p>
    @if (FoodOrder)
    {
        <section class="auto-fulfillment-cost-conditions" aria-label="내 배송비 조건">
            <h4>내 배송비 조건</h4>
            <p>음식점 조건 · <strong>@DeliveryCostSharingPresentation.Summary(Model.CostSharingPolicy, Model.MerchantContributionKrw)</strong></p>
            <p>주문 전체 누적 배송비에 이 정책을 한 번 적용합니다. 아래 상한은 내 최종 부담액입니다.</p>
            <label>본인 부담 상한 (원)<input aria-label="본인 부담 상한 (원)" type="number" min="0" step="1" @bind="Model.MaximumUserChargeKrw" disabled="@Disabled" /></label>
            <DeliveryCostSharingExample Policy="Model.CostSharingPolicy" CustomerMaximumKrw="Model.MaximumUserChargeKrw" />
        </section>
        <h4>자동 배송 처리 조건</h4>
    }
    else
    { <label>본인 부담 상한 (원)<input aria-label="본인 부담 상한 (원)" type="number" min="0" step="1" @bind="Model.MaximumUserChargeKrw" disabled="@Disabled" /></label> }
    <label>희망 완료 시각<input aria-label="희망 완료 시각" type="datetime-local" @bind="Model.DesiredCompletionLocal" disabled="@Disabled" /></label>
    <fieldset disabled="@Disabled"><legend>자동 접수를 허용할 처리처</legend>
        @if (Model.Providers.Count == 0) { <p role="status">현재 허용 가능한 처리처가 없습니다. 조건을 다시 확인해 주세요.</p> }
        @foreach (var provider in Model.Providers)
        { <label class="auto-fulfillment-check"><input type="checkbox" checked="@Model.Allows(provider.Id)" @onchange="args => Model.SetAllowed(provider.Id, args.Value is true)" /><span>@provider.Name@(provider.IsSimulation ? " · 모의" : "")</span></label> }
    </fieldset>
    @if (Model.HasAssumedProvider) { <p class="auto-fulfillment-warning">가정 연결 검증용입니다. 표시되는 모의 비용·예상 시간은 실제 업체 요금이나 도착 약속이 아니며, 실제 업체로 정보를 보내지 않습니다.</p> }
    <label class="auto-fulfillment-check"><input type="checkbox" @bind="Model.ProviderInformationSharingAgreed" disabled="@Disabled" /><span>허용한 처리처에 픽업·전달 주소, 담당자 연락처와 요청 사항을 배송 목적으로 제공하는 데 동의합니다.</span></label>
    @if (Model.RequiredDirectPayment && Model.Allows("internal"))
    { <label class="auto-fulfillment-check"><input type="checkbox" @bind="Model.DirectPaymentAgreed" disabled="@Disabled" /><span>자체 배차가 선정되면 확인된 본인 부담 배송비를 기사에게 직접 지급하는 조건에 동의합니다. 실제 지급은 따로 확인합니다.</span></label> }
    <label class="auto-fulfillment-check"><input type="checkbox" @bind="Model.AutomaticSubmissionAgreed" disabled="@Disabled" /><span>위 비용·시간·처리처 조건 안에서 자동 접수와 확정 실패·취소 완료 후 재선정에 동의합니다.</span></label>
    <p class="auto-fulfillment-note">누적 발생 비용도 상한에 포함합니다. 결과·취소 비용이 미확정이거나 기한이 지나면 새 접수를 멈춥니다. 모의 수행은 실제 업체 배차·청구·지급이 아닙니다.</p>
</section>
@code {
    [Parameter, EditorRequired] public AutoFulfillmentConditionsViewModel Model { get; set; } = null!;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool FoodOrder { get; set; }
    [Parameter] public string HeadingId { get; set; } = "auto-fulfillment-conditions-title";
}
