@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Core
@using Ssalddel.Contracts.Admin.BusinessPackages
@inject NavigationManager Navigation

<main class="role-selection-home">
    <header class="role-selection-home__header">
        <h1>생산에 참여해 보세요.</h1>
    </header>
    <HomeParticipationOverview DetailsHref="@Href("/overview/participation")" />
    <공간공동운영HomeOverview DetailsHref="@Href(공간공동운영Routes.Home)" />
    <h2 id="role-work-entry-title" class="role-selection-home__entry-title">업무 시작</h2>
    <a class="role-selection-home__driver-work" href="@Href("/driver/current-work")"><MudIcon Icon="@Icons.Material.Filled.Assignment" />기사 · 지금 할 일<MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" /></a>
    <nav class="role-selection-home__groups" aria-label="활동 역할 선택" aria-describedby="role-work-entry-title">
        @foreach (var group in RoleWorkspaceHomeCatalog.Groups)
        {
            <section class="role-selection-home__group @(group.Key == "other" ? "role-selection-home__group--other" : "")"
                     data-business="@group.Key" aria-labelledby="@($"role-group-{group.Key}")">
                <h3 id="@($"role-group-{group.Key}")">@group.Label</h3>
                <div class="role-selection-home__roles">
                    @foreach (var role in group.Entries)
                    {
                        var selected = IsSelected(group, role);
                        <a class="role-selection-home__role @(selected ? "is-selected" : "")"
                           href="@Href(role.Href)" data-role="@role.RoleKey" data-business="@group.Key"
                           aria-current="@(selected ? "page" : null)">
                            <span class="role-selection-home__icon"><MudIcon Icon="@role.Icon" /></span>
                            <span class="role-selection-home__copy"><strong>@role.Label</strong><small>@role.Description</small></span>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
                        </a>
                    }
                </div>
            </section>
        }
    </nav>
    <footer class="role-selection-home__footer" aria-label="이용 안내">
        @if (ShowQuickIntroduction)
        {
            <a class="role-selection-home__quick" href="@Href("/services")">처음이라면, 서비스 이용 안내 <span aria-hidden="true">→</span></a>
        }
        <p class="role-selection-home__commerce">Mirror는 통신판매중개자이며 상품·서비스 거래의 당사자가 아닙니다. 거래 전 계약 당사자와 조건을 확인하세요. <a href="@Href("/commerce/notices")">거래·개인정보 안내</a></p>
    </footer>
</main>

@code {
    [Parameter] public string? SelectedRoleKey { get; set; }
    [Parameter] public string? SelectedBusinessCode { get; set; }
    [Parameter] public bool IntegratedRoot { get; set; }
    [Parameter] public bool ShowQuickIntroduction { get; set; }
    private bool IsSelected(RoleWorkspaceHomeGroup group, RoleWorkspaceHomeEntry role)
        => string.Equals(role.RoleKey, SelectedRoleKey, StringComparison.OrdinalIgnoreCase)
           && (role.RoleKey != RoleWorkspaceCatalog.Operator
               || group.Key == (string.Equals(SelectedBusinessCode, BusinessPackageCatalog.FreightDelivery, StringComparison.OrdinalIgnoreCase)
                   ? BusinessPackageCatalog.FreightDelivery : BusinessPackageCatalog.FoodDelivery));
    private string Href(string route) => IntegratedRoot
        ? new Uri(new Uri(new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority) + "/"), route.TrimStart('/')).ToString()
        : Navigation.ToAbsoluteUri(route.TrimStart('/')).ToString();
}
