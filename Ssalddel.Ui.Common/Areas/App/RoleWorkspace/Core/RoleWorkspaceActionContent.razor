@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Core

<span class="role-workspace-action-content">
    @if (RoleWorkspaceActionIconResolver.Resolve(ActionKey) is { } icon)
    {
        <MudIcon Icon="@icon" Size="Size.Small" Color="Color.Inherit" aria-hidden="true"
            Style="color:currentColor;width:1.125rem;height:1.125rem;flex:0 0 auto;" />
    }
    <span class="role-workspace-action-content__label">@Label</span>
</span>

@code {
    [Parameter] public string? ActionKey { get; set; }
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
}
