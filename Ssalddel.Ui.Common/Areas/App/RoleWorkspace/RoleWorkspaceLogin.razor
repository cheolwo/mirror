@using Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Core
@implements IDisposable
@inject IRoleWorkspaceAccess Access
@inject NavigationManager Navigation

<main class="role-login">
    <h1 id="@TitleId">@(RoleWorkspaceCatalog.Find(RoleKey)?.Label ?? "활동") 로그인</h1>
    <form class="role-login__form" aria-labelledby="@TitleId" aria-busy="@(_busy ? "true" : "false")"
          @onsubmit="SignIn" @onsubmit:preventDefault="true">
        <div class="role-login__field">
            <label for="@NameId">아이디</label>
            <input id="@NameId" class="role-login__input" name="username" type="text" autocomplete="username"
                   autocapitalize="none" spellcheck="false" @bind="_name" disabled="@_busy"
                   aria-describedby="@(_error is not null ? ErrorId : null)" />
        </div>
        <div class="role-login__field">
            <label for="@PasswordId">비밀번호</label>
            <input id="@PasswordId" class="role-login__input" name="password" type="password" autocomplete="current-password"
                   @bind="_password" disabled="@_busy" aria-describedby="@(_error is not null ? ErrorId : null)" />
        </div>
        @if (_error is not null) { <p id="@ErrorId" class="role-login__error" role="alert">@_error</p> }
        <div class="role-login__actions">
            <button class="role-login__submit" type="submit" disabled="@_busy">@(_busy ? "로그인 중" : "로그인")</button>
            <button class="role-login__cancel" type="button" @onclick="Cancel">취소</button>
        </div>
    </form>
</main>
@code {
    [Parameter] public string RoleKey { get; set; } = "community";
    [Parameter] public string? ReturnUrl { get; set; }
    private readonly string _formId = "role-login-" + Guid.NewGuid().ToString("N");
    private string TitleId => _formId + "-title";
    private string NameId => _formId + "-name";
    private string PasswordId => _formId + "-password";
    private string ErrorId => _formId + "-error";
    private string _name = "", _password = "";
    private string? _error;
    private bool _busy, _disposed;
    private readonly CancellationTokenSource _lifetime = new();
    private string ReturnPath => SafeReturn(ReturnUrl) ?? $"/workspace/{RoleWorkspaceCatalog.Find(RoleKey)?.Key ?? "community"}";
    private string? SafeReturn(string? path)
        => Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Cargo.CargoPublicBrowseNavigation.LoginReturn(RoleKey, path);
    private async Task SignIn()
    {
        if (_busy || _disposed) return;
        _busy = true; _error = null;
        try { await Access.SignInAsync(RoleKey, _name, _password, _lifetime.Token); if (!_disposed) Navigation.NavigateTo(ReturnPath); }
        catch (OperationCanceledException) { }
        catch (Exception) { if (!_disposed) _error = "로그인하지 못했습니다. 아이디와 비밀번호를 확인한 뒤 다시 시도해 주세요."; }
        finally { _password = ""; _busy = false; }
    }
    private void Cancel() { _lifetime.Cancel(); _password = ""; Navigation.NavigateTo(ReturnPath); }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); _password = ""; }
}
