@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DistributedFulfillment
@using Ssalddel.Contracts.Common.Warehouse
<div class="work-photo" aria-label="완료 사진 촬영과 전송">
    <h3>@Title 사진</h3><p>물품과 적재·전달 위치가 보이게 촬영해 주세요. 얼굴·연락처·주문 라벨은 담지 마세요.</p>
    @if (!Model.Photo.CaptureSupported) { <p class="notice">이 화면에서는 카메라 촬영을 지원하지 않습니다. 모바일 앱에서 촬영해 주세요.</p> }
    @for (var index = 0; index < Model.Photo.Photos.Count; index++)
    {
        var photoIndex = index; var photo = Model.Photo.Photos[index];
        <figure><img src="@photo.PreviewUrl" alt="보내기 전 완료 사진 @(index + 1)" /><figcaption>사진 @(index + 1)</figcaption>
            <button type="button" disabled="@Model.PhotoInputsLocked" @onclick="() => Retake(photoIndex)">이 사진 다시 촬영</button>
            <button type="button" disabled="@Model.PhotoInputsLocked" @onclick="() => Model.RemovePhoto(photoIndex)">사진 제거</button></figure>
    }
    <button type="button" disabled="@(!Model.Photo.CaptureSupported || Model.PhotoInputsLocked || !Model.CanEdit || Model.Photo.Photos.Count >= 3 || Work is null)" @onclick="Capture">@(Model.Photo.HasPhotos ? "사진 추가 촬영" : "사진 촬영")</button>
    <p>JPEG·PNG 1~3장, 한 장당 5MB 이하입니다. 사진만 전송해도 업무가 완료되지는 않습니다.</p>
    @if (Model.Photo.FullyUploaded) { <p role="status">사진 저장은 확인됐습니다. 같은 물품·수량의 완료 기록을 확인합니다.</p> }
    <button class="primary" type="button" disabled="@(!Confirmed || !Model.Photo.HasPhotos || !Model.CanEdit || Work is null)" @onclick="() => Model.CompletePhotoAsync(Confirmed)">사진 보내고 @Title 완료</button>
</div>
@code {
    [Parameter, EditorRequired] public 분산이행PageViewModel Model { get; set; } = default!;
    [Parameter] public DistributedEvidenceWorkRequest? Work { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Action { get; set; } = "";
    [Parameter] public string Suffix { get; set; } = "";
    [Parameter] public IReadOnlyList<string> AllowedActions { get; set; } = [];
    [Parameter] public int? Quantity { get; set; }
    [Parameter] public bool Confirmed { get; set; }
    private string? workDigest;
    protected override void OnParametersSet()
    {
        var digest = Work is null ? null : DistributedEvidenceDigests.Payload(Work);
        if (workDigest != digest && workDigest is not null) Model.ClearPhotos();
        workDigest = digest;
    }
    private Task Capture() => Work is null ? Model.InvalidInputAsync("먼저 실제 위치·상품·수량을 확인해 주세요.") : Model.CapturePhotoAsync(Work, Title, Action, Suffix, AllowedActions, Quantity);
    private async Task Retake(int index) { Model.RemovePhoto(index); await Capture(); }
}
