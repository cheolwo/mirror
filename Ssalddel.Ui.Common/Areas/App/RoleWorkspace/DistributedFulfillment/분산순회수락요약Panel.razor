@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DistributedFulfillment
@using Ssalddel.Contracts.Common.Warehouse

@if (Wave is { } current)
{
    <div class="round-acceptance-summary" role="group" aria-label="수락 전 작업·보수 확인">
        <h3>작업·보수 확인</h3>
        <p class="round-acceptance-scope">@분산순회수락요약표시.작업범위(current)</p>
        <dl class="round-acceptance-facts">
            <div><dt>제안 운임</dt><dd>@분산순회수락요약표시.운임(current.OfferedDriverFareKrw)</dd></div>
            <div><dt>계획 거리</dt><dd>@분산순회수락요약표시.거리(current.TotalDistanceKm)</dd></div>
            <div><dt>계획 소요</dt><dd>@분산순회수락요약표시.소요(current.TotalElapsedMinutes)</dd></div>
            <div><dt>피킹 보수</dt><dd>포함·별도 여부 확인 필요</dd></div>
        </dl>
        <p class="round-acceptance-note">직접 피킹 선택은 포장 동의가 아닙니다. 포장 작업·보수는 별도로 확인하세요.</p>
        @if (분산순회수락요약표시.약정확인경로(current, ReturnHref) is { } href)
        {
            <a class="round-acceptance-link" href="@href">내 활동·정산 약정 확인 <span aria-hidden="true">→</span></a>
        }
        <p class="round-acceptance-note">제안 운임은 입금·실지급 완료를 뜻하지 않습니다.</p>
    </div>
}

@code {
    [Parameter] public DistributedWaveDto? Wave { get; set; }
    [Parameter] public string? ReturnHref { get; set; }
}
