@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DistributedFulfillment
@using Ssalddel.Contracts.Common.Warehouse
<div class="inbound-visual">
    <section aria-label="잔여 재고 반출 합의">
        <h2 class="inbound-section-heading"><분산입고Icon Kind="space" />잔여 재고 정리</h2>
        <p>공간 제공자와 물품 소유자가 처리 방법·수량·담당자·조건에 각각 동의합니다. 정상 반출과 불량 폐기·실사 소실 정정을 구분하며 예약하거나 운송 중인 물품은 기존 주문의 취소·반환부터 확인해 주세요.</p>
        @if (Model.Workspace?.StockReleases.Count == 0) { <p>본인에게 연결된 반출 합의가 없습니다.</p> }
        <label>반출 합의<select @bind="releaseId" @bind:after="SelectionChanged" disabled="@(!Model.CanEdit || Model.Photo.HasPhotos)"><option value="">합의를 선택해 주세요</option>
            @foreach (var item in Model.Workspace?.StockReleases ?? []) { <option value="@item.ReleaseId">@item.SiteLabel · @item.ProductLabel · @ReleaseStatus(item.StatusCode)</option> }</select></label>
        @if (Release is { } release)
        {
            <h3>@release.SiteLabel · @release.ProductLabel</h3>
            <p><strong>@ResolutionLabel(release.ResolutionKind)</strong></p>
            <p>@ReleaseStatus(release.StatusCode, release.ResolutionKind) · 합의 @release.AgreedQuantity 개 · 처리 확인 @release.ReleasedQuantity 개</p>
            <p>다음 담당 · @release.NextActorLabel</p><p>@release.HandoverTerms</p>
            <p>공간 제공자 @(release.SpaceOwnerConsented ? "동의" : "미동의") · 물품 소유자 @(release.GoodsOwnerConsented ? "동의" : "미동의")</p>
            @if (Model.Allows("consent-stock-release", release.AllowedActions))
            {
                <label class="check"><input type="checkbox" @bind="consentConfirmed" disabled="@(!Model.CanEdit)" />본인의 처리 조건·담당자·수량을 확인했습니다</label>
                <button class="primary" type="button" disabled="@(!consentConfirmed || !Model.CanEdit)" @onclick="() => Consent(false)">@(MyConsent(release) ? "내 동의 철회" : "처리 조건에 동의")</button>
                <button type="button" disabled="@(!consentConfirmed || !Model.CanEdit)" @onclick="() => Consent(true)">남은 반출 협의 취소</button>
            }
            @if (Model.Allows("handover-stock-release", release.AllowedActions))
            {
                <p>@release.PickupInstructions</p>
                <label>현장 적재대 바코드<input @bind="barcode" disabled="@Model.PhotoInputsLocked" autocomplete="off" /></label>
                <label>이번에 확인한 처리 수량<input type="number" min="1" max="@(release.AgreedQuantity - release.ReleasedQuantity)" @bind="quantity" disabled="@Model.PhotoInputsLocked" /></label>
                @if (DistributedStockResolutionKinds.Normalize(release.ResolutionKind) != DistributedStockResolutionKinds.Handover)
                {
                    <p>합의한 재고에서만 수량을 줄입니다. 반환·재입고·손실 배상이나 지급이 완료됐다는 뜻은 아닙니다.</p>
                    <label>실제 폐기 또는 실사 확인 근거<input @bind="resolutionEvidence" disabled="@Model.PhotoInputsLocked" placeholder="확인 기록·처리 문서의 참조" /></label>
                }
                <label class="check"><input type="checkbox" @bind="handoverConfirmed" disabled="@Model.PhotoInputsLocked" />합의한 처리 방법과 현장 수량·근거를 확인했습니다</label>
                <분산사진업무Screen Model="Model" Work="HandoverWork" Title="@(ResolutionLabel(release.ResolutionKind))" Action="handover-stock-release"
                    Suffix="@($"sites/{분산이행Client.Segment(release.SiteId)}/stock-release-handovers")" AllowedActions="release.AllowedActions" Quantity="quantity" Confirmed="handoverConfirmed" />
            }
        }
    </section>
    @if (Model.Workspace?.StockReleaseCandidates is { Count: > 0 } candidates)
    {
        <section aria-label="새 반출 조건 제안"><h2>반출 조건 제안</h2>
            <label>내가 협의할 물품<select @bind="candidateId" @bind:after="SelectionChanged" disabled="@(!Model.CanEdit)"><option value="">물품을 선택해 주세요</option>
                @foreach (var item in candidates) { <option value="@item.LotId">@item.SiteLabel · @item.ProductLabel · 가용 @item.AvailableQuantity 개 · 불량 @item.DamagedQuantity 개</option> }</select></label>
            @if (Candidate is { } candidate)
            {
                <label>반출 담당자<select @bind="assigneeId" disabled="@(!Model.CanEdit)"><option value="">담당자를 선택해 주세요</option>
                    @foreach (var person in candidate.AssigneeCandidates) { <option value="@person.UserId">@person.Label</option> }</select></label>
                <label>처리 방법<select @bind="resolutionKind" @bind:after="ResolutionChanged" disabled="@(!Model.CanEdit)">
                    <option value="handover">정상 물품 반출</option><option value="damaged-disposal">불량 물품 폐기 확인</option>
                    <option value="available-shortage">가용 재고의 실사 소실 정정</option><option value="damaged-shortage">불량 재고의 실사 소실 정정</option>
                </select></label>
                <label>합의할 수량<input type="number" min="1" max="@ProposalMaximum" @bind="proposalQuantity" disabled="@(!Model.CanEdit)" /></label>
                <label>처리 조건<textarea @bind="terms" disabled="@(!Model.CanEdit)" placeholder="누가 어떤 방법으로 처리할지 확인한 조건"></textarea></label>
                <label>반출 사유<textarea @bind="reason" disabled="@(!Model.CanEdit)"></textarea></label>
                <label class="check"><input type="checkbox" @bind="proposalConfirmed" disabled="@(!Model.CanEdit)" />실제 소유 관계와 제안 내용을 확인했습니다</label>
                <button class="primary" type="button" disabled="@(!Model.CanEdit || !proposalConfirmed)" @onclick="Propose">반출 조건 보내기</button>
            }
        </section>
    }
    @if (CloseSites.Count > 0)
    {
        <section aria-label="보관 공간 사용 종료"><h2>보관 공간 사용 종료</h2>
            <label>종료할 공간<select @bind="closeSiteId" @bind:after="SelectionChanged" disabled="@(!Model.CanEdit)"><option value="">공간을 선택해 주세요</option>
                @foreach (var candidate in CloseSites) { <option value="@candidate.SiteId">@candidate.PublicLabel</option> }</select></label>
        @if (CloseSiteSelection is { } site)
        {
            <h3>@site.PublicLabel 사용 종료</h3>
            <p>반출 합의를 마쳐도 공간 사용이 자동으로 종료되지는 않습니다. 남은 재고·예약·불량 물품·기사 보관량을 다시 확인합니다.</p>
            <label>정리 확인 근거<input @bind="closeEvidence" disabled="@(!Model.CanEdit)" /></label>
            <label class="check"><input type="checkbox" @bind="closeConfirmed" disabled="@(!Model.CanEdit)" />현장에 남은 물품과 보관 중인 물품이 없음을 확인했습니다</label>
            <button type="button" disabled="@(!Model.CanEdit || !closeConfirmed || string.IsNullOrWhiteSpace(closeEvidence))" @onclick="() => CloseSite(site)">재고·보관량 확인 후 공간 사용 종료</button>
        }
        </section>
    }
</div>
@code {
    [Parameter, EditorRequired] public 분산이행PageViewModel Model { get; set; } = default!;
    private string releaseId = "", candidateId = "", assigneeId = "", barcode = "", terms = "", reason = "", closeEvidence = "", closeSiteId = "", resolutionEvidence = "";
    private string resolutionKind = DistributedStockResolutionKinds.Handover;
    private string? context;
    private int quantity = 1, proposalQuantity = 1;
    private bool consentConfirmed, handoverConfirmed, proposalConfirmed, closeConfirmed;
    private DistributedStockReleaseDto? Release => Model.Workspace?.StockReleases.SingleOrDefault(x => x.ReleaseId == releaseId);
    private DistributedStockReleaseCandidateDto? Candidate => Model.Workspace?.StockReleaseCandidates.SingleOrDefault(x => x.LotId == candidateId);
    private int ProposalMaximum => Candidate is not { } c ? 0 : DistributedStockResolutionKinds.UsesDamagedStock(resolutionKind) ? c.DamagedQuantity : c.AvailableQuantity;
    private IReadOnlyList<DistributedSiteDto> CloseSites => (Model.Workspace?.Sites ?? []).Where(x => x.AllowedActions.Contains("close-site")).ToArray();
    private DistributedSiteDto? CloseSiteSelection => CloseSites.SingleOrDefault(x => x.SiteId == closeSiteId);
    protected override void OnParametersSet()
    {
        var next = $"{Model.CurrentUserId}|{releaseId}|{Release?.SiteRevision}|{candidateId}|{Candidate?.SiteRevision}|{closeSiteId}|{CloseSiteSelection?.Revision}";
        if (context == next) return;
        context = next; consentConfirmed = handoverConfirmed = proposalConfirmed = closeConfirmed = false;
        if (!Model.PhotoInputsLocked) { barcode = resolutionEvidence = ""; quantity = 1; }
    }
    private void SelectionChanged()
    {
        consentConfirmed = handoverConfirmed = proposalConfirmed = closeConfirmed = false;
        assigneeId = terms = reason = closeEvidence = ""; proposalQuantity = 1;
        resolutionKind = DistributedStockResolutionKinds.Handover;
        if (!Model.PhotoInputsLocked) { barcode = resolutionEvidence = ""; quantity = 1; }
    }
    private void ResolutionChanged() { proposalQuantity = 1; proposalConfirmed = false; }
    private bool MyConsent(DistributedStockReleaseDto release) => Model.CurrentUserId == release.SpaceOwnerUserId ? release.SpaceOwnerConsented : release.GoodsOwnerConsented;
    private Task Consent(bool cancel) => Release is { } r ? Model.ExecuteAsync(cancel ? "cancel-stock-release" : "consent-stock-release",
        $"sites/{분산이행Client.Segment(r.SiteId)}/stock-release-consents", new DistributedStockReleaseConsentRequest
        { ExpectedRevision = r.SiteRevision, ReleaseId = r.ReleaseId, Granted = !cancel && !MyConsent(r), CancelRemaining = cancel },
        r.SiteId, r.AllowedActions, consentConfirmed) : Task.CompletedTask;
    private Task Propose()
    {
        if (Candidate is not { } c || proposalQuantity <= 0 || proposalQuantity > ProposalMaximum
            || !c.AssigneeCandidates.Any(x => x.UserId == assigneeId) || string.IsNullOrWhiteSpace(terms) || string.IsNullOrWhiteSpace(reason))
            return Model.InvalidInputAsync("실제 물품·수량·담당자와 인계 조건을 확인해 주세요.");
        return Model.ExecuteAsync("propose-stock-release", $"sites/{분산이행Client.Segment(c.SiteId)}/stock-releases",
            new DistributedStockReleaseProposalRequest { ExpectedRevision = c.SiteRevision, LotId = c.LotId, AssignedUserId = assigneeId,
                Quantity = proposalQuantity, HandoverTerms = terms, Reason = reason,
                ResolutionKind = resolutionKind == DistributedStockResolutionKinds.Handover ? null : resolutionKind }, c.SiteId, ["propose-stock-release"], proposalConfirmed);
    }
    private DistributedEvidenceWorkRequest? HandoverWork => Release is { } r && quantity > 0
        && quantity <= r.AgreedQuantity - r.ReleasedQuantity && !string.IsNullOrWhiteSpace(barcode)
        && (DistributedStockResolutionKinds.Normalize(r.ResolutionKind) == DistributedStockResolutionKinds.Handover || !string.IsNullOrWhiteSpace(resolutionEvidence))
        ? new() { Kind = "StockRelease", AggregateId = r.SiteId, StockRelease = new() { ExpectedRevision = r.SiteRevision,
            ReleaseId = r.ReleaseId, LocationBarcode = barcode.Trim(), Quantity = quantity,
            ResolutionEvidenceReference = DistributedStockResolutionKinds.Normalize(r.ResolutionKind) == DistributedStockResolutionKinds.Handover ? null : resolutionEvidence.Trim() } } : null;
    private Task CloseSite(DistributedSiteDto site) => Model.ExecuteAsync("close-site", $"sites/{분산이행Client.Segment(site.SiteId)}/close",
        new DistributedSiteCloseRequest { ExpectedRevision = site.Revision, NoRemainingCustodyConfirmed = closeConfirmed, EvidenceReference = closeEvidence },
        site.SiteId, site.AllowedActions, closeConfirmed);
    private static string ReleaseStatus(string state, string? kind = null) => state switch
    { "AwaitingConsent" => "양측 동의 대기", "Confirmed" => "처리 준비", "PartiallyReleased" => "일부 처리 확인",
      "Completed" => DistributedStockResolutionKinds.Normalize(kind) == DistributedStockResolutionKinds.Handover ? "인계 확인" : "정리 확인",
      "Cancelled" => "남은 협의 취소", _ => "현재 상태 확인 필요" };
    private static string ResolutionLabel(string? kind) => DistributedStockResolutionKinds.Normalize(kind) switch
    { DistributedStockResolutionKinds.DamagedDisposal => "불량 물품 폐기 확인", DistributedStockResolutionKinds.AvailableShortage => "가용 재고 실사 소실 정정",
      DistributedStockResolutionKinds.DamagedShortage => "불량 재고 실사 소실 정정", _ => "정상 물품 반출" };
}
