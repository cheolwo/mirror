@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DriverPreferences
@using Ssalddel.Contracts.Driver.Settings
@implements IDisposable

<div data-testid="driver-work-participation" class="driver-work-preferences">
    @if (Model.RequiresLogin)
    {
        <MudAlert Severity="Severity.Info">기사 로그인이 필요합니다. 로그인 후 받을 업무를 설정해 주세요.</MudAlert>
        <MudButton Href="@LoginHref" Variant="Variant.Filled" Color="Color.Primary" Style="min-height:48px">로그인 화면으로</MudButton>
    }
    else
    {
        @if (Model.IsBusy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="설정 확인 중" />
        }
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@Model.Error</MudAlert>
        }
        @if (Model.IsLoaded)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">받을 업무</MudText>
                    <MudText Typo="Typo.body2">원하는 업무를 여러 개 선택할 수 있습니다.</MudText>
                    <MudCheckBox T="bool" Label="음식 배달" @bind-Value="Model.FoodDelivery" Disabled="@(!Model.CanEdit)" />
                    <MudCheckBox T="bool" Label="소형 물품·퀵" @bind-Value="Model.QuickDelivery" Disabled="@(!Model.CanEdit)" />
                    <MudCheckBox T="bool" Label="화물 운송" @bind-Value="Model.CargoTransport" Disabled="@(!Model.CanEdit)" />
                    <MudDivider />
                    <MudSwitch T="bool" Label="직접 피킹 가능" @bind-Value="Model.DirectPicking" Disabled="@(!Model.CanEdit)" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">소형 물품·화물을 직접 찾아 담은 뒤 배송할 수 있을 때 켜 주세요.</MudText>
                    @if (!Model.FoodEligible || !Model.CargoEligible)
                    {
                        <MudText Typo="Typo.body2">업무 선택과 수행 자격은 별도입니다. 자격 확인이 필요한 업무는 확인 후 제안됩니다.</MudText>
                    }
                </MudStack>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">차량·적재 조건</MudText>
                    <MudSelect T="string" Label="희망 차량 종류" @bind-Value="Model.VehicleKind" Variant="Variant.Outlined" Disabled="@(!Model.CanEdit)" Required="true">
                        <MudSelectItem T="string" Value="@DriverVehicleKinds.Motorcycle">오토바이</MudSelectItem>
                        <MudSelectItem T="string" Value="@DriverVehicleKinds.Car">승용차</MudSelectItem>
                        <MudSelectItem T="string" Value="@DriverVehicleKinds.Van">승합차</MudSelectItem>
                        <MudSelectItem T="string" Value="@DriverVehicleKinds.Truck">화물차</MudSelectItem>
                        <MudSelectItem T="string" Value="@DriverVehicleKinds.Bicycle">자전거</MudSelectItem>
                        <MudSelectItem T="string" Value="@DriverVehicleKinds.Walking">도보</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.body2">실제 배차는 등록 차량과 수행 자격을 확인합니다.</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" Label="사용 가능 중량 (kg)" @bind-Value="Model.CapacityKg" Min="0.001m"
                                             Max="@DriverWorkParticipationSettingsRules.MaxCapacityKg"
                                             Variant="Variant.Outlined" Disabled="@(!Model.CanEdit)" HideSpinButtons="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal?" Label="사용 가능 부피 (L)" @bind-Value="Model.CapacityLitres" Min="0.001m"
                                             Max="@DriverWorkParticipationSettingsRules.MaxCapacityLitres"
                                             Variant="Variant.Outlined" Disabled="@(!Model.CanEdit)" HideSpinButtons="true" />
                        </MudItem>
                    </MudGrid>
                    <MudText Typo="Typo.body2">현재 사용할 수 있는 적재 공간을 소수 3자리까지 입력해 주세요. 모르면 빈칸으로 둘 수 있습니다.</MudText>
                    <MudCheckBox T="bool" Label="음식과 다른 물품을 분리하여 적재할 수 있습니다."
                                 @bind-Value="Model.FoodCargoSeparationConfirmed" Disabled="@(!Model.CanEdit)" />
                </MudStack>
            </MudPaper>
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">추가 배차</MudText>
                    <MudNumericField T="int" Label="희망 최대 동시 업무 수" @bind-Value="Model.MaxConcurrentJobs" Min="1"
                                     Max="Model.OperationalMaxConcurrentJobs" Variant="Variant.Outlined" Disabled="@(!Model.CanEdit)" />
                    <MudSwitch T="bool" Label="업무 중 추가 배차 받기" @bind-Value="Model.ReceiveAdditionalOffers" Disabled="@(!Model.CanEdit)" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">추가 배차를 꺼도 이미 수락한 업무는 계속 처리할 수 있습니다.</MudText>
                    @if (!Model.SharedAdmissionEnabled)
                    {
                        <MudText Typo="Typo.body2">설정은 미리 저장할 수 있습니다. 배차 제공 범위는 서비스 준비 상태에 따라 달라집니다.</MudText>
                    }
                </MudStack>
            </MudPaper>
        }
        @if (Model.NeedsResultCheck || !Model.IsLoaded)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FindInPage"
                       Disabled="@(!Model.CanLoad)" OnClick="Model.LoadAsync" Class="mt-4" Style="min-height:48px">
                @(Model.NeedsResultCheck ? "저장 결과 확인" : "설정 다시 확인")
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save"
                       Disabled="@(!Model.CanEdit)" OnClick="Model.SaveAsync" Class="mt-4" Style="min-height:48px">업무·적재 설정 저장</MudButton>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <MudText Typo="Typo.body2" Class="mt-3" role="status">@Model.Message</MudText>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public DriverWorkParticipationViewModel Model { get; set; } = default!;
    [Parameter] public string LoginHref { get; set; } = "/login";
    private DriverWorkParticipationViewModel? observed;
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(observed, Model)) return;
        if (observed is not null) observed.Changed -= Refresh;
        observed = Model; observed.Changed += Refresh;
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { if (observed is not null) observed.Changed -= Refresh; }
}
