@using Ssalddel.Contracts.Common.Notifications
@using Ssalddel.Contracts.Driver.Settings
@implements IDisposable

<section class="recommendation-settings" data-testid="driver-recommendation-settings" aria-label="추천 알림 설정">
    <MudText Typo="Typo.h5">받고 싶은 추천 알림</MudText>
    <MudText Typo="Typo.body2">음식 배달과 화물 운송을 서로 다른 그림으로 알려드려요.</MudText>
    @if (Model.IsBusy)
    {
        <MudProgressLinear Indeterminate="true" aria-label="알림 설정 확인 중" />
    }
    <p role="status">@Model.Status</p>
    @if (Model.RequiresLogin)
    {
        <MudButton Href="@LoginHref" Variant="Variant.Filled" Color="Color.Primary">기사 로그인</MudButton>
    }
    <fieldset disabled="@(!Model.CanEdit)">
        <legend class="sr-only">추천 알림 허용과 알림 방식</legend>
        <MudSwitch T="bool" @bind-Value="Model.Enabled" Color="Color.Primary" Label="추천 알림 받기" Disabled="@(!Model.CanEdit)" />
        <div class="alert-options">
            @foreach (var kind in new[] { DriverWorkKinds.FoodDelivery, DriverWorkKinds.CargoTransport })
            {
                var visual = DriverRecommendationAlertPresentation.Resolve(kind)!;
                <div class="alert-option" style="--alert-color:@visual.AccentColor">
                    <div class="alert-option-heading">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="@visual.IconPath" /></svg>
                        @if (kind == DriverWorkKinds.FoodDelivery)
                        {
                            <MudSwitch T="bool" @bind-Value="Model.FoodEnabled" Color="Color.Primary" Label="음식 배달 추천" Disabled="@(!Model.CanEdit)" />
                        }
                        else
                        {
                            <MudSwitch T="bool" @bind-Value="Model.CargoEnabled" Color="Color.Primary" Label="화물 운송 추천 (퀵 포함)" Disabled="@(!Model.CanEdit)" />
                        }
                    </div>
                    <div class="alert-example" aria-label="@(visual.Label + " 알림 예시")">
                        <span class="example-caption">알림 예시</span>
                        <strong>@visual.Title</strong>
                        <span>@visual.Body</span>
                    </div>
                </div>
            }
        </div>
        @if (Model.IsLoaded && !Model.Enabled)
        {
            <p class="settings-note">전체 추천 알림이 꺼져 있어요. 업무별 선택은 저장해 둘 수 있습니다.</p>
        }
        <div class="alert-methods">
            <MudSwitch T="bool" @bind-Value="Model.Sound" Color="Color.Primary" Label="알림음" Disabled="@(!Model.CanEdit)" />
            <MudSwitch T="bool" @bind-Value="Model.Vibrate" Color="Color.Primary" Label="진동" Disabled="@(!Model.CanEdit)" />
            <MudSwitch T="bool" @bind-Value="Model.QuietAtNight" Color="Color.Primary" Label="야간 무음 (22:00~07:00)" Disabled="@(!Model.CanEdit)" />
        </div>
        <p class="settings-note">야간 무음은 한국 시각 기준이며, 메시지는 표시하고 소리·진동만 끕니다.</p>
        @if (ShowAdvancedOptions)
        {
            <details><summary>추가 알림 방식</summary>
                <MudSwitch T="bool" @bind-Value="Model.DrivingPushOnly" Color="Color.Primary" Label="운전 중에는 푸시 알림만 사용" Disabled="@(!Model.CanEdit)" />
                <MudSwitch T="bool" @bind-Value="Model.CollectWhenStopped" Color="Color.Primary" Label="정차 후 모아보기" Disabled="@(!Model.CanEdit)" />
            </details>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Model.CanEdit)" OnClick="SaveAsync">알림 설정 저장</MudButton>
    </fieldset>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@Model.IsBusy" OnClick="ReloadAsync">다시 조회</MudButton>
    <p class="settings-note">받을 업무와 배차 수신도 켜져 있어야 추천이 도착합니다. 휴대폰의 앱 알림 허용은 별도이며, 알림을 열어도 자동으로 수락되지 않습니다.</p>
</section>

@code {
    [Parameter, EditorRequired] public DriverRecommendationSettingsViewModel Model { get; set; } = default!;
    [Parameter] public string LoginHref { get; set; } = "/workspace-login/cargo-driver?returnUrl=%2Fdriver%2Fnotifications%2Fsettings";
    [Parameter] public bool ShowAdvancedOptions { get; set; }
    private DriverRecommendationSettingsViewModel? _subscribed;
    protected override void OnParametersSet()
    {
        if (_subscribed == Model) return;
        if (_subscribed is not null) _subscribed.Changed -= Refresh;
        _subscribed = Model; _subscribed.Changed += Refresh;
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private Task SaveAsync() => Model.SaveAsync();
    private Task ReloadAsync() => Model.LoadAsync();
    public void Dispose() { if (_subscribed is not null) _subscribed.Changed -= Refresh; }
}
