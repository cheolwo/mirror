@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Cargo
@inject CargoNoticeListViewModel Model
@implements IDisposable

<section class="cargo-notices" aria-label="화물 정보 공고">
    <header>
        <span class="eyebrow">로그인 없이 둘러보기</span>
        <h1>화물 정보 공고</h1>
        <p>출발·도착 지역과 희망 조건을 살펴보세요. 게시된 정보만 보여드립니다.</p>
        <a class="primary" href="@CargoNoticeNavigation.Mine">내 공고 작성·관리</a>
    </header>
    <p class="notice">공고를 보거나 게시해도 운송 신청·배차·계약·결제는 시작되지 않습니다.</p>
    <div class="toolbar"><strong>@Model.Page 페이지</strong><button type="button" disabled="@Model.IsLoading" @onclick="Refresh">새로고침</button></div>
    @if (Model.IsLoading)
    { <p role="status">공개 공고를 불러오는 중입니다.</p> }
    else if (Model.FeatureDisabled)
    { <p class="notice" role="status">화물 정보 공고를 준비하고 있습니다. 현재는 조회·게시를 이용할 수 없습니다.</p> }
    else if (Model.Error is { } error)
    { <div class="error" role="alert"><p>@error</p><button type="button" @onclick="Refresh">다시 조회</button></div> }
    else if (Model.HasLoaded && Model.Items.Count == 0)
    { <p role="status">현재 공개 중인 공고가 없습니다.</p> }
    else
    {
        <ul class="cards">
            @foreach (var item in Model.Items)
            {
                <li @key="item.NoticeId">
                    <CargoNoticeSummary Content="item.Content" PickupRegionName="@item.PickupRegionName" DropoffRegionName="@item.DropoffRegionName" />
                    <p class="muted">게시 @CargoNoticePresentation.Time(item.PublishedAtUtc) · 만료 @CargoNoticePresentation.Time(item.ExpiresAtUtc) (한국)</p>
                </li>
            }
        </ul>
    }
    <nav class="toolbar" aria-label="공고 페이지 이동">
        <button type="button" disabled="@(Model.IsLoading || Model.Page <= 1 || Model.FeatureDisabled)" @onclick="Previous">이전 페이지</button>
        <button type="button" disabled="@(Model.IsLoading || !Model.HasNext || Model.FeatureDisabled)" @onclick="Next">다음 페이지</button>
    </nav>
</section>

@code {
    protected override async Task OnInitializedAsync() { Model.Changed += Changed; await Model.LoadAsync(); }
    private Task Refresh() => Model.LoadAsync(Model.Page);
    private Task Previous() => Model.LoadAsync(Model.Page - 1);
    private Task Next() => Model.LoadAsync(Model.Page + 1);
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Model.Changed -= Changed; Model.Dispose(); }
}
