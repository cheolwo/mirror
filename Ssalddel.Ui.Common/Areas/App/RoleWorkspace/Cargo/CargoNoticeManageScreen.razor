@namespace Ssalddel.Ui.Common.Areas.App.RoleWorkspace.Cargo
@using Ssalddel.Contracts.Common.Community
@inject CargoNoticeManageViewModel Model
@implements IDisposable

<section class="cargo-notices" aria-label="내 화물 정보 공고">
    <header><span class="eyebrow">내 공고</span><h1>화물 정보 작성·관리</h1><p>초안으로 저장한 뒤 공개 내용을 확인하고 게시하세요.</p><a href="@CargoNoticeNavigation.Public">공개 목록으로</a></header>
    <p class="notice">공고는 정보 공유용입니다. 운송 신청·기사 추천·배차·계약·결제는 별도 업무입니다. 상세주소와 연락처를 입력하지 마세요.</p>
    @if (!Model.IsAuthenticated)
    {
        <div class="panel"><h2>로그인 후 내 공고를 관리할 수 있습니다</h2><p>공개 목록은 로그인 없이 볼 수 있습니다.</p><a class="primary" href="@CargoNoticeNavigation.Login">로그인하고 돌아오기</a></div>
    }
    else
    {
        <div class="toolbar"><button type="button" disabled="@Model.IsBusy" @onclick="Refresh">최신 내용 확인</button></div>
        @if (Model.IsBusy) { <p role="status">공고를 확인하는 중입니다. 잠시 기다려 주세요.</p> }
        @if (Model.FeatureDisabled)
        { <p class="notice" role="status">화물 정보 공고를 준비하고 있습니다. 현재는 조회·게시를 이용할 수 없습니다.</p> }
        @if (Model.Error is { } error) { <p class="error" role="alert">@error</p> }
        @if (Model.Message is { } message) { <p class="success" role="status">@message</p> }
        @if (Model.HasActiveContext && !Model.FeatureDisabled)
        {
            @if (Model.HasPending)
            {
                <section class="pending" aria-label="저장 결과 확인 필요">
                    <h2>이전 요청의 결과 확인이 필요합니다</h2>
                    <p>응답이 확인되지 않아 새 입력과 게시를 잠시 막았습니다. 자동으로 다시 보내지 않습니다. 같은 계정·서버에서 결과부터 확인하세요.</p>
                    <p>결과가 계속 없거나 입력 오류가 남아 있으면 새 요청으로 바꾸지 말고 담당자에게 확인을 요청해 주세요.</p>
                    <div class="toolbar"><button type="button" disabled="@Model.IsBusy" @onclick="Model.ResolvePendingAsync">이전 요청 결과 확인</button>
                        <button type="button" disabled="@(!Model.CanRetryPending)" @onclick="Model.RetryPendingAsync">같은 내용으로 다시 보내기</button></div>
                </section>
            }
            @if (Model.RequiresRefresh) { <p class="notice">저장은 확인됐지만 최신 내용을 읽지 못했습니다. 위의 ‘최신 내용 확인’을 눌러 주세요.</p> }
            <div class="manage-grid">
                <section class="panel" aria-label="내 공고 목록">
                    <div class="toolbar"><h2>내 공고</h2><button type="button" disabled="@(!Model.CanEdit)" @onclick="Model.NewDraft">새 초안</button></div>
                    @if (Model.Items.Count == 0) { <p>저장된 공고가 없습니다. 첫 초안을 작성해 보세요.</p> }
                    <ul class="owner-list">
                    @foreach (var item in Model.Items)
                    {
                        <li @key="item.NoticeId"><button type="button" class="owner-card" disabled="@(!Model.CanEdit)" @onclick="() => Model.SelectAsync(item.NoticeId)">
                            <strong>@item.Content.Title</strong><span>@CargoNoticePresentation.Status(item.Status)</span><small>@Region(item.Content.PickupRegionKey) → @Region(item.Content.DropoffRegionKey)</small>
                        </button></li>
                    }
                    </ul>
                    <nav class="toolbar" aria-label="내 공고 페이지">
                        <button type="button" disabled="@(!Model.CanEdit || Model.Page <= 1)" @onclick="Previous">이전</button><button type="button" disabled="@(!Model.CanEdit || !Model.HasNext)" @onclick="Next">다음</button>
                    </nav>
                </section>
                <section class="panel" aria-label="공고 입력">
                    <h2>@(Model.Current is null ? "새 초안" : "선택한 공고")</h2>
                    @if (Model.Current is { } current) { <p>현재 상태: <strong>@CargoNoticePresentation.Status(current.Status)</strong></p> }
                    <fieldset disabled="@(!Model.CanEdit)">
                        <legend>공개할 정보</legend>
                        <label>제목 <input maxlength="80" @bind="Model.Form.Title" @bind:after="Model.DraftChanged" /></label>
                        <label>화물명 <input maxlength="80" @bind="Model.Form.GoodsName" @bind:after="Model.DraftChanged" /></label>
                        <div class="field-pair">
                            <label>수량 (개) <input inputmode="numeric" @bind="Model.Form.Quantity" @bind:after="Model.DraftChanged" /></label>
                            <label>총 중량 (kg, 선택) <input inputmode="decimal" @bind="Model.Form.WeightKg" @bind:after="Model.DraftChanged" /></label>
                        </div>
                        <label>차량 분류 (선택)<select aria-label="차량 분류 (선택)" @bind="Model.Form.VehicleKind" @bind:after="Model.DraftChanged"><option value="unspecified">선택 안 함</option><option value="motorcycle">오토바이</option><option value="van">승합·소형 밴</option><option value="truck">화물차</option></select></label>
                        <div class="field-pair">
                            <label>출발 지역<select aria-label="출발 지역" @bind="Model.Form.PickupRegionKey" @bind:after="Model.DraftChanged"><option value="">지역 선택</option>@foreach (var region in Model.Regions) { <option value="@region.RegionKey">@region.DisplayName</option> }</select></label>
                            <label>도착 지역<select aria-label="도착 지역" @bind="Model.Form.DropoffRegionKey" @bind:after="Model.DraftChanged"><option value="">지역 선택</option>@foreach (var region in Model.Regions) { <option value="@region.RegionKey">@region.DisplayName</option> }</select></label>
                        </div>
                        <label>희망 시작 (한국 시각, 선택)<input type="datetime-local" value="@Model.Form.DesiredFromLocal" @onchange="FromChanged" /></label>
                        <label>희망 종료 (한국 시각, 선택)<input type="datetime-local" value="@Model.Form.DesiredUntilLocal" @onchange="UntilChanged" /></label>
                        <p class="muted">희망 시간은 시작과 종료를 함께 입력합니다. 수량·중량은 최대 1,000,000까지 입력할 수 있습니다.</p>
                        @if (Model.Current?.Status == CargoNoticeStatus.Published) { <p class="notice">내용을 수정해 저장하면 공개가 내려가고 초안이 됩니다. 다시 동의해야 게시됩니다.</p> }
                        <button type="button" class="primary" @onclick="Model.SaveAsync">@(Model.Current is null ? "초안 저장" : "수정 내용 저장")</button>
                    </fieldset>
                </section>
                @if (Model.Current is { } saved)
                {
                    <section class="panel preview" aria-label="저장된 내용의 공개 미리보기">
                        <span class="eyebrow">저장된 내용 · 공개 미리보기</span>
                        <CargoNoticeSummary Content="saved.Content" PickupRegionName="@Region(saved.Content.PickupRegionKey)" DropoffRegionName="@Region(saved.Content.DropoffRegionKey)" />
                        @if (Model.IsDirty) { <p class="notice">입력 내용을 바꿨습니다. 미리보기는 이전에 저장된 내용입니다. 먼저 수정 내용을 저장하세요.</p> }
                        @if (saved.Status == CargoNoticeStatus.Published)
                        {
                            <p>만료: @CargoNoticePresentation.Time(saved.ExpiresAtUtc) (한국)</p><button type="button" disabled="@(!Model.CanEdit)" @onclick="Model.WithdrawAsync">공개 철회</button>
                        }
                        else
                        {
                            <fieldset disabled="@(!Model.CanEdit || Model.IsDirty)">
                                <legend>공개 게시 확인</legend>
                                <label>게시 만료 (한국 시각, 30일 이내)<input type="datetime-local" value="@Model.ExpiresLocal" @onchange="ExpiryChanged" /></label>
                                <label class="consent"><input type="checkbox" @bind="Model.Consent" /><span>미리보기의 제목·화물 조건·넓은 지역·희망 시간 공개에 동의합니다.</span></label>
                                <p class="muted">공개 정보에 개인정보가 없는지 확인하세요. 만료 이후에는 공개 목록에서 내려갑니다.</p>
                                <button type="button" class="primary" disabled="@(!Model.CanPublish)" @onclick="Model.PublishAsync">확인한 내용 게시</button>
                            </fieldset>
                        }
                    </section>
                }
            </div>
        }
    }
</section>

@code {
    protected override async Task OnInitializedAsync() { Model.Changed += Changed; await Model.LoadAsync(); }
    private Task Refresh() => Model.LoadAsync(Model.Page);
    private Task Previous() => Model.LoadAsync(Model.Page - 1);
    private Task Next() => Model.LoadAsync(Model.Page + 1);
    private string Region(string key) => Model.Regions.FirstOrDefault(r => r.RegionKey == key)?.DisplayName ?? "지역 미확인";
    private void FromChanged(ChangeEventArgs e) { Model.Form.DesiredFromLocal = e.Value?.ToString() ?? ""; Model.DraftChanged(); }
    private void UntilChanged(ChangeEventArgs e) { Model.Form.DesiredUntilLocal = e.Value?.ToString() ?? ""; Model.DraftChanged(); }
    private void ExpiryChanged(ChangeEventArgs e) { Model.ExpiresLocal = e.Value?.ToString() ?? ""; Model.Consent = false; }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { Model.Changed -= Changed; Model.Dispose(); }
}
