@using Ssalddel.Ui.Common.Areas.BackOffice.ViewModels
<section class="operations-alerts" aria-label="운영 알림">
    <header><div class="eyebrow">MIRROR · 운영</div><h1>운영 알림</h1><p>지금 확인할 일을 모았습니다.</p></header>
    @if (!Authenticated)
    { <div class="alert-card"><h2>관리자 로그인이 필요합니다</h2><p>로그인 후 최신 업무 상태를 확인하세요.</p><a class="primary" href="@LoginHref">관리자 로그인</a></div> }
    else if (State.Busy && State.Page is null && State.Detail is null)
    { <p role="status">알림을 불러오고 있습니다.</p> }
    else
    {
        @if (State.Error is not null) { <div class="notice error" role="alert">@State.Error <button @onclick="Retry">다시 시도</button></div> }
        @if (State.Page is { } page)
        {
            @if (!page.Enabled) { <div class="notice">운영 알림 감시가 꺼져 있습니다.</div> }
            else if (!page.ExternalSendEnabled) { <div class="notice">앱 내 기록만 확인할 수 있습니다. 외부 알림 발송은 꺼져 있습니다.</div> }
        }
        @if (DetailId is null)
        {
            <nav class="filters" aria-label="알림 상태">
                <button class="@(Status == "Open" ? "selected" : "")" @onclick='() => SelectStatus.InvokeAsync("Open")'>긴급·확인 필요</button>
                <button class="@(Status == "Acknowledged" ? "selected" : "")" @onclick='() => SelectStatus.InvokeAsync("Acknowledged")'>확인 중</button>
                <button class="@(Status == "Resolved" ? "selected" : "")" @onclick='() => SelectStatus.InvokeAsync("Resolved")'>해결됨</button>
            </nav>
            @if (State.Page is { Items.Count: 0 }) { <div class="alert-card empty"><h2>확인할 알림이 없습니다</h2><p>새 문제가 접수되면 여기에 표시됩니다.</p></div> }
            @foreach (var row in State.Page?.Items ?? [])
            {
                <a class="alert-card alert-row" href="@("/operations-alerts/" + row.Id)">
                    <span class="badge @(row.Severity == "Urgent" ? "urgent" : "")">@(row.Severity == "Urgent" ? "긴급" : "확인 필요")</span>
                    <h2>@row.Title</h2><p>@row.CreatedAtUtc.AddHours(9).ToString("MM.dd HH:mm") · @Label(row.Status)</p><span class="arrow" aria-hidden="true">›</span>
                </a>
            }
            <div class="pagination">
                @if ((State.Page?.Page ?? 1) > 1) { <button disabled="@State.Busy" @onclick="Previous">이전</button> }
                <span>@(State.Page?.Page ?? 1) 페이지</span>
                @if (State.Page?.HasMore == true) { <button disabled="@State.Busy" @onclick="Next">다음</button> }
            </div>
        }
        else if (State.Detail is { } row)
        {
            <a class="back" href="/operations-alerts">‹ 알림 목록</a>
            <article class="alert-card">
                <span class="badge @(row.Severity == "Urgent" ? "urgent" : "")">@(row.Severity == "Urgent" ? "긴급" : "확인 필요")</span>
                <h2>@row.Title</h2><p>@row.Action</p>
                <dl><dt>처리 상태</dt><dd>@Label(row.Status)</dd><dt>발생 시각</dt><dd>@row.CreatedAtUtc.AddHours(9).ToString("MM.dd HH:mm")</dd></dl>
                @if (!row.SourceCurrent) { <div class="notice">최근 원장 확인이 지연되고 있습니다. 해당 업무에서 상태를 확인하세요.</div> }
                <a class="primary" href="@row.SourceHref">해당 업무 보기</a>
            </article>
            <section class="alert-card"><h2>알림 확인</h2><p>확인하면 재알림을 멈춥니다. 실제 업무의 해결 상태는 바뀌지 않습니다.</p>
                <button class="secondary" disabled="@(!State.CanAcknowledge)" @onclick="Acknowledge">@(row.Status == "Acknowledged" ? "확인 중" : "알림 확인")</button>
                @if (row.DeliveryStates.Length > 0) { <details><summary>알림 전달 상태</summary>@foreach (var channel in row.DeliveryStates) { <p>@DeliveryLabel(channel)</p> }</details> }
            </section>
        }
    }
</section>
@code {
    [Parameter, EditorRequired] public OperationsAlertsState State { get; set; } = default!;
    [Parameter] public bool Authenticated { get; set; }
    [Parameter] public string LoginHref { get; set; } = "/login";
    [Parameter] public string? DetailId { get; set; }
    [Parameter] public string Status { get; set; } = "Open";
    [Parameter] public EventCallback Retry { get; set; }
    [Parameter] public EventCallback Previous { get; set; }
    [Parameter] public EventCallback Next { get; set; }
    [Parameter] public EventCallback<string> SelectStatus { get; set; }
    [Parameter] public EventCallback Acknowledge { get; set; }
    private static string Label(string status) => status switch { "Open" => "확인 필요", "Acknowledged" => "확인 중", "Resolved" => "해결됨", _ => "확인 필요" };
    private static string DeliveryLabel(string channel)
    {
        var parts = channel.Split(':');
        var name = parts[0] == "Push" ? "앱 알림" : "이메일";
        return name + " · " + (parts.Last() switch { "Sent" => "전송 접수", "Failed" => "발송 실패", "ConfigurationRequired" => "설정 필요", "Suppressed" => "발송 생략", "Processing" => "발송 중", _ => "발송 대기" });
    }
}
