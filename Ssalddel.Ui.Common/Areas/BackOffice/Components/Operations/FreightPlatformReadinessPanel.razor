@namespace Ssalddel.Ui.Common.Areas.BackOffice.Components.Operations
@using Ssalddel.Ui.Common.Areas.BackOffice.ViewModels
@implements IDisposable

<section class="platform-readiness" aria-label="화물 플랫폼 등록 준비">
    <header><MudIcon Icon="@Icons.Material.Outlined.AssignmentTurnedIn" /><div><h1>화물 플랫폼 등록 준비</h1><p>기관 등록과 운영 준비에 남은 항목을 확인합니다.</p></div></header>
    @if (Model.Busy) { <p role="status">준비 현황을 확인하고 있습니다.</p> }
    @if (Model.Error is { } error) { <p role="alert">@error</p> }
    @if (Model.Current is { } current)
    {
        <aside><strong>@(current.IsPreparationComplete ? "준비 자료 확인" : "추가 준비 필요")</strong><p>@current.Notice</p><p>시행 예정일 @current.RegistrationEffectiveDate.ToString("yyyy-MM-dd")</p></aside>
        <dl><div><dt>플랫폼 기관 등록</dt><dd>@플랫폼등록준비ViewModel.Status(current.PlatformRegistrationStatusCode)</dd></div><div><dt>운송주선 허가</dt><dd>@플랫폼등록준비ViewModel.Status(current.BrokeragePermitStatusCode)</dd></div><div><dt>현재 이용료 설정</dt><dd>@(current.FreeConnectionConfigured ? "무료·0원 설정" : "설정 확인 필요")</dd></div></dl>
        @if (current.PlannedInformationSubscription is { } plan)
        {
            <article aria-label="향후 월정액 정보추천 계획">
                <div class="platform-readiness__title"><h2>향후 월정액 정보추천</h2><strong>@(plan.ConfirmedMonthlyAmountKrw is null ? "요금 미확정" : "계획 요금 확정")</strong></div>
                <p>@plan.Notice</p>
                <dl>
                    <div><dt>월 이용료 후보</dt><dd>@string.Join(" / ", plan.CandidateMonthlyAmountsKrw.Select(amount => amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("ko-KR")) + "원"))</dd></div>
                    <div><dt>확정 월 이용료</dt><dd>@(plan.ConfirmedMonthlyAmountKrw is { } amount ? amount.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("ko-KR")) + "원" : "미정")</dd></div>
                    <div><dt>건별 중개수수료 계획</dt><dd>@(plan.PerShipmentCommissionPlanned ? "별도 검토 필요" : "없음")</dd></div>
                    <div><dt>법적 분류 확인</dt><dd>@플랫폼등록준비ViewModel.Status(plan.LegalClassificationStatusCode)</dd></div>
                </dl>
                @if (plan.RealtimeRecommendationsPlanned && plan.PartyFinalDecisionRequired)
                {
                    <p>실시간 추천 → 기사 수락·거절 → 계약 당사자 최종 결정</p>
                }
                <p>@(plan.BillingImplemented ? "월정액 청구 구현 표시 · 실제 활성화는 별도 확인합니다." : "월정액 청구 미구현 · 현재 실행 설정과 별도인 향후 계획입니다.")</p>
            </article>
        }
        <p>이 화면은 준비 현황 조회입니다. 등록 신청·허가·신고 또는 영업을 활성화하지 않습니다.</p>
        @if (current.Requirements.Count == 0) { <p>확인할 요건 자료가 없습니다.</p> }
        @foreach (var row in current.Requirements)
        {
            <article @key="row.Code"><div class="platform-readiness__title"><h2>@row.Title</h2><strong>@플랫폼등록준비ViewModel.Status(row.StatusCode)</strong></div>
                <p>@row.NextAction</p><small>준비 근거 @(row.HasEvidenceReference ? "기록 있음" : "미확인") · 기관 접수 근거 @(row.HasAuthorityReceiptReference ? "기록 있음" : "미확인")</small>
                @if (row.RecheckAtUtc is { } date) { <p>재확인 @date.ToLocalTime().ToString("yyyy-MM-dd")</p> }
            </article>
        }
    }
    <button type="button" disabled="@Model.Busy" @onclick="Model.LoadAsync">준비 현황 다시 확인</button>
</section>
@code {
    [Parameter, EditorRequired] public 플랫폼등록준비ViewModel Model { get; set; } = default!;
    private 플랫폼등록준비ViewModel? subscribed;
    protected override void OnParametersSet()
    {
        if (subscribed == Model) return;
        if (subscribed is not null) subscribed.Changed -= Changed;
        subscribed = Model; subscribed.Changed += Changed;
    }
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() { if (subscribed is not null) subscribed.Changed -= Changed; }
}
