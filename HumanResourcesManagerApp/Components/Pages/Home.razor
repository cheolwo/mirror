@page "/"
@inherits MvvmComponentBase<인사역할검토HomePageViewModel>
@inject NavigationManager Navigation

<PageTitle>살뜰 인사 역할 검토</PageTitle>

<PlatformCommunityHome AppName="살뜰 인사"
                       RoleLabel="인력 관리자"
                       AppKey="hr-manager">
    <WorkModeContent>
        <MudStack Spacing="3" Class="hr-home">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">인력 역할 검토</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        역할 지원·철회와 역할 배정·해제 내역을 함께 확인합니다.
                    </MudText>
                </MudStack>
                @if (ViewModel.기능사용가능 && ViewModel.인증.역할검토접근가능)
                {
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">
                            @ViewModel.인증.현재사용자표시
                        </MudChip>
                        <MudTooltip Text="지원·배정 내역 다시 조회">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                           Color="Color.Default"
                                           Disabled="@ViewModel.처리중"
                                           OnClick="RefreshAsync"
                                           aria-label="지원·배정 내역 다시 조회" />
                        </MudTooltip>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Disabled="@ViewModel.처리중"
                                   OnClick="LogoutAsync">
                            로그아웃
                        </MudButton>
                    </MudStack>
                }
            </MudStack>

            @if (!ViewModel.초기화됨 || ViewModel.초기화중)
            {
                <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            인력 관리 권한과 지원·배정 내역을 확인하고 있습니다.
                        </MudText>
                    </MudStack>
                </MudPaper>
            }
            else if (!string.IsNullOrWhiteSpace(ViewModel.페이지오류메시지))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudText>@ViewModel.페이지오류메시지</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@ViewModel.처리중" OnClick="RetryPageAsync">
                            다시 확인
                        </MudButton>
                    </MudStack>
                </MudAlert>
            }
            else if (!ViewModel.기능사용가능)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.subtitle1">현재 인력 지원·배정 내역을 조회할 수 없습니다.</MudText>
                        <MudText Typo="Typo.body2">@ViewModel.기능안내</MudText>
                        <MudText Typo="Typo.caption">
                            이 환경에서 인력 관리 기능을 사용할 수 있는지 관리자에게 확인해 주세요.
                        </MudText>
                    </MudStack>
                </MudAlert>
            }
            else if (!ViewModel.인증.역할검토접근가능)
            {
                <HumanResourcesAuthenticationPanel ViewModel="@ViewModel.인증"
                                                   OnAuthenticated="AfterAuthenticationAsync"
                                                   OnLoggedOut="OnLoggedOut" />
            }
            else
            {
                <SsalddelHrRoleReviewWorkspace Model="@ViewModel.역할검토"
                                               OnReviewSelected="OpenReviewAsync" />
            }
        </MudStack>
    </WorkModeContent>
</PlatformCommunityHome>

<AppContextImageWall AppPackId="human-resources"
                     Title="함께 일하는 사람들" />

<style>
    .hr-home {
        min-width: 0;
    }
</style>

@code {
    private bool _parametersLoaded;
    private Guid? _loadedReviewId;

    [Parameter]
    [SupplyParameterFromQuery(Name = "reviewId")]
    public Guid? ReviewId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_parametersLoaded && _loadedReviewId == ReviewId)
        {
            return;
        }

        _parametersLoaded = true;
        _loadedReviewId = ReviewId;
        await ViewModel.초기화Async(ReviewId);
    }

    private Task AfterAuthenticationAsync()
        => ViewModel.인증후조회Async();

    private void OnLoggedOut()
        => ViewModel.역할검토.결과초기화();

    private Task RefreshAsync()
        => ViewModel.다시조회Async();

    private Task RetryPageAsync()
        => ViewModel.초기화Async(ReviewId);

    private Task LogoutAsync()
        => ViewModel.로그아웃Async();

    private Task OpenReviewAsync(Guid? reviewId)
    {
        var target = reviewId is { } id
            ? $"{HumanResourcesManagerRoutes.RoleReviews}?reviewId={id:D}"
            : HumanResourcesManagerRoutes.RoleReviews;
        Navigation.NavigateTo(target);
        return Task.CompletedTask;
    }
}
