@page "/"

<PageTitle>살뜰 인사</PageTitle>

<PlatformCommunityHome AppName="살뜰 인사"
                       RoleLabel="인력 관리자"
                       AppKey="hr-manager"
                       QuickActions="QuickActions">
    <WorkModeContent>
        <MudStack Spacing="3" Class="hr-home">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">인력 관리 콘솔</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    역할, 근무 시간, 작업장 접근 조건, 계약/급여 흐름을 한 화면에서 확인합니다.
                </MudText>
            </MudStack>

            <MudGrid>
                @foreach (var metric in Metrics)
                {
                    <MudItem xs="12" sm="6" lg="3">
                        <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100 hr-metric-card">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudIcon Icon="@metric.Icon" Color="@metric.Color" />
                                    <MudChip T="string" Size="Size.Small" Color="@metric.Color" Variant="Variant.Outlined">@metric.Badge</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.h4">@metric.Value</MudText>
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1">@metric.Title</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@metric.Description</MudText>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <MudGrid>
                <MudItem xs="12" lg="7">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">오늘 확인할 HR 업무</MudText>
                            @foreach (var item in WorkQueue)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@item.Icon" Color="@item.Color" />
                                            <MudStack Spacing="0">
                                                <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                                            </MudStack>
                                        </MudStack>
                                        <MudChip T="string" Size="Size.Small" Color="@item.Color" Variant="Variant.Outlined">@item.Status</MudChip>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="5">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.h6">접근 검증 기준</MudText>
                            @foreach (var rule in Rules)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@rule</MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">교육/모임 참여 혜택 이관</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                교육 과정이나 오프라인 모임 참여로 발생한 혜택을 HR 이력으로 묶어 관리합니다.
                            </MudText>
                        </MudStack>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">HR 기록 대상</MudChip>
                    </MudStack>

                    <MudTable Items="ParticipationBenefitRecords" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>참여자</MudTh>
                            <MudTh>출처</MudTh>
                            <MudTh>혜택</MudTh>
                            <MudTh>상태</MudTh>
                            <MudTh>기록</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="record">
                            <MudTd DataLabel="참여자">
                                <MudText Typo="Typo.body2">@record.ParticipantName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@record.UserId</MudText>
                            </MudTd>
                            <MudTd DataLabel="출처">
                                <MudText Typo="Typo.body2">@record.SourceTitle</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@record.SourceType</MudText>
                            </MudTd>
                            <MudTd DataLabel="혜택">
                                <MudText Typo="Typo.body2">@record.BenefitName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@record.BenefitDescription</MudText>
                            </MudTd>
                            <MudTd DataLabel="상태">
                                <MudChip T="string" Size="Size.Small" Color="@record.StatusColor" Variant="Variant.Outlined">@record.BenefitStatus</MudChip>
                            </MudTd>
                            <MudTd DataLabel="기록">
                                <MudText Typo="Typo.caption">@record.RecordedAt</MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudStack>
            </MudPaper>
        </MudStack>
    </WorkModeContent>
</PlatformCommunityHome>

<style>
    .hr-home {
        min-width: 0;
    }

    .hr-metric-card {
        border-radius: 8px;
        min-height: 180px;
    }
</style>

