@page "/"
@page "/overview"
@inject AdminAuthSession Session

<PageTitle>살뜰 운영 개요</PageTitle>

<MudStack Spacing="3" Class="admin-overview">
    <MudStack Spacing="1">
        <MudText Typo="Typo.h4">운영 개요</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">확인할 업무를 선택하세요.</MudText>
    </MudStack>
    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">음식 배달</MudText>
            <MudText Typo="Typo.body2">주문 진행과 배달 중단 검토를 확인합니다.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/food-operations">음식 주문 보기</MudButton>
        </MudStack>
    </MudPaper>
    @if (Session.IsServerAdmin)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">거래·개인정보 보호</MudText>
                <MudText Typo="Typo.body2">문제 접수와 개인정보 요청의 담당 업무를 확인합니다.</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Href="/privacy-support">처리 요청 보기</MudButton>
            </MudStack>
        </MudPaper>
    }
    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">화물 운송</MudText>
            <MudText Typo="Typo.body2">운송·기사 현황을 확인합니다.</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Href="/overview/cargo">화물 운영 보기</MudButton>
        </MudStack>
    </MudPaper>
</MudStack>
