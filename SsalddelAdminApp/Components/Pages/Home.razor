@page "/"
@page "/overview"
@implements IAsyncDisposable
@inject AdminAuthSession Session
@inject AdminAuthService AuthService
@inject AdminDashboardService DashboardService
@inject ITransportRequestLedgerObserver LedgerObserver
@inject TransportRequestLedgerRealtimeClient RealtimeClient
@inject NavigationManager Navigation

<PageTitle>살뜰 모바일 운영 개요</PageTitle>

<MudStack Spacing="3" Class="admin-overview">
    <div class="admin-page-header admin-overview-hero">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Primary">오늘의 운영</MudText>
            <MudText Typo="Typo.h4">지금 확인할 일을 모았습니다</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                주문, 배차, 예외 상황을 우선순위대로 확인하세요.
            </MudText>
        </MudStack>
        @if (Session.IsServerAdmin)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="isBusy"
                       OnClick="@(() => LoadAsync(false))">
                새로고침
            </MudButton>
        }
    </div>

    @if (!Session.IsServerAdmin)
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage)
             && !string.IsNullOrWhiteSpace(Session.RefreshToken))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                @errorMessage
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Disabled="isBusy"
                           OnClick="RetryAuthenticationAsync">
                    세션 다시 연결
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="OpenLogin">다시 로그인</MudButton>
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                실제 운영 현황은 서버관리자 로그인 후 확인할 수 있습니다.
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="OpenLogin">로그인</MudButton>
            </MudAlert>
        }
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                @errorMessage
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => LoadAsync(false))">다시 시도</MudButton>
            </MudAlert>
        }

        @if (isBusy && summary is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">서버 운영 현황을 불러오고 있습니다.</MudText>
        }
        else if (summary is not null)
        {
            <MudAlert Severity="@AttentionSeverity" Variant="Variant.Outlined">
                관리자 확인 @(summary.관리자확인필요수)건 · 운송 예외 @(summary.운송예외수)건 · 배차대기 @(summary.배차대기수)건
            </MudAlert>

            <MudGrid Spacing="2">
                <MudItem xs="6" md="3">
                    <MetricCard Title="관리자 확인"
                                Value="@summary.관리자확인필요수.ToString("N0")"
                                Description="확인이 필요한 진행 건"
                                Icon="@Icons.Material.Filled.NotificationImportant"
                                AccentColor="Color.Error" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MetricCard Title="운송 예외"
                                Value="@summary.운송예외수.ToString("N0")"
                                Description="예외가 보고된 운송"
                                Icon="@Icons.Material.Filled.ReportProblem"
                                AccentColor="Color.Warning" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MetricCard Title="배차대기"
                                Value="@summary.배차대기수.ToString("N0")"
                                Description="기사 추천·수락 대기"
                                Icon="@Icons.Material.Filled.Schedule"
                                AccentColor="Color.Info" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MetricCard Title="운송 중"
                                Value="@summary.운송중수.ToString("N0")"
                                Description="현재 이행 중인 운송"
                                Icon="@Icons.Material.Filled.LocalShipping"
                                AccentColor="Color.Success" />
                </MudItem>
            </MudGrid>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudText Typo="Typo.subtitle1">오늘의 주문·이행 상태</MudText>
                <MudGrid Spacing="2" Class="mt-1">
                    @foreach (var item in TodayMetrics)
                    {
                        <MudItem xs="6" sm="4">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Label</MudText>
                                <MudText Typo="Typo.h6">@(item.Value.ToString("N0"))건</MudText>
                            </MudStack>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1">모바일 관리 바로가기</MudText>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.MonitorHeart"
                               Href="/operations">
                        운송·기사 현황 보기
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Healing"
                               Href="/operations/follow-up-recovery">
                        후속 처리 복구
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.AccountBalanceWallet"
                               Href="/operations/finance">
                        현금 흐름 보기
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @syncText · 실시간 누락 보정을 위해 30초마다 자동 조회합니다.
            </MudText>
        }
    }
</MudStack>

@if (!EnforceFieldTestRoutes)
{
    <AppContextImageWall AppPackId="community-admin-mobile"
                         Title="현장에서 보는 커뮤니티" />
}

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);
    private 관리자대시보드요약응답? summary;
    private bool isBusy;
    private string? errorMessage;
    private string syncText = "동기화 대기";
    private CancellationTokenSource? monitorCancellation;
    private Task? monitorTask;

    private static bool EnforceFieldTestRoutes
    {
        get
        {
#if DEBUG
            return false;
#else
            return true;
#endif
        }
    }

    private Severity AttentionSeverity
        => summary is { 관리자확인필요수: > 0 } || summary is { 운송예외수: > 0 }
            ? Severity.Warning
            : Severity.Success;

    private IReadOnlyList<AdminMetricItem> TodayMetrics
        => summary is null
            ? []
            :
            [
                new("오늘 의뢰", summary.오늘의뢰수),
                new("결제 대기", summary.결제대기수),
                new("결제 완료", summary.결제완료수),
                new("배차 확정", summary.배차확정수),
                new("완료", summary.완료수),
                new("취소·환불", summary.취소환불수)
            ];

    protected override async Task OnInitializedAsync()
    {
        LedgerObserver.RefreshRequested += OnLedgerRefreshRequested;
        await Session.RestoreAsync();
        if (!string.IsNullOrWhiteSpace(Session.RefreshToken))
        {
            var authenticationError = await AuthService.EnsureAccessTokenAsync();
            if (authenticationError is not null)
            {
                errorMessage = authenticationError;
            }
        }

        if (Session.IsServerAdmin)
        {
            await StartRealtimeQuietlyAsync();
            await LoadAsync(false);
            StartMonitor();
        }
    }

    private async Task LoadAsync(bool silent)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        if (!silent)
        {
            errorMessage = null;
        }

        try
        {
            summary = await DashboardService.GetAsync();
            syncText = $"최근 동기화 {DateTime.Now:HH:mm:ss}";
            errorMessage = null;
        }
        catch (AdminApiException ex)
        {
            errorMessage = ex.Message;
            syncText = "자동 동기화 지연";
            if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await Session.LogoutAsync();
                StopMonitor();
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private void StartMonitor()
    {
        if (monitorTask is { IsCompleted: false })
        {
            return;
        }

        monitorCancellation = new CancellationTokenSource();
        monitorTask = MonitorAsync(monitorCancellation.Token);
    }

    private void StopMonitor()
    {
        monitorCancellation?.Cancel();
        monitorCancellation?.Dispose();
        monitorCancellation = null;
        monitorTask = null;
    }

    private async Task MonitorAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() => LoadAsync(true));
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void OpenLogin()
        => Navigation.NavigateTo("/login?returnUrl=%2Foverview");

    private async Task RetryAuthenticationAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            errorMessage = await AuthService.EnsureAccessTokenAsync();
        }
        finally
        {
            isBusy = false;
        }

        if (errorMessage is null && Session.IsServerAdmin)
        {
            await StartRealtimeQuietlyAsync();
            await LoadAsync(false);
            StartMonitor();
        }
    }

    public ValueTask DisposeAsync()
    {
        LedgerObserver.RefreshRequested -= OnLedgerRefreshRequested;
        StopMonitor();
        return ValueTask.CompletedTask;
    }

    private void OnLedgerRefreshRequested(TransportRequestLedgerRefreshRequest request)
        => _ = InvokeAsync(async () =>
        {
            await LoadAsync(true);
            StateHasChanged();
        });

    private async Task StartRealtimeQuietlyAsync()
    {
        try
        {
            await RealtimeClient.StartAsync();
        }
        catch
        {
            // 연결 실패 시 30초 보완 조회를 유지합니다.
        }
    }

    private sealed record AdminMetricItem(string Label, int Value);
}
