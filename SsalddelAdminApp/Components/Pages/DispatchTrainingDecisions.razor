@page "/training/dispatch/decisions"
@using Ssalddel.Contracts.Admin.DispatchTraining
@inherits DispatchTrainingPageBase

<PageTitle>배차 판단·AI 비교 · 살뜰 관리자</PageTitle>
<MudStack Spacing="3" Class="admin-overview">
    <MudText Typo="Typo.h4">배차 판단·AI 비교</MudText>
    <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@DispatchTrainingRoutes.Home">가상 퀵 운영으로</MudButton>
    @if (State.Error is { } error) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@error</MudAlert> }
    @if (State.CapabilityChecked && !State.Enabled) { <MudText>현재 서버는 가상 퀵 훈련을 제공하지 않습니다.</MudText> }
    else if (State.RequiresLogin || State.Enabled && !State.IsAdmin) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Login">관리자 로그인</MudButton> }
    else if (State.Enabled)
    {
        <MudText Typo="Typo.body2">실제 훈련 배차는 규칙 엔진이 결정합니다. AI 결과는 별도의 비교 기록입니다.</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Disabled="State.IsBusy" StartIcon="@Icons.Material.Filled.Refresh" OnClick="Refresh">현재 기록 조회</MudButton>
        @if (State.IsBusy) { <MudText role="status">판단 기록을 확인하고 있습니다.</MudText> }
        @if (State.Loaded && State.Decisions.Count == 0) { <MudText>아직 확인할 판단 기록이 없습니다.</MudText> }
        @foreach (var decision in State.Decisions)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4"><MudStack Spacing="2">
                <MudText Typo="Typo.h6">@decision.Summary</MudText><MudText Typo="Typo.caption">@DispatchTrainingPresentation.Time(decision.RecordedAtUtc)</MudText>
                <MudText>규칙 배차: @(decision.RuleDriverLabel ?? "배정 보류")</MudText>
                <MudText>@DispatchTrainingPresentation.Ai(decision.AiResult?.StatusCode)</MudText>
                @if (decision.Candidates.FirstOrDefault(candidate => candidate.DriverLabel == decision.AiResult?.ShadowDriverId) is { } aiCandidate)
                { <MudText>AI 비교 선택: @aiCandidate.DriverLabel</MudText> }
                @if (decision.AiResult?.SameChoice is { } same) { <MudText>규칙 선택과 @(same ? "같음" : "다름")</MudText> }
                @if (decision.AiResult?.ElapsedMilliseconds is { } elapsed) { <MudText Typo="Typo.body2">AI 응답 @elapsed ms</MudText> }
                <details><summary>후보별 판단 근거</summary>
                    @if (decision.Candidates.Count == 0) { <MudText Typo="Typo.body2">확인된 후보 근거가 없습니다.</MudText> }
                    @foreach (var candidate in decision.Candidates)
                    {
                        <div class="my-3"><MudText Typo="Typo.subtitle2">@candidate.DriverLabel · @candidate.Token</MudText>
                            <dl class="training-candidate-facts">
                                <div><dt>후보 조건</dt><dd>@DispatchTrainingPresentation.Eligibility(candidate.EligibilityCode)</dd></div>
                                <div><dt>거리</dt><dd>@(candidate.DistanceKm is { } distance ? distance.ToString("0.##") + "km" : "미확인")</dd></div>
                                <div><dt>기본 점수</dt><dd>@DispatchTrainingPresentation.Score(candidate.BaseScore)</dd></div>
                                <div><dt>대기 가점</dt><dd>@DispatchTrainingPresentation.Score(candidate.AgingScore)</dd></div>
                                <div><dt>합계 점수</dt><dd>@DispatchTrainingPresentation.Score(candidate.TotalScore)</dd></div>
                            </dl>
                        </div>
                    }
                </details>
            </MudStack></MudPaper>
        }
    }
    @if (State.Error is not null && (!State.Enabled || !State.IsAdmin)) { <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="Refresh">다시 확인</MudButton> }
</MudStack>
@code { protected override bool DecisionsMode => true; }
