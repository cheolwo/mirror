@page "/login"
@inject AdminAuthService AuthService
@inject AdminAuthSession Session
@inject NavigationManager Navigation

<PageTitle>관리자 로그인</PageTitle>

<section class="admin-login-shell" aria-labelledby="admin-login-title">
    <div class="admin-login-intro">
        <span>SSALDDEL OPERATIONS</span>
        <h1 id="admin-login-title">운영에 필요한 정보를 빠르게 확인하세요.</h1>
        <p>관리자 계정으로 로그인하면 주문, 배차, 예외 처리 현황을 한 화면에서 볼 수 있습니다.</p>
    </div>

    <Ssalddel공통로그인Panel 제목="관리자 로그인"
                         설명="관리자 아이디와 비밀번호를 입력해 주세요."
                         Class="admin-login-card"
                         상태메시지="@statusMessage"
                         상태Severity="@statusSeverity"
                         IsBusy="@isBusy"
                         소셜로그인표시="false"
                         OnPasswordLogin="HandleLoginAsync" />
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private bool isBusy;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (Session.IsServerAdmin)
        {
            NavigateAfterLogin();
        }
    }

    private async Task HandleLoginAsync(공통로그인요청 request)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await AuthService.LoginAsync(request.UserNameOrEmail, request.Password);
            if (!result.Succeeded)
            {
                statusSeverity = Severity.Error;
                statusMessage = result.ErrorMessage;
                return;
            }

            NavigateAfterLogin();
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"로그인 처리 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void NavigateAfterLogin()
        => Navigation.NavigateTo(IsSafeLocalRoute(ReturnUrl) ? ReturnUrl! : "/overview");

    private static bool IsSafeLocalRoute(string? route)
        => !string.IsNullOrWhiteSpace(route)
           && route.StartsWith("/", StringComparison.Ordinal)
           && !route.StartsWith("//", StringComparison.Ordinal)
           && !route.StartsWith("/\\", StringComparison.Ordinal);
}
