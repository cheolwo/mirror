@page "/operations"
@implements IAsyncDisposable
@inject AdminAuthSession Session
@inject AdminAuthService AuthService
@inject AdminOperationsService OperationsService
@inject ITransportRequestLedgerObserver LedgerObserver
@inject TransportRequestLedgerRealtimeClient RealtimeClient
@inject NavigationManager Navigation
@using Ssalddel.Contracts.Admin.Restaurants

<PageTitle>운송·기사 모바일 관제</PageTitle>

<MudStack Spacing="3">
    <div class="admin-page-header">
        <MudStack Spacing="1">
            <MudText Typo="Typo.overline" Color="Color.Primary">OPERATIONS</MudText>
            <MudText Typo="Typo.h4">운송·기사 현황</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                진행 중인 운송과 운행 기사 현황을 확인하세요.
            </MudText>
        </MudStack>
        @if (Session.IsServerAdmin)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="isBusy"
                       OnClick="@(() => LoadAsync(false))">
                새로고침
            </MudButton>
        }
    </div>

    @if (!Session.IsServerAdmin)
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage)
             && !string.IsNullOrWhiteSpace(Session.RefreshToken))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                @errorMessage
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Disabled="isBusy"
                           OnClick="RetryAuthenticationAsync">
                    세션 다시 연결
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="OpenLogin">다시 로그인</MudButton>
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                서버관리자 로그인이 필요합니다.
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="OpenLogin">로그인</MudButton>
            </MudAlert>
        }
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                @errorMessage
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => LoadAsync(false))">다시 시도</MudButton>
            </MudAlert>
        }

        @if (isBusy && snapshot is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (snapshot is not null)
        {
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MetricCard Title="진행 운송"
                                Value="@snapshot.Transports.Count.ToString("N0")"
                                Description="서버 운송 목록"
                                Icon="@Icons.Material.Filled.Route"
                                AccentColor="Color.Primary" />
                </MudItem>
                <MudItem xs="6">
                    <MetricCard Title="운행 기사"
                                Value="@snapshot.OperatingDrivers.Count.ToString("N0")"
                                Description="현재 운행 상태"
                                Icon="@Icons.Material.Filled.PersonPinCircle"
                                AccentColor="Color.Success" />
                </MudItem>
            </MudGrid>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">한시 수요 할증</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                기사를 호출하거나 지시하지 않고, 새 배차 제안의 지급 조건만 일정 시간 높입니다.
                            </MudText>
                        </MudStack>
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="@(snapshot.TemporaryDemandSurcharge.IsActive ? Color.Warning : Color.Default)"
                                 Variant="Variant.Outlined">
                            @(snapshot.TemporaryDemandSurcharge.IsActive ? "적용 중" : "미적용")
                        </MudChip>
                    </MudStack>

                    @if (snapshot.TemporaryDemandSurcharge.IsActive)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                            새 음식 배달 제안에 @snapshot.TemporaryDemandSurcharge.SurchargeAmount.ToString("N0")원 추가 ·
                            @TemporarySurchargeRemaining(snapshot.TemporaryDemandSurcharge)
                        </MudAlert>
                    }

                    @if (!snapshot.TemporaryDemandSurcharge.CanApply)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            현재 환경에서는 한시 수요 할증을 변경할 수 없습니다.
                        </MudAlert>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">1. 적용시간</MudText>
                        <MudGrid Spacing="1">
                            @foreach (var duration in snapshot.TemporaryDemandSurcharge.AllowedDurationMinutes)
                            {
                                <MudItem xs="4">
                                    <MudButton Variant="@(selectedDurationMinutes == duration ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               FullWidth="true"
                                               Disabled="isBusy"
                                               OnClick="@(() => selectedDurationMinutes = duration)">
                                        @duration 분
                                    </MudButton>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudText Typo="Typo.body2">2. 추가 지급액</MudText>
                        <MudGrid Spacing="1">
                            @foreach (var amount in snapshot.TemporaryDemandSurcharge.AllowedAmounts)
                            {
                                <MudItem xs="4">
                                    <MudButton Variant="@(selectedSurchargeAmount == amount ? Variant.Filled : Variant.Outlined)"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               FullWidth="true"
                                               Disabled="isBusy"
                                               OnClick="@(() => selectedSurchargeAmount = amount)">
                                        +@amount.ToString("N0")원
                                    </MudButton>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.PriceChange"
                                   Disabled="@(isBusy || !selectedSurchargeAmount.HasValue)"
                                   OnClick="ApplyTemporaryDemandSurchargeAsync">
                            선택한 조건 적용
                        </MudButton>
                    }

                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">@successMessage</MudAlert>
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        범위: 전체 음식 배달 · 사유: 제안 가능 기사 부족 · 정책 @snapshot.TemporaryDemandSurcharge.PolicyRevision
                    </MudText>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.subtitle1">확인 필요한 운송</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                            @(AttentionTransports.Count)건
                        </MudChip>
                    </MudStack>
                    @if (AttentionTransports.Count == 0)
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">현재 관리자 확인이 필요한 운송이 없습니다.</MudAlert>
                    }
                    else
                    {
                        @foreach (var transport in AttentionTransports.Take(10))
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                        <MudText Typo="Typo.subtitle2">@ValueOrDash(transport.운송번호)</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Error">@ValueOrDash(transport.상태)</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.body2">@ValueOrDash(transport.출발지) → @ValueOrDash(transport.도착지)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        기사 @ValueOrDash(transport.기사_운송자) · @transport.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(transport.최근예외메시지))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Error">@transport.최근예외메시지</MudText>
                                    }
                                </MudStack>
                            </MudPaper>
                        }
                    }
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1">최근 운송</MudText>
                    @if (snapshot.Transports.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">조회된 운송이 없습니다.</MudText>
                    }
                    else
                    {
                        @foreach (var transport in snapshot.Transports.OrderByDescending(x => x.UpdatedAt).Take(12))
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@ValueOrDash(transport.운송번호)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ValueOrDash(transport.기사_운송자)</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="@TransportColor(transport)" Variant="Variant.Outlined">
                                    @ValueOrDash(transport.상태)
                                </MudChip>
                            </MudStack>
                            <MudDivider />
                        }
                    }
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1">운행 기사</MudText>
                    @if (snapshot.OperatingDrivers.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">현재 조회된 운행 기사가 없습니다.</MudText>
                    }
                    else
                    {
                        @foreach (var driver in snapshot.OperatingDrivers.Take(12))
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2">@ValueOrDash(driver.기사명)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @ValueOrDash(driver.차량) · @ValueOrDash(driver.주_활동지역)
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                    @ValueOrDash(driver.운행상태)
                                </MudChip>
                            </MudStack>
                            <MudDivider />
                        }
                    }
                </MudStack>
            </MudPaper>

            <MudText Typo="Typo.caption" Color="Color.Secondary">
                최근 동기화 @snapshot.UpdatedAtUtc.ToLocalTime().ToString("HH:mm:ss")
            </MudText>
        }
    }
</MudStack>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);
    private AdminMobileOperationsSnapshot? snapshot;
    private bool isBusy;
    private string? errorMessage;
    private string? successMessage;
    private int selectedDurationMinutes = 30;
    private decimal? selectedSurchargeAmount;
    private CancellationTokenSource? monitorCancellation;
    private Task? monitorTask;

    private IReadOnlyList<운송진행응답> AttentionTransports
        => snapshot?.Transports
               .Where(x => x.관리자확인필요 || x.예외신고됨)
               .OrderByDescending(x => x.UpdatedAt)
               .ToArray()
           ?? [];

    protected override async Task OnInitializedAsync()
    {
        LedgerObserver.RefreshRequested += OnLedgerRefreshRequested;
        await Session.RestoreAsync();
        if (!string.IsNullOrWhiteSpace(Session.RefreshToken))
        {
            errorMessage = await AuthService.EnsureAccessTokenAsync();
        }

        if (Session.IsServerAdmin)
        {
            await StartRealtimeQuietlyAsync();
            await LoadAsync(false);
            StartMonitor();
        }
    }

    private async Task LoadAsync(bool silent)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        if (!silent)
        {
            errorMessage = null;
            successMessage = null;
        }

        try
        {
            snapshot = await OperationsService.GetAsync();
            errorMessage = null;
        }
        catch (AdminApiException ex)
        {
            errorMessage = ex.Message;
            if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                await Session.LogoutAsync();
                StopMonitor();
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ApplyTemporaryDemandSurchargeAsync()
    {
        if (snapshot is null
            || !snapshot.TemporaryDemandSurcharge.CanApply
            || !selectedSurchargeAmount.HasValue
            || isBusy)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            var state = await OperationsService.ApplyTemporaryDemandSurchargeAsync(
                new 음식배달한시수요할증적용요청
                {
                    SurchargeAmount = selectedSurchargeAmount.Value,
                    DurationMinutes = selectedDurationMinutes,
                    ReasonCode = 음식배달한시수요할증사유Codes.제안가능기사부족,
                    ScopeCode = 음식배달한시수요할증범위Codes.전체음식배달,
                    ExpectedRevision = snapshot.TemporaryDemandSurcharge.Revision,
                    ClientRequestId = Guid.NewGuid()
                });
            snapshot = snapshot with
            {
                TemporaryDemandSurcharge = state,
                UpdatedAtUtc = DateTime.UtcNow
            };
            successMessage = $"{state.SurchargeAmount:N0}원 한시 할증을 {state.DurationMinutes}분 동안 적용했습니다.";
            selectedSurchargeAmount = null;
        }
        catch (AdminApiException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OpenLogin()
        => Navigation.NavigateTo("/login?returnUrl=%2Foperations");

    private async Task RetryAuthenticationAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;
        try
        {
            errorMessage = await AuthService.EnsureAccessTokenAsync();
        }
        finally
        {
            isBusy = false;
        }

        if (errorMessage is null && Session.IsServerAdmin)
        {
            await StartRealtimeQuietlyAsync();
            await LoadAsync(false);
            StartMonitor();
        }
    }

    private void StartMonitor()
    {
        if (monitorTask is { IsCompleted: false })
        {
            return;
        }

        monitorCancellation = new CancellationTokenSource();
        monitorTask = MonitorAsync(monitorCancellation.Token);
    }

    private void StopMonitor()
    {
        monitorCancellation?.Cancel();
        monitorCancellation?.Dispose();
        monitorCancellation = null;
        monitorTask = null;
    }

    private async Task MonitorAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() => LoadAsync(true));
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private static Color TransportColor(운송진행응답 transport)
        => transport.관리자확인필요 || transport.예외신고됨
            ? Color.Error
            : transport.상태.Contains("완료", StringComparison.OrdinalIgnoreCase)
                ? Color.Success
                : Color.Info;

    private static string ValueOrDash(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    private static string TemporarySurchargeRemaining(음식배달한시수요할증응답 state)
    {
        if (!state.ExpiresAtUtc.HasValue)
        {
            return "종료 시각 미정";
        }

        var remaining = state.ExpiresAtUtc.Value - state.ServerNowUtc;
        return remaining <= TimeSpan.Zero
            ? "종료됨"
            : $"약 {Math.Max(1, (int)Math.Ceiling(remaining.TotalMinutes))}분 남음";
    }

    public ValueTask DisposeAsync()
    {
        LedgerObserver.RefreshRequested -= OnLedgerRefreshRequested;
        StopMonitor();
        return ValueTask.CompletedTask;
    }

    private void OnLedgerRefreshRequested(TransportRequestLedgerRefreshRequest request)
        => _ = InvokeAsync(async () =>
        {
            await LoadAsync(true);
            StateHasChanged();
        });

    private async Task StartRealtimeQuietlyAsync()
    {
        try
        {
            await RealtimeClient.StartAsync();
        }
        catch
        {
            // 연결 실패 시 30초 보완 조회를 유지합니다.
        }
    }
}
