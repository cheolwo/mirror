<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SsalddelAdminApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AdminFirebaseGoogleServicesJson Condition="'$(AdminFirebaseGoogleServicesJson)' == ''">$(SSALDDEL_ADMIN_FIREBASE_GOOGLE_SERVICES_JSON)</AdminFirebaseGoogleServicesJson>
    <DefineConstants Condition="Exists('$(AdminFirebaseGoogleServicesJson)')">$(DefineConstants);SSALDDEL_ADMIN_FIREBASE</DefineConstants>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <ApplicationTitle>살뜰 관리자</ApplicationTitle>
    <ApplicationId>com.ssalddel.adminapp</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(SsalddelServerBaseAddress)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SsalddelServerBaseAddress</_Parameter1>
      <_Parameter2>$(SsalddelServerBaseAddress)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ssalddel.Contracts\Ssalddel.Contracts.csproj" />
    <ProjectReference Include="..\Ssalddel.Client.Infrastructure\Ssalddel.Client.Infrastructure.csproj" />
    <ProjectReference Include="..\Ssalddel.Ui.Common\Ssalddel.Ui.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#173B57" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#173B57" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android' and Exists('$(AdminFirebaseGoogleServicesJson)')">
    <PackageReference Include="Xamarin.Firebase.Messaging" />
    <GoogleServicesJson Include="$(AdminFirebaseGoogleServicesJson)" />
  </ItemGroup>
  <Target Name="ValidateAdminFirebaseConfiguration" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' == 'net10.0-android'">
    <Error Condition="'$(AdminFirebaseGoogleServicesJson)' != '' and !Exists('$(AdminFirebaseGoogleServicesJson)')" Text="관리자 Firebase 설정 파일을 찾을 수 없습니다." />
    <Warning Condition="'$(AdminFirebaseGoogleServicesJson)' == ''" Text="관리자 Firebase 설정 없음: 실제 푸시는 연결되지 않습니다. 로컬 앱 검증용 빌드입니다." />
  </Target>
</Project>
