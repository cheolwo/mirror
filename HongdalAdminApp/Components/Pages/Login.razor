@page "/login"
@inject AdminAuthService AuthService
@inject AdminAuthSession Session
@inject NavigationManager Navigation

<PageTitle>관리자 로그인</PageTitle>

<Hongdal공통로그인Panel 제목="살뜰 관리자 로그인"
                     설명="서버관리자 권한이 있는 계정만 커뮤니티 운영과 내부 자료 관리 기능을 사용할 수 있습니다."
                     Style="max-width: 520px; margin: 2rem auto;"
                     상태메시지="@statusMessage"
                     상태Severity="@statusSeverity"
                     IsBusy="@isBusy"
                     OnPasswordLogin="HandleLoginAsync"
                     OnSocialLogin="HandleSocialLoginAsync" />

@code {
    private bool isBusy;
    private string? statusMessage;
    private Severity statusSeverity = Severity.Info;

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        if (Session.IsServerAdmin)
        {
            Navigation.NavigateTo("/community-management");
        }
    }

    private async Task HandleLoginAsync(공통로그인요청 request)
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        statusMessage = null;
        try
        {
            var result = await AuthService.LoginAsync(request.UserNameOrEmail, request.Password);
            if (!result.Succeeded)
            {
                statusSeverity = Severity.Error;
                statusMessage = result.ErrorMessage;
                return;
            }

            Navigation.NavigateTo("/community-management");
        }
        catch (Exception ex)
        {
            statusSeverity = Severity.Error;
            statusMessage = $"로그인 처리 중 오류가 발생했습니다: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private Task HandleSocialLoginAsync(공통소셜로그인요청 request)
    {
        statusSeverity = Severity.Info;
        statusMessage = $"{request.ProviderDisplayName} 관리자 로그인은 아직 연결하지 않았습니다.";
        return Task.CompletedTask;
    }
}
