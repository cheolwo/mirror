<Window x:Class="Ssalddel.BatchMonitor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ssalddel.BatchMonitor.Windows"
        Title="살뜰 · 가상 배치 관찰 · Claude 작업본" Width="1340" Height="820" MinWidth="880" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#EAF0F3" FontFamily="Malgun Gothic" FontSize="13">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
        </Style>
        <DataTemplate x:Key="OrderRow">
            <Border Background="#F4F8F9" BorderBrush="{StaticResource Edge}" BorderThickness="1" CornerRadius="5"
                    Margin="0,0,0,6" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border MinWidth="22" Height="22" CornerRadius="11" Background="#CDECE1" BorderBrush="#91C7BA"
                            BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="3,0" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Number}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Subtle}"
                               VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="BatchRow">
            <Border Background="#EFF6F4" CornerRadius="5" Padding="8,7" Margin="0,0,0,6">
                <TextBlock Text="{Binding}" FontSize="12"/>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="PageHeading" Text="길 구간 지도 · 가상 배치 관찰" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="PageDescription" Text="주문이 들어오고, 묶이고, 처리된 뒤 목록에서 정리됩니다." Foreground="{StaticResource Subtle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button x:Name="ModeButton" Content="경영 체험" Click="SwitchMode" Padding="9,5" Margin="0,0,8,0"/>
                <Border Background="#D8F0E6" CornerRadius="5" Padding="9,5" Margin="0,0,8,0">
                    <TextBlock x:Name="ModeIndicator" Text="● 자동 관찰 중" FontWeight="Bold" Foreground="#146657"/>
                </Border>
                <Border Style="{StaticResource Card}" Padding="9,5">
                    <TextBlock x:Name="ClockText" Text="경과 00:00" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="282"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="13">
                <Grid>
                <ScrollViewer x:Name="ObservationPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ListHeading" Text="주문·배치 현황" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="Counters" Background="#EDF6F2" Padding="8,6" Margin="0,0,0,11" TextWrapping="Wrap"/>
                        <TextBlock x:Name="FreightStatus" Background="#FFF2DF" Foreground="#633A16" Padding="8,6"
                                   Margin="0,0,0,11" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="AssignmentHeading" Text="현재 배치" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="NoBatch" Text="첫 묶음이 만들어지는 중" Foreground="{StaticResource Subtle}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="BatchList" ItemTemplate="{StaticResource BatchRow}"/>
                        <TextBlock x:Name="OrderHeading" Text="가상 주문" FontWeight="Bold" Margin="0,8,0,5"/>
                        <ItemsControl x:Name="OrderList" ItemTemplate="{StaticResource OrderRow}"/>
                    </StackPanel>
                </ScrollViewer>
                <local:FoodManagementPanel x:Name="ManagementPanel" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Padding="12,7" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="MapHeading" Text="가상 관찰 구역" FontWeight="Bold"/>
                            <TextBlock x:Name="MapDescription" Text="네이버 지도 연결 준비 중" FontSize="11" Foreground="{StaticResource Subtle}"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" x:Name="MapSurface">
                        <local:BatchRouteMap x:Name="RouteMap" AutomationProperties.Name="가상 주문 번호와 배치 이동 선분 지도"/>
                        <TextBlock x:Name="UnavailableMap" Text="지도 연결 중에도 주문과 배차는 계속 표시됩니다."
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Subtle}"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <Border Grid.Row="2" Padding="12,7" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
                        <WrapPanel>
                            <TextBlock x:Name="OrderLegend" Text="● 주문 번호" Foreground="#177668" Margin="0,0,14,0"/>
                            <TextBlock x:Name="RouteLegend" Text="━ 이동 중" Foreground="#6244A9" Margin="0,0,14,0"/>
                            <TextBlock x:Name="WaitingLegend" Text="┄ 묶음 대기" Foreground="#3A7699" Margin="0,0,14,0"/>
                            <TextBlock x:Name="CompletedLegend" Text="━ 완료" Foreground="#20836F"/>
                            <TextBlock x:Name="RouteCredit" Text="도로 표본 © OpenStreetMap contributors · ODbL"
                                       Foreground="{StaticResource Subtle}" FontSize="11" Margin="14,0,0,0" Visibility="Collapsed"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="13,9">
            <StackPanel>
                <TextBlock Text="최근 처리 내역" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock x:Name="EventLog" MinHeight="45" FontSize="12" Foreground="{StaticResource Subtle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
