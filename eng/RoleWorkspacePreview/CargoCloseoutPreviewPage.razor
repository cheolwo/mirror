@page "/cargo-closeout-preview"
@using Ssalddel.Ui.Common.Areas.App.Components.Transport
@using DriverApp.ViewModels.Driver.Transport
@using DriverApp.Services
@implements IDisposable

<Ssalddel.Ui.Common.Areas.App.Components.RoleAppProviders />
<main style="max-width:760px;margin:auto;padding:24px 16px">
    <h1>화물 업무 마무리 화면</h1>
    <p>화면 확인용 예시입니다. 실제 인수증·신고·정산 기록은 변경하지 않습니다.</p>
    <section data-testid="receipt-example">
        <h2>화주 · 인수증 확인</h2>
        <ShipperReceiptRegistrationPanel ReadinessMessage="@ReceiptMessage"
            @bind-ReceiptNumber="receipt" @bind-Memo="memo" @bind-AcceptanceConfirmed="accepted"
            Registered="registered" RegisteredNumber="@receipt" InputLocked="@(waiting || registered)"
            NeedsResultCheck="waiting" CanRegister="@(!waiting && accepted && !string.IsNullOrWhiteSpace(receipt))"
            RegisterRequested="Register" CheckRequested="Check" />
        <MudButton Variant="Variant.Text" OnClick="ResetReceipt">인수증 예시 다시 보기</MudButton>
    </section>
    <section data-testid="issue-example" style="margin-top:32px">
        <h2>기사 · 신고 응답 미확정</h2>
        <RoleWorkspacePreview.LinkedDriver.DriverTransportIssuePanel Title="운송 문제 신고"
            IssueTypes="@issue.유형목록" @bind-Open="issue.열림" @bind-IssueType="issue.유형" @bind-Memo="issue.메모"
            IsReporting="issue.신고중" CanSubmit="issue.신고가능" ResultUncertain="issue.결과확인필요"
            OnSubmit="Report" />
        @if (!string.IsNullOrWhiteSpace(status.메시지))
        {
            <p role="status">@status.메시지</p>
        }
        <output data-issue-posts="@reports.Calls" data-issue-waiting="@issue.결과확인필요"></output>
    </section>
</main>

@code {
    private string receipt = "";
    private string memo = "";
    private bool accepted, waiting, registered;
    private readonly 기사운송작업상태ViewModel status = new();
    private readonly ExampleReporter reports = new();
    private 기사운송예외신고ViewModel issue = null!;
    private string ReceiptMessage => registered ? "인수증 등록 상태를 확인했습니다. 정산·입금은 별도로 확인합니다."
        : waiting ? "응답을 확인하지 못했습니다. 같은 등록 결과를 확인해 주세요."
        : "수령한 화물과 인수증을 확인한 뒤 등록해 주세요.";
    protected override void OnInitialized()
    {
        issue = new(reports, status, "상차", ["수량 부족", "파손 의심"], "수량 부족", _ => "수량불일치");
        issue.운송설정(11);
    }
    private void Register() { if (accepted && !string.IsNullOrWhiteSpace(receipt)) waiting = true; }
    private void Check() { waiting = false; registered = true; }
    private void ResetReceipt() { receipt = memo = ""; accepted = waiting = registered = false; }
    private Task Report() => issue.신고Async();
    public void Dispose() => issue?.Dispose();
    private sealed class ExampleReporter : IDriverTransportExceptionService
    {
        public int Calls { get; private set; }
        public Task<DriverTransportExceptionReportResult> ReportAsync(DriverTransportExceptionReport report, CancellationToken cancellationToken = default)
        {
            Calls++;
            return Task.FromResult(new DriverTransportExceptionReportResult(false, "신고 결과 확인 필요", OutcomeUnknown: true));
        }
    }
}
