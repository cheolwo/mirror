@using Microsoft.JSInterop
@using System.Text.RegularExpressions
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="mart-package-scan" data-package-scan-state="@_상태" aria-label="주문 전표 QR 픽업">
    <button type="button" class="mart-package-scan__button" data-package-scan-start
            disabled="@(Disabled || _카메라열림)" @onclick="스캔시작Async">전표 QR 스캔 · 픽업</button>
    <p class="mart-package-scan__notice" role="status" aria-live="polite">@상태안내</p>
    <div class="mart-package-scan__camera" hidden="@(!_카메라열림)">
        <video @ref="_영상" data-package-scan-video autoplay muted playsinline aria-label="주문 전표 QR 카메라 미리보기"></video>
        <p>포장에 붙인 주문 전표 QR을 화면 가운데에 맞춰 주세요.</p>
        <button type="button" class="mart-package-scan__button mart-package-scan__button--secondary"
                data-package-scan-stop @onclick="스캔닫기Async">카메라 닫기 · 번호 입력</button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string ExpectedPackageCode { get; set; } = "";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> CodeScanned { get; set; }

    private static readonly Regex 전표코드Pattern = new(@"\ASAMPLE-PKG-[0-9a-f]{32}-[1-9][0-9]{0,5}\z", RegexOptions.CultureInvariant | RegexOptions.NonBacktracking);
    private ElementReference _영상;
    private IJSObjectReference? _모듈, _스캐너;
    private DotNetObjectReference<SsalddelMartPackageScanner>? _콜백;
    private string _표찰코드 = "", _세션 = "", _상태 = "idle";
    private long _대상판본;
    private bool _카메라열림, _disposed;

    private string 상태안내 => _상태 switch
    {
        "starting" => "카메라 권한을 확인하고 있어요. 닫고 전표의 네 자리 번호를 입력해도 됩니다.",
        "scanning" => "전표 QR을 읽고 있어요. 인식되면 추가 버튼 없이 픽업을 요청합니다.",
        "matched" => "전표 코드를 확인했어요. 위에 표시되는 픽업 처리 결과를 확인해 주세요.",
        "wrong-code" => "현재 주문의 전표 QR이 아니에요. 올바른 전표로 다시 스캔하거나 번호를 입력해 주세요.",
        "permission-denied" => "카메라 권한이 허용되지 않았어요. 전표의 네 자리 번호를 입력해 주세요.",
        "camera-unavailable" => "사용할 수 있는 카메라가 없어요. 전표의 네 자리 번호를 입력해 주세요.",
        "unsupported" => "이 브라우저는 QR 카메라 인식을 지원하지 않아요. 전표 번호를 입력해 주세요.",
        "insecure" => "카메라는 보안 연결이 필요해요. 지금은 전표 번호를 입력해 주세요.",
        "timeout" => "QR을 읽지 못해 카메라를 닫았어요. 다시 스캔하거나 전표 번호를 입력해 주세요.",
        "hidden" or "disconnected" => "화면을 떠나거나 연결이 끊겨 카메라를 닫았어요. 필요하면 다시 켜 주세요.",
        "cancelled" => "카메라를 닫았어요. 전표 번호로 픽업을 요청해도 됩니다.",
        "failed" => "QR 인식을 마치지 못했어요. 다시 스캔하거나 전표 번호를 입력해 주세요.",
        _ => "전표 QR을 스캔하면 픽업을 요청해요. 포장 준비와 현재 배정 건인지 확인한 뒤 결과를 표시합니다."
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_표찰코드 != ExpectedPackageCode)
        {
            ++_대상판본;
            _표찰코드 = ExpectedPackageCode;
            await 카메라해제Async();
            _상태 = "idle";
        }
        if (Disabled && _카메라열림) await 스캔닫기Async();
    }

    private async Task 스캔시작Async()
    {
        if (_disposed || Disabled || _카메라열림 || !합성전표코드인가(ExpectedPackageCode)) return;
        await 카메라해제Async();
        if (_disposed || Disabled || !합성전표코드인가(ExpectedPackageCode)) return;
        var targetCode = ExpectedPackageCode;
        var targetVersion = _대상판본;
        _카메라열림 = true;
        _상태 = "starting";
        var session = _세션 = Guid.NewGuid().ToString("N");
        try
        {
            if (_모듈 is null)
            {
                var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ssalddel-mart-scanner.js");
                if (!현재세션인가(session, targetCode, targetVersion))
                {
                    // import 대기 중 component가 폐기되면 DisposeAsync가 보지 못한 늦은 참조도 정리합니다.
                    await imported.DisposeAsync();
                    return;
                }
                _모듈 = imported;
            }
            if (!현재세션인가(session, targetCode, targetVersion)) return;
            _콜백 ??= DotNetObjectReference.Create(this);
            var scanner = await _모듈.InvokeAsync<IJSObjectReference>("createScanner", _영상, _콜백, session, targetCode, "package");
            if (!현재세션인가(session, targetCode, targetVersion))
            {
                await scanner.InvokeVoidAsync("dispose");
                await scanner.DisposeAsync();
                return;
            }
            _스캐너 = scanner;
            var state = await scanner.InvokeAsync<string>("start");
            if (현재세션인가(session, targetCode, targetVersion) && _상태 == "starting")
            {
                _상태 = state is "scanning" or "unsupported" or "insecure" or "permission-denied" or "camera-unavailable" or "cancelled" ? state : "failed";
                _카메라열림 = state == "scanning";
            }
        }
        catch (Exception error) when (error is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException)
        {
            if (!_disposed && _세션 == session) { _상태 = "failed"; await 카메라해제Async(); }
        }
    }

    [JSInvokable]
    public async Task OnScanAsync(string session, string state, string rawCode)
    {
        if (_disposed || Disabled || !_카메라열림 || session != _세션) return;
        if (state == "matched")
        {
            var targetCode = ExpectedPackageCode;
            var targetVersion = _대상판본;
            if (!합성전표코드인가(rawCode) || !string.Equals(rawCode, targetCode, StringComparison.Ordinal)) return;
            _상태 = "matched";
            // 스캔은 픽업 의사입니다. 카메라를 먼저 해제하고 권위 결과는 부모 Runtime이 표시합니다.
            await 카메라해제Async();
            if (!_disposed && !Disabled && targetVersion == _대상판본 && string.Equals(targetCode, ExpectedPackageCode, StringComparison.Ordinal))
                await CodeScanned.InvokeAsync(rawCode);
        }
        else if (state is "wrong-code" or "timeout" or "hidden" or "disconnected" or "failed")
        {
            _상태 = state;
            await 카메라해제Async();
        }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private bool 현재세션인가(string session, string code, long version) => !_disposed && !Disabled && _세션 == session &&
        _대상판본 == version && string.Equals(code, ExpectedPackageCode, StringComparison.Ordinal);

    private static bool 합성전표코드인가(string? code) => code is { Length: >= 45 and <= 50 } && 전표코드Pattern.IsMatch(code);
    private async Task 스캔닫기Async() { _상태 = "cancelled"; await 카메라해제Async(); }

    private async Task 카메라해제Async()
    {
        _세션 = "";
        _카메라열림 = false;
        var scanner = _스캐너;
        _스캐너 = null;
        if (scanner is null) return;
        try { await scanner.InvokeVoidAsync("dispose"); await scanner.DisposeAsync(); }
        catch (Exception error) when (error is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        ++_대상판본;
        _콜백?.Dispose();
        await 카메라해제Async();
        if (_모듈 is not null)
        {
            try { await _모듈.DisposeAsync(); }
            catch (Exception error) when (error is JSException or JSDisconnectedException or InvalidOperationException or OperationCanceledException) { }
        }
    }
}
