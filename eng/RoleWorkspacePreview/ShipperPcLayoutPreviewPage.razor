@page "/shipper-pc-layout-preview/{Scenario}"
@layout RoleWorkspacePreview.LinkedShipper.ShipperMobileLayout
@using Ssalddel.Contracts.Shipper.Request
@using Ssalddel.Ui.Common.Areas.App.Components.Crud
@using Ssalddel.Ui.Common.Areas.App.Components.Transport

<PageTitle>화주 화면 배치 확인</PageTitle>
<MudThemeProvider />
<MudPopoverProvider /><MudDialogProvider /><MudSnackbarProvider />
<section data-shipper-pc-layout-preview="@Scenario">
    <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mb-4">
        화면 배치 확인용 예시 · 실제 접수·조회·배차·결제 연결 없음
    </MudAlert>
    @if (Scenario == "input")
    {
        <ShipperRequestCargoScreen ViewModel="Fixture.Authoring"
                                   NavigationContext="@(new ShipperRequestNavigationContext())"
                                   Title="화물 조건 입력" RootBackHref="/shipper-pc-layout-preview/list" />
    }
    else if (Scenario is "summary" or "completed" or "payment-pending" or "held")
    {
        <ShipperRequestSummaryScreen State="@(Fixture.Summary(Scenario == "completed", Scenario))"
                                     Context="@(new ShipperRequestDetailNavigationContext())"
                                     HomeHref="/shipper-pc-layout-preview/list"
                                     NewRequestHref="/shipper-pc-layout-preview/input" />
    }
    else
    {
        <h1>운송 의뢰 목록</h1>
        <p>공통 표·카드의 좁은 화면과 넓은 화면 배치를 확인합니다.</p>
        <div class="ssalddel-account-workspace__table" data-preview-request-table>
            <SsalddelCrudTable TItem="ShipperPcLayoutPreviewFixture.RequestRow" Items="Fixture.Rows" ShowPager="false">
                <HeaderContent><MudTh>의뢰</MudTh><MudTh>상차</MudTh><MudTh>전달</MudTh><MudTh>상태</MudTh></HeaderContent>
                <RowContent Context="row">
                    <MudTd DataLabel="의뢰">@row.Name</MudTd><MudTd DataLabel="상차">@row.Pickup</MudTd>
                    <MudTd DataLabel="전달">@row.Dropoff</MudTd><MudTd DataLabel="상태">@row.State</MudTd>
                </RowContent>
            </SsalddelCrudTable>
        </div>
        <div class="ssalddel-account-workspace__cards" data-preview-request-cards>
            <SsalddelCrudCardList TItem="ShipperPcLayoutPreviewFixture.RequestRow" Items="Fixture.Rows">
                <CardContent Context="row">
                    <strong>@row.Name · @row.State</strong><p>@row.Pickup → @row.Dropoff</p>
                </CardContent>
            </SsalddelCrudCardList>
        </div>
    }
</section>

@code {
    [Parameter] public string Scenario { get; set; } = "input";
    private readonly ShipperPcLayoutPreviewFixture Fixture = new();
}
