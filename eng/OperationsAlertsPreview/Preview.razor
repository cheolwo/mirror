@page "/"
@page "/operations-alerts"
@page "/operations-alerts/{AlertId}"
@namespace OperationsAlertsPreview
@using Microsoft.AspNetCore.Components
@using Ssalddel.Contracts.Admin.Operations
@using Ssalddel.Ui.Common.Areas.BackOffice.ViewModels
@using Ssalddel.Ui.Common.Areas.BackOffice.Components.Operations
@implements IDisposable
@if(state is not null) { <OperationsAlertsView State="state" Authenticated="authenticated" DetailId="@AlertId" Status="@status" Retry="Load"
    SelectStatus="Select" Next="Next" Previous="Previous" Acknowledge="Acknowledge"/> }
@code {
    [Parameter] public string? AlertId {get;set;}
    [SupplyParameterFromQuery(Name="state")] public string? Scenario {get;set;}
    private OperationsAlertsState? state;
    private PreviewClient client=new();
    private bool authenticated=true;
    private string status="Open";
    private int page=1;
    protected override async Task OnParametersSetAsync()
    {
        state?.Dispose();client=new(){Scenario=Scenario??"list"};state=new(client);authenticated=Scenario!="login";
        state.SetOwner(authenticated?"test-admin":null);await Load();
    }
    private Task Load()=>state!.LoadAsync(AlertId,status,page);
    private async Task Select(string value){status=value;page=1;await Load();}
    private async Task Next(){page++;await Load();}
    private async Task Previous(){page--;await Load();}
    private async Task Acknowledge(){await state!.AcknowledgeAsync();StateHasChanged();}
    public void Dispose()=>state?.Dispose();
    private sealed class PreviewClient : IOperationsAlertsClient
    {
        public string Scenario="list";private string status="Open";
        public Task<OperationsAlertsPage> ListAsync(string filter,int page,CancellationToken ct)
        {
            if(Scenario=="error")throw new InvalidOperationException();
            var items=Scenario=="empty"?Array.Empty<OperationsAlertDto>():new[]{Dto(new string('a',64),"거래 문제 접수","Urgent",filter),Dto(new string('b',64),"사진 업로드 확인 필요","Warning",filter)};
            return Task.FromResult(new OperationsAlertsPage(Scenario!="disabled",false,items,page,page==1));
        }
        public Task<OperationsAlertDto?> DetailAsync(string id,CancellationToken ct)=>Task.FromResult<OperationsAlertDto?>(Dto(id,"거래 문제 접수","Urgent",status));
        public Task<OperationsAlertDto> AcknowledgeAsync(string id,OperationsAlertAcknowledgeRequest r,CancellationToken ct)
        { if(Scenario=="conflict")throw new InvalidOperationException();status="Acknowledged";return Task.FromResult(Dto(id,"거래 문제 접수","Urgent",status)); }
        private OperationsAlertDto Dto(string id,string title,string severity,string state)=>new(id,1,2,severity,state,title,"해당 업무를 열어 진행 상태와 처리 근거를 확인하세요.","/privacy-support/test-case",DateTime.UtcNow,DateTime.UtcNow,Scenario!="stale",["Push:Pending","Email:ConfigurationRequired"]);
    }
}
