@page "/privacy-support"
@page "/privacy-support/{CaseId}"
@using Ssalddel.Ui.Common.Areas.BackOffice.Components.PrivacySupport
@inject RealApiSession Real
<aside class="preview-context">기존 운영자 공유 UI · 실제 격리 HTTP/Mongo · 합성 사건 · 외부 통지·운영 계정 증거 아님</aside>
@if (_failure is not null) { <p role="alert">격리 운영자 연결 실패: @_failure</p> }
else if (!_ready) { <p role="status">격리 운영자를 연결하고 있습니다.</p> }
else { <보호지원관리Page CaseId="@CaseId" AdminOwnerProvider="@Owner" /> }
@code {
    [Parameter] public string? CaseId { get; set; }
    private string? Owner() => Real.AuthenticationOwnerId;
    private bool _ready;
    private string? _failure;
    protected override async Task OnParametersSetAsync()
    {
        _ready=false; _failure=null;
        try { await Real.EnsureInitializedAsync("operator"); _ready=true; }
        catch(Exception ex) { _failure=ex.GetType().Name; }
    }
}
