@inject NavigationManager NavigationManager
@inject RestaurantAuthService AuthService

@if (_canRender)
{
    <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
}
else if (!string.IsNullOrWhiteSpace(_connectionMessage))
{
    <LayoutView Layout="DefaultLayout">
        <MudAlert Severity="Severity.Warning">@_connectionMessage</MudAlert>
        <MudButton Variant="Variant.Outlined" Disabled="@_checking" OnClick="CheckAccessAsync">다시 확인</MudButton>
    </LayoutView>
}

@code {
    [Parameter, EditorRequired]
    public RouteData RouteData { get; set; } = default!;

    [Parameter]
    public Type? DefaultLayout { get; set; }

    private bool _canRender;
    private bool _checking;
    private string? _connectionMessage;

    protected override async Task OnParametersSetAsync()
        => await CheckAccessAsync();

    private async Task CheckAccessAsync()
    {
        if (_checking) return;
        _checking = true;
        _canRender = false;
        _connectionMessage = null;
        try
        {
            if (RouteData.PageType == typeof(Pages.Login) || RouteData.PageType == typeof(Pages.CommerceNoticesPage))
            {
                _canRender = true;
                return;
            }

            if (RouteData.PageType == typeof(Pages.OrderDetail)
                && RouteData.RouteValues.TryGetValue(nameof(Pages.OrderDetail.OrderNo), out var orderNo))
                AuthService.OrderReturn.TrackOrder(AuthService.Session.UserId, orderNo?.ToString());
            else
                AuthService.OrderReturn.Clear();

            var result = await AuthService.EnsureAccessTokenAsync();
            if (result.IsSuccess)
            {
                _canRender = true;
                return;
            }

            if (result.RequiresLogin)
            {
                var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                var loginHref = Ssalddel.Contracts.Common.Commerce.CommerceAuthenticationRoutes.TryReturnRoute("/" + relative, out var commerceReturn)
                    ? Ssalddel.Contracts.Common.Commerce.CommerceAuthenticationRoutes.LoginHref("/login", commerceReturn)
                    : "/login";
                NavigationManager.NavigateTo(loginHref, replace: true);
                return;
            }

            _connectionMessage = "연결 상태를 확인하지 못했습니다. 연결이 돌아오면 다시 확인해 주세요.";
        }
        finally
        {
            _checking = false;
        }
    }
}
