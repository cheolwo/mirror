@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Routing

<MudLayout>
    <MudAppBar Dense="true" Elevation="1" Color="Color.Primary">
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Disabled="@(!CanGoBack)" OnClick="GoBack" Class="back-nav-button">← 뒤로가기</MudButton>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">살뜰 식당</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">주문 수신 데스크</MudChip>
    </MudAppBar>

    <MudDrawer Open="@_drawerOpen" Variant="DrawerVariant.Temporary" Elevation="1" ClipMode="DrawerClipMode.Always" @onclick="CloseDrawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private readonly Stack<string> _navigationHistory = new();
    private string? _currentUri;
    private bool _isNavigatingBack;

    private bool CanGoBack => _navigationHistory.Count > 0;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        _currentUri = NavigationManager.Uri;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void CloseDrawer() => _drawerOpen = false;

    private void GoBack()
    {
        if (_navigationHistory.Count == 0)
        {
            return;
        }

        var previousUri = _navigationHistory.Pop();
        _isNavigatingBack = true;
        NavigationManager.NavigateTo(previousUri);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_isNavigatingBack)
        {
            _isNavigatingBack = false;
            _currentUri = args.Location;
            InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_currentUri) && !string.Equals(_currentUri, args.Location, StringComparison.OrdinalIgnoreCase))
        {
            _navigationHistory.Push(_currentUri);
        }

        _currentUri = args.Location;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
