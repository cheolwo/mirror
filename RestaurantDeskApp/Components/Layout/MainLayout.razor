@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject RestaurantAuthService AuthService
@inject I음식점주문SignalRClientService RestaurantRealtimeService
@using Microsoft.AspNetCore.Components.Routing

<MudLayout>
    <MudAppBar Dense="true" Elevation="0" Color="Color.Primary" Class="restaurant-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Inherit"
                       Disabled="@(!CanGoBack)"
                       aria-label="뒤로가기"
                       OnClick="GoBack"
                       Class="back-nav-button" />
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="탐색 메뉴" />
        <MudText Typo="Typo.h6" Class="ml-2 restaurant-appbar-title">살뜰 식당</MudText>
        <MudSpacer />
        <RoleAppLifecycleIndicator />
        @if (AuthService.Session.IsAuthenticated)
        {
            <MudText Typo="Typo.caption" Class="mr-2 restaurant-appbar-user">@AuthService.Session.UserName</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                           Color="Color.Inherit"
                           aria-label="로그아웃"
                           OnClick="LogoutAsync" />
        }
        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Class="restaurant-appbar-chip">주문 수신 데스크</MudChip>
    </MudAppBar>

    <MudDrawer Open="@_drawerOpen" Variant="DrawerVariant.Temporary" Elevation="0" ClipMode="DrawerClipMode.Always" @onclick="CloseDrawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MobileFieldTestBanner AppVersion="0.1.0" />
        <div class="pa-4 restaurant-main-content">
            @Body
        </div>
    </MudMainContent>
    @if (AuthService.Session.IsAuthenticated)
    {
        <음식점하단탐색 />
    }
</MudLayout>

@code {
    private bool _drawerOpen;
    private readonly Stack<string> _navigationHistory = new();
    private string? _currentUri;
    private bool _isNavigatingBack;

    private bool CanGoBack => _navigationHistory.Count > 0;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        _currentUri = NavigationManager.Uri;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void CloseDrawer() => _drawerOpen = false;

    private void GoBack()
    {
        if (_navigationHistory.Count == 0)
        {
            return;
        }

        var previousUri = _navigationHistory.Pop();
        _isNavigatingBack = true;
        NavigationManager.NavigateTo(previousUri);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_isNavigatingBack)
        {
            _isNavigatingBack = false;
            _currentUri = args.Location;
            InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_currentUri) && !string.Equals(_currentUri, args.Location, StringComparison.OrdinalIgnoreCase))
        {
            _navigationHistory.Push(_currentUri);
        }

        _currentUri = args.Location;
        InvokeAsync(StateHasChanged);
    }

    private async Task LogoutAsync()
    {
        try
        {
            await RestaurantRealtimeService.연결해제Async();
        }
        catch
        {
            // A hub shutdown failure must not retain the authenticated session.
        }
        finally
        {
            try { await AuthService.LogoutAsync(); }
            catch (RestaurantPendingStorageException)
            {
                // The login screen displays the cleanup failure after the private workspace closes.
            }
            finally { NavigationManager.NavigateTo("/login", replace: true); }
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
