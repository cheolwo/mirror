<section class="ingredient-supply-form" aria-labelledby="ingredient-supply-form-title">
    <div class="ingredient-supply-page__section-heading">
        <div>
            <MudText Typo="Typo.overline">수요 조건</MudText>
            <MudText Typo="Typo.h6" id="ingredient-supply-form-title">필요한 식재료</MudText>
        </div>
        <MudTooltip Text="현재 공급 경로 입력값 초기화">
            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt"
                           Color="Color.Default"
                           OnClick="ResetRequested" />
        </MudTooltip>
    </div>

    <MudForm @ref="form" @key="Draft.공급경로">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="7">
                <MudTextField T="string" Label="품목명" @bind-Value="Draft.품목명" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudSelect T="string" Label="품목 분류" @bind-Value="Draft.품목분류" Required="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("농산물")">농산물</MudSelectItem>
                    <MudSelectItem T="string" Value="@("수산물")">수산물</MudSelectItem>
                    <MudSelectItem T="string" Value="@("축산물")">축산물</MudSelectItem>
                    <MudSelectItem T="string" Value="@("가공 농산물")">가공 농산물</MudSelectItem>
                    <MudSelectItem T="string" Value="@("가공 수산물")">가공 수산물</MudSelectItem>
                    <MudSelectItem T="string" Value="@("기타 식재료")">기타 식재료</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="납품 규격" @bind-Value="Draft.규격" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="8" sm="5">
                <MudNumericField T="decimal" Label="필요 수량" @bind-Value="Draft.필요수량" Min="0.01m" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="4" sm="3">
                <MudTextField T="string" Label="단위" @bind-Value="Draft.수량단위" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="납품 주기" @bind-Value="Draft.납품주기" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value="@("1회")">1회</MudSelectItem>
                    <MudSelectItem T="string" Value="@("매주")">매주</MudSelectItem>
                    <MudSelectItem T="string" Value="@("격주")">격주</MudSelectItem>
                    <MudSelectItem T="string" Value="@("매월")">매월</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="희망 납품일" @bind-Date="Draft.희망납품일" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="음식점식재료보관방식" Label="보관 방식" @bind-Value="Draft.보관방식" Variant="Variant.Outlined">
                    @foreach (var storage in Enum.GetValues<음식점식재료보관방식>())
                    {
                        <MudSelectItem T="음식점식재료보관방식" Value="@storage">@storage</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" Label="현재 구매 단가" @bind-Value="Draft.현재구매단가" Min="0m" Adornment="Adornment.End" AdornmentText="원" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" Label="희망 도착 단가" @bind-Value="Draft.희망도착단가" Min="0m" Adornment="Adornment.End" AdornmentText="원" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="희망 원산지 또는 허용 범위" @bind-Value="Draft.희망원산지" Required="@(Draft.공급경로 == 음식점식재료공급경로.공동수입)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="납품 지역" @bind-Value="Draft.납품지역" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="사용 목적" @bind-Value="Draft.사용목적" Required="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string" Label="품질·포장·인계 조건" @bind-Value="Draft.추가조건" Lines="2" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>

        <div class="ingredient-supply-form__checks">
            <MudCheckBox T="bool" @bind-Value="Draft.공동수요집계동의" Label="다른 음식점 수요와 수량 집계 허용" Color="Color.Success" />
            <MudCheckBox T="bool" @bind-Value="Draft.산지Lot추적필수" Label="원산지·생산·입고 lot 추적 필요" Color="Color.Primary" />
            <MudCheckBox T="bool" @bind-Value="Draft.원산지대체허용" Label="동급 조건의 다른 원산지 제안 허용" Color="Color.Warning" />
        </div>

        <div class="ingredient-supply-form__actions">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PriceCheck"
                       OnClick="CompareAsync"
                       Disabled="@Busy">
                조건으로 비교
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync"
                       Disabled="@Busy">
                공급 요청 초안 저장
            </MudButton>
        </div>
    </MudForm>
</section>

@code {
    private MudForm? form;

    [Parameter, EditorRequired]
    public 음식점식재료공급요청Draft Draft { get; set; } = default!;

    [Parameter]
    public bool Busy { get; set; }

    [Parameter]
    public EventCallback CompareRequested { get; set; }

    [Parameter]
    public EventCallback SaveRequested { get; set; }

    [Parameter]
    public EventCallback ResetRequested { get; set; }

    private async Task CompareAsync()
    {
        await ValidateAsync();
        await CompareRequested.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        await ValidateAsync();
        await SaveRequested.InvokeAsync();
    }

    private async Task ValidateAsync()
    {
        if (form is not null)
        {
            await form.ValidateAsync();
        }
    }
}
