@page "/login"
@layout AuthLayout
@inject RestaurantAuthService AuthService
@inject NavigationManager Navigation
@inject RestaurantOrderNotificationCoordinator Notifications
@inject RestaurantMenuDraftStore MenuDrafts

<PageTitle>음식점 로그인</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="restaurant-login-shell">
    <MudStack Spacing="1" Class="restaurant-login-intro">
        <MudText Typo="Typo.overline">SSALDDEL RESTAURANT</MudText>
        <MudText Typo="Typo.h3">새 주문을 놓치지 않도록</MudText>
        <MudText Typo="Typo.body1">주문 확인부터 조리 준비까지 한곳에서 관리하세요.</MudText>
    </MudStack>
    <MudPaper Elevation="0" Class="restaurant-login-card">
        <MudStack Spacing="3">
            <div>
                <MudText Typo="Typo.h5">음식점 로그인</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    음식점 아이디와 비밀번호를 입력해 주세요.
                </MudText>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="Severity.Error">@message</MudAlert>
            }

            <MudTextField T="string"
                          @bind-Value="userName"
                          Label="아이디 또는 이메일"
                          Variant="Variant.Outlined"
                          Disabled="@isBusy" />
            <MudTextField T="string"
                          @bind-Value="password"
                          Label="비밀번호"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          Disabled="@isBusy" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@isBusy"
                       FullWidth="true"
                       Class="restaurant-login-button"
                       OnClick="LoginAsync">
                @(isBusy ? "로그인 확인 중" : "로그인")
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string userName = string.Empty;
    private string password = string.Empty;
    private string? message;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        message = AuthService.ConsumeSessionCleanupNotice();
        var result = await AuthService.EnsureAccessTokenAsync();
        if (result.IsSuccess)
        {
            await ReturnToOrdersAsync();
        }
    }

    private async Task LoginAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        message = null;
        try
        {
            var result = await AuthService.LoginAsync(userName, password);
            if (!result.IsSuccess)
            {
                message = result.ErrorMessage;
                return;
            }

            await ReturnToOrdersAsync();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ReturnToOrdersAsync()
    {
        await Notifications.SynchronizeAsync();
        var target = await Notifications.ResolvePendingNavigationAsync();
        var orderReturn = AuthService.OrderReturn.ConsumeReturnRoute(AuthService.Session.UserId);
        var menuReturn = AuthService.Session.UserId is { Length: > 0 } ownerId
            ? MenuDrafts.GetReturnRoute(ownerId) : null;
        var commerceReturn = Ssalddel.Contracts.Common.Commerce.CommerceAuthenticationRoutes.TryReturnRoute(ReturnUrl, out var returnRoute)
            ? returnRoute : null;
        Navigation.NavigateTo(commerceReturn ?? target ?? orderReturn ?? menuReturn ?? "/orders", replace: true);
    }
}
