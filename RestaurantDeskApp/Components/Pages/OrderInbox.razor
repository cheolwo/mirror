@using RestaurantDeskApp.Components.Pages
@page "/orders"
@page "/"
@implements IAsyncDisposable
@inject I음식점주문DeskService OrderDeskService
@inject I음식점주문SignalRClientService RestaurantRealtimeService
@inject IOptions<RestaurantDeskOptions> DeskOptions
@inject NavigationManager NavigationManager
@inject RestaurantOrderNotificationCoordinator Notifications

<PageTitle>주문 처리</PageTitle>

<section class="restaurant-pos" aria-label="음식점 주문 처리">
    <header class="pos-heading">
        <div>
            <span class="pos-eyebrow">@DeskOptions.Value.RestaurantName</span>
            <h1>주문 처리</h1>
        </div>
        <div class="pos-connection">
            <MudChip T="string" Color="@RealtimeStatusColor" Variant="Variant.Outlined" Size="Size.Small">@RealtimeStatusLabel</MudChip>
            <span>@(lastSuccessfulRefresh is null ? "확인 대기" : $"확인 {lastSuccessfulRefresh.Value.ToLocalTime():HH:mm:ss}")</span>
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Disabled="@(isRefreshing || workLocked)" OnClick="ReloadManuallyAsync" aria-label="주문 목록 새로고침" />
        </div>
    </header>
    @if (!string.IsNullOrWhiteSpace(message) && (messageSeverity == Severity.Warning || messageSeverity == Severity.Error))
    {
        <MudAlert Severity="@messageSeverity">@message</MudAlert>
    }
    <nav class="pos-queues" aria-label="현재 수신함 주문 분류">
        @foreach (var queue in new[] { RestaurantPosQueue.All, RestaurantPosQueue.New, RestaurantPosQueue.InProgress, RestaurantPosQueue.Attention })
        {
            var label = queue switch { RestaurantPosQueue.New => "신규", RestaurantPosQueue.InProgress => "진행", RestaurantPosQueue.Attention => "확인 필요", _ => "수신함" };
            var count = queue switch { RestaurantPosQueue.New => NewCount, RestaurantPosQueue.InProgress => ProgressCount, RestaurantPosQueue.Attention => AttentionCount, _ => orders.Count };
            <button type="button" class="pos-queue @(workspace.Queue == queue ? "is-active" : "")" aria-pressed="@(workspace.Queue == queue)" @onclick="() => SelectQueue(queue)">
                @label <strong>@(hasLoaded ? count.ToString() : "—")</strong>
            </button>
        }
    </nav>
    @if (reloadFailed && hasLoaded)
    {
        <p class="pos-list-notice">마지막 확인 목록 · 최신 상태 확인 필요</p>
    }
    <div class="pos-workspace">
        <section class="pos-inbox" aria-label="주문 목록">
            @if (isRefreshing && !hasLoaded)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="주문을 확인하고 있습니다" />
            }
            @if (!hasLoaded && reloadFailed)
            {
                <div class="pos-empty"><MudIcon Icon="@Icons.Material.Filled.CloudOff" /><h2>주문 확인 필요</h2>
                    <MudButton Variant="Variant.Outlined" Disabled="@(isRefreshing || workLocked)" OnClick="ReloadManuallyAsync">다시 확인</MudButton>
                </div>
            }
            else if ((orders.Count == 0 && hasLoaded && !reloadFailed) || (hasLoaded && !reloadFailed && workspace.VisibleOrders(orders).Count == 0))
            {
                <div class="pos-empty"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" /><h2>@(orders.Count == 0 ? "새 주문을 기다리고 있어요" : "해당 주문이 없습니다")</h2></div>
            }
            @foreach (var order in workspace.VisibleOrders(orders))
            {
                <article @key="order.주문번호" class="pos-order @(workspace.SelectedOrderNo == order.주문번호 ? "is-selected" : "")">
                    <button type="button" class="pos-order-select pos-desktop-select" disabled="@(workspace.CommandInProgress || workLocked)" aria-pressed="@(workspace.SelectedOrderNo == order.주문번호)" @onclick="() => SelectOrderAsync(order.주문번호)">
                        @OrderSummary(order)
                    </button>
                    <a class="pos-order-select pos-mobile-select" aria-label="주문 보기" href="@($"/orders/{Uri.EscapeDataString(order.주문번호)}")">@OrderSummary(order)</a>
                </article>
            }
        </section>
        <section class="pos-selected" aria-label="선택 주문 상세">
            @if (!workLocked && workspace.SelectedOrderNo is not null)
            {
                <OrderDetail OrderNo="@workspace.SelectedOrderNo" Embedded="true" BusyChanged="OnDetailBusyChanged" OrderUpdated="OnDetailUpdatedAsync" />
            }
            else
            {
                <div class="pos-empty"><MudIcon Icon="@Icons.Material.Filled.TouchApp" /><h2>주문을 선택하세요</h2><p>메뉴와 요청사항을 확인하고 처리합니다.</p></div>
            }
        </section>
    </div>
    <details class="pos-support">
        <summary>알림·배송 설정</summary>
        <div class="order-flow-secondary-row">
            <MudButton Href="/settings/agreed-rates" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ReceiptLong">합의 요금표</MudButton>
            <MudButton Href="/settings/preparation-times" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Timer">기본 조리시간</MudButton>
            @if (Notifications.SupportsSystemNotification)
            {
                <MudButton Href="/settings/notifications" Variant="Variant.Text">주문 알림 설정</MudButton>
                <MudButton Variant="Variant.Text" Disabled="@(isRefreshing || workLocked)" OnClick="EnableSystemNotificationsAsync">주문 알림 허용</MudButton>
            }
            <MudButton Variant="Variant.Text" OnClick="@(() => showFulfillmentSupport = !showFulfillmentSupport)">음식점 배송 지원 설정</MudButton>
        </div>
        @if (!string.IsNullOrWhiteSpace(notificationPermissionMessage)) { <p role="status">@notificationPermissionMessage</p> }
        @if (showFulfillmentSupport) { <Ssalddel.Ui.Common.Areas.App.Components.Food.FoodMerchantFulfillmentSettingsPanel /> }
    </details>
</section>

@code {
    private RenderFragment OrderSummary(음식점주문DeskItem item) => @<text>
        <span class="pos-order-meta"><strong>@RestaurantPosPresentation.StatusLabel(item)</strong><time>@item.접수시각.ToLocalTime().ToString("HH:mm")</time></span>
        <span class="pos-order-menu">@item.메뉴요약</span>
        <span class="pos-order-total"><span>주문 @item.주문번호</span><strong>@item.주문금액.ToString("N0")원</strong></span>
        <span class="pos-order-preparation">조리 예상 @(item.선택조리예상분 ?? item.추천조리예상분)분</span>
        @if (RestaurantPosPresentation.NeedsAttention(item)) { <span class="pos-attention">확인 필요</span> }
    </text>;
}

@code {
    private bool showFulfillmentSupport;
    private readonly RestaurantPosPresentation workspace = new();
    private Task SelectOrderAsync(string orderNo)
    {
        if (!workLocked) workspace.Select(orderNo);
        return Task.CompletedTask;
    }
    private void OnDetailBusyChanged(bool busy) => workspace.SetCommandInProgress(busy);
    private async Task OnDetailUpdatedAsync() => await TryReloadAsync(음식점주문복구출처.서버재조회);
    private void SelectQueue(RestaurantPosQueue queue) => workspace.Queue = queue;
    private int NewCount => orders.Count(RestaurantPosPresentation.IsNew);
    private int ProgressCount => orders.Count(RestaurantPosPresentation.IsInProgress);
    private int AttentionCount => orders.Count(RestaurantPosPresentation.NeedsAttention);

    private readonly CancellationTokenSource refreshCancellation = new();
    private Task? refreshTask;
    private Task<bool>? currentReloadTask;
    private bool disposed;
    private IReadOnlyList<음식점주문DeskItem> orders = [];
    private string realtimeStatus = "실시간 연결 대기";
    private string? message;
    private string? notificationPermissionMessage;
    private Severity messageSeverity = Severity.Info;
    private bool workLocked;
    private bool isRefreshing;
    private bool hasLoaded;
    private bool reloadFailed;
    private DateTimeOffset? lastSuccessfulRefresh;

    private async Task ReloadManuallyAsync()
        => await TryReloadAsync(음식점주문복구출처.서버재조회);

    private async Task EnableSystemNotificationsAsync()
    {
        try
        {
            var allowed = await Notifications.RequestPermissionAsync(refreshCancellation.Token);
            if (disposed) return;
            messageSeverity = allowed ? Severity.Success : Severity.Warning;
            message = allowed ? "주문 알림을 허용했습니다." : "기기 알림이 꺼져 있습니다. 기기 설정에서 주문 알림을 허용해 주세요.";
            notificationPermissionMessage = message;
        }
        catch (Exception) when (disposed || refreshCancellation.IsCancellationRequested) { }
        catch
        {
            if (disposed) return;
            messageSeverity = Severity.Warning;
            message = "기기 알림 설정을 확인하지 못했습니다. 다시 시도해 주세요.";
        }
    }

    private Color RealtimeStatusColor => RestaurantRealtimeService.연결상태 switch
    {
        음식점실시간연결상태.연결됨 => Color.Success,
        음식점실시간연결상태.재연결중 => Color.Warning,
        음식점실시간연결상태.인증필요 => Color.Error,
        _ => Color.Default
    };

    protected override async Task OnInitializedAsync()
    {
        RestaurantRealtimeService.주문수신 += HandleRealtimeOrderReceivedAsync;
        RestaurantRealtimeService.주문상태변경 += HandleOrderStatusChangedAsync;
        RestaurantRealtimeService.상태변경 += HandleRealtimeStatusChangedAsync;
        RestaurantRealtimeService.재연결후재조회요청 += HandleReconnectedRefreshAsync;
        Notifications.CanonicalRefreshRequested += HandleReconnectedRefreshAsync;
        await TryReloadAsync(음식점주문복구출처.서버재조회);
        if (disposed) return;

        if (!workLocked)
        {
            try
            {
                await RestaurantRealtimeService.연결Async(refreshCancellation.Token);
                refreshCancellation.Token.ThrowIfCancellationRequested();
                realtimeStatus = $"실시간 연결됨 · {DeskOptions.Value.RestaurantName}";
            }
            catch (Exception) when (refreshCancellation.IsCancellationRequested)
            {
                return;
            }
            catch (UnauthorizedAccessException ex)
            {
                workLocked = true;
                realtimeStatus = "로그인 복구 필요";
                messageSeverity = Severity.Error;
                message = ex.Message;
                NavigationManager.NavigateTo("/login", replace: true);
            }
            catch (Exception)
            {
                realtimeStatus = "실시간 연결 실패 · 30초 서버 조회 유지";
                messageSeverity = Severity.Warning;
                message = "주문 알림 연결을 확인하지 못했습니다. 30초마다 주문을 다시 확인합니다.";
            }
        }

        if (!disposed) refreshTask = RunPeriodicRefreshAsync(refreshCancellation.Token);
    }

    private async Task HandleRealtimeOrderReceivedAsync(음식점주문수신알림 notification)
    {
        await InvokeAsync(async () =>
        {
            if (disposed) return;
            // 알림음/OS 알림은 페이지 밖 singleton이 인증된 정본과 대조한다.
            messageSeverity = Severity.Success;
            message = $"{notification.주문번호} 주문을 수신했습니다.";
            await TryReloadAsync(음식점주문복구출처.서버재조회);
            if (!disposed) StateHasChanged();
        });
    }

    private async Task HandleRealtimeStatusChangedAsync(음식점실시간연결상태변경 change)
    {
        await InvokeAsync(() =>
        {
            if (disposed) return;
            realtimeStatus = change.안내;
            if (change.상태 == 음식점실시간연결상태.인증필요)
            {
                workLocked = true;
                workspace.Clear();
                messageSeverity = Severity.Error;
                message = change.안내;
                NavigationManager.NavigateTo("/login", replace: true);
            }
            StateHasChanged();
        });
    }

    private async Task HandleReconnectedRefreshAsync()
    {
        await InvokeAsync(async () =>
        {
            if (disposed) return;
            var recovered = await TryReloadAsync(음식점주문복구출처.재연결재조회);
            if (recovered)
            {
                messageSeverity = Severity.Success;
                message = "실시간 재연결 직후 서버 수신함을 다시 확인했습니다.";
            }
            if (!disposed) StateHasChanged();
        });
    }

    private async Task HandleOrderStatusChangedAsync(음식점주문상태변경알림 notification)
    {
        await InvokeAsync(async () =>
        {
            if (disposed) return;
            if (await TryReloadAsync(음식점주문복구출처.서버재조회))
            {
                messageSeverity = Severity.Info;
                message = $"{notification.주문번호} · {notification.주문상태} / {notification.배차상태} ({notification.변경사유})";
            }
            if (!disposed) StateHasChanged();
        });
    }

    private async Task RunPeriodicRefreshAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (!workLocked && !disposed)
                    {
                        await TryReloadAsync(음식점주문복구출처.서버재조회);
                    }
                    if (!disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private Task<bool> TryReloadAsync(음식점주문복구출처 복구출처)
    {
        if (isRefreshing || workLocked || disposed) return Task.FromResult(false);
        return currentReloadTask = ReloadInboxAsync(복구출처);
    }

    private async Task<bool> ReloadInboxAsync(음식점주문복구출처 복구출처)
    {
        isRefreshing = true;
        var cancellationToken = refreshCancellation.Token;
        try
        {
            var loaded = await OrderDeskService.주문목록조회Async(복구출처, cancellationToken);
            cancellationToken.ThrowIfCancellationRequested();
            orders = loaded;
            hasLoaded = true;
            lastSuccessfulRefresh = DateTimeOffset.UtcNow;
            if (reloadFailed) message = null;
            reloadFailed = false;
            return true;
        }
        catch (Exception) when (cancellationToken.IsCancellationRequested)
        {
            return false;
        }
        catch (UnauthorizedAccessException ex)
        {
            reloadFailed = true;
            workLocked = true;
            orders = [];
            workspace.Clear();
            messageSeverity = Severity.Error;
            message = ex.Message;
            NavigationManager.NavigateTo("/login", replace: true);
            return false;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            reloadFailed = true;
            workLocked = true;
            orders = [];
            workspace.Clear();
            messageSeverity = Severity.Error;
            message = "로그인 세션을 복구하지 못했습니다. 다시 로그인해 주세요.";
            NavigationManager.NavigateTo("/login", replace: true);
            return false;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            reloadFailed = true;
            workLocked = true;
            orders = [];
            workspace.Clear();
            messageSeverity = Severity.Error;
            message = "이 계정은 현재 음식점 주문을 볼 수 없습니다. 음식점 운영 권한을 확인해 주세요.";
            return false;
        }
        catch (SsalddelApiException ex) when (ex.StatusCode == 401)
        {
            reloadFailed = true;
            workLocked = true;
            orders = [];
            workspace.Clear();
            messageSeverity = Severity.Error;
            message = "로그인이 만료되었습니다. 다시 로그인해 주세요.";
            NavigationManager.NavigateTo("/login", replace: true);
            return false;
        }
        catch (SsalddelApiException ex) when (ex.StatusCode == 403)
        {
            reloadFailed = true;
            workLocked = true;
            orders = [];
            workspace.Clear();
            messageSeverity = Severity.Error;
            message = "이 계정은 현재 음식점 주문을 볼 수 없습니다. 음식점 운영 권한을 확인해 주세요.";
            return false;
        }
        catch (Exception)
        {
            reloadFailed = true;
            messageSeverity = Severity.Warning;
            message = "주문 목록을 갱신하지 못했습니다. 이전 목록을 표시하며 다음 30초 조회에서 다시 시도합니다. 새로고침으로도 다시 시도할 수 있습니다.";
            return false;
        }
        finally
        {
            if (!disposed) isRefreshing = false;
        }
    }

    private string RealtimeStatusLabel => RestaurantRealtimeService.연결상태 switch
    {
        음식점실시간연결상태.연결됨 => "주문 알림 켜짐",
        음식점실시간연결상태.재연결중 => "다시 연결 중",
        음식점실시간연결상태.인증필요 => "로그인 필요",
        _ => "알림 연결 확인"
    };

    private static string OrderStatusLabel(string status) => status switch
    {
        음식점주문Desk상태코드.주문대기 => "주문 확인 필요",
        "주문확인" => "기사 배정 대기",
        음식점주문Desk상태코드.수락처리중 => "주문 확인 중",
        음식점주문Desk상태코드.기사배정 => "기사 배정 완료",
        음식점주문Desk상태코드.조리중 => "조리 중",
        음식점주문Desk상태코드.픽업대기 => "픽업 대기",
        음식점주문Desk상태코드.픽업완료 => "배달 중",
        음식점주문Desk상태코드.전달완료 => "수령 확인 대기",
        음식점주문Desk상태코드.수령확인 => "주문 완료",
        음식점주문Desk상태코드.거절 => "주문 거절",
        음식점주문Desk상태코드.취소 => "주문 취소",
        _ => status
    };

    private static string RecoveryLabel(음식점주문복구출처 source) => source switch
    {
        음식점주문복구출처.실시간 => "실시간 수신",
        음식점주문복구출처.재연결재조회 => "재연결 복구",
        _ => "서버 복구"
    };

    private static Color StatusColor(string status) => status switch
    {
        음식점주문Desk상태코드.주문대기 => Color.Error,
        음식점주문Desk상태코드.수락처리중 => Color.Info,
        음식점주문Desk상태코드.조리중 => Color.Primary,
        음식점주문Desk상태코드.픽업대기 => Color.Success,
        음식점주문Desk상태코드.거절 or 음식점주문Desk상태코드.취소 => Color.Error,
        음식점주문Desk상태코드.기사배정 or 음식점주문Desk상태코드.픽업완료 => Color.Info,
        음식점주문Desk상태코드.전달완료 or 음식점주문Desk상태코드.수령확인 => Color.Success,
        음식점주문Desk상태코드.전표출력됨 => Color.Success,
        음식점주문Desk상태코드.상세조회실패 => Color.Warning,
        _ => Color.Default
    };

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        refreshCancellation.Cancel();
        RestaurantRealtimeService.주문수신 -= HandleRealtimeOrderReceivedAsync;
        RestaurantRealtimeService.주문상태변경 -= HandleOrderStatusChangedAsync;
        RestaurantRealtimeService.상태변경 -= HandleRealtimeStatusChangedAsync;
        RestaurantRealtimeService.재연결후재조회요청 -= HandleReconnectedRefreshAsync;
        Notifications.CanonicalRefreshRequested -= HandleReconnectedRefreshAsync;
        if (refreshTask is not null)
        {
            await refreshTask;
        }
        if (currentReloadTask is not null)
        {
            await currentReloadTask;
        }

        refreshCancellation.Dispose();
    }
}
