@page "/orders/{OrderNo}"
@inject I음식점주문DeskService OrderDeskService
@inject ISsalddelDocumentOutputService DocumentOutputService
@inject IJSRuntime JS

<PageTitle>음식점 주문 상세</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">음식점 주문 상세</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">정확한 주문번호 한 건을 서버에서 다시 읽고 수락·조리·픽업 준비를 기록합니다.</MudText>
            </MudStack>
            <MudButton Href="/orders" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">
                수신함
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@isBusy"
                       OnClick="RefreshAsync">
                서버 상태 새로고침
            </MudButton>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        @if (order is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                현재 실행 세션에서 수신한 주문을 찾을 수 없습니다. 수신함으로 돌아가 서버 알림을 다시 확인해 주세요.
            </MudAlert>
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">@order.주문번호</MudText>
                        <MudChip T="string" Color="@StatusColor(order.상태)">@order.상태</MudChip>
                    </MudStack>
                    <MudDivider />
                    <MudText Typo="Typo.body1">@order.고객명</MudText>
                    <MudText Typo="Typo.body2">@order.메뉴요약</MudText>
                    @if (order.상품별조리기준.Count > 0)
                    {
                        <MudDivider />
                        @foreach (var item in order.상품별조리기준)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2">@item.상품명 × @item.수량</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                                    기본 @(item.기본조리분)분@(item.음식점기본값사용 ? " · 음식점 기본" : "")
                                </MudChip>
                            </MudStack>
                        }
                    }
                    <MudText Typo="Typo.subtitle1">@order.주문금액.ToString("N0")원</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @order.접수시각.ToLocalTime().ToString("yyyy-MM-dd HH:mm") 수신
                    </MudText>
                    @if (!string.IsNullOrWhiteSpace(order.최근메시지))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@order.최근메시지</MudText>
                    }
                </MudStack>
            </MudPaper>

            @if (order.배차상태 != 음식주문배차상태코드.미요청)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <div>
                                <MudText Typo="Typo.h6">배달 인계</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    주문 수락 응답에 따라 배달 기사 업무로 인계된 상태입니다.
                                </MudText>
                            </div>
                            <MudChip T="string"
                                     Color="@DispatchStatusColor(order.배차상태)"
                                     Variant="Variant.Filled">
                                @DispatchStatusLabel(order.배차상태)
                            </MudChip>
                        </MudStack>

                        <MudGrid Spacing="2">
                            <MudItem xs="6" md="3">
                                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Color="Color.Success" />
                                    <MudText Typo="Typo.caption" Align="Align.Center">배차 요청 접수</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.DeliveryDining"
                                             Color="@(order.배차상태 == 음식주문배차상태코드.기사배정 ? Color.Success : Color.Warning)" />
                                    <MudText Typo="Typo.caption" Align="Align.Center">기사 제안·수락</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Restaurant" Color="Color.Default" />
                                    <MudText Typo="Typo.caption" Align="Align.Center">음식점 픽업</MudText>
                                </MudStack>
                            </MudItem>
                            <MudItem xs="6" md="3">
                                <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                    <MudIcon Icon="@Icons.Material.Filled.Home" Color="Color.Default" />
                                    <MudText Typo="Typo.caption" Align="Align.Center">고객 전달</MudText>
                                </MudStack>
                            </MudItem>
                        </MudGrid>

                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            배차 요청 시각 · @FormatOptionalDate(order.배차요청시각Utc)
                        </MudText>
                        <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                            이 표시는 주문 수락 응답 기준입니다. 기사 수락·픽업·전달 완료는 기사 앱에서 서버 상태를 변경합니다.
                        </MudAlert>
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                <MudStack Spacing="2">
                    @if (order.수락가능)
                    {
                        <MudText Typo="Typo.h6">주문 수락 또는 거절</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            수락하면 서버 원장을 조리 중으로 변경하고 배차 준비 이벤트를 만듭니다.
                            거절은 사유와 함께 종료 상태로 기록되며 배차를 만들지 않습니다.
                        </MudText>
                        @PreparationControls()
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Print"
                                   Disabled="@isBusy"
                                   OnClick="AcceptAndPrintAsync">
                            @(isBusy ? "수락 처리 중" : $"조리 {preparationMinutes}분으로 수락·조리 시작")
                        </MudButton>
                        @if (order.거절가능)
                        {
                            <MudDivider />
                            <MudTextField @bind-Value="rejectionReason"
                                          Label="거절 사유"
                                          HelperText="품절, 영업 종료 등 주문자에게 설명할 수 있는 구체적인 사유를 입력합니다."
                                          Lines="2"
                                          Variant="Variant.Outlined" />
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Block"
                                       Disabled="@(isBusy || string.IsNullOrWhiteSpace(rejectionReason))"
                                       OnClick="RejectAsync">
                                주문 거절
                            </MudButton>
                        }
                    }
                    else if (order.조리변경가능 || order.픽업준비가능)
                    {
                        <MudText Typo="Typo.h6">조리 진행</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            조리 예상 시간을 바꾸거나 실제 조리가 끝난 시점에 픽업 준비 완료를 기록합니다.
                            두 작업 모두 서버 상태 이력에 처리자와 요청 ID를 남깁니다.
                        </MudText>
                        @PreparationControls()
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @if (order.조리변경가능)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Info"
                                           Disabled="@isBusy"
                                           OnClick="UpdateCookingTimeAsync">
                                    조리 예상시간 변경
                                </MudButton>
                            }
                            @if (order.픽업준비가능)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.TakeoutDining"
                                           Disabled="@isBusy"
                                           OnClick="MarkPickupReadyAsync">
                                    픽업 준비 완료
                                </MudButton>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.h6">현재 이행 상태</MudText>
                        <MudAlert Severity="@StatusAlertSeverity(order.상태)" Variant="Variant.Outlined">
                            서버 주문 상태는 <strong>@order.상태</strong>입니다.
                            현재 상태에서 음식점이 직접 수행할 추가 작업은 없습니다.
                        </MudAlert>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string OrderNo { get; set; } = string.Empty;

    private 음식점주문DeskItem? order;
    private static readonly int[] QuickPreparationMinutes = [10, 15, 20, 30, 45];
    private string? loadedOrderNo;
    private int preparationMinutes = 20;
    private string rejectionReason = string.Empty;
    private bool isBusy;
    private string? message;
    private Severity messageSeverity = Severity.Info;

    protected override async Task OnParametersSetAsync()
    {
        order = await OrderDeskService.주문조회Async(OrderNo);
        if (order is not null && !string.Equals(loadedOrderNo, order.주문번호, StringComparison.Ordinal))
        {
            preparationMinutes = order.선택조리예상분
                ?? (order.추천조리예상분 > 0 ? order.추천조리예상분 : 20);
            loadedOrderNo = order.주문번호;
        }
    }

    private void SetPreparationMinutes(int minutes)
        => preparationMinutes = 음식점조리시간정책.Clamp(minutes);

    private RenderFragment PreparationControls() => @<MudStack Spacing="2">
        <MudNumericField T="int"
                         @bind-Value="preparationMinutes"
                         Label="이 주문의 조리 대기시간"
                         HelperText="@($"추천 {order?.추천조리예상분 ?? 20}분 · 1~180분 사이에서 변경할 수 있습니다.")"
                         Min="1"
                         Max="180"
                         Step="1"
                         Variant="Variant.Outlined"
                         Adornment="Adornment.End"
                         AdornmentText="분" />
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            @foreach (var minutes in QuickPreparationMinutes)
            {
                <MudButton Variant="@(preparationMinutes == minutes ? Variant.Filled : Variant.Outlined)"
                           Color="Color.Info"
                           Size="Size.Small"
                           OnClick="@(() => SetPreparationMinutes(minutes))">
                    @(minutes)분
                </MudButton>
            }
        </MudStack>
    </MudStack>;

    private async Task RefreshAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        try
        {
            order = await OrderDeskService.주문조회Async(OrderNo);
            messageSeverity = order is null ? Severity.Warning : Severity.Info;
            message = order is null
                ? "서버에서 이 주문을 찾지 못했습니다."
                : $"서버 상태를 다시 확인했습니다. 현재 {order.상태}, 배차 {DispatchStatusLabel(order.배차상태)}입니다.";
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = $"서버 상태를 갱신하지 못했습니다. {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task AcceptAndPrintAsync()
    {
        if (order is null || isBusy)
        {
            return;
        }

        isBusy = true;
        message = null;
        try
        {
            preparationMinutes = 음식점조리시간정책.Clamp(preparationMinutes);
            var result = await OrderDeskService.주문수락후전표준비Async(
                order.주문번호,
                preparationMinutes);
            if (!result.성공 || result.전표Draft is null)
            {
                messageSeverity = Severity.Error;
                message = result.메시지;
                return;
            }

            var output = DocumentOutputService.CreateOutboundExpectedItems(result.전표Draft);
            await JS.InvokeVoidAsync("ssalddelDocumentOutput.printHtml", output.Title, output.Html);
            await OrderDeskService.전표출력완료Async(order.주문번호);
            order = await OrderDeskService.주문조회Async(order.주문번호);
            messageSeverity = Severity.Success;
            message = $"{OrderNo} 주문을 수락하고 전표 출력 요청을 보냈습니다.";
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = $"주문 수락을 완료하지 못했습니다. {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RejectAsync()
    {
        if (order is null || isBusy || string.IsNullOrWhiteSpace(rejectionReason))
        {
            return;
        }

        await RunProgressAsync(
            () => OrderDeskService.주문거절Async(order.주문번호, rejectionReason),
            "주문을 거절하고 사유를 서버 원장에 기록했습니다.");
    }

    private async Task UpdateCookingTimeAsync()
    {
        if (order is null || isBusy)
        {
            return;
        }

        preparationMinutes = 음식점조리시간정책.Clamp(preparationMinutes);
        await RunProgressAsync(
            () => OrderDeskService.조리시간변경Async(order.주문번호, preparationMinutes),
            $"조리 예상 시간을 {preparationMinutes}분으로 변경했습니다.");
    }

    private async Task MarkPickupReadyAsync()
    {
        if (order is null || isBusy)
        {
            return;
        }

        await RunProgressAsync(
            () => OrderDeskService.픽업준비완료Async(order.주문번호),
            "픽업 준비 완료를 서버 원장에 기록했습니다.");
    }

    private async Task RunProgressAsync(
        Func<Task<음식점주문DeskItem?>> action,
        string successMessage)
    {
        isBusy = true;
        message = null;
        try
        {
            var updated = await action();
            if (updated is null)
            {
                messageSeverity = Severity.Warning;
                message = "서버에서 이 주문을 찾지 못했습니다.";
                return;
            }

            order = updated;
            messageSeverity = Severity.Success;
            message = successMessage;
        }
        catch (Exception ex)
        {
            messageSeverity = Severity.Error;
            message = $"주문 진행 상태를 변경하지 못했습니다. {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private static Color StatusColor(string status) => status switch
    {
        음식점주문Desk상태코드.주문대기 => Color.Error,
        음식점주문Desk상태코드.수락처리중 => Color.Info,
        음식점주문Desk상태코드.조리중 => Color.Primary,
        음식점주문Desk상태코드.픽업대기 => Color.Success,
        음식점주문Desk상태코드.거절 or 음식점주문Desk상태코드.취소 => Color.Error,
        음식점주문Desk상태코드.기사배정 or 음식점주문Desk상태코드.픽업완료 => Color.Info,
        음식점주문Desk상태코드.전달완료 or 음식점주문Desk상태코드.수령확인 => Color.Success,
        음식점주문Desk상태코드.전표출력됨 => Color.Success,
        음식점주문Desk상태코드.상세조회실패 => Color.Warning,
        _ => Color.Default
    };

    private static Severity StatusAlertSeverity(string status) => status switch
    {
        음식점주문Desk상태코드.거절 or 음식점주문Desk상태코드.취소 => Severity.Error,
        음식점주문Desk상태코드.전달완료 or 음식점주문Desk상태코드.수령확인 => Severity.Success,
        _ => Severity.Info
    };

    private static string DispatchStatusLabel(string? status) => status switch
    {
        음식주문배차상태코드.배차대기 => "기사 제안 대기",
        음식주문배차상태코드.추천중 => "기사 추천 중",
        음식주문배차상태코드.기사배정 => "기사 배정 완료",
        음식주문배차상태코드.배달중 => "배달 중",
        음식주문배차상태코드.배달완료 => "배달 완료",
        음식주문배차상태코드.배차불가 => "배차 확인 필요",
        _ => "배차 전"
    };

    private static Color DispatchStatusColor(string? status) => status switch
    {
        음식주문배차상태코드.배달완료 => Color.Success,
        음식주문배차상태코드.기사배정 or 음식주문배차상태코드.배달중 => Color.Primary,
        음식주문배차상태코드.배차불가 => Color.Error,
        _ => Color.Warning
    };

    private static string FormatOptionalDate(DateTime? value)
        => value.HasValue
            ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).ToLocalTime().ToString("yyyy-MM-dd HH:mm")
            : "확인 중";
}
