@page "/orders/{OrderNo}"
@implements IDisposable

<PageTitle>주문 상세</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4 restaurant-order-flow">
    <MudStack Spacing="3">
        <div class="order-flow-heading">
            <MudText Typo="Typo.h4">주문 상세</MudText>
            <MudButton Href="/orders" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">주문 목록</MudButton>
        </div>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity" Class="order-flow-message">@message</MudAlert>
        }
        @if (isLoading && order is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="주문을 불러오고 있습니다" />
        }
        else if (order is null)
        {
            @if (!readFailed)
            {
                <MudAlert Severity="Severity.Warning">주문을 찾을 수 없습니다. 주문 목록에서 다시 확인해 주세요.</MudAlert>
            }
            <MudButton Variant="Variant.Outlined" Disabled="@(isBusy || isLoading || isRefreshing)" OnClick="RefreshAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 order-current-step">
                <MudStack Spacing="2">
                    <div class="order-flow-summary-row">
                        <MudText Typo="Typo.h5" Class="order-step-title">@CurrentStepLabel</MudText>
                        <MudChip T="string" Color="@StatusColor(order.상태)" Size="Size.Small">@OrderStatusLabel(order.상태)</MudChip>
                    </div>
                    <MudText Typo="Typo.body1" Class="order-page-guide">@NextStepGuide</MudText>
                    @if (order.수락가능 || order.조리시작가능)
                    {
                        @PreparationControls()
                    }
                    @if (order.수락가능)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="order-primary-action"
                                   Disabled="@WorkDisabled" OnClick="AcceptAndPrintAsync" StartIcon="@Icons.Material.Filled.Check">
                            @(isBusy ? "주문 확인 중" : "주문 확인")
                        </MudButton>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">조리 예상 @(preparationMinutes)분 · 확인 후 기사 배차를 요청합니다.</MudText>
                    }
                    else if (order.조리시작가능)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="order-primary-action"
                                   Disabled="@WorkDisabled" OnClick="StartCookingAsync">@(isBusy ? "처리 중" : "조리 시작")</MudButton>
                    }
                    else if (order.픽업준비가능)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="order-primary-action"
                                   Disabled="@WorkDisabled" OnClick="MarkPickupReadyAsync" StartIcon="@Icons.Material.Filled.TakeoutDining">
                            @(isBusy ? "처리 중" : "픽업 준비 완료")
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4 order-menu-panel">
                <MudStack Spacing="2">
                    <div class="order-flow-summary-row">
                        <MudText Typo="Typo.h6">주문 메뉴</MudText>
                        <MudText Typo="Typo.h6" Class="order-amount">@order.주문금액.ToString("N0")원</MudText>
                    </div>
                    @if (order.상품별조리기준.Count > 0)
                    {
                        @foreach (var item in order.상품별조리기준)
                        {
                            <div class="order-menu-line">
                                <MudText Typo="Typo.body1">@item.상품명</MudText>
                                <MudText Typo="Typo.body1" Class="order-menu-quantity">@(item.수량)개</MudText>
                            </div>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body1">@order.메뉴요약</MudText>
                    }
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@order.고객명 · @order.접수시각.ToLocalTime().ToString("HH:mm") 접수</MudText>
                </MudStack>
            </MudPaper>

            @if (order.조리변경가능)
            {
                <details class="order-flow-details">
                    <summary>조리 예상시간 변경</summary>
                    <div class="order-details-content">
                        @PreparationControls()
                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Disabled="@WorkDisabled" OnClick="UpdateCookingTimeAsync">시간 변경 적용</MudButton>
                    </div>
                </details>
            }
            @if (order.수락가능 && order.거절가능)
            {
                <details class="order-flow-details">
                    <summary>주문 거절</summary>
                    <div class="order-details-content">
                        <MudTextField @bind-Value="rejectionReason" Label="거절 사유" HelperText="품절, 영업 종료 등 사유를 적어 주세요."
                                      Lines="2" Variant="Variant.Outlined" Immediate="true" Disabled="@WorkDisabled" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@(WorkDisabled || string.IsNullOrWhiteSpace(rejectionReason))"
                                   OnClick="RejectAsync" StartIcon="@Icons.Material.Filled.Block">주문 거절</MudButton>
                    </div>
                </details>
            }

            <div class="order-flow-secondary-row">
                @if (CanPrintReceipt)
                {
                    <MudButton Variant="Variant.Outlined" Disabled="@WorkDisabled" OnClick="PrintReceiptAsync" StartIcon="@Icons.Material.Filled.Print">전표 출력</MudButton>
                }
                <MudButton Variant="Variant.Outlined" Disabled="@(isBusy || isLoading || isRefreshing)" OnClick="RefreshAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@(lastSuccessfulRefresh is null ? "확인 대기" : $"마지막 확인 {lastSuccessfulRefresh.Value.ToLocalTime():HH:mm:ss}")</MudText>
            </div>
            <details class="order-flow-details">
                <summary>상세 정보</summary>
                <div class="order-details-content">
                    <MudText Typo="Typo.body2">주문번호 · @order.주문번호</MudText>
                    <MudText Typo="Typo.body2">접수 · @order.접수시각.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                    @if (order.배차상태 != 음식주문배차상태코드.미요청)
                    {
                        <MudText Typo="Typo.body2">배차 · @DispatchStatusLabel(order.배차상태)</MudText>
                        <MudText Typo="Typo.body2">배차 요청 · @FormatOptionalDate(order.배차요청시각Utc)</MudText>
                    }
                    @foreach (var item in order.상품별조리기준)
                    {
                        <MudText Typo="Typo.body2">@item.상품명 · 기본 @(item.기본조리분)분@(item.음식점기본값사용 ? " · 음식점 기본" : "")</MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(order.최근메시지))
                    {
                        <MudText Typo="Typo.body2">@order.최근메시지</MudText>
                    }
                </div>
            </details>
        }
    </MudStack>
</MudContainer>

@code {
    private RenderFragment PreparationControls() => @<MudStack Spacing="2">
        <MudNumericField T="int"
                         @bind-Value="preparationMinutes"
                         Immediate="true"
                         Label="조리 예상시간"
                         HelperText="@($"추천 {order?.추천조리예상분 ?? 20}분 · 1~180분 사이에서 변경할 수 있습니다.")"
                         Min="1"
                         Max="180"
                         Step="1"
                         Disabled="@WorkDisabled"
                         Variant="Variant.Outlined"
                         Adornment="Adornment.End"
                         AdornmentText="분" />
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
            @foreach (var minutes in QuickPreparationMinutes)
            {
                <MudButton Variant="Variant.Outlined"
                           Class="@(preparationMinutes == minutes ? "order-time-selected" : string.Empty)"
                           Disabled="@WorkDisabled"
                           Color="Color.Info"
                           Size="Size.Small"
                           OnClick="@(() => SetPreparationMinutes(minutes))">
                    @(minutes)분
                </MudButton>
            }
        </MudStack>
    </MudStack>;
}
