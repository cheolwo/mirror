# 이 파일을 .env로 복사한 뒤 실제 값으로 바꿉니다. .env는 Git과 Docker 이미지에서 제외됩니다.
HONGDAL_ASPNETCORE_ENVIRONMENT=Production

HONGDAL_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
HONGDAL_MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
HONGDAL_MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
HONGDAL_DB_CONNECTION_STRING=server=mysql;port=3306;database=hongdal_dev;user=hongdal;password=CHANGE_ME_APP_PASSWORD;
# 권장 단일 VM 구성은 Redis입니다. Redis 없이 확인할 때만 Memory로 바꿉니다.
HONGDAL_TRANSIENT_STATE_PROVIDER=Redis
HONGDAL_REDIS_CONNECTION_STRING=redis:6379
HONGDAL_MONGO_CONNECTION_STRING=mongodb://hongdal:CHANGE_ME_MONGO_PASSWORD@mongo:27017/?authSource=admin

HONGDAL_JWT_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
HONGDAL_ISMSP_AES256_GCM_KEY_BASE64=CHANGE_ME_WITH_A_32_BYTE_BASE64_KEY
HONGDAL_ISMSP_HASH_SALT=CHANGE_ME_WITH_A_RANDOM_HASH_SALT
HONGDAL_ISMSP_TRANSPORT_KEY_ID=hongdal-local-transport-v1
HONGDAL_ISMSP_FAIL_WHEN_KEY_MISSING=true
# PEM은 배포 플랫폼의 비밀 저장소에서 실제 줄바꿈을 보존해 주입하는 것을 권장합니다.
HONGDAL_ISMSP_TRANSPORT_PUBLIC_KEY_PEM=
HONGDAL_ISMSP_TRANSPORT_PRIVATE_KEY_PEM=

HONGDAL_AGRICULTURAL_FISHERIES_BATCH_ENABLED=true
HONGDAL_KAMIS_DAILY_BATCH_ENABLED=true
HONGDAL_KAMIS_DAILY_CRON_EXPRESSION="0 30 6 * * ?"
HONGDAL_KAMIS_MONTHLY_BATCH_ENABLED=true
HONGDAL_KAMIS_MONTHLY_CRON_EXPRESSION="0 0 7 2 * ?"
HONGDAL_USDA_MONTHLY_BATCH_ENABLED=true
HONGDAL_USDA_MONTHLY_CRON_EXPRESSION="0 30 7 10 * ?"
HONGDAL_KAMIS_CERTIFICATION_KEY=CHANGE_ME_KAMIS_CERTIFICATION_KEY
HONGDAL_KAMIS_REQUESTER_ID=CHANGE_ME_KAMIS_REQUESTER_ID
HONGDAL_USDA_NASS_API_KEY=CHANGE_ME_USDA_NASS_API_KEY

# Azure Translator를 만든 뒤에만 true로 바꿉니다. 신고·분쟁 글은 기본적으로 번역하지 않습니다.
HONGDAL_COMMUNITY_TRANSLATION_ENABLED=false
HONGDAL_AZURE_TRANSLATOR_KEY=
HONGDAL_AZURE_TRANSLATOR_REGION=koreacentral
