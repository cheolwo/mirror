<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DriverApp.Controls"
             x:Class="DriverApp.NativeDriverHomePage"
             BackgroundColor="#f7f8fa"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto">
        <controls:DriverNativeMapView x:Name="MapView"
                                      Grid.RowSpan="2" />

        <VerticalStackLayout Grid.Row="0"
                             Margin="16,8,16,0"
                             Spacing="8"
                             VerticalOptions="Start">
            <Label x:Name="TitleLabel"
                   IsVisible="False" />
            <Label x:Name="StatusLabel"
                   FontSize="14"
                   TextColor="#334155"
                   BackgroundColor="#EFFFFFFF"
                   Padding="12"
                   IsVisible="False" />
            <Button x:Name="RetryWorkspaceButton"
                    Text="다시 시도"
                    BackgroundColor="#2563eb"
                    TextColor="#ffffff"
                    CornerRadius="8"
                    Clicked="OnRetryWorkspaceClicked"
                    IsVisible="False" />

            <Border Padding="5"
                    BackgroundColor="#EFFFFFFF"
                    Stroke="#cbd5e1"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="13" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#33000000"
                            Offset="0,3"
                            Radius="9"
                            Opacity="0.18" />
                </Border.Shadow>

                    <VerticalStackLayout Spacing="0"
                                         Padding="7,2"
                                         VerticalOptions="Center">
                        <Label x:Name="OperatingMarketLabel"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#0f172a"
                               HorizontalTextAlignment="Start" />
                        <Label x:Name="MapProviderLabel"
                               FontSize="10"
                               TextColor="#64748b"
                               HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
            </Border>

            <Border x:Name="RecommendationBanner"
                    Padding="12,9"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DCE5E9"
                    StrokeThickness="1"
                    IsVisible="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenIncomingRecommendationClicked" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#55000000"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.24" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="4,4,24,*,Auto" ColumnSpacing="6">
                        <BoxView x:Name="RecommendationPrimaryBar" Color="#64748B" />
                        <BoxView x:Name="RecommendationSecondaryBar" Grid.Column="1" Color="#DC2626" IsVisible="False" />
                        <Path Grid.Column="2" Data="M3 7 L12 2 L21 7 L21 17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 L12 22"
                              Stroke="#172B36" StrokeThickness="1.6" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                            <Label x:Name="RecommendationWorkLabel" Text="신규 배차 추천" FontAttributes="Bold" FontSize="15" TextColor="#172B36" LineBreakMode="WordWrap" />
                            <Label x:Name="RecommendationActivityLabel" FontSize="13" TextColor="#586B78" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label x:Name="RecommendationCountdownLabel"
                               Grid.Column="4"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#172B36"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <ProgressBar x:Name="RecommendationCountdownProgress"
                                 Grid.Row="1"
                                 HeightRequest="5"
                                 Progress="0"
                                 ProgressColor="#22c55e" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Margin="16,0,16,16"
                             Spacing="10"
                             VerticalOptions="End">
            <Border x:Name="RecommendationDetailBanner"
                    Padding="12"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DCE5E9"
                    StrokeThickness="1"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#55000000"
                            Offset="0,-3"
                            Radius="14"
                            Opacity="0.24" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="4,4,24,*,Auto" ColumnSpacing="6">
                        <BoxView x:Name="RecommendationDetailPrimaryBar" Color="#64748B" />
                        <BoxView x:Name="RecommendationDetailSecondaryBar" Grid.Column="1" Color="#DC2626" IsVisible="False" />
                        <Path Grid.Column="2" Data="M3 7 L12 2 L21 7 L21 17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 L12 22"
                              Stroke="#172B36" StrokeThickness="1.6" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                            <Label x:Name="RecommendationDetailWorkLabel" Text="신규 배차 추천 확인"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="#172B36" />
                            <Label x:Name="RecommendationSummaryLabel"
                                   FontSize="13"
                                   TextColor="#586B78"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label x:Name="RecommendationDetailCountdownLabel"
                               Grid.Column="4"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#172B36"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <ProgressBar x:Name="RecommendationDetailCountdownProgress"
                                 Grid.Row="1"
                                 HeightRequest="7"
                                 Progress="0"
                                 ProgressColor="#22c55e" />
                </Grid>
            </Border>

            <Border x:Name="LinkedRouteCard"
                    Padding="14"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DCE5E9"
                    StrokeThickness="1"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="4,4,24,*" ColumnSpacing="6">
                        <BoxView x:Name="LinkedOfferPrimaryBar" Color="#64748B" />
                        <BoxView x:Name="LinkedOfferSecondaryBar" Grid.Column="1" Color="#DC2626" IsVisible="False" />
                        <Path Grid.Column="2" Data="M3 7 L12 2 L21 7 L21 17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 L12 22"
                              Stroke="#172B36" StrokeThickness="1.6" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                            <Label x:Name="LinkedOfferWorkLabel" FontAttributes="Bold" FontSize="15" TextColor="#172B36" LineBreakMode="WordWrap" />
                            <Label x:Name="LinkedOfferActivityLabel" FontSize="13" TextColor="#586B78" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="운행 연계 경로"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#0f172a" />
                            <Label x:Name="LinkedRouteSummaryLabel"
                                   FontSize="13"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label x:Name="LinkedRouteBenefitLabel"
                               Grid.Column="1"
                               Padding="8,4"
                               BackgroundColor="#dcfce7"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="#166534"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="5"
                          ColumnSpacing="8">
                        <Label Grid.Row="0" Text="1" FontAttributes="Bold" TextColor="#2563eb" />
                        <Label x:Name="CurrentDropoffRouteLabel" Grid.Row="0" Grid.Column="1" FontSize="13" TextColor="#111827" />

                        <Label Grid.Row="1" Text="2" FontAttributes="Bold" TextColor="#2563eb" />
                        <Label x:Name="RecommendationPickupRouteLabel" Grid.Row="1" Grid.Column="1" FontSize="13" TextColor="#111827" />

                        <Label Grid.Row="2" Text="3" FontAttributes="Bold" TextColor="#2563eb" />
                        <Label x:Name="RecommendationDropoffRouteLabel" Grid.Row="2" Grid.Column="1" FontSize="13" TextColor="#111827" />
                    </Grid>

                    <Label x:Name="RecommendationCompactInfoLabel"
                           FontSize="13"
                           TextColor="#334155"
                           LineBreakMode="WordWrap" />

                    <Label x:Name="RecommendationPricingDistanceLabel" FontSize="13" TextColor="#586B78" LineBreakMode="WordWrap" />
                    <Label x:Name="RecommendationPricingFeeLabel" FontSize="13" TextColor="#172B36" LineBreakMode="WordWrap" />
                    <Label x:Name="RecommendationPricingRateLabel" FontSize="13" TextColor="#586B78" LineBreakMode="WordWrap" />

                    <Label x:Name="RecommendationDecisionStatusLabel"
                           FontSize="13"
                           TextColor="#475569"
                           LineBreakMode="WordWrap" />

                    <Grid x:Name="RecommendationDecisionButtons"
                          ColumnDefinitions="*,*,*,*"
                          ColumnSpacing="8">
                        <Button Text="수락"
                                BackgroundColor="#16a34a"
                                TextColor="#ffffff"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                Clicked="OnAcceptRecommendationClicked" />
                        <Button Grid.Column="1"
                                Text="보류"
                                BackgroundColor="#e0f2fe"
                                TextColor="#075985"
                                CornerRadius="8"
                                Clicked="OnHoldRecommendationClicked" />
                        <Button Grid.Column="2"
                                Text="거절"
                                BackgroundColor="#fee2e2"
                                TextColor="#991b1b"
                                CornerRadius="8"
                                Clicked="OnRejectRecommendationClicked" />
                        <Button Grid.Column="3"
                                Text="취소"
                                BackgroundColor="#fef3c7"
                                TextColor="#92400e"
                                CornerRadius="8"
                                Clicked="OnCancelAcceptedRecommendationClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <controls:DriverTransportFooterBar x:Name="TransportFooterBar"
                                               OpenMenuRequested="OnOpenLegacyMenuClicked"
                                               OpenTransportRequested="OnOpenCurrentTransportClicked" />
            <Button Text="직접 피킹·배송 순회"
                    HeightRequest="48"
                    BackgroundColor="#0F766E"
                    TextColor="#ffffff"
                    CornerRadius="8"
                    Clicked="OnOpenDistributedRoundClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
