<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DriverApp.Controls"
             x:Class="DriverApp.NativeDriverHomePage"
             BackgroundColor="#f7f8fa"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto">
        <controls:DriverNativeMapView x:Name="MapView"
                                      Grid.RowSpan="2" />

        <VerticalStackLayout Grid.Row="0"
                             Margin="16,8,16,0"
                             Spacing="8"
                             VerticalOptions="Start">
            <Label x:Name="TitleLabel"
                   IsVisible="False" />
            <Label x:Name="StatusLabel"
                   IsVisible="False" />

            <Border Padding="5"
                    BackgroundColor="#EFFFFFFF"
                    Stroke="#cbd5e1"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="13" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#33000000"
                            Offset="0,3"
                            Radius="9"
                            Opacity="0.18" />
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                    <Button x:Name="KoreaDriverButton"
                            Text="한국 기사용"
                            Padding="12,7"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="9"
                            Clicked="OnKoreaDriverClicked" />
                    <Button x:Name="UnitedStatesDriverButton"
                            Grid.Column="1"
                            Text="미국 기사용"
                            Padding="12,7"
                            FontSize="12"
                            FontAttributes="Bold"
                            CornerRadius="9"
                            Clicked="OnUnitedStatesDriverClicked" />
                    <VerticalStackLayout Grid.Column="2"
                                         Spacing="0"
                                         HorizontalOptions="End"
                                         VerticalOptions="Center">
                        <Label x:Name="OperatingMarketLabel"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#0f172a"
                               HorizontalTextAlignment="End" />
                        <Label x:Name="MapProviderLabel"
                               FontSize="10"
                               TextColor="#64748b"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border x:Name="RecommendationBanner"
                    Padding="12,9"
                    BackgroundColor="#111827"
                    Stroke="#60a5fa"
                    StrokeThickness="1"
                    IsVisible="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenIncomingRecommendationClicked" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#55000000"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.24" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                BackgroundColor="#2563eb"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="17" />
                            </Border.StrokeShape>
                            <Label Text="!"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="#ffffff"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>

                        <Label Grid.Column="1"
                               Text="신규 배차 추천"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="#ffffff"
                               VerticalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />

                        <Label x:Name="RecommendationCountdownLabel"
                               Grid.Column="2"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#ffffff"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <ProgressBar x:Name="RecommendationCountdownProgress"
                                 Grid.Row="1"
                                 HeightRequest="5"
                                 Progress="0"
                                 ProgressColor="#22c55e" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Margin="16,0,16,16"
                             Spacing="10"
                             VerticalOptions="End">
            <Border x:Name="RecommendationDetailBanner"
                    Padding="12"
                    BackgroundColor="#0f172a"
                    Stroke="#38bdf8"
                    StrokeThickness="1"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#55000000"
                            Offset="0,-3"
                            Radius="14"
                            Opacity="0.24" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="신규 배차 추천 확인"
                                FontAttributes="Bold"
                                FontSize="15"
                                TextColor="#ffffff" />
                            <Label x:Name="RecommendationSummaryLabel"
                                   FontSize="13"
                                   TextColor="#dbeafe"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label x:Name="RecommendationDetailCountdownLabel"
                               Grid.Column="1"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#ffffff"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <ProgressBar x:Name="RecommendationDetailCountdownProgress"
                                 Grid.Row="1"
                                 HeightRequest="7"
                                 Progress="0"
                                 ProgressColor="#22c55e" />
                </Grid>
            </Border>

            <Border x:Name="LinkedRouteCard"
                    Padding="14"
                    BackgroundColor="#f8fafc"
                    Stroke="#bfdbfe"
                    StrokeThickness="1"
                    IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="운행 연계 경로"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="#0f172a" />
                            <Label x:Name="LinkedRouteSummaryLabel"
                                   FontSize="13"
                                   TextColor="#334155"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Label x:Name="LinkedRouteBenefitLabel"
                               Grid.Column="1"
                               Padding="8,4"
                               BackgroundColor="#dcfce7"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="#166534"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="5"
                          ColumnSpacing="8">
                        <Label Grid.Row="0" Text="1" FontAttributes="Bold" TextColor="#2563eb" />
                        <Label x:Name="CurrentDropoffRouteLabel" Grid.Row="0" Grid.Column="1" FontSize="13" TextColor="#111827" />

                        <Label Grid.Row="1" Text="2" FontAttributes="Bold" TextColor="#2563eb" />
                        <Label x:Name="RecommendationPickupRouteLabel" Grid.Row="1" Grid.Column="1" FontSize="13" TextColor="#111827" />

                        <Label Grid.Row="2" Text="3" FontAttributes="Bold" TextColor="#2563eb" />
                        <Label x:Name="RecommendationDropoffRouteLabel" Grid.Row="2" Grid.Column="1" FontSize="13" TextColor="#111827" />
                    </Grid>

                    <Label x:Name="RecommendationCompactInfoLabel"
                           FontSize="13"
                           TextColor="#334155"
                           LineBreakMode="WordWrap" />

                    <Label x:Name="RecommendationDecisionStatusLabel"
                           FontSize="13"
                           TextColor="#475569"
                           LineBreakMode="WordWrap" />

                    <Grid x:Name="RecommendationDecisionButtons"
                          ColumnDefinitions="*,*,*,*"
                          ColumnSpacing="8">
                        <Button Text="수락"
                                BackgroundColor="#16a34a"
                                TextColor="#ffffff"
                                CornerRadius="8"
                                FontAttributes="Bold"
                                Clicked="OnAcceptRecommendationClicked" />
                        <Button Grid.Column="1"
                                Text="보류"
                                BackgroundColor="#e0f2fe"
                                TextColor="#075985"
                                CornerRadius="8"
                                Clicked="OnHoldRecommendationClicked" />
                        <Button Grid.Column="2"
                                Text="거절"
                                BackgroundColor="#fee2e2"
                                TextColor="#991b1b"
                                CornerRadius="8"
                                Clicked="OnRejectRecommendationClicked" />
                        <Button Grid.Column="3"
                                Text="취소"
                                BackgroundColor="#fef3c7"
                                TextColor="#92400e"
                                CornerRadius="8"
                                Clicked="OnCancelAcceptedRecommendationClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <controls:DriverTransportFooterBar x:Name="TransportFooterBar"
                                               OpenMenuRequested="OnOpenLegacyMenuClicked"
                                               OpenTransportRequested="OnOpenCurrentTransportClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
