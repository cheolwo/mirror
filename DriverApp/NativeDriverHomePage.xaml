<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DriverApp.Controls"
             x:Class="DriverApp.NativeDriverHomePage"
             BackgroundColor="#f7f8fa"
             NavigationPage.HasNavigationBar="False">
    <Grid RowDefinitions="*,Auto">
        <controls:DriverNativeMapView x:Name="MapView"
                                      Grid.RowSpan="2" />

        <VerticalStackLayout Grid.Row="0"
                             Margin="16,8,16,0"
                             Spacing="8"
                             VerticalOptions="Start">
            <Label x:Name="TitleLabel"
                   IsVisible="False" />
            <Label x:Name="StatusLabel"
                   FontSize="14"
                   TextColor="#334155"
                   BackgroundColor="#EFFFFFFF"
                   Padding="12"
                   IsVisible="False" />
            <Button x:Name="RetryWorkspaceButton"
                    Text="다시 시도"
                    BackgroundColor="#2563eb"
                    TextColor="#ffffff"
                    CornerRadius="8"
                    Clicked="OnRetryWorkspaceClicked"
                    IsVisible="False" />

            <Border Padding="12,9" BackgroundColor="#FFFFFF" Stroke="#DCE5E9" StrokeThickness="1"
                    HorizontalOptions="Start" MaximumWidthRequest="340">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="8">
                        <Path Data="M10 3 L10 11 M5 6 C0 13 5 20 10 20 C15 20 20 13 15 6"
                              Stroke="#172B36" StrokeThickness="1.6" Aspect="Uniform" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="신규 배차 받기" FontAttributes="Bold" FontSize="14" TextColor="#172B36" />
                            <Label x:Name="ReceptionStateLabel" Text="확인 필요" FontSize="12" TextColor="#586B78" />
                        </VerticalStackLayout>
                        <Switch x:Name="ReceptionSwitch" Grid.Column="2" OnColor="#0F766E" IsEnabled="False"
                                SemanticProperties.Description="신규 배차 받기" Toggled="OnReceptionToggled" />
                    </Grid>
                    <Label x:Name="ReceptionNoticeLabel" FontSize="12" TextColor="#586B78" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="5"
                    BackgroundColor="#EFFFFFFF"
                    Stroke="#cbd5e1"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="13" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#33000000"
                            Offset="0,3"
                            Radius="9"
                            Opacity="0.18" />
                </Border.Shadow>

                    <VerticalStackLayout Spacing="0"
                                         Padding="7,2"
                                         VerticalOptions="Center">
                        <Label x:Name="OperatingMarketLabel"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#0f172a"
                               HorizontalTextAlignment="Start" />
                        <Label x:Name="MapProviderLabel"
                               FontSize="10"
                               TextColor="#64748b"
                               HorizontalTextAlignment="Start" />
                    </VerticalStackLayout>
            </Border>

            <Border x:Name="RecommendationBanner"
                    Padding="12,9"
                    BackgroundColor="#FFFFFF"
                    Stroke="#DCE5E9"
                    StrokeThickness="1"
                    IsVisible="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenIncomingRecommendationClicked" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#55000000"
                            Offset="0,4"
                            Radius="12"
                            Opacity="0.24" />
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto" RowSpacing="7">
                    <Grid ColumnDefinitions="4,4,24,*,Auto" ColumnSpacing="6">
                        <BoxView x:Name="RecommendationPrimaryBar" Color="#64748B" />
                        <BoxView x:Name="RecommendationSecondaryBar" Grid.Column="1" Color="#DC2626" IsVisible="False" />
                        <Path x:Name="RecommendationWorkIcon" Grid.Column="2" Data="M3 7 L12 2 L21 7 L21 17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 L12 22"
                              Stroke="#172B36" StrokeThickness="1.6" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="3" Spacing="2">
                            <Label x:Name="RecommendationWorkLabel" Text="신규 배차 추천" FontAttributes="Bold" FontSize="15" TextColor="#172B36" LineBreakMode="WordWrap" />
                            <Label x:Name="RecommendationActivityLabel" FontSize="13" TextColor="#586B78" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Label x:Name="RecommendationCountdownLabel"
                               Grid.Column="4"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="#172B36"
                               VerticalTextAlignment="Center" />
                    </Grid>

                    <ProgressBar x:Name="RecommendationCountdownProgress"
                                 Grid.Row="1"
                                 HeightRequest="5"
                                 Progress="0"
                                 ProgressColor="#22c55e" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Margin="16,0,16,16"
                             Spacing="10"
                             VerticalOptions="End">
            <controls:DriverTransportFooterBar x:Name="TransportFooterBar"
                                               OpenMenuRequested="OnOpenLegacyMenuClicked"
                                               OpenTransportRequested="OnOpenCurrentTransportClicked" />
            <Button Text="직접 피킹·배송 순회"
                    HeightRequest="48"
                    BackgroundColor="#0F766E"
                    TextColor="#ffffff"
                    CornerRadius="8"
                    Clicked="OnOpenDistributedRoundClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
