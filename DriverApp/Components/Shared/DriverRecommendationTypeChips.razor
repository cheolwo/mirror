@using DriverApp.Models.Driver
@using Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DriverOffers

<MudStack Spacing="1" Class="@Class">
    <DriverOfferBadge Visual="@Request.OfferVisual" />
    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@Request.운송의뢰유형표시</MudChip>
    @if (Request.세대배송포함여부)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@Request.세대배송범위표시</MudChip>
    }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public DriverRequestItem Request { get; set; } = new();

    [Parameter]
    public string Class { get; set; } = "mt-1";
}
