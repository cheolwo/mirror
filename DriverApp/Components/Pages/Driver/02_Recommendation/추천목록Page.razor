@page "/driver/recommendations"
@inject IDriverSampleDataService Samples
@inject IAuthSession AuthSession
@inject 추천카드표시설정Service CardPreferenceService
@inject IDriverRecommendationDecisionService DecisionService
@using DriverApp.Models.Driver
@using Ssalddel.Client.Infrastructure.Transport
@implements IDisposable

<PageTitle>추천목록</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">추천 목록</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">기사님 현재 위치에서 가까운 상차지부터 추천콜을 확인한다.</MudText>
            </MudStack>
        </MudPaper>

        @if (_데이터로딩중)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">현재 위치와 추천 배차를 불러오고 있습니다.</MudText>
        }
        else if (!_인증됨)
        {
            <MudAlert Severity="Severity.Warning">
                추천 배차는 기사 로그인 후 확인할 수 있습니다.
                <MudButton Class="ml-2"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@DriverRoutes.LoginFor(DriverRoutes.Recommendations)">
                    로그인하고 추천 보기
                </MudButton>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_데이터오류))
        {
            <MudAlert Severity="Severity.Error">
                @_데이터오류
                <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" OnClick="재조회Async">다시 시도</MudButton>
            </MudAlert>
        }
        else
        {
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="재조회Async">
                    새 추천 확인
                </MudButton>
            </MudStack>
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1">현재 위치</MudText>
                        <MudText Typo="Typo.body2">@Samples.기사현재위치.위치명</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@현재위치갱신문구</MudText>
                    </MudStack>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">@추천건수문구</MudChip>
                </MudStack>

                <MudDivider />

                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">상차지까지 거리</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var option in 반경옵션)
                        {
                            <MudButton Size="Size.Small" Variant="@반경버튼Variant(option.Km)" Color="Color.Primary" OnClick="@(() => 반경선택(option.Km))">@option.Label</MudButton>
                        }
                    </MudStack>
                </MudStack>

                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">정렬</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Size="Size.Small" Variant="@정렬버튼Variant("거리")" Color="Color.Secondary" OnClick="@(() => 정렬선택("거리"))">가까운순</MudButton>
                        <MudButton Size="Size.Small" Variant="@정렬버튼Variant("수익")" Color="Color.Secondary" OnClick="@(() => 정렬선택("수익"))">수익순</MudButton>
                    </MudStack>
                </MudStack>

                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">보기 방식</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Size="Size.Small" Variant="@(CardPreferenceService.GetSettings().표시모드 == 추천카드표시모드.간단히 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => CardPreferenceService.SetMode(추천카드표시모드.간단히))">간단히</MudButton>
                        <MudButton Size="Size.Small" Variant="@(CardPreferenceService.GetSettings().표시모드 == 추천카드표시모드.표준 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => CardPreferenceService.SetMode(추천카드표시모드.표준))">표준</MudButton>
                        <MudButton Size="Size.Small" Variant="@(CardPreferenceService.GetSettings().표시모드 == 추천카드표시모드.자세히 ? Variant.Filled : Variant.Outlined)" Color="Color.Success" OnClick="@(() => CardPreferenceService.SetMode(추천카드표시모드.자세히))">자세히</MudButton>
                    </MudStack>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!_데이터로딩중 && _인증됨 && string.IsNullOrWhiteSpace(_데이터오류) && 표시목록.Count == 0)
        {
            <MudAlert Severity="Severity.Info">현재 조건에 맞는 추천 의뢰가 없습니다. 운행 대기 상태와 위치 공유 상태를 확인한 뒤 새 추천을 확인해 주세요.</MudAlert>
        }
        else if (!_데이터로딩중 && _인증됨 && string.IsNullOrWhiteSpace(_데이터오류)
                 && CardPreferenceService.CalculatePolicy().거리표시 == false
                 && CardPreferenceService.CalculatePolicy().차량조건표시 == false)
        {
            <MudStack Spacing="2">
                @foreach (var item in 표시목록)
                {
                    <MudPaper Class="driver-recommendation-card pa-3" Elevation="0">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Class="driver-recommendation-card__head">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1">@item.의뢰.화물종류</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@간단부제(item)</MudText>
                                    <DriverRecommendationTypeChips Request="@item.의뢰" />
                                </MudStack>
                                <MudStack Spacing="0" AlignItems="AlignItems.End" Class="driver-recommendation-card__fare">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">예상 수익</MudText>
                                    <MudText Typo="Typo.h6" Color="Color.Error">@item.예상수익표시</MudText>
                                </MudStack>
                            </MudStack>

                            @{ var warningState = DriverWarningBadgeStateFactory.Create(item); }
                            <RecommendationWarningBadges RequiresSpecialPickup="@warningState.RequiresSpecialPickup"
                                                         RequiresSpecialDropoff="@warningState.RequiresSpecialDropoff"
                                                         ShowReceipt="@warningState.ShowReceipt" />

                            <DriverRoutePaymentSummary PickupTitle="@item.의뢰.픽업지"
                                                       PickupSubtitle="@상차지거리문구(item)"
                                                       PickupMeta="@(new[] { item.의뢰.운송조건표시, item.의뢰.차량조건표시 })"
                                                       DropoffTitle="@item.의뢰.하차지"
                                                       DropoffSubtitle="@운송거리문구(item)"
                                                       DropoffMeta="@(new[] { item.의뢰.시간조건표시, item.의뢰.인수증표시 })"
                                                       PaymentItems="@(new[] { item.의뢰.결제방식, item.의뢰.인수증표시 })" />

                            @응답제한표시(item.의뢰)

                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@DriverRoutes.RecommendationDetail(item.의뢰.의뢰Id)">상세</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" Href="@DriverRoutes.RecommendationDecision(item.의뢰.의뢰Id)">수락/거절</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }
        else if (!_데이터로딩중 && _인증됨 && string.IsNullOrWhiteSpace(_데이터오류))
        {
            <MudGrid Spacing="3">
                @foreach (var item in 표시목록)
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="driver-recommendation-card pa-4 h-100" Elevation="0">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Class="driver-recommendation-card__head">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.h6">@item.의뢰.화물종류</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@자세히부제(item)</MudText>
                                        <DriverRecommendationTypeChips Request="@item.의뢰" />
                                    </MudStack>
                                    <MudStack Spacing="0" AlignItems="AlignItems.End" Class="driver-recommendation-card__fare">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">예상 수익</MudText>
                                        <MudText Typo="Typo.h6" Color="Color.Error">@item.예상수익표시</MudText>
                                    </MudStack>
                                </MudStack>

                                @{ var warningState = DriverWarningBadgeStateFactory.Create(item); }
                                <RecommendationWarningBadges RequiresSpecialPickup="@warningState.RequiresSpecialPickup"
                                                             RequiresSpecialDropoff="@warningState.RequiresSpecialDropoff"
                                                             ShowReceipt="@warningState.ShowReceipt" />

                                <DriverRoutePaymentSummary PickupTitle="@item.의뢰.픽업지"
                                                           PickupSubtitle="@상차지거리문구(item)"
                                                           PickupMeta="@(new[] { item.의뢰.운송조건표시, item.의뢰.차량조건표시, item.의뢰.상차시간표시 })"
                                                           DropoffTitle="@item.의뢰.하차지"
                                                           DropoffSubtitle="@운송거리문구(item)"
                                                           DropoffMeta="@(new[] { item.의뢰.하차시간표시, item.의뢰.인수증표시 })"
                                                           PaymentItems="@(new[] { item.의뢰.결제방식, item.의뢰.인수증표시 })" />

                                @응답제한표시(item.의뢰)

                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@DriverRoutes.RecommendationDetail(item.의뢰.의뢰Id)">상세</MudButton>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Success" Href="@DriverRoutes.RecommendationDecision(item.의뢰.의뢰Id)">수락/거절</MudButton>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Home">기사 홈으로</MudButton>
    </MudStack>
</MudContainer>

@code {
    private decimal? _선택반경Km;
    private string _정렬기준 = "거리";
    private readonly HashSet<string> _자동거절처리중 = new(StringComparer.OrdinalIgnoreCase);
    private CancellationTokenSource? _타이머취소;
    private bool _데이터로딩중 = true;
    private bool _인증됨;
    private string? _데이터오류;

    private static readonly IReadOnlyList<반경옵션항목> 반경옵션 =
    [
        new("전체", null),
        new("5km", 5m),
        new("10km", 10m),
        new("20km", 20m),
        new("50km", 50m)
    ];

    private IReadOnlyList<추천의뢰표시항목> 표시목록
    {
        get
        {
            var items = Samples.거리포함추천의뢰목록조회().AsEnumerable();
            if (_선택반경Km.HasValue)
            {
                items = items.Where(x => x.상차지까지거리Km <= _선택반경Km.Value);
            }

            items = _정렬기준 switch
            {
                "수익" => items.OrderByDescending(x => x.의뢰.예상수익 ?? 0m).ThenBy(x => x.상차지까지거리Km),
                _ => items.OrderBy(x => x.상차지까지거리Km)
            };

            return items.ToList();
        }
    }

    private string 현재위치갱신문구 => string.Format("{0:HH:mm} 갱신 · 상차지까지 직선거리 기준", Samples.기사현재위치.갱신시각);
    private string 추천건수문구 => string.Format("추천 {0}건", 표시목록.Count);

    private static string 간단부제(추천의뢰표시항목 item) => string.Format("{0}. {1} · {2}", item.가까운순위, item.의뢰.화물종류, item.의뢰.상태);
    private static string 자세히부제(추천의뢰표시항목 item) => string.Format("{0} · 추천점수 {1}", item.의뢰.화물종류, item.추천점수표시);
    private static string 상차지거리문구(추천의뢰표시항목 item) => string.Format("현재 위치에서 상차지까지 {0}", item.상차지까지거리표시);
    private static string 운송거리문구(추천의뢰표시항목 item) => string.Format("운송 {0}", item.운송거리표시);
    private static string 예상수익문구(추천의뢰표시항목 item) => string.Format("예상수익 {0}", item.예상수익표시);

    private void 반경선택(decimal? 반경Km) => _선택반경Km = 반경Km;
    private void 정렬선택(string 정렬기준) => _정렬기준 = 정렬기준;

    private Variant 반경버튼Variant(decimal? 반경Km) => _선택반경Km == 반경Km ? Variant.Filled : Variant.Outlined;
    private Variant 정렬버튼Variant(string 정렬기준) => _정렬기준 == 정렬기준 ? Variant.Filled : Variant.Outlined;
    private Variant 보기버튼Variant(string 보기모드) => CardPreferenceService.GetSettings().표시모드 switch
    {
        추천카드표시모드.간단히 when 보기모드 == "간단히" => Variant.Filled,
        추천카드표시모드.표준 when 보기모드 == "표준" => Variant.Filled,
        추천카드표시모드.자세히 when 보기모드 == "자세히" => Variant.Filled,
        _ => Variant.Outlined
    };

    protected override async Task OnInitializedAsync()
    {
        DecisionService.Changed += OnDecisionChanged;
        _타이머취소 = new CancellationTokenSource();
        _ = RunTimerAsync(_타이머취소.Token);
        await 데이터조회Async(force: false);
    }

    public void Dispose()
    {
        DecisionService.Changed -= OnDecisionChanged;
        _타이머취소?.Cancel();
        _타이머취소?.Dispose();
    }

    private async Task RunTimerAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var nextServerRefresh = DateTime.UtcNow
            + TransportRequestLedgerRefreshPolicy.FallbackPollingInterval;
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await 자동미응답거절처리Async(cancellationToken);
                    if (DateTime.UtcNow >= nextServerRefresh)
                    {
                        await 데이터조회Async(force: true);
                        nextServerRefresh = DateTime.UtcNow
                            + TransportRequestLedgerRefreshPolicy.FallbackPollingInterval;
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task 자동미응답거절처리Async(CancellationToken cancellationToken)
    {
        if (_데이터로딩중 || !_인증됨 || !string.IsNullOrWhiteSpace(_데이터오류))
        {
            return;
        }

        foreach (var item in 표시목록)
        {
            var request = item.의뢰;
            if (!자동거절대상(request))
            {
                continue;
            }

            _자동거절처리중.Add(request.의뢰Id);
            try
            {
                await DecisionService.RejectAsync(request, "60초 미응답 자동 거절", cancellationToken);
            }
            catch
            {
                _자동거절처리중.Remove(request.의뢰Id);
            }
        }
    }

    private bool 자동거절대상(DriverRequestItem request)
        => request.추천응답만료
           && DecisionService.GetDecision(request.의뢰Id) is null
           && !_자동거절처리중.Contains(request.의뢰Id);

    private void OnDecisionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private Task 재조회Async()
        => 데이터조회Async(force: true);

    private async Task 데이터조회Async(bool force)
    {
        _데이터로딩중 = true;
        _데이터오류 = null;

        try
        {
            await AuthSession.RestoreAsync();
            _인증됨 = AuthSession.IsAuthenticated;
            if (_인증됨)
            {
                await Samples.RefreshAsync(force: force);
            }
        }
        catch
        {
            _데이터오류 = "추천 정보를 불러오지 못했습니다. 네트워크와 서버 연결을 확인한 뒤 다시 시도해 주세요.";
        }
        finally
        {
            _데이터로딩중 = false;
        }
    }

    private RenderFragment 응답제한표시(DriverRequestItem request) => builder =>
    {
        if (!request.서버지정추천)
        {
            return;
        }

        var decision = DecisionService.GetDecision(request.의뢰Id);
        var isHandled = decision is not null;
        var seconds = request.추천남은초;
        var label = isHandled
            ? $"처리됨 · {decision!.Decision}"
            : seconds > 0
                ? $"남은 시간 {seconds}초"
                : "미응답 자동 거절 처리 중";

        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "driver-recommendation-timeout");
        builder.OpenElement(2, "div");
        builder.AddAttribute(3, "class", "driver-recommendation-timeout__head");
        builder.OpenElement(4, "span");
        builder.AddContent(5, "신규 배차");
        builder.CloseElement();
        builder.OpenElement(6, "span");
        builder.AddContent(7, label);
        builder.CloseElement();
        builder.CloseElement();

        builder.OpenComponent<MudProgressLinear>(8);
        builder.AddAttribute(9, "Color", seconds > 10 || isHandled ? Color.Primary : Color.Warning);
        builder.AddAttribute(10, "Rounded", true);
        builder.AddAttribute(11, "Size", Size.Medium);
        builder.AddAttribute(12, "Value", isHandled ? 100d : request.추천진행률);
        builder.CloseComponent();

        builder.OpenElement(13, "div");
        builder.AddAttribute(14, "class", "driver-recommendation-timeout__caption");
        builder.AddContent(15, isHandled
            ? decision!.Memo
            : "제한 시간 안에 수락하지 않으면 서버에 미응답 거절로 보냅니다.");
        builder.CloseElement();
        builder.CloseElement();
    };

    private sealed record 반경옵션항목(string Label, decimal? Km);
}

