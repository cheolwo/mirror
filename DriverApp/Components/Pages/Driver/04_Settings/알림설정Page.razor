@page "/driver/notifications/settings"
@using Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DriverNotifications
@inject IAuthSession Auth
@inject IDriverNotificationApiService Api
@inject IDriverCargoRecommendationAlertService Alerts
@implements IDisposable
<PageTitle>추천 알림 설정</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <DriverRecommendationSettingsForm Model="Model" LoginHref="@DriverRoutes.LoginFor(DriverRoutes.NotificationSettings)" />
    <MudStack Row="true" Wrap="Wrap.Wrap" Class="mt-4">
        <MudButton Variant="Variant.Outlined" Href="@DriverRoutes.Notifications">알림함 보기</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/driver/notifications/push">휴대폰 알림 안내</MudButton>
        <MudButton Variant="Variant.Text" Href="@DriverRoutes.Menu">전체 메뉴로</MudButton>
    </MudStack>
</MudContainer>

@code {
    private DriverRecommendationSettingsViewModel Model = default!;
    protected override void OnInitialized() => Model = new(new DriverRecommendationSettingsClient(Auth, Api, Alerts));
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender) { await Model.LoadAsync(); StateHasChanged(); } }
    public void Dispose() => Model.Dispose();
}
