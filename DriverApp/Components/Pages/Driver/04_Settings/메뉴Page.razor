@page "/driver/menu"

<PageTitle>메뉴</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
    <div class="driver-menu-page">
        <header class="driver-menu-heading">
            <h1>전체 메뉴</h1>
            <p>운행 준비부터 내 정보까지 필요한 메뉴를 선택합니다.</p>
        </header>

        <NavMenu />

        <div class="driver-menu-return">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Home">기사 홈으로 돌아가기</MudButton>
        </div>
    </div>
</MudContainer>
