@page "/driver/reservations"
@using DriverApp.ViewModels.Driver.Reservation
@using DriverApp.ViewModels.Driver.Transport
@inherits DriverApp.Components.MvvmComponentBase<기사예약PageViewModel>

<PageTitle>예약</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">예약</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">오늘 잡아둔 예약과 운행 전 확인할 내용을 확인합니다.</MudText>
            </MudStack>
        </MudPaper>

        <MudGrid Spacing="3">
            @foreach (var item in ViewModel.예약목록)
            {
                <MudItem xs="12" md="4">
                    <MudPaper Class="pa-4 h-100" Elevation="2">
                        <MudStack Spacing="1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">@기사국내시각표시.표시(item.StartTime, "MM-dd HH:mm", "예약 시각 미확인")</MudText>
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@(item.IsFuture ? "예약" : "지난 예약")</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.body2">시작 모드: @item.StartMode</MudText>
                            <MudText Typo="Typo.body2">시작 위치: @item.StartLocation</MudText>
                            <MudText Typo="Typo.body2">복귀지: @(item.ReturnDestination ?? "미설정")</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/driver/work/start">운행 시작으로</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/driver/home">기사 홈으로</MudButton>
        </MudStack>
    </MudStack>
</MudContainer>

@code {
    protected override Task OnInitializedAsync() => ViewModel.초기화Async();
}
