@page "/driver/transports/{운송Id:long}/pickup"
@using DriverApp.ViewModels.Driver.Transport
@inherits MvvmComponentBase<기사상차PageViewModel>

<PageTitle>상차</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">상차</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">상차지 도착, 화물 확인, 사진 증빙을 마친 뒤 상차 완료를 처리합니다.</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                @if (ViewModel.운송 is null)
                {
                    <MudAlert Severity="Severity.Warning">운송 정보를 찾지 못했습니다.</MudAlert>
                }
                else
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">상차지</MudText>
                            <MudText Typo="Typo.h6">@ViewModel.운송.픽업지</MudText>
                        </MudStack>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">@ViewModel.운송.현재단계</MudChip>
                    </MudStack>

                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">화물</MudText>
                            <MudText Typo="Typo.body1">@ViewModel.운송.화물종류</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">의뢰</MudText>
                            <MudText Typo="Typo.body1">@ViewModel.운송.의뢰Id</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">다음 이동</MudText>
                            <MudText Typo="Typo.body1">@ViewModel.운송.하차지</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">상차 유형</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@ViewModel.화물.상차유형색" Variant="Variant.Filled">@ViewModel.운송.수입화물유형표시</MudChip>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">결제/증빙</MudText>
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.body1">@ViewModel.인수증.결제증빙라벨</MudText>
                                @if (ViewModel.인수증.필요)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@ViewModel.인수증.서명칩색" Variant="Variant.Filled">@ViewModel.인수증.서명칩라벨</MudChip>
                                }
                            </MudStack>
                        </MudItem>
                    </MudGrid>

                    <MudDivider />

                    <MudPaper Elevation="0" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle1">수입화물 상차 확인</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@ViewModel.운송.상차주의사항</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="@ViewModel.화물.상차유형색" Variant="Variant.Outlined">@ViewModel.운송.상차작업방식</MudChip>
                            </MudStack>

                            <MudGrid>
                                @if (!string.IsNullOrWhiteSpace(ViewModel.운송.선하증권번호))
                                {
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">BL/반출 문서</MudText>
                                        <MudText Typo="Typo.body2">@ViewModel.운송.선하증권번호</MudText>
                                    </MudItem>
                                }
                                @if (ViewModel.운송.IsFcl)
                                {
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">컨테이너 번호</MudText>
                                        <MudText Typo="Typo.body2">@ViewModel.운송.컨테이너번호</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">봉인번호</MudText>
                                        <MudText Typo="Typo.body2">@ViewModel.운송.봉인번호</MudText>
                                    </MudItem>
                                }
                            </MudGrid>

                            @if (ViewModel.운송.IsLcl)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    LCL은 여러 화주의 화물이 섞여 나올 수 있으므로 문서 번호, 박스 라벨, 수량을 함께 대조합니다.
                                </MudAlert>
                            }
                            else if (ViewModel.운송.IsFcl)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    FCL은 컨테이너와 봉인 상태가 핵심입니다. 번호 불일치나 훼손 흔적은 상차 전에 사진으로 남깁니다.
                                </MudAlert>
                            }

                            @if (ViewModel.운송.상차체크목록.Count > 0)
                            {
                                <MudStack Spacing="1">
                                    @foreach (var item in ViewModel.운송.상차체크목록)
                                    {
                                        <MudPaper Elevation="0" Class="pa-2">
                                            <MudCheckBox T="bool"
                                                         Value="@ViewModel.화물.체크확인됨(item.Code)"
                                                         ValueChanged="@((bool value) => ViewModel.화물.체크설정(item.Code, value))"
                                                         Label="@item.Label"
                                                         Color="Color.Primary" />
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.HelpText</MudText>
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                        </MudStack>
                    </MudPaper>

                    <MudDivider />

                    @if (ViewModel.운송.상차대상화물목록.Count > 0)
                    {
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1">바코드 상차/적재 안내</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@ViewModel.운송.적재순번운영안내</MudText>
                                    </MudStack>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@(ViewModel.운송.적재순번필요 ? Color.Warning : Color.Success)"
                                             Variant="Variant.Filled">
                                        @(ViewModel.운송.적재순번필요 ? "적재순번 적용" : "동일 규격")
                                    </MudChip>
                                </MudStack>

                                <DriverCargoLoadProgress CargoItems="@ViewModel.운송.상차대상화물목록"
                                                         ConfirmedCargoCodes="@ViewModel.화물.상차완료코드" />

                                @if (ViewModel.화물.다음화물 is not null)
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">
                                                지금 상차: @ViewModel.화물.다음화물.적재순번표시 · @ViewModel.화물.다음화물.Label
                                            </MudText>
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@ViewModel.화물.다음화물.적재순번표시 상차</MudChip>
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@ViewModel.화물.다음화물.차량적재위치</MudChip>
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@ViewModel.화물.다음화물.하차순번표시</MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.body2">@ViewModel.화물.다음화물.하차위치 · @ViewModel.화물.다음화물.수량중량표시</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@ViewModel.화물.다음화물.작업메모</MudText>
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Warning"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.TouchApp"
                                                       OnClick="ViewModel.화물.다음화물선택">
                                                다음 화물 선택
                                            </MudButton>
                                        </MudStack>
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true">권장 상차 순서의 모든 화물을 확인했습니다.</MudAlert>
                                }

                                <MudGrid>
                                    <MudItem xs="12" sm="8">
                                        <MudTextField @bind-Value="ViewModel.화물.바코드입력"
                                                      Label="상차 바코드"
                                                      Placeholder="바코드를 스캔하거나 입력"
                                                      Variant="Variant.Outlined"
                                                      Immediate="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.QrCodeScanner"
                                                   OnClick="ViewModel.화물.바코드조회">
                                            바코드 조회
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>

                                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                    @foreach (var item in ViewModel.화물.정렬화물)
                                    {
                                        <MudButton Variant="@ViewModel.화물.화물버튼모양(item)"
                                                   Color="@ViewModel.화물.화물버튼색(item)"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ViewModel.화물.화물선택(item))">
                                            @item.적재순번표시 · @item.Barcode
                                        </MudButton>
                                    }
                                </MudStack>

                                @if (ViewModel.화물.선택화물 is not null)
                                {
                                    <MudPaper Elevation="0" Class="pa-3">
                                        @if (ViewModel.화물.선택화물순서다름)
                                        {
                                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                                권장 다음 화물은 @(ViewModel.화물.다음화물?.Label)입니다. 현장 사정으로 순서를 바꿀 수는 있지만,
                                                하차 때 화물이 막히지 않는지 먼저 확인해 주세요.
                                            </MudAlert>
                                        }

                                        <MudGrid>
                                            <MudItem xs="12" sm="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @(ViewModel.운송.적재순번필요 ? "적재순번" : "적재 기준")
                                                </MudText>
                                                @if (ViewModel.운송.적재순번필요)
                                                {
                                                    <MudText Typo="Typo.h3" Color="Color.Warning">@ViewModel.화물.선택화물.적재순번표시</MudText>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.h5" Color="Color.Success">동일 규격</MudText>
                                                }
                                            </MudItem>
                                            <MudItem xs="12" sm="8">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">조회된 화물</MudText>
                                                <MudText Typo="Typo.subtitle1">@ViewModel.화물.선택화물.Label</MudText>
                                                <MudText Typo="Typo.body2">@ViewModel.화물.선택화물.수량중량표시 · @ViewModel.화물.선택화물.하차위치</MudText>
                                                <MudText Typo="Typo.body2">@ViewModel.화물.선택화물.차량적재위치 · @ViewModel.화물.선택화물.하차순번표시</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ViewModel.화물.선택화물.작업메모</MudText>
                                            </MudItem>
                                        </MudGrid>

                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                                   Disabled="@ViewModel.화물.상차확인됨(ViewModel.화물.선택화물.Code)"
                                                   OnClick="ViewModel.화물.선택화물확인">
                                            @(ViewModel.화물.상차확인됨(ViewModel.화물.선택화물.Code) ? "상차 확인됨" : "이 화물 상차 확인")
                                        </MudButton>
                                    </MudPaper>
                                }

                                <MudGrid>
                                    @foreach (var item in ViewModel.화물.정렬화물)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-2">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.body2"><strong>@item.적재순번표시 상차</strong> · @item.Label</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Barcode · @item.수량중량표시</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.차량적재위치 → @item.하차순번표시 · @item.하차위치</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.작업메모</MudText>
                                                    </MudStack>
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="@ViewModel.화물.화물칩색(item)"
                                                             Variant="Variant.Outlined">
                                                        @ViewModel.화물.화물칩라벨(item)
                                                    </MudChip>
                                                </MudStack>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudStack>
                        </MudPaper>

                        <MudDivider />
                    }

                    <MudPaper Elevation="0" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">현장 확인</MudText>
                            <MudCheckBox T="bool" @bind-Value="ViewModel.현장.상차지확인" Label="상차지에 도착했고 주소를 확인했습니다." Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="ViewModel.현장.화물상태확인" Label="화물 수량과 외관 상태를 확인했습니다." Color="Color.Primary" />
                            <MudCheckBox T="bool" @bind-Value="ViewModel.현장.화주연락확인" Label="화주 또는 현장 담당자와 상차를 확인했습니다." Color="Color.Primary" />
                        </MudStack>
                    </MudPaper>

                    <DriverTransportIssuePanel Description="상차 수량 부족, 다른 화물 혼입, 바코드 훼손 같은 예외를 즉시 남깁니다."
                                               IssueTypes="@ViewModel.예외.유형목록"
                                               @bind-Open="ViewModel.예외.열림"
                                               @bind-IssueType="ViewModel.예외.유형"
                                               @bind-Memo="ViewModel.예외.메모"
                                               IsReporting="@ViewModel.예외.신고중"
                                               OnSubmit="@(() => ViewModel.예외.신고Command.ExecuteAsync(null))" />

                    @if (ViewModel.인수증.필요)
                    {
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.subtitle1">인수증 증빙</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@ViewModel.인수증.서명칩색" Variant="Variant.Outlined">@ViewModel.인수증.서명칩라벨</MudChip>
                                </MudStack>

                                <MudSelect T="string" Label="증빙 방식" @bind-Value="ViewModel.인수증.증빙방식" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@기사상차인수증ViewModel.문서사진방식">서명 문서 사진</MudSelectItem>
                                    <MudSelectItem Value="@기사상차인수증ViewModel.직접서명방식">직접 서명 입력</MudSelectItem>
                                    @if (!ViewModel.인수증.서명필수)
                                    {
                                        <MudSelectItem Value="@기사상차인수증ViewModel.서명생략방식">서명 없이 진행</MudSelectItem>
                                    }
                                </MudSelect>

                                @if (ViewModel.인수증.문서사진선택)
                                {
                                    <MudCheckBox T="bool"
                                                 @bind-Value="ViewModel.인수증.문서사진확인"
                                                 Label="상차 사진에 서명된 인수증 또는 현장 문서가 함께 보이도록 촬영했습니다."
                                                 Color="Color.Primary" />
                                }
                                else if (ViewModel.인수증.직접서명선택)
                                {
                                    <MudGrid>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="ViewModel.인수증.인수자명"
                                                          Label="인수자명"
                                                          Variant="Variant.Outlined"
                                                          MaxLength="100"
                                                          Immediate="true" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="ViewModel.인수증.인수자소속"
                                                          Label="인수자 소속"
                                                          Variant="Variant.Outlined"
                                                          MaxLength="100"
                                                          Immediate="true" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="ViewModel.인수증.인수자서명"
                                                          Label="인수자 서명"
                                                          Variant="Variant.Outlined"
                                                          MaxLength="200"
                                                          Immediate="true" />
                                        </MudItem>
                                        <MudItem xs="12" sm="6">
                                            <MudTextField @bind-Value="ViewModel.인수증.기사서명"
                                                          Label="기사 서명"
                                                          Variant="Variant.Outlined"
                                                          MaxLength="200"
                                                          Immediate="true" />
                                        </MudItem>
                                    </MudGrid>
                                    <MudCheckBox T="bool"
                                                 @bind-Value="ViewModel.인수증.인수증확인"
                                                 Label="인수자와 기사가 상차 인수 사실을 확인하고 서명했습니다."
                                                 Color="Color.Primary" />
                                }
                                else
                                {
                                    <MudTextField @bind-Value="ViewModel.인수증.서명생략사유"
                                                  Label="서명 생략 사유"
                                                  Variant="Variant.Outlined"
                                                  MaxLength="300"
                                                  Immediate="true" />
                                }
                            </MudStack>
                        </MudPaper>
                    }

                    <DriverTransportProofPanel Title="상차 완료 사진"
                                               Description="화물과 차량 적재 상태가 보이도록 촬영합니다. 사진 확인 후 완료 처리가 가능합니다."
                                               PreviewUrl="@ViewModel.사진.미리보기Url"
                                               PreviewAlt="상차 완료 사진 미리보기"
                                               FileName="@ViewModel.사진.파일명"
                                               StatusMessage="@ViewModel.상태.메시지"
                                               StatusSeverity="@ViewModel.상태.심각도"
                                               HasPhoto="@ViewModel.사진.사진있음"
                                               IsCapturing="@ViewModel.사진.촬영중"
                                               CanComplete="@ViewModel.완료가능"
                                               IsCompleting="@ViewModel.상차완료.처리중"
                                               CompletionGuide="@ViewModel.완료안내"
                                               CaptureButtonText="상차 완료 사진 촬영"
                                               RetakeButtonText="상차 사진 다시 촬영"
                                               CompleteButtonText="상차 완료"
                                               CompletingText="상차 완료 처리 중"
                                               OnCapture="@(() => ViewModel.사진.촬영Command.ExecuteAsync(null))"
                                               OnComplete="@(() => ViewModel.완료Command.ExecuteAsync(null))"
                                               OnClear="ViewModel.사진.제거" />
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/driver/transports/current">진행 중 운송으로</MudButton>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public long 운송Id { get; set; }

    protected override void OnParametersSet() => ViewModel.Initialize(운송Id);
}
