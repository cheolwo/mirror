@page "/driver/transports/{운송Id:long}/dropoff"
@using DriverApp.ViewModels.Driver.Transport
@inherits MvvmComponentBase<기사하차PageViewModel>

<PageTitle>하차</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">하차</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">하차지 도착, 인수 확인, 결제 또는 인수증 확인 후 하차 완료를 처리합니다.</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                @if (ViewModel.운송 is null)
                {
                    <MudAlert Severity="Severity.Warning">운송 정보를 찾지 못했습니다.</MudAlert>
                }
                else
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">하차지</MudText>
                            <MudText Typo="Typo.h6">@ViewModel.운송.하차지</MudText>
                        </MudStack>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@ViewModel.운송.현재단계</MudChip>
                    </MudStack>

                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">출발 상차지</MudText>
                            <MudText Typo="Typo.body1">@ViewModel.운송.픽업지</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">운송거리</MudText>
                            <MudText Typo="Typo.body1">@ViewModel.운송.운송거리Km.ToString("0.0")km</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">예상수익</MudText>
                            <MudText Typo="Typo.body1">@ViewModel.운송.예상수익.ToString("N0")원</MudText>
                        </MudItem>
                    </MudGrid>

                    <MudDivider />

                    @if (ViewModel.운송.상차대상화물목록.Count > 0)
                    {
                        <MudPaper Elevation="0" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1">세대/하차지별 하차 확인</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@ViewModel.화물.안내</MudText>
                                    </MudStack>
                                    <MudChip T="string" Size="Size.Small" Color="@ViewModel.화물.진행색" Variant="Variant.Filled">@ViewModel.화물.진행라벨</MudChip>
                                </MudStack>

                                <DriverCargoLoadProgress CargoItems="@ViewModel.운송.상차대상화물목록"
                                                         ConfirmedCargoCodes="@ViewModel.화물.하차완료코드"
                                                         IsUnloading="true" />

                                @if (ViewModel.화물.다음화물 is not null)
                                {
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.subtitle2">
                                                지금 하차: @ViewModel.화물.다음화물.하차순번표시 · @ViewModel.화물.다음화물.하차위치
                                            </MudText>
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@ViewModel.화물.다음화물.차량적재위치</MudChip>
                                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">@ViewModel.화물.다음화물.하차순번표시</MudChip>
                                            </MudStack>
                                            <MudText Typo="Typo.body2">@ViewModel.화물.다음화물.Label · @ViewModel.화물.다음화물.수량중량표시 · @ViewModel.화물.다음화물.Barcode</MudText>
                                            <MudButton Variant="Variant.Text"
                                                       Color="Color.Info"
                                                       Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.TouchApp"
                                                       OnClick="ViewModel.화물.다음화물선택">
                                                다음 화물 선택
                                            </MudButton>
                                        </MudStack>
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Success" Dense="true">권장 하차 순서의 모든 화물을 확인했습니다.</MudAlert>
                                }

                                <MudGrid>
                                    <MudItem xs="12" sm="8">
                                        <MudTextField @bind-Value="ViewModel.화물.바코드입력"
                                                      Label="하차 바코드"
                                                      Placeholder="내릴 화물의 바코드를 스캔하거나 입력"
                                                      Variant="Variant.Outlined"
                                                      Immediate="true" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Info"
                                                   FullWidth="true"
                                                   StartIcon="@Icons.Material.Filled.QrCodeScanner"
                                                   OnClick="ViewModel.화물.바코드조회">
                                            바코드 조회
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>

                                @if (ViewModel.화물.선택화물 is not null)
                                {
                                    <MudPaper Elevation="0" Class="pa-3">
                                        @if (ViewModel.화물.선택화물순서다름)
                                        {
                                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                                권장 다음 화물은 @(ViewModel.화물.다음화물?.Label)입니다. 먼저 내리면 다른 화물을 다시 옮겨야 하는지 확인해 주세요.
                                            </MudAlert>
                                        }

                                        <MudGrid>
                                            <MudItem xs="12" sm="4">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">하차 순서</MudText>
                                                <MudText Typo="Typo.h4" Color="Color.Info">@ViewModel.화물.선택화물.하차순번표시</MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="8">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">조회된 화물</MudText>
                                                <MudText Typo="Typo.subtitle1">@ViewModel.화물.선택화물.Label</MudText>
                                                <MudText Typo="Typo.body2">@ViewModel.화물.선택화물.하차위치 · @ViewModel.화물.선택화물.수량중량표시</MudText>
                                                <MudText Typo="Typo.body2">@ViewModel.화물.선택화물.차량적재위치</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ViewModel.화물.선택화물.작업메모</MudText>
                                            </MudItem>
                                        </MudGrid>

                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Success"
                                                   StartIcon="@Icons.Material.Filled.CheckCircle"
                                                   Disabled="@ViewModel.화물.하차확인됨(ViewModel.화물.선택화물.Code)"
                                                   OnClick="ViewModel.화물.선택화물확인">
                                            @(ViewModel.화물.하차확인됨(ViewModel.화물.선택화물.Code) ? "하차 확인됨" : "이 화물 하차 확인")
                                        </MudButton>
                                    </MudPaper>
                                }

                                <MudGrid>
                                    @foreach (var item in ViewModel.화물.정렬화물)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudPaper Elevation="0" Class="pa-2">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.body2"><strong>@item.하차순번표시</strong> · @item.하차위치</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Label · @item.수량중량표시</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.차량적재위치 · @item.Barcode</MudText>
                                                    </MudStack>
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="@ViewModel.화물.화물칩색(item)"
                                                             Variant="Variant.Outlined">
                                                        @ViewModel.화물.화물칩라벨(item)
                                                    </MudChip>
                                                </MudStack>
                                            </MudPaper>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudStack>
                        </MudPaper>

                        <MudDivider />
                    }

                    <MudPaper Elevation="0" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">인수/결제 확인</MudText>
                            <MudCheckBox T="bool" @bind-Value="ViewModel.인계.하차지확인" Label="하차지에 도착했고 주소를 확인했습니다." Color="Color.Info" />
                            <MudCheckBox T="bool" @bind-Value="ViewModel.인계.수령자확인" Label="수령자 또는 현장 담당자에게 화물을 인계했습니다." Color="Color.Info" />
                            <MudSelect T="string" Label="현장 결제/증빙 방식" @bind-Value="ViewModel.인계.결제증빙방식" Variant="Variant.Outlined">
                                <MudSelectItem Value="@("인수증")">인수증</MudSelectItem>
                                <MudSelectItem Value="@("하단 계좌")">하단 계좌</MudSelectItem>
                                <MudSelectItem Value="@("카드")">카드</MudSelectItem>
                                <MudSelectItem Value="@("현금")">현금</MudSelectItem>
                                <MudSelectItem Value="@("후불 정산")">후불 정산</MudSelectItem>
                            </MudSelect>
                            <MudCheckBox T="bool" @bind-Value="ViewModel.인계.결제증빙확인" Label="선택한 결제/증빙 방식을 현장에서 확인했습니다." Color="Color.Info" />
                        </MudStack>
                    </MudPaper>

                    <DriverTransportIssuePanel Description="수량 부족, 다른 화물, 수령자 부재, 파손 의심 같은 하차 예외를 즉시 남깁니다."
                                               IssueTypes="@ViewModel.예외.유형목록"
                                               @bind-Open="ViewModel.예외.열림"
                                               @bind-IssueType="ViewModel.예외.유형"
                                               @bind-Memo="ViewModel.예외.메모"
                                               IsReporting="@ViewModel.예외.신고중"
                                               OnSubmit="@(() => ViewModel.예외.신고Command.ExecuteAsync(null))" />

                    <DriverTransportProofPanel Title="하차 완료 사진"
                                               Description="하차 위치와 전달 상태가 확인되도록 촬영합니다. 사진 확인 후 완료 처리가 가능합니다."
                                               PreviewUrl="@ViewModel.사진.미리보기Url"
                                               PreviewAlt="하차 완료 사진 미리보기"
                                               FileName="@ViewModel.사진.파일명"
                                               StatusMessage="@ViewModel.상태.메시지"
                                               StatusSeverity="@ViewModel.상태.심각도"
                                               HasPhoto="@ViewModel.사진.사진있음"
                                               IsCapturing="@ViewModel.사진.촬영중"
                                               CanComplete="@ViewModel.완료가능"
                                               IsCompleting="@ViewModel.하차완료.처리중"
                                               CompletionGuide="@ViewModel.완료안내"
                                               CaptureButtonText="하차 완료 사진 촬영"
                                               RetakeButtonText="하차 사진 다시 촬영"
                                               CompleteButtonText="하차 완료"
                                               CompletingText="하차 완료 처리 중"
                                               OnCapture="@(() => ViewModel.사진.촬영Command.ExecuteAsync(null))"
                                               OnComplete="@(() => ViewModel.완료Command.ExecuteAsync(null))"
                                               OnClear="ViewModel.사진.제거" />
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/driver/transports/current">진행 중 운송으로</MudButton>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public long 운송Id { get; set; }

    protected override void OnParametersSet() => ViewModel.Initialize(운송Id);
}
