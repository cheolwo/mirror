@page "/driver/transports/current"
@inject IDriverSampleDataService Samples
@inject IAuthSession AuthSession
@using Ssalddel.Client.Infrastructure.Transport
@implements IDisposable

<PageTitle>진행중 운송</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">진행 중 운송</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">현재 운송과 다음 행동을 서버 운송 데이터로 확인합니다.</MudText>
            </MudStack>
        </MudPaper>

        @if (_데이터로딩중)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">진행 중 운송을 확인하고 있습니다.</MudText>
        }
        else if (!_인증됨)
        {
            <MudAlert Severity="Severity.Warning">
                진행 중 운송은 기사 로그인 후 확인할 수 있습니다.
                <MudButton Class="ml-2"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@DriverRoutes.LoginFor(DriverRoutes.CurrentTransport)">
                    로그인하고 운송 확인
                </MudButton>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_데이터오류))
        {
            <MudAlert Severity="Severity.Error">
                @_데이터오류
                <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" OnClick="재조회Async">다시 시도</MudButton>
            </MudAlert>
        }
        else if (현재운송 is not null)
        {
            <MudPaper Class="pa-4" Elevation="3">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">다음 행동</MudText>
                            <MudText Typo="Typo.h5">@현재운송.다음행동</MudText>
                        </MudStack>
                        <MudChip T="string" Color="@CurrentStageColor" Variant="Variant.Filled">@현재운송.현재단계</MudChip>
                    </MudStack>

                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">상차</MudText>
                                <MudText Typo="Typo.subtitle1">@현재운송.픽업지</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">하차</MudText>
                                <MudText Typo="Typo.subtitle1">@현재운송.하차지</MudText>
                            </MudStack>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">예정시각</MudText>
                            <MudText Typo="Typo.body1">@현재운송.예정시각.ToString("HH:mm")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">운송거리</MudText>
                            <MudText Typo="Typo.body1">@현재운송.운송거리표시</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">예상수익</MudText>
                            <MudText Typo="Typo.body1">@현재운송.운임표시</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">상차 유형</MudText>
                            <MudChip T="string" Size="Size.Small" Color="@CargoLoadTypeColor" Variant="Variant.Filled">@현재운송.수입화물유형표시</MudChip>
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="flex-wrap">
                        <MudButton Variant="Variant.Filled" Color="@NextActionColor" Href="@NextActionHref" StartIcon="@NextActionIcon">@NextActionLabel</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@SecondaryActionHref">@SecondaryActionLabel</MudButton>
                    </MudStack>

                    <MudAlert Severity="Severity.Info" Class="mb-0">주소와 결제 정보는 아래 운행 상세에서 필요한 순간에만 펼쳐 확인합니다.</MudAlert>

                    <MudPaper Elevation="0" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle1">운송 상태 타임라인</MudText>
                            <MudGrid>
                                @foreach (var step in TransportTimeline)
                                {
                                    <MudItem xs="6" sm="4" md="2">
                                        <MudStack Spacing="1" AlignItems="AlignItems.Center">
                                            <MudIcon Icon="@step.Icon" Color="@step.Color" Size="Size.Medium" />
                                            <MudText Typo="Typo.caption" Align="Align.Center">@step.Label</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="@step.Color" Variant="@step.Variant">@step.Status</MudChip>
                                        </MudStack>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <MudPaper Elevation="0" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">수령자 최소 정보</MudText>
                                    <MudText Typo="Typo.subtitle1">@RecipientName</MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@RecipientPaymentMethod</MudChip>
                            </MudStack>
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">하차 위치</MudText>
                                    <MudText Typo="Typo.body2">@현재운송.하차지</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">연락처</MudText>
                                    <MudText Typo="Typo.body2">@RecipientMaskedPhone</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">인수 확인</MudText>
                                    <MudText Typo="Typo.body2">@RecipientProofHint</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudStack>
                    </MudPaper>

                    <SsalddelSensitiveDisclosureList Title="운행 상세"
                                                    Summary="@현재운송.현재단계"
                                                    RelatedParties='@($"기사님 · 화주 · 하차지 담당자 / 의뢰 {현재운송.의뢰Id}")'
                                                    Icon="@Icons.Material.Filled.LocalShipping"
                                                    Color="Color.Primary"
                                                    PrivacyHint="운행 중 필요한 정보만 펼쳐 확인합니다.">
                        <MudExpansionPanel Text="화물 정보">
                            <SsalddelSensitiveInfoRow Label="화물 종류" Value="@현재운송.화물종류" />
                            <SsalddelSensitiveInfoRow Label="상차 유형" Value="@현재운송.수입화물유형표시" />
                            <SsalddelSensitiveInfoRow Label="BL/반출 문서" Value="@DocumentNumberLabel" />
                            <SsalddelSensitiveInfoRow Label="컨테이너" Value="@ContainerNumberLabel" />
                            <SsalddelSensitiveInfoRow Label="의뢰 번호" Value="@현재운송.의뢰Id" />
                            <SsalddelSensitiveInfoRow Label="작업 메모" Value="@현재운송.상차주의사항" />
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="운송 정보">
                            <SsalddelSensitiveInfoRow Label="상차지" Value="@현재운송.픽업지" />
                            <SsalddelSensitiveInfoRow Label="하차지" Value="@현재운송.하차지" />
                            <SsalddelSensitiveInfoRow Label="현재 단계" Value="@현재운송.현재단계" />
                            <SsalddelSensitiveInfoRow Label="예정 시각" Value='@현재운송.예정시각.ToString("HH:mm")' />
                            <SsalddelSensitiveInfoRow Label="운송 거리" Value="@현재운송.운송거리표시" />
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="결제 정보">
                            <SsalddelSensitiveInfoRow Label="예상 수익" Value="@현재운송.운임표시" />
                            <SsalddelSensitiveInfoRow Label="정산 기준" Value="하차 완료 후 정산 확인" />
                            <SsalddelSensitiveInfoRow Label="인수증" Value="하차 현장에서 필요 여부 확인" />
                        </MudExpansionPanel>

                        <MudExpansionPanel Text="전달받는자 정보">
                            <SsalddelSensitiveInfoRow Label="전달 위치" Value="@현재운송.하차지" />
                            <SsalddelSensitiveInfoRow Label="담당자" Value="@RecipientName" />
                            <SsalddelSensitiveInfoRow Label="연락처" Value="@RecipientPhone" />
                            <SsalddelSensitiveInfoRow Label="전달 요청" Value="@RecipientDeliveryRequest" />
                        </MudExpansionPanel>
                    </SsalddelSensitiveDisclosureList>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Spacing="2" AlignItems="AlignItems.Start">
                    <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Secondary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">현재 진행 중인 운송이 없습니다.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">운행 대기를 시작하거나 추천 목록에서 다음 운송을 확인해 주세요.</MudText>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@DriverRoutes.Recommendations">추천 운송 보기</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.WorkStart">운행 대기 시작</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="재조회Async">새로고침</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Home">기사 홈으로</MudButton>
    </MudStack>
</MudContainer>

@code {
    private bool _데이터로딩중 = true;
    private bool _인증됨;
    private string? _데이터오류;
    private readonly CancellationTokenSource _갱신취소 = new();
    private CancellationToken _갱신토큰;
    private bool _폐기됨;
    private bool _초기조회완료;
    private int _조회판본;
    private long _관찰세션;
    private long? _조회세션;

    private 기사운송샘플항목? 현재운송
        => !_폐기됨 && AuthSession.IsAuthenticated && _조회세션 == AuthSession.SessionRevision
            ? Samples.현재운송조회()
            : null;

    protected override async Task OnInitializedAsync()
    {
        _갱신토큰 = _갱신취소.Token;
        AuthSession.Changed += 인증변경;
        await 데이터조회Async(force: false);
        _초기조회완료 = true;
        if (_폐기됨 || _갱신토큰.IsCancellationRequested)
            return;
        _ = 보완조회Async(_갱신토큰);
    }

    public void Dispose()
    {
        if (_폐기됨)
            return;
        _폐기됨 = true;
        Interlocked.Increment(ref _조회판본);
        AuthSession.Changed -= 인증변경;
        _갱신취소.Cancel();
        _갱신취소.Dispose();
    }

    private void 인증변경()
    {
        if (!_폐기됨 && _초기조회완료)
            _ = 인증변경반영Async();
    }

    private async Task 인증변경반영Async()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_폐기됨 || _관찰세션 == AuthSession.SessionRevision)
                    return;
                _관찰세션 = AuthSession.SessionRevision;
                Interlocked.Increment(ref _조회판본);
                _조회세션 = null;
                _인증됨 = AuthSession.IsAuthenticated;
                _데이터오류 = null;
                _데이터로딩중 = false;
                if (_인증됨)
                    await 데이터조회Async(force: true);
                if (!_폐기됨)
                    StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (_갱신토큰.IsCancellationRequested) { }
        catch (ObjectDisposedException) when (_폐기됨) { }
        catch (InvalidOperationException) when (_폐기됨) { }
    }

    private async Task 보완조회Async(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(
            TransportRequestLedgerRefreshPolicy.FallbackPollingInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (_폐기됨 || cancellationToken.IsCancellationRequested)
                        return;
                    await 데이터조회Async(force: true);
                    if (!_폐기됨 && !cancellationToken.IsCancellationRequested)
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (ObjectDisposedException) when (_폐기됨) { }
        catch (InvalidOperationException) when (_폐기됨) { }
    }

    private Task 재조회Async()
        => 데이터조회Async(force: true);

    private async Task 데이터조회Async(bool force)
    {
        if (_폐기됨 || _갱신토큰.IsCancellationRequested)
            return;
        var 판본 = Interlocked.Increment(ref _조회판본);
        _데이터로딩중 = true;
        _데이터오류 = null;

        try
        {
            await AuthSession.RestoreAsync(_갱신토큰);
            if (_폐기됨 || 판본 != _조회판본)
                return;
            var 세션 = AuthSession.SessionRevision;
            _관찰세션 = 세션;
            _인증됨 = AuthSession.IsAuthenticated;
            if (_인증됨)
            {
                await Samples.RefreshAsync(_갱신토큰, force: force);
                if (_폐기됨 || 판본 != _조회판본)
                    return;
                if (세션 != AuthSession.SessionRevision)
                {
                    if (AuthSession.IsAuthenticated)
                        _데이터오류 = "로그인 정보가 변경되었습니다. 다시 시도해 현재 운송을 확인해 주세요.";
                    return;
                }
                _조회세션 = 세션;
            }
        }
        catch (OperationCanceledException) when (_갱신토큰.IsCancellationRequested)
        {
        }
        catch
        {
            if (!_폐기됨 && 판본 == _조회판본 && AuthSession.IsAuthenticated)
                _데이터오류 = "진행 중 운송을 불러오지 못했습니다. 네트워크와 서버 연결을 확인한 뒤 다시 시도해 주세요.";
        }
        finally
        {
            if (!_폐기됨 && 판본 == _조회판본)
            {
                _인증됨 = AuthSession.IsAuthenticated;
                _데이터로딩중 = false;
            }
        }
    }

    private bool ShouldPickup
        => 현재운송?.현재단계 is "확정" or "배차확정"
           || 현재운송?.다음행동.Contains("상차", StringComparison.OrdinalIgnoreCase) == true;

    private string NextActionLabel => ShouldPickup ? "상차 처리하기" : "하차 처리하기";

    private string SecondaryActionLabel => ShouldPickup ? "하차 화면 확인" : "상차 화면 확인";

    private string NextActionHref => 현재운송 is null
        ? DriverRoutes.Home
        : ShouldPickup
            ? DriverRoutes.TransportPickup(현재운송.Id)
            : DriverRoutes.TransportDropoff(현재운송.Id);

    private string SecondaryActionHref => 현재운송 is null
        ? DriverRoutes.Home
        : ShouldPickup
            ? DriverRoutes.TransportDropoff(현재운송.Id)
            : DriverRoutes.TransportPickup(현재운송.Id);

    private string NextActionIcon => ShouldPickup
        ? Icons.Material.Filled.FileUpload
        : Icons.Material.Filled.TaskAlt;

    private Color NextActionColor => ShouldPickup ? Color.Primary : Color.Success;

    private Color CurrentStageColor => ShouldPickup ? Color.Primary : Color.Success;

    private Color CargoLoadTypeColor
        => 현재운송?.IsFcl == true
            ? Color.Warning
            : 현재운송?.IsLcl == true
                ? Color.Info
                : Color.Default;

    private string DocumentNumberLabel
        => string.IsNullOrWhiteSpace(현재운송?.선하증권번호) ? "현장 확인" : 현재운송.선하증권번호;

    private string ContainerNumberLabel
        => 현재운송?.IsFcl == true
            ? $"{현재운송.컨테이너번호} / 봉인 {현재운송.봉인번호}"
            : "해당 없음";

    private string RecipientName => string.IsNullOrWhiteSpace(현재운송?.수령자명)
        ? "하차지 담당자"
        : 현재운송.수령자명;

    private string RecipientPhone => string.IsNullOrWhiteSpace(현재운송?.수령자연락처)
        ? "연락처 미등록"
        : 현재운송.수령자연락처;

    private string RecipientMaskedPhone => MaskPhone(현재운송?.수령자연락처);

    private string RecipientDeliveryRequest => string.IsNullOrWhiteSpace(현재운송?.전달요청)
        ? "도착 전 연락 후 하차 완료 사진을 남깁니다."
        : 현재운송.전달요청;

    private string RecipientPaymentMethod => 현재운송 is null || string.IsNullOrWhiteSpace(현재운송.결제방식)
        ? "인수증 또는 현장 결제 확인"
        : 현재운송.결제방식;

    private string RecipientProofHint => 현재운송?.인수증필요 == true
        ? 현재운송.인수증서명필수 ? "상차 인수증 서명 필수 + 하차 사진" : "상차 인수증 서명 선택 + 하차 사진"
        : "하차 사진 + 수령자 확인";

    private static string MaskPhone(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return "연락처 미등록";
        }

        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return digits.Length >= 8
            ? $"{digits[..3]}-****-{digits[^4..]}"
            : "연락처 확인";
    }

    private IReadOnlyList<TransportTimelineStep> TransportTimeline =>
    [
        BuildTimelineStep("접수", Icons.Material.Filled.AssignmentTurnedIn, IsStepReached("접수")),
        BuildTimelineStep("배차중", Icons.Material.Filled.ManageSearch, IsStepReached("배차중")),
        BuildTimelineStep("배차확정", Icons.Material.Filled.LocalShipping, IsStepReached("배차확정")),
        BuildTimelineStep("상차완료", Icons.Material.Filled.FileUpload, IsStepReached("상차완료")),
        BuildTimelineStep("운송중", Icons.Material.Filled.Route, IsStepReached("운송중")),
        BuildTimelineStep("하차완료", Icons.Material.Filled.TaskAlt, IsStepReached("하차완료"))
    ];

    private TransportTimelineStep BuildTimelineStep(string label, string icon, bool reached)
    {
        var isCurrent = IsCurrentTimelineStep(label);
        return new TransportTimelineStep(
            label,
            icon,
            isCurrent ? "현재" : reached ? "완료" : "대기",
            isCurrent ? Color.Primary : reached ? Color.Success : Color.Default,
            isCurrent || reached ? Variant.Filled : Variant.Outlined);
    }

    private bool IsCurrentTimelineStep(string label)
    {
        var stage = 현재운송?.현재단계 ?? string.Empty;
        return label switch
        {
            "상차완료" => stage.Contains("상차", StringComparison.OrdinalIgnoreCase),
            "운송중" => stage.Contains("하차지 이동", StringComparison.OrdinalIgnoreCase) || stage.Contains("운송", StringComparison.OrdinalIgnoreCase),
            "하차완료" => stage.Contains("하차완료", StringComparison.OrdinalIgnoreCase) || stage.Contains("인수", StringComparison.OrdinalIgnoreCase),
            _ => false
        };
    }

    private bool IsStepReached(string label)
    {
        var stage = 현재운송?.현재단계 ?? string.Empty;
        var order = label switch
        {
            "접수" => 0,
            "배차중" => 1,
            "배차확정" => 2,
            "상차완료" => 3,
            "운송중" => 4,
            "하차완료" => 5,
            _ => 0
        };

        var currentOrder = stage switch
        {
            var s when s.Contains("하차완료", StringComparison.OrdinalIgnoreCase) || s.Contains("인수", StringComparison.OrdinalIgnoreCase) => 5,
            var s when s.Contains("하차지 이동", StringComparison.OrdinalIgnoreCase) || s.Contains("운송", StringComparison.OrdinalIgnoreCase) => 4,
            var s when s.Contains("상차", StringComparison.OrdinalIgnoreCase) => 3,
            _ => 2
        };

        return order <= currentOrder;
    }

    private sealed record TransportTimelineStep(
        string Label,
        string Icon,
        string Status,
        Color Color,
        Variant Variant);
}
