@page "/driver/transports/history"
@using Ssalddel.Contracts.Driver.Transport
@using DriverApp.ViewModels.Driver.Transport
@inherits DriverApp.Components.MvvmComponentBase<기사운송내역PageViewModel>

<PageTitle>배달 내역</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">배달 내역</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">화물 운송 기록과 원장 운임을 확인합니다.</MudText>
            </MudStack>
        </MudPaper>

        @if (ViewModel.불러오는중)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">배달 내역을 불러오고 있습니다.</MudText>
        }
        else if (ViewModel.로그인필요)
        {
            <MudAlert Severity="Severity.Warning">
                배달 내역은 기사 로그인 후 확인할 수 있습니다.
                <MudButton Class="ml-2"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@DriverRoutes.LoginFor(DriverRoutes.DeliveryHistory)">
                    로그인하고 내역 보기
                </MudButton>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(ViewModel.오류메시지))
        {
            <MudAlert Severity="Severity.Error">
                @ViewModel.오류메시지
                <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" OnClick="재조회Async">다시 시도</MudButton>
            </MudAlert>
        }
        else if (ViewModel.운송목록.Count == 0)
        {
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Spacing="2" AlignItems="AlignItems.Start">
                    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Secondary" Size="Size.Large" />
                    <MudText Typo="Typo.h6">아직 배달 내역이 없습니다.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">운송을 시작하면 진행 상태와 완료 기록이 여기에 시간순으로 쌓입니다.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@DriverRoutes.Recommendations">추천 운송 보기</MudButton>
                </MudStack>
            </MudPaper>
        }
        else
        {
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="재조회Async">내역 새로고침</MudButton>
            </MudStack>
            <MudGrid Spacing="2">
                @foreach (var item in ViewModel.운송목록.OrderByDescending(x => x.UpdatedAt))
                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="driver-recommendation-card pa-4 h-100" Elevation="0">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle1">화물 운송</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@item.운송번호</MudText>
                                    </MudStack>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@item.상태</MudChip>
                                </MudStack>

                                <DriverRoutePaymentSummary PickupTitle="@item.출발지"
                                                           PickupSubtitle="@PickupScheduleText(item)"
                                                           DropoffTitle="@item.도착지"
                                                           DropoffSubtitle="@HistoryDistanceText(item)"
                                                           PaymentLabel="원장 운임"
                                                           PaymentItems="@HistoryPaymentItems(item)" />
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Menu">사용자 메뉴로</MudButton>
    </MudStack>
</MudContainer>

@code {
    protected override Task OnInitializedAsync()
        => ViewModel.InitializeAsync();

    private Task 재조회Async()
        => ViewModel.RefreshAsync();

    private static string PickupScheduleText(기사운송요약응답 item)
        => $"출발 {기사국내시각표시.표시(item.출발_픽업)}";

    private static string HistoryDistanceText(기사운송요약응답 item)
        => item.예상거리Km.HasValue ? 기사운송표시Mapper.Map(item).운송거리표시 : "거리 자료 없음";

    private static IReadOnlyList<string> HistoryPaymentItems(기사운송요약응답 item)
        => [item.운임 is { } fare ? $"{fare:N0}원" : "운임 미확인", "실수령액은 별도 정산 확인"];
}
