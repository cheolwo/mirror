@page "/driver/account/bank"
<PageTitle>계좌 정보</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">계좌 정보</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">정산금을 받을 본인 계좌의 확인 상태를 안내합니다.</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="driver-recommendation-card pa-4" Elevation="0">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">계좌 정보 미확인</MudText>
                <MudAlert Severity="Severity.Info">현재 이 화면에서는 본인 계좌를 조회하거나 변경할 수 없습니다.</MudAlert>
                <MudText Typo="Typo.body2">이 안내는 계좌 등록이나 본인 확인 완료를 뜻하지 않습니다. 지급 예정 금액과 지급 준비 상태는 운송대금 목록에서 확인해 주세요.</MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@DriverRoutes.Payouts">운송대금 목록 보기</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Menu">전체 메뉴로</MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>
