@page "/driver/settlements/current-month"
@using DriverApp.ViewModels.Driver.Settlement
@inherits DriverApp.Components.MvvmComponentBase<기사월정산PageViewModel>

<PageTitle>월정산</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">월 정산</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">이번 달 이용료와 정산 내역을 확인합니다.</MudText>
            </MudStack>
        </MudPaper>

        @if (ViewModel.처리중)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText>이번 달 이용료를 불러오고 있습니다.</MudText>
        }
        else if (!ViewModel.초기화됨)
        {
            <MudAlert Severity="Severity.Error">@(ViewModel.오류메시지 ?? "이번 달 이용료를 확인하지 못했습니다.")</MudAlert>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="재조회Async">다시 시도</MudButton>
        }
        else
        {
        <MudPaper Class="pa-4" Elevation="2">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="3"><MudText Typo="Typo.h6">@정산월표시</MudText></MudItem>
                <MudItem xs="12" sm="3"><MudText>@배차건수표시</MudText></MudItem>
                <MudItem xs="12" sm="3"><MudText>@이용료표시</MudText></MudItem>
                <MudItem xs="12" sm="3"><MudText>@월상한표시</MudText></MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Spacing="2">
                <MudText Typo="Typo.subtitle2">상세 내역</MudText>
                @foreach (var item in 상세항목)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="driver-settlement-line">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body2">@item.항목명</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.설명</MudText>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="driver-settlement-line__amount">@금액표시(item.금액)</MudText>
                    </MudStack>
                }
            </MudStack>

            <MudAlert Class="mt-3" Severity="@(ViewModel.정산.IsPaid ? Severity.Success : Severity.Warning)">
                @(ViewModel.정산.IsPaid ? "이번 달 이용료 결제가 완료되었습니다." : "이번 달 이용료 확인이 필요합니다.")
            </MudAlert>
            <MudStack Row="true" Spacing="2" Class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/driver/settlements/info">이용료 안내</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/driver/home">기사 홈으로</MudButton>
            </MudStack>
        </MudPaper>
        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="재조회Async">이용료 새로고침</MudButton>
        }
    </MudStack>
</MudContainer>

@code {
    private string 정산월표시 => string.Format("{0}년 {1}월", ViewModel.정산.Year, ViewModel.정산.Month);
    private string 배차건수표시 => string.Format("배차 {0}건", ViewModel.정산.DispatchCount);
    private string 이용료표시 => string.Format("이용료 {0:0}원", ViewModel.정산.UsageFee);
    private string 월상한표시 => string.Format("월 상한 {0:0}원", ViewModel.정산.MonthlyFeeCap);
    private IReadOnlyList<기사정산표시항목> 상세항목 =>
    [
        new("이번 달 이용료", "완료된 배차 기준", -ViewModel.정산.UsageFee),
        new("월 상한 잔여", "상한 도달 전 남은 금액", ViewModel.정산.RemainingUntilCap)
    ];

    protected override Task OnInitializedAsync() => ViewModel.초기화Async();

    private Task 재조회Async() => ViewModel.새로고침Async();

    private static string 금액표시(decimal amount)
    {
        if (amount == 0)
        {
            return "0원";
        }

        return amount > 0 ? $"+{amount:0}원" : $"{amount:0}원";
    }

    private sealed record 기사정산표시항목(string 항목명, string 설명, decimal 금액);
}
