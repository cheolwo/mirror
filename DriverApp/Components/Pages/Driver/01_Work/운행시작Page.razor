@page "/driver/work/start"
@using DriverApp.ViewModels.Driver.Work
@inherits DriverApp.Components.MvvmComponentBase<기사운행시작PageViewModel>

<PageTitle>운행 시작</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">운행 시작</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">운행을 시작하면 현재 위치를 서버에 등록하고 Android 백그라운드 위치 송신을 시작한다.</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">운행 시작 기준</MudText>
                <MudText Typo="Typo.body1">현재 근무 상태: @ViewModel.운행상태</MudText>
                <MudText Typo="Typo.body1">시작 모드: @ViewModel.시작모드</MudText>
                <MudText Typo="Typo.body1">기본 시작 위치: @ViewModel.시작위치</MudText>
                <MudText Typo="Typo.body1">복귀지: @(ViewModel.복귀지 ?? "미설정")</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">위치 송신은 30초 간격으로 요청하며, 서버 권장값에 따라 조정됩니다.</MudText>
                <MudCheckBox T="bool" @bind-Value="ViewModel.커뮤니티운행공개" Color="Color.Success"
                             Disabled="@(ViewModel.처리중 || ViewModel.운행시작결과미확인)">
                    운행 시작을 커뮤니티에 공개하고 개별 운송 의뢰 받기
                </MudCheckBox>
                <MudCheckBox T="bool"
                             @bind-Value="ViewModel.커뮤니티구단위위치공개동의"
                             Color="Color.Primary"
                             Disabled="@(!ViewModel.커뮤니티운행공개 || ViewModel.처리중 || ViewModel.운행시작결과미확인)">
                    현재 GPS를 시·도와 시·군·구까지만 변환하여 공개하는 데 동의
                </MudCheckBox>
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined">
                    공개 목적은 인근 운송 의뢰 연결이며, 범위는 `서울특별시 중랑구` 같은 시·도+시·군·구입니다.
                    운행 중 최대 18시간만 유효하고 운행 종료로 철회됩니다. 면목동 같은 동 단위, 실제 좌표, 도로명주소와 연락처는 공개하지 않습니다.
                </MudAlert>

                @if (!string.IsNullOrWhiteSpace(ViewModel.상태문구))
                {
                    <MudAlert Severity="@메시지Severity(ViewModel.상태종류)">@ViewModel.상태문구</MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           Disabled="ViewModel.운행시작불가"
                           OnClick="@(() => ViewModel.운행시작Command.ExecuteAsync(null))">
                    @(ViewModel.처리중 ? "처리 중" : ViewModel.운행시작결과미확인 ? "현재 운행 확인" : ViewModel.위치송신중 ? "위치 송신 중" : "운행 시작")
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Warning"
                           Disabled="ViewModel.운행종료불가"
                           OnClick="@(() => ViewModel.운행종료Command.ExecuteAsync(null))">
                    운행 종료
                </MudButton>
                @if (ViewModel.지도이동가능)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="ViewModel.처리중"
                               OnClick="@(() => ViewModel.지도열기Command.ExecuteAsync(null))">운행 지도 열기</MudButton>
                }
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@DriverRoutes.HomeSummary">기사 홈에서 상태 보기</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Success" Href="@DriverRoutes.Recommendations">추천 운송 보기</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Forum" Href="@DriverRoutes.CommunityInquiries">커뮤니티 개별 의뢰 보기</MudButton>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    protected override Task OnInitializedAsync() => ViewModel.초기화Async();

    private static Severity 메시지Severity(기사Page메시지종류 종류) => 종류 switch
    {
        기사Page메시지종류.성공 => Severity.Success,
        기사Page메시지종류.주의 => Severity.Warning,
        기사Page메시지종류.오류 => Severity.Error,
        _ => Severity.Info
    };
}
