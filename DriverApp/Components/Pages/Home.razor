@page "/driver/home"
@using Hongdal.Contracts.Common.Drivers
@inject IAuthSession AuthSession
@inject IDriverSampleDataService SampleDataService
@inject DriverAppProfile DriverProfile

<PageTitle>살뜰 기사 업무 허브</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h4">기사 업무 허브</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            현재 앱은 @DriverProfile.DisplayName 업무 흐름을 기본값으로 사용합니다. 음식 배달 흐름은 F 드라이버 앱에서 분리해 처리합니다.
                        </MudText>
                    </MudStack>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">@DriverProfile.DisplayName</MudChip>
                </MudStack>

                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    지도는 앱 첫 화면의 네이티브 Naver SDK 지도에서 처리합니다. 이 화면은 화물/용달 추천, 운행, 정산, 설정 업무로 이동하는 허브입니다.
                </MudAlert>
            </MudStack>
        </MudPaper>

        <MudGrid>
            @foreach (var profile in DriverProfile.WorkProfiles)
            {
                var isCurrentApp = string.Equals(profile.AppKey, DriverProfile.AppKey, StringComparison.Ordinal);

                <MudItem xs="12" md="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudText Typo="Typo.h6">@profile.DisplayName</MudText>
                                <MudChip T="string"
                                         Color="@(isCurrentApp ? Color.Success : Color.Default)"
                                         Variant="@(isCurrentApp ? Variant.Filled : Variant.Outlined)"
                                         Size="Size.Small">
                                    @(isCurrentApp ? "현재 앱" : "화물/용달")
                                </MudChip>
                            </MudStack>

                            <MudText Typo="Typo.body2" Color="Color.Secondary">@profile.Description</MudText>

                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-1">
                                @profile.Focus
                            </MudAlert>

                            <MudButton Variant="@(isCurrentApp ? Variant.Filled : Variant.Outlined)"
                                       Color="@ProfileColor(profile)"
                                       Disabled="@(!isCurrentApp)"
                                       Href="@DriverRoutes.Recommendations">
                                @(isCurrentApp ? "추천 보기" : "별도 앱 분리 예정")
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudGrid>
            @foreach (var action in Actions)
            {
                <MudItem xs="12" md="6" lg="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                        <MudStack Spacing="2">
                            <MudIcon Icon="@action.Icon" Color="@action.Color" Size="Size.Large" />
                            <MudText Typo="Typo.h6">@action.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@action.Description</MudText>
                            <MudButton Variant="Variant.Filled" Color="@action.Color" Href="@action.Route">이동</MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6">현재 운행 상태</MudText>
                <MudGrid>
                    @foreach (var metric in Metrics)
                    {
                        <MudItem xs="12" sm="4">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@metric.Label</MudText>
                                <MudText Typo="Typo.h6" Color="@metric.Color">@metric.Value</MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private int RecommendationCount => SampleDataService.추천의뢰목록.Count;

    private string CurrentLocationName => SampleDataService.기사현재위치.위치명;

    private IReadOnlyList<HomeAction> Actions =>
    [
        new("운행 시작", "배차 수신 비콘과 운행 상태를 확인합니다.", Icons.Material.Filled.PlayArrow, Color.Success, DriverRoutes.WorkStart),
        new("추천 목록", $"현재 추천 {RecommendationCount:N0}건을 확인합니다.", Icons.Material.Filled.ListAlt, Color.Primary, DriverRoutes.Recommendations),
        new("진행 중 운송", "상차, 하차, 인수 완료 흐름으로 이동합니다.", Icons.Material.Filled.LocalShipping, Color.Secondary, DriverRoutes.CurrentTransport),
        new("전체 메뉴", "계좌, 정산, 알림, 화면 설정을 확인합니다.", Icons.Material.Filled.Menu, Color.Info, DriverRoutes.Menu)
    ];

    private IReadOnlyList<HomeMetric> Metrics =>
    [
        new("현재 위치", CurrentLocationName, Color.Primary),
        new("추천 운송", $"{RecommendationCount:N0}건", Color.Success),
        new("로그인 상태", AuthSession.IsAuthenticated ? "로그인됨" : "로그인 필요", AuthSession.IsAuthenticated ? Color.Success : Color.Warning)
    ];

    protected override async Task OnInitializedAsync()
    {
        await AuthSession.RestoreAsync();
    }

    private static Color ProfileColor(DriverWorkProfile profile)
    {
        return profile.WorkType switch
        {
            Hongdal.Contracts.Common.Drivers.기사업무유형코드.화물운송 => Color.Secondary,
            _ => Color.Primary
        };
    }

    private sealed record HomeAction(
        string Title,
        string Description,
        string Icon,
        Color Color,
        string Route);

    private sealed record HomeMetric(
        string Label,
        string Value,
        Color Color);
}
