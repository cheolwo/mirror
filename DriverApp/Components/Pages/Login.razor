@page "/login"
@layout AuthLayout
@inject IAuthSession AuthSession
@inject AuthApiService AuthApi
@inject I기사푸시토큰등록Service 푸시토큰등록Service
@inject NavigationManager NavigationManager

<PageTitle>로그인</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <MudStack Spacing="3">
        <Ssalddel공통로그인Panel 제목="기사 로그인"
                         설명="로그인하고 배차 추천과 운송 정보를 확인하세요."
                         초기아이디="@_loginId"
                         현재사용자표시="@CurrentUserLabel"
                         상태메시지="@_statusMessage"
                         상태Severity="@_statusSeverity"
                         일반로그인버튼텍스트="@(_isLoggedIn ? "세션 갱신" : "로그인")"
                         IsBusy="@_isBusy"
                         OnPasswordLogin="LoginAsync"
                         OnSocialLogin="SocialLoginAsync">
            @if (!string.IsNullOrWhiteSpace(복귀화면안내))
            {
                <MudText Typo="Typo.caption" Color="Color.Primary">로그인 후 @복귀화면안내 화면으로 돌아갑니다.</MudText>
            }

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       FullWidth="true"
                       OnClick="GoBackOrHome">
                @(_isLoggedIn && 안전한복귀경로 is not null ? "요청한 업무로 돌아가기" : "기사 홈으로")
            </MudButton>

            @if (_isLoggedIn)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           FullWidth="true"
                           OnClick="Logout">
                    로그아웃
                </MudButton>
            }
        </Ssalddel공통로그인Panel>
    </MudStack>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private string _loginId = string.Empty;
    private bool _isBusy;
    private bool _isLoggedIn;
    private string? _statusMessage = "로그인하면 배차 추천, 진행 중 운송, 배달 내역을 서버 상태와 동기화합니다.";
    private Severity _statusSeverity = Severity.Info;
    private string CurrentUserLabel => AuthSession.UserName ?? "미로그인";
    private string? 안전한복귀경로 => 내부기사경로인가(ReturnUrl) ? ReturnUrl : null;
    private string? 복귀화면안내 => 안전한복귀경로 switch
    {
        DriverRoutes.Recommendations => "추천 목록",
        DriverRoutes.CurrentTransport => "진행 중 운송",
        DriverRoutes.DeliveryHistory => "배달 내역",
        DriverRoutes.WorkStart => "운행 시작",
        not null => "요청한 기사 업무",
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await AuthSession.RestoreAsync();
        }
        catch
        {
            _statusSeverity = Severity.Warning;
            _statusMessage = "저장된 로그인 정보를 확인하지 못했습니다. 다시 로그인해 주세요.";
        }
        _isLoggedIn = AuthSession.IsAuthenticated;
        _loginId = AuthSession.UserName ?? string.Empty;
    }

    private async Task LoginAsync(공통로그인요청 request)
    {
        if (_isBusy)
        {
            return;
        }

        _loginId = request.UserNameOrEmail;
        _isBusy = true;

        try
        {
            var result = await AuthApi.LoginAsync(request.UserNameOrEmail, request.Password);
            if (!result.IsSuccess)
            {
                _statusSeverity = Severity.Error;
                _statusMessage = result.ErrorMessage;
                return;
            }

            _isLoggedIn = AuthSession.IsAuthenticated;
            try
            {
                await 푸시토큰등록Service.저장토큰등록Async();
            }
            catch
            {
                // Notification registration is auxiliary to the successful login.
                // The requested transport can still be loaded and retried independently.
            }

            _isLoggedIn = AuthSession.IsAuthenticated;
            if (!_isLoggedIn)
            {
                _statusSeverity = Severity.Warning;
                _statusMessage = "로그인 세션이 만료되었습니다. 다시 로그인해 주세요.";
                return;
            }
            _statusSeverity = Severity.Success;
            _statusMessage = $"{AuthSession.UserName ?? _loginId} 님, 서버 로그인되었습니다.";
            NavigationManager.NavigateTo(안전한복귀경로 ?? DriverRoutes.HomeSummary);
        }
        catch
        {
            _statusSeverity = Severity.Error;
            _statusMessage = "Ssalddel 서버에 연결하지 못했습니다. 서버 실행 상태와 HTTPS 포트를 확인해 주세요.";
            return;
        }
        finally
        {
            _isBusy = false;
        }

    }

    private Task SocialLoginAsync(공통소셜로그인요청 request)
    {
        _statusSeverity = Severity.Info;
        _statusMessage = $"{request.ProviderDisplayName} 요청을 받았습니다. ProviderId={request.ProviderId}. 서버 OAuth 설정이 준비되면 이 버튼에서 인증 흐름을 시작합니다.";
        return Task.CompletedTask;
    }

    private async Task Logout()
    {
        try
        {
            await AuthSession.ClearAsync();
            _statusSeverity = Severity.Info;
            _statusMessage = "로그아웃했습니다.";
        }
        catch
        {
            _statusSeverity = Severity.Warning;
            _statusMessage = "현재 로그인은 종료했습니다. 기기의 저장된 로그인 정보 삭제를 확인하지 못했습니다.";
        }
        finally
        {
            _isLoggedIn = AuthSession.IsAuthenticated;
        }
    }

    private void GoBackOrHome()
    {
        NavigationManager.NavigateTo(
            _isLoggedIn && 안전한복귀경로 is { } route
                ? route
                : DriverRoutes.HomeSummary);
    }

    private static bool 내부기사경로인가(string? returnUrl)
        => !string.IsNullOrWhiteSpace(returnUrl)
            && returnUrl.StartsWith("/driver/", StringComparison.Ordinal)
            && !returnUrl.StartsWith("//", StringComparison.Ordinal)
            && !returnUrl.Contains("://", StringComparison.Ordinal);
}
