@page "/shipper/sales/listings/new"
@inject SellerListingCreatePageViewModel ViewModel

<PageTitle>채널 출품 준비</PageTitle>

<header class="seller-page-header">
    <span class="seller-eyebrow">SELLER · LISTING PREPARATION</span>
    <h1>채널 출품 준비</h1>
    <p>판매상품 한 건과 판매채널 계정 한 건을 선택해 내부 준비 원장을 만듭니다.</p>
</header>

@if (ViewModel.IsBusy && ViewModel.Products.Count == 0)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (!string.IsNullOrWhiteSpace(ViewModel.StatusMessage))
    {
        <MudAlert Severity="@(ViewModel.HasError ? Severity.Error : Severity.Success)"
                  Variant="Variant.Outlined"
                  Class="mb-4">
            @ViewModel.StatusMessage
        </MudAlert>
    }

    @if (ViewModel.HasError)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@ViewModel.IsBusy" OnClick="ReloadAsync">
            출품 준비 다시 확인
        </MudButton>
    }
    else if (ViewModel.Products.Count == 0 || ViewModel.Accounts.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            판매상품과 판매채널 계정이 모두 있어야 출품 준비 원장을 만들 수 있습니다.
        </MudAlert>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
            @if (ViewModel.Products.Count == 0)
            {
                <MudButton Href="@SellerRoutes.Products" Variant="Variant.Outlined" Color="Color.Primary">판매상품 준비</MudButton>
            }
            @if (ViewModel.Accounts.Count == 0)
            {
                <MudButton Href="@SellerRoutes.SalesChannels" Variant="Variant.Outlined" Color="Color.Primary">판매채널 연결</MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@ViewModel.IsBusy" OnClick="ReloadAsync">준비 상태 다시 확인</MudButton>
        </MudStack>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="seller-form-card">
            <MudStack Spacing="3">
                <MudSelect T="long?" Label="판매상품" @bind-Value="ViewModel.SelectedProductId" Variant="Variant.Outlined">
                    @foreach (var product in ViewModel.Products)
                    {
                        <MudSelectItem T="long?" Value="@product.Id">@product.대표상품명 (@product.판매SKU)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="long?" Label="판매채널 계정" @bind-Value="ViewModel.SelectedAccountId" Variant="Variant.Outlined">
                    @foreach (var account in ViewModel.Accounts)
                    {
                        <MudSelectItem T="long?" Value="@account.Id">@account.채널종류 · @account.상점명</MudSelectItem>
                    }
                </MudSelect>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                    저장 결과는 내부 출품 준비 상태입니다. 외부 인증·상품 발행·주문 동기화는 실행하지 않습니다.
                </MudAlert>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@ViewModel.IsBusy"
                           OnClick="CreateAsync">
                    출품 준비 원장 저장
                </MudButton>
            </MudStack>
        </MudPaper>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "productId")]
    public long? ProductId { get; set; }

    private bool initialized;

    protected override async Task OnParametersSetAsync()
    {
        if (initialized)
        {
            return;
        }

        initialized = true;
        await ViewModel.LoadAsync(ProductId);
    }

    private Task CreateAsync() => ViewModel.CreateAsync();
    private Task ReloadAsync() => ViewModel.LoadAsync(ProductId);
}
