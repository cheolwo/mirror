@page "/shipper/sales/orders"
@implements IAsyncDisposable
@inject NavigationManager Navigation

<PageTitle>판매 주문 원장</PageTitle>

<header class="seller-page-header">
    <span class="seller-eyebrow">SELLER · PERSISTED ORDERS</span>
    <h1>판매 주문 원장</h1>
    <p>서버에 영속된 판매채널 출고 후보와 창고·운송 인계 상태를 30초 보완 조회로 확인합니다.</p>
</header>

<ShipperSalesOrderWorkspace @ref="workspace"
                            Mode="ShipperSalesOrderWorkspaceMode.List"
                            HomeHref="@SellerRoutes.Home" HomeLabel="판매자 홈으로"
                            PublicHref="@SellerRoutes.Home" PublicLabel="판매자 홈으로"
                            InitialSearch="@Context.Search"
                            InitialSyncScope="@Context.SyncScope"
                            InitialStatus="@Context.Status"
                            InitialPage="@Context.Page" />

@code {
    private readonly CancellationTokenSource monitorCancellation = new();
    private ShipperSalesOrderWorkspace? workspace;
    private bool disposed;
    private SalesOrderNavigationContext Context
        => SalesOrderNavigationContext.Parse(Navigation.Uri);

    protected override void OnInitialized()
        => _ = MonitorAsync(monitorCancellation.Token);

    private async Task MonitorAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (!disposed && !cancellationToken.IsCancellationRequested && workspace is not null)
                    {
                        await workspace.RefreshAsync(cancellationToken);
                    }
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (ObjectDisposedException) when (disposed)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        if (!disposed)
        {
            disposed = true;
            monitorCancellation.Cancel();
            monitorCancellation.Dispose();
        }
        return ValueTask.CompletedTask;
    }
}
