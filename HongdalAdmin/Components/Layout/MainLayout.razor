@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.Routing

<BackOfficeProviders />

<MudLayout>
    <MudAppBar Dense="true" Fixed="false" Elevation="0" Color="Color.Default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Disabled="@(!CanGoBack)" OnClick="GoBack" StartIcon="@Icons.Material.Filled.ArrowBack">뒤로가기</MudButton>
        <MudStack Spacing="0">
            <MudText Typo="Typo.subtitle1">살뜰 관리자</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">운영자 백오피스</MudText>
        </MudStack>
        <MudSpacer />
        <MudButton Href="https://learn.microsoft.com/aspnet/core/"
                   Target="_blank"
                   Variant="Variant.Text"
                   Color="Color.Inherit"
                   EndIcon="@Icons.Material.Filled.OpenInNew">
            About
        </MudButton>
    </MudAppBar>

    <MudDrawer Open="@_drawerOpen" Variant="DrawerVariant.Persistent" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly Stack<string> _navigationHistory = new();
    private string? _currentUri;
    private bool _isNavigatingBack;
    private bool _drawerOpen = true;

    private bool CanGoBack => _navigationHistory.Count > 0;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        _currentUri = NavigationManager.Uri;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void GoBack()
    {
        if (_navigationHistory.Count == 0)
        {
            return;
        }

        var previousUri = _navigationHistory.Pop();
        _isNavigatingBack = true;
        NavigationManager.NavigateTo(previousUri);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_isNavigatingBack)
        {
            _isNavigatingBack = false;
            _currentUri = args.Location;
            InvokeAsync(StateHasChanged);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_currentUri) && !string.Equals(_currentUri, args.Location, StringComparison.OrdinalIgnoreCase))
        {
            _navigationHistory.Push(_currentUri);
        }

        _currentUri = args.Location;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
