@inject ViewPolicyService ViewPolicyService
@inject NavigationManager NavigationManager

@if (isOutsideV1)
{
    <ViewAccessDenied ViewName="살뜰 외 관리자 화면" ShowPolicyButton="false" />
}
else if (!ViewPolicyService.IsLoaded)
{
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Class="pa-4">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </MudStack>
}
else if (blockedItem is not null)
{
    <ViewAccessDenied ViewName="@blockedItem.DisplayName" />
}
else
{
    <RouteView RouteData="RouteData" DefaultLayout="typeof(Layout.MainLayout)" />
    <FocusOnNavigate RouteData="RouteData" Selector="h1" />
}

@code {
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;

    private Hongdal.Contracts.Common.ViewSettings.View가시성항목응답? blockedItem;
    private bool isOutsideV1;

    protected override async Task OnParametersSetAsync()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        isOutsideV1 = !AdminV1NavigationPolicy.IsAllowedRoute(relativePath);
        if (isOutsideV1)
        {
            blockedItem = null;
            return;
        }

        await ViewPolicyService.EnsureLoadedAsync();
        blockedItem = ViewPolicyService.GetBlockingItem(relativePath);
    }
}
