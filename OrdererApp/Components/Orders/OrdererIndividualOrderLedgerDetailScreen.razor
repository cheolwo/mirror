<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudStack Spacing="3">
        @if (ShowHeading)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h4">주문 상세</MudText>
                </MudStack>
                <MudButton Href="/orders"
                           Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Filled.ArrowBack">
                    내 주문
                </MudButton>
            </MudStack>
        }

        <OrdererOrderAccessGate LoginTitle="주문 상세 로그인"
                                LoginDescription="본인 확인 후 주문 진행 정보를 불러옵니다."
                                LoginButtonText="로그인하고 주문 보기"
                                AuthenticationCheckMessage="주문자 로그인을 확인하고 있습니다.">
            <Authorized>
                <OrdererIndividualOrderLedgerDetail OrderLedgerId="@OrderLedgerId" />
            </Authorized>
        </OrdererOrderAccessGate>
    </MudStack>
</MudContainer>

@code {
    [Parameter, EditorRequired]
    public string OrderLedgerId { get; set; } = string.Empty;

    [Parameter]
    public bool ShowHeading { get; set; } = true;
}
