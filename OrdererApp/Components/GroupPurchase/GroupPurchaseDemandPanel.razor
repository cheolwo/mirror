@using Ssalddel.Contracts.Common.Orderer
@using Ssalddel.Contracts.Common.Operations
@using Ssalddel.Ui.Common.Areas.App.Services
@inject IGroupPurchaseShipmentTrackingService ShipmentTrackingService
@inject 주문자앱인증ViewModel Authentication

@if (_authenticationMode)
{
    <Ssalddel공통로그인Panel 제목="수요 원장 로그인"
                         설명="로그인 후 작성하던 모집권과 수요로 돌아갑니다. 수요 저장은 별도로 확인합니다."
                         상태메시지="@(Authentication.오류메시지 ?? (_authenticationRequired ? _statusMessage : null))"
                         상태Severity="@(_authenticationRequired ? Severity.Error : AuthenticationSeverity)"
                         일반로그인표시="true"
                         소셜로그인표시="false"
                         일반로그인버튼텍스트="로그인하고 수요 작성으로 돌아가기"
                         IsBusy="@Authentication.처리중"
                         Elevation="0"
                         Class="pa-3 group-demand-login"
                         OnPasswordLogin="LoginAsync">
        <MudButton FullWidth="true" Variant="Variant.Outlined" Disabled="@Authentication.처리중" OnClick="ReturnToDemandAsync">수요 작성으로 돌아가기</MudButton>
    </Ssalddel공통로그인Panel>
}
else
{
<MudStack Spacing="3">
    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <MudAlert Severity="@_statusSeverity" Variant="Variant.Outlined">@_statusMessage</MudAlert>
    }

    <MudGrid>
        <MudItem xs="12" md="@(ShowFlowSummary ? 7 : 12)">
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">1. 같은 상품·배송권 수요 등록</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                국가별 주소 서비스로 모집권 후보를 확인하고 직접 선택한 뒤 수요를 등록합니다.
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">@OperatingMarketLabel</MudChip>
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
                                @GroupPurchasePresentation.ApplicationStatusLabel(CurrentApplicationPlan.제안상태)
                            </MudChip>
                        </MudStack>
                    </MudStack>

                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        상세주소는 자동집단 원장에 저장하지 않습니다. 선택한 시·군·구 또는 미국 Census 모집권 키만 수요 묶음에 사용합니다.
                    </MudAlert>

                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudTextField T="string"
                                      Label="@DeliveryAddressLabel"
                                      @bind-Value="_deliveryAddressQuery"
                                      Placeholder="@DeliveryAddressPlaceholder"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      Class="flex-grow-1" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.MyLocation"
                                   Disabled="@(_isDeliveryScopeLoading || string.IsNullOrWhiteSpace(_deliveryAddressQuery))"
                                   OnClick="ResolveDeliveryScopesAsync">
                            @(_isDeliveryScopeLoading ? "확인 중" : "모집권 확인")
                        </MudButton>
                    </MudStack>

                    @if (_isDeliveryScopeLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }

                    @if (!string.IsNullOrWhiteSpace(_deliveryScopeMessage))
                    {
                        <MudAlert Severity="@_deliveryScopeSeverity" Variant="Variant.Outlined" Dense="true">
                            @_deliveryScopeMessage
                        </MudAlert>
                    }

                    @if (_deliveryScopePlan is { Success: true })
                    {
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2">2. 사용할 모집권 선택</MudText>
                            @foreach (var scope in _deliveryScopePlan.Items)
                            {
                                <MudPaper Elevation="0" Outlined="true" Class="@DeliveryScopeClass(scope)">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                <MudText Typo="Typo.subtitle2">@scope.DisplayName</MudText>
                                                @if (scope.IsRecommendedRecruitmentScope)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">권장</MudChip>
                                                }
                                                @if (scope.IsFineGrained)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">세부권</MudChip>
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @scope.ScopeKey · 공개 기준 @(scope.MinimumParticipantsForPublicDisplay)명 이상
                                            </MudText>
                                        </MudStack>
                                        <MudButton Variant="@(scope.ScopeKey == _groupScopeKey ? Variant.Filled : Variant.Outlined)"
                                                   Color="@(scope.ScopeKey == _groupScopeKey ? Color.Success : Color.Primary)"
                                                   Size="Size.Small"
                                                   OnClick="@(() => SelectDeliveryScope(scope))">
                                            @(scope.ScopeKey == _groupScopeKey ? "선택됨" : "이 범위 선택")
                                        </MudButton>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }

                    <MudDivider />

                    <MudText Typo="Typo.subtitle2">3. 수요 내용 확인</MudText>
                    <MudTextField T="string" Label="선택한 주문자 집단 범위" Value="@_groupScopeName" ReadOnly="true" Variant="Variant.Outlined" />
                    <MudNumericField T="decimal"
                                     Label="내 구매 의향 수량(kg)"
                                     Value="@DesiredQuantityKg"
                                     ValueChanged="UpdateDesiredQuantityAsync"
                                     Min="1"
                                     Step="1M"
                                     Variant="Variant.Outlined" />
                    <MudNumericField T="decimal"
                                     Label="희망 단가"
                                     Value="@DesiredUnitPrice"
                                     ValueChanged="UpdateDesiredUnitPriceAsync"
                                     Min="1"
                                     Step="100M"
                                     Variant="Variant.Outlined" />
                    <MudTextField T="string" Label="개설 신청 메모" @bind-Value="_requestMemo" Immediate="true" Lines="3" Variant="Variant.Outlined" />
                    <MudCheckBox T="bool"
                                 @bind-Value="_deliveryScopeConfirmed"
                                 Disabled="@string.IsNullOrWhiteSpace(_groupScopeKey)"
                                 Label="선택한 모집권으로 같은 상품 수요가 묶이는 것에 동의합니다."
                                 Color="Color.Success" />
                    <MudCheckBox T="bool"
                                 @bind-Value="_nonBindingAgreementAccepted"
                                 Label="이 신청은 구매 확정이 아니라 공동 주문 집단 개설 의향임을 확인합니다."
                                 Color="Color.Primary" />

                    @if (Authentication.처리중 && !Authentication.초기화됨)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                            <MudText Typo="Typo.body2">저장된 주문자 로그인 세션을 확인하고 있습니다.</MudText>
                        </MudStack>
                    }
                    else if (!Authentication.로그인됨 || _authenticationRequired)
                    {
                        <MudText Typo="Typo.body2">모집권 확인은 익명으로 할 수 있고, 수요를 본인 원장에 저장할 때만 로그인합니다.</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(Authentication.처리중 || _isSubmitting)" OnClick="OpenAuthenticationAsync">로그인하고 수요 등록 준비</MudButton>
                    }
                    else
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">
                                @Authentication.현재사용자표시
                            </MudChip>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="LogoutAsync">로그아웃</MudButton>
                        </MudStack>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Groups"
                               Disabled="@(!CanSubmitDemand || _isSubmitting)"
                               OnClick="SubmitDemandAsync">
                        @(_isSubmitting ? "저장 후 모집 현황 확인 중" : "비구속 수요 저장하고 모집 현황 보기")
                    </MudButton>

                    @if (!string.IsNullOrWhiteSpace(_registeredDemandSourceKey))
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Warning"
                                   Disabled="@(_isSubmitting || _authenticationRequired || !Authentication.로그인됨)"
                                   OnClick="WithdrawDemandAsync">
                            내 비구속 수요 철회
                        </MudButton>
                    }

                    @if (_registeredGroup is not null)
                    {
                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 group-demand-result">
                            <MudStack Spacing="1">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.subtitle2">서버에서 다시 읽은 자동집단</MudText>
                                    <MudChip T="string" Color="@GroupPurchasePresentation.AutoGroupStatusColor(_registeredGroup.현재상태)" Size="Size.Small">
                                        @GroupPurchasePresentation.AutoGroupStatusLabel(_registeredGroup.현재상태)
                                    </MudChip>
                                </MudStack>
                                <MudText Typo="Typo.body2">@_registeredGroup.상품명 · @_registeredGroup.배송권명</MudText>
                                <MudText Typo="Typo.h6">@_registeredGroup.수요건수.ToString("N0")건 · @_registeredGroup.총희망수량.ToString("N0")@_registeredGroup.수량단위</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    모집 마감 @GroupPurchasePresentation.DateLabel(_registeredGroup.모집종료시각Utc) · 조건 @(_registeredGroup.모집조건충족여부 ? "충족" : "미충족")
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">자동집단 @_registeredGroup.자동집단Id</MudText>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        @if (ShowFlowSummary)
        {
            <MudItem xs="12" md="5">
                <GroupPurchaseDemandFlowSummary RequiredAdminReviewSteps="CurrentApplicationPlan.RequiredAdminReviewSteps" />
            </MudItem>
        }
    </MudGrid>

</MudStack>
}

@code {
    private bool _authenticationMode;
    private bool _authenticationRequired;
    private readonly GroupPurchaseDemandSession _demand = new();
    private string _groupScopeKey => _demand.GroupScopeKey;
    private string _groupScopeName => _demand.GroupScopeName;
    private string _operatingMarketCode = OperatingMarketCodes.Korea;
    private string _deliveryAddressQuery = string.Empty;
    private OperatingMarketDeliveryScopePlan? _deliveryScopePlan => _demand.DeliveryScopePlan;
    private bool _isDeliveryScopeLoading => _demand.IsDeliveryScopeLoading;
    private string? _deliveryScopeMessage => _demand.DeliveryScopeMessage;
    private Severity _deliveryScopeSeverity => _demand.DeliveryScopeSeverity;
    private bool _deliveryScopeConfirmed { get => _demand.DeliveryScopeConfirmed; set => _demand.DeliveryScopeConfirmed = value; }
    private 공동구매자동집단요약응답? _registeredGroup => _demand.RegisteredGroup;
    private string _registeredDemandSourceKey => _demand.RegisteredDemandSourceKey;
    private string _requestMemo = "같은 지역 주문자들과 함께 먼저 수요를 모아보고 싶습니다.";
    private bool _nonBindingAgreementAccepted;
    private bool _isSubmitting => _demand.IsSubmitting;
    private string? _statusMessage { get => _demand.StatusMessage; set => _demand.StatusMessage = value; }
    private Severity _statusSeverity { get => _demand.StatusSeverity; set => _demand.StatusSeverity = value; }

    [Parameter, EditorRequired]
    public HS먹거리공동구매상품카드 Product { get; set; } = default!;

    [Parameter]
    public decimal DesiredQuantityKg { get; set; }

    [Parameter]
    public EventCallback<decimal> DesiredQuantityKgChanged { get; set; }

    [Parameter]
    public decimal DesiredUnitPrice { get; set; }

    [Parameter]
    public EventCallback<decimal> DesiredUnitPriceChanged { get; set; }

    [Parameter]
    public bool ShowFlowSummary { get; set; } = true;

    [Parameter]
    public EventCallback<bool> AuthenticationModeChanged { get; set; }

    private 주문자집단개설신청계획 CurrentApplicationPlan
        => 주문자집단개설신청계획기.계획(CreateApplicationDraft());

    private bool CanSubmitDemand
        => Authentication.로그인됨
           && !_authenticationRequired
           && _deliveryScopeConfirmed
           && !string.IsNullOrWhiteSpace(_groupScopeKey)
           && CurrentApplicationPlan.CanSubmit;

    private string OperatingMarketLabel
        => _operatingMarketCode == OperatingMarketCodes.UnitedStates
            ? "미국 · Census 모집권"
            : "한국 · 도로명주소/Naver·Kakao";

    private string DeliveryAddressLabel
        => _operatingMarketCode == OperatingMarketCodes.UnitedStates
            ? "배송지 주소(미국)"
            : "배송지 도로명주소(한국)";

    private string DeliveryAddressPlaceholder
        => _operatingMarketCode == OperatingMarketCodes.UnitedStates
            ? "예: 4600 Silver Hill Rd, Washington, DC"
            : "예: 경기도 수원시 영통구 ...";

    private string OrdererDisplayName
        => Authentication.로그인됨 ? Authentication.현재사용자표시 : "unconfirmed-orderer";

    private Severity AuthenticationSeverity
        => Authentication.오류발생 ? Severity.Error : Severity.Info;

    protected override void OnParametersSet() => _demand.ChangeProduct(Product.상품카드Id);

    protected override async Task OnInitializedAsync()
    {
        var authenticationTask = Authentication.초기화됨
            ? Task.FromResult(true)
            : Authentication.복원Async();
        await Task.WhenAll(LoadOperatingMarketAsync(), authenticationTask);
    }

    private async Task LoadOperatingMarketAsync()
    {
        var operatingMarket = await ShipmentTrackingService.GetOperatingMarketAsync();
        if (operatingMarket is not null &&
            OperatingMarketCodes.TryNormalize(operatingMarket.MarketCode, out var marketCode))
        {
            _operatingMarketCode = marketCode;
        }
    }

    private Task ResolveDeliveryScopesAsync()
        => _demand.ResolveDeliveryScopesAsync(_operatingMarketCode, _deliveryAddressQuery,
            request => ShipmentTrackingService.ResolveDeliveryScopesAsync(request));

    private void SelectDeliveryScope(OperatingMarketDeliveryScopeCandidate scope)
        => _demand.SelectDeliveryScope(scope);

    private Task UpdateDesiredQuantityAsync(decimal quantityKg)
        => DesiredQuantityKgChanged.InvokeAsync(quantityKg);

    private Task UpdateDesiredUnitPriceAsync(decimal unitPrice)
        => DesiredUnitPriceChanged.InvokeAsync(unitPrice);

    private async Task LoginAsync(공통로그인요청 request)
    {
        if (await Authentication.로그인Async(request.UserNameOrEmail, request.Password))
        {
            _authenticationRequired = false;
            _statusSeverity = Severity.Success;
            _statusMessage = "주문자 계정으로 로그인했습니다. 모집권 동의를 확인하면 수요를 등록할 수 있습니다.";
            await SetAuthenticationModeAsync(false);
        }
    }

    private Task OpenAuthenticationAsync() => SetAuthenticationModeAsync(true);
    private Task ReturnToDemandAsync() => SetAuthenticationModeAsync(false);

    private async Task SetAuthenticationModeAsync(bool authenticationMode)
    {
        if (Authentication.처리중) return;
        _authenticationMode = authenticationMode;
        await AuthenticationModeChanged.InvokeAsync(authenticationMode);
    }

    private async Task LogoutAsync()
    {
        await Authentication.로그아웃Async();
        _demand.ClearResult();
    }

    private async Task SubmitDemandAsync()
    {
        if (!Authentication.로그인됨 || _authenticationRequired)
        {
            _statusSeverity = Severity.Warning;
            _statusMessage = "수요를 본인 원장에 저장하려면 먼저 로그인해 주세요.";
            await OpenAuthenticationAsync();
            return;
        }

        if (string.IsNullOrWhiteSpace(_groupScopeKey) || !_deliveryScopeConfirmed)
        {
            _statusSeverity = Severity.Warning;
            _statusMessage = "주소로 모집권을 확인하고, 선택한 범위를 직접 동의해 주세요.";
            return;
        }

        if (!CurrentApplicationPlan.CanSubmit)
        {
            _statusSeverity = Severity.Warning;
            _statusMessage = "비구속 신청 동의와 HS 식품 코드 확인이 필요합니다.";
            return;
        }

        var demandSourceKey = CreateDemandSourceKey();
        if (!string.IsNullOrWhiteSpace(_registeredDemandSourceKey)
            && !string.Equals(_registeredDemandSourceKey, demandSourceKey, StringComparison.Ordinal))
        {
            _statusSeverity = Severity.Warning;
            _statusMessage = "현재 표시된 수요를 먼저 철회한 뒤 다른 상품 수요를 등록해 주세요.";
            return;
        }

        await _demand.RegisterDemandAsync(demandSourceKey,
            () => new 공동구매자동수요등록Command
            {
                수요출처키 = demandSourceKey,
                상품키 = Product.상품카드Id,
                상품명 = Product.상품명,
                HS코드 = Product.HS코드,
                온도코드 = Product.온도코드,
                물류방식 = Product.예상물류방식,
                주문자표시명 = Authentication.현재사용자표시,
                배송권키 = _groupScopeKey,
                배송권명 = _groupScopeName,
                희망수량 = DesiredQuantityKg,
                수량단위 = "kg",
                수요유형 = 공동구매자동수요유형코드.관심표시,
                결제상태 = 공동구매자동결제상태코드.미결제,
                메모 = _requestMemo,
                목표수량 = Product.SuggestedTargetQuantityKg
            },
            request => ShipmentTrackingService.RegisterDemandAsync(request),
            (productKey, scopeKey) => ShipmentTrackingService.ListGroupsAsync(productKey, scopeKey),
            () => Product,
            RequireAuthenticationAsync);
    }

    private async Task WithdrawDemandAsync()
    {
        if (string.IsNullOrWhiteSpace(_registeredDemandSourceKey) || _isSubmitting)
        {
            return;
        }

        if (!Authentication.로그인됨 || _authenticationRequired)
        {
            await OpenAuthenticationAsync();
            return;
        }

        await _demand.WithdrawDemandAsync(
            (sourceKey, reason) => ShipmentTrackingService.WithdrawDemandAsync(sourceKey, reason),
            (productKey, scopeKey) => ShipmentTrackingService.ListGroupsAsync(productKey, scopeKey),
            () => Product,
            RequireAuthenticationAsync);
    }

    private async Task RequireAuthenticationAsync()
    {
        _authenticationRequired = true;
        await OpenAuthenticationAsync();
    }

    private string CreateDemandSourceKey()
    {
        var userId = Authentication.세션.UserId
            ?? throw new InvalidOperationException("로그인 사용자 식별자를 찾을 수 없습니다.");
        return GroupPurchaseDemandSession.CreateDemandSourceKey(userId, Product.상품카드Id);
    }

    private 주문자집단개설신청초안 CreateApplicationDraft()
        => new(
            ApplicantOrdererId: OrdererDisplayName,
            상품카드: Product,
            주문자집단배송권키: string.IsNullOrWhiteSpace(_groupScopeKey)
                ? "unselected-delivery-scope"
                : _groupScopeKey,
            주문자집단배송권명: string.IsNullOrWhiteSpace(_groupScopeName)
                ? "모집권 미선택"
                : _groupScopeName,
            희망수량Kg: DesiredQuantityKg,
            DesiredUnitPrice: DesiredUnitPrice,
            NonBindingAgreementAccepted: _nonBindingAgreementAccepted,
            Request메모: _requestMemo);

    private string DeliveryScopeClass(OperatingMarketDeliveryScopeCandidate scope)
        => scope.ScopeKey == _groupScopeKey
            ? "delivery-scope-card delivery-scope-card--selected"
            : "delivery-scope-card";
}
