@using Ssalddel.Contracts.Common.Orderer
@using Ssalddel.Ui.Common.Areas.App.Services
@using Ssalddel.Ui.Common.Areas.App.ViewModels
@implements IAsyncDisposable
@inject I같이수입준비주문자Client ReadinessClient
@inject ISsalddel현재사용자Context CurrentUser

@if (string.IsNullOrWhiteSpace(AutoGroupId))
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        본인이 참여한 원천 자동집단 식별자가 필요합니다. 내 공동 진행 화면에서 다시 열어 주세요.
    </MudAlert>
}
else if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
        <MudStack Spacing="1">
            <MudText Typo="Typo.body2">@_error</MudText>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RetryAsync">
                다시 시도
            </MudButton>
        </MudStack>
    </MudAlert>
}
else if (_readiness is null)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        조회할 수 있는 같이 수입 준비 원장이 없습니다. 참여 원장과 준비 상태를 확인해 주세요.
    </MudAlert>
}
else
{
    <MudStack Spacing="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                서버 원장을 30초마다 다시 확인합니다.
            </MudText>
            @if (_lastLoadedAtUtc is not null)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    최근 확인 @_lastLoadedAtUtc.Value.ToLocalTime().ToString("HH:mm:ss")
                </MudText>
            }
        </MudStack>
        @if (!string.IsNullOrWhiteSpace(_backgroundWarning))
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                @_backgroundWarning
            </MudAlert>
        }
        @ChildContent(_readiness)
    </MudStack>
}

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);
    private OrdererGroupImportReadinessState _state = default!;
    private string? _loadedKey => _state.Key;
    private bool _isLoading => _state.IsLoading;
    private string? _error => _state.Error;
    private string? _backgroundWarning => _state.BackgroundWarning;
    private DateTime? _lastLoadedAtUtc => _state.LastLoadedAtUtc;
    private 같이수입준비주문자조회응답? _readiness => _state.Readiness;
    private bool _disposed;
    private CancellationTokenSource? _pollingCancellation;
    private Task? _pollingTask;

    [Parameter, EditorRequired] public string LedgerId { get; set; } = string.Empty;
    [Parameter] public string? AutoGroupId { get; set; }
    [Parameter, EditorRequired] public RenderFragment<같이수입준비주문자조회응답> ChildContent { get; set; } = default!;

    protected override void OnInitialized() => _state = new(ReadinessClient, () => CurrentUser.현재사용자.UserId);

    protected override async Task OnParametersSetAsync()
    {
        _state.SynchronizeOwner();
        var key = OrdererGroupImportReadinessState.SelectionKey(LedgerId, AutoGroupId);
        if (string.Equals(_loadedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        await LoadAsync(key);
        EnsurePolling();
    }

    private async Task RetryAsync()
        => await LoadAsync(OrdererGroupImportReadinessState.SelectionKey(LedgerId, AutoGroupId), force: true);

    private async Task LoadAsync(
        string key,
        bool force = false,
        bool preserveCurrentContent = false)
    {
        if (!force && string.Equals(_loadedKey, key, StringComparison.Ordinal))
        {
            return;
        }

        if (_disposed || key != OrdererGroupImportReadinessState.SelectionKey(LedgerId, AutoGroupId)) return;
        await _state.LoadAsync(LedgerId, AutoGroupId, force, preserveCurrentContent);
    }

    private void EnsurePolling()
    {
        if (_disposed || _pollingTask is not null)
        {
            return;
        }

        _pollingCancellation = new CancellationTokenSource();
        _pollingTask = PollAsync(_pollingCancellation.Token);
    }

    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    if (_disposed) return;
                    var key = OrdererGroupImportReadinessState.SelectionKey(LedgerId, AutoGroupId);
                    await LoadAsync(key, force: true, preserveCurrentContent: true);
                    if (!_disposed) StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _state.Dispose();
        _pollingCancellation?.Cancel();
        if (_pollingTask is not null)
        {
            try
            {
                await _pollingTask;
            }
            catch (OperationCanceledException)
            {
            }
        }

        _pollingCancellation?.Dispose();
        _pollingCancellation = null;
        _pollingTask = null;
    }
}
