@page "/"

<PageTitle>주문자 홈 · 살뜰 주문</PageTitle>

@if (EnforceFieldTestRoutes)
{
    <OrdererMobileHomeScreen ScreenCode="02.01" FoodFieldTestOnly="true" />
}
else
{
    <RolePurposeJourney RoleName="주문자"
                        Title="음식·마트·화물 주문을 한곳에서 확인합니다"
                        Description="필요한 주문 유형을 고르고 서버가 확정한 진행 상태와 원장을 다시 확인합니다."
                        Steps="@PurposeSteps"
                        BoundaryNote="상품 탐색과 화면 이동만으로 주문·결제·운송은 확정되지 않습니다." />

    <OrdererMobileHomeScreen ScreenCode="02.01" />

    <AppContextImageWall AppPackId="orderer"
                         Title="생산지와 장보기 이야기" />
}

@code {
    private static readonly IReadOnlyList<RolePurposeJourneyStep> PurposeSteps =
    [
        new("시작할 일", "음식점 찾기", "주문 가능한 음식점과 메뉴를 확인합니다.", OrdererRoutes.Restaurants, true),
        new("주문 선택", "음식 주문", "선택한 음식과 전달 정보를 확인한 뒤 주문합니다.", OrdererRoutes.Food),
        new("상품 선택", "살뜰마트", "도심 창고 재고 상품을 확인합니다.", OrdererRoutes.Mart),
        new("진행 확인", "음식 주문 내역", "서버가 확정한 주문·조리·배달 상태를 다시 조회합니다.", "/orders/food"),
        new("확인 필요", "화물·공산품 주문", "별도 운송이 필요한 주문 유형과 조건을 확인합니다.", OrdererRoutes.Cargo),
        new("완료 근거", "주문 원장", "명시적으로 확정된 주문 기록을 다시 조회합니다.", OrdererRoutes.Orders)
    ];

    private static bool EnforceFieldTestRoutes
    {
        get
        {
#if DEBUG
            return false;
#else
            return true;
#endif
        }
    }
}
