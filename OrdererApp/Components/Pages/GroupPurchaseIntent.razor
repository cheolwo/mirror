    protected override async Task OnInitializedAsync()
    {
        await LoadSelectedProductMarketSignal();
    }

    private async Task SelectProduct(string productCardId)
    {
        selectedProductCardId = productCardId;
        desiredQuantityKg = SelectedProduct.온도코드 == 공동구매온도코드.냉동 ? 20m : 5m;
        desiredUnitPrice = SelectedProduct.ExpectedUnitPrice;
        statusMessage = null;
        await LoadSelectedProductMarketSignal();
    }

    private async Task LoadSelectedProductMarketSignal()
    {
        isMarketSignalLoading = true;

        try
        {
            marketSignal = await ShipmentTrackingService.SimulateImportUnitPriceAsync(new HsCountryMonthlyTradeUnitPriceRequest
            {
                HsCode = SelectedProduct.HS코드,
                CountryCode = marketSignalCountryCode,
                Month = marketSignalMonth,
                LookbackMonths = 3,
                ExpectedFxRateKrwPerUsd = marketSignalFxRateKrwPerUsd,
                ExpectedPurchaseUnitPriceKrwPerKg = SelectedProduct.ExpectedUnitPrice,
                ExpectedDomesticLogisticsCostKrwPerKg = marketSignalDomesticLogisticsCostKrwPerKg,
                ExpectedSellingUnitPriceKrwPerKg = SelectedProduct.ExpectedUnitPrice * 1.35m,
                ParticipantQuantityKg = desiredQuantityKg
            });
        }
        finally
        {
            isMarketSignalLoading = false;
        }
    }

    private async Task SubmitOpeningApplication()
    {
        var plan = CurrentApplicationPlan;
        if (!plan.CanSubmit)
        {
            statusSeverity = Severity.Warning;
            statusMessage = "비구속 신청 동의와 HS 식품 코드 확인이 필요합니다.";
            return;
        }

        isOpeningApplicationSubmitting = true;
        try
        {
            var group = await ShipmentTrackingService.RegisterDemandAsync(new 공동구매자동수요등록Command
            {
                상품키 = SelectedProduct.상품카드Id,
                상품명 = SelectedProduct.상품명,
                HS코드 = SelectedProduct.HS코드,
                온도코드 = SelectedProduct.온도코드,
                물류방식 = SelectedProduct.예상물류방식,
                주문자키 = "demo-orderer",
                주문자표시명 = "데모 주문자",
                배송권키 = ordererGroupScopeKey,
                배송권명 = ordererGroupScopeName,
                희망수량 = desiredQuantityKg,
                수량단위 = "kg",
                수요유형 = 공동구매자동수요유형코드.관심표시,
                결제상태 = 공동구매자동결제상태코드.미결제,
                메모 = requestMemo
            });

            if (group is null)
            {
                statusSeverity = Severity.Error;
                statusMessage = "공동 주문 수요를 서버에 등록하지 못했습니다. 잠시 후 다시 시도해 주세요.";
                return;
            }

            statusSeverity = Severity.Success;
            statusMessage = $"{SelectedProduct.상품명} 수요가 자동 집단 {group.자동집단Id}에 등록되었습니다. 현재 {group.수요건수:N0}건, {group.총희망수량:N0}kg이 모였습니다.";
        }
        finally
        {
            isOpeningApplicationSubmitting = false;
        }
    }

    private async Task LookupShipmentTracking()
    {
        if (string.IsNullOrWhiteSpace(shipmentDocumentManagementNumber))
        {
            shipmentTracking = null;
            shipmentTrackingSeverity = Severity.Warning;
            shipmentTrackingMessage = "문서관리번호를 입력해 주세요.";
            return;
        }

        isShipmentTrackingLoading = true;
        shipmentTrackingMessage = null;

        try
        {
            shipmentTracking = await ShipmentTrackingService.LookupAsync(shipmentDocumentManagementNumber);
            if (shipmentTracking is null)
            {
                shipmentTrackingSeverity = Severity.Warning;
                shipmentTrackingMessage = "해당 문서관리번호로 조회 가능한 공동수입 선적 정보가 없습니다.";
                return;
            }

            shipmentTrackingSeverity = Severity.Success;
            shipmentTrackingMessage = $"{shipmentTracking.상품요약} 선적 정보를 조회했습니다.";
        }
        finally
        {
            isShipmentTrackingLoading = false;
        }
    }

