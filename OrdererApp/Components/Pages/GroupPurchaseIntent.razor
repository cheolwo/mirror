@page "/group-purchase"
@using Hongdal.Contracts.Common.Orderer
@using Hongdal.Contracts.Common.PublicData
@inject IGroupPurchaseShipmentTrackingService ShipmentTrackingService

<PageTitle>먹거리 공동수입</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4 group-purchase-page">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">먹거리 공동수입</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    HS 코드상 식품으로 분류되는 상품 카드를 보고, 주문자가 직접 공동 주문 집단 개설을 신청합니다.
                </MudText>
            </MudStack>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">HS 식품 코드 우선</MudChip>
        </MudStack>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <MudAlert Severity="@statusSeverity" Variant="Variant.Outlined">@statusMessage</MudAlert>
        }

        <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">공동수입 화물 위치 조회</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            플랫폼에 등록된 문서관리번호로 B/L 또는 AWB 기준 선적 상태와 공개 위치 이력을 확인합니다.
                        </MudText>
                    </MudStack>
                    @if (shipmentTracking is not null)
                    {
                        <MudChip T="string" Color="@ShipmentStatusColor(shipmentTracking.현재상태코드)" Variant="Variant.Filled">
                            @ShipmentStatusLabel(shipmentTracking.현재상태코드)
                        </MudChip>
                    }
                </MudStack>

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudTextField T="string"
                                  Label="문서관리번호"
                                  @bind-Value="shipmentDocumentManagementNumber"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Class="flex-grow-1" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               Disabled="@isShipmentTrackingLoading"
                               OnClick="LookupShipmentTracking">
                        조회
                    </MudButton>
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(shipmentTrackingMessage))
                {
                    <MudAlert Severity="@shipmentTrackingSeverity" Variant="Variant.Outlined">@shipmentTrackingMessage</MudAlert>
                }

                @if (shipmentTracking is not null)
                {
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">현재 위치</MudText>
                                <MudText Typo="Typo.subtitle1">@shipmentTracking.현재위치요약</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">운송 문서</MudText>
                                <MudText Typo="Typo.subtitle1">@TransportDocumentLabel(shipmentTracking.운송문서유형) @shipmentTracking.운송문서번호</MudText>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">도착 예정</MudText>
                                <MudText Typo="Typo.subtitle1">@DateLabel(shipmentTracking.예상도착시각Utc)</MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="2">
                        @foreach (var item in shipmentTracking.이벤트목록.OrderByDescending(x => x.발생시각Utc))
                        {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                    <MudStack Spacing="0">
                                        <MudText Typo="Typo.subtitle2">@item.표시명</MudText>
                                        <MudText Typo="Typo.body2">@item.위치요약</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.출처주체코드</MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@DateLabel(item.발생시각Utc)</MudText>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                }
            </MudStack>
        </MudPaper>

        <MudGrid>
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                    <MudStack Spacing="3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">HS 먹거리 상품 카드</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                먼저 먹거리 수요가 모이기 쉬운 상품부터 공동주문 후보로 노출합니다.
                            </MudText>
                        </MudStack>

                        @foreach (var product in ProductCards)
                        {
                            var plan = PlanProduct(product);
                            <MudPaper Elevation="0" Outlined="true" Class="@ProductCardClass(product)">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle1">@product.상품명</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">HS @product.HS코드 · @product.HS표시명</MudText>
                                        </MudStack>
                                        <MudChip T="string" Size="Size.Small" Color="@PriorityColor(plan.활성화우선순위)">
                                            @PriorityLabel(plan.활성화우선순위)
                                        </MudChip>
                                    </MudStack>

                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@TemperatureLabel(product.온도코드)</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@product.예상물류방식</MudChip>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@($"{product.SuggestedTargetQuantityKg:N0}kg 목표")</MudChip>
                                    </MudStack>

                                    <MudText Typo="Typo.body2">@plan.요약</MudText>

                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Groups"
                                               OnClick="@(() => SelectProduct(product.상품카드Id))">
                                        이 상품으로 집단 개설 신청
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        }
                    </MudStack>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" lg="8">
                <MudStack Spacing="3">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h5">@SelectedProduct.상품명 공동 주문 집단</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        개설 신청이 승인되면 같은 주문자 집단 범위 안의 다른 사용자들이 참여할 수 있습니다.
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Color="@PriorityColor(CurrentApplicationPlan.IsFoodFocusedCandidate ? 공동구매활성화우선순위코드.냉장냉동먹거리중심 : 공동구매활성화우선순위코드.일반)"
                                         Variant="Variant.Filled">
                                    @StatusLabel(CurrentApplicationPlan.제안상태)
                                </MudChip>
                            </MudStack>

                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">HS 코드</MudText>
                                        <MudText Typo="Typo.h6">@SelectedProduct.HS코드</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">예상 물류</MudText>
                                        <MudText Typo="Typo.h6">@SelectedProduct.예상물류방식</MudText>
                                    </MudPaper>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">예상 단가</MudText>
                                        <MudText Typo="Typo.h6">@Money(SelectedProduct.ExpectedUnitPrice)</MudText>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle2">HS import price signal</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                HS + country + month customs statistics are used as a market reference.
                                            </MudText>
                                        </MudStack>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.QueryStats"
                                                   Disabled="@isMarketSignalLoading"
                                                   OnClick="LoadSelectedProductMarketSignal">
                                            Refresh
                                        </MudButton>
                                    </MudStack>

                                    @if (isMarketSignalLoading)
                                    {
                                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                                    }
                                    else if (marketSignal is not null && marketSignal.Success)
                                    {
                                        <MudGrid>
                                            <MudItem xs="12" sm="3">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Avg import</MudText>
                                                <MudText Typo="Typo.subtitle1">@UsdPerKg(marketSignal.AverageImportUnitValueUsdPerKg)</MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="3">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">KRW estimate</MudText>
                                                <MudText Typo="Typo.subtitle1">@KrwPerKg(marketSignal.AverageImportUnitValueKrwPerKg)</MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="3">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Landed cost</MudText>
                                                <MudText Typo="Typo.subtitle1">@KrwPerKg(marketSignal.ExpectedLandedCostKrwPerKg)</MudText>
                                            </MudItem>
                                            <MudItem xs="12" sm="3">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">Signal</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@MarketSignalColor(marketSignal.PriceSignalCode)">
                                                    @marketSignal.PriceSignalCode
                                                </MudChip>
                                            </MudItem>
                                        </MudGrid>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@marketSignal.Summary</MudText>
                                    }
                                    else
                                    {
                                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                                            @(marketSignal?.Summary ?? "No customs import price signal has been loaded yet.")
                                        </MudAlert>
                                    }
                                </MudStack>
                            </MudPaper>

                            <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                        <MudStack Spacing="0">
                                            <MudText Typo="Typo.subtitle2">Import landed cost path</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                From overseas seller payment to domestic 3PL inbound, each estimated cost is shown as a separate step.
                                            </MudText>
                                        </MudStack>
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                                            @KrwPerKg(LandedCostPlan.예상도착단가Krw)
                                        </MudChip>
                                    </MudStack>

                                    <MudGrid>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">Approx. CIF</MudText>
                                            <MudText Typo="Typo.subtitle1">@KrwPerKg(LandedCostPlan.예상Cif단가Krw)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">After tax</MudText>
                                            <MudText Typo="Typo.subtitle1">@KrwPerKg(LandedCostPlan.예상세후단가Krw)</MudText>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">3PL inbound total</MudText>
                                            <MudText Typo="Typo.subtitle1">@KrwTotal(LandedCostPlan.예상도착총액Krw)</MudText>
                                        </MudItem>
                                    </MudGrid>

                                    <MudStack Spacing="1">
                                        @foreach (var stage in LandedCostPlan.단계목록)
                                        {
                                            <MudPaper Elevation="0" Outlined="true" Class="pa-2">
                                                <MudStack Spacing="1">
                                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                                        <MudStack Spacing="0">
                                                            <MudText Typo="Typo.body2">@(stage.순서). @stage.표시명</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@stage.설명</MudText>
                                                        </MudStack>
                                                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                                                            <MudText Typo="Typo.body2">@KrwPerKg(stage.단가Krw)</MudText>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">acc. @KrwPerKg(stage.Accumulated단가Krw)</MudText>
                                                        </MudStack>
                                                    </MudStack>
                                                    <MudProgressLinear Color="@CostStageColor(stage.상태코드)"
                                                                       Value="@CostStagePercent(stage)"
                                                                       Rounded="true" />
                                                </MudStack>
                                            </MudPaper>
                                        }
                                    </MudStack>

                                    @foreach (var warning in LandedCostPlan.경고목록)
                                    {
                                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@warning</MudAlert>
                                    }
                                </MudStack>
                            </MudPaper>
                        </MudStack>
                    </MudPaper>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                                <MudStack Spacing="3">
                                    <MudText Typo="Typo.h6">집단 개설 신청</MudText>
                                    <MudTextField T="string" Label="주문자 집단 범위" @bind-Value="ordererGroupScopeName" Variant="Variant.Outlined" />
                                    <MudNumericField T="decimal" Label="내 구매 의향 수량(kg)" @bind-Value="desiredQuantityKg" Min="1" Step="1M" Variant="Variant.Outlined" />
                                    <MudNumericField T="decimal" Label="희망 단가" @bind-Value="desiredUnitPrice" Min="1" Step="100M" Variant="Variant.Outlined" />
                                    <MudTextField T="string" Label="개설 신청 메모" @bind-Value="requestMemo" Lines="3" Variant="Variant.Outlined" />
                                    <MudCheckBox T="bool"
                                                 @bind-Value="nonBindingAgreementAccepted"
                                                 Label="이 신청은 구매 확정이 아니라 공동 주문 집단 개설 의향임을 확인합니다."
                                                 Color="Color.Primary" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Send"
                                               Disabled="@(!CurrentApplicationPlan.CanSubmit || isOpeningApplicationSubmitting)"
                                               OnClick="SubmitOpeningApplication">
                                        @(isOpeningApplicationSubmitting ? "등록 중" : "개설 승인 요청")
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4 h-100">
                                <MudStack Spacing="3">
                                    <MudText Typo="Typo.h6">승인 후 참여 흐름</MudText>
                                    <MudList T="string" Dense="true">
                                        <MudListItem Icon="@Icons.Material.Filled.Inventory2">
                                            상품 카드와 HS 식품 코드 검토
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.Map">
                                            주문자 집단 범위 승인
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.GroupAdd">
                                            공동 주문 집단 생성
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.ShoppingCart">
                                            다른 주문자의 구매 의향 참여
                                        </MudListItem>
                                        <MudListItem Icon="@Icons.Material.Filled.AcUnit">
                                            냉장/냉동 보관 및 운송 검토
                                        </MudListItem>
                                    </MudList>

                                    <MudDivider />

                                    <MudText Typo="Typo.subtitle2">운영 검토 항목</MudText>
                                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                                        @foreach (var step in CurrentApplicationPlan.RequiredAdminReviewSteps)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@step</MudChip>
                                        }
                                    </MudStack>
                                </MudStack>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>

                    <MudPaper Elevation="0" Outlined="true" Class="pa-4">
                        <MudStack Spacing="3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">공동수입 지급 일정</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        전액 선결제 대신 상차, 하차, 분배 확인 시점에 맞춰 나누어 지급합니다.
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                                    @PaymentPlan.요약
                                </MudChip>
                            </MudStack>

                            <MudGrid>
                                @foreach (var line in PaymentPlan.라인목록)
                                {
                                    <MudItem xs="12" md="4">
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                                    <MudText Typo="Typo.subtitle2">@line.표시명</MudText>
                                                    <MudChip T="string" Size="Size.Small" Color="@PaymentStatusColor(line.상태)">
                                                        @PaymentStatusLabel(line.상태)
                                                    </MudChip>
                                                </MudStack>
                                                <MudText Typo="Typo.h6">@Money(line.금액)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@line.지급조건</MudText>
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudStack>
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudContainer>

<style>
    .group-purchase-page .product-card {
        border-radius: 8px;
        transition: border-color 120ms ease, background-color 120ms ease;
    }

    .group-purchase-page .product-card--selected {
        border-color: var(--mud-palette-primary);
        background: color-mix(in srgb, var(--mud-palette-surface) 88%, var(--mud-palette-primary) 12%);
    }
</style>

@code {
    private readonly List<HS먹거리공동구매상품카드> ProductCards =
    [
        new(
            상품카드Id: "hs-food-0203-pork-frozen",
            상품명: "냉동 삼겹살",
            HS코드: "0203.29",
            HS표시명: "돼지고기 냉동 기타",
            온도코드: 공동구매온도코드.냉동,
            예상물류방식: 공동구매물류방식코드.FCL,
            SuggestedTargetQuantityKg: 12000m,
            ExpectedUnitPrice: 8500m),
        new(
            상품카드Id: "hs-food-1602-prepared-meat",
            상품명: "가공육 세트",
            HS코드: "1602.49",
            HS표시명: "조제 또는 저장 처리한 육류",
            온도코드: 공동구매온도코드.냉장,
