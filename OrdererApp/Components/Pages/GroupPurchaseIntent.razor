    private double CostStagePercent(수입도착원가단계 stage)
    {
        if (LandedCostPlan.예상도착단가Krw <= 0)
        {
            return 0;
        }

        return decimal.ToDouble(decimal.Round(stage.Accumulated단가Krw / LandedCostPlan.예상도착단가Krw * 100m, 2));
    }

