@page "/food/mart/order"
@page "/food/mart/order/{ProductId:long}"
@implements IDisposable
@inject NavigationManager Navigation
@using Ssalddel.Contracts.Common.Mart

<PageTitle>@(_authenticationMode ? "주문 요청 로그인" : "알뜰살뜰 마트 주문 요청")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MartProductAccessFrame Context="@Context"
                            CurrentScreen="MartProductScreenKind.Order"
                            ProductId="@EffectiveProductId"
                            Eyebrow="@(_authenticationMode ? "LOGIN" : "ORDER REQUEST")"
                            Title="@(_authenticationMode ? "주문 요청 로그인" : "알뜰살뜰 마트 주문 요청")"
                            Description="@(_authenticationMode ? "로그인하면 선택한 상품의 주문 요청을 이어갈 수 있습니다." : "선택한 공개 상품 한 건의 비구속 주문 의향만 저장하고 같은 요청 ID를 다시 확인합니다.")"
                            AuthenticationOnly="@_authenticationMode"
                            HomeHref="@OrdererRoutes.Food">
        <OrdererMartOrderRequestWorkspace ProductId="@EffectiveProductId"
                                          RequestId="@RequestId"
                                          CatalogHref="@Context.PathFor(MartProductScreenKind.List)"
                                          AuthenticationModeChanged="OnAuthenticationModeChanged"
                                          RequestSelected="OnRequestSelectedAsync" />
    </MartProductAccessFrame>
</MudContainer>

@code {
    private bool _authenticationMode = true;
    private bool _disposed;
    private OrdererPageDisplayContext.PageLease? _displayLease;

    [CascadingParameter]
    public OrdererPageDisplayContext? DisplayContext { get; set; }

    private void OnAuthenticationModeChanged(bool authenticationMode)
    {
        if (_disposed || _displayLease is { IsCurrent: false }) return;
        _authenticationMode = authenticationMode;
        _displayLease?.SetAuthenticationMode(authenticationMode);
    }

    [Parameter] public long? ProductId { get; set; }

    [SupplyParameterFromQuery(Name = "productId")]
    public long? LegacyProductId { get; set; }

    [SupplyParameterFromQuery(Name = "requestId")]
    public Guid? RequestId { get; set; }

    private long? EffectiveProductId => ProductId is > 0 ? ProductId : LegacyProductId;

    private MartProductNavigationContext Context
        => MartProductNavigationContext.Parse(Navigation.Uri);

    protected override void OnParametersSet()
    {
        if (_disposed) return;
        if (DisplayContext is not null && _displayLease?.IsFor(Navigation.Uri) != true)
        {
            _displayLease?.Dispose();
            _displayLease = DisplayContext.Acquire(_authenticationMode, Navigation.Uri);
        }
        if (ProductId is not > 0 && LegacyProductId is > 0)
        {
            var target = Context.PathFor(MartProductScreenKind.Order, LegacyProductId);
            Navigation.NavigateTo(AppendRequestId(target, RequestId), replace: true);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        _displayLease?.Dispose();
    }

    private Task OnRequestSelectedAsync(Guid? requestId)
    {
        if (_disposed || _displayLease is { IsCurrent: false })
        {
            return Task.CompletedTask;
        }

        var target = EffectiveProductId is > 0
            ? Context.PathFor(MartProductScreenKind.Order, EffectiveProductId)
            : MartProductPageRoutes.OrderRoot;
        Navigation.NavigateTo(AppendRequestId(target, requestId), replace: true);
        return Task.CompletedTask;
    }

    private static string AppendRequestId(string path, Guid? requestId)
    {
        if (!requestId.HasValue)
        {
            return path;
        }

        var separator = path.Contains('?', StringComparison.Ordinal) ? '&' : '?';
        return $"{path}{separator}requestId={requestId.Value:D}";
    }
}
