@page "/food"

<PageTitle>음식 주문</PageTitle>

<main class="food-order-home">
    <header class="food-order-home__hero">
        <span>FOOD &amp; GROCERY</span>
        <h1>무엇을 주문할까요?</h1>
        <p>
                @(EnforceFieldTestRoutes
                    ? "음식점을 찾고 주문 내역을 확인하세요."
                    : "음식점과 살뜰마트에서 원하는 메뉴를 찾아보세요.")
        </p>
    </header>

    <section class="food-order-home__choices" aria-label="주문 유형 선택">
        <article class="food-order-choice food-order-choice--restaurant">
            <div class="food-order-choice__icon"><MudIcon Icon="@Icons.Material.Filled.RamenDining" /></div>
            <span>따뜻한 한 끼</span>
            <h2>음식점에서 주문</h2>
            <p>가까운 가게의 메뉴를 둘러보고 바로 주문하세요.</p>
            <MudButton Href="@OrdererRoutes.Restaurants" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">음식점 보기</MudButton>
            <MudButton Href="/orders/food" Variant="Variant.Text" Color="Color.Primary">주문 내역</MudButton>
        </article>

        <article class="food-order-choice food-order-choice--mart">
            <div class="food-order-choice__icon"><MudIcon Icon="@Icons.Material.Filled.Storefront" /></div>
            <span>생활에 필요한 것</span>
            <h2>살뜰마트에서 주문</h2>
            <p>장보기 상품을 한 번에 담고 편하게 받아보세요.</p>
                        @if (EnforceFieldTestRoutes)
                        {
                <span class="food-order-choice__soon">준비 중</span>
                        }
                        else
                        {
                <MudButton Href="@OrdererRoutes.Mart" Variant="Variant.Filled" Color="Color.Success" EndIcon="@Icons.Material.Filled.ArrowForward">살뜰마트 보기</MudButton>
                        }
        </article>
    </section>
</main>

@code {
    private static bool EnforceFieldTestRoutes
    {
        get
        {
#if DEBUG
            return false;
#else
            return true;
#endif
        }
    }
}
