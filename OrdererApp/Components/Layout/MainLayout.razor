@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="orderer-mobile-shell">
    <header class="orderer-mobile-shell__appbar">
        <button type="button"
                class="orderer-mobile-shell__icon-button"
                aria-label="주문자 메뉴 열기"
                aria-expanded="@_drawerOpen"
                @onclick="ToggleDrawer">
            <MudIcon Icon="@Icons.Material.Filled.Menu" />
        </button>
        <a class="orderer-mobile-shell__brand" href="@OrdererRoutes.Home">
            <span class="orderer-mobile-shell__brand-mark">ㅅ</span>
            <span>살뜰</span>
        </a>
        <span class="orderer-mobile-shell__spacer"></span>
        <span class="orderer-mobile-shell__scope">음식 · 마트 · 화물 주문</span>
        <RoleAppLifecycleIndicator />
        <span class="orderer-mobile-shell__avatar" aria-label="주문자">O</span>
    </header>

    <MobileFieldTestBanner AppVersion="0.1.0" />

    @if (_drawerOpen)
    {
        <button type="button"
                class="orderer-mobile-shell__backdrop"
                aria-label="주문자 메뉴 닫기"
                @onclick="CloseDrawer"></button>
        <aside class="orderer-mobile-shell__drawer" aria-label="주문자 메뉴">
            <header>
                <div>
                    <strong>살뜰 주문</strong>
                    <span>내 주문과 진행 상태</span>
                </div>
                <button type="button" aria-label="메뉴 닫기" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </header>
            <nav>
                @if (EnforceFieldTestRoutes)
                {
                    <a href="@OrdererRoutes.Food" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.Restaurant" />
                        음식 주문
                    </a>
                    <a href="@OrdererRoutes.Restaurants" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.Map" />
                        음식점 찾기
                    </a>
                    <a href="/orders/food" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                        음식 주문 내역
                    </a>
                }
                else
                {
                    <a href="@OrdererRoutes.Home" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.Home" />
                        주문자 홈
                    </a>
                    <a href="@OrdererRoutes.Food" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.Restaurant" />
                        음식 주문
                    </a>
                    <a href="@OrdererRoutes.Restaurants" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.Map" />
                        음식점 찾기
                    </a>
                    <a href="@OrdererRoutes.Mart" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.Storefront" />
                        살뜰마트
                    </a>
                    <a href="@OrdererRoutes.Cargo" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                        화물·공산품 주문
                    </a>
                    <a href="@OrdererRoutes.Orders" @onclick="CloseDrawer">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                        주문 원장
                    </a>
                }
            </nav>
            <aside>
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                화면은 서버가 확정한 주문 상태를 표시하며 결제·계약·수입 실행과 분리됩니다.
            </aside>
        </aside>
    }

    <section class="orderer-mobile-shell__content">
        @Body
    </section>

    @if (EnforceFieldTestRoutes)
    {
        <footer class="orderer-mobile-shell__bottom-nav">
            <a class="orderer-mobile-shell__bottom-link" href="@OrdererRoutes.Food">
                <MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small" />
                <span>주문</span>
            </a>
            <a class="orderer-mobile-shell__bottom-link" href="@OrdererRoutes.Restaurants">
                <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" />
                <span>음식점</span>
            </a>
            <a class="orderer-mobile-shell__bottom-link" href="/orders/food">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
                <span>내역</span>
            </a>
        </footer>
    }
    else
    {
    <footer class="orderer-mobile-shell__bottom-nav">
        <a class="@BuildBottomLinkClass(BottomDestination.Home)"
           href="@OrdererRoutes.Home"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Home) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
            <span>홈</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Food)"
           href="@OrdererRoutes.Food"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Food) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.Restaurant" Size="Size.Small" />
            <span>음식</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Mart)"
           href="@OrdererRoutes.Mart"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Mart) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
            <span>마트</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Ledgers)"
           href="@OrdererRoutes.Orders"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Ledgers) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Small" />
            <span>원장</span>
        </a>
    </footer>
    }
</div>

@code {
    private bool _drawerOpen;

    private static bool EnforceFieldTestRoutes
    {
        get
        {
#if DEBUG
            return false;
#else
            return true;
#endif
        }
    }

    protected override void OnInitialized()
        => Navigation.LocationChanged += HandleLocationChanged;

    private string CurrentPath
        => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/') is { Length: > 0 } path
            ? path
            : "/";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void CloseDrawer() => _drawerOpen = false;

    private bool IsBottomDestinationActive(BottomDestination destination)
        => destination switch
        {
            BottomDestination.Food =>
                CurrentPath.StartsWith(OrdererRoutes.Food, StringComparison.OrdinalIgnoreCase),
            BottomDestination.Mart =>
                CurrentPath.StartsWith(OrdererRoutes.Mart, StringComparison.OrdinalIgnoreCase),
            BottomDestination.Ledgers =>
                CurrentPath.StartsWith(OrdererRoutes.Orders, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith("/trade", StringComparison.OrdinalIgnoreCase),
            _ => string.Equals(CurrentPath, OrdererRoutes.Home, StringComparison.OrdinalIgnoreCase)
        };

    private string BuildBottomLinkClass(BottomDestination destination)
        => IsBottomDestinationActive(destination)
            ? "orderer-mobile-shell__bottom-link orderer-mobile-shell__bottom-link--active"
            : "orderer-mobile-shell__bottom-link";

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _drawerOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
        => Navigation.LocationChanged -= HandleLocationChanged;

    private enum BottomDestination
    {
        Home,
        Food,
        Mart,
        Ledgers
    }
}
