<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <!-- Keep generated .cs and assemblies outside the UPM package scanned by Unity. -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)../artifacts/local/mobile-game-core-build/$(MSBuildProjectName)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)../artifacts/local/mobile-game-core-build/$(MSBuildProjectName)/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
</Project>
