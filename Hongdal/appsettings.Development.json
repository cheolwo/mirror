{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "server=mysql;port=3306;database=hongdal_dev;user=hongdal;password=YOUR_LOCAL_PASSWORD;"
  },
  "DatabaseInitialization": {
    "RunAtStartup": true,
    "FailOnError": true
  },
  "TransientState": {
    "Provider": "Memory"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:16379"
  },
  "MongoDb": {
    "ConnectionString": "",
    "Database": "hongdal_dev"
  },
  "VersionFeatureFlags": {
    "GroupPurchaseImportWorkflow": true
  },
  "CustomsBrokerCors": {
    "AllowedOrigins": [
      "http://localhost:5087",
      "http://localhost:5238",
      "http://127.0.0.1:5238",
      "https://localhost:7139"
    ]
  },
  "GoogleGeocodingApiKey": "",
  "Jwt": {
    "Issuer": "Hongdal.Dev",
    "Audience": "Hongdal.Client.Dev",
    "SecretKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "TossPayments": {
    "ClientKey": "",
    "SecretKey": "",
    "BaseUrl": "https://api.tosspayments.com"
  },
  "GoogleCloudStorage": {
    "BucketName": "your-dev-bucket-name",
    "ServiceAccountJsonPath": "",
    "PublicBaseUrl": "https://storage.googleapis.com"
  },
  "PushNotifications": {
    "ProjectId": "",
    "ServiceAccountJsonPath": "",
    "ServerKey": "",
    "DefaultTitle": "홍달 추천 알림",
    "DefaultBodyPrefix": "추천 목록이 업데이트되었습니다."
  },
  "HongikHakdangCards": {
    "PublicBaseUrl": "https://localhost:7117"
  },
  "CommunityPostStorage": {
    "Folder": "community/dev-posts",
    "MaxImageBytes": 5242880,
    "MaxAttachmentsPerPost": 5,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif"
    ]
  },
  "NaverCloudDirections": {
    "BaseUrl": "https://maps.apigw.ntruss.com",
    "Path": "/map-direction/v1/driving",
    "ApiKeyId": "",
    "ApiKey": "",
    "DefaultOption": "trafast"
  },
  "Opinet": {
    "BaseUrl": "https://www.opinet.co.kr",
    "AveragePricePath": "/api/avgAllPrice.do",
    "CertKey": "",
    "OutputFormat": "xml"
  },
  "NtsBusinessRegistration": {
    "BaseUrl": "https://api.odcloud.kr/api/nts-businessman/v1",
    "StatusPath": "/status",
    "ServiceKey": ""
  },
  "DriverUsagePolicy": {
    "무료배차": false,
    "기본이용료": 500,
    "월상한이용료": 5000
  },
  "SalesChannelOrderSync": {
    "Enabled": true,
    "DomesticSyncIntervalSeconds": 300,
    "OverseasSyncIntervalSeconds": 600,
    "LookbackMinutes": 120,
    "BatchSize": 100
  },
  "WorkRelationshipSnapshots": {
    "Enabled": true
  },
  "CommandProcessing": {
    "Defaults": {
      "AuditLogEnabled": true,
      "WorkRelationshipSnapshotEnabled": false,
      "SmsEnabled": false,
      "SnsEnabled": false,
      "PushEnabled": false,
      "EventName": "CommandHandled",
      "Target": ""
    },
    "Commands": {
      "배차수락Command": {
        "AuditLogEnabled": true,
        "WorkRelationshipSnapshotEnabled": false,
        "PushEnabled": true,
        "EventName": "DispatchAccepted",
        "Target": "Driver"
      },
      "배차거절Command": {
        "AuditLogEnabled": true,
        "EventName": "DispatchRejected",
        "Target": "Driver"
      },
      "운송상차지도착Command": {
        "AuditLogEnabled": true,
        "EventName": "TransportArrivedPickup",
        "Target": "Driver"
      },
      "운송상차완료Command": {
        "AuditLogEnabled": true,
        "PushEnabled": true,
        "EventName": "TransportPickupCompleted",
        "Target": "Driver"
      },
      "운송하차지도착Command": {
        "AuditLogEnabled": true,
        "EventName": "TransportArrivedDropoff",
        "Target": "Driver"
      },
      "운송인수완료Command": {
        "AuditLogEnabled": true,
        "SmsEnabled": true,
        "PushEnabled": true,
        "EventName": "TransportCompleted",
        "Target": "Driver"
      },
      "운송문제신고Command": {
        "AuditLogEnabled": true,
        "SmsEnabled": true,
        "SnsEnabled": true,
        "EventName": "TransportIssueReported",
        "Target": "Admin"
      }
    }
  },
  "CommandFileStorage": {
    "RootFolder": "uploads",
    "DefaultCommand": {
      "Folder": "commands",
      "IncludeRequestIdSegment": true
    },
    "AdminFilePod": {
      "Folder": "admin/files-pod",
      "IncludeRequestIdSegment": true
    },
    "Commands": {
      "배차수락Command": {
        "Folder": "driver/dispatch/accepted"
      },
      "배차거절Command": {
        "Folder": "driver/dispatch/rejected"
      },
      "운송상차완료Command": {
        "Folder": "driver/transport/pickup-completed"
      },
      "TransportPickupComplete": {
        "Folder": "driver/transport/pickup-completed"
      },
      "운송인수완료Command": {
        "Folder": "driver/transport/completed"
      },
      "TransportDropoffComplete": {
        "Folder": "driver/transport/completed"
      },
      "운송문제신고Command": {
        "Folder": "driver/transport/issues"
      }
    }
  }
}
