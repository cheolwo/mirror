@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<CascadingValue Value="_displayContext" IsFixed="true">
<div class="@(_displayContext.AuthenticationOnly ? "warehouse-mobile-shell warehouse-mobile-shell--authentication" : "warehouse-mobile-shell")">
    @if (!_displayContext.AuthenticationOnly)
    {
    <header class="warehouse-mobile-shell__appbar">
        <button type="button"
                class="warehouse-mobile-shell__icon-button"
                aria-label="창고 메뉴 열기"
                aria-expanded="@_drawerOpen"
                @onclick="ToggleDrawer">
            <MudIcon Icon="@Icons.Material.Filled.Menu" Size="Size.Small" />
        </button>
        <a class="warehouse-mobile-shell__brand" href="@WarehouseManagerRoutes.Warehouse">
            <strong>살뜰 창고</strong>
            <small>일반 입출고</small>
        </a>
        <span class="warehouse-mobile-shell__spacer"></span>
        <span class="warehouse-mobile-shell__site">A-01</span>
        <span class="warehouse-mobile-shell__avatar" aria-label="창고 관리자">W</span>
    </header>

    }

    @if (!_displayContext.AuthenticationOnly && _drawerOpen)
    {
        <button type="button"
                class="warehouse-mobile-shell__backdrop"
                aria-label="창고 메뉴 닫기"
                @onclick="CloseDrawer"></button>
        <aside class="warehouse-mobile-shell__drawer" aria-label="창고 메뉴">
            <header>
                <div>
                    <strong>살뜰 창고</strong>
                    <span>입고에서 출고 인계까지</span>
                </div>
                <button type="button" aria-label="메뉴 닫기" @onclick="CloseDrawer">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                </button>
            </header>

            <nav>
                @foreach (var item in DrawerItems)
                {
                    <a href="@item.Route" @onclick="CloseDrawer">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                        <span>@item.Label</span>
                    </a>
                }
            </nav>

            <aside>
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />
                <span>수량·파손·온도·주소 차이는 숨기지 않고 예외로 남겨 담당자와 근거를 확인한 뒤 처리합니다.</span>
            </aside>
        </aside>
    }

    <main class="warehouse-mobile-shell__content">
        @if (!_displayContext.AuthenticationOnly && CurrentScreen is not null)
        {
            <header class="warehouse-mobile-shell__screen-header">
                <span>창고 업무 · @CurrentScreen.ScreenCode</span>
                <div>
                    <h1>@CurrentScreen.Title</h1>
                    <small>@CurrentScreen.Badge</small>
                </div>
                <p>@CurrentScreen.Description</p>
            </header>
        }

        <section class="warehouse-mobile-shell__screen-body">
            @Body
        </section>
    </main>

    @if (!_displayContext.AuthenticationOnly)
    {
    <footer class="warehouse-mobile-shell__bottom-nav" aria-label="창고 주요 메뉴">
        <a class="@BuildBottomLinkClass(BottomDestination.Home)"
           href="@WarehouseManagerRoutes.Warehouse"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Home) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
            <span>홈</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Inbound)"
           href="@WarehouseManagerRoutes.ExpectedInbounds"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Inbound) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.South" Size="Size.Small" />
            <span>입고</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Work)"
           href="@WarehouseManagerRoutes.WorkBoard"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Work) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
            <span>작업</span>
        </a>
        <a class="@BuildBottomLinkClass(BottomDestination.Outbound)"
           href="@WarehouseManagerRoutes.OutboundPlanReview"
           aria-current="@(IsBottomDestinationActive(BottomDestination.Outbound) ? "page" : null)">
            <MudIcon Icon="@Icons.Material.Filled.North" Size="Size.Small" />
            <span>출고</span>
        </a>
    </footer>
    }
</div>
</CascadingValue>

@code {
    private bool _drawerOpen;
    private bool _disposed;
    private readonly WarehousePageDisplayContext _displayContext = new();

    private string CurrentPath
        => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/') is { Length: > 0 } path
            ? path
            : "/";

    private WarehouseMobileScreenDefinition? CurrentScreen
        => WarehouseMobileScreenCatalog.Resolve(CurrentPath);

    private static IReadOnlyList<WarehouseDrawerItem> DrawerItems =>
    [
        new("창고 운영 홈", WarehouseManagerRoutes.Warehouse, Icons.Material.Filled.Home),
        new("창고 작업 보드", WarehouseManagerRoutes.WorkBoard, Icons.Material.Filled.ViewKanban),
        new("입고 예정 조회", WarehouseManagerRoutes.ExpectedInbounds, Icons.Material.Filled.EventAvailable),
        new("스캔 스테이션", WarehouseManagerRoutes.Scan, Icons.Material.Filled.QrCodeScanner),
        new("입고상품 수령", WarehouseManagerRoutes.InboundProductScan, Icons.Material.Filled.MoveToInbox),
        new("입고 검수 목록", WarehouseManagerRoutes.InboundInspection, Icons.Material.Filled.FactCheck),
        new("적재 작업", WarehouseManagerRoutes.PutAwayTask, Icons.Material.Filled.Warehouse),
        new("일반 재고 현황", WarehouseManagerRoutes.GeneralInventory, Icons.Material.Filled.Inventory),
        new("피킹 작업 목록", WarehouseManagerRoutes.PickingBatch, Icons.Material.Filled.Inventory2),
        new("포장 작업", WarehouseManagerRoutes.PackingTask, Icons.Material.Filled.AllInbox),
        new("출고예정 운송 전 검토", WarehouseManagerRoutes.OutboundPlanReview, Icons.Material.Filled.Rule),
        new("출고 인계 준비", WarehouseManagerRoutes.GeneralTransportHandoff, Icons.Material.Filled.LocalShipping),
        new("창고 예외 처리", WarehouseManagerRoutes.WarehouseExceptions, Icons.Material.Filled.ReportProblem),
        new("창고 작업 이력", WarehouseManagerRoutes.WarehouseHistory, Icons.Material.Filled.History),
        new("창고 설정", WarehouseManagerRoutes.WarehouseSettings, Icons.Material.Filled.Settings),
        new("보세·통관 상태", WarehouseManagerRoutes.ImportCustoms, Icons.Material.Filled.FactCheck)
    ];

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        _displayContext.Changed += HandleDisplayChanged;
    }

    private void ToggleDrawer()
    {
        if (!_disposed && !_displayContext.AuthenticationOnly) _drawerOpen = !_drawerOpen;
    }
    private void CloseDrawer() => _drawerOpen = false;

    private bool IsBottomDestinationActive(BottomDestination destination)
        => destination switch
        {
            BottomDestination.Inbound =>
                CurrentPath.StartsWith("/warehouse/inbounds", StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith("/work/inbound", StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith("/warehouse/import", StringComparison.OrdinalIgnoreCase),
            BottomDestination.Outbound =>
                CurrentPath.StartsWith("/work/outbound", StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith("/warehouse/general/outbound", StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith(WarehouseManagerRoutes.GeneralTransportHandoff, StringComparison.OrdinalIgnoreCase),
            BottomDestination.Work =>
                CurrentPath.StartsWith(WarehouseManagerRoutes.WorkBoard, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith(WarehouseManagerRoutes.Scan, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith(WarehouseManagerRoutes.PickingBatch, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith(WarehouseManagerRoutes.GeneralInventory, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith(WarehouseManagerRoutes.WarehouseExceptions, StringComparison.OrdinalIgnoreCase)
                || CurrentPath.StartsWith(WarehouseManagerRoutes.WarehouseHistory, StringComparison.OrdinalIgnoreCase),
            _ => !IsBottomDestinationActive(BottomDestination.Inbound)
                 && !IsBottomDestinationActive(BottomDestination.Outbound)
                 && !IsBottomDestinationActive(BottomDestination.Work)
        };

    private string BuildBottomLinkClass(BottomDestination destination)
        => IsBottomDestinationActive(destination)
            ? "warehouse-mobile-shell__bottom-link warehouse-mobile-shell__bottom-link--active"
            : "warehouse-mobile-shell__bottom-link";

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (_disposed) return;
        _drawerOpen = false;
        _displayContext.ResetForNavigation(args.Location);
        RefreshShell();
    }

    private void HandleDisplayChanged()
    {
        if (_disposed) return;
        if (_displayContext.AuthenticationOnly) _drawerOpen = false;
        RefreshShell();
    }

    private void RefreshShell()
        => _ = InvokeAsync(() =>
        {
            if (!_disposed) StateHasChanged();
        });

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Navigation.LocationChanged -= HandleLocationChanged;
        _displayContext.Changed -= HandleDisplayChanged;
        _displayContext.Stop();
    }

    private sealed record WarehouseDrawerItem(string Label, string Route, string Icon);

    private enum BottomDestination
    {
        Home,
        Inbound,
        Work,
        Outbound
    }
}
