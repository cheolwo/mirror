@page "/warehouse"
@inherits MvvmComponentBase<창고홈PageViewModel>
@inject NavigationManager Navigation

<PageTitle>창고 운영 홈</PageTitle>

<WarehousePageShell Model="@ViewModel"
                    Title="창고 운영 홈"
                    Description="창고 유형을 선택하고 해당 업무 흐름으로 진입합니다."
                    Icon="@Icons.Material.Filled.Warehouse"
                    Color="Color.Primary">
    <Actions>
        <MudButton Href="@WarehouseManagerRoutes.WorkBoard"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ViewKanban">
            작업 보드
        </MudButton>
    </Actions>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(ViewModel.창고조회.오류메시지))
        {
            <MudAlert Severity="Severity.Error">@ViewModel.창고조회.오류메시지</MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudSelect T="long?"
                               Label="작업 창고"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Clearable="true"
                               @bind-Value="_selectedWarehouseId">
                        @foreach (var warehouse in ViewModel.창고조회.항목목록)
                        {
                            <MudSelectItem T="long?" Value="@((long?)warehouse.Id)">
                                @warehouse.창고명 · @warehouse.주소
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                        <MudButton Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="@ViewModel.처리중"
                                   OnClick="ReloadAsync">
                            새로고침
                        </MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <MudGrid>
            @foreach (var profile in 창고운영ProfileCatalog.전체)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4 h-100" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudIcon Icon="@ProfileIcon(profile.코드)" Color="@ProfileColor(profile.코드)" Size="Size.Large" />
                                @if (string.Equals(ViewModel.세션.운영ProfileCode, profile.코드, StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="@ProfileColor(profile.코드)">현재 유형</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.h6">@profile.표시명</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@profile.설명</MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="@ProfileColor(profile.코드)"
                                       EndIcon="@Icons.Material.Filled.ChevronRight"
                                       OnClick="@(() => OpenProfile(profile.코드))">
                                업무 화면 열기
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudStack Spacing="2">
            <MudText Typo="Typo.h6">현재 유형의 작업 순서</MudText>
            <MudGrid>
                @foreach (var page in ViewModel.연결된페이지목록.Where(page => page.페이지코드 != 창고PageCodes.홈))
                {
                    <MudItem xs="12" sm="6" lg="4">
                        <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="2">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">@(page.표시명)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(page.설명)</MudText>
                                </MudStack>
                                <MudTooltip Text="@(page.표시명)">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                   Color="Color.Primary"
                                                   Href="@(page.경로)"
                                                   aria-label="@(page.표시명)" />
                                </MudTooltip>
                            </MudStack>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        </MudStack>
    </ChildContent>
</WarehousePageShell>

@code {
    private long? _selectedWarehouseId;

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.초기화Async();
        _selectedWarehouseId = ViewModel.세션.선택된창고?.Id;
    }

    private async Task ReloadAsync()
    {
        await ViewModel.초기화Async();
        _selectedWarehouseId = ViewModel.세션.선택된창고?.Id;
    }

    private void OpenProfile(string profileCode)
    {
        if (_selectedWarehouseId is { } warehouseId)
        {
            ViewModel.세션.창고선택(warehouseId, profileCode);
        }
        else
        {
            ViewModel.세션.운영Profile설정(profileCode);
        }

        Navigation.NavigateTo(ProfileStartRoute(profileCode));
    }

    private static string ProfileStartRoute(string profileCode)
        => profileCode switch
        {
            창고운영ProfileCodes.보세수입 => WarehouseManagerRoutes.ImportArrival,
            창고운영ProfileCodes.마트도심 => WarehouseManagerRoutes.MartHome,
            창고운영ProfileCodes.공동주택물류 => WarehouseManagerRoutes.ApartmentArrivals,
            _ => WarehouseManagerRoutes.GeneralInventory
        };

    private static string ProfileIcon(string profileCode)
        => profileCode switch
        {
            창고운영ProfileCodes.보세수입 => Icons.Material.Filled.Public,
            창고운영ProfileCodes.마트도심 => Icons.Material.Filled.Storefront,
            창고운영ProfileCodes.공동주택물류 => Icons.Material.Filled.Group,
            _ => Icons.Material.Filled.Inventory2
        };

    private static Color ProfileColor(string profileCode)
        => profileCode switch
        {
            창고운영ProfileCodes.보세수입 => Color.Info,
            창고운영ProfileCodes.마트도심 => Color.Success,
            창고운영ProfileCodes.공동주택물류 => Color.Secondary,
            _ => Color.Primary
        };
}
