@page "/work-board"
@inherits MvvmComponentBase<창고작업보드PageViewModel>

<PageTitle>창고 작업 보드</PageTitle>

<WarehousePageShell Model="@ViewModel"
                    Title="창고 작업 보드"
                    Description="선택한 입고 요청의 현재 상태와 다음 업무를 확인합니다."
                    Icon="@Icons.Material.Filled.ViewKanban"
                    Color="Color.Primary">
    <Actions>
        @if (ViewModel.기능사용가능 && ViewModel.인증.창고업무접근가능)
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">
                    @ViewModel.인증.현재사용자표시
                </MudChip>
                <MudTooltip Text="선택 입고 다시 조회">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   Disabled="@(ViewModel.처리중 || !ViewModel.조회대상선택됨)"
                                   OnClick="RetryInboundAsync"
                                   aria-label="선택 입고 다시 조회" />
                </MudTooltip>
                <MudButton Href="@WarehouseManagerRoutes.ExpectedInbounds"
                           Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.EventAvailable">
                    입고 예정 선택
                </MudButton>
            </MudStack>
        }
    </Actions>
    <ChildContent>
        @if (!ViewModel.초기화됨 || ViewModel.초기화중)
        {
            <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        창고 업무 권한과 선택한 입고 요청을 확인하고 있습니다.
                    </MudText>
                </MudStack>
            </MudPaper>
        }
        else if (!string.IsNullOrWhiteSpace(ViewModel.페이지오류메시지))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText>@ViewModel.페이지오류메시지</MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Disabled="@ViewModel.처리중"
                               OnClick="RetryPageAsync">
                        다시 확인
                    </MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (!ViewModel.기능사용가능)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">창고 작업 보드가 비활성입니다.</MudText>
                    <MudText Typo="Typo.body2">@ViewModel.기능안내</MudText>
                    <MudText Typo="Typo.caption">
                        이 환경에서 창고 업무를 사용할 수 있는지 관리자에게 확인해 주세요.
                    </MudText>
                </MudStack>
            </MudAlert>
        }
        else if (!ViewModel.인증.창고업무접근가능)
        {
            <WarehouseAuthenticationPanel ViewModel="@ViewModel.인증"
                                          OnAuthenticated="AfterAuthenticationAsync"
                                          OnLoggedOut="OnLoggedOut" />
        }
        else if (!ViewModel.조회대상선택됨)
        {
            <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Large" Color="Color.Secondary" />
                    <MudText Typo="Typo.h6">확인할 입고 요청을 선택해 주세요.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                        입고 예정 목록에서 한 건을 선택하면 현재 처리 상태와 다음 업무를 볼 수 있습니다.
                    </MudText>
                    <MudButton Href="@WarehouseManagerRoutes.ExpectedInbounds"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ChevronRight">
                        입고 예정 목록 열기
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (!string.IsNullOrWhiteSpace(ViewModel.입고상세조회.오류메시지))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText>@ViewModel.입고상세조회.오류메시지</MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Disabled="@ViewModel.처리중"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="RetryInboundAsync">
                        입고 요청 다시 조회
                    </MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (ViewModel.입고상세조회.대상없음)
        {
            <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" />
                    <MudText Typo="Typo.h6">입고 요청을 찾을 수 없습니다.</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                        입고 요청 #@ViewModel.입고요청Id 이(가) 없거나 현재 계정의 창고 조회 범위에 없습니다.
                    </MudText>
                    <MudButton Href="@WarehouseManagerRoutes.ExpectedInbounds"
                               Variant="Variant.Outlined"
                               Color="Color.Primary">
                        다른 입고 요청 선택
                    </MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (ViewModel.입고상세조회.항목 is { } item && ViewModel.작업상태 is { } workState)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Science">
                시험 기능의 조회 전용 화면입니다. 검수·적재·보관·정산 처리는 이 화면에서 실행하지 않습니다.
            </MudAlert>

            <MudGrid>
                <MudItem xs="12" lg="8">
                    <MudPaper Class="pa-4 h-100" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.h6">입고 요청 #@item.Id</MudText>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                                        @InboundSummary(item)
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Color="@StatusColor(item.상태)" Variant="Variant.Outlined">
                                    @workState.현재단계
                                </MudChip>
                            </MudStack>

                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">예정 상품</MudText>
                                    <MudText Typo="Typo.body1">@ValueOrFallback(item.예정상품명)</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">상품 코드 · 예정 수량</MudText>
                                    <MudText Typo="Typo.body1">@SkuAndQuantity(item)</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">예정 도착</MudText>
                                    <MudText Typo="Typo.body1">@DateTimeText(item.예정도착일)</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">입고 흐름</MudText>
                                    <MudText Typo="Typo.body1">@입고흐름유형코드.GetDisplayName(item.입고흐름유형)</MudText>
                                </MudItem>
                            </MudGrid>

                            <SsalddelSensitiveDisclosureList Title="관련 업무 정보"
                                                            Summary="창고·주문·공급 정보를 필요할 때 펼쳐 확인합니다."
                                                            RelatedParties="@($"{ValueOrFallback(item.공급처명)} · 창고 #{item.창고Id}")"
                                                            PrivacyHint="연락처와 상세 주소는 이 조회 응답에 포함하지 않습니다."
                                                            Icon="@Icons.Material.Filled.AccountTree"
                                                            Color="Color.Primary"
                                                            Compact="true">
                                <MudExpansionPanel Text="입고 기준정보" Icon="@Icons.Material.Filled.Assignment">
                                    <SsalddelSensitiveInfoRow Label="창고 번호" Value="@item.창고Id.ToString()" />
                                    <SsalddelSensitiveInfoRow Label="공급처" Value="@ValueOrFallback(item.공급처명)" />
                                    <SsalddelSensitiveInfoRow Label="공급처 코드" Value="@ValueOrFallback(item.공급처코드)" />
                                    <SsalddelSensitiveInfoRow Label="생성 경로" Value="@ValueOrFallback(item.입고생성경로)" />
                                </MudExpansionPanel>
                                <MudExpansionPanel Text="관련 주문" Icon="@Icons.Material.Filled.Hub">
                                    <SsalddelSensitiveInfoRow Label="주문 참조" Value="@ValueOrFallback(item.주문참조번호)" />
                                    <SsalddelSensitiveInfoRow Label="원주문 참조" Value="@ValueOrFallback(item.원주문참조번호)" />
                                    <SsalddelSensitiveInfoRow Label="운송 의뢰" Value="@ValueOrFallback(item.운송의뢰Id)" />
                                    <SsalddelSensitiveInfoRow Label="공동 업무 기록" Value="@ValueOrFallback(item.커뮤니티원장Id)" />
                                </MudExpansionPanel>
                                <MudExpansionPanel Text="입고 계약 내용" Icon="@Icons.Material.Filled.Description">
                                    <SsalddelSensitiveInfoRow Label="계약 번호" Value="@ValueOrFallback(item.계약정보.계약번호)" />
                                    <SsalddelSensitiveInfoRow Label="계약 유형" Value="@입고계약유형코드.GetDisplayName(item.계약정보.계약유형)" />
                                    <SsalddelSensitiveInfoRow Label="계약 상대방" Value="@ValueOrFallback(item.계약정보.계약상대방명)" />
                                    <SsalddelSensitiveInfoRow Label="통관 필요" Value="@(item.계약정보.통관필요여부 ? "예" : "아니요")" />
                                </MudExpansionPanel>
                            </SsalddelSensitiveDisclosureList>
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" lg="4">
                    <MudStack Spacing="2">
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            <MudStack Spacing="2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Route" Color="Color.Primary" />
                                    <MudText Typo="Typo.subtitle1">다음 업무</MudText>
                                </MudStack>
                                <MudChip T="string"
                                         Color="@(workState.상태전이후보 ? Color.Warning : Color.Default)"
                                         Variant="Variant.Outlined">
                                    @workState.다음행동
                                </MudChip>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@workState.안내</MudText>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Disabled="true"
                                           StartIcon="@Icons.Material.Filled.LockClock">
                                    시험 환경에서 별도 처리
                                </MudButton>
                            </MudStack>
                        </MudPaper>

                        @if (item.입고완료일시.HasValue)
                        {
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">입고 완료 시각</MudText>
                                <MudText Typo="Typo.body1">@DateTimeText(item.입고완료일시)</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.subtitle1">다른 작업 영역</MudText>
                    <MudGrid Spacing="2">
                        @foreach (var area in ViewModel.작업영역목록)
                        {
                            <MudItem xs="12" sm="6" lg="4">
                                <MudButton Href="@area.경로"
                                           Variant="Variant.Text"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           EndIcon="@Icons.Material.Filled.ChevronRight">
                                    @area.표시명
                                </MudButton>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@area.설명</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                </MudStack>
            </MudPaper>
        }
    </ChildContent>
</WarehousePageShell>

@code {
    private bool _parametersLoaded;
    private long? _loadedInboundId;

    [Parameter]
    [SupplyParameterFromQuery(Name = "inboundId")]
    public long? InboundId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_parametersLoaded && _loadedInboundId == InboundId)
        {
            return;
        }

        _parametersLoaded = true;
        _loadedInboundId = InboundId;
        await ViewModel.초기화Async(InboundId);
    }

    private async Task AfterAuthenticationAsync()
        => await ViewModel.인증후조회Async();

    private void OnLoggedOut()
        => ViewModel.인증해제적용();

    private async Task RetryInboundAsync()
        => await ViewModel.다시조회Async();

    private async Task RetryPageAsync()
        => await ViewModel.초기화Async(InboundId);

    private static Color StatusColor(string? status)
        => status switch
        {
            입고상태코드.예정 => Color.Warning,
            입고상태코드.운송중 => Color.Info,
            입고상태코드.완료 => Color.Success,
            입고상태코드.취소 => Color.Error,
            _ => Color.Default
        };

    private static string InboundSummary(입고요청항목응답 item)
        => $"창고 #{item.창고Id} · {ValueOrFallback(item.공급처명)}";

    private static string SkuAndQuantity(입고요청항목응답 item)
    {
        var sku = ValueOrFallback(item.예정SKU);
        return item.예정수량.HasValue ? $"{sku} · {item.예정수량:N0}개" : sku;
    }

    private static string DateTimeText(DateTime? value)
        => value?.ToString("yyyy-MM-dd HH:mm") ?? "미정";

    private static string ValueOrFallback(string? value)
        => string.IsNullOrWhiteSpace(value) ? "연결 정보 없음" : value.Trim();
}
