@page "/mart/work-board"

@inherits MvvmComponentBase<마트주문처리PageViewModel>

<PageTitle>알뜰살뜰 마트 작업 보드</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h4">알뜰살뜰 마트 작업 보드</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    음식점 주문 보드처럼 빠르게 보되, 기준 데이터는 창고 재고, 피킹 위치, 포장 완료, 배달 기사 픽업입니다.
                </MudText>
            </MudStack>
            <MudButton Href="@WarehouseManagerRoutes.MartHome"
                       Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Storefront">
                알뜰살뜰 마트 홈
            </MudButton>
            <MudButton Href="@WarehouseManagerRoutes.MartPickingPacking"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ShoppingCartCheckout">
                피킹/포장 작업
            </MudButton>
        </MudStack>

        <MudGrid>
            @foreach (var summary in Summaries)
            {
                <MudItem xs="6" md="3">
                    <MudPaper Class="pa-4 h-100" Elevation="0" Outlined="true">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@summary.Label</MudText>
                            <MudText Typo="Typo.h5">@summary.Value</MudText>
                            <MudText Typo="Typo.body2" Color="@summary.Color">@summary.Note</MudText>
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <MudGrid>
            @foreach (var lane in Lanes)
            {
                <MudItem xs="12" lg="3">
                    <MudPaper Class="pa-3 h-100" Elevation="0" Outlined="true">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.h6">@lane.Title</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@lane.Color" Variant="Variant.Outlined">@($"{lane.Count}건")</MudChip>
                            </MudStack>

                            @foreach (var item in lane.Items)
                            {
                                <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                    <MudStack Spacing="1">
                                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                            <MudText Typo="Typo.subtitle2">@item.Title</MudText>
                                            <MudChip T="string" Size="Size.Small" Color="@item.Color">@item.Status</MudChip>
                                        </MudStack>

                                        <HongdalSensitiveDisclosureList Title="작업 관계와 상세"
                                                                        Summary="@item.Description"
                                                                        RelatedParties="@item.RelatedParties"
                                                                        PrivacyHint="고객, 작업자, 배달 기사 관련 정보는 필요한 범위에서 단계적으로 확인합니다."
                                                                        Icon="@item.Icon"
                                                                        Color="@item.Color"
                                                                        Compact="true">
                                            <MudExpansionPanel Text="작업 정보" Icon="@Icons.Material.Filled.Assignment">
                                                <HongdalSensitiveInfoRow Label="작업" Value="@item.Title" />
                                                <HongdalSensitiveInfoRow Label="상태" Value="@item.Status" />
                                                <HongdalSensitiveInfoRow Label="마감" Value="@item.Deadline" />
                                            </MudExpansionPanel>
                                            <MudExpansionPanel Text="직접 관련 대상" Icon="@Icons.Material.Filled.Group">
                                                <HongdalSensitiveInfoRow Label="관련 대상" Value="@item.RelatedParties" />
                                                <HongdalSensitiveInfoRow Label="후속 연락" Value="@item.ContactContext" />
                                                <HongdalSensitiveInfoRow Label="관계 기록" Value="피킹, 포장, 픽업 완료 시 실제로 함께 처리한 사람과의 업무 관계 후보가 됩니다." />
                                            </MudExpansionPanel>
                                        </HongdalSensitiveDisclosureList>

                                        <MudText Typo="Typo.caption">@item.Deadline</MudText>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudStack>
</MudContainer>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (!string.Equals(ViewModel.세션.운영ProfileCode, 창고운영ProfileCodes.마트도심, StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.세션.운영Profile설정(창고운영ProfileCodes.마트도심);
        }
    }

