@page "/distributed-login"
@using Ssalddel.Ui.Common.Areas.App.Models.Auth
@using Ssalddel.Ui.Common.Areas.App.Components.Auth
@inject WarehouseAuthApiService Auth
@inject NavigationManager Navigation
@implements IDisposable
<PageTitle>보관 거점 로그인</PageTitle>
<Ssalddel공통로그인Panel 제목="보관 거점 로그인" 설명="로그인한 계정의 실제 소유·관리 관계로 거점 업무를 확인합니다. 일반 창고 인사 권한은 별도로 유지됩니다." 상태메시지="@error" 상태Severity="Severity.Error" IsBusy="busy" 소셜로그인표시="false" OnPasswordLogin="Login" />
<p><a href="@ResumeHref">보관 거점으로 돌아가기</a></p>
@code {
    private readonly CancellationTokenSource lifetime = new();
    private bool busy, disposed;
    private string? error;
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string ResumeHref => Ssalddel.Ui.Common.Areas.App.RoleWorkspace.DistributedFulfillment.분산이행Navigation.WarehouseLoginReturn(ReturnUrl);
    private async Task Login(공통로그인요청 request)
    {
        if (busy) return; busy = true; error = null;
        try
        {
            var result = await Auth.LoginAsync(request.UserNameOrEmail, request.Password, lifetime.Token);
            if (disposed) return;
            if (result.IsSuccess) Navigation.NavigateTo(ResumeHref);
            else error = "로그인 정보를 확인하지 못했습니다. 계정과 연결 상태를 확인해 주세요.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception) when (!disposed) { error = "로그인 결과를 확인하지 못했습니다. 다시 확인해 주세요."; }
        finally { busy = false; }
    }
    public void Dispose() { disposed = true; lifetime.Cancel(); lifetime.Dispose(); }
}
