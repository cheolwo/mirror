@page "/warehouse/inbounds/expected"
@inherits MvvmComponentBase<창고입고예정조회PageViewModel>
@inject NavigationManager Navigation

<PageTitle>입고 예정 조회</PageTitle>

<WarehousePageShell Model="@ViewModel"
                    Title="입고 예정 조회"
                    Description="현재 창고에 도착할 업체별 품목과 예정 시간을 확인합니다."
                    Icon="@Icons.Material.Filled.EventAvailable"
                    Color="Color.Primary">
    <Actions>
        <MudStack Row="true" Spacing="1">
            @if (ViewModel.기능사용가능 && ViewModel.인증.창고업무접근가능)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">
                    @ViewModel.인증.현재사용자표시
                </MudChip>
                <MudTooltip Text="새로고침">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Default"
                                   Disabled="@(ViewModel.처리중 || !ViewModel.선택된창고Id.HasValue)"
                                   OnClick="RequestReload"
                                   aria-label="입고 예정 목록 새로고침" />
                </MudTooltip>
                <MudButton Href="@ViewModel.입고작업경로"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ChevronRight">
                    입고 작업
                </MudButton>
            }
        </MudStack>
    </Actions>
    <ChildContent>
        @if (!ViewModel.초기화됨 || ViewModel.초기화중)
        {
            <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                <MudStack AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">창고 업무 권한과 입고 기준정보를 확인하고 있습니다.</MudText>
                </MudStack>
            </MudPaper>
        }
        else if (!string.IsNullOrWhiteSpace(ViewModel.페이지오류메시지))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText>@ViewModel.페이지오류메시지</MudText>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Error"
                               Disabled="@ViewModel.처리중"
                               OnClick="RetryPageAsync">
                        다시 확인
                    </MudButton>
                </MudStack>
            </MudAlert>
        }
        else if (!ViewModel.기능사용가능)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle1">창고 입출고 기능이 비활성입니다.</MudText>
                    <MudText Typo="Typo.body2">@ViewModel.기능안내</MudText>
                    <MudText Typo="Typo.caption">
                        현재 0.0 공개 커뮤니티 운영에는 영향이 없으며, 창고 기능 플래그가 활성화된 환경에서만 이 페이지를 사용합니다.
                    </MudText>
                </MudStack>
            </MudAlert>
        }
        else if (!ViewModel.인증.창고업무접근가능)
        {
            <WarehouseAuthenticationPanel ViewModel="@ViewModel.인증"
                                          OnAuthenticated="AfterAuthenticationAsync"
                                          OnLoggedOut="OnLoggedOut" />
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(ViewModel.창고조회.오류메시지))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudText>@ViewModel.창고조회.오류메시지</MudText>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Error"
                                   Disabled="@ViewModel.처리중"
                                   OnClick="RetryWarehousesAsync">
                            창고 다시 조회
                        </MudButton>
                    </MudStack>
                </MudAlert>
            }

            @if (ViewModel.창고목록비어있음)
            {
                <MudPaper Class="pa-6" Elevation="0" Outlined="true">
                    <MudStack AlignItems="AlignItems.Center" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Filled.Warehouse" Size="Size.Large" Color="Color.Secondary" />
                        <MudText Typo="Typo.h6">조회 가능한 창고가 없습니다.</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            서버에서 창고 배정과 HR 세부 역할을 확인한 뒤 다시 조회해 주세요.
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@ViewModel.처리중"
                                   OnClick="RetryWarehousesAsync">
                            다시 조회
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
            else if (ViewModel.창고조회.항목목록.Count > 0)
            {
                <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                    <MudSelect T="long?"
                               Label="조회 창고"
                               Value="@ViewModel.선택된창고Id"
                               ValueChanged="WarehouseChanged"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Disabled="@ViewModel.창고조회.처리중">
                        @foreach (var warehouse in ViewModel.창고조회.항목목록)
                        {
                            <MudSelectItem T="long?" Value="@((long?)warehouse.Id)">
                                @warehouse.창고명 · @warehouse.주소
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudPaper>

                @if (ViewModel.선택된창고Id.HasValue)
                {
                    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                        <SsalddelOperationState ViewModel="@ViewModel.입고예정조회" />
                        @if (!string.IsNullOrWhiteSpace(ViewModel.입고예정조회.오류메시지))
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       Disabled="@ViewModel.처리중"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="RequestReload">
                                입고 예정 다시 조회
                            </MudButton>
                        }
                        <WarehouseExpectedInboundGrid ViewModel="@ViewModel.입고예정조회"
                                                      ReloadVersion="@ViewModel.목록갱신번호"
                                                      OnSelect="OpenInbound" />
                    </MudPaper>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        조회할 창고를 선택해 주세요.
                    </MudAlert>
                }
            }
        }
    </ChildContent>
</WarehousePageShell>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.초기화Async();
    }

    private void RequestReload()
        => ViewModel.목록새로고침요청();

    private void WarehouseChanged(long? warehouseId)
        => ViewModel.창고선택(warehouseId);

    private async Task AfterAuthenticationAsync()
        => await ViewModel.인증후조회Async();

    private void OnLoggedOut()
        => ViewModel.인증해제적용();

    private async Task RetryWarehousesAsync()
        => await ViewModel.인증후조회Async();

    private async Task RetryPageAsync()
        => await ViewModel.초기화Async();

    private void OpenInbound(입고요청항목응답 item)
    {
        var path = ViewModel.입고작업선택(item);
        if (!string.IsNullOrWhiteSpace(path))
        {
            Navigation.NavigateTo(path);
        }
    }
}
