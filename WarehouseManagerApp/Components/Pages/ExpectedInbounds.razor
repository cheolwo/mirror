@page "/warehouse/inbounds/expected"
@inherits MvvmComponentBase<창고입고예정조회PageViewModel>

<PageTitle>입고 예정 조회</PageTitle>

<WarehousePageShell Model="@ViewModel"
                    Title="입고 예정 조회"
                    Description="현재 창고에 도착할 업체별 품목과 예정 시간을 확인합니다."
                    Icon="@Icons.Material.Filled.EventAvailable"
                    Color="Color.Primary">
    <Actions>
        <MudStack Row="true" Spacing="1">
            <MudTooltip Text="새로고침">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                               Color="Color.Default"
                               Disabled="@ViewModel.처리중"
                               OnClick="ReloadAsync"
                               aria-label="새로고침" />
            </MudTooltip>
            <MudButton Href="@ViewModel.입고작업경로"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       EndIcon="@Icons.Material.Filled.ChevronRight">
                입고 작업
            </MudButton>
        </MudStack>
    </Actions>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(ViewModel.창고조회.오류메시지))
        {
            <MudAlert Severity="Severity.Error">@ViewModel.창고조회.오류메시지</MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudSelect T="long?"
                       Label="조회 창고"
                       Value="@_warehouseId"
                       ValueChanged="WarehouseChangedAsync"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Disabled="@ViewModel.창고조회.처리중">
                @foreach (var warehouse in ViewModel.창고조회.항목목록)
                {
                    <MudSelectItem T="long?" Value="@((long?)warehouse.Id)">
                        @warehouse.창고명 · @warehouse.주소
                    </MudSelectItem>
                }
            </MudSelect>
        </MudPaper>

        @if (_initialized && _warehouseId.HasValue)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <HongdalOperationState ViewModel="@ViewModel.입고예정조회" />
                <WarehouseExpectedInboundGrid @ref="_grid"
                                              ViewModel="@ViewModel.입고예정조회" />
            </MudPaper>
        }
        else if (_initialized)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                조회할 창고를 선택해 주세요.
            </MudAlert>
        }
    </ChildContent>
</WarehousePageShell>

@code {
    private WarehouseExpectedInboundGrid? _grid;
    private long? _warehouseId;
    private bool _initialized;

    protected override async Task OnInitializedAsync()
    {
        _initialized = await ViewModel.초기화Async();
        _warehouseId = ViewModel.세션.선택된창고?.Id;
    }

    private Task ReloadAsync()
        => _grid?.ReloadAsync() ?? Task.CompletedTask;

    private async Task WarehouseChangedAsync(long? warehouseId)
    {
        _warehouseId = warehouseId;
        if (!warehouseId.HasValue || !ViewModel.창고선택(warehouseId.Value))
        {
            return;
        }

        if (_grid is not null)
        {
            await _grid.ReloadAsync();
        }
    }
}
