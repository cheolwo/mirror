@page "/work/inbound/products"
@inherits MvvmComponentBase<일반입고작업PageViewModel>
@inject NavigationManager Navigation

<PageTitle>입고 상품 확인</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="py-4">
    <MudStack Spacing="3">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4">입고 상품 확인</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                상품 바코드를 입력하면 입고 예정 상품을 조회합니다. 입고 확인은 상품 바코드와 입고 묶음 바코드가 함께 확인되어야 완료됩니다.
            </MudText>
        </MudStack>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <MudTextField T="string"
                              Label="상품 바코드"
                              Value="@productBarcode"
                              ValueChanged="OnBarcodeChanged"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              AutoFocus="true"
                              Placeholder="SKU:MILK-001"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                              OnKeyDown="OnKeyDownAsync" />

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Search"
                               Disabled="@string.IsNullOrWhiteSpace(productBarcode)"
                               OnClick="LookupAsync">
                        입고 예정 조회
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Backspace"
                               OnClick="Clear">
                        다시 입력
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.AddBusiness"
                               Disabled="@string.IsNullOrWhiteSpace(productBarcode)"
                               OnClick="StartUnplannedInbound">
                        현장 입고 등록
                    </MudButton>
                    <MudButton Href="@WarehouseManagerRoutes.ExpectedInbounds"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.EventAvailable">
                        업체별 입고 예정
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@messageSeverity">@message</MudAlert>
        }

        @if (showUnplannedInboundForm)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">현장 입고 등록</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                계약 또는 입고 예정이 아직 연결되지 않은 상품을 임시 입고로 등록합니다.
                            </MudText>
                        </MudStack>
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">예외 입고</MudChip>
                    </MudStack>

                    <MudAlert Severity="Severity.Info" Dense="true">
                        현장 입고는 업무를 멈추지 않기 위한 임시 상태입니다. 검수 단계에서 계약 연결, 정산 조건, 보관 책임을 보완해야 합니다.
                    </MudAlert>

                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="상품 바코드"
                                          @bind-Value="unplannedProductBarcode"
                                          Variant="Variant.Outlined"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.QrCodeScanner" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="입고 묶음 바코드"
                                          @bind-Value="unplannedInboundBundleBarcode"
                                          Variant="Variant.Outlined"
                                          Placeholder="BND:IN-001"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.QrCodeScanner" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="상품명"
                                          @bind-Value="unplannedProductName"
                                          Variant="Variant.Outlined"
                                          Placeholder="예: 냉장 샌드위치 박스" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="공급사 또는 반입자"
                                          @bind-Value="unplannedSupplier"
                                          Variant="Variant.Outlined"
                                          Placeholder="미확인이면 비워둘 수 있습니다." />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField T="int"
                                             Label="입고 수량"
                                             @bind-Value="unplannedReceivedQuantity"
                                             Min="1"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="string"
                                       Label="보관 조건"
                                       @bind-Value="unplannedStorageType"
                                       Variant="Variant.Outlined">
                                @foreach (var option in storageTypeOptions)
                                {
                                    <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="string"
                                       Label="계약 연결 상태"
                                       @bind-Value="unplannedContractLinkStatus"
                                       Variant="Variant.Outlined">
                                @foreach (var option in contractLinkOptions)
                                {
                                    <MudSelectItem T="string" Value="@option">@option</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string"
                                          Label="현장 입고 사유"
                                          @bind-Value="unplannedExceptionReason"
                                          Variant="Variant.Outlined"
                                          Lines="3"
                                          Placeholder="예: 계약 등록 전 선반입, 긴급 반품 회수, 공급사 착오 반입" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Warning"
                                   StartIcon="@Icons.Material.Filled.Inventory"
                                   OnClick="RegisterUnplannedInboundAsync">
                            임시 입고로 편입
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Default"
                                   StartIcon="@Icons.Material.Filled.Close"
                                   OnClick="CancelUnplannedInbound">
                            취소
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        @if (selectedProduct is not null)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudStack Spacing="3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">@selectedProduct.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@selectedProduct.InboundRequestNo / @selectedProduct.Supplier</MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @if (selectedProduct.IsUnplannedInbound)
                            {
                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">현장 입고</MudChip>
                            }
                            <MudChip T="string" Color="@QuantityColor" Variant="Variant.Filled">@QuantityStatus</MudChip>
                        </MudStack>
                    </MudStack>

                    <HongdalSensitiveDisclosureList Title="입고 관계와 상세"
                                                    Summary="@($"{selectedProduct.Name} / 예정 {selectedProduct.ExpectedQuantity}개")"
                                                    RelatedParties="@BuildInboundRelatedParties(selectedProduct)"
                                                    PrivacyHint="입고 담당자가 후속 확인이 필요한 상대를 먼저 인지하도록 구성합니다."
                                                    Icon="@Icons.Material.Filled.MoveToInbox"
                                                    Color="@QuantityColor">
                        <MudExpansionPanel Text="입고 정보" Icon="@Icons.Material.Filled.Inventory2">
                            <HongdalSensitiveInfoRow Label="입고 번호" Value="@selectedProduct.InboundRequestNo" />
                            <HongdalSensitiveInfoRow Label="상품 바코드" Value="@selectedProduct.Barcode" />
                            <HongdalSensitiveInfoRow Label="상품명" Value="@selectedProduct.Name" />
                            <HongdalSensitiveInfoRow Label="공급사" Value="@selectedProduct.Supplier" />
                            <HongdalSensitiveInfoRow Label="계약 연결 상태" Value="@selectedProduct.ContractLinkStatus" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="수량과 보관" Icon="@Icons.Material.Filled.FactCheck">
                            <HongdalSensitiveInfoRow Label="예정 수량" Value="@selectedProduct.ExpectedQuantity.ToString()" />
                            <HongdalSensitiveInfoRow Label="실제 입고 수량" Value="@receivedQuantity.ToString()" />
                            <HongdalSensitiveInfoRow Label="입고 묶음 바코드" Value="@inboundBundleBarcode" />
                            <HongdalSensitiveInfoRow Label="보관 조건" Value="@selectedProduct.StorageType" />
                            <HongdalSensitiveInfoRow Label="수량 상태" Value="@QuantityStatus" />
                        </MudExpansionPanel>
                        <MudExpansionPanel Text="후속 연결" Icon="@Icons.Material.Filled.ConnectWithoutContact">
                            <HongdalSensitiveInfoRow Label="다음 공정" Value="입고 확인 후 검수 작업으로 이동" />
                            <HongdalSensitiveInfoRow Label="문의 가능 대상" Value="@BuildInboundContactContext(selectedProduct)" />
                            <HongdalSensitiveInfoRow Label="관계 기록" Value="입고 확인 완료 시 공급사, 화주, 검수 담당자와의 업무 관계 스냅샷 후보가 됩니다." />
                            @if (!string.IsNullOrWhiteSpace(selectedProduct.ExceptionReason))
                            {
                                <HongdalSensitiveInfoRow Label="예외 사유" Value="@selectedProduct.ExceptionReason" />
                            }
                        </MudExpansionPanel>
                    </HongdalSensitiveDisclosureList>

                    <MudNumericField T="int"
                                     Label="실제 입고 수량"
                                     @bind-Value="receivedQuantity"
                                     Min="0"
                                     Variant="Variant.Outlined" />

                    <MudTextField T="string"
                                  Label="입고 묶음 바코드"
                                  @bind-Value="inboundBundleBarcode"
                                  Variant="Variant.Outlined"
                                  Placeholder="BND:IN-001"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.QrCodeScanner" />

                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        수량과 입고 묶음 바코드가 확인되면 입고 확인 상태로 변경하고 검수 작업으로 이동합니다. 묶음 바코드 하나에는 상품 종류 최대 3개와 각 수량이 포함됩니다.
                    </MudText>

                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Inventory"
                                   OnClick="ConfirmInboundAsync">
                            입고 확인 상태로 변경
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.FactCheck"
                                   Disabled="@(!isInboundConfirmed)"
                                   OnClick="@(() => Navigation.NavigateTo(WarehouseManagerRoutes.InboundInspection))">
                            검수 작업으로 이동
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.subtitle1">샘플 상품 바코드</MudText>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                @foreach (var item in expectedProducts)
                {
                    <MudButton Size="Size.Small"
                               Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="@(() => SelectSampleAsync(item.Barcode))">
                        @item.Barcode
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    private IReadOnlyList<InboundExpectedProductDto> expectedProducts = [];
    private string productBarcode = string.Empty;
    private string? message;
    private Severity messageSeverity = Severity.Info;
    private InboundExpectedProductDto? selectedProduct;
    private int receivedQuantity;
    private bool isInboundConfirmed;
    private bool showUnplannedInboundForm;
    private string inboundBundleBarcode = string.Empty;
    private string unplannedProductBarcode = string.Empty;
    private string unplannedInboundBundleBarcode = string.Empty;
    private string unplannedProductName = string.Empty;
    private string unplannedSupplier = string.Empty;
    private int unplannedReceivedQuantity = 1;
    private string unplannedStorageType = "상온";
    private string unplannedContractLinkStatus = "계약 미연결";
    private string unplannedExceptionReason = string.Empty;

    private static readonly IReadOnlyList<string> storageTypeOptions = ["상온", "냉장", "냉동", "위험물", "미지정"];
    private static readonly IReadOnlyList<string> contractLinkOptions = ["계약 미연결", "계약 확인 중", "구두 합의 선반입", "반품/회수 입고", "기존 계약 사후 연결 예정"];

    private Color QuantityColor => selectedProduct is null
        ? Color.Default
        : receivedQuantity == selectedProduct.ExpectedQuantity
            ? Color.Success
            : Color.Warning;

    private string QuantityStatus => selectedProduct is null
        ? "대기"
        : receivedQuantity == selectedProduct.ExpectedQuantity
            ? "수량 일치"
            : "수량 차이";

    protected override async Task OnInitializedAsync()
    {
        EnsureGeneralProfile();
        expectedProducts = await ViewModel.입고Workflow.GetExpectedProductsAsync();
    }

    private void EnsureGeneralProfile()
    {
        if (!string.Equals(ViewModel.세션.운영ProfileCode, 창고운영ProfileCodes.일반입출고, StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.세션.운영Profile설정(창고운영ProfileCodes.일반입출고);
        }
    }

    private Task OnBarcodeChanged(string value)
    {
        productBarcode = (value ?? string.Empty).Trim();
        message = null;
        isInboundConfirmed = false;
        inboundBundleBarcode = string.Empty;
        showUnplannedInboundForm = false;
        return Task.CompletedTask;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await LookupAsync();
        }
    }

    private async Task LookupAsync()
    {
        selectedProduct = await ViewModel.입고Workflow.FindExpectedProductAsync(productBarcode);
        isInboundConfirmed = false;

        if (selectedProduct is null)
        {
            receivedQuantity = 0;
            PrefillUnplannedInbound();
            showUnplannedInboundForm = true;
            messageSeverity = Severity.Warning;
            message = "입고 예정 상품에서 찾지 못했습니다. 현장 입고로 임시 등록하거나 바코드를 다시 확인해 주세요.";
            return;
        }

        showUnplannedInboundForm = false;
        receivedQuantity = selectedProduct.ExpectedQuantity;
        inboundBundleBarcode = BuildDefaultBundleBarcode(selectedProduct.InboundRequestNo);
        messageSeverity = Severity.Success;
        message = $"{selectedProduct.Name} 입고 예정 정보를 불러왔습니다.";
    }

    private async Task ConfirmInboundAsync()
    {
        if (selectedProduct is null)
        {
            messageSeverity = Severity.Warning;
            message = "먼저 상품 바코드로 입고 예정 상품을 조회해 주세요.";
            return;
        }

        try
        {
            var result = await ViewModel.입고Workflow.ConfirmReceivedAsync(new InboundReceivingConfirmationRequest(
                selectedProduct.Barcode,
                inboundBundleBarcode,
                receivedQuantity));

            isInboundConfirmed = true;
            inboundBundleBarcode = result.InboundBundleBarcode;
            messageSeverity = result.QuantityMatched ? Severity.Success : Severity.Warning;
            message = result.Message;
        }
        catch (InvalidOperationException ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
    }

    private async Task SelectSampleAsync(string barcode)
    {
        productBarcode = barcode;
        await LookupAsync();
    }

    private void StartUnplannedInbound()
    {
        selectedProduct = null;
        isInboundConfirmed = false;
        PrefillUnplannedInbound();
        showUnplannedInboundForm = true;
        messageSeverity = Severity.Info;
        message = "현장 입고 정보를 입력한 뒤 임시 입고로 편입할 수 있습니다.";
    }

    private async Task RegisterUnplannedInboundAsync()
    {
        try
        {
            var result = await ViewModel.입고Workflow.RegisterUnplannedInboundAsync(new UnplannedInboundRegistrationRequest(
                unplannedProductBarcode,
                unplannedInboundBundleBarcode,
                unplannedProductName,
                unplannedSupplier,
                unplannedReceivedQuantity,
                unplannedStorageType,
                unplannedContractLinkStatus,
                unplannedExceptionReason));

            expectedProducts = await ViewModel.입고Workflow.GetExpectedProductsAsync();
            selectedProduct = result.Product;
            productBarcode = result.Product.Barcode;
            inboundBundleBarcode = result.InboundBundleBarcode;
            receivedQuantity = result.ReceivedQuantity;
            isInboundConfirmed = true;
            showUnplannedInboundForm = false;
            messageSeverity = Severity.Warning;
            message = result.Message;
        }
        catch (InvalidOperationException ex)
        {
            messageSeverity = Severity.Error;
            message = ex.Message;
        }
    }

    private void CancelUnplannedInbound()
    {
        showUnplannedInboundForm = false;
        message = null;
    }

    private void Clear()
    {
        productBarcode = string.Empty;
        selectedProduct = null;
        receivedQuantity = 0;
        inboundBundleBarcode = string.Empty;
        isInboundConfirmed = false;
        showUnplannedInboundForm = false;
        message = null;
    }

    private void PrefillUnplannedInbound()
    {
        unplannedProductBarcode = productBarcode;
        unplannedInboundBundleBarcode = BuildDefaultBundleBarcode("UNPLANNED");
        unplannedProductName = string.Empty;
        unplannedSupplier = string.Empty;
        unplannedReceivedQuantity = Math.Max(1, receivedQuantity);
        unplannedStorageType = "상온";
        unplannedContractLinkStatus = "계약 미연결";
        unplannedExceptionReason = "입고 예정 또는 계약 연결 전 현장 반입";
    }

    private static string BuildInboundRelatedParties(InboundExpectedProductDto product)
        => product.IsUnplannedInbound
            ? $"입고 담당자 · 반입자 {product.Supplier} · 계약 확인 담당자 · 검수 담당자"
            : $"입고 담당자 · 공급사 {product.Supplier} · 화주 재고 담당자 · 검수 담당자";

    private static string BuildInboundContactContext(InboundExpectedProductDto product)
        => product.IsUnplannedInbound
            ? $"{product.Supplier}, 계약 확인 담당자, 검수 담당자"
            : $"{product.Supplier}, 화주 재고 담당자, 검수 담당자";

    private static string BuildDefaultBundleBarcode(string seed)
    {
        var value = new string((seed ?? string.Empty)
            .Where(char.IsLetterOrDigit)
            .TakeLast(8)
            .ToArray());
        return $"BND:{(string.IsNullOrWhiteSpace(value) ? "INBOUND" : value)}";
    }
}
