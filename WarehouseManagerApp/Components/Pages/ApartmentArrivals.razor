@page "/warehouse/apartment/arrivals"
@inherits MvvmComponentBase<공동주택반입예정PageViewModel>
@inject NavigationManager Navigation

<PageTitle>공동주택 반입 예정</PageTitle>

<WarehousePageShell Model="@ViewModel"
                    Title="공동주택 반입 예정"
                    Description="단지 물류 거점에 도착할 화물과 예정 시간을 확인합니다."
                    Icon="@Icons.Material.Filled.Schedule"
                    Color="Color.Secondary">
    <Actions>
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Disabled="@ViewModel.처리중"
                       OnClick="ReloadAsync">
                새로고침
            </MudButton>
            <MudButton Href="@WarehouseManagerRoutes.ApartmentInbound"
                       Variant="Variant.Filled"
                       Color="Color.Secondary"
                       EndIcon="@Icons.Material.Filled.ChevronRight">
                입고 확인
            </MudButton>
        </MudStack>
    </Actions>
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(ViewModel.입고예정조회.오류메시지))
        {
            <MudAlert Severity="Severity.Error">@ViewModel.입고예정조회.오류메시지</MudAlert>
        }

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <HongdalOperationState ViewModel="@ViewModel.입고예정조회" />
            <WarehouseExpectedInboundGrid @ref="_grid"
                                          ViewModel="@ViewModel.입고예정조회"
                                          Color="Color.Secondary"
                                          SelectLabel="입고 확인"
                                          OnSelect="OpenInbound" />
        </MudPaper>
    </ChildContent>
</WarehousePageShell>

@code {
    private WarehouseExpectedInboundGrid? _grid;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        EnsureProfile();
    }

    private Task ReloadAsync() => _grid?.ReloadAsync() ?? Task.CompletedTask;

    private void OpenInbound(입고요청항목응답 item)
    {
        ViewModel.입고예정조회.선택(item.Id);
        Navigation.NavigateTo(WarehouseManagerRoutes.ApartmentInbound);
    }

    private void EnsureProfile()
    {
        if (!string.Equals(ViewModel.세션.운영ProfileCode, 창고운영ProfileCodes.공동주택물류, StringComparison.OrdinalIgnoreCase))
        {
            ViewModel.세션.운영Profile설정(창고운영ProfileCodes.공동주택물류);
        }
    }
}
