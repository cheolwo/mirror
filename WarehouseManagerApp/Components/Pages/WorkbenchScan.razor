@page "/work/{ProcessCode}/workbench"
@inherits MvvmComponentBase<창고작업대스캔PageViewModel>
@inject NavigationManager Navigation

<PageTitle>@Definition.Title</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">@Definition.Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Definition.Description</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h6">작업대 바코드</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Definition.InputHelp</MudText>
                    </MudStack>
                    <MudChip T="string" Color="@Definition.Color" Variant="Variant.Outlined">@Definition.Label</MudChip>
                </MudStack>

                <MudTextField T="string"
                              Label="작업대 바코드"
                              Value="@ViewModel.작업대Barcode"
                              ValueChanged="OnBarcodeChanged"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              AutoFocus="true"
                              Placeholder="@Definition.Placeholder"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                              OnKeyDown="OnKeyDownAsync" />

                @if (!string.IsNullOrWhiteSpace(ViewModel.안내메시지))
                {
                    <MudAlert Severity="@messageSeverity">@ViewModel.안내메시지</MudAlert>
                }

                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    <MudButton Variant="Variant.Filled"
                               Color="@Definition.Color"
                               StartIcon="@Icons.Material.Filled.Done"
                               Disabled="@(!CanConfirm)"
                               OnClick="ConfirmAsync">
                        작업대 확인
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Backspace"
                               OnClick="Clear">
                        다시 입력
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            샘플 바코드: 입고 작업대 WB:IN-01, 포장 작업대 WB:PK-03
        </MudAlert>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string ProcessCode { get; set; } = WarehouseWorkProcessCodes.Inbound;

    private Severity messageSeverity = Severity.Info;

    private WorkbenchDefinition Definition => ResolveDefinition(ProcessCode);

    private bool CanConfirm => ViewModel.확인가능;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ViewModel.초기화();
    }

    private Task OnBarcodeChanged(string value)
    {
        ViewModel.작업대Barcode = (value ?? string.Empty).Trim();
        messageSeverity = Severity.Info;
        return Task.CompletedTask;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await ConfirmAsync();
        }
    }

    private async Task ConfirmAsync()
    {
        if (!CanConfirm)
        {
            messageSeverity = Severity.Warning;
            ViewModel.작업대확인();
            return;
        }

        if (!ViewModel.작업대확인())
        {
            messageSeverity = Severity.Warning;
            return;
        }

        messageSeverity = Severity.Success;
        await Task.Delay(300);
        Navigation.NavigateTo(Definition.NextRoute);
    }

    private void Clear()
    {
        ViewModel.초기화();
        messageSeverity = Severity.Info;
    }

    private static WorkbenchDefinition ResolveDefinition(string? processCode)
    {
        return Definitions.FirstOrDefault(x => string.Equals(x.ProcessCode, processCode, StringComparison.OrdinalIgnoreCase))
            ?? Definitions[0];
    }

    private static readonly IReadOnlyList<WorkbenchDefinition> Definitions =
    [
        new(
            WarehouseWorkProcessCodes.Inbound,
            "입고 작업대 확인",
            "입고 작업자가 사용할 검수/입고 작업대를 바코드로 확인합니다.",
            "입고",
            "입고 검수대 또는 입고 작업대에 부착된 바코드를 입력합니다.",
            "WB:IN-01",
            Color.Warning,
            WarehouseManagerRoutes.InboundProductScan),
        new(
            WarehouseWorkProcessCodes.Packing,
            "포장 작업대 확인",
            "포장 작업자가 사용할 포장 작업대를 바코드로 확인합니다.",
            "포장",
            "포장대 또는 출고 포장 작업대에 부착된 바코드를 입력합니다.",
            "WB:PK-03",
            Color.Success,
            WarehouseManagerRoutes.WorkBoard)
    ];

    private sealed record WorkbenchDefinition(
        string ProcessCode,
        string Title,
        string Description,
        string Label,
        string InputHelp,
        string Placeholder,
        Color Color,
        string NextRoute);
}
