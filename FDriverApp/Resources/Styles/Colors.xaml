<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#0F766E</Color>
    <Color x:Key="PrimaryDark">#5EEAD4</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DDF5ED</Color>
    <Color x:Key="SecondaryDarkText">#5EEAD4</Color>
    <Color x:Key="Tertiary">#173B57</Color>

    <Color x:Key="DarkBackground">#17171a</Color>
    <Color x:Key="LightOnDarkBackground">#C3C3C3</Color>
    <Color x:Key="LightBackground">#F3F7F5</Color>
    <Color x:Key="DarkOnLightBackground">#0D0D0D</Color>

    <Color x:Key="LightSecondaryBackground">#E0E0E0</Color>
    <Color x:Key="DarkSecondaryBackground">#222228</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- 기사 화면의 의미 색상. 공통 UI 디자인 기준과 같은 역할로 사용한다. -->
    <Color x:Key="DriverCanvas">#F5F7FA</Color>
    <Color x:Key="DriverSurface">#FFFFFF</Color>
    <Color x:Key="DriverSurfaceSubtle">#F5F7FA</Color>
    <Color x:Key="DriverBorder">#DCE5E9</Color>
    <Color x:Key="DriverText">#172B36</Color>
    <Color x:Key="DriverTextSecondary">#586B78</Color>
    <Color x:Key="DriverAccent">#0F766E</Color>
    <Color x:Key="DriverAccentStrong">#0B5C56</Color>
    <Color x:Key="DriverAccentSubtle">#EAF5F3</Color>
    <Color x:Key="DriverAccentBorder">#BDDCD5</Color>
    <Color x:Key="DriverInformation">#1D4ED8</Color>
    <Color x:Key="DriverWarning">#92400E</Color>
    <Color x:Key="DriverDanger">#B42318</Color>
    <Color x:Key="DriverDisabled">#E4EBEF</Color>
    <Color x:Key="DriverCanvasDark">#142128</Color>
    <Color x:Key="DriverSurfaceDark">#1C2C34</Color>
    <Color x:Key="DriverSurfaceSubtleDark">#243740</Color>
    <Color x:Key="DriverBorderDark">#425860</Color>
    <Color x:Key="DriverTextDark">#EEF5F7</Color>
    <Color x:Key="DriverTextSecondaryDark">#B7C9D1</Color>
    <Color x:Key="DriverAccentDark">#7ADCC9</Color>
    <Color x:Key="DriverAccentSubtleDark">#173E3B</Color>
    <Color x:Key="DriverInformationDark">#A6C5FF</Color>
    <Color x:Key="DriverWarningDark">#FFD19A</Color>
    <Color x:Key="DriverDangerDark">#FFB4AC</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
