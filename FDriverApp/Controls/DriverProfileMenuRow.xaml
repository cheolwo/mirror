<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:FDriverApp.Controls" xmlns:fonts="clr-namespace:Fonts"
    x:Class="FDriverApp.Controls.DriverProfileMenuRow" x:Name="MenuRow"
    x:DataType="controls:DriverProfileMenuRow" MinimumHeightRequest="56">
    <Grid MinimumHeightRequest="56">
        <Button x:Name="MenuButton" Clicked="OnMenuClicked"
            Style="{StaticResource DriverSecondaryButtonStyle}"
            TextColor="{AppThemeBinding Light={StaticResource DriverText}, Dark={StaticResource DriverTextDark}}"
            CornerRadius="12" BorderWidth="0" MinimumHeightRequest="56" HorizontalOptions="Fill"
            SemanticProperties.Description="{Binding Text, Source={x:Reference MenuRow}}">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DriverSurfaceSubtle}, Dark={StaticResource DriverSurfaceSubtleDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DriverAccentSubtle}, Dark={StaticResource DriverAccentSubtleDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Property="BorderWidth" Value="2" />
                            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource DriverAccentStrong}, Dark={StaticResource DriverAccentDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DriverTextSecondary}, Dark={StaticResource DriverTextSecondaryDark}}" />
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DriverDisabled}, Dark={StaticResource DriverSurfaceSubtleDark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>
        <Grid ColumnDefinitions="24,*,20" ColumnSpacing="12" Padding="16,12"
            InputTransparent="True" CascadeInputTransparent="True" AutomationProperties.IsInAccessibleTree="False">
            <Label Text="{Binding Glyph, Source={x:Reference MenuRow}}" FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                FontSize="22" FontAutoScalingEnabled="False" VerticalOptions="Center"
                TextColor="{Binding TextColor, Source={x:Reference MenuButton}, x:DataType=Button}" AutomationProperties.IsInAccessibleTree="False" />
            <Label Grid.Column="1" Text="{Binding Text, Source={x:Reference MenuRow}}"
                Style="{StaticResource DriverBodyStyle}" VerticalOptions="Center" LineBreakMode="WordWrap"
                TextColor="{Binding TextColor, Source={x:Reference MenuButton}, x:DataType=Button}" AutomationProperties.IsInAccessibleTree="False" />
            <Label Grid.Column="2" Text="{x:Static fonts:FluentUI.chevron_down_24_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                FontSize="20" FontAutoScalingEnabled="False" VerticalOptions="Center" Rotation="-90"
                TextColor="{Binding TextColor, Source={x:Reference MenuButton}, x:DataType=Button}" AutomationProperties.IsInAccessibleTree="False" />
        </Grid>
    </Grid>
</ContentView>
