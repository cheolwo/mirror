<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FDriverApp.PageModels"
    x:Class="FDriverApp.Controls.FDriverCompletionFeedbackView"
    x:DataType="models:FDriverCompletionFeedbackState" IsVisible="{Binding HasNotice}">
    <Grid InputTransparent="{Binding IsBrief}" CascadeInputTransparent="False">
        <Grid IsVisible="{Binding IsDialog}" BackgroundColor="#66000000" Padding="24" AutomationId="WorkflowCompletionDialog">
            <Border Style="{StaticResource DriverCardStyle}" VerticalOptions="Center" MaximumWidthRequest="420"
                Padding="24" BackgroundColor="{AppThemeBinding Light={StaticResource DriverSurface}, Dark={StaticResource DriverSurfaceDark}}">
                <VerticalStackLayout Spacing="16">
                    <Path x:Name="DialogIcon" Aspect="Uniform" WidthRequest="36" HeightRequest="36"
                        HorizontalOptions="Start" />
                    <Label Text="{Binding Title}" Style="{StaticResource DriverTitleStyle}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding Message}" Style="{StaticResource DriverBodyStyle}" />
                    <Label Text="{Binding NextStep}" Style="{StaticResource DriverMetadataStyle}" />
                    <Button Text="확인" Command="{Binding DismissCommand}" Style="{StaticResource DriverPrimaryButtonStyle}" AutomationId="WorkflowCompletionDismiss"
                        SemanticProperties.Hint="완료 안내만 닫습니다. 다음 단계를 실행하지 않습니다." />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Border IsVisible="{Binding IsBrief}" Style="{StaticResource DriverCardStyle}" Margin="16,16,16,80" Padding="16"
            VerticalOptions="End" MaximumWidthRequest="480" BackgroundColor="{AppThemeBinding Light={StaticResource DriverSurface}, Dark={StaticResource DriverSurfaceDark}}">
            <Grid ColumnDefinitions="28,*,Auto" ColumnSpacing="12">
                <Path x:Name="BriefIcon" Aspect="Uniform" WidthRequest="28" HeightRequest="28" />
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="{Binding Title}" Style="{StaticResource DriverSectionStyle}" />
                    <Label Text="{Binding NextStep}" Style="{StaticResource DriverMetadataStyle}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="확인" Command="{Binding DismissCommand}" Style="{StaticResource DriverSecondaryButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
