<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:FDriverApp.PageModels"
    x:Class="FDriverApp.Pages.살뜰마트배송Page" x:DataType="models:살뜰마트배송PageViewModel"
    Title="살뜰마트 배송" Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource DriverCanvas}, Dark={StaticResource DriverCanvasDark}}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Button Text="내 정보로 돌아가기" Clicked="OnBackClicked" Style="{StaticResource DriverSecondaryButtonStyle}" />
            <Label Text="살뜰마트 배송" Style="{StaticResource DriverTitleStyle}" />
            <Label Text="{Binding Notice}" Style="{StaticResource DriverMetadataStyle}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Status}" Style="{StaticResource DriverBodyStyle}" SemanticProperties.Description="배송 조회와 요청 결과" />
            <Button Text="다시 조회" Command="{Binding RefreshCommand}" Style="{StaticResource DriverSecondaryButtonStyle}" />
            <Label Text="현재 마트 배송이 없습니다." IsVisible="{Binding IsEmpty}" Style="{StaticResource DriverBodyStyle}" />
            <CollectionView ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                SelectionMode="Single" IsEnabled="{Binding CanSelect}" IsVisible="{Binding HasItems}" HeightRequest="180">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:마트배송표시항목">
                        <Grid Padding="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Text="{Binding Title}" Style="{StaticResource DriverSectionStyle}" />
                            <Label Grid.Row="1" Text="{Binding StateText}" Style="{StaticResource DriverMetadataStyle}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Border Style="{StaticResource DriverCardStyle}" IsVisible="{Binding HasSelection}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding SelectionState}" Style="{StaticResource DriverSectionStyle}" />
                    <Label Text="{Binding PayoutText}" Style="{StaticResource DriverSectionStyle}" />
                    <Label Text="픽업 장소" Style="{StaticResource DriverMetadataStyle}" />
                    <Label Text="{Binding PickupText}" Style="{StaticResource DriverBodyStyle}" LineBreakMode="WordWrap" />
                    <BoxView HeightRequest="1" Color="{StaticResource DriverBorder}" />
                    <Label Text="전달 장소" Style="{StaticResource DriverMetadataStyle}" />
                    <Label Text="{Binding DropoffText}" Style="{StaticResource DriverBodyStyle}" LineBreakMode="WordWrap" />
                    <Button Text="배송 수락" Command="{Binding AcceptCommand}" IsVisible="{Binding SelectedItem.Value.CanAccept}"
                        Style="{StaticResource DriverPrimaryButtonStyle}" />
                    <Button Text="제안 거절" Command="{Binding RejectCommand}" IsVisible="{Binding SelectedItem.Value.CanReject}"
                        Style="{StaticResource DriverSecondaryButtonStyle}" />
                    <VerticalStackLayout IsVisible="{Binding NeedsPickupInput}" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="네 자리 번호로 입력" Style="{StaticResource DriverBodyStyle}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ByNumber}" IsEnabled="{Binding CanChangeCodeKind}" />
                        </Grid>
                        <Label Text="번호 입력을 끄면 전표의 QR 문자열을 직접 입력합니다. 제출하면 바로 픽업됩니다."
                            Style="{StaticResource DriverMetadataStyle}" />
                        <Entry Text="{Binding PickupCode}" Placeholder="네 자리 번호 또는 QR 문자열" MaxLength="512"
                            IsPassword="True" IsEnabled="{Binding CanChangeInput}" FontSize="16" FontAutoScalingEnabled="False"
                            MinimumHeightRequest="48" SemanticProperties.Description="현재 포장 전표 코드 입력" />
                        <Button Text="코드 제출 · 픽업" Command="{Binding PickupCommand}" IsVisible="{Binding SelectedItem.Value.CanPickup}"
                            Style="{StaticResource DriverPrimaryButtonStyle}" />
                    </VerticalStackLayout>
                    <Button Text="전달 완료" Command="{Binding DeliverCommand}" IsVisible="{Binding SelectedItem.Value.CanDeliver}"
                        Style="{StaticResource DriverPrimaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout IsVisible="{Binding HasPendingRequest}" Spacing="8">
                <Label Text="이전 요청을 먼저 확인합니다. 자동으로 다시 보내지 않습니다." Style="{StaticResource DriverBodyStyle}" />
                <Button Text="요청 결과 확인" Command="{Binding CheckResultCommand}" Style="{StaticResource DriverSecondaryButtonStyle}" />
                <Button Text="같은 요청 다시 보내기" Command="{Binding RetryCommand}" Style="{StaticResource DriverSecondaryButtonStyle}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
