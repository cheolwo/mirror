<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:maps="clr-namespace:FDriverApp.Controls"
    xmlns:fonts="clr-namespace:Fonts"
    xmlns:pageModels="clr-namespace:FDriverApp.PageModels"
    xmlns:models="clr-namespace:Ssalddel.Ui.Common.Areas.App.Models;assembly=Ssalddel.Ui.Common"
    x:Class="FDriverApp.Pages.MainPage"
    x:DataType="pageModels:MainPageModel"
    Title="{Binding AppName}"
    BackgroundColor="{AppThemeBinding Light={StaticResource DriverCanvas}, Dark={StaticResource DriverCanvasDark}}">
    <ContentPage.Resources>
        <FontImageSource x:Key="ProfileIcon" Glyph="{x:Static fonts:FluentUI.person_24_regular}"
            FontFamily="{x:Static fonts:FluentUI.FontFamily}" Size="20"
            Color="{AppThemeBinding Light={StaticResource DriverAccentStrong}, Dark={StaticResource DriverAccentDark}}" />
        <FontImageSource x:Key="ProfileSelectedIcon" Glyph="{x:Static fonts:FluentUI.person_24_regular}"
            FontFamily="{x:Static fonts:FluentUI.FontFamily}" Size="20" Color="{StaticResource White}" />
        <Style x:Key="DeliveryStageLabelStyle" TargetType="Label" BasedOn="{StaticResource DriverMetadataStyle}">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DriverAccentStrong}, Dark={StaticResource DriverAccentDark}}" />
        </Style>
        <Style x:Key="DeliveryAddressStyle" TargetType="Label" BasedOn="{StaticResource DriverBodyStyle}">
            <Setter Property="FontAttributes" Value="None" />
            <Setter Property="HorizontalTextAlignment" Value="Start" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="LineHeight" Value="1.15" />
        </Style>
        <Style x:Key="DeliverySectionDividerStyle" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource DriverBorder}, Dark={StaticResource DriverBorderDark}}" />
        </Style>
        <Style x:Key="DriverDetailsIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DriverSecondaryButtonStyle}">
            <Setter Property="maps:DriverActionIcon.Glyph" Value="{x:Static fonts:FluentUI.chevron_down_24_regular}" />
            <Style.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsDeliveryDetailsExpanded}" Value="True">
                    <Setter Property="maps:DriverActionIcon.Glyph" Value="{x:Static fonts:FluentUI.chevron_up_24_regular}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DriverCurrentDeliveryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DriverSecondaryButtonStyle}">
            <Setter Property="maps:DriverActionIcon.Glyph" Value="{x:Static fonts:FluentUI.chevron_down_24_regular}" />
            <Style.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsCurrentDeliveryExpanded}" Value="True">
                    <Setter Property="maps:DriverActionIcon.Glyph" Value="{x:Static fonts:FluentUI.chevron_up_24_regular}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>
    <Grid>
        <Grid IsVisible="{Binding IsRegularWorkspaceVisible}">
                <Grid RowDefinitions="Auto,*">
                    <VerticalStackLayout x:Name="WorkspaceHeader" Grid.Row="0" Padding="16,8" Spacing="8"
                        ZIndex="3" VerticalOptions="Start" BackgroundColor="Transparent"
                        InputTransparent="True" CascadeInputTransparent="False" SizeChanged="OnFoodLayoutSizeChanged">
                        <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Margin="-4"
                            InputTransparent="True" CascadeInputTransparent="False">
                            <Button Style="{StaticResource DriverSecondaryButtonStyle}" Text="배달" Margin="4" Padding="8,8"
                                Clicked="OnDeliveryClicked" SemanticProperties.Description="배달 영역">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Navigation.IsDelivery}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource DriverAccent}" />
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Style="{StaticResource DriverSecondaryButtonStyle}" Text="내 정보" Margin="4" Padding="8,8"
                                ImageSource="{StaticResource ProfileIcon}" ContentLayout="Left,8"
                                Clicked="OnProfileClicked" SemanticProperties.Description="내 정보 영역">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Navigation.IsProfile}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource DriverAccent}" />
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                        <Setter Property="ImageSource" Value="{StaticResource ProfileSelectedIcon}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </FlexLayout>
                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.arrow_left_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Text="배달로 돌아가기"
                            IsVisible="{Binding Navigation.IsAuxiliary}" Clicked="OnDeliveryClicked"
                            HorizontalOptions="Start" />
                        <VerticalStackLayout IsVisible="{Binding Navigation.IsAuxiliary}" Spacing="4">
                            <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding StatusMessage}"
                                TextColor="{AppThemeBinding Light={StaticResource DriverTextSecondary}, Dark={StaticResource DriverTextSecondaryDark}}" />
                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding WorkspaceWarningText}"
                                IsVisible="{Binding HasWorkspaceWarning}" TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                            <Label Style="{StaticResource DriverMetadataStyle}" Text="현재 자동 배차가 중지되어 있습니다."
                                IsVisible="{Binding HasDispatchNotice}" TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding LocationNotice}"
                                IsVisible="{Binding HasLocationWarning}" TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                        </VerticalStackLayout>
                        <Border x:Name="FoodRecommendationNotice" Style="{StaticResource DriverCardStyle}"
                            IsVisible="{Binding HasNewRecommendations}"
                            SizeChanged="OnFoodLayoutSizeChanged"
                            BackgroundColor="White"
                            Stroke="{StaticResource DriverBorder}"
                            StrokeThickness="1"
                            Padding="8"
                            HorizontalOptions="Fill"
                            VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="4,4,24,*,Auto" ColumnSpacing="6">
                                <BoxView Color="{Binding NewRecommendationPrimaryColor}" />
                                <BoxView Grid.Column="1" Color="{Binding NewRecommendationSecondaryColor}" IsVisible="{Binding NewRecommendationHasCombinedWork}" />
                                <Path Grid.Column="2" Data="M3 7 L12 2 L21 7 L21 17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 L12 22"
                                    Stroke="#172B36" StrokeThickness="1.6" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="3" Spacing="4">
                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding NewRecommendationNotice}"
                                        FontAttributes="Bold"
                                        TextColor="#172B36" />
                                    <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding NewRecommendationWorkLabel}" TextColor="#172B36" />
                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding NewRecommendationActivityText}" TextColor="#586B78" />
                                </VerticalStackLayout>
                                <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.arrow_right_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Grid.Column="4"
                                    Text="보기"
                                    Padding="8,8" VerticalOptions="Center"
                                    Command="{Binding OpenNewRecommendationsCommand}"
                                    Clicked="OnRecommendationsClicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    <Grid x:Name="WorkspaceAreas" Grid.Row="1" SizeChanged="OnFoodLayoutSizeChanged" ZIndex="0">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding Navigation.IsDelivery}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid x:Name="DeliveryWorkspace" IsVisible="{Binding Navigation.IsDelivery}">
                            <maps:FDriverNativeMapView x:Name="FoodDeliveryMap"
                                Grid.Row="0"
                                PropertyChanged="OnFoodMapPropertyChanged"
                                CenterLatitude="{Binding MapCenterLatitude}"
                                CenterLongitude="{Binding MapCenterLongitude}"
                                CurrentLocationLatitude="{Binding CurrentLocationLatitude}"
                                CurrentLocationLongitude="{Binding CurrentLocationLongitude}"
                                Zoom="{Binding MapZoom, Mode=TwoWay}"
                                SelectedRequestId="{Binding FocusedMapRequestId}"
                                RecenterRequestVersion="{Binding MapRecenterRequestVersion}"
                                IsFollowingCurrentLocation="{Binding IsFollowingCurrentLocation, Mode=TwoWay}"
                                HasCurrentLocation="{Binding HasCurrentLocation}"
                                Markers="{Binding MapMarkers}"
                                RouteOverlays="{Binding SelectedRouteOverlays}"
                                ShowTrafficLayer="False"
                                ShowLocationButton="False"
                                ShowCurrentLocationOverlay="{Binding HasCurrentLocation}"
                                MarkerSelected="OnMapMarkerSelected" />
                            <Border x:Name="FoodDispatchReceptionControl" Style="{StaticResource DriverCardStyle}"
                                ZIndex="1" HorizontalOptions="Start" VerticalOptions="Start" Margin="8" Padding="12,4" MaximumWidthRequest="340">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="48">
                                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="신규 배차 받기" />
                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding DispatchReceptionStatusText}" />
                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding DispatchAutomaticStopNotice}"
                                            IsVisible="{Binding DispatchAutomaticallyPaused}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="FoodDispatchReceptionSwitch" Grid.Column="1"
                                        IsToggled="{Binding IsDispatchReceptionOn, Mode=OneWay}"
                                        IsEnabled="{Binding CanUseDispatchReceptionSwitch}"
                                        Toggled="OnDispatchReceptionToggled"
                                        SemanticProperties.Description="신규 배차 받기"
                                        SemanticProperties.Hint="{Binding DispatchIntentNotice}" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout x:Name="FoodMapTools" Grid.Row="0" ZIndex="1"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="8" Spacing="8"
                                InputTransparent="True" CascadeInputTransparent="False">
                            <Border x:Name="FoodMapLegend" Style="{StaticResource DriverCardStyle}"
                                IsVisible="{Binding HasRouteSelection}" Padding="8"
                                HorizontalOptions="End" VerticalOptions="Start" SizeChanged="OnFoodLayoutSizeChanged">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsMapReady, Source={x:Reference FoodDeliveryMap}, x:DataType='maps:FDriverNativeMapView'}" Value="False">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#F57C00" BackgroundColor="Transparent" VerticalOptions="Center" />
                                        <Label Style="{StaticResource DriverMetadataStyle}" Grid.Column="1" Text="픽업: 음식점" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#2563EB" BackgroundColor="Transparent" VerticalOptions="Center" />
                                        <Label Style="{StaticResource DriverMetadataStyle}" Grid.Column="1" Text="전달: 고객 주소" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                            <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.my_location_24_regular}" x:Name="FoodMapRecenterButton" Style="{StaticResource DriverSecondaryButtonStyle}" Text="현위치"
                                HorizontalOptions="End" VerticalOptions="Start"
                                SizeChanged="OnFoodLayoutSizeChanged"
                                Command="{Binding RecenterMapCommand}" IsEnabled="{Binding HasCurrentLocation}"
                                SemanticProperties.Description="지도에서 현재 위치로 돌아가기">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsMapReady, Source={x:Reference FoodDeliveryMap}, x:DataType='maps:FDriverNativeMapView'}" Value="False">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsFollowingCurrentLocation}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource DriverAccentSubtle}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            </VerticalStackLayout>
                            <Border x:Name="DeliveryCard" Style="{StaticResource DriverCardStyle}" Grid.Row="0"
                                ZIndex="2" VerticalOptions="End" Margin="8,0,8,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource DriverSurfaceSubtle}, Dark={StaticResource DriverSurfaceSubtleDark}}"
                                StrokeThickness="0"
                                Padding="16" SizeChanged="OnFoodLayoutSizeChanged">
                                <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                    <ScrollView x:Name="WorkspaceScroll" Scrolled="OnWorkspaceScrolled">
                                        <VerticalStackLayout x:Name="DeliveryCardBodyContent" Spacing="8"
                                            SizeChanged="OnFoodLayoutSizeChanged">
                                            <VerticalStackLayout x:Name="WorkspaceSummarySection" Spacing="8">
                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding WorkspaceWarningText}"
                                                    IsVisible="{Binding HasWorkspaceWarning}" TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding LocationNotice}"
                                                    IsVisible="{Binding HasTaskLocationWarning}" TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                                                <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.arrow_clockwise_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Text="위치 다시 확인"
                                                    IsVisible="{Binding HasTaskLocationWarning}" Command="{Binding RetryMapLocationCommand}" />
                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="현재 자동 배차가 중지되어 있습니다."
                                                    IsVisible="{Binding HasTaskDispatchNotice}" TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                                                <VerticalStackLayout IsVisible="{Binding IsWaitingForDelivery}" Spacing="8">
                                                    <Label Style="{StaticResource DriverTitleStyle}" Text="{Binding WaitingTitle}" />
                                                    <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding WaitingNotice}" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout x:Name="ActiveDeliverySection" IsVisible="{Binding HasActiveWork}" Spacing="12">
                                                    <Border x:Name="CurrentDeliverySummaryCard" Style="{StaticResource DriverCardStyle}" IsVisible="{Binding IsCurrentDeliverySummaryVisible}" Padding="16">
                                                    <VerticalStackLayout Spacing="8">
                                                        <Label Style="{StaticResource DeliveryStageLabelStyle}" Text="{Binding CurrentDeliveryStageText}" SemanticProperties.HeadingLevel="Level2" />
                                                        <Label Style="{StaticResource DeliveryAddressStyle}" Text="{Binding CurrentDeliveryTargetText}" />
                                                        <Label Style="{StaticResource DriverValueStyle}" Text="{Binding CurrentDeliveryFeeText}" />
                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding RouteStatusText}" />
                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding StatusMessage}" />
                                                    </VerticalStackLayout>
                                                    </Border>
                                                    <VerticalStackLayout IsVisible="{Binding IsCurrentDeliveryContentVisible}" Spacing="12">
                                                    <Border x:Name="PickupInformationCard" Style="{StaticResource DriverCardStyle}" IsVisible="{Binding HasPickupStage}" Padding="16">
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Style="{StaticResource DeliveryStageLabelStyle}" Text="{Binding CurrentDeliveryStageText}" SemanticProperties.HeadingLevel="Level2" />
                                                            <Label Style="{StaticResource DriverSectionStyle}" Text="픽업지" SemanticProperties.HeadingLevel="Level2" />
                                                            <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding ActiveDelivery.RestaurantName}" FontAttributes="Bold" />
                                                            <Label Style="{StaticResource DeliveryAddressStyle}" Text="{Binding CurrentDeliveryAddressText}" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding PickupExperienceText}"
                                                                IsVisible="{Binding HasPickupExperience}" LineBreakMode="WordWrap" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding PickupPreparationTimeText}" IsVisible="{Binding HasPickupPreparationTime}" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding StatusMessage}" />
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="진행 상황" SemanticProperties.HeadingLevel="Level3" />
                                                                <BoxView Grid.Column="1" Style="{StaticResource DeliverySectionDividerStyle}" />
                                                            </Grid>
                                                            <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding CurrentDeliveryActionGuide}" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding RouteStatusText}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border x:Name="DestinationCard" Style="{StaticResource DriverCardStyle}" IsVisible="{Binding HasDeliveryStage}" Padding="16">
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Style="{StaticResource DeliveryStageLabelStyle}" Text="{Binding CurrentDeliveryStageText}" SemanticProperties.HeadingLevel="Level2" />
                                                            <Label Style="{StaticResource DriverSectionStyle}" Text="전달지" SemanticProperties.HeadingLevel="Level2" />
                                                            <Label Style="{StaticResource DeliveryAddressStyle}" Text="{Binding CurrentDeliveryAddressText}" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding DestinationExperienceText}"
                                                                IsVisible="{Binding HasDestinationExperience}" LineBreakMode="WordWrap" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding DestinationExperienceSecondText}"
                                                                IsVisible="{Binding HasDestinationSecondExperience}" LineBreakMode="WordWrap" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding StatusMessage}" />
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="진행 상황" SemanticProperties.HeadingLevel="Level3" />
                                                                <BoxView Grid.Column="1" Style="{StaticResource DeliverySectionDividerStyle}" />
                                                            </Grid>
                                                            <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding CurrentDeliveryActionGuide}" />
                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding RouteStatusText}"
                                                                TextColor="{AppThemeBinding Light={StaticResource DriverInformation}, Dark={StaticResource DriverInformationDark}}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border x:Name="CustomerRequestCard" Style="{StaticResource DriverCardStyle}" IsVisible="{Binding HasDeliveryRecipient}" Padding="16">
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Style="{StaticResource DriverSectionStyle}" Text="고객 요청 사항" SemanticProperties.HeadingLevel="Level2" />
                                                            <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding ActiveDelivery.DeliveryInstructionsText}" LineBreakMode="WordWrap" />
                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="수령인 정보" SemanticProperties.HeadingLevel="Level3" />
                                                                <BoxView Grid.Column="1" Style="{StaticResource DeliverySectionDividerStyle}" />
                                                            </Grid>
                                                            <VerticalStackLayout Spacing="4">
                                                                <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding ActiveDelivery.RecipientNameText}" FontAttributes="Bold" />
                                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ActiveDelivery.RecipientRelationshipText}" />
                                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ActiveDelivery.RecipientContactText}" />
                                                            </VerticalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    <Border x:Name="OrderInformationCard" Style="{StaticResource DriverCardStyle}" Padding="16">
                                                        <VerticalStackLayout Spacing="8">
                                                            <Label Style="{StaticResource DriverSectionStyle}" Text="주문 정보" SemanticProperties.HeadingLevel="Level2" />
                                                            <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding ActiveDelivery.OrderSummary}" IsVisible="{Binding HasActiveWork}" FontAttributes="Bold" />
                                                            <Label Style="{StaticResource DriverValueStyle}" Text="{Binding CurrentDeliveryFeeText}" />
                                                            <Button Style="{StaticResource DriverDetailsIconButtonStyle}" Text="{Binding DeliveryDetailsToggleText}"
                                                                Command="{Binding ToggleDeliveryDetailsCommand}" />
                                                            <VerticalStackLayout IsVisible="{Binding IsDeliveryDetailsExpanded}" Spacing="8">
                                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding PickupPointText}" IsVisible="{Binding HasPickupStage}" LineBreakMode="WordWrap" />
                                                                <VerticalStackLayout IsVisible="{Binding HasActiveWork}" Spacing="4">
                                                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="배달료 산정 근거" SemanticProperties.HeadingLevel="Level3" />
                                                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ActiveDelivery.PricingDistanceText}" />
                                                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ActiveDelivery.PricingDistanceFeeText}" />
                                                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ActiveDelivery.PricingRateText}" />
                                                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ActiveDelivery.PricingComponentsText}" LineBreakMode="WordWrap" />
                                                                    <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ActiveDelivery.PricingPolicyText}" LineBreakMode="WordWrap" />
                                                                </VerticalStackLayout>
                                                                <VerticalStackLayout IsVisible="{Binding HasActiveWork}" Spacing="8">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="현장 처리" SemanticProperties.HeadingLevel="Level3" />
                                                                        <BoxView Grid.Column="1" Style="{StaticResource DeliverySectionDividerStyle}" />
                                                                    </Grid>
                                                                    <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.stop_24_regular}" Style="{StaticResource DriverDangerButtonStyle}" Text="현장 중단"
                                                                        Command="{Binding OpenInterruptionCommand}" IsEnabled="{Binding CanOpenInterruption}" />
                                                                    <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.warning_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Text="이 배달 문제 접수"
                                                                        Clicked="OnProblemClicked" IsVisible="{Binding ActiveDelivery.HasSupportSource}" />
                                                                </VerticalStackLayout>
                                                            </VerticalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                                <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding CurrentDeliveryTargetText}"
                                                    IsVisible="{Binding HasSelectedRecommendationSummary}" LineBreakMode="WordWrap" />
                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding DispatchIntentNotice}"
                                                    IsVisible="{Binding HasRouteSelection}"
                                                    TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding StatusMessage}"
                                                    IsVisible="{Binding HasDeliveryStatusNotice}" />
                                            </VerticalStackLayout>
                                            <Button Style="{StaticResource DriverDetailsIconButtonStyle}" Text="{Binding DeliveryDetailsToggleText}"
                                                IsVisible="{Binding HasDeliveryDetails}" Command="{Binding ToggleDeliveryDetailsCommand}">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button" Binding="{Binding IsCurrentDeliveryContentVisible}" Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                            <VerticalStackLayout IsVisible="{Binding IsDeliveryDetailsVisible}" Spacing="16">
                                                <VerticalStackLayout x:Name="RecommendationSection" IsVisible="{Binding HasRecommendationContent}" Spacing="8">
                                                    <BoxView Style="{StaticResource DeliverySectionDividerStyle}" Margin="0,8" />
                                                    <VerticalStackLayout IsVisible="{Binding HasBundleCandidates}" Spacing="8">
                                                        <Label Style="{StaticResource DriverSectionStyle}" Text="묶음 배달 추천" FontAttributes="Bold" />
                                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding BundleCandidateItems}" Spacing="8">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="pageModels:FoodDeliveryBundlePreview">
                                                                    <Border Style="{StaticResource DriverCardStyle}" Padding="8">
                                                                        <VerticalStackLayout Spacing="4">
                                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding CountText}" />
                                                                            <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding Reason}" LineBreakMode="WordWrap" />
                                                                            <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding RouteText}" />
                                                                            <Label Style="{StaticResource DriverValueStyle}" Text="{Binding PayoutText}" />
                                                                            <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.checkmark_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Text="묶음 수락"
                                                                                Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=AcceptBundleCommand}"
                                                                                CommandParameter="{Binding .}" />
                                                                        </VerticalStackLayout>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </VerticalStackLayout>
                                                    </VerticalStackLayout>
                                                    <Label Style="{StaticResource DriverSectionStyle}" Text="배달 요청" FontAttributes="Bold" />
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecommendedTicketItems}" Spacing="8">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="pageModels:DeliveryTicketPreview">
                                                                <Border Style="{StaticResource DriverCardStyle}" Padding="8">
                                                                    <VerticalStackLayout Spacing="4">
                                                                        <Grid ColumnDefinitions="4,4,24,*" ColumnSpacing="6" BackgroundColor="White">
                                                                            <BoxView Color="{Binding OfferPrimaryColor}" />
                                                                            <BoxView Grid.Column="1" Color="{Binding OfferSecondaryColor}" IsVisible="{Binding HasCombinedWork}" />
                                                                            <Path Grid.Column="2" Data="M3 7 L12 2 L21 7 L21 17 L12 22 L3 17 Z M3 7 L12 12 L21 7 M12 12 L12 22"
                                                                                Stroke="#172B36" StrokeThickness="1.6" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                                                                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                                                                <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding OfferLabel}" TextColor="#172B36" />
                                                                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding AssignedActivityText}" TextColor="#586B78" />
                                                                            </VerticalStackLayout>
                                                                        </Grid>
                                                                        <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding OrderSummary}" FontAttributes="Bold" />
                                                                        <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding RestaurantName}" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding RestaurantAddress}" LineBreakMode="WordWrap" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding DropoffAddress, StringFormat='전달지 {0}'}" LineBreakMode="WordWrap" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding RecommendationReason}" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding RemainingText}" FontAttributes="Bold"
                                                                            TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding DistanceText}" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding PricingDistanceText}" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding PricingDistanceFeeText}" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding PricingRateText}" IsVisible="{Binding HasPricingEvidence}" />
                                                                        <Label Style="{StaticResource DriverValueStyle}" Text="{Binding DriverPayoutText}" />
                                                                        <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding WeatherSurchargeText}" IsVisible="{Binding IsWeatherSurchargeApplied}" />
                                                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.directions_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Text="지도에서 선택"
                                                                            Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=SelectTicketCommand}"
                                                                            CommandParameter="{Binding .}" />
                                                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.checkmark_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Text="수락"
                                                                            Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=AcceptTicketCommand}"
                                                                            CommandParameter="{Binding .}" IsEnabled="{Binding CanAccept}" />
                                                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.dismiss_24_regular}" Style="{StaticResource DriverDangerButtonStyle}" Text="거절"
                                                                            Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=RejectTicketCommand}"
                                                                            CommandParameter="{Binding .}" IsEnabled="{Binding CanReject}" />
                                                                    </VerticalStackLayout>
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                    <Grid x:Name="DeliveryPrimaryFooter" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasDeliveryFooter}"
                                        MinimumHeightRequest="48" SizeChanged="OnFoodLayoutSizeChanged">
                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.play_24_regular}" Style="{StaticResource DriverPrimaryButtonStyle}" Text="운행 시작"
                                            IsVisible="{Binding IsStartWorkPrimaryAction}" Command="{Binding ToggleWorkCommand}" IsEnabled="{Binding CanToggleWork}" />
                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.arrow_clockwise_24_regular}" Style="{StaticResource DriverPrimaryButtonStyle}" Text="위치 다시 확인"
                                            IsVisible="{Binding IsWaitingLocationPrimaryAction}" Command="{Binding RetryMapLocationCommand}" IsEnabled="{Binding CanToggleWork}" />
                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.checkmark_24_regular}" Style="{StaticResource DriverPrimaryButtonStyle}" Text="{Binding CurrentDeliveryPrimaryActionLabel}"
                                            IsVisible="{Binding IsCompletionPrimaryAction}" Command="{Binding CompleteDeliveryCommand}" IsEnabled="{Binding CanCompleteDelivery}" />
                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.box_checkmark_24_regular}" Style="{StaticResource DriverPrimaryButtonStyle}" Text="{Binding CurrentDeliveryPrimaryActionLabel}"
                                            IsVisible="{Binding IsPickupPrimaryAction}" Command="{Binding ConfirmPickupCommand}" IsEnabled="{Binding CanConfirmPickup}" />
                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.building_shop_24_regular}" Style="{StaticResource DriverPrimaryButtonStyle}" Text="{Binding CurrentDeliveryPrimaryActionLabel}"
                                            IsVisible="{Binding IsArrivalPrimaryAction}" Command="{Binding RecordRestaurantArrivalCommand}" IsEnabled="{Binding CanRecordArrival}" />
                                        <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.checkmark_24_regular}" Style="{StaticResource DriverPrimaryButtonStyle}" Text="선택한 배달 수락"
                                            IsVisible="{Binding IsRecommendationPrimaryAction}" Command="{Binding AcceptSelectedTicketCommand}" IsEnabled="{Binding CanAcceptSelectedTicket}" />
                                        <Button Grid.Column="1" Style="{StaticResource DriverCurrentDeliveryIconButtonStyle}" Text="{Binding CurrentDeliveryToggleText}"
                                            IsVisible="{Binding HasActiveWork}" Clicked="OnCurrentDeliveryCardToggleClicked"
                                            SemanticProperties.Description="현재 배달 정보 접기 또는 펼치기" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <ScrollView x:Name="ProfileScroll" IsVisible="{Binding Navigation.IsProfile}"
                            Scrolled="OnWorkspaceScrolled"
                            BackgroundColor="{AppThemeBinding Light={StaticResource DriverSurface}, Dark={StaticResource DriverSurfaceDark}}">
                            <VerticalStackLayout Padding="16" x:Name="ProfileSection" Spacing="{StaticResource DriverSpaceSmall}">
                                <Label Style="{StaticResource DriverSectionStyle}" Text="내 정보" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DriverText}, Dark={StaticResource DriverTextDark}}" />
                                <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding SignedInUserText}" TextColor="{AppThemeBinding Light={StaticResource DriverTextSecondary}, Dark={StaticResource DriverTextSecondaryDark}}" />
                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding SettlementText}" TextColor="{AppThemeBinding Light={StaticResource DriverTextSecondary}, Dark={StaticResource DriverTextSecondaryDark}}" />
                                <Border Style="{StaticResource DriverCardStyle}" Padding="0">
                                    <maps:DriverProfileMenuRow Text="배달 내역" Glyph="{x:Static fonts:FluentUI.list_24_regular}"
                                        Clicked="OnSettlementClicked" />
                                </Border>
                                <Border Style="{StaticResource DriverCardStyle}" Padding="0">
                                    <maps:DriverProfileMenuRow Text="살뜰마트 배송" Glyph="{x:Static fonts:FluentUI.list_24_regular}"
                                        Clicked="OnMartDeliveriesClicked" />
                                </Border>
                                <Label Style="{StaticResource DriverSectionStyle}" Text="설정" Margin="0,16,0,0" />
                                <Border Style="{StaticResource DriverCardStyle}" Padding="0">
                                    <VerticalStackLayout Spacing="0">
                                        <maps:DriverProfileMenuRow Text="받을 업무·적재 설정" Glyph="{x:Static fonts:FluentUI.list_24_regular}"
                                            Clicked="OnWorkPreferencesClicked" />
                                        <BoxView Style="{StaticResource DeliverySectionDividerStyle}" Margin="16,0" />
                                        <maps:DriverProfileMenuRow Text="복귀 권역" Glyph="{x:Static fonts:FluentUI.my_location_24_regular}"
                                            Clicked="OnReturnAreaSettingsClicked" />
                                        <BoxView Style="{StaticResource DeliverySectionDividerStyle}" Margin="16,0" />
                                        <maps:DriverProfileMenuRow Text="알림 설정" Glyph="{x:Static fonts:FluentUI.alert_24_regular}"
                                            Clicked="OnNotificationSettingsClicked" />
                                        <BoxView Style="{StaticResource DeliverySectionDividerStyle}" Margin="16,0" />
                                        <maps:DriverProfileMenuRow Text="배달 경험 공유" Glyph="{x:Static fonts:FluentUI.people_24_regular}"
                                            Clicked="OnDeliveryExperienceSettingsClicked" />
                                        <BoxView Style="{StaticResource DeliverySectionDividerStyle}" Margin="16,0" />
                                        <maps:DriverProfileMenuRow Text="합의 요금표" Glyph="{x:Static fonts:FluentUI.book_24_regular}"
                                            Clicked="OnAgreedRatesClicked" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding NotificationSettingsNotice}" />
                                <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.sign_out_24_regular}" Style="{StaticResource DriverDangerButtonStyle}" Text="로그아웃"
                                    Command="{Binding LogoutCommand}" HorizontalOptions="Start" />
                                <BoxView Style="{StaticResource DeliverySectionDividerStyle}" Margin="0,16,0,8" IsVisible="{Binding IsOnDuty}" />
                                <Label Style="{StaticResource DriverMetadataStyle}" Text="진행 중인 배달을 마치면 운행을 종료할 수 있습니다."
                                    IsVisible="{Binding HasActiveWork}" />
                                <Button x:Name="ProfileEndWorkButton" maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.stop_24_regular}"
                                    Style="{StaticResource DriverDangerButtonStyle}" Text="운행 종료" HorizontalOptions="Fill"
                                    IsVisible="{Binding IsOnDuty}" IsEnabled="{Binding CanToggleWork}" Command="{Binding ToggleWorkCommand}" />
                            </VerticalStackLayout>
                        </ScrollView>
                    </Grid>
                </Grid>
        </Grid>
        <ScrollView IsVisible="{Binding IsExceptionWorkspaceVisible}"
            BackgroundColor="{AppThemeBinding Light={StaticResource DriverSurface}, Dark={StaticResource DriverSurfaceDark}}">
            <VerticalStackLayout Padding="16,24" Spacing="16">
                <Label Style="{StaticResource DriverTitleStyle}" Text="현장 배달 중단" />
                <Label Style="{StaticResource DriverBodyStyle}" Text="{Binding ExceptionEditor.DeliveryText}" />
                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ExceptionEditor.PreparationText}" />
                <Label Style="{StaticResource DriverBodyStyle}" Text="안전한 곳에서 사유를 기록해 주세요. 중단 사유만으로 기사 책임을 확정하지 않습니다." />
                <Picker Title="중단 사유" ItemsSource="{Binding ExceptionEditor.Reasons}"
                    FontSize="16" FontAutoScalingEnabled="False"
                    ItemDisplayBinding="{Binding Label, x:DataType='pageModels:FDriverInterruptionReason'}"
                    SelectedItem="{Binding ExceptionEditor.SelectedReason}" IsEnabled="{Binding CanEditInterruption}"
                    MinimumHeightRequest="48" />
                <Editor Placeholder="현장 상황 메모 (선택, 500자 이내)" Text="{Binding ExceptionEditor.Memo}"
                    FontSize="16" FontAutoScalingEnabled="False"
                    MaxLength="500" AutoSize="TextChanges" MinimumHeightRequest="120"
                    IsEnabled="{Binding CanEditInterruption}" />
                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding ExceptionEditor.Notice}"
                    TextColor="{AppThemeBinding Light={StaticResource DriverWarning}, Dark={StaticResource DriverWarningDark}}" />
                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding StatusMessage}" />
                <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.stop_24_regular}" Style="{StaticResource DriverDangerButtonStyle}" Text="{Binding ExceptionEditor.ActionLabel}"
                    Command="{Binding SubmitInterruptionCommand}" IsEnabled="{Binding CanSubmitInterruption}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ExceptionEditor.HasPendingRequest}" Value="True">
                            <Setter Property="maps:DriverActionIcon.Glyph" Value="{x:Static fonts:FluentUI.arrow_clockwise_24_regular}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button maps:DriverActionIcon.Glyph="{x:Static fonts:FluentUI.arrow_left_24_regular}" Style="{StaticResource DriverSecondaryButtonStyle}" Text="현재 배달로 돌아가기"
                    Command="{Binding CloseInterruptionCommand}" />
                <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
        <Border Style="{StaticResource DriverCardStyle}" IsVisible="{Binding IsRestoringSession}"
            Padding="24" Margin="24" VerticalOptions="Center" MaximumWidthRequest="420">
            <VerticalStackLayout Spacing="{StaticResource DriverSpaceMedium}">
                <ActivityIndicator IsRunning="{Binding IsRestoringSession}" Color="{StaticResource DriverAccent}" />
                <Label Style="{StaticResource DriverBodyStyle}" Text="로그인 정보를 확인하고 있습니다." />
            </VerticalStackLayout>
        </Border>
        <Border Style="{StaticResource DriverCardStyle}" IsVisible="{Binding IsSignedOut}"
            BackgroundColor="{AppThemeBinding Light={StaticResource DriverSurface}, Dark={StaticResource DriverSurfaceDark}}"
            Stroke="{AppThemeBinding Light={StaticResource DriverBorder}, Dark={StaticResource DriverBorderDark}}"
            StrokeThickness="1"
            Padding="24"
            Margin="24"
            HorizontalOptions="Fill"
            VerticalOptions="Center"
            MaximumWidthRequest="420">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="{StaticResource DriverSpaceMedium}">
                <Label Style="{StaticResource DriverMetadataStyle}" Text="SSALDDEL DRIVER" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DriverAccentStrong}, Dark={StaticResource DriverAccentDark}}" CharacterSpacing="1.6" />
                <Label Style="{StaticResource DriverTitleStyle}" Text="오늘의 배달을 시작하세요" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource DriverText}, Dark={StaticResource DriverTextDark}}" />
                <Label Style="{StaticResource DriverBodyStyle}" Text="기사 아이디로 로그인하면 추천 배달과 현재 경로를 바로 확인할 수 있습니다." TextColor="{AppThemeBinding Light={StaticResource DriverTextSecondary}, Dark={StaticResource DriverTextSecondaryDark}}" />
                <Entry Style="{StaticResource DriverFieldStyle}" Placeholder="아이디 또는 이메일"
                    Text="{Binding LoginId}"
                    Keyboard="Email" />
                <Entry Style="{StaticResource DriverFieldStyle}" Placeholder="비밀번호"
                    Text="{Binding Password}"
                    IsPassword="True" />
                <Button Style="{StaticResource DriverPrimaryButtonStyle}" Text="로그인"
                    Command="{Binding LoginCommand}" IsEnabled="{Binding CanLogin}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="{StaticResource DriverAccent}" />
                <Label Style="{StaticResource DriverMetadataStyle}" Text="{Binding StatusMessage}" TextColor="{AppThemeBinding Light={StaticResource DriverDanger}, Dark={StaticResource DriverDangerDark}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
