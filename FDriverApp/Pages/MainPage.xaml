<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:FDriverApp.Controls"
             xmlns:pageModels="clr-namespace:FDriverApp.PageModels"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             x:Class="FDriverApp.Pages.MainPage"
             x:DataType="pageModels:MainPageModel"
             Title="{Binding AppName}"
             BackgroundColor="#F8FAFC">

    <Grid>
    <pullToRefresh:SfPullToRefresh
        IsVisible="{Binding IsAuthenticated}"
        IsRefreshing="{Binding IsRefreshing}"
        RefreshCommand="{Binding RefreshCommand}">
        <pullToRefresh:SfPullToRefresh.PullableContent>
            <Grid RowDefinitions="*,Auto">
                <maps:FDriverNativeMapView x:Name="FoodDeliveryMap"
                                           Grid.Row="0"
                                           CenterLatitude="{Binding MapCenterLatitude}"
                                           CenterLongitude="{Binding MapCenterLongitude}"
                                           CurrentLocationLatitude="{Binding CurrentLocationLatitude}"
                                           CurrentLocationLongitude="{Binding CurrentLocationLongitude}"
                                           Zoom="14"
                                           Markers="{Binding MapMarkers}"
                                           RouteOverlays="{Binding SelectedRouteOverlays}"
                                           ShowTrafficLayer="True"
                                           ShowLocationButton="True"
                                           ShowCurrentLocationOverlay="{Binding HasCurrentLocation}"
                                           MarkerSelected="OnMapMarkerSelected" />

                <HorizontalStackLayout Grid.Row="0"
                                       Spacing="8"
                                       Margin="16"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start">
                    <Button Text="내 정보"
                            Padding="12,8"
                            BackgroundColor="#FFFFFF"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            TextColor="#0F172A"
                            Clicked="OnProfileClicked"
                            Command="{Binding OpenProfileCommand}" />
                    <Button Text="현재 배달"
                            Padding="12,8"
                            BackgroundColor="#FFFFFF"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            TextColor="#0F172A"
                            Clicked="OnCurrentDeliveryClicked"
                            Command="{Binding OpenCurrentDeliveryCommand}" />
                    <Button Text="로그아웃"
                            Padding="12,8"
                            BackgroundColor="#FFFFFF"
                            BorderColor="#CBD5E1"
                            BorderWidth="1"
                            TextColor="#991B1B"
                            Command="{Binding LogoutCommand}" />
                </HorizontalStackLayout>

                <Border Grid.Row="0"
                        IsVisible="{Binding HasNewRecommendations}"
                        BackgroundColor="#1D4ED8"
                        Stroke="#BFDBFE"
                        StrokeThickness="1"
                        Padding="12"
                        Margin="16,140,16,0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Start"
                        MaximumWidthRequest="360">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding NewRecommendationNotice}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#FFFFFF" />
                            <Label Text="눌러서 음식점·전달지와 예상 경로를 확인하세요."
                                   FontSize="11"
                                   TextColor="#DBEAFE" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="확인"
                                Padding="12,6"
                                BackgroundColor="#FFFFFF"
                                TextColor="#1D4ED8"
                                Command="{Binding OpenNewRecommendationsCommand}" />
                    </Grid>
                </Border>

                <Border Grid.Row="0"
                        BackgroundColor="#F8FAFC"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        Padding="10"
                        Margin="16,70,16,0"
                        HorizontalOptions="End"
                        VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#F57C00" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="픽업: 음식점" FontSize="12" TextColor="#111827" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="#2563EB" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="전달: 고객 주소" FontSize="12" TextColor="#111827" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0"
                        BackgroundColor="#FFFFFF"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        Padding="14"
                        Margin="16"
                        HorizontalOptions="Fill"
                        VerticalOptions="End">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding SelectedRouteText}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding PickupPointText}" FontSize="12" TextColor="#374151" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding DropoffPointText}" FontSize="12" TextColor="#374151" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
                            <Label Text="{Binding WorkStage}" FontSize="13" FontAttributes="Bold" TextColor="#2563EB" HorizontalTextAlignment="End" />
                            <Label Text="{Binding ActiveWorkPayoutText}" FontSize="12" TextColor="#475569" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <ScrollView x:Name="WorkspaceScroll"
                            Grid.Row="1"
                            BackgroundColor="#FFFFFF"
                            HeightRequest="390">
                    <Grid Padding="16" RowSpacing="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="WorkspaceSummarySection"
                              Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding AppName}" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="{Binding CurrentArea}" FontSize="13" TextColor="#475569" />
                                 <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="#334155" />
                                  <Label Text="{Binding DispatchAutomationNotice}" FontSize="12" TextColor="#B45309" />
                                  <Label Text="{Binding WorkspaceSyncText}" FontSize="11" TextColor="#64748B" />
                                  <Label Text="{Binding RealtimeConnectionText}" FontSize="11" TextColor="#2563EB" />
                                  <Label Text="{Binding LocationSyncText}" FontSize="11" TextColor="#64748B" />
                                 <Label Text="{Binding RouteStatusText}" FontSize="12" TextColor="#2563EB" />
                                <Label Text="{Binding SettlementText}" FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" HorizontalOptions="End">
                                <Label Text="{Binding Today}" FontSize="12" TextColor="#64748B" HorizontalTextAlignment="End" />
                                <Label Text="{Binding PendingDeliveryTickets, StringFormat='대기 {0}건'}" FontSize="13" TextColor="#0F172A" HorizontalTextAlignment="End" />
                                <Label Text="{Binding RecommendedTickets, StringFormat='추천 {0}건'}" FontSize="13" FontAttributes="Bold" TextColor="#2563EB" HorizontalTextAlignment="End" />
                                <Button Text="{Binding WorkToggleText}"
                                        Padding="12,6"
                                        BackgroundColor="{Binding WorkToggleColor}"
                                        TextColor="#FFFFFF"
                                        Command="{Binding ToggleWorkCommand}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border x:Name="ActiveDeliverySection"
                                Grid.Row="1"
                                Stroke="#DBEAFE"
                                StrokeThickness="1"
                                BackgroundColor="#EFF6FF"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                             <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding ActiveWorkSummary}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding ActiveWorkRouteText}" FontSize="13" TextColor="#334155" />
                                        <Label Text="{Binding NextActionGuide}" FontSize="12" TextColor="#2563EB" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Text="{Binding ActiveWorkPayoutText}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           HorizontalTextAlignment="End" />
                                 </Grid>

                                 <CollectionView Grid.Row="1"
                                                 ItemsSource="{Binding ActiveDeliveryItems}"
                                                 ItemsLayout="HorizontalList"
                                                 SelectionMode="None"
                                                 IsVisible="{Binding HasMultipleActiveDeliveries}"
                                                 HeightRequest="48">
                                     <CollectionView.ItemTemplate>
                                         <DataTemplate x:DataType="pageModels:ActiveDeliveryPreview">
                                             <Button Text="{Binding OrderSummary}"
                                                     FontSize="11"
                                                     Padding="10,5"
                                                     Margin="0,0,8,0"
                                                     BackgroundColor="#FFFFFF"
                                                     BorderColor="#93C5FD"
                                                     BorderWidth="1"
                                                     TextColor="#1D4ED8"
                                                     Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=SelectActiveDeliveryCommand}"
                                                     CommandParameter="{Binding .}" />
                                         </DataTemplate>
                                     </CollectionView.ItemTemplate>
                                 </CollectionView>

                                 <Border Grid.Row="2"
                                         IsVisible="{Binding ActiveDelivery.HasRecipient}"
                                         Stroke="#BAE6FD"
                                         StrokeThickness="1"
                                         BackgroundColor="#F0F9FF"
                                         Padding="10">
                                     <Border.StrokeShape>
                                         <RoundRectangle CornerRadius="8" />
                                     </Border.StrokeShape>
                                     <VerticalStackLayout Spacing="3">
                                         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                             <Label Text="{Binding ActiveDelivery.RecipientNameText}"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    TextColor="#0F172A" />
                                             <Label Grid.Column="1"
                                                    Text="{Binding ActiveDelivery.RecipientRelationshipText}"
                                                    FontSize="11"
                                                    TextColor="#0369A1" />
                                         </Grid>
                                         <Label Text="{Binding ActiveDelivery.RecipientContactText}"
                                                FontSize="12"
                                                TextColor="#334155" />
                                         <Label Text="{Binding ActiveDelivery.DeliveryInstructionsText}"
                                                FontSize="12"
                                                TextColor="#334155"
                                                MaxLines="2" />
                                         <Label Text="배차가 확정된 현재 업무에서만 수령자 정보를 표시합니다."
                                                FontSize="10"
                                                TextColor="#64748B" />
                                     </VerticalStackLayout>
                                 </Border>

                                 <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border Stroke="#BFDBFE" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="1" FontSize="11" TextColor="#2563EB" />
                                            <Label Text="수락" FontSize="12" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" Stroke="#BFDBFE" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="2" FontSize="11" TextColor="#2563EB" />
                                            <Label Text="{Binding ActiveDelivery.PickupActionLabel}" FontSize="12" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" Stroke="#BFDBFE" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="8">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="3" FontSize="11" TextColor="#2563EB" />
                                            <Label Text="{Binding ActiveDelivery.CompletionActionLabel}" FontSize="12" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                 <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Text="{Binding ActiveDelivery.PickupActionLabel}"
                                            Command="{Binding ConfirmPickupCommand}"
                                            IsEnabled="{Binding CanConfirmPickup}"
                                            BackgroundColor="#2563EB"
                                            TextColor="#FFFFFF" />
                                    <Button Grid.Column="1"
                                            Text="{Binding ActiveDelivery.CompletionActionLabel}"
                                            Command="{Binding CompleteDeliveryCommand}"
                                            IsEnabled="{Binding CanCompleteDelivery}"
                                            BackgroundColor="#0F766E"
                                            TextColor="#FFFFFF" />
                                </Grid>
                            </Grid>
                        </Border>

                        <VerticalStackLayout x:Name="RecommendationSection"
                                             Grid.Row="2"
                                             Spacing="10">
                            <VerticalStackLayout IsVisible="{Binding HasBundleCandidates}" Spacing="6">
                                <Label Text="묶음 배달 추천" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                                <CollectionView ItemsSource="{Binding BundleCandidateItems}"
                                                ItemsLayout="HorizontalList"
                                                SelectionMode="None"
                                                HeightRequest="118">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="pageModels:FoodDeliveryBundlePreview">
                                            <Border Stroke="#99F6E4" StrokeThickness="1" BackgroundColor="#F0FDFA" Padding="10" Margin="0,0,10,0" WidthRequest="285">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="8" />
                                                </Border.StrokeShape>
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding CountText}" FontSize="11" TextColor="#0F766E" />
                                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation" />
                                                        <Label Text="{Binding Reason}" FontSize="11" TextColor="#475569" MaxLines="2" />
                                                        <Label Text="{Binding RouteText}" FontSize="11" TextColor="#0F766E" />
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End">
                                                        <Label Text="{Binding PayoutText}" FontSize="13" FontAttributes="Bold" />
                                                        <Button Text="묶음 수락"
                                                                Padding="10,6"
                                                                BackgroundColor="#0F766E"
                                                                TextColor="#FFFFFF"
                                                                Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=AcceptBundleCommand}"
                                                                CommandParameter="{Binding .}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="추천 배달권" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                 <Label Grid.Column="1" Text="{Binding TodayExpectedPayout, StringFormat='추천 운임 합계 {0:N0}원'}" FontSize="12" TextColor="#475569" />
                            </Grid>
                            <CollectionView ItemsSource="{Binding RecommendedTicketItems}"
                                            SelectionMode="None"
                                            HeightRequest="210">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="pageModels:DeliveryTicketPreview">
                                        <Border Stroke="#E5E7EB" StrokeThickness="1" BackgroundColor="#FFFFFF" Padding="12" Margin="0,0,0,10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding OrderSummary}" FontSize="15" FontAttributes="Bold" TextColor="#111827" />
                                                    <Label Text="{Binding RestaurantName}" FontSize="13" TextColor="#374151" />
                                                    <Label Text="{Binding RestaurantAddress}" FontSize="12" TextColor="#6B7280" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding DropoffAddress, StringFormat='전달지 {0}'}" FontSize="12" TextColor="#6B7280" LineBreakMode="TailTruncation" />
                                                     <Label Text="{Binding RecommendationReason}" FontSize="12" TextColor="#2563EB" />
                                                     <Label Text="{Binding RemainingText}" FontSize="12" FontAttributes="Bold" TextColor="#B45309" />
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End">
                                                    <Label Text="{Binding DistanceText}" FontSize="12" HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding DriverPayoutText}" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                                    <Label Text="{Binding WeatherSurchargeText}"
                                                           IsVisible="{Binding IsWeatherSurchargeApplied}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="#0369A1"
                                                           HorizontalTextAlignment="End" />
                                                    <Button Text="선택"
                                                            Padding="12,6"
                                                            Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=SelectTicketCommand}"
                                                            CommandParameter="{Binding .}" />
                                                     <Button Text="수락"
                                                            Padding="12,6"
                                                            BackgroundColor="#2563EB"
                                                            TextColor="#FFFFFF"
                                                             Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=AcceptTicketCommand}"
                                                             CommandParameter="{Binding .}"
                                                             IsEnabled="{Binding CanAccept}" />
                                                     <Button Text="거절"
                                                             Padding="12,6"
                                                             BackgroundColor="#FFFFFF"
                                                             BorderColor="#CBD5E1"
                                                             BorderWidth="1"
                                                             TextColor="#991B1B"
                                                             Command="{Binding x:DataType='pageModels:MainPageModel', Source={RelativeSource AncestorType={x:Type pageModels:MainPageModel}}, Path=RejectTicketCommand}"
                                                             CommandParameter="{Binding .}"
                                                             IsEnabled="{Binding CanReject}" />
                                                 </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Grid>
                </ScrollView>
            </Grid>
        </pullToRefresh:SfPullToRefresh.PullableContent>
    </pullToRefresh:SfPullToRefresh>
        <Border IsVisible="{Binding IsSignedOut}"
                BackgroundColor="#FFFFFF"
                Stroke="#CBD5E1"
                StrokeThickness="1"
                Padding="24"
                Margin="24"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                MaximumWidthRequest="420">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="14">
                <Label Text="살뜰 배달" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                <Label Text="기사 계정으로 로그인하면 실제 배차, 위치, 경로와 월 정산을 불러옵니다."
                       FontSize="13" TextColor="#475569" />
                <Entry Placeholder="아이디 또는 이메일"
                       Text="{Binding LoginId}"
                       Keyboard="Email" />
                <Entry Placeholder="비밀번호"
                       Text="{Binding Password}"
                       IsPassword="True" />
                <Button Text="기사 로그인"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="#2563EB"
                        TextColor="#FFFFFF" />
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="#2563EB" />
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="#B91C1C" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
