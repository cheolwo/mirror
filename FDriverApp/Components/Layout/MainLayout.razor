@inherits LayoutComponentBase

<MudLayout>
    <MudAppBar Dense="true" Fixed="false" Elevation="0" Class="hongdal-appbar">
        <MudStack Spacing="0" Class="hongdal-appbar-title">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">살뜰 배달</MudText>
            <MudText Typo="Typo.caption" Class="hongdal-appbar-subtitle">음식 배달 기사 · 통합 커뮤니티</MudText>
        </MudStack>
        <MudSpacer />
        <div class="hongdal-role-switcher">
            <button type="button"
                    class="hongdal-role-trigger"
                    aria-label="활동 역할 확인"
                    aria-expanded="@rolePanelOpen"
                    @onclick="ToggleRolePanel">
                <MudIcon Icon="@Icons.Material.Filled.Person" />
            </button>

            @if (rolePanelOpen)
            {
                <button type="button" class="hongdal-role-panel-dismiss" aria-label="역할 패널 닫기" @onclick="CloseRolePanel"></button>
                <section class="hongdal-role-panel" role="dialog" aria-modal="true" aria-label="활동 역할" @onclick:stopPropagation="true">
                    <div class="hongdal-role-panel-handle" aria-hidden="true"></div>
                    <header>
                        <div>
                            <span>활동 역할</span>
                            <strong>음식 배달 기사</strong>
                            <small>역할에 맞춰 사방괘의 네 업무 진입점이 바뀝니다.</small>
                        </div>
                        <button type="button" aria-label="닫기" @onclick="CloseRolePanel">
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                        </button>
                    </header>
                    <button type="button" class="hongdal-role-option hongdal-role-option--active" @onclick="CloseRolePanel">
                        <span class="hongdal-role-option-icon">
                            <MudIcon Icon="@Icons.Material.Filled.DeliveryDining" Size="Size.Small" />
                        </span>
                        <span>
                            <strong>음식 배달 기사</strong>
                            <small>배차 · 묶음 배달 · 위치와 경로 · 정산</small>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    </button>
                </section>
            }
        </div>
    </MudAppBar>

    <MudMainContent Class="hongdal-main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool rolePanelOpen;

    private void ToggleRolePanel() => rolePanelOpen = !rolePanelOpen;
    private void CloseRolePanel() => rolePanelOpen = false;
}
